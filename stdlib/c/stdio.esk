// c/stdio.esk: the stdio.h file functions the stdlib calls (internal, see
// <c/string>). A `FILE*` is `*void`; <io> has the standard streams and printf.
import <ctypes>;

extern *void fopen(string path, string mode);
extern int fclose(*void fp);
extern int fflush(*void fp);
extern size_t fread(*void buf, size_t size, size_t count, *void fp);
extern size_t fwrite(*void buf, size_t size, size_t count, *void fp);
extern int fgetc(*void fp);
extern *uint8 fgets(*uint8 buf, int n, *void fp);
extern int fputs(string s, *void fp);
extern int fseek(*void fp, c_long offset, int whence);
extern c_long ftell(*void fp);
extern void rewind(*void fp);
extern int feof(*void fp);
extern int ferror(*void fp);
extern int rename(string from, string to);
extern int vsnprintf(*char buf, size_t n, string fmt, va_list ap);
