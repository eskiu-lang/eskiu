// c/unistd.esk: the POSIX unistd.h and fcntl.h functions the stdlib calls
// (internal, see <c/string>). Nothing on Windows, whose descriptors these are not.
// sleep and usleep are in <c/time>.
import <ctypes>;

#ifndef _WIN32
extern int close(int fd);
extern ssize_t read(int fd, *void buf, size_t n);
extern ssize_t write(int fd, *void buf, size_t n);
extern int pipe(*int fds);
extern int dup2(int from, int to);
extern int isatty(int fd);
extern int chdir(string path);
extern *char getcwd(*char buf, size_t size);
extern int unlink(string path);
extern int getpid();
// Variadic in C: arm64 Apple passes the `...` arguments on the stack.
extern int open(string path, int flags, ...);
extern int fcntl(int fd, int cmd, ...);
#endif
