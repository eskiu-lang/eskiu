// c/pthread.esk: the pthread thread-specific data functions the stdlib calls
// (internal, see <c/string>). pthread_key_t is an unsigned long on Apple and an
// unsigned int in glibc, musl, bionic, emscripten and winpthreads; `_c_tls_key`
// holds either. The program links the pthread library like <threading> does.
import <ctypes>;

#if defined(__linux__) && !defined(__ANDROID__)
#pragma link("pthread")
#endif
#ifdef _WIN32
#pragma link("pthread")
#endif

#ifdef __APPLE__
type _c_tls_key = c_long;
#else
type _c_tls_key = uint32;
#endif

extern int pthread_key_create(*_c_tls_key key, fn(*void)->void destructor);
extern *void pthread_getspecific(_c_tls_key key);
extern int pthread_setspecific(_c_tls_key key, *void value);
