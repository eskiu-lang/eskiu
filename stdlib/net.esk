// net.esk — TCP sockets over the POSIX BSD socket API.
//
// Hosted mode only (uses libc); link normally, no extra flags. The raw
// `extern`s are exposed for advanced use, but most code only needs the
// `net_*` helpers below.
//
//   import <net>;
//   int fd = net_tcp_listen(8080);
//   int c  = net_accept(fd);
//   net_send_str(c, "hello\n");
//   net_close(c);

import <ctypes>;
import <time>;
import <dns>;    // host names in net_tcp_connect

extern int socket(int domain, int type, int protocol);
extern int bind(int fd, *void addr, int len);
extern int listen(int fd, int backlog);
extern int accept(int fd, *void addr, *int len);
extern int connect(int fd, *void addr, int len);
#ifdef _WIN32
// Winsock (ws2_32): sockets are closed with closesocket, not the CRT close, and the library
// must be started once before any socket call. WSADATA is ~400 bytes; 512 is a safe buffer.
#pragma link("ws2_32")
extern int closesocket(int fd);
extern int WSAStartup(int version, *void data);
#else
extern int close(int fd);
#endif
extern int setsockopt(int fd, int level, int opt, *void val, int len);
#ifdef _WIN32
// Winsock's send/recv take and return an int: read as int64, SOCKET_ERROR
// (-1) would be 4294967295.
extern int send(int fd, *void buf, int n, int flags);
extern int recv(int fd, *void buf, int n, int flags);
#else
extern ssize_t send(int fd, *void buf, size_t n, int flags);
extern ssize_t recv(int fd, *void buf, size_t n, int flags);
#endif
extern uint16 htons(uint16 x);
extern uint32 htonl(uint32 x);
extern uint32 inet_addr(string dotted);
extern size_t strlen(string s);

// sockaddr_in — an exact 16-byte layout (hence `packed`). macOS leads with a
// `sin_len` byte; Linux starts with a 2-byte `sin_family`. Selected at compile
// time via the predefined `__APPLE__` macro.
#ifdef __APPLE__
packed struct sockaddr_in {
    uint8 sin_len;
    uint8 sin_family;
    uint16 sin_port;
    uint32 sin_addr;
    uint8 z0;
    uint8 z1;
    uint8 z2;
    uint8 z3;
    uint8 z4;
    uint8 z5;
    uint8 z6;
    uint8 z7;
}
#else
packed struct sockaddr_in {
    uint16 sin_family;
    uint16 sin_port;
    uint32 sin_addr;
    uint8 z0;
    uint8 z1;
    uint8 z2;
    uint8 z3;
    uint8 z4;
    uint8 z5;
    uint8 z6;
    uint8 z7;
}
#endif

// AF_INET / SOCK_STREAM match everywhere; SOL_SOCKET and SO_REUSEADDR do not. macOS and
// Windows share the same values (0xffff / 4); only Linux differs (1 / 2).
#define AF_INET     2
#define SOCK_STREAM 1
#ifdef __linux__
#define SOL_SOCKET    1
#define SO_REUSEADDR  2
#else
#define SOL_SOCKET    65535
#define SO_REUSEADDR  4
#endif

// Start Winsock once before any socket call (a no-op elsewhere). Not thread-safe on its
// own; the servers call it from their single setup path before spawning workers.
#ifdef _WIN32
bool _net_wsa_ready = false;
void _net_wsa_init() {
    if (!_net_wsa_ready) {
        uint8[512] wsadata;
        WSAStartup(514, (*void)&wsadata);   // 514 = 0x0202, Winsock 2.2
        _net_wsa_ready = true;
    }
}

int _net_close_fd(int fd) {
    return closesocket(fd);
}
#else
void _net_wsa_init() {}
int _net_close_fd(int fd) {
    return close(fd);
}
#endif

// Fill a sockaddr_in with a network-order address and a host-order port.
void _net_fill_addr(sockaddr_in* a, uint32 net_ip, uint16 port) {
#ifdef __APPLE__
    a.sin_len = 16;
#endif
    a.sin_family = AF_INET;
    a.sin_port = htons(port);
    a.sin_addr = net_ip;
}

// Open a listening TCP socket on 0.0.0.0:port. Returns the fd, or -1 on error.
int net_tcp_listen(uint16 port) {
    _net_wsa_init();
    const int fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) {
        return -1;
    }
    int one = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (*void)&one, 4);
    _net_nosigpipe(fd);
    let a: sockaddr_in;
    _net_fill_addr(&a, 0, port);              // INADDR_ANY
    if (bind(fd, (*void)&a, 16) != 0) {
        _net_close_fd(fd);
        return -1;
    }
    if (listen(fd, 16) != 0) {
        _net_close_fd(fd);
        return -1;
    }
    return fd;
}

// Accept the next pending connection. Returns the connection fd, or -1.
int net_accept(int listen_fd) {
    const int c = accept(listen_fd, null, null);
    if (c >= 0) {
        _net_nosigpipe(c);
    }
    return c;
}

// Accept the next connection and write the peer's IPv4 address (network byte
// order) into *peer_ip (pass null to ignore). Returns the connection fd, or -1.
// Enables real per-client rate limiting / logging — net_accept alone drops the
// peer address.
int net_accept_addr(int listen_fd, *uint32 peer_ip) {
    let a: sockaddr_in;
    let alen: int = 16;
    const int c = accept(listen_fd, (*void)&a, &alen);
    if (c >= 0) {
        _net_nosigpipe(c);
    }
    if (c >= 0 && peer_ip != null) {
        peer_ip[0] = a.sin_addr;
    }
    return c;
}

// Connect to `host` and port. Returns the fd, or -1. `host` is a dotted IPv4
// address ("127.0.0.1"), used as is, or a host name or IPv6 address, resolved
// with getaddrinfo (<dns>) and tried address by address until one connects.
int net_tcp_connect(string host, uint16 port) {
    _net_wsa_init();
    const uint32 ip = inet_addr(host);
    if (ip != (uint32)4294967295 || strcmp(host, "255.255.255.255") == 0) {
        const int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) {
            return -1;
        }
        let a: sockaddr_in;
        _net_fill_addr(&a, ip, port);
        if (connect(fd, (*void)&a, 16) != 0) {
            _net_close_fd(fd);
            return -1;
        }
        _net_nosigpipe(fd);
        return fd;
    }
    char[8] ps;
    int pv = (int)port;
    int k = 6;
    ps[7] = 0;
    ps[k] = (char)(48 + pv % 10);
    pv = pv / 10;
    while (pv > 0) {
        k--;
        ps[k] = (char)(48 + pv % 10);
        pv = pv / 10;
    }
    *_dns_addrinfo res = null;
    if (_dns_lookup(host, (string)&ps[k], &res) != 0) {
        return -1;
    }
    int fd = -1;
    for (*_dns_addrinfo ai = res; ai != null && fd < 0; ai = ai.ai_next) {
        const int s = socket(ai.ai_family, ai.ai_socktype, ai.ai_protocol);
        if (s < 0) {
            continue;
        }
        if (connect(s, ai.ai_addr, (int)ai.ai_addrlen) != 0) {
            _net_close_fd(s);
            continue;
        }
        _net_nosigpipe(s);
        fd = s;
    }
    freeaddrinfo(res);
    return fd;
}

// Writing to a socket whose peer has closed must fail with EPIPE, not raise
// SIGPIPE (which kills the process by default). net_send passes MSG_NOSIGNAL
// (Linux and macOS both have it). A plain write() on a socket (OpenSSL's socket
// BIO) takes no flag: macOS covers it with SO_NOSIGPIPE, set on every socket
// net_accept/net_tcp_connect returns (accepted sockets inherit it from a
// listener too). Windows has no SIGPIPE.
#ifdef __linux__
#define _NET_MSG_NOSIGNAL 16384
#else
#ifdef __APPLE__
#define _NET_MSG_NOSIGNAL 524288
#else
#define _NET_MSG_NOSIGNAL 0
#endif
#endif
#ifdef __APPLE__
#define _NET_SO_NOSIGPIPE 4130
#endif

// Make plain writes on socket `fd` return EPIPE instead of raising SIGPIPE,
// where the socket can carry that (macOS). A no-op elsewhere.
void _net_nosigpipe(int fd) {
#ifdef __APPLE__
    int one = 1;
    setsockopt(fd, SOL_SOCKET, _NET_SO_NOSIGPIPE, (*void)&one, 4);
#endif
}

// send() that never raises SIGPIPE: a closed peer is a -1 return (EPIPE).
#ifdef _WIN32
int _net_io_len(int64 n) {
    return n > 1073741824 ? 1073741824 : (int)n;
}

int64 net_send(int fd, *void buf, int64 n) {
    return (int64)send(fd, buf, _net_io_len(n), _NET_MSG_NOSIGNAL);
}

int64 net_recv(int fd, *void buf, int64 n) {
    return (int64)recv(fd, buf, _net_io_len(n), 0);
}
#else
int64 net_send(int fd, *void buf, int64 n) {
    return send(fd, buf, n, _NET_MSG_NOSIGNAL);
}

int64 net_recv(int fd, *void buf, int64 n) {
    return recv(fd, buf, n, 0);
}
#endif
int64 net_send_str(int fd, string s) {
    return net_send(fd, (*void)s, strlen(s));
}

void net_close(int fd) {
    _net_close_fd(fd);
}

// The last socket error and "would block", per platform. EAGAIN (== EWOULDBLOCK)
// is also what a blocking recv/send returns once SO_RCVTIMEO / SO_SNDTIMEO runs
// out; Winsock reports that as WSAETIMEDOUT.
#ifdef _WIN32
extern int WSAGetLastError();
int _net_errno() {
    return WSAGetLastError();
}

const int _NET_EAGAIN = 10035;   // WSAEWOULDBLOCK
const int _NET_ETIMEDOUT = 10060;   // WSAETIMEDOUT
#else
#ifdef __APPLE__
extern *int __error();
int _net_errno() {
    return *__error();
}

const int _NET_EAGAIN = 35;     // EAGAIN == EWOULDBLOCK on macOS
#else
// errno's location: __errno() in Android's bionic, __errno_location() in glibc and musl.
#ifdef __ANDROID__
extern *int __errno();
#ifndef __errno_location
#define __errno_location __errno
#endif
#else
extern *int __errno_location();
#endif
int _net_errno() {
    return *__errno_location();
}

const int _NET_EAGAIN = 11;     // EAGAIN == EWOULDBLOCK on Linux
#endif
const int _NET_ETIMEDOUT = _NET_EAGAIN;
#endif

// 1 if the last failed socket call only ran out of time or would have blocked
// (the socket is fine; retry or give up on a deadline), else 0.
int net_would_block() {
    const int e = _net_errno();
    return e == _NET_EAGAIN || e == _NET_ETIMEDOUT ? 1 : 0;
}

// ── Socket timeouts ──────────────────────────────────────────────────────────
// SO_RCVTIMEO / SO_SNDTIMEO bound how long a blocking recv / send on `fd` waits
// (`ms` milliseconds; 0 waits forever). A recv or send that runs out returns -1
// with net_would_block() == 1. POSIX takes a struct timeval of two C `long`s
// (_net_long: 64-bit on 64-bit macOS and Linux, where the low half of tv_usec is
// macOS's int; 32-bit on 32-bit ARM and x86), Winsock a DWORD of milliseconds.
#ifdef __linux__
#define _NET_SO_SNDTIMEO 21
#define _NET_SO_RCVTIMEO 20
#else
#define _NET_SO_SNDTIMEO 4101
#define _NET_SO_RCVTIMEO 4102
#endif

// The target's C `long` (LP64 on the 64-bit Unix targets, ILP32 on 32-bit).
#if defined(__aarch64__) || defined(__x86_64__)
type _net_long = int64;
#else
type _net_long = int32;
#endif

struct _net_timeval {
    _net_long tv_sec;
    _net_long tv_usec;
}

int _net_set_timeo(int fd, int opt, int64 ms) {
    if (ms < 0) {
        ms = 0;
    }
#ifdef _WIN32
    int w = (int)ms;
    return setsockopt(fd, SOL_SOCKET, opt, (*void)&w, 4);
#else
    let tv: _net_timeval;
    tv.tv_sec = (_net_long)(ms / 1000);
    tv.tv_usec = (_net_long)((ms % 1000) * 1000);
    return setsockopt(fd, SOL_SOCKET, opt, (*void)&tv, (int)sizeof(_net_timeval));
#endif
}

int net_set_recv_timeout(int fd, int64 ms) {
    return _net_set_timeo(fd, _NET_SO_RCVTIMEO, ms);
}

int net_set_send_timeout(int fd, int64 ms) {
    return _net_set_timeo(fd, _NET_SO_SNDTIMEO, ms);
}

// Set both: SO_RCVTIMEO to `recv_ms` and SO_SNDTIMEO to `send_ms` (0 = none).
void net_set_timeouts(int fd, int64 recv_ms, int64 send_ms) {
    net_set_recv_timeout(fd, recv_ms);
    net_set_send_timeout(fd, send_ms);
}

// Deadlines are absolute monotonic times in ms (time_monotonic_ms), 0 for none.
// net_deadline(ms) is `ms` from now, or 0 (no deadline) when ms <= 0.
int64 net_deadline(int64 ms) {
    return ms > 0 ? time_monotonic_ms() + ms : 0;
}

// What a read or write with a deadline returns once the deadline passed (the
// <net_async> *_deadline_async futures, the <http> servers). Never a byte count
// and distinct from -1 (an error) and 0 (end of stream).
const int NET_TIMED_OUT = -3;

// ── Readiness wait (blocking) ────────────────────────────────────────────────
// poll() on one socket (WSAPoll on Windows). struct pollfd is { int fd; short
// events; short revents; } on POSIX; WSAPOLLFD on x64 is { SOCKET fd; SHORT
// events; SHORT revents; } padded to 16 bytes. nfds_t is macOS's unsigned int,
// Linux's unsigned long; WSAPoll takes a ULONG.
#ifdef _WIN32
extern int WSAPoll(*void fdarray, int nfds, int timeout);
packed struct _net_pollfd {
    int64 fd;
    int16 events;
    int16 revents;
    int32 _pad;
}

const int _NET_POLLIN = 256;   // POLLRDNORM
const int _NET_POLLOUT = 16;    // POLLWRNORM
int _net_poll1(_net_pollfd* p, int timeout) {
    return WSAPoll((*void)p, 1, timeout);
}
#else
struct _net_pollfd {
    int fd;
    int16 events;
    int16 revents;
}

const int _NET_POLLIN = 1;
const int _NET_POLLOUT = 4;
const int _NET_EINTR = 4;
#ifdef __APPLE__
extern int poll(*void fds, uint32 nfds, int timeout);
int _net_poll1(_net_pollfd* p, int timeout) {
    return poll((*void)p, (uint32)1, timeout);
}
#else
extern int poll(*void fds, _net_long nfds, int timeout);
int _net_poll1(_net_pollfd* p, int timeout) {
    return poll((*void)p, (_net_long)1, timeout);
}
#endif
#endif

// Wait until socket `fd` is readable (mode 0) or writable (mode 1), by
// `deadline` (net_deadline; 0 = none): 0 when it is ready (or has an error or
// hang-up for the next call to report), NET_TIMED_OUT once the deadline passed,
// -1 if the wait itself failed. Works on a blocking or non-blocking socket.
int net_wait_ready(int fd, int mode, int64 deadline) {
    while (true) {
        int timeout = -1;
        if (deadline != 0) {
            const int64 left = deadline - time_monotonic_ms();
            if (left <= 0) {
                return NET_TIMED_OUT;
            }
            timeout = left > 2147483647 ? 2147483647 : (int)left;
        }
        let p: _net_pollfd;
#ifdef _WIN32
        p.fd = (int64)fd;
#else
        p.fd = fd;
#endif
        p.events = (int16)(mode == 0 ? _NET_POLLIN : _NET_POLLOUT);
        p.revents = (int16)0;
        const int r = _net_poll1(&p, timeout);
        if (r > 0) {
            return 0;
        }
#ifdef _WIN32
        if (r < 0) {
            return -1;
        }
#else
        if (r < 0 && _net_errno() != _NET_EINTR) {
            return -1;
        }
#endif
    }
    return -1;
}
