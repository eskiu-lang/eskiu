    16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216, 16777216,
};

// The three bytes of the group whose four characters are in word w (first
// character in the low byte), in output order; 2^24 or more if one is invalid.
uint32 _b64_dec_word(uint32 w) {
    return _B64_DEC0[w & 255] | _B64_DEC1[(w >> 8) & 255] | _B64_DEC2[(w >> 16) & 255] | _B64_DEC3[w >> 24];
}

// Decode `n` characters from src into out. Returns the number of bytes written,
// or -1 on malformed input: a non-Base64 character, '=' anywhere but the end
// (or more than two), a padded input that is not whole 4-character groups, or
// a length that cannot come from any byte string (one character left over, the
// sign of a truncated input). Unpadded input is accepted. Whitespace is ignored.
// out must hold base64_decoded_len(n) bytes.
int base64_decode(*uint8 src, int n, *uint8 out) {
    int acc = 0;   // bit accumulator
    int bits = 0;   // bits currently in acc
    int64 o = 0;
    int data = 0;   // Base64 digits seen
    int pad = 0;   // '=' seen (only trailing padding is valid)
    int64 i = 0;
    const int64 end = (int64)n;
    const bool le = _b64_little_endian();
    while (i < end) {
        if (bits == 0 && pad == 0) {
            // At a group boundary: decode whole groups of four digits until one
            // holds anything else (whitespace, '=', a bad byte, the end). With
            // both buffers word-aligned, four groups at a time as words.
            if (le && (((int64)(src + i) | (int64)(out + o)) & 3) == 0) {
                while (i + 16 <= end) {
                    const uint32 s0 = _b64_dec_word(*(*uint32)(src + i));
                    const uint32 s1 = _b64_dec_word(*(*uint32)(src + i + 4));
                    const uint32 s2 = _b64_dec_word(*(*uint32)(src + i + 8));
                    const uint32 s3 = _b64_dec_word(*(*uint32)(src + i + 12));
                    if (((s0 | s1 | s2 | s3) >> 24) != 0) {
                        break;
                    }
                    *(*uint32)(out + o) = s0 | (s1 << 24);
                    *(*uint32)(out + o + 4) = (s1 >> 8) | (s2 << 16);
                    *(*uint32)(out + o + 8) = (s2 >> 16) | (s3 << 8);
                    o += 12;
                    i += 16;
                    data += 16;
                }
            }
            while (i + 4 <= end) {
                const uint32 s = _B64_DEC0[src[i]] | _B64_DEC1[src[i + 1]] | _B64_DEC2[src[i + 2]]
                    | _B64_DEC3[src[i + 3]];
                if ((s >> 24) != 0) {
                    break;
                }
                out[o] = (uint8)s;
                out[o + 1] = (uint8)(s >> 8);
                out[o + 2] = (uint8)(s >> 16);
                o += 3;
                i += 4;
                data += 4;
            }
            if (i >= end) {
                break;
            }
        }
        const uint8 ch = src[i];
        i++;
        if (ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t') {
            continue;
        }
        if (ch == '=') {
            pad++;
            continue;
        }
        if (pad > 0) {                                 // data after padding
            return -1;
        }
        const int v = (int)_B64_VALUES[ch];
        if (v == 255) {
            return -1;
        }
        data++;
        acc = ((acc << 6) | v) & 16777215;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            out[o++] = (uint8)((acc >> bits) & 255);
        }
    }
    if (data % 4 == 1) {                               // truncated: a lone 6-bit digit
        return -1;
    }
    if (pad > 2) {
        return -1;
    }
    if (pad > 0 && (data + pad) % 4 != 0) {            // padding must complete the group
        return -1;
    }
    return (int)o;
}
