// The four digits of the 24-bit group t, packed in output order into a word
// whose low byte is the first digit.
uint32 _b64_enc_word(uint32 t) {
    return (uint32)_B64_DIGITS[t >> 18] | _B64_DIGITS1[(t >> 12) & 63] | _B64_DIGITS2[(t >> 6) & 63]
        | _B64_DIGITS3[t & 63];
}

// Encode `n` bytes from src into out. Returns the number of characters written
// (out is also NUL-terminated at that index). out must hold
// base64_encoded_len(n) + 1 bytes.
int base64_encode(*uint8 src, int n, *uint8 out) {
    int64 i = 0;
    int64 o = 0;
    const int64 whole = n < 3 ? 0 : (int64)n - (int64)n % 3;
    if ((((int64)src | (int64)out) & 3) == 0 && _b64_little_endian()) {
        // Both buffers word-aligned: 12 bytes in as three words, 16 digits out
        // as four. src + i and out + o stay aligned (i, o advance by 12, 16).
        while (i + 12 <= whole) {
            const uint32 w0 = *(*uint32)(src + i);
            const uint32 w1 = *(*uint32)(src + i + 4);
            const uint32 w2 = *(*uint32)(src + i + 8);
            const uint32 t0 = ((w0 & 255) << 16) | (w0 & 65280) | ((w0 >> 16) & 255);
            const uint32 t1 = (w0 >> 24 << 16) | ((w1 & 255) << 8) | ((w1 >> 8) & 255);
            const uint32 t2 = (((w1 >> 16) & 255) << 16) | (w1 >> 24 << 8) | (w2 & 255);
            const uint32 t3 = (((w2 >> 8) & 255) << 16) | (((w2 >> 16) & 255) << 8) | (w2 >> 24);
            *(*uint32)(out + o) = _b64_enc_word(t0);
            *(*uint32)(out + o + 4) = _b64_enc_word(t1);
            *(*uint32)(out + o + 8) = _b64_enc_word(t2);
            *(*uint32)(out + o + 12) = _b64_enc_word(t3);
            i += 12;
            o += 16;
        }
    }
    while (i < whole) {
        const uint32 t = ((uint32)src[i] << 16) | ((uint32)src[i + 1] << 8) | (uint32)src[i + 2];
        out[o] = _B64_DIGITS[t >> 18];
        out[o + 1] = _B64_DIGITS[(t >> 12) & 63];
        out[o + 2] = _B64_DIGITS[(t >> 6) & 63];
        out[o + 3] = _B64_DIGITS[t & 63];
        i += 3;
        o += 4;
    }
    const int64 rem = (int64)n - i;
    if (rem > 0) {
        // One or two bytes left: emit their digits, then '=' up to a full group.
        const int b0 = (int)src[i];
        const int b1 = rem == 2 ? (int)src[i + 1] : 0;
        out[o] = _B64_DIGITS[b0 >> 2];
        out[o + 1] = _B64_DIGITS[((b0 & 3) << 4) | (b1 >> 4)];
        out[o + 2] = rem == 2 ? _B64_DIGITS[(b1 & 15) << 2] : '=';
        out[o + 3] = '=';
        o += 4;
    }
    out[o] = 0;
    return (int)o;
}

