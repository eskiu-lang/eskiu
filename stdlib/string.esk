// String — mutable string with owned buffer
// Requires: stdlib/mem.esk for alloc/free/memcpy/strlen

import <ctypes>;
import <mem>;
import <list>;   // String_split collects parts into a List<String>

struct String {
    *char data;
    int64 len;
    int64 cap;
}

void String_init(String* self, int64 initial_cap) {
    if (initial_cap < 1) {   // room for the trailing NUL
        initial_cap = 1;
    }
    self.data = alloc<char>(initial_cap);
    self.len = 0;
    self.cap = initial_cap;
    self.data[0] = 0;
}

void String_from(String* self, string s) {
    const int64 n = strlen(s);
    self.data = alloc<char>(n + 1);
    memcpy(self.data, s, n + 1);
    self.len = n;
    self.cap = n + 1;
}

*char String_cstr(String* self) {
    return self.data;
}

int64 String_len(String* self) {
    return self.len;
}

void String_free(String* self) {
    free(self.data);
    self.data = null;   // guard against double-free if the String is reused
    self.len = 0;
    self.cap = 0;
}

void String_append(String* self, string s) {
    const int64 slen = strlen(s);
    const int64 newlen = self.len + slen;
    // `s` may point into our own buffer (String_concat(&s, &s)); growing frees
    // it, so re-derive the pointer from its offset after the copy.
    const int64 so = (int64)s - (int64)self.data;
    const bool inside = self.data != null && so >= 0 && so <= self.len;
    if (newlen >= self.cap) {
        const int64 newcap = newlen * 2 + 1;
        let newbuf: *char = alloc<char>(newcap);
        memcpy(newbuf, self.data, self.len);
        free(self.data);
        self.data = newbuf;
        self.cap = newcap;
        if (inside) {
            s = (string)(self.data + so);
        }
    }
    memcpy(self.data + self.len, s, slen);
    self.data[newlen] = 0;
    self.len = newlen;
}

// Append `other`'s bytes, all of them: a NUL inside it is kept.
void String_concat(String* self, String* other) {
    _string_append_bytes(self, other.data, other.len);
}

// Append a single character, growing the buffer if needed and keeping the
// trailing NUL so the buffer stays a valid C string.
void String_push(String* self, char c) {
    if (self.len + 1 >= self.cap) {
        const int64 newcap = self.cap * 2 + 2;
        let newbuf: *char = alloc<char>(newcap);
        memcpy(newbuf, self.data, self.len);
        free(self.data);
        self.data = newbuf;
        self.cap = newcap;
    }
    self.data[self.len] = c;
    self.len++;
    self.data[self.len] = 0;
}

// Read the i-th character (no bounds check).
char String_char_at(String* self, int64 i) {
    return self.data[i];
}

// Overwrite the i-th character in place (no bounds check, no length change).
void String_set(String* self, int64 i, char c) {
    self.data[i] = c;
}

// Reset to the empty string, keeping the allocated buffer. Safe on a freed
// String (no buffer): it stays empty and the next push/append allocates.
void String_clear(String* self) {
    self.len = 0;
    if (self.data != null) {
        self.data[0] = 0;
    }
}

// First index of c, or -1 if absent.
int64 String_index_of(String* self, char c) {
    for (int64 i = 0; i < self.len; i++) {
        if (self.data[i] == c) {
            return i;
        }
    }
    return -1;
}

// 1 if the two Strings hold the same bytes, else 0.
int String_eq(String* self, String* other) {
    if (self.len != other.len) {
        return 0;
    }
    for (int64 i = 0; i < self.len; i++) {
        if (self.data[i] != other.data[i]) {
            return 0;
        }
    }
    return 1;
}

// 1 if this String equals the C string s, else 0.
int String_eq_cstr(String* self, string s) {
    const int64 n = strlen(s);
    if (self.len != n) {
        return 0;
    }
    for (int64 i = 0; i < n; i++) {
        if (self.data[i] != s[i]) {
            return 0;
        }
    }
    return 1;
}

// `a == b` / `a != b` on Strings compare their bytes (String_eq), and against a C
// string its text (String_eq_cstr), so a String is never compared by address.
bool operator ==(String a, String b) {
    return String_eq(&a, &b) == 1;
}

bool operator !=(String a, String b) {
    return String_eq(&a, &b) == 0;
}

bool operator ==(String a, string b) {
    return String_eq_cstr(&a, b) == 1;
}

bool operator !=(String a, string b) {
    return String_eq_cstr(&a, b) == 0;
}

// Reverse the characters in place.
void String_reverse(String* self) {
    int64 i = 0;
    int64 j = self.len - 1;
    while (i < j) {
        const char t = self.data[i];
        self.data[i] = self.data[j];
        self.data[j] = t;
        i++;
        j--;
    }
}

// Copy up to `count` characters starting at `start` from self into out.
// out must already be initialised; it is cleared first. A negative `start`
// counts from 0 (it is clamped), and one past the end gives an empty result.
void String_substring(String* self, String* out, int64 start, int64 count) {
    out.clear();
    if (start < 0) {
        start = 0;
    }
    for (int64 i = 0; i < count && start + i < self.len; i++) {
        out.push(self.data[start + i]);
    }
}

// Render an integer (with optional minus sign) into self.
void String_from_int(String* self, int n) {
    self.clear();
    if (n == 0) {
        self.push('0');
        return;
    }
    int64 v = (int64)n;   // widened: -(-2147483648) does not fit in an int
    const bool neg = v < 0;
    if (neg) {
        v = -v;
    }
    while (v > 0) {
        self.push((char)((int)'0' + (int)(v % 10)));
        v /= 10;
    }
    if (neg) {
        self.push('-');
    }
    self.reverse();
}

// Parse a leading (optionally signed, '+' or '-') decimal integer; stops at the first
// non-digit. Returns 0 for an empty or non-numeric string; a value outside the
// int range saturates to INT_MIN / INT_MAX.
int String_to_int(String* self) {
    int64 result = 0;
    int64 i = 0;
    bool neg = false;
    if (self.len > 0 && self.data[0] == '-') {
        neg = true;
        i = 1;
    } else if (self.len > 0 && self.data[0] == '+') {
        i = 1;
    }
    for (; i < self.len; i++) {
        const char c = self.data[i];
        if (c < '0' || c > '9') {
            break;
        }
        result = result * 10 + (int64)((int)c - (int)'0');
        if (result > 2147483648) {   // saturate; no int64 overflow
            result = 2147483648;
        }
    }
    if (neg) {
        return (int)(0 - result);
    }
    if (result > 2147483647) {
        return 2147483647;
    }
    return (int)result;
}

// 1 if this String begins with the C string `prefix`, else 0.
int String_starts_with(String* self, string prefix) {
    for (int64 i = 0; prefix[i] != 0; i++) {
        if (i >= self.len || self.data[i] != prefix[i]) {
            return 0;
        }
    }
    return 1;
}

// 1 if this String ends with the C string `suffix`, else 0.
int String_ends_with(String* self, string suffix) {
    const int64 slen = strlen(suffix);
    if (slen > self.len) {
        return 0;
    }
    const int64 off = self.len - slen;
    for (int64 i = 0; i < slen; i++) {
        if (self.data[off + i] != suffix[i]) {
            return 0;
        }
    }
    return 1;
}

// The whitespace String_trim strips: space, tab, newline, carriage return.
int _string_ws(char c) {
    return (c == 32 || c == 9 || c == 10 || c == 13) ? 1 : 0;
}

// Remove leading and trailing ASCII whitespace (space, tab, newline, carriage
// return), in place.
void String_trim(String* self) {
    if (self.data == null) {   // a freed String: nothing to trim
        self.len = 0;
        return;
    }
    int64 start = 0;
    while (start < self.len && _string_ws(self.data[start]) == 1) {
        start++;
    }
    int64 end = self.len;
    while (end > start && _string_ws(self.data[end - 1]) == 1) {
        end--;
    }
    const int64 n = end - start;
    if (start > 0) {
        for (int64 i = 0; i < n; i++) {
            self.data[i] = self.data[start + i];
        }
    }
    self.len = n;
    self.data[n] = 0;
}

// Split on `sep`, one token at a time (streaming — no allocation per call).
// Start with `pos` = 0; each call fills `out` with the next token, advances
// `pos`, and returns 1. Returns 0 when there are no more tokens. Consecutive
// separators (and a trailing one) yield empty tokens.
//
//   let tok: String;  String_init(&tok, 8);
//   int pos = 0;
//   while (String_next_token(&s, ',', &pos, &tok) == 1) { /* use tok */ }
//   String_free(&tok);
int String_next_token(String* self, char sep, *int pos, String* out) {
    out.clear();
    int64 p = *pos;
    if (p > self.len) {
        return 0;
    }
    while (p < self.len && self.data[p] != sep) {
        out.push(self.data[p]);
        p++;
    }
    // Skip the separator; after the last token, move past the end so the next
    // call stops.
    *pos = p < self.len ? p + 1 : self.len + 1;
    return 1;
}

// Split on `sep`, collecting every part into `out` (a List<String> the caller
// has initialised). Each part is a freshly allocated String the list owns;
// consecutive separators yield empty parts. Free with String_split_free.
void String_split(String* self, char sep, List<String>* out) {
    let tok: String;
    tok.init(8);
    defer tok.free();
    int pos = 0;
    while (self.next_token(sep, &pos, &tok) == 1) {
        let copy: String;
        copy.init(8);
        _string_append_bytes(&copy, tok.data, tok.len);
        List_push<String>(out, copy);
    }
}

// Free every part of a split result, then the list itself.
void String_split_free(List<String>* parts) {
    for (i in 0..List_len<String>(parts)) {
        let p: String = List_get<String>(parts, i);
        p.free();
    }
    List_free<String>(parts);
}

// ── Scripting helpers ─────────────────────────────────────────────────────────
//
// Text-producing functions follow the stdlib rule: a String passed as `out` is
// cleared and refilled (the caller initialised it and frees it), and a String
// passed as `self` is edited in place. Split results are Lists of owned Strings,
// freed with String_split_free. Case mapping and padding work on bytes: only
// ASCII letters change case, and a multi-byte UTF-8 character counts as its
// byte length.

extern int vsnprintf(*char buf, size_t n, string fmt, va_list ap);
extern double strtod(string s, *string end);

// Make room for at least `need` bytes (the trailing NUL included). Contents are
// kept. Works on a freed String too (it gets a fresh buffer).
void String_reserve(String* self, int64 need) {
    if (self.data != null && self.cap >= need) {
        return;
    }
    int64 newcap = self.cap * 2;
    if (newcap < need) {
        newcap = need;
    }
    if (newcap < 8) {
        newcap = 8;
    }
    let nb: *char = alloc<char>(newcap);
    if (self.data != null) {
        memcpy(nb, self.data, self.len);
        free(self.data);
    } else {
        self.len = 0;
    }
    nb[self.len] = 0;
    self.data = nb;
    self.cap = newcap;
}

// Append `n` bytes starting at `p` (which may hold NULs).
void _string_append_bytes(String* self, *char p, int64 n) {
    if (n <= 0) {
        return;
    }
    const int64 so = (int64)p - (int64)self.data;
    const bool inside = self.data != null && so >= 0 && so <= self.len;
    String_reserve(self, self.len + n + 1);
    if (inside) {
        p = self.data + so;
    }
    memmove(self.data + self.len, p, n);
    self.len = self.len + n;
    self.data[self.len] = 0;
}

// First index at or after `from` where `needle` starts, or -1. An empty needle
// matches at `from` (clamped to 0..len).
int64 String_find(String* self, string needle, int64 from) {
    if (from < 0) {
        from = 0;
    }
    if (from > self.len) {
        return -1;
    }
    const int64 nl = strlen(needle);
    if (nl == 0) {
        return from;
    }
    for (int64 i = from; i + nl <= self.len; i++) {
        int64 k = 0;
        while (k < nl && self.data[i + k] == needle[k]) {
            k++;
        }
        if (k == nl) {
            return i;
        }
    }
    return -1;
}

// 1 if `needle` occurs in this String, else 0 (an empty needle always occurs).
int String_contains(String* self, string needle) {
    return String_find(self, needle, 0) >= 0 ? 1 : 0;
}

// Replace up to `limit` non-overlapping occurrences of `from`, scanning left to
// right (limit < 0: all). Returns the number replaced.
int64 _string_replace(String* self, string from, string to, int64 limit) {
    const int64 fl = strlen(from);
    if (fl == 0 || self.len == 0) {
        return 0;
    }
    if (String_find(self, from, 0) < 0) {
        return 0;
    }
    // `from` or `to` may point into our own buffer; the old buffer stays alive
    // until the result is built.
    let r: String;
    r.init(self.len + 1);
    int64 count = 0;
    int64 i = 0;
    while (i < self.len && (limit < 0 || count < limit)) {
        const int64 j = String_find(self, from, i);
        if (j < 0) {
            break;
        }
        _string_append_bytes(&r, self.data + i, j - i);
        r.append(to);
        i = j + fl;
        count++;
    }
    _string_append_bytes(&r, self.data + i, self.len - i);
    free(self.data);
    self.data = r.data;
    self.len = r.len;
    self.cap = r.cap;
    return count;
}

// Replace the first occurrence of `from` with `to`, in place. Returns 1 if one
// was replaced, else 0. An empty `from` replaces nothing.
int String_replace(String* self, string from, string to) {
    return (int)_string_replace(self, from, to, 1);
}

// Replace every non-overlapping occurrence of `from` (left to right: "aaa" with
// "aa" -> "b" gives "ba"), in place. Returns the count. An empty `from` replaces
// nothing.
int64 String_replace_all(String* self, string from, string to) {
    return _string_replace(self, from, to, -1);
}

// Push a copy of self[from..to) onto a List<String>.
void _string_push_part(String* self, int64 from, int64 to, List<String>* out) {
    let part: String;
    part.init(to - from + 1);
    _string_append_bytes(&part, self.data + from, to - from);
    List_push<String>(out, part);
}

// Split on the string `sep`, appending each part to `out` (a List<String> the
// caller has initialised) as a String the list owns. Like String_split,
// adjacent separators and separators at either end give empty parts. An empty
// `sep` gives the whole String as one part. Free with String_split_free.
void String_split_str(String* self, string sep, List<String>* out) {
    const int64 sl = strlen(sep);
    if (sl == 0) {
        _string_push_part(self, 0, self.len, out);
        return;
    }
    int64 i = 0;
    while (true) {
        const int64 j = String_find(self, sep, i);
        if (j < 0) {
            break;
        }
        _string_push_part(self, i, j, out);
        i = j + sl;
    }
    _string_push_part(self, i, self.len, out);
}

// Split into lines, appending each to `out` (an initialised List<String>; free
// with String_split_free). Lines end at "\n" or "\r\n"; the terminator is not
// kept. A final terminator does not start an extra empty line, and an empty
// String has no lines.
void String_lines(String* self, List<String>* out) {
    int64 i = 0;
    while (i < self.len) {
        int64 j = i;
        while (j < self.len && self.data[j] != '\n') {
            j++;
        }
        int64 end = j;
        if (end > i && self.data[end - 1] == '\r') {
            end--;
        }
        _string_push_part(self, i, end, out);
        i = j + 1;
    }
}

// Clear `out` and fill it with the C strings in `parts` joined by `sep`, called
// as `parts.join(sep, &out)`. The list keeps its strings (nothing is freed).
// Generic so the dot-call reaches it from a List<string>; only T = string
// type-checks.
void List_join<T>(List<T>* self, string sep, String* out) {
    out.clear();
    for (i in 0..List_len<T>(self)) {
        if (i > 0) {
            out.append(sep);
        }
        out.append(List_get<T>(self, i));
    }
}

// Clear self and fill it with the Strings in `parts` joined by `sep` (the
// inverse of String_split / String_split_str).
void String_join(String* self, List<String>* parts, string sep) {
    self.clear();
    for (i in 0..List_len<String>(parts)) {
        if (i > 0) {
            self.append(sep);
        }
        let p: String = List_get<String>(parts, i);
        _string_append_bytes(self, p.data, p.len);
    }
}

// ASCII lowercase, in place. Bytes outside 'A'..'Z' (UTF-8 included) are kept.
void String_lower(String* self) {
    for (int64 i = 0; i < self.len; i++) {
        const char c = self.data[i];
        if (c >= 'A' && c <= 'Z') {
            self.data[i] = (char)((int)c + 32);
        }
    }
}

// ASCII uppercase, in place. Bytes outside 'a'..'z' (UTF-8 included) are kept.
void String_upper(String* self) {
    for (int64 i = 0; i < self.len; i++) {
        const char c = self.data[i];
        if (c >= 'a' && c <= 'z') {
            self.data[i] = (char)((int)c - 32);
        }
    }
}

// Replace self with `n` copies of itself, in place (n <= 0 leaves it empty).
void String_repeat(String* self, int64 n) {
    if (n <= 0 || self.len == 0) {
        self.clear();
        return;
    }
    const int64 one = self.len;
    String_reserve(self, one * n + 1);
    for (int64 k = 1; k < n; k++) {
        memcpy(self.data + k * one, self.data, one);
    }
    self.len = one * n;
    self.data[self.len] = 0;
}

// Prepend `fill` until the String is `width` bytes long (no change if it
// already is), in place.
void String_pad_left(String* self, int64 width, char fill) {
    if (self.len >= width) {
        return;
    }
    const int64 add = width - self.len;
    String_reserve(self, width + 1);
    memmove(self.data + add, self.data, self.len);
    for (int64 i = 0; i < add; i++) {
        self.data[i] = fill;
    }
    self.len = width;
    self.data[width] = 0;
}

// Append `fill` until the String is `width` bytes long, in place.
void String_pad_right(String* self, int64 width, char fill) {
    while (self.len < width) {
        self.push(fill);
    }
}

// Parse a leading floating-point number (C strtod syntax: "3.5", "-1e3",
// "inf"); 0.0 when there is none.
double String_to_double(String* self) {
    if (self.data == null) {
        return 0.0;
    }
    return strtod((string)self.data, null);
}

// Parse the whole String as a floating-point number, allowing surrounding
// ASCII whitespace. Stores it in *out and returns 1, or returns 0 (and leaves
// *out alone) when the String is not exactly one number.
int String_parse_double(String* self, *double out) {
    if (self.data == null || self.len == 0) {
        return 0;
    }
    string end = null;
    const double v = strtod((string)self.data, &end);
    int64 p = (int64)end - (int64)self.data;
    if (p == 0) {
        return 0;
    }
    while (p < self.len && _string_ws(self.data[p]) == 1) {
        p++;
    }
    if (p != self.len) {
        return 0;
    }
    out[0] = v;
    return 1;
}

#ifdef _WIN32
// msvcrt's vsnprintf is not C99: "%g" of 1e6 is "1e+006" and infinity is
// "1.#INF". mingw-w64's own implementation follows C99, so every platform
// prints the same text.
extern int __mingw_vsnprintf(*char buf, size_t n, string fmt, va_list ap);
#endif

// vsnprintf into the spare room after the current contents; returns the length
// the formatted text needs (it may not all fit).
int _string_vwrite(String* self, string fmt, va_list ap) {
#ifdef _WIN32
    return __mingw_vsnprintf(self.data + self.len, self.cap - self.len, fmt, ap);
#else
    return vsnprintf(self.data + self.len, self.cap - self.len, fmt, ap);
#endif
}

// printf-style append: `s.appendf("%s=%d\n", k, v)`. Uses the C library's
// vsnprintf, so the format follows C (pass `int64` with %lld, a String as
// `s.cstr()` with %s, floats arrive as double).
void String_appendf(String* self, string fmt, ...) {
    String_reserve(self, self.len + 128);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(self, fmt, ap);
    va_end(ap);
    if (n < 0) {
        self.data[self.len] = 0;
        return;
    }
    if (self.len + (int64)n >= self.cap) {
        String_reserve(self, self.len + (int64)n + 1);
        va_start(ap);
        _string_vwrite(self, fmt, ap);
        va_end(ap);
    }
    self.len = self.len + (int64)n;
}

// printf-style formatting into self (cleared first): `s.format("%d", n)`. See
// String_appendf.
void String_format(String* self, string fmt, ...) {
    self.clear();
    String_reserve(self, 128);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(self, fmt, ap);
    va_end(ap);
    if (n < 0) {
        self.data[0] = 0;
        return;
    }
    if ((int64)n >= self.cap) {
        String_reserve(self, (int64)n + 1);
        va_start(ap);
        _string_vwrite(self, fmt, ap);
        va_end(ap);
    }
    self.len = (int64)n;
}

// Render a double into self: the shortest of %.15g / %.17g that reads back as
// the same value ("0.1", "3", "1e+20", "inf", "nan").
void String_from_double(String* self, double d) {
    String_format(self, "%.15g", d);
    if (strtod((string)self.data, null) != d) {
        String_format(self, "%.17g", d);
    }
}
