// sysheap.esk — a general-purpose heap backed by OS pages, with no libc malloc.
//
// This is how "real" systems allocators work (Zig's page_allocator, jemalloc, the
// Go runtime): get raw pages straight from the kernel via `mmap`, then run our own
// allocator (`<alloc>`'s FirstFit) on top. The allocation *logic* is ours — libc
// `malloc` is never called. (`mmap` itself is a libc syscall wrapper; for a build
// with no libc symbols at all, use `--freestanding` and supply your own
// `esk_alloc` over a fixed region — see `kernel/alloc.esk`.)
//
//   let h: Heap;
//   if (Heap_init(&h, 1024 * 1024)) {                 // 1 MB straight from the OS
//       *int xs = (*int)Heap_alloc(&h, sizeof(int) * 16);
//       // ... use xs ...
//       Heap_free(&h, (*void)xs);
//       Heap_destroy(&h);                             // returns the pages to the OS
//   }

import <ctypes>;
import <alloc>;

#ifdef _WIN32
// Windows has no mmap; carve pages straight from the OS with VirtualAlloc / VirtualFree
// (kernel32). VirtualAlloc with MEM_COMMIT hands back zeroed memory, like an anonymous mmap.
extern *void VirtualAlloc(*void addr, size_t size, int alloc_type, int protect);
extern int VirtualFree(*void addr, size_t size, int free_type);

// Map `length` bytes of fresh zeroed read/write memory from the kernel, or null.
*uint8 sys_pages(int64 length) {
    // MEM_COMMIT|MEM_RESERVE = 0x1000|0x2000 = 12288; PAGE_READWRITE = 4.
    *void p = VirtualAlloc(null, length, 12288, 4);
    return (*uint8)p;               // null on failure
}

// MEM_RELEASE = 0x8000 = 32768; the size must be 0 for a full release.
void _sys_unpages(*uint8 p, int64 length) {
    VirtualFree((*void)p, 0, 32768);
}
#else
extern *void mmap(*void addr, size_t length, int prot, int flags, int fd, int64 offset);
extern int munmap(*void addr, size_t length);

// PROT_READ|PROT_WRITE = 3 (same on Linux and macOS). The anonymous-private flags
// differ: macOS MAP_PRIVATE(0x0002)|MAP_ANON(0x1000); Linux uses MAP_ANONYMOUS(0x0020).
#ifdef __APPLE__
const int _sys_map_flags = 4098;     // 0x1002
#else
const int _sys_map_flags = 34;       // 0x0022
#endif

// Map `length` bytes of fresh zeroed read/write memory from the kernel, or null.
// mmap reports failure as MAP_FAILED (== (void*)-1), not null — check both.
*uint8 sys_pages(int64 length) {
    *void p = mmap(null, length, 3, _sys_map_flags, -1, 0);
    const int64 pv = (int64)p;
    if (pv == 0 || pv == -1) {
        return null;
    }
    return (*uint8)p;
}

void _sys_unpages(*uint8 p, int64 length) {
    munmap((*void)p, length);
}
#endif

// A general-purpose heap: one OS mapping with FirstFit allocation over it.
struct Heap {
    FirstFit ff;
    *uint8 base;
    int64 size;
}

// Map `size` bytes from the OS and arm a FirstFit allocator over them. Returns
// false if the mapping failed.
bool Heap_init(Heap* self, int64 size) {
    *uint8 mem = sys_pages(size);
    if (mem == null) {
        return false;
    }
    self.base = mem;
    self.size = size;
    self.ff.init(mem, size);
    return true;
}

*void Heap_alloc(Heap* self, int64 nbytes) {
    return self.ff.alloc(nbytes);
}

void Heap_free(Heap* self, *void p) {   // null is a no-op
    self.ff.free(p);
}

// Return all the heap's pages to the OS. Frees everything at once.
void Heap_destroy(Heap* self) {
    _sys_unpages(self.base, self.size);
}
