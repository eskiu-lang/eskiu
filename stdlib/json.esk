// json.esk — a complete JSON module: a builder (writer) and a parser (reader).
//
// Builder — `Json` accumulates text; separators are inserted automatically:
//   let j: Json;  Json_init(&j);
//   Json_obj_begin(&j);
//     Json_key(&j, "name"); Json_str(&j, "Eskiu");
//     Json_key(&j, "year"); Json_int(&j, 2026);
//   Json_obj_end(&j);
//   printf("%s\n", Json_cstr(&j));    // {"name":"Eskiu","year":2026}
//   Json_free(&j);
//
// Parser — `json_parse` returns a `*JsonValue` tree (null on error):
//   *JsonValue v = json_parse(text);
//   *JsonValue name = JsonValue_get(v, "name");   // object lookup
//   printf("%s\n", JsonValue_as_cstr(name));
//   JsonValue_free(v);
//
// To only read a document, `json_parse_doc` is faster: its nodes and strings come
// from one arena, freed together by JsonDoc_free (the document is read-only):
//   JsonDoc d = json_parse_doc(text);
//   if (d.root != null) { ... JsonValue_get(d.root, "name") ... }
//   JsonDoc_free(&d);

import <c/stdlib>;   // atof
import <string>;
import <result>;

// ── Builder ──────────────────────────────────────────────────────────────────

struct Json {
    String buf;
}

void Json_init(Json* self) {
    self.buf.init(64);
}

void Json_free(Json* self) {
    self.buf.free();
}

*char Json_cstr(Json* self) {
    return self.buf.cstr();
}

// Insert a separating comma unless the last byte is an opener or a key colon.
void _Json_sep(Json* self) {
    const int64 n = self.buf.len;
    if (n == 0) {
        return;
    }
    const char last = self.buf.data[n - 1];
    if (last == '{' || last == '[' || last == ':' || last == ',') {
        return;
    }
    self.buf.push(',');
}

// Append `n` bytes at `s` to `out` as a JSON string literal: `"` and backslash
// are escaped, and every control byte below 0x20 (NUL included) becomes
// \n \t \r \b \f or \u00XX (RFC 8259 §7). Other bytes are copied as they are.
void _json_escape(String* out, *char s, int64 n) {
    out.reserve(out.len + n + 3);
    int64 i = 0;
    while (i < n) {
        const int b = (int)(uint8)s[i];
        if (b < 32 || b == 34 || b == 92) {
            break;
        }
        i++;
    }
    if (i == n) {
        // Nothing to escape: the quoted bytes go straight into the buffer.
        *char w = out.data + out.len;
        w[0] = '"';
        memcpy(w + 1, s, n);
        w[n + 1] = '"';
        w[n + 2] = (char)0;
        out.len = out.len + n + 2;
        return;
    }
    out.push('"');
    i = 0;
    while (i < n) {
        // Copy the run of bytes that need no escape in one go.
        int64 j = i;
        while (j < n) {
            const int b = (int)(uint8)s[j];
            if (b < 32 || b == 34 || b == 92) {
                break;
            }
            j++;
        }
        if (j > i) {
            out.append_bytes(s + i, j - i);
        }
        if (j >= n) {
            break;
        }
        const char c = s[j];
        const int u = (int)(uint8)c;
        if (c == '"' || c == '\\') {
            out.push('\\');
            out.push(c);
        }
        else if (c == '\n') {
            out.append("\\n");
        }
        else if (c == '\t') {
            out.append("\\t");
        }
        else if (c == '\r') {
            out.append("\\r");
        }
        else if (u == 8) {
            out.append("\\b");
        }
        else if (c == '\f') {
            out.append("\\f");
        }
        else {
            out.append("\\u00");
            out.push("0123456789abcdef"[u >> 4]);
            out.push("0123456789abcdef"[u & 15]);
        }
        i = j + 1;
    }
    out.push('"');
}

// Append a JSON string literal for the C string `s` (see _json_escape).
void Json_raw_str(Json* self, string s) {
    _json_escape(&self.buf, (*char)s, strlen(s));
}

void Json_obj_begin(Json* self) {
    _Json_sep(self);
    self.buf.push('{');
}

void Json_obj_end(Json* self) {
    self.buf.push('}');
}

void Json_arr_begin(Json* self) {
    _Json_sep(self);
    self.buf.push('[');
}

void Json_arr_end(Json* self) {
    self.buf.push(']');
}

// Object key: emits "key": — the following value attaches without a comma.
void Json_key(Json* self, string k) {
    _Json_sep(self);
    Json_raw_str(self, k);
    self.buf.push(':');
}

void Json_str(Json* self, string v) {
    _Json_sep(self);
    Json_raw_str(self, v);
}

// Append the full int64 (no truncation to 32 bits; INT64_MIN included).
void Json_int(Json* self, int64 v) {
    _Json_sep(self);
    String* out = &self.buf;
    uint64 mag = (uint64)v;
    if (v < 0) {
        out.push('-');
        mag = (uint64)0 - (uint64)v;
    }
    // Collect the digits least significant first, then emit them in reverse.
    let digits: char[20];
    int n = 0;
    do {
        digits[n++] = (char)('0' + (int)(mag % 10));
        mag /= 10;
    } while (mag > 0);
    while (n > 0) {
        out.push(digits[--n]);
    }
}

void Json_bool(Json* self, int b) {
    _Json_sep(self);
    self.buf.append(b != 0 ? "true" : "false");
}

void Json_null(Json* self) {
    _Json_sep(self);
    self.buf.append("null");
}

// ── Parsed value tree ────────────────────────────────────────────────────────

enum JsonKind { JNull, JBool, JNumber, JString, JArray, JObject }

// A node uses first-child / next-sibling links, so arrays and objects need no
// generic containers. Object members carry their `key`; everything else leaves
// it empty. `str`/`key` own their buffers (data == null when unused).
// A container also keeps hints so that appending, `JsonValue_len` and walking
// `JsonValue_at(v, 0..n)` are linear overall: its last child and the count up to it
// (`_tail`, `_n`) and the child the last `JsonValue_at` returned (`_at`, `_at_i`).
// Children appended through `next` by hand are found by walking on from `_tail`;
// remove children with the JsonValue_ functions, which reset the hints.
struct JsonValue {
    int kind;
    double num;       // JNumber
    int boolean;   // JBool
    String str;       // JString value
    String key;       // set when this node is an object member
    *JsonValue child;     // first array element / object member
    *JsonValue next;      // next sibling
    *JsonValue _tail;
    int _n;
    *JsonValue _at;
    int _at_i;
    int _arena;       // 1: part of a JsonDoc, which owns it and its strings
}

// alloc zero-fills, so num is 0, boolean is 0, and str/key/child/next are null.
*JsonValue JsonValue_new(int kind) {
    *JsonValue v = alloc<JsonValue>(1);
    v.kind = kind;
    return v;
}

// Free a value tree (safe on null). Fully iterative, so neither a long array
// nor deep nesting recurses: a node's children are spliced into the work list
// in front of its siblings before the node is freed (each child chain is walked
// once to find its tail, so the whole free is linear).
void JsonValue_free(JsonValue* v) {
    if (v != null && v._arena == 1) {
        return;                         // its JsonDoc frees it
    }
    while (v != null) {
        if (v.child != null) {
            *JsonValue last = v.child;
            while (last.next != null) {
                last = last.next;
            }
            last.next = v.next;
            v.next = v.child;
            v.child = null;
        }
        *JsonValue nx = v.next;
        if (v.str.data != null) {
            v.str.free();
        }
        if (v.key.data != null) {
            v.key.free();
        }
        free(v);
        v = nx;
    }
}

int JsonValue_kind(JsonValue* v) {
    return v.kind;
}

// Bring `_tail` / `_n` up to date: walk on from the last known child (or from the
// first when there is none) to the end.
void _json_sync_tail(JsonValue* v) {
    *JsonValue t = v._tail;
    int n = v._n;
    if (t == null) {
        t = v.child;
        n = t != null ? 1 : 0;
    }
    if (t == null) {
        return;
    }
    while (t.next != null) {
        t = t.next;
        n++;
    }
    v._tail = t;
    v._n = n;
}

// Forget the hints after children were replaced or removed.
void _json_reset_hints(JsonValue* v) {
    v._tail = null;
    v._n = 0;
    v._at = null;
    v._at_i = 0;
}

// Number of array elements / object members.
int JsonValue_len(JsonValue* v) {
    _json_sync_tail(v);
    return v._n;
}

// The i-th array element (or object member), or null if out of range. Walking
// i = 0, 1, 2, ... continues from the previous answer, so a loop over a container
// is linear.
*JsonValue JsonValue_at(JsonValue* v, int i) {
    if (i < 0) {
        return null;
    }
    *JsonValue c = v.child;
    int j = 0;
    if (v._at != null && v._at_i <= i) {
        c = v._at;
        j = v._at_i;
    }
    while (c != null && j < i) {
        c = c.next;
        j++;
    }
    if (c != null) {
        v._at = c;
        v._at_i = i;
    }
    return c;
}

// The object member whose key equals `key`, or null.
*JsonValue JsonValue_get(JsonValue* v, string key) {
    for (*JsonValue c = v.child; c != null; c = c.next) {
        if (c.key.data != null && c.key.eq_cstr(key) == 1) {
            return c;
        }
    }
    return null;
}

int64 JsonValue_as_int(JsonValue* v) {
    return (int64)v.num;
}

double JsonValue_as_double(JsonValue* v) {
    return v.num;
}

int JsonValue_as_bool(JsonValue* v) {
    return v.boolean;
}

*char JsonValue_as_cstr(JsonValue* v) {
    return v.str.cstr();
}

// The rest of json.esk, in these parts (imported in order):
import "_json/parser.esk";
import "_json/edit.esk";
import "_json/ryu_tables.esk";
import "_json/number.esk";
