#elif defined(__wasm__)   // emscripten and WASI (musl's wasm32 layout)
int _fs_stat_raw(string p, *void b) {
    return stat(p, b);
}

int _fs_lstat_raw(string p, *void b) {
    return lstat(p, b);
}

int _fs_fstat_raw(int fd, *void b) {
    return fstat(fd, b);
}

int _fs_lstatat_raw(int dfd, string name, *void b) {   // AT_SYMLINK_NOFOLLOW
    return fstatat(dfd, name, b, 256);
}
#define _FS_HAVE_STAT 1
#define _FS_O_DIRFD 722944   // O_RDONLY | O_NONBLOCK | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC
#define _FS_AT_REMOVEDIR 512
#define _FS_ST_MODE 4
#define _FS_ST_MTIME 56
#define _FS_ST_SIZE 24
#define _FS_ST_DEV_SIZE 4
#define _FS_ST_INO 88
#define _FS_DIRENT_NAME 19
#else
#define _FS_DIRENT_NAME 11
#endif
#endif
#ifndef _FS_ST_INO
#define _FS_ST_INO 8
#endif
// ENOENT: WebAssembly numbers errno as WASI does.
#ifdef __wasm__
#define _FS_ENOENT 44
#else
#define _FS_ENOENT 2
#endif

// The failure state behind fs_last_error / fs_errno.
int _fs_err = 0;
bool _fs_err_win = false;   // Windows: _fs_err is a GetLastError code, not an errno

int _fs_errno_now() {
    return _c_errno();
}

#ifdef _WIN32
int _fs_fail_os() {
    _fs_err = (int)GetLastError();
    _fs_err_win = true;
    return -1;
}
#else
int _fs_fail_os() {
    _fs_err = _fs_errno_now();
    _fs_err_win = false;
    return -1;
}
#endif
int _fs_fail_crt() {
    _fs_err = _fs_errno_now();
    _fs_err_win = false;
    return -1;
}

// The OS error code of the last failing fs_* call (errno, or GetLastError on
// Windows for the calls that go through the Win32 API); 0 if none failed yet.
int fs_errno() {
    return _fs_err;
}

// A readable message for the last failing fs_* call ("No such file or directory").
void fs_last_error(String* out) {
    out.clear();
    if (_fs_err == 0) {
        out.append("no error");
        return;
    }
#ifdef _WIN32
    if (_fs_err_win) {
        *uint8 buf = alloc<uint8>(512);
        // FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS
        uint32 n = FormatMessageA((uint32)4608, null, (uint32)_fs_err, (uint32)0, buf, (uint32)511, null);
        while (n > 0 && (buf[n - 1] == 10 || buf[n - 1] == 13 || buf[n - 1] == 32 || buf[n - 1] == 46)) {
            n--;
        }
        buf[n] = 0;
        if (n == 0) {
            out.append("Windows error");
        } else {
            out.append((string)buf);
        }
        free((*void)buf);
        return;
    }
#endif
    out.append(strerror(_fs_err));
}

// Append n raw bytes to a String (NUL bytes included), keeping it NUL-terminated.
void _fs_append_bytes(String* s, *uint8 p, int64 n) {
    if (n <= 0) {
        return;
    }
    if (s.len + n + 1 > s.cap) {
        int64 ncap = s.cap * 2;
        if (ncap < s.len + n + 1) {
            ncap = s.len + n + 1;
        }
        *char nd = alloc<char>(ncap);
        if (s.data != null) {
            memcpy((*void)nd, (*void)s.data, s.len);
            free((*void)s.data);
        }
        s.data = nd;
        s.cap = ncap;
    }
    memcpy((*void)(s.data + s.len), (*void)p, n);
    s.len += n;
    s.data[s.len] = 0;
}

#ifdef _WIN32
// UTF-8 -> a NUL-terminated UTF-16 copy (free it), or null if `s` is not valid.
*uint16 _fs_wide(string s) {
    const int n = MultiByteToWideChar((uint32)65001, (uint32)0, s, -1, null, 0);
    if (n <= 0) {
        return null;
    }
    *uint16 w = alloc<uint16>((int64)n + 1);
    MultiByteToWideChar((uint32)65001, (uint32)0, s, -1, w, n);
    return w;
}

// _fs_wide for a path handed to a file API: a path whose absolute form is 248
// characters or more (the limit of CreateDirectoryW; MAX_PATH is 260) becomes
// that absolute form with the \\?\ prefix (\\?\UNC\ for \\server\share), so it
// is not cut at MAX_PATH. GetFullPathNameW resolves it first (relative to the
// current directory, '/' to '\', "." and ".."), since the prefix turns that off.
// A shorter path is converted as given, so it behaves as before.
*uint16 _fs_wpath(string s) {
    *uint16 w = _fs_wide(s);
    if (w == null) {
        return null;
    }
    if (w[0] == (uint16)92 && w[1] == (uint16)92 && (w[2] == (uint16)63 || w[2] == (uint16)46)) {   // \\?\ or \\.\ already
        return w;
    }
    const uint32 need = GetFullPathNameW(w, (uint32)0, null, null);   // characters with the NUL
    if (need < (uint32)249) {
        return w;
    }
    *uint16 full = alloc<uint16>((int64)need + 1);
    const uint32 got = GetFullPathNameW(w, need, full, null);
    if (got == (uint32)0 || got >= need) {
        free((*void)full);
        return w;
    }
    const bool unc = full[0] == (uint16)92 && full[1] == (uint16)92 && full[2] != (uint16)63 && full[2] != (uint16)46;
    const bool drive = full[1] == (uint16)58 && full[2] == (uint16)92;
    if (!unc && !drive) {
        free((*void)full);
        return w;
    }
    *uint16 res = alloc<uint16>((int64)got + 9);
    res[0] = (uint16)92;
    res[1] = (uint16)92;
    res[2] = (uint16)63;
    res[3] = (uint16)92;
    int64 at = 4;
    int64 from = 0;
    if (unc) {
        // \\?\UNC followed by full[1..], which is \server\share\...
        res[4] = (uint16)85;
        res[5] = (uint16)78;
        res[6] = (uint16)67;
        at = 7;
        from = 1;
    }
    memcpy((*void)(res + at), (*void)(full + from), ((int64)got - from) * 2);
    res[at + (int64)got - from] = (uint16)0;
    free((*void)full);
    free((*void)w);
    return res;
}

// Append n UTF-16 units (no NUL needed) to `out` as UTF-8.
void _fs_append_wide_n(String* out, *uint16 w, int n) {
    if (n <= 0) {
        return;
    }
    const int m = WideCharToMultiByte((uint32)65001, (uint32)0, w, n, null, 0, null, null);
    if (m <= 0) {
        return;
    }
    *uint8 b = alloc<uint8>((int64)m + 1);
    WideCharToMultiByte((uint32)65001, (uint32)0, w, n, b, m, null, null);
    _fs_append_bytes(out, b, (int64)m);
    free((*void)b);
}

// Append a NUL-terminated UTF-16 string to `out` as UTF-8.
void _fs_append_wide(String* out, *uint16 w) {
    const int n = WideCharToMultiByte((uint32)65001, (uint32)0, w, -1, null, 0, null, null);
    if (n <= 1) {
        return;
    }
    *uint8 b = alloc<uint8>((int64)n);
    WideCharToMultiByte((uint32)65001, (uint32)0, w, -1, b, n, null, null);
    out.append((string)b);
    free((*void)b);
}

int64 _fs_u32_at(*uint8 b, int off) {
    let v: uint32 = (uint32)0;
    memcpy((*void)&v, (*void)(b + off), 4);
    return (int64)v;
}

// FILETIME (100 ns ticks since 1601) at b[off] -> Unix epoch seconds.
int64 _fs_filetime_at(*uint8 b, int off) {
    const int64 t = _fs_u32_at(b, off) | (_fs_u32_at(b, off + 4) << 32);
    return (t - 116444736000000000) / 10000000;
}
#endif

// fopen with a UTF-8 path on every platform (_wfopen on Windows).
*void _fs_fopen(string path, string mode) {
#ifdef _WIN32
    *uint16 wp = _fs_wpath(path);
    *uint16 wm = _fs_wide(mode);
    *void fp = null;
    if (wp != null && wm != null) {
        fp = _wfopen(wp, wm);
    }
    free((*void)wp);
    free((*void)wm);
    return fp;
#else
    return fopen(path, mode);
#endif
}

// ── Text files ────────────────────────────────────────────────────────────

// Read the whole file into `out` (cleared first). Returns 0, or -1 on failure.
int fs_read_text(string path, String* out) {
    out.clear();
    *void fp = _fs_fopen(path, "rb");
    if (fp == null) {
        return _fs_fail_crt();
    }
    defer fclose(fp);
    *uint8 buf = alloc<uint8>(65536);
    defer free((*void)buf);
    while (true) {
        const int64 got = fread((*void)buf, 1, 65536, fp);
        if (got <= 0) {
            break;
        }
        _fs_append_bytes(out, buf, got);
    }
    if (ferror(fp) != 0) {
        return _fs_fail_crt();
    }
    return 0;
}

int _fs_write_mode(string path, string text, string mode) {
    *void fp = _fs_fopen(path, mode);
    if (fp == null) {
        return _fs_fail_crt();
    }
    const int64 n = strlen(text);
    const int64 w = n > 0 ? fwrite((*void)text, 1, n, fp) : 0;
    if (w != n) {
        _fs_fail_crt();
        fclose(fp);
        return -1;
    }
    if (fclose(fp) != 0) {
        return _fs_fail_crt();
    }
    return 0;
}

// Replace the file's contents with `text` (created if missing). 0 or -1.
int fs_write_text(string path, string text) {
    return _fs_write_mode(path, text, "wb");
}

// Append `text` to the file (created if missing). 0 or -1.
int fs_append_text(string path, string text) {
    return _fs_write_mode(path, text, "ab");
}

// Append each line of the file to `out` as a new String, without its "\n" or
// "\r\n". A final line without a newline counts; an empty file adds none.
// Free the list with fs_list_free. Returns 0, or -1 on failure.
int fs_read_lines(string path, List<String>* out) {
    let text: String;
    text.init(256);
    defer text.free();
    if (fs_read_text(path, &text) != 0) {
        return -1;
    }
    int64 start = 0;
    for (int64 i = 0; i <= text.len; i++) {
        if (i == text.len && start == text.len) {
            break;
        }
        if (i == text.len || text.data[i] == '\n') {
            int64 end = i;
            if (end > start && text.data[end - 1] == '\r') {
                end--;
            }
            let line: String;
            line.init(end - start + 1);
            _fs_append_bytes(&line, (*uint8)(text.data + start), end - start);
            List_push<String>(out, line);
            start = i + 1;
        }
    }
    return 0;
}

// Free every String in a list filled by fs_read_lines, fs_list_dir or fs_glob,
// then the list itself.
void fs_list_free(List<String>* list) {
    for (i in 0..List_len<String>(list)) {
        let s: String = List_get<String>(list, i);
        s.free();
    }
    List_free<String>(list);
}

// ── Paths and directories ─────────────────────────────────────────────────

// Metadata of a path (fs_stat follows symbolic links, fs_lstat does not).
// mtime is in Unix epoch seconds; mode holds the permission bits (0o7777 on
// POSIX; on Windows 0o444 for a read-only file, else 0o666, plus 0o111 for a
// directory).
struct FileStat {
    int64 size;
    int64 mtime;
    int mode;
    bool is_dir;
    bool is_file;
    bool is_symlink;
}

int _fs_stat_impl(string path, FileStat* out, bool follow) {
    out.size = 0;
    out.mtime = 0;
    out.mode = 0;
    out.is_dir = false;
    out.is_file = false;
    out.is_symlink = false;
#ifdef _WIN32
    *uint16 w = _fs_wpath(path);
    if (w == null) {   // ERROR_INVALID_NAME
        _fs_err = 123;
        _fs_err_win = true;
        return -1;
    }
    int64[8] raw;
    *uint8 b = (*uint8)&raw;
    const int ok = GetFileAttributesExW(w, 0, (*void)b);
    free((*void)w);
    if (ok == 0) {
        return _fs_fail_os();
    }
    const int64 attrs = _fs_u32_at(b, 0);
    out.is_dir = (attrs & _FS_ATTR_DIRECTORY) != 0;
    out.is_file = !out.is_dir;
    out.is_symlink = !follow && (attrs & _FS_ATTR_REPARSE) != 0;
    out.mtime = _fs_filetime_at(b, 20);
    out.size = out.is_dir ? 0 : (_fs_u32_at(b, 28) << 32) | _fs_u32_at(b, 32);
    out.mode = (attrs & _FS_ATTR_READONLY) != 0 ? 292 : 438;
    if (out.is_dir) {
        out.mode = out.mode | 73;
    }
    return 0;
#else
#ifdef _FS_HAVE_STAT
    int64[32] raw;
    *uint8 b = (*uint8)&raw;
    const int r = follow ? _fs_stat_raw(path, (*void)b) : _fs_lstat_raw(path, (*void)b);
    if (r != 0) {
        return _fs_fail_os();
    }
#ifdef _FS_ST_MODE16
    let m16: uint16 = (uint16)0;
    memcpy((*void)&m16, (*void)(b + _FS_ST_MODE), 2);
    const int mode = (int)m16;
#else
    let m32: uint32 = (uint32)0;
    memcpy((*void)&m32, (*void)(b + _FS_ST_MODE), 4);
    const int mode = (int)m32;
#endif
    let size: int64 = 0;
    memcpy((*void)&size, (*void)(b + _FS_ST_SIZE), 8);
    let mtime: int64 = 0;
    memcpy((*void)&mtime, (*void)(b + _FS_ST_MTIME), 8);
    const int kind = mode & 61440;
    out.is_dir = kind == 16384;
    out.is_file = kind == 32768;
    out.is_symlink = kind == 40960;
    out.mode = mode & 4095;
    out.size = size;
    out.mtime = mtime;
    return 0;
#else
    *void d = opendir(path);
    if (d != null) {
        closedir(d);
        out.is_dir = true;
        return 0;
    }
    *void fp = fopen(path, "rb");
    if (fp == null) {
        return _fs_fail_os();
    }
    out.is_file = true;
    out.size = fs_size(fp);
    fclose(fp);
    return 0;
#endif
#endif
}

// Fill `out` with the metadata of `path`, following symbolic links. 0 or -1.
int fs_stat(string path, FileStat* out) {
    return _fs_stat_impl(path, out, true);
}

// Like fs_stat, but a symbolic link describes the link itself (is_symlink).
int fs_lstat(string path, FileStat* out) {
    return _fs_stat_impl(path, out, false);
}

// 1 if the path names an existing file or directory (links followed), else 0.
int fs_exists(string path) {
    let st: FileStat;
    return _fs_stat_impl(path, &st, true) == 0 ? 1 : 0;
}

// 1 if the path is a directory (links followed), else 0.
int fs_is_dir(string path) {
    let st: FileStat;
    return _fs_stat_impl(path, &st, true) == 0 && st.is_dir ? 1 : 0;
}

// 1 if the path is a regular file (links followed), else 0.
int fs_is_file(string path) {
    let st: FileStat;
    return _fs_stat_impl(path, &st, true) == 0 && st.is_file ? 1 : 0;
}

// Create one directory (its parent must exist). 0 or -1 (also if it exists).
int fs_mkdir(string path) {
#ifdef _WIN32
    *uint16 w = _fs_wpath(path);
    const int ok = w != null ? CreateDirectoryW(w, null) : 0;
    free((*void)w);
    return ok != 0 ? 0 : _fs_fail_os();
#else
    return mkdir(path, (_fs_mode_t)511) == 0 ? 0 : _fs_fail_os();
#endif
}

bool _fs_is_sep(char c) {
#ifdef _WIN32
    return c == '/' || c == '\\';
#else
    return c == '/';
#endif
}

// Create a directory and every missing parent ("mkdir -p"). An existing
// directory is success. 0 or -1.
int fs_mkdir_p(string path) {
    const int64 n = strlen(path);
    if (n == 0) {   // ENOENT
        _fs_err = 2;
        _fs_err_win = false;
        return -1;
    }
    let part: String;
    part.init(n + 1);
    defer part.free();
    for (int64 i = 0; i <= n; i++) {
        if (i == n || (_fs_is_sep(path[i]) && i > 0)) {
            if (part.len > 0 && fs_is_dir(part.cstr()) == 0) {
                if (fs_mkdir(part.cstr()) != 0) {
                    const int e = _fs_err;
                    const bool ew = _fs_err_win;
                    if (fs_is_dir(part.cstr()) == 0) {   // the mkdir error, not the check's
                        _fs_err = e;
                        _fs_err_win = ew;
                        return -1;
                    }
                }
            }
        }
        if (i < n) {
            part.push(path[i]);
        }
    }
    return 0;
}

// Remove a file or an empty directory. 0 or -1.
int fs_remove(string path) {
#ifdef _WIN32
    *uint16 w = _fs_wpath(path);
    if (w == null) {
        _fs_err = 123;
        _fs_err_win = true;
        return -1;
    }
    const uint32 attrs = GetFileAttributesW(w);
    int ok = 0;
    if (attrs != (uint32)4294967295 && ((int64)attrs & _FS_ATTR_DIRECTORY) != 0) {
        ok = RemoveDirectoryW(w);
    } else {
        ok = DeleteFileW(w);
    }
    free((*void)w);
    return ok != 0 ? 0 : _fs_fail_os();
#else
    let st: FileStat;
    if (_fs_stat_impl(path, &st, false) != 0) {
        return -1;
    }
    if (st.is_dir) {
        return rmdir(path) == 0 ? 0 : _fs_fail_os();
    }
    return unlink(path) == 0 ? 0 : _fs_fail_os();
#endif
}

// Join `dir` and `name` with one separator into `out` (cleared first).
void _fs_join(String* out, string dir, string name) {
    out.clear();
    out.append(dir);
    if (out.len > 0 && !_fs_is_sep(out.data[out.len - 1])) {
        out.push('/');
    }
    out.append(name);
}

#if !defined(_WIN32) && defined(_FS_HAVE_STAT)
// ── Directory trees through descriptors ──────────────────────────────────────
//
// fs_remove_all and fs_walk go down a tree one open directory at a time: each
// entry is looked up relative to its directory's descriptor (fstatat, openat with
// O_NOFOLLOW), never by a path from the root. So a directory swapped for a
// symbolic link while the walk runs is never entered (rm -rf could otherwise
// delete outside the tree), and the depth is not limited by PATH_MAX. Only one
// directory is open at a time: going back up opens ".." and checks it is the
// directory the walk came from.

struct _FsLevel {
    List<String> names;   // the entries, sorted
    int next;           // the next one to visit
    int64 dev;            // identity of this directory
    int64 ino;
    int64 path_len;       // fs_walk: length of this directory's path
}

// A stat buffer's file kind: 1 for a directory, 0 for anything else.
bool _fs_raw_is_dir(*uint8 b) {
#ifdef _FS_ST_MODE16
    let m16: uint16 = (uint16)0;
    memcpy((*void)&m16, (*void)(b + _FS_ST_MODE), 2);
    return ((int)m16 & 61440) == 16384;
#else
    let m32: uint32 = (uint32)0;
    memcpy((*void)&m32, (*void)(b + _FS_ST_MODE), 4);
    return ((int)m32 & 61440) == 16384;
#endif
}

// The device and inode of an open file (as _fs_same_file reads them). 0 or -1.
int _fs_fd_id(int fd, *int64 dev, *int64 ino) {
    int64[32] raw;
    *dev = 0;
    *ino = 0;
    if (_fs_fstat_raw(fd, (*void)&raw) != 0) {
        return -1;
    }
    memcpy((*void)dev, (*void)&raw, _FS_ST_DEV_SIZE);
    memcpy((*void)ino, (*void)((*uint8)&raw + _FS_ST_INO), 8);
    return 0;
}

// Push a level for the open directory `fd`: its identity and sorted entries.
int _fs_level_push(List<_FsLevel>* levels, int fd, int64 path_len) {
    let lv: _FsLevel;
    List_init<String>(&lv.names, 16);
    lv.next = 0;
    lv.path_len = path_len;
    if (_fs_fd_id(fd, &lv.dev, &lv.ino) != 0) {
        List_free<String>(&lv.names);
        return _fs_fail_os();
    }
    const int lfd = openat(fd, ".", _FS_O_DIRFD);   // fdopendir owns its descriptor
    if (lfd < 0) {
        List_free<String>(&lv.names);
        return _fs_fail_os();
    }
    *void d = fdopendir(lfd);
    if (d == null) {
        const int e = _fs_fail_os();
        close(lfd);
        List_free<String>(&lv.names);
        return e;
    }
    while (true) {
        *uint8 ent = (*uint8)readdir(d);
        if (ent == null) {
            break;
        }
        string nm = (string)(ent + _FS_DIRENT_NAME);
        if (strcmp(nm, ".") == 0 || strcmp(nm, "..") == 0) {
            continue;
        }
        let n: String;
        n.from(nm);
        List_push<String>(&lv.names, n);
    }
    closedir(d);
    _fs_sort(&lv.names);
    List_push<_FsLevel>(levels, lv);
    return 0;
}

void _fs_level_free(List<_FsLevel>* levels) {
    for (i in 0..List_len<_FsLevel>(levels)) {
        fs_list_free(&levels.data[i].names);
    }
    List_free<_FsLevel>(levels);
}

// From the directory `cur` (the deepest level, now popped) back to its parent,
// which must still be the directory one level up. The parent's descriptor, or -1
// (EBUSY when the tree was moved meanwhile).
int _fs_level_up(List<_FsLevel>* levels, int cur) {
    const int up = openat(cur, "..", _FS_O_DIRFD);
    close(cur);
    if (up < 0) {
        return _fs_fail_os();
    }
    int64 dev = 0;
    int64 ino = 0;
    *_FsLevel parent = &levels.data[List_len<_FsLevel>(levels) - 1];
    if (_fs_fd_id(up, &dev, &ino) != 0 || dev != parent.dev || ino != parent.ino) {
        close(up);
        _fs_err = 16;   // EBUSY
        _fs_err_win = false;
        return -1;
    }
    return up;
}

// Remove everything under the directory `path` (not `path` itself). 0 or -1.
int _fs_remove_tree(string path) {
    int cur = open(path, _FS_O_DIRFD);
    if (cur < 0) {
        return _fs_fail_os();
    }
    let levels: List<_FsLevel>;
    List_init<_FsLevel>(&levels, 8);
    defer _fs_level_free(&levels);
    if (_fs_level_push(&levels, cur, 0) != 0) {
        close(cur);
        return -1;
    }
    int64[32] raw;
    while (true) {
        *_FsLevel lv = &levels.data[List_len<_FsLevel>(&levels) - 1];
        if (lv.next >= List_len<String>(&lv.names)) {
            if (List_len<_FsLevel>(&levels) == 1) {
                break;
            }
            let done: _FsLevel = List_pop<_FsLevel>(&levels);
            fs_list_free(&done.names);
            cur = _fs_level_up(&levels, cur);
            if (cur < 0) {
                return -1;
            }
            *_FsLevel parent = &levels.data[List_len<_FsLevel>(&levels) - 1];
            string dname = parent.names.data[parent.next - 1].cstr();
            if (unlinkat(cur, dname, _FS_AT_REMOVEDIR) != 0) {
                const int e = _fs_fail_os();
                close(cur);
                return e;
            }
            continue;
        }
        string name = lv.names.data[lv.next].cstr();
        lv.next++;
        if (_fs_lstatat_raw(cur, name, (*void)&raw) != 0) {
            if (_fs_errno_now() == _FS_ENOENT) {   // gone already
                continue;
            }
            const int e = _fs_fail_os();
            close(cur);
            return e;
        }
        if (_fs_raw_is_dir((*uint8)&raw)) {
            const int sub = openat(cur, name, _FS_O_DIRFD);
            if (sub >= 0) {
                if (_fs_level_push(&levels, sub, 0) != 0) {
                    close(sub);
                    close(cur);
                    return -1;
                }
                close(cur);
                cur = sub;
                continue;
            }
            // No longer a directory (swapped for a link or a file): remove the entry.
            if (_fs_errno_now() == _FS_ENOENT) {
                continue;
            }
        }
        if (unlinkat(cur, name, 0) != 0 && _fs_errno_now() != 2) {
            const int e = _fs_fail_os();
            close(cur);
            return e;
        }
    }
    close(cur);
    return 0;
}

// fs_walk over the directory `root` (path `base`).
void _fs_walk_tree(String* base, fn(string, bool)->void visit) {
    int cur = open(base.cstr(), _FS_O_DIRFD);
    if (cur < 0) {
        return;
    }
    let levels: List<_FsLevel>;
    List_init<_FsLevel>(&levels, 8);
    defer _fs_level_free(&levels);
    let path: String;
    path.from(base.cstr());
    defer path.free();
    if (_fs_level_push(&levels, cur, path.len) != 0) {
        close(cur);
        return;
    }
    int64[32] raw;
    while (true) {
        *_FsLevel lv = &levels.data[List_len<_FsLevel>(&levels) - 1];
        if (lv.next >= List_len<String>(&lv.names)) {
            if (List_len<_FsLevel>(&levels) == 1) {
                break;
            }
            let done: _FsLevel = List_pop<_FsLevel>(&levels);
            fs_list_free(&done.names);
            cur = _fs_level_up(&levels, cur);
            if (cur < 0) {
                return;
            }
            continue;
        }
        string name = lv.names.data[lv.next].cstr();
        lv.next++;
        path.len = lv.path_len;
        path.data[path.len] = 0;
        if (path.len > 0 && path.data[path.len - 1] != '/') {
            path.push('/');
        }
        path.append(name);
        const bool is_dir = _fs_lstatat_raw(cur, name, (*void)&raw) == 0 && _fs_raw_is_dir((*uint8)&raw);
        visit(path.cstr(), is_dir);
        if (!is_dir) {
            continue;
        }
        const int sub = openat(cur, name, _FS_O_DIRFD);
        if (sub < 0) {                     // unreadable, or no longer a directory
            continue;
        }
        if (_fs_level_push(&levels, sub, path.len) != 0) {
            close(sub);
            continue;
        }
        close(cur);
        cur = sub;
    }
    close(cur);
}
#endif

#ifdef _WIN32
// ── Directory trees through handles (Windows) ────────────────────────────────
//
// The Windows counterpart of the descriptor walk above. Each entry is opened
// relative to its directory's open handle (NtOpenFile with a RootDirectory, the
// openat of NT) with FILE_OPEN_REPARSE_POINT, so the open names the entry itself,
// never what a junction or symbolic link points to; whether it is a directory is
// then read from that handle, and a directory is listed and removed through it.
// Nothing is looked up by a path from the root after the root itself, so a
// directory swapped for a junction while the walk runs is never entered, and the
// depth is not limited by MAX_PATH. The handles of the directories above the
// current one stay open (Windows has no "..").

#define _FS_NT_ACC_LIST    1          // FILE_LIST_DIRECTORY
#define _FS_NT_ACC_ATTRS   1048704    // FILE_READ_ATTRIBUTES | SYNCHRONIZE
#define _FS_NT_ACC_DELETE  1114240    // DELETE | FILE_READ_ATTRIBUTES | SYNCHRONIZE
#define _FS_NT_SHARE_ALL   7
#define _FS_NT_OPT_ENTRY   2113568    // FILE_OPEN_REPARSE_POINT | FILE_OPEN_FOR_BACKUP_INTENT | FILE_SYNCHRONOUS_IO_NONALERT
#define _FS_NT_OPT_DIR     2113569    // the same | FILE_DIRECTORY_FILE
#define _FS_NT_OPT_FILE    2113632    // the same as _FS_NT_OPT_ENTRY | FILE_NON_DIRECTORY_FILE
#define _FS_FLAG_BACKUP    33554432   // FILE_FLAG_BACKUP_SEMANTICS
#define _FS_FLAG_REPARSE   2097152    // FILE_FLAG_OPEN_REPARSE_POINT

struct _FsUStr {          // UNICODE_STRING
    uint16 len;
    uint16 max;
    *uint16 buf;
}

struct _FsObjAttrs {      // OBJECT_ATTRIBUTES
    uint32 length;
    *void root;
    *void name;
    uint32 attributes;
    *void sd;
    *void sqos;
}

struct _FsWLevel {
    List<String> names;   // the entries, sorted
    int next;           // the next one to visit
    *void h;              // this directory, opened to list it (fs_remove_all: and delete it)
    int64 path_len;       // fs_walk: length of this directory's path
}

int _fs_fail_nt(uint32 st) {
    _fs_err = (int)RtlNtStatusToDosError(st);
    _fs_err_win = true;
    return -1;
}

// Open `name` (one component) relative to the directory handle `dir`; the entry
// itself, a junction or link not followed. The handle, or null with *st set.
*void _fs_nt_open(*void dir, string name, uint32 access, uint32 options, *uint32 st) {
    *uint16 w = _fs_wide(name);
    if (w == null) {   // STATUS_OBJECT_NAME_INVALID
        *st = (uint32)3221225523;
        return null;
    }
    defer free((*void)w);
    int64 n = 0;
    while (w[n] != (uint16)0) {
        n++;
    }
    let us: _FsUStr;
    us.len = (uint16)(n * 2);
    us.max = (uint16)(n * 2);
    us.buf = w;
    let oa: _FsObjAttrs;
    oa.length = (uint32)sizeof(_FsObjAttrs);
    oa.root = dir;
    oa.name = (*void)&us;
    oa.attributes = (uint32)64;   // OBJ_CASE_INSENSITIVE, as Win32 opens
    oa.sd = null;
    oa.sqos = null;
    int64[2] iosb;
    *void h = null;
    *st = NtOpenFile((*void)&h, access, (*void)&oa, (*void)&iosb, (uint32)_FS_NT_SHARE_ALL, options);
    if (*st >= (uint32)2147483648) {
        return null;
    }
    return h;
}

// What the open handle `h` is: 1 a directory, 0 anything else (a file, or a
// junction or symbolic link of either kind), -1 if it cannot be read.
int _fs_handle_kind(*void h) {
    int64 info = 0;   // FILE_ATTRIBUTE_TAG_INFO: attributes, reparse tag
    if (GetFileInformationByHandleEx(h, 9, (*void)&info, (uint32)8) == 0) {
        return -1;
    }
    const int64 attrs = info & 4294967295;
    if ((attrs & _FS_ATTR_REPARSE) != 0) {
        return 0;
    }
    return (attrs & _FS_ATTR_DIRECTORY) != 0 ? 1 : 0;
}

// Delete the entry `h` names (an empty directory, a file or a link itself) when
// the handle closes. 0 or -1; the handle is closed either way.
int _fs_handle_delete(*void h) {
    uint8 yes = (uint8)1;   // FILE_DISPOSITION_INFO
    const int ok = SetFileInformationByHandle(h, 4, (*void)&yes, (uint32)1);
    const int rc = ok != 0 ? 0 : _fs_fail_os();
    CloseHandle(h);
    return rc;
}

// Push a level for the directory opened as `list_h`: its sorted entries. The
// level owns the handle, also when this fails.
int _fs_wlevel_push(List<_FsWLevel>* levels, *void list_h, int64 path_len) {
    let lv: _FsWLevel;
    List_init<String>(&lv.names, 16);
    lv.next = 0;
    lv.h = list_h;
    lv.path_len = path_len;
    List_push<_FsWLevel>(levels, lv);
    *_FsWLevel top = &levels.data[List_len<_FsWLevel>(levels) - 1];
    *uint8 buf = alloc<uint8>(65536);
    defer free((*void)buf);
    while (true) {
        // FILE_FULL_DIR_INFO records: next offset at 0, name length (bytes) at 60, name at 68.
        if (GetFileInformationByHandleEx(list_h, 14, (*void)buf, (uint32)65536) == 0) {
            const uint32 e = GetLastError();
            if (e == (uint32)18 || e == (uint32)2) {   // NO_MORE_FILES, FILE_NOT_FOUND (empty)
                break;
            }
            return _fs_fail_os();
        }
        int64 off = 0;
        while (true) {
            const int64 next = _fs_u32_at(buf, (int)off);
            const int nlen = (int)(_fs_u32_at(buf, (int)off + 60) / 2);
            *uint16 nm = (*uint16)(buf + off + 68);
            const bool dot = (nlen == 1 && nm[0] == (uint16)46) || (nlen == 2 && nm[0] == (uint16)46 && nm[1] == (uint16)46);
            if (!dot) {
                let s: String;
                s.init(nlen + 8);
                _fs_append_wide_n(&s, nm, nlen);
                List_push<String>(&top.names, s);
            }
            if (next == 0) {
                break;
            }
            off += next;
        }
    }
    _fs_sort(&top.names);
    return 0;
}

void _fs_wlevel_free(List<_FsWLevel>* levels) {
    for (i in 0..List_len<_FsWLevel>(levels)) {
        *_FsWLevel lv = &levels.data[i];
        fs_list_free(&lv.names);
        if (lv.h != null) {
            CloseHandle(lv.h);
        }
    }
    List_free<_FsWLevel>(levels);
}

// Remove everything under the directory `path` (not `path` itself). 0 or -1.
int _fs_remove_tree(string path) {
    *uint16 w = _fs_wpath(path);
    if (w == null) {
        _fs_err = 123;
        _fs_err_win = true;
        return -1;
    }
    *void root = CreateFileW(w, (uint32)(_FS_NT_ACC_LIST | _FS_NT_ACC_ATTRS), (uint32)_FS_NT_SHARE_ALL, null, (uint32)3,
                             (uint32)(_FS_FLAG_BACKUP | _FS_FLAG_REPARSE), null);
    free((*void)w);
    if ((int64)root == -1) {
        return _fs_fail_os();
    }
    const int kind = _fs_handle_kind(root);
    if (kind != 1) {
        CloseHandle(root);
        if (kind < 0) {
            return _fs_fail_os();
        }
        return 0;   // a link now: fs_remove removes the link itself
    }
    let levels: List<_FsWLevel>;
    List_init<_FsWLevel>(&levels, 8);
    defer _fs_wlevel_free(&levels);
    if (_fs_wlevel_push(&levels, root, 0) != 0) {
        return -1;
    }
    while (true) {
        *_FsWLevel lv = &levels.data[List_len<_FsWLevel>(&levels) - 1];
        if (lv.next >= List_len<String>(&lv.names)) {
            if (List_len<_FsWLevel>(&levels) == 1) {
                break;
            }
            let done: _FsWLevel = List_pop<_FsWLevel>(&levels);
            fs_list_free(&done.names);
            if (_fs_handle_delete(done.h) != 0) {
                return -1;
            }
            continue;
        }
        *void cur = lv.h;
        string name = lv.names.data[lv.next].cstr();
        lv.next++;
        // Open the entry itself as a directory, for listing and deleting it; a
        // non-directory fails with NOT_A_DIRECTORY and is opened for deleting only.
        let st: uint32 = (uint32)0;
        *void h = _fs_nt_open(cur, name, (uint32)(_FS_NT_ACC_DELETE | _FS_NT_ACC_LIST), (uint32)_FS_NT_OPT_DIR, &st);
        if (h == null && st == (uint32)3221225731) {   // STATUS_NOT_A_DIRECTORY
            h = _fs_nt_open(cur, name, (uint32)_FS_NT_ACC_DELETE, (uint32)_FS_NT_OPT_FILE, &st);
        }
        if (h == null) {
            // OBJECT_NAME_NOT_FOUND, DELETE_PENDING: gone already
            if (st == (uint32)3221225524 || st == (uint32)3221225558) {
                continue;
            }
            return _fs_fail_nt(st);
        }
        const int k = _fs_handle_kind(h);
        if (k < 0) {
            const int e = _fs_fail_os();
            CloseHandle(h);
            return e;
        }
        if (k == 1) {
            if (_fs_wlevel_push(&levels, h, 0) != 0) {
                return -1;
            }
            continue;
        }
        // A file, or a junction or link: the handle names the entry, not a target.
        if (_fs_handle_delete(h) != 0) {
            return -1;
        }
    }
    return 0;
}

// fs_walk over the directory `base`.
void _fs_walk_tree(String* base, fn(string, bool)->void visit) {
    *uint16 w = _fs_wpath(base.cstr());
    if (w == null) {
        return;
    }
    *void root = CreateFileW(w, (uint32)(_FS_NT_ACC_LIST | _FS_NT_ACC_ATTRS), (uint32)_FS_NT_SHARE_ALL, null, (uint32)3,
                             (uint32)_FS_FLAG_BACKUP, null);
    free((*void)w);
    if ((int64)root == -1) {
        return;
    }
    let levels: List<_FsWLevel>;
    List_init<_FsWLevel>(&levels, 8);
    defer _fs_wlevel_free(&levels);
    let path: String;
    path.from(base.cstr());
    defer path.free();
    if (_fs_wlevel_push(&levels, root, path.len) != 0) {
        return;
    }
    while (true) {
        *_FsWLevel lv = &levels.data[List_len<_FsWLevel>(&levels) - 1];
        if (lv.next >= List_len<String>(&lv.names)) {
            if (List_len<_FsWLevel>(&levels) == 1) {
                break;
            }
            let done: _FsWLevel = List_pop<_FsWLevel>(&levels);
            fs_list_free(&done.names);
            CloseHandle(done.h);
            continue;
        }
        *void cur = lv.h;
        string name = lv.names.data[lv.next].cstr();
        lv.next++;
        path.len = lv.path_len;
        path.data[path.len] = 0;
        if (path.len > 0 && !_fs_is_sep(path.data[path.len - 1])) {
            path.push('/');
        }
        path.append(name);
        let st: uint32 = (uint32)0;
        bool is_dir = false;
        *void ah = _fs_nt_open(cur, name, (uint32)_FS_NT_ACC_ATTRS, (uint32)_FS_NT_OPT_ENTRY, &st);
        if (ah != null) {
            is_dir = _fs_handle_kind(ah) == 1;
            CloseHandle(ah);
        }
        visit(path.cstr(), is_dir);
        if (!is_dir) {
            continue;
        }
        // Opened again after the visit, and checked through that handle: a
        // directory swapped for a junction or link meanwhile is not entered.
        *void dh = _fs_nt_open(cur, name, (uint32)(_FS_NT_ACC_LIST | _FS_NT_ACC_ATTRS), (uint32)_FS_NT_OPT_DIR, &st);
        if (dh == null) {
            continue;
        }
        if (_fs_handle_kind(dh) != 1) {
            CloseHandle(dh);
            continue;
        }
        if (_fs_wlevel_push(&levels, dh, path.len) != 0) {
            let bad: _FsWLevel = List_pop<_FsWLevel>(&levels);
            fs_list_free(&bad.names);
            CloseHandle(bad.h);
        }
    }
}
#endif

// Remove a path and everything under it ("rm -rf"). Symbolic links are removed,
// never followed. A missing path is success. 0 or -1 (the first failure).
int fs_remove_all(string path) {
    // lstat("link/") follows the link: drop trailing separators first, so a
    // symbolic link named with one is removed, not emptied.
    let trimmed: String;
    trimmed.from(path);
    defer trimmed.free();
    while (trimmed.len > 1 && _fs_is_sep(trimmed.data[trimmed.len - 1])) {
        trimmed.len--;
        trimmed.data[trimmed.len] = 0;
    }
    path = trimmed.cstr();
    let st: FileStat;
    if (_fs_stat_impl(path, &st, false) != 0) {
        if (fs_errno_missing()) {
            _fs_err = 0;
            return 0;
        }
        return -1;
    }
#if defined(_WIN32) || defined(_FS_HAVE_STAT)
    if (st.is_dir && !st.is_symlink && _fs_remove_tree(path) != 0) {
        return -1;
    }
#else
    if (st.is_dir && !st.is_symlink) {
        let names: List<String>;
        List_init<String>(&names, 8);
        defer fs_list_free(&names);
        if (fs_list_dir(path, &names) != 0) {
            return -1;
        }
        let child: String;
        child.init(64);
        defer child.free();
        for (i in 0..List_len<String>(&names)) {
            let nm: String = List_get<String>(&names, i);
            _fs_join(&child, path, nm.cstr());
            if (fs_remove_all(child.cstr()) != 0) {
                return -1;
            }
        }
    }
#endif
    return fs_remove(path);
}

// 1 if the last failure was "no such file or directory".
bool fs_errno_missing() {
#ifdef _WIN32
    if (_fs_err_win) {   // FILE/PATH_NOT_FOUND
        return _fs_err == 2 || _fs_err == 3;
    }
#endif
    return _fs_err == _FS_ENOENT;
}

// Rename or move a path, replacing an existing file at `to`. 0 or -1.
int fs_rename(string from, string to) {
#ifdef _WIN32
    *uint16 wf = _fs_wpath(from);
    *uint16 wt = _fs_wpath(to);
    // MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED
    const int ok = wf != null && wt != null ? MoveFileExW(wf, wt, (uint32)3) : 0;
    free((*void)wf);
    free((*void)wt);
    return ok != 0 ? 0 : _fs_fail_os();
#else
    return rename(from, to) == 0 ? 0 : _fs_fail_os();
#endif
}

// 1 if `a` and `b` name the same file (device and inode, links followed).
bool _fs_same_file(string a, string b) {
#ifdef _FS_HAVE_STAT
    int64[32] ra;
    int64[32] rb;
    if (_fs_stat_raw(a, (*void)&ra) != 0 || _fs_stat_raw(b, (*void)&rb) != 0) {
        return false;
    }
    return memcmp((*void)&ra, (*void)&rb, _FS_ST_DEV_SIZE) == 0
        && memcmp((*void)((*uint8)&ra + _FS_ST_INO), (*void)((*uint8)&rb + _FS_ST_INO), 8) == 0;
#else
    return false;
#endif
}

// Copy a regular file's bytes to `to` (replaced if it exists), keeping its
// permission bits. 0 or -1 (EINVAL when `to` is `from` itself, or a link to it).
int fs_copy(string from, string to) {
#ifdef _WIN32
    *uint16 wf = _fs_wpath(from);
    *uint16 wt = _fs_wpath(to);
    const int ok = wf != null && wt != null ? CopyFileW(wf, wt, 0) : 0;
    free((*void)wf);
    free((*void)wt);
    return ok != 0 ? 0 : _fs_fail_os();
#else
    let st: FileStat;
    if (fs_stat(from, &st) != 0) {
        return -1;
    }
    if (st.is_dir) {   // EISDIR
        _fs_err = 21;
        _fs_err_win = false;
        return -1;
    }
    if (_fs_same_file(from, to)) {   // EINVAL: would truncate the source
        _fs_err = 22;
        _fs_err_win = false;
        return -1;
    }
    *void src = fopen(from, "rb");
    if (src == null) {
        return _fs_fail_crt();
    }
    defer fclose(src);
    // Owner-only until the bytes are in, also when `to` already exists: a copy of a
    // private file is never readable by others, not even halfway.
    const int dfd = open(to, _FS_O_COPY, 384);   // 0600
    if (dfd < 0) {
        return _fs_fail_crt();
    }
    _fs_fchmod(dfd, 384);
    *void dst = fdopen(dfd, "wb");
    if (dst == null) {
        const int e = _fs_fail_crt();
        close(dfd);
        return e;
    }
    *uint8 buf = alloc<uint8>(65536);
    defer free((*void)buf);
    int rc = 0;
    while (true) {
        const int64 got = fread((*void)buf, 1, 65536, src);
        if (got <= 0) {
            break;
        }
        if (fwrite((*void)buf, 1, got, dst) != got) {
            rc = _fs_fail_crt();
            break;
        }
    }
    if (rc == 0 && ferror(src) != 0) {
        rc = _fs_fail_crt();
    }
    if (fflush(dst) != 0 && rc == 0) {
        rc = _fs_fail_crt();
    }
#ifdef _FS_HAVE_STAT
    if (rc == 0) {   // the source's permission bits
        _fs_fchmod(dfd, st.mode & 4095);
    }
#else
    if (rc == 0) {               // 0644: no stat to read them from
        _fs_fchmod(dfd, 420);
    }
#endif
    if (fclose(dst) != 0 && rc == 0) {
        rc = _fs_fail_crt();
    }
    return rc;
#endif
}

// Sort a list of Strings bytewise ascending (Shell sort, in place).
void _fs_sort(List<String>* list) {
    const int n = List_len<String>(list);
    int gap = n / 2;
    while (gap > 0) {
        for (int i = gap; i < n; i++) {
            const String tmp = list.data[i];
            int j = i;
            while (j >= gap && strcmp(list.data[j - gap].data, tmp.data) > 0) {
                list.data[j] = list.data[j - gap];
                j -= gap;
            }
            list.data[j] = tmp;
        }
        gap = gap / 2;
    }
}

// Append the names in a directory (no "." or ".."), sorted bytewise, to `out`.
// Free the list with fs_list_free. 0 or -1.
int fs_list_dir(string path, List<String>* out) {
    let names: List<String>;
    List_init<String>(&names, 16);
#ifdef _WIN32
    let pat: String;
    pat.init(64);
    _fs_join(&pat, path, "*");
    *uint16 w = _fs_wpath(pat.cstr());
    pat.free();
    if (w == null) {
        List_free<String>(&names);
        _fs_err = 123;
        _fs_err_win = true;
        return -1;
    }
    int64[80] raw;   // WIN32_FIND_DATAW is 592 bytes; cFileName at 44
    *uint8 b = (*uint8)&raw;
    *void h = FindFirstFileW(w, (*void)b);
    free((*void)w);
    if ((int64)h == -1) {
        const int rc = _fs_fail_os();
        List_free<String>(&names);
        if (_fs_err == 2) {   // ERROR_FILE_NOT_FOUND: an empty directory
            return 0;
        }
        return rc;
    }
    while (true) {
        let nm: String;
        nm.init(32);
        _fs_append_wide(&nm, (*uint16)(b + 44));
        if (nm.eq_cstr(".") == 1 || nm.eq_cstr("..") == 1) {
            nm.free();
        }
        else {
            List_push<String>(&names, nm);
        }
        if (FindNextFileW(h, (*void)b) == 0) {
            break;
        }
    }
    FindClose(h);
#else
    *void d = opendir(path);
    if (d == null) {
        List_free<String>(&names);
        return _fs_fail_os();
    }
    while (true) {
        *uint8 ent = (*uint8)readdir(d);
        if (ent == null) {
            break;
        }
        string nm = (string)(ent + _FS_DIRENT_NAME);
        if (strcmp(nm, ".") == 0 || strcmp(nm, "..") == 0) {
            continue;
        }
        let s: String;
        s.from(nm);
        List_push<String>(&names, s);
    }
    closedir(d);
#endif
    _fs_sort(&names);
    for (i in 0..List_len<String>(&names)) {
        List_push<String>(out, List_get<String>(&names, i));
    }
    List_free<String>(&names);
    return 0;
}

void _fs_walk_dir(String* dir, fn(string, bool)->void visit) {
    let names: List<String>;
    List_init<String>(&names, 16);
    defer fs_list_free(&names);
    if (fs_list_dir(dir.cstr(), &names) != 0) {
        return;
    }
    for (i in 0..List_len<String>(&names)) {
        let nm: String = List_get<String>(&names, i);
        let child: String;
        child.init(dir.len + nm.len + 2);
        defer child.free();
        _fs_join(&child, dir.cstr(), nm.cstr());
        let st: FileStat;
        const bool is_dir = _fs_stat_impl(child.cstr(), &st, false) == 0 && st.is_dir && !st.is_symlink;
        visit(child.cstr(), is_dir);
        if (is_dir) {
            _fs_walk_dir(&child, visit);
        }
    }
}

// Visit every entry under `root` (not `root` itself), depth first, each
// directory's entries in sorted order: visit(path, is_dir), where path is
// `root` joined with the entry's relative path. Symbolic links are reported
// (is_dir false) but never followed, so a link loop cannot recurse. A
// subdirectory that cannot be read is skipped. 0, or -1 if `root` is not a
// readable directory.
int fs_walk(string root, fn(string, bool)->void visit) {
    if (fs_is_dir(root) == 0) {
        if (_fs_err == 0 || fs_exists(root) == 1) {   // ENOTDIR
            _fs_err = 20;
            _fs_err_win = false;
        }
        return -1;
    }
    let base: String;
    base.from(root);
    defer base.free();
    while (base.len > 1 && _fs_is_sep(base.data[base.len - 1])) {
        base.len--;
        base.data[base.len] = 0;
    }
#if defined(_WIN32) || defined(_FS_HAVE_STAT)
    _fs_walk_tree(&base, visit);
#else
    _fs_walk_dir(&base, visit);
#endif
    return 0;
}

// The position just past a [...] class starting at pat[p] (the '['), with
// *matched set to whether `c` is in it; -1 if the class has no closing ']'.
int _fs_class(string pat, int p, char c, *bool matched) {
    int i = p + 1;
    bool neg = false;
    if (pat[i] == '!' || pat[i] == '^') {
        neg = true;
        i++;
    }
    bool hit = false;
    bool first = true;
    while (pat[i] != 0 && (first || pat[i] != ']')) {
        first = false;
        char lo = pat[i];
        if (lo == '\\' && pat[i + 1] != 0) {
            i++;
            lo = pat[i];
        }
        char hi = lo;
        if (pat[i + 1] == '-' && pat[i + 2] != 0 && pat[i + 2] != ']') {
            hi = pat[i + 2];
            if (hi == '\\' && pat[i + 3] != 0) {
                i++;
                hi = pat[i + 2];
            }
            i += 2;
        }
        if ((uint8)c >= (uint8)lo && (uint8)c <= (uint8)hi) {
            hit = true;
        }
        i++;
    }
    if (pat[i] != ']') {
        return -1;
    }
    *matched = hit != neg;
    return i + 1;
}

// 1 if `name` matches the shell pattern `pat`, else 0: `*` matches any run of
// characters, `?` one character, `[abc]` / `[a-z]` / `[!a-z]` one character of
// (or not of) a set, and `\` makes the next character literal. A pattern
// matches the whole name; there is no special case for '/' or a leading '.'.
int fs_match(string pat, string name) {
    int p = 0;
    int n = 0;
    int star = -1;
    int mark = 0;
    while (name[n] != 0) {
        const char pc = pat[p];
        if (pc == '*') {
            star = p;
            p++;
            mark = n;
            continue;
        }
        int next = -1;
        if (pc == '?') {
            next = p + 1;
        }
        else if (pc == '[') {
            let m: bool = false;
            const int q = _fs_class(pat, p, name[n], &m);
            if (q < 0) {
                if (name[n] == '[') {
                    next = p + 1;
                }
            }
            else if (m) {
                next = q;
            }
        }
        else if (pc == '\\' && pat[p + 1] != 0) {
            if (pat[p + 1] == name[n]) {
                next = p + 2;
            }
        }
        else if (pc != 0 && pc == name[n]) {
            next = p + 1;
        }
        if (next >= 0) {
            p = next;
            n++;
            continue;
        }
        if (star < 0) {
            return 0;
        }
        p = star + 1;
        mark++;
        n = mark;
    }
    while (pat[p] == '*') {
        p++;
    }
    return pat[p] == 0 ? 1 : 0;
}

bool _fs_has_magic(String* s) {
    for (int64 i = 0; i < s.len; i++) {
        const char c = s.data[i];
        if (c == '*' || c == '?' || c == '[') {
            return true;
        }
    }
    return false;
}

void _fs_glob_push(List<String>* out, String* path) {
    let s: String;
    s.from(path.cstr());
    List_push<String>(out, s);
}

// Every entry under `dir` (recursively, not following links), for a trailing **.
void _fs_glob_all(String* dir, List<String>* out) {
    let names: List<String>;
    List_init<String>(&names, 16);
    defer fs_list_free(&names);
    if (fs_list_dir(dir.len == 0 ? "." : dir.cstr(), &names) != 0) {
        return;
    }
    let child: String;
    child.init(64);
    defer child.free();
    for (i in 0..List_len<String>(&names)) {
        let nm: String = List_get<String>(&names, i);
        if (nm.data[0] == '.') {
            continue;
        }
        _fs_join(&child, dir.cstr(), nm.cstr());
        _fs_glob_push(out, &child);
        let st: FileStat;
        if (_fs_stat_impl(child.cstr(), &st, false) == 0 && st.is_dir && !st.is_symlink) {
            _fs_glob_all(&child, out);
        }
    }
}

void _fs_glob_at(String* base, List<String>* comps, int i, List<String>* out) {
    const int nc = List_len<String>(comps);
    if (i == nc) {
        if (base.len > 0 && fs_exists(base.cstr()) == 1) {
            _fs_glob_push(out, base);
        }
        return;
    }
    let comp: String = List_get<String>(comps, i);
    if (comp.len == 0) {
        _fs_glob_at(base, comps, i + 1, out);
        return;
    }
    const bool last = i + 1 == nc;
    let child: String;
    child.init(64);
    defer child.free();
    if (comp.eq_cstr("**") == 1) {
        if (last) {
            _fs_glob_all(base, out);
            return;
        }
        _fs_glob_at(base, comps, i + 1, out);
        let names: List<String>;
        List_init<String>(&names, 16);
        defer fs_list_free(&names);
        if (fs_list_dir(base.len == 0 ? "." : base.cstr(), &names) != 0) {
            return;
        }
        for (k in 0..List_len<String>(&names)) {
            let nm: String = List_get<String>(&names, k);
            if (nm.data[0] == '.') {
                continue;
            }
            _fs_join(&child, base.cstr(), nm.cstr());
            let st: FileStat;
            if (_fs_stat_impl(child.cstr(), &st, false) == 0 && st.is_dir && !st.is_symlink) {
                _fs_glob_at(&child, comps, i, out);
            }
        }
        return;
    }
    if (!_fs_has_magic(&comp)) {
        // A component without wildcards is a name, with fs_match's backslash
        // escapes removed (so `d\1` names "d1", as a pattern would match it).
        let lit: String;
        lit.init(comp.len + 1);
        defer lit.free();
        for (int64 k = 0; k < comp.len; k++) {
#ifndef _WIN32
            if (comp.data[k] == '\\' && k + 1 < comp.len) {
                k++;
            }
#endif
            lit.push(comp.data[k]);
        }
        _fs_join(&child, base.cstr(), lit.cstr());
        if (last) {
            let st: FileStat;
            if (_fs_stat_impl(child.cstr(), &st, false) == 0) {
                _fs_glob_push(out, &child);
            }
        } else if (fs_is_dir(child.cstr()) == 1) {
            _fs_glob_at(&child, comps, i + 1, out);
        }
        return;
    }
    let names: List<String>;
    List_init<String>(&names, 16);
    defer fs_list_free(&names);
    if (fs_list_dir(base.len == 0 ? "." : base.cstr(), &names) != 0) {
        return;
    }
    const bool dot_ok = comp.data[0] == '.';
    for (k in 0..List_len<String>(&names)) {
        let nm: String = List_get<String>(&names, k);
        if (nm.data[0] == '.' && !dot_ok) {
            continue;
        }
        if (fs_match(comp.cstr(), nm.cstr()) == 0) {
            continue;
        }
        _fs_join(&child, base.cstr(), nm.cstr());
        if (last) {
            _fs_glob_push(out, &child);
        }
        else if (fs_is_dir(child.cstr()) == 1) {
            _fs_glob_at(&child, comps, i + 1, out);
        }
    }
}

// Append the paths matching `pattern` to `out`, sorted and without
// duplicates; returns how many were added. Each '/'-separated component is an
// fs_match pattern, and a `**` component matches any number of directories
// (zero included; a trailing `**` matches everything below). Wildcards do not
// match names that start with '.' unless the component itself does. Relative
// patterns are relative to the current directory and give relative paths.
// Symbolic links are never followed by `**`. Free with fs_list_free.
int fs_glob(string pattern, List<String>* out) {
    let comps: List<String>;
    List_init<String>(&comps, 8);
    defer fs_list_free(&comps);
    let cur: String;
    cur.init(32);
    defer cur.free();
    const int64 n = strlen(pattern);
    let base: String;
    base.init(32);
    defer base.free();
    int64 start = 0;
    if (n > 0 && _fs_is_sep(pattern[0])) {
        base.append("/");
        start = 1;
    }
    for (int64 i = start; i <= n; i++) {
        if (i == n || _fs_is_sep(pattern[i])) {
            let c: String;
            c.from(cur.cstr());
            List_push<String>(&comps, c);
            cur.clear();
        } else {
            cur.push(pattern[i]);
        }
    }
    let found: List<String>;
    List_init<String>(&found, 16);
    _fs_glob_at(&base, &comps, 0, &found);
    _fs_sort(&found);
    int added = 0;
    for (i in 0..List_len<String>(&found)) {
        let s: String = List_get<String>(&found, i);
        if (i > 0 && strcmp(s.data, List_get<String>(&found, i - 1).data) == 0) {
            s.free();
            continue;
        }
        List_push<String>(out, s);
        added++;
    }
    List_free<String>(&found);
    return added;
}

// ── Current directory and temporary files ─────────────────────────────────

// Write the current working directory into `out` (cleared first). 0 or -1.
int fs_cwd(String* out) {
    out.clear();
#ifdef _WIN32
    const uint32 need = GetCurrentDirectoryW((uint32)0, null);
    if (need == (uint32)0) {
        return _fs_fail_os();
    }
    *uint16 w = alloc<uint16>((int64)need + 1);
    defer free((*void)w);
    if (GetCurrentDirectoryW(need, w) == (uint32)0) {
        return _fs_fail_os();
    }
    _fs_append_wide(out, w);
    return 0;
#else
    int64 cap = 256;
    while (cap <= 1048576) {
        *char buf = alloc<char>(cap);
        if (getcwd(buf, cap) != null) {
            out.append((string)buf);
            free((*void)buf);
            return 0;
        }
        free((*void)buf);
        if (_fs_errno_now() != 34) {   // ERANGE: grow and retry
            return _fs_fail_os();
        }
        cap = cap * 4;
    }
    return _fs_fail_os();
#endif
}

// Change the current working directory. 0 or -1.
int fs_chdir(string path) {
#ifdef _WIN32
    *uint16 w = _fs_wide(path);
    const int ok = w != null ? SetCurrentDirectoryW(w) : 0;
    free((*void)w);
    return ok != 0 ? 0 : _fs_fail_os();
#else
    return chdir(path) == 0 ? 0 : _fs_fail_os();
#endif
}

// The system temporary directory, without a trailing separator, into `out`
// (cleared first): $TMPDIR or /tmp on POSIX, GetTempPathW on Windows.
void fs_temp_base(String* out) {
    out.clear();
#ifdef _WIN32
    *uint16 w = alloc<uint16>(1024);
    if (GetTempPathW((uint32)1023, w) != (uint32)0) {
        _fs_append_wide(out, w);
    }
    free((*void)w);
    if (out.len == 0) {
        out.append(".");
    }
#else
    const string t = getenv("TMPDIR");
    out.append(t != null && t[0] != 0 ? t : "/tmp");
#endif
    while (out.len > 1 && _fs_is_sep(out.data[out.len - 1])) {
        out.len--;
        out.data[out.len] = 0;
    }
}

// Create a new, empty file with a unique name starting with `prefix` in the
// temporary directory and write its path into `out` (cleared first). The
// caller removes it (fs_remove). 0 or -1.
int fs_temp_file(string prefix, String* out) {
    let dir: String;
    dir.init(64);
    defer dir.free();
    fs_temp_base(&dir);
#ifdef _WIN32
    out.clear();
    *uint16 wd = _fs_wide(dir.cstr());
    *uint16 wp = _fs_wide(prefix);
    *uint16 name = alloc<uint16>(1100);
    const uint32 r = wd != null && wp != null ? GetTempFileNameW(wd, wp, (uint32)0, name) : (uint32)0;
    free((*void)wd);
    free((*void)wp);
    if (r == (uint32)0) {
        free((*void)name);
        return _fs_fail_os();
    }
    _fs_append_wide(out, name);
    free((*void)name);
    return 0;
#else
    _fs_join(out, dir.cstr(), prefix);
    out.append("XXXXXX");
    const int fd = mkstemp(out.data);
    if (fd < 0) {
        out.clear();
        return _fs_fail_os();
    }
    close(fd);
    return 0;
#endif
}

// Create a new, empty directory with a unique name starting with `prefix` in
// the temporary directory and write its path into `out` (cleared first). The
// caller removes it (fs_remove_all). 0 or -1.
int fs_temp_dir(string prefix, String* out) {
#ifdef _WIN32
    for (attempt in 0..16) {
        if (fs_temp_file(prefix, out) != 0) {
            return -1;
        }
        // GetTempFileNameW created a file to reserve the name; swap it for a directory.
        if (fs_remove(out.cstr()) == 0 && fs_mkdir(out.cstr()) == 0) {
            return 0;
        }
    }
    return -1;
#else
    let dir: String;
    dir.init(64);
    defer dir.free();
    fs_temp_base(&dir);
    _fs_join(out, dir.cstr(), prefix);
    out.append("XXXXXX");
    if (mkdtemp(out.data) == null) {
        out.clear();
        return _fs_fail_os();
    }
    return 0;
#endif
}

// ── Result forms ───────────────────────────────────────────────────────────

// fs_read_text as a Result: the file's text, or an error. fs_last_error gives the OS
// reason. Free the text with String_free.
Result<String, string> fs_read_text_result(string path) {
    let text: String;
    String_init(&text, 256);
    if (fs_read_text(path, &text) != 0) {
        String_free(&text);
        return Err<String, string>("cannot read the file");
    }
    return Ok<String, string>(text);
}

// fs_write_text as a Result (the value is 0). fs_last_error gives the OS reason.
Result<int, string> fs_write_text_result(string path, string text) {
    if (fs_write_text(path, text) != 0) {
        return Err<int, string>("cannot write the file");
    }
    return Ok<int, string>(0);
}

// fs_append_text as a Result (the value is 0). fs_last_error gives the OS reason.
Result<int, string> fs_append_text_result(string path, string text) {
    if (fs_append_text(path, text) != 0) {
        return Err<int, string>("cannot append to the file");
    }
    return Ok<int, string>(0);
}
