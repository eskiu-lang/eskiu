// log.esk: leveled logging with timestamps, to stderr or a file.
//
//   import <log>;
//   log_info("listening on port %d", port);
//   log_warn("retrying %s (%d left)", url, tries);
//   log_debug("only shown with LOG_LEVEL=debug");
//
//   log_set_level(LOG_DEBUG);              // or LOG_LEVEL=debug in the environment
//   log_set_file("app.log");               // append to a file instead of stderr
//   log_set_time(LOG_TIME_LOCAL);          // local time instead of UTC
//
// A line is "<timestamp> <LEVEL> <message>\n": the timestamp is ISO 8601 with
// milliseconds, "2026-10-11T08:30:05.123Z" in UTC (the default) or
// "2026-10-11T04:30:05.123-04:00" in local time, and the level is padded to
// five columns. The message is printf-style (C vsnprintf rules, as
// String_appendf: %lld for int64, a String as s.cstr()).
//
// The minimum level is the one given to log_set_level; until it is called it
// comes from the LOG_LEVEL variable (trace, debug, info, warn or warning,
// error, off, any case, or 0-5), read at every call, and is LOG_INFO when that
// is unset or not a level. Messages below the minimum cost one comparison and
// are not formatted.
//
// On stderr the level tag is colored when <term> enables colors for stderr
// (a terminal, NO_COLOR and FORCE_COLOR respected); log_set_color changes
// that. stdout is flushed before a line goes to stderr, so the two stay in
// order when they share a destination. A file gets no colors and is flushed
// after every line.

import <c/stdio>;   // fopen, fclose
import <term>;
import <time>;

const int LOG_TRACE = 0;
const int LOG_DEBUG = 1;
const int LOG_INFO = 2;
const int LOG_WARN = 3;
const int LOG_ERROR = 4;
const int LOG_OFF = 5;

const int LOG_TIME_UTC = 0;
const int LOG_TIME_LOCAL = 1;
const int LOG_TIME_NONE = 2;

const string[5] LOG_LEVEL_TAGS = {"TRACE", "DEBUG", "INFO ", "WARN ", "ERROR"};

int _log_level = -1;         // -1: from LOG_LEVEL
*void _log_fp = null;          // null: stderr
int _log_time = 0;
int _log_color = 0;          // TERM_AUTO / TERM_ALWAYS / TERM_NEVER
bool _log_frozen = false;
int64 _log_frozen_ms = 0;

char _log_lower(char c) {
    return c >= 'A' && c <= 'Z' ? (char)((int)c + 32) : c;
}

bool _log_name_is(string s, string name) {
    int i = 0;
    while (s[i] != 0 && name[i] != 0 && _log_lower(s[i]) == name[i]) {
        i++;
    }
    return s[i] == 0 && name[i] == 0;
}

// The level named by `name` (trace, debug, info, warn/warning, error, off, any
// case, or a digit 0-5), or -1.
int log_level_from_name(string name) {
    if (name == null) {
        return -1;
    }
    if (name[0] >= '0' && name[0] <= '5' && name[1] == 0) {
        return (int)name[0] - 48;
    }
    if (_log_name_is(name, "trace")) {
        return LOG_TRACE;
    }
    if (_log_name_is(name, "debug")) {
        return LOG_DEBUG;
    }
    if (_log_name_is(name, "info")) {
        return LOG_INFO;
    }
    if (_log_name_is(name, "warn") || _log_name_is(name, "warning")) {
        return LOG_WARN;
    }
    if (_log_name_is(name, "error")) {
        return LOG_ERROR;
    }
    if (_log_name_is(name, "off") || _log_name_is(name, "none")) {
        return LOG_OFF;
    }
    return -1;
}

// Set the minimum level (LOG_TRACE .. LOG_OFF). -1 goes back to LOG_LEVEL.
void log_set_level(int level) {
    _log_level = level < -1 ? -1 : (level > LOG_OFF ? LOG_OFF : level);
}

// The minimum level in effect.
int log_level() {
    if (_log_level >= 0) {
        return _log_level;
    }
    const int env = log_level_from_name(getenv("LOG_LEVEL"));
    return env >= 0 ? env : LOG_INFO;
}

// 1 if a message at `level` would be written.
int log_enabled(int level) {
    return level >= log_level() && level < LOG_OFF ? 1 : 0;
}

// Append to the file at `path` (created if missing) instead of stderr.
// 0, or -1 if it cannot be opened (the destination is then unchanged).
int log_set_file(string path) {
    *void fp = fopen(path, "ab");
    if (fp == null) {
        return -1;
    }
    if (_log_fp != null) {
        fclose(_log_fp);
    }
    _log_fp = fp;
    return 0;
}

// Write to stderr again (closing a file set with log_set_file).
void log_set_stderr() {
    if (_log_fp != null) {
        fclose(_log_fp);
    }
    _log_fp = null;
}

// Timestamps in UTC (LOG_TIME_UTC, the default), local time (LOG_TIME_LOCAL)
// or none (LOG_TIME_NONE).
void log_set_time(int mode) {
    _log_time = mode;
}

// Colored level tags on stderr: TERM_AUTO (the default, <term>'s rules for
// stderr), TERM_ALWAYS or TERM_NEVER.
void log_set_color(int mode) {
    _log_color = mode;
}

// Stamp every line with `epoch_ms` instead of the clock (for tests and
// reproducible output).
void log_freeze_time(int64 epoch_ms) {
    _log_frozen = true;
    _log_frozen_ms = epoch_ms;
}

// Go back to the real clock.
void log_unfreeze_time() {
    _log_frozen = false;
}

void _log_timestamp(String* line) {
    const int64 ms = _log_frozen ? _log_frozen_ms : time_now_ms();
    int64 s = ms / 1000;
    int64 frac = ms % 1000;
    if (frac < 0) {
        frac = frac + 1000;
        s = s - 1;
    }
    let dt: DateTime;
    int off = 0;
    if (_log_time == LOG_TIME_LOCAL) {
        off = time_to_local(s, &dt);
    } else {
        time_to_utc(s, &dt);
    }
    _time_pad(line, dt.year, 4);
    line.push('-');
    _time_pad(line, dt.month, 2);
    line.push('-');
    _time_pad(line, dt.day, 2);
    line.push('T');
    _time_pad(line, dt.hour, 2);
    line.push(':');
    _time_pad(line, dt.min, 2);
    line.push(':');
    _time_pad(line, dt.sec, 2);
    line.push('.');
    _time_pad(line, (int)frac, 3);
    if (_log_time != LOG_TIME_LOCAL) {
        line.push('Z');
        return;
    }
    if (off < 0) {
        line.push('-');
        off = -off;
    } else {
        line.push('+');
    }
    _time_pad(line, off / 3600, 2);
    line.push(':');
    _time_pad(line, (off % 3600) / 60, 2);
}

int64 _log_level_style(int level) {
    if (level == LOG_TRACE) {
        return TERM_BRIGHT_BLACK;
    }
    if (level == LOG_DEBUG) {
        return TERM_CYAN;
    }
    if (level == LOG_INFO) {
        return TERM_GREEN;
    }
    if (level == LOG_WARN) {
        return TERM_YELLOW;
    }
    return TERM_BOLD | TERM_RED;
}

// Write one formatted line for `msg` at `level` (no level check).
void _log_emit(int level, String* msg) {
    if (level < 0) {
        level = 0;
    }
    if (level > LOG_ERROR) {
        level = LOG_ERROR;
    }
    let line: String;
    line.init(msg.len + 48);
    if (_log_time != LOG_TIME_NONE) {
        _log_timestamp(&line);
        line.push(' ');
    }
    bool color = false;
    if (_log_fp == null) {
        if (_log_color == TERM_ALWAYS) {
            color = true;
        }
        else if (_log_color == TERM_AUTO) {
            color = term_color_enabled(2) == 1;
        }
    }
    if (color) {
        term_sgr(&line, _log_level_style(level));
        line.append(LOG_LEVEL_TAGS[level]);
        term_reset(&line);
    } else {
        line.append(LOG_LEVEL_TAGS[level]);
    }
    line.push(' ');
    line.concat(msg);
    line.push('\n');
    if (_log_fp != null) {
        fwrite((*void)line.data, 1, line.len, _log_fp);
        fflush(_log_fp);
    } else {
        fflush(io_stdout());
        *void err = io_stderr();
        fwrite((*void)line.data, 1, line.len, err);
        fflush(err);
    }
    line.free();
}

// After a first vsnprintf into `m` that reported `n` bytes: 1 when the text did
// not fit and `m` was grown for a second pass, else 0 (the length is set).
int _log_fit(String* m, int n) {
    if (n < 0) {
        m.data[0] = 0;
        return 0;
    }
    if ((int64)n >= m.cap) {
        String_reserve(m, (int64)n + 1);
        return 1;
    }
    m.len = (int64)n;
    return 0;
}

// Log a printf-style message at `level`.
void log_at(int level, string fmt, ...) {
    if (log_enabled(level) == 0) {
        return;
    }
    let m: String;
    m.init(256);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(&m, fmt, ap);
    va_end(ap);
    if (_log_fit(&m, n) == 1) {
        va_start(ap);
        _string_vwrite(&m, fmt, ap);
        va_end(ap);
        m.len = (int64)n;
    }
    _log_emit(level, &m);
    m.free();
}

void log_trace(string fmt, ...) {
    if (log_enabled(LOG_TRACE) == 0) {
        return;
    }
    let m: String;
    m.init(256);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(&m, fmt, ap);
    va_end(ap);
    if (_log_fit(&m, n) == 1) {
        va_start(ap);
        _string_vwrite(&m, fmt, ap);
        va_end(ap);
        m.len = (int64)n;
    }
    _log_emit(LOG_TRACE, &m);
    m.free();
}

void log_debug(string fmt, ...) {
    if (log_enabled(LOG_DEBUG) == 0) {
        return;
    }
    let m: String;
    m.init(256);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(&m, fmt, ap);
    va_end(ap);
    if (_log_fit(&m, n) == 1) {
        va_start(ap);
        _string_vwrite(&m, fmt, ap);
        va_end(ap);
        m.len = (int64)n;
    }
    _log_emit(LOG_DEBUG, &m);
    m.free();
}

void log_info(string fmt, ...) {
    if (log_enabled(LOG_INFO) == 0) {
        return;
    }
    let m: String;
    m.init(256);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(&m, fmt, ap);
    va_end(ap);
    if (_log_fit(&m, n) == 1) {
        va_start(ap);
        _string_vwrite(&m, fmt, ap);
        va_end(ap);
        m.len = (int64)n;
    }
    _log_emit(LOG_INFO, &m);
    m.free();
}

void log_warn(string fmt, ...) {
    if (log_enabled(LOG_WARN) == 0) {
        return;
    }
    let m: String;
    m.init(256);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(&m, fmt, ap);
    va_end(ap);
    if (_log_fit(&m, n) == 1) {
        va_start(ap);
        _string_vwrite(&m, fmt, ap);
        va_end(ap);
        m.len = (int64)n;
    }
    _log_emit(LOG_WARN, &m);
    m.free();
}

void log_error(string fmt, ...) {
    if (log_enabled(LOG_ERROR) == 0) {
        return;
    }
    let m: String;
    m.init(256);
    va_list ap;
    va_start(ap);
    const int n = _string_vwrite(&m, fmt, ap);
    va_end(ap);
    if (_log_fit(&m, n) == 1) {
        va_start(ap);
        _string_vwrite(&m, fmt, ap);
        va_end(ap);
        m.len = (int64)n;
    }
    _log_emit(LOG_ERROR, &m);
    m.free();
}
