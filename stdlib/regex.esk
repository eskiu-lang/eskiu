// regex.esk: a small regular-expression engine.
//
//   import <regex>;
//   if (regex_match("\\d+-\\d+", "12-34") == 1) { ... }      // search, 1/0
//
//   Regex re = regex_compile("(\\w+)@(\\w+)");
//   let m: Match;
//   if (Regex_search(&re, "a@b", &m) == 1) {
//       String u; String_init(&u, 8);
//       Match_group(&m, "a@b", 1, &u);        // "a"  (group 1)
//       // ... use u ...
//       String_free(&u);
//   }
//   Match_free(&m);
//
//   // Every match of a text of `len` bytes (or one search from an offset with
//   // Regex_search_at, which keeps the text before it as context for ^ and \b):
//   RegexIter it = Regex_iter(&re, text, len);
//   while (RegexIter_next(&it, &m) == 1) { ... m.start, m.end ... }
//   Match_free(&m);
//   Regex_free(&re);
//
// A compiled Regex can be searched from several threads at once.
//
// Supported syntax (RE2 semantics, as Go's regexp): patterns and texts are UTF-8,
// and `.`, classes and literals match whole code points (a byte that is not valid
// UTF-8 in the text reads as U+FFFD, one byte wide). Match offsets are byte offsets.
//
//   literals, `.` (any code point but newline), classes `[a-z]` / `[^...]` (a
//   negated class matches newline), `[[:alpha:]]` and the other POSIX classes, the
//   ASCII shorthands `\d \w \s \D \W \S` (also inside a class), Unicode classes
//   `\pL`, `\p{Lu}`, `\p{Greek}`, `\PL`, `\p{^Lu}` (the general categories and
//   their one-letter groups, the scripts, and `Any`), the escapes `\a \f \t \n \r
//   \v`, octal `\0`, `\012`, `\101`, hex `\x41`, `\x{10FFFF}`, a backslash before
//   any ASCII punctuation (`\.`, `\-`) for that character, literal text `\Q...\E`,
//   quantifiers `* + ? {m} {m,} {m,n}` (counts up to 1000, as in RE2; append `?`
//   for the lazy form), alternation `|`, capturing groups `( )` and named ones
//   `(?P<name>...)` / `(?<name>...)`, non-capturing groups `(?:...)`, the flags
//   `(?i)` (case-insensitive, by Unicode simple case folding), `(?m)` (`^` and `$`
//   also match at line breaks), `(?s)` (`.` matches newline) and `(?U)` (swap
//   greedy and lazy), set with `(?flags)` for the rest of the group or scoped with
//   `(?flags:...)` and cleared with `-` (`(?i-s)`), the anchors `^` and `\A`
//   (start of text), `$` and `\z` (end of text), and the ASCII word boundaries
//   `\b` and `\B`. Any other escape of a letter or digit is an error. In a class,
//   a `-` right after a shorthand is a literal (`[\d-z]` is digits, '-' and 'z').
//
// The matcher is a Thompson NFA, linear in the input length with no catastrophic
// backtracking (no ReDoS). A search runs it three ways, as RE2 does: a lazily
// built DFA (states made on first use and cached, with their ASCII transitions)
// finds where the leftmost match ends, a DFA over the reversed program finds
// where that match starts, and a Pike VM, which explores all paths in lockstep
// and tracks the capture groups, runs over that span only (not at all for a
// pattern without groups). The result is the Pike VM's: the leftmost match,
// preferring greedy quantifiers unless they are marked lazy, and earlier
// alternatives. A DFA that outgrows its budget (RE_DFA_MAX_STATES) leaves the
// search to the Pike VM over the whole text.
//
// Before the VM runs, the search skips text where no match can start: compiling
// records the bytes a match can begin with and an ASCII byte every match
// contains (when there is one), and the VM drops a thread at once when it
// cannot read the next byte.

import <mem>;
import <string>;
import <regex_unicode>;
import <atomic>;

// ---- limits (fixed, so no reallocation during compile) --------------------
#define RE_MAX_INST  4096
#define RE_MAX_RANGE 1024
#define RE_MAX_CLASS 256
#define RE_MAX_PROP  1024
#define RE_MAX_NODES 4096
#define RE_MAX_DEPTH 512
#define RE_MAX_REPEAT 1000

// ---- instruction opcodes --------------------------------------------------
#define OP_CHAR  1      // a = code point, b = 1: case-insensitive
#define OP_ANY   2      // a = 1: also newline
#define OP_CLASS 3
#define OP_MATCH 4
#define OP_JMP   5
#define OP_SPLIT 6
#define OP_SAVE  7
#define OP_BOL   8      // a = 1: also after a newline
#define OP_EOL   9      // a = 1: also before a newline
#define OP_WORDB 10     // a = 0: \b, a = 1: \B

// ---- AST node kinds -------------------------------------------------------
#define N_EMPTY  0
#define N_LIT    1
#define N_ANY    2
#define N_CLASS  3
#define N_CONCAT 4
#define N_ALT    5
#define N_GROUP  6
#define N_REPEAT 7
#define N_BOL    8
#define N_EOL    9
#define N_WORDB  10     // ch = 0: \b, ch = 1: \B

// ---- flags ----------------------------------------------------------------
#define RF_FOLD  1      // (?i)
#define RF_MULTI 2      // (?m)
#define RF_DOTNL 4      // (?s)
#define RF_UNGREEDY 8   // (?U)

// ---- class property kinds -------------------------------------------------
#define P_ASCII  1      // val: a _re_class_has kind (\d \w \s, the POSIX classes)
#define P_CAT    2      // val: bit mask over RE_CAT_NAMES
#define P_SCRIPT 3      // val: index into RE_SCRIPT_NAMES
#define P_ANY    4

struct _ReInst {
    int op;
    int a;      // code point / class id / save slot / jump target x
    int b;      // second jump target (SPLIT), fold flag (CHAR)
}

struct _ReRange {
    int lo;
    int hi;
}

// A property of a class: the code points in it (neg = 0) or outside it (neg = 1).
struct _ReProp {
    int kind;
    int val;
    int neg;
}

// A class matches a code point in its ranges or props (or, when negate is set,
// one in neither). With fold set, a code point matches when any member of its
// case-folding orbit does, and a negated prop excludes the whole orbit, as RE2.
struct _ReClassInfo {
    int start;      // index into the ranges array
    int count;
    int negate;
    int fold;
    int pstart;     // index into the props array
    int pcount;
}

struct _ReNode {
    int kind;
    int ch;         // N_LIT code point; N_ANY / N_BOL / N_EOL: 1 for the flag form
    int cls;        // N_CLASS
    int grp;        // N_GROUP capture index (1-based)
    int rmin;       // N_REPEAT
    int rmax;       // N_REPEAT (-1 = unbounded)
    int greedy;
    int fold;       // N_LIT: case-insensitive
    _ReNode* left;     // child / left operand
    _ReNode* right;    // right operand (concat, alt)
}

struct _ReThread {
    int pc;
    *int caps;
}

// The memory a search works in. A search takes the Regex's own block by
// switching `busy` from 0 to 1 atomically and gives it back at the end; a
// search that finds it taken (another thread is searching the same Regex)
// allocates a block of its own for that call. visited holds ninst + 1 ints: the
// generation stamp of each pc and, at [ninst], the last generation used.
struct _ReScratch {
    int busy;
    *int visited;
    *_ReThread la;
    *_ReThread lb;
    *int capsA;
    *int capsB;
    *int work;          // 2 * ncap ints: the working and the best captures
    *_ReDfa fdfa;       // the forward and reverse DFAs, made by the first search
    *_ReDfa rdfa;
    int dfa_off;        // 1 once a DFA outgrew its budget: the Pike VM alone
}

// A lazily built DFA over a program (the forward one or the reversed one). A
// state is an ordered list of the program's pcs that a step resumes from: the
// consuming instructions, MATCH, and the zero-width assertions still to be
// decided (they need the character after the point), plus, in the unanchored
// forward DFA, RE_DFA_RESTART last, standing for the match that may start at the
// next position. Its flags describe the character on its consumed side (the
// left one going forward, the right one in reverse). A transition first decides
// the assertions with the next character, then (going forward) drops what
// follows a MATCH, as the Pike VM cuts its lower-priority threads, then steps
// over the character. Transitions on ASCII code points are cached per state.
struct _ReDfa {
    Regex* re;
    *_ReInst insts;
    *uint64 amask;
    int ninst;
    int restart;        // forward: unanchored, RE_DFA_RESTART at the end of states
    int cut;            // forward: leftmost-first (MATCH cuts what follows)
    int reverse;        // the consumed character is on the right
    *int pool;          // the items of every state
    int npool;
    int cpool;
    *int off;           // per state: its items in pool
    *int len;
    *int flags;
    *uint8 isstart;     // the state is a start state (no partial match in it)
    *int trans;         // per state, 128 entries: 0 unknown, else (next + 3) * 2 + match
    int nst;
    int cst;
    *int hash;          // open addressing: state + 1, 0 empty
    int hcap;
    *int mark;          // per pc: the pass that last added it
    int gen;
    *int buf1;
    *int buf2;
}

struct Regex {
    *_ReInst inst;
    int ninst;
    *_ReClassInfo classes;
    int nclass;
    *_ReRange ranges;
    int nrange;
    *_ReProp props;
    int nprop;
    int ngroup;      // number of capturing groups (group 0 is the whole match)
    int ok;
    string err;         // null when ok
    // Built by regex_compile for the search: for each instruction, the ASCII
    // code points it consumes (two words of bits); the start prefilter, where
    // _first[b] is 1 for a byte that can begin a match and is used when _pf is 1
    // (the pattern cannot match empty), _pfbyte being that byte when it is the
    // only one and ASCII (else -1); and _bolonly, 1 when every match starts at
    // offset 0. _req is an ASCII byte every match contains, or -1; when no
    // instruction consumes a non-ASCII code point, _inmatch[b] is 1 for the bytes
    // a match can contain and _reqscan is 1 (see Regex_search_at).
    *uint64 _amask;
    *uint8 _first;
    int _pf;
    int _pfbyte;
    int _bolonly;
    int _req;
    int _reqscan;
    *uint8 _inmatch;
    // Search scratch, allocated by regex_compile (so copies of the Regex share
    // it) and reused by every search that finds it free.
    *_ReScratch _scratch;
    // The program reversed (concatenations right to left, no SAVE), for the
    // reverse DFA that finds where a match starts, and its ASCII masks; null when
    // it did not fit (the search then runs the Pike VM only).
    *_ReInst _rinst;
    int _rninst;
    *uint64 _ramask;
}

struct _ReComp {
    string pat;
    int len;
    int pos;
    int ngroup;
    string err;
    Regex* re;
    *_ReNode nodes;
    int nnode;
    int depth;   // groups currently open (the parser recurses once per group)
    int flags;   // RF_* in effect
    int inquote; // inside \Q...\E
    int rev;     // compiling the reversed program
}

struct Match {
    int ok;
    int ngroup;
    int start;     // group 0 start (== cap[0])
    int end;       // group 0 end   (== cap[1])
    *int cap;       // 2*(ngroup+1) ints: [start,end] per group, -1 if unset
}

struct _ReVm {
    Regex* prog;
    string text;
    int len;
    int ncap;
    *int visited;       // ninst ints, holds the generation each pc was last added under
    *_ReThread la;
    *_ReThread lb;
    int nA;
    int nB;
    // Capture storage: thread slot i of list A owns capsA[i*ncap .. (i+1)*ncap),
    // likewise for B. Enqueueing a thread copies its captures into its slot, so
    // the storage is recycled every step: O(threads * ncap) for the whole search.
    *int capsA;
    *int capsB;
}

// =========================== Unicode =======================================

// Decode the UTF-8 sequence at s[i] (i < n) as Go's utf8.DecodeRune does: the
// code point, with its byte length in w[0]; -1 (w[0] = 1) when the bytes are not
// valid UTF-8 (a stray continuation byte, an overlong form, a surrogate, a value
// above 0x10FFFF or a truncated sequence).
int _re_decode(string s, int n, int i, *int w) {
    const int b0 = (int)((uint8)s[i]);
    w[0] = 1;
    if (b0 < 0x80) {
        return b0;
    }
    int need = 0;
    int lo = 0x80;
    int hi = 0xBF;
    int r = 0;
    if (b0 >= 0xC2 && b0 <= 0xDF) {
        need = 1;
        r = b0 & 0x1F;
    }
    else if (b0 >= 0xE0 && b0 <= 0xEF) {
        need = 2;
        r = b0 & 0x0F;
        if (b0 == 0xE0) {
            lo = 0xA0;
        }
        if (b0 == 0xED) {
            hi = 0x9F;
        }
    } else if (b0 >= 0xF0 && b0 <= 0xF4) {
        need = 3;
        r = b0 & 0x07;
        if (b0 == 0xF0) {
            lo = 0x90;
        }
        if (b0 == 0xF4) {
            hi = 0x8F;
        }
    } else {
        return -1;
    }
    for (int k = 1; k <= need; k++) {
        if (i + k >= n) {
            return -1;
        }
        const int b = (int)((uint8)s[i + k]);
        const int blo = k == 1 ? lo : 0x80;
        const int bhi = k == 1 ? hi : 0xBF;
        if (b < blo || b > bhi) {
            return -1;
        }
        r = (r << 6) | (b & 0x3F);
    }
    w[0] = need + 1;
    return r;
}

// The next member of r's simple case-folding orbit (r itself when it has none),
// as Go's unicode.SimpleFold: iterating from r visits the whole orbit.
int _re_simple_fold(int r) {
    int lo = 0;
    int hi = RE_NFOLD - 1;
    while (lo <= hi) {
        const int mid = (lo + hi) / 2;
        if (r < RE_FOLD[3 * mid]) {
            hi = mid - 1;
        }
        else if (r > RE_FOLD[3 * mid + 1]) {
            lo = mid + 1;
        }
        else {
            const int d = RE_FOLD[3 * mid + 2];
            if (d != 0) {
                return r + d;
            }
            return (r - RE_FOLD[3 * mid]) % 2 == 0 ? r + 1 : r - 1;
        }
    }
    return r;
}

// Fill orb with r's case-folding orbit (r first; just r when fold is 0) and
// return its size (at most 4 in Unicode 15).
int _re_orbit(int r, int fold, *int orb) {
    orb[0] = r;
    int n = 1;
    if (fold == 0) {
        return n;
    }
    int f = _re_simple_fold(r);
    while (f != r && n < 8) {
        orb[n++] = f;
        f = _re_simple_fold(f);
    }
    return n;
}

// Index of the run of `runs` (start << 8 | id, ascending) holding r: its id.
int _re_run_id(*int runs, int nruns, int r) {
    int lo = 0;
    int hi = nruns - 1;
    while (lo < hi) {
        const int mid = (lo + hi + 1) / 2;
        if ((runs[mid] >> 8) <= r) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return runs[lo] & 255;
}

// General category index of r (into RE_CAT_NAMES), 255 when unassigned.
int _re_cat_of(int r) {
    return _re_run_id((*int)&RE_CATRUN[0], RE_NCATRUN, r);
}

// Script index of r (into RE_SCRIPT_NAMES), 255 when it has none.
int _re_script_of(int r) {
    return _re_run_id((*int)&RE_SCRIPTRUN[0], RE_NSCRIPTRUN, r);
}

// =========================== parsing =======================================

int _re_peek(_ReComp* c) {
    return c.pos >= c.len ? -1 : (int)((uint8)c.pat[c.pos]);
}

int _re_peek_at(_ReComp* c, int off) {
    const int p = c.pos + off;
    return p >= c.len ? -1 : (int)((uint8)c.pat[p]);
}

// Read the code point at c.pos and step past it: -1 at the end of the pattern,
// -2 (with c.err set) for bytes that are not valid UTF-8.
int _re_next_rune(_ReComp* c) {
    if (c.pos >= c.len) {
        return -1;
    }
    int[1] w;
    const int r = _re_decode(c.pat, c.len, c.pos, &w[0]);
    if (r < 0) {
        if (c.err == null) {
            c.err = "invalid UTF-8";
        }
        return -2;
    }
    c.pos += w[0];
    return r;
}

_ReNode* _re_node(_ReComp* c, int kind) {
    if (c.nnode >= RE_MAX_NODES) {
        if (c.err == null) {
            c.err = "regex pattern too complex";
        }
        return &c.nodes[0];
    }
    _ReNode* n = &c.nodes[c.nnode++];
    n.kind = kind;
    n.ch = 0;
    n.cls = 0;
    n.grp = 0;
    n.rmin = 0;
    n.rmax = 0;
    n.greedy = 1;
    n.fold = 0;
    n.left = null;
    n.right = null;
    return n;
}

// A literal code point under the current flags.
_ReNode* _re_lit(_ReComp* c, int r) {
    _ReNode* n = _re_node(c, N_LIT);
    n.ch = r;
    n.fold = (c.flags & RF_FOLD) != 0 && _re_simple_fold(r) != r ? 1 : 0;
    return n;
}

// Add a class to the current program; returns its id. Fill ranges and props after.
int _re_class_begin(_ReComp* c, int negate) {
    Regex* re = c.re;
    if (re.nclass >= RE_MAX_CLASS) {
        if (c.err == null) {
            c.err = "too many character classes";
        }
        return 0;
    }
    const int id = re.nclass++;
    re.classes[id].start = re.nrange;
    re.classes[id].count = 0;
    re.classes[id].negate = negate;
    re.classes[id].fold = (c.flags & RF_FOLD) != 0 ? 1 : 0;
    re.classes[id].pstart = re.nprop;
    re.classes[id].pcount = 0;
    return id;
}

void _re_range(_ReComp* c, int id, int lo, int hi) {
    Regex* re = c.re;
    if (re.nrange >= RE_MAX_RANGE) {
        if (c.err == null) {
            c.err = "too many class ranges";
        }
        return;
    }
    re.ranges[re.nrange].lo = lo;
    re.ranges[re.nrange].hi = hi;
    re.nrange++;
    re.classes[id].count++;
}

void _re_prop(_ReComp* c, int id, int kind, int val, int neg) {
    Regex* re = c.re;
    if (re.nprop >= RE_MAX_PROP) {
        if (c.err == null) {
            c.err = "too many class ranges";
        }
        return;
    }
    re.props[re.nprop].kind = kind;
    re.props[re.nprop].val = val;
    re.props[re.nprop].neg = neg;
    re.nprop++;
    re.classes[id].pcount++;
}

// The POSIX class names of a bracket expression ([:alpha:]), in the order of
// their kinds RE_POSIX + 0 .. RE_POSIX + 13.
const int RE_POSIX = 256;
const int RE_NPOSIX = 14;
const string[14] RE_POSIX_NAMES = {"alnum", "alpha", "ascii", "blank", "cntrl", "digit", "graph",
                                   "lower", "print", "punct", "space", "upper", "word", "xdigit"};

// 1 if code point `i` is in the class `kind`: 'd' 'w' 's' (the Perl shorthands;
// \s is [\t\n\f\r ] as in RE2, without \v) or RE_POSIX + k for the POSIX class
// RE_POSIX_NAMES[k]. All of them are ASCII only, as in RE2.
int _re_class_has(int kind, int i) {
    if (i < 0 || i >= 128) {
        return 0;
    }
    const bool digit = i >= '0' && i <= '9';
    const bool upper = i >= 'A' && i <= 'Z';
    const bool lower = i >= 'a' && i <= 'z';
    const bool alpha = upper || lower;
    const bool punct = (i >= '!' && i <= '/') || (i >= ':' && i <= '@') || (i >= '[' && i <= '`') || (i >= '{' && i <= '~');
    bool r = false;
    switch (kind) {
        case 'd': r = digit;
        break;
        case 'w': r = digit || alpha || i == '_';
        break;
        case 's': r = i == '\t' || i == '\n' || i == '\f' || i == '\r' || i == ' ';
        break;
        case RE_POSIX + 0: r = digit || alpha;
        break;
        case RE_POSIX + 1: r = alpha;
        break;
        case RE_POSIX + 2: r = true;
        break;
        case RE_POSIX + 3: r = i == '\t' || i == ' ';
        break;
        case RE_POSIX + 4: r = i < 32 || i == 127;
        break;
        case RE_POSIX + 5: r = digit;
        break;
        case RE_POSIX + 6: r = i >= '!' && i <= '~';
        break;
        case RE_POSIX + 7: r = lower;
        break;
        case RE_POSIX + 8: r = i >= ' ' && i <= '~';
        break;
        case RE_POSIX + 9: r = punct;
        break;
        case RE_POSIX + 10: r = (i >= '\t' && i <= '\r') || i == ' ';
        break;
        case RE_POSIX + 11: r = upper;
        break;
        case RE_POSIX + 12: r = digit || alpha || i == '_';
        break;
        case RE_POSIX + 13: r = digit || (i >= 'A' && i <= 'F') || (i >= 'a' && i <= 'f');
        break;
    }
    return r ? 1 : 0;
}

// At a '[' inside a bracket class: a POSIX class [:name:] or [:^name:] is
// added to class `id` and consumed, returning 1. Returns 0 (nothing consumed)
// if no ":]" follows, so the '[' is a literal member, as in RE2; an unknown
// name is an error (-1 with c.err set).
int _re_posix_class(_ReComp* c, int id) {
    if (_re_peek_at(c, 1) != ':') {
        return 0;
    }
    int e = c.pos + 2;
    while (e + 1 < c.len && !(c.pat[e] == ':' && c.pat[e + 1] == ']')) {
        e++;
    }
    if (e + 1 >= c.len) {
        return 0;
    }
    int s = c.pos + 2;
    const bool negate = s < e && c.pat[s] == '^';
    if (negate) {
        s++;
    }
    for (k in 0..RE_NPOSIX) {
        const string name = RE_POSIX_NAMES[k];
        int j = 0;
        while (s + j < e && name[j] != 0 && c.pat[s + j] == name[j]) {
            j++;
        }
        if (s + j == e && name[j] == 0) {
            _re_prop(c, id, P_ASCII, RE_POSIX + k, negate ? 1 : 0);
            c.pos = e + 2;
            return 1;
        }
    }
    if (c.err == null) {
        c.err = "invalid character class range";
    }
    return -1;
}

// 1 if pat[s..e) spells `name`.
int _re_span_is(string pat, int s, int e, string name) {
    int j = 0;
    while (s + j < e && name[j] != 0 && pat[s + j] == name[j]) {
        j++;
    }
    return s + j == e && name[j] == 0 ? 1 : 0;
}

// At "\p" or "\P": read the Unicode class name (one letter, or braced) and add
// it to class `id`. Returns 0, or -1 with c.err set for an unknown name.
int _re_unicode_class(_ReComp* c, int id) {
    int neg = _re_peek_at(c, 1) == 'P' ? 1 : 0;
    c.pos += 2;
    int s = c.pos;
    int e = c.pos;
    if (_re_peek(c) == '{') {
        int p = c.pos;
        while (p < c.len && c.pat[p] != '}') {
            p++;
        }
        if (p >= c.len) {
            if (c.err == null) {
                c.err = "invalid character class range";
            }
            return -1;
        }
        s = c.pos + 1;
        e = p;
        c.pos = p + 1;
    } else {
        if (_re_next_rune(c) < 0) {
            if (c.err == null) {
                c.err = "invalid character class range";
            }
            return -1;
        }
        e = c.pos;
    }
    if (s < e && c.pat[s] == '^') {
        neg = 1 - neg;
        s++;
    }
    if (_re_span_is(c.pat, s, e, "Any") == 1) {
        _re_prop(c, id, P_ANY, 0, neg);
        return 0;
    }
    if (e == s + 1) {
        // A one-letter name is the group of the categories that start with it.
        int mask = 0;
        for (k in 0..RE_NCAT) {
            if (RE_CAT_NAMES[k][0] == c.pat[s]) {
                mask = mask | (1 << k);
            }
        }
        if (mask != 0) {
            _re_prop(c, id, P_CAT, mask, neg);
            return 0;
        }
    }
    for (k in 0..RE_NCAT) {
        if (_re_span_is(c.pat, s, e, RE_CAT_NAMES[k]) == 1) {
            _re_prop(c, id, P_CAT, 1 << k, neg);
            return 0;
        }
    }
    for (k in 0..RE_NSCRIPT) {
        if (_re_span_is(c.pat, s, e, RE_SCRIPT_NAMES[k]) == 1) {
            _re_prop(c, id, P_SCRIPT, k, neg);
            return 0;
        }
    }
    if (c.err == null) {
        c.err = "invalid character class range";
    }
    return -1;
}

// 1 if `e` names a class shorthand (\d \w \s \D \W \S).
int _re_is_shorthand(int e) {
    return (e == 'd' || e == 'w' || e == 's' || e == 'D' || e == 'W' || e == 'S') ? 1 : 0;
}

// Add the shorthand `e` (\d \w \s, or their negations \D \W \S) to class `id`.
void _re_shorthand(_ReComp* c, int id, int e) {
    const bool lower = e == 'd' || e == 'w' || e == 's';
    _re_prop(c, id, P_ASCII, lower ? e : e + 32, lower ? 0 : 1);
}

int _re_hex_digit(int ch) {
    if (ch >= '0' && ch <= '9') {
        return ch - '0';
    }
    if (ch >= 'a' && ch <= 'f') {
        return ch - 'a' + 10;
    }
    if (ch >= 'A' && ch <= 'F') {
        return ch - 'A' + 10;
    }
    return -1;
}

int _re_bad_escape(_ReComp* c) {
    if (c.err == null) {
        c.err = "invalid escape sequence";
    }
    return -1;
}

// Decode the escape whose letter `e` was just consumed to its code point, reading
// any further digits: \a \f \t \n \r \v, octal (\0 plus up to two octal digits,
// or \1-\7 followed by one or two more), hex \xHH or \x{H...} (up to 10FFFF),
// and ASCII punctuation as itself (\. is '.', \\ is '\'). Anything else (another
// letter or digit, a non-ASCII character) is an error, as in RE2: -1 with c.err
// set.
int _re_escape_char(_ReComp* c, int e) {
    switch (e) {
        case 'a': return 7;
        case 'f': return '\f';
        case 't': return '\t';
        case 'n': return '\n';
        case 'r': return '\r';
        case 'v': return '\v';
        default: break;
    }
    if (e >= '0' && e <= '7') {
        // \1-\7 alone would be a backreference, which RE2 does not have.
        if (e != '0' && (_re_peek(c) < '0' || _re_peek(c) > '7')) {
            return _re_bad_escape(c);
        }
        int v = e - '0';
        for (int k = 0; k < 2 && _re_peek(c) >= '0' && _re_peek(c) <= '7'; k++) {
            v = v * 8 + (_re_peek(c) - '0');
            c.pos++;
        }
        return v;
    }
    if (e == 'x') {
        if (_re_peek(c) == '{') {
            c.pos++;
            int v = 0;
            int nd = 0;
            while (_re_hex_digit(_re_peek(c)) >= 0) {
                if (v <= 0x10FFFF) {
                    v = v * 16 + _re_hex_digit(_re_peek(c));
                }
                c.pos++;
                nd++;
            }
            if (nd == 0 || _re_peek(c) != '}' || v > 0x10FFFF) {
                return _re_bad_escape(c);
            }
            c.pos++;
            return v;
        }
        const int h1 = _re_hex_digit(_re_peek(c));
        const int h2 = _re_hex_digit(_re_peek_at(c, 1));
        if (h1 < 0 || h2 < 0) {
            return _re_bad_escape(c);
        }
        c.pos += 2;
        return h1 * 16 + h2;
    }
    const bool alnum = (e >= '0' && e <= '9') || (e >= 'a' && e <= 'z') || (e >= 'A' && e <= 'Z');
    if (e < 0 || e >= 128 || alnum) {
        return _re_bad_escape(c);
    }
    return e;
}

// One class member character: an escape or a code point. -1 on error.
int _re_class_char(_ReComp* c) {
    if (_re_peek(c) == '\\') {
        c.pos++;
        const int e = _re_peek(c);
        if (e == -1) {
            if (c.err == null) {
                c.err = "unterminated character class";
            }
            return -1;
        }
        c.pos++;
        return _re_escape_char(c, e);
    }
    const int r = _re_next_rune(c);
    return r < 0 ? -1 : r;
}

// [ ... ] returns a N_CLASS node.
_ReNode* _re_parse_class(_ReComp* c) {
    c.pos++;   // consume '['
    int negate = 0;
    if (_re_peek(c) == '^') {
        c.pos++;
        negate = 1;
    }
    const int id = _re_class_begin(c, negate);

    // A ']' right after '[' or '[^' is a literal member (POSIX), not the end.
    bool first = true;
    while (_re_peek(c) != ']' || first) {
        first = false;
        if (_re_peek(c) == -1) {
            if (c.err == null) {
                c.err = "unterminated character class";
            }
            return _re_node(c, N_CLASS);
        }
        if (_re_peek(c) == '[' && _re_posix_class(c, id) != 0) {
            // A '-' after a POSIX class is the next member, as after \d.
            if (c.err != null) {
                return _re_node(c, N_CLASS);
            }
            continue;
        }
        if (_re_peek(c) == '\\' && (_re_peek_at(c, 1) == 'p' || _re_peek_at(c, 1) == 'P')) {
            if (_re_unicode_class(c, id) < 0) {
                return _re_node(c, N_CLASS);
            }
            continue;
        }
        if (_re_peek(c) == '\\' && _re_is_shorthand(_re_peek_at(c, 1)) == 1) {
            // A '-' after a shorthand does not make a range: it is read as the
            // next member, so [\d-z] is digits, '-' and 'z' (RE2).
            _re_shorthand(c, id, _re_peek_at(c, 1));
            c.pos += 2;
            continue;
        }
        const int lo = _re_class_char(c);
        if (lo < 0) {
            return _re_node(c, N_CLASS);
        }
        // range 'a-z'?  ('-' not immediately before the closing ']')
        if (_re_peek(c) == '-' && _re_peek_at(c, 1) != ']' && _re_peek_at(c, 1) != -1) {
            c.pos++;   // consume '-'
            if (_re_peek(c) == '\\' && (_re_is_shorthand(_re_peek_at(c, 1)) == 1 || _re_peek_at(c, 1) == 'p' || _re_peek_at(c, 1) == 'P')) {
                if (c.err == null) {
                    c.err = "invalid character class range";
                }
                return _re_node(c, N_CLASS);
            }
            const int hi = _re_class_char(c);
            if (hi < 0) {
                return _re_node(c, N_CLASS);
            }
            // A range whose end is below its start ([z-a]) is an error (RE2).
            if (hi < lo) {
                if (c.err == null) {
                    c.err = "invalid character class range";
                }
                return _re_node(c, N_CLASS);
            }
            _re_range(c, id, lo, hi);
        } else {
            _re_range(c, id, lo, lo);
        }
    }
    c.pos++;   // consume ']'
    _ReNode* n = _re_node(c, N_CLASS);
    n.cls = id;
    return n;
}

// A backslash escape as an atom: \d \w \s \D \W \S and \p \P become classes, \A
// \z anchors, \b \B word-boundary assertions, \Q starts literal text, the rest
// (_re_escape_char) a literal.
_ReNode* _re_parse_escape(_ReComp* c) {
    const int e = _re_peek_at(c, 1);
    if (e == -1) {
        c.pos++;
        if (c.err == null) {
            c.err = "trailing backslash";
        }
        return _re_node(c, N_EMPTY);
    }
    if (e == 'p' || e == 'P' || _re_is_shorthand(e) == 1) {
        const int id = _re_class_begin(c, 0);
        if (e == 'p' || e == 'P') {
            _re_unicode_class(c, id);
        }
        else {
            _re_shorthand(c, id, e);
            c.pos += 2;
        }
        _ReNode* n = _re_node(c, N_CLASS);
        n.cls = id;
        return n;
    }
    c.pos += 2;
    if (e == 'A') {
        return _re_node(c, N_BOL);
    }
    if (e == 'z') {
        return _re_node(c, N_EOL);
    }
    if (e == 'b' || e == 'B') {
        _ReNode* n = _re_node(c, N_WORDB);
        n.ch = e == 'B' ? 1 : 0;
        return n;
    }
    if (e == 'Q') {
        // Non-empty (_re_skip_nops consumed the empty ones): the first quoted
        // character is this atom, the rest follow as their own atoms.
        c.inquote = 1;
        const int r = _re_next_rune(c);
        if (r < 0) {
            return _re_node(c, N_EMPTY);
        }
        return _re_lit(c, r);
    }
    const int ch = _re_escape_char(c, e);
    if (ch < 0) {
        return _re_node(c, N_EMPTY);
    }
    return _re_lit(c, ch);
}

// 1 if "(?" at c.pos starts a named group, (?P<name> or (?<name>.
int _re_named_ahead(_ReComp* c) {
    const int left = c.len - c.pos;
    if (left > 4 && c.pat[c.pos + 2] == 'P' && c.pat[c.pos + 3] == '<') {
        return 1;
    }
    if (left > 3 && c.pat[c.pos + 2] == '<') {
        return 1;
    }
    return 0;
}

// At "(?" (not a named group): read the flags up to ':' or ')' and return that
// terminator, with the resulting flags in out[0]; -1 with c.err set when the
// syntax is invalid ((?z), (?-), (?i-), an unterminated group).
int _re_parse_flags(_ReComp* c, *int out) {
    c.pos += 2;
    int add = 0;
    int del = 0;
    bool neg = false;
    bool saw = false;
    while (c.pos < c.len) {
        const int ch = (int)((uint8)c.pat[c.pos]);
        c.pos++;
        int f = 0;
        if (ch == 'i') {
            f = RF_FOLD;
        }
        else if (ch == 'm') {
            f = RF_MULTI;
        }
        else if (ch == 's') {
            f = RF_DOTNL;
        }
        else if (ch == 'U') {
            f = RF_UNGREEDY;
        }
        if (f != 0) {
            if (neg) {
                del = del | f;
            } else {
                add = add | f;
            }
            saw = true;
            continue;
        }
        if (ch == '-') {
            if (neg) {
                break;
            }
            neg = true;
            saw = false;
            continue;
        }
        if (ch == ':' || ch == ')') {
            if (neg && !saw) {
                break;
            }
            out[0] = (c.flags | add) & ~del;
            return ch;
        }
        break;
    }
    if (c.err == null) {
        c.err = "invalid or unsupported Perl syntax";
    }
    return -1;
}

// Skip what matches nothing and takes no quantifier of its own: empty \Q\E
// quotes, and flag groups (?flags), which set the flags for the rest of the
// enclosing group. Returns how many were skipped. As in RE2, a quantifier after
// them applies to the atom before (a(?i)* is a*).
int _re_skip_nops(_ReComp* c) {
    int n = 0;
    while (c.err == null && c.inquote == 0) {
        const int pk = _re_peek(c);
        if (pk == '\\' && _re_peek_at(c, 1) == 'Q') {
            if (c.pos + 2 >= c.len) {
                c.pos = c.len;
                n++;
                continue;
            }
            if (_re_peek_at(c, 2) == '\\' && _re_peek_at(c, 3) == 'E') {
                c.pos += 4;
                n++;
                continue;
            }
            break;
        }
        if (pk == '(' && _re_peek_at(c, 1) == '?' && _re_named_ahead(c) == 0) {
            const int save = c.pos;
            int[1] nf;
            const int t = _re_parse_flags(c, &nf[0]);
            if (t == ')') {
                c.flags = nf[0];
                n++;
                continue;
            }
            if (t == ':') {
                c.pos = save;
            }
            break;
        }
        break;
    }
    return n;
}

_ReNode* _re_parse_alt(_ReComp* c);

// A group at '(': capturing, named, or (?flags:...) non-capturing. The flags in
// effect before the group come back at its ')'.
_ReNode* _re_parse_group(_ReComp* c) {
    // Nesting is bounded so a pattern of many '(' fails cleanly instead of
    // recursing until the stack overflows.
    if (c.depth >= RE_MAX_DEPTH) {
        if (c.err == null) {
            c.err = "regex nesting too deep";
        }
        return _re_node(c, N_EMPTY);
    }
    const int saved = c.flags;
    int g = 0;
    if (_re_peek_at(c, 1) == '?') {
        if (_re_named_ahead(c) == 1) {
            const int s = c.pos + (c.pat[c.pos + 2] == 'P' ? 4 : 3);
            int e = s;
            while (e < c.len && c.pat[e] != '>') {
                e++;
            }
            bool valid = e < c.len && e > s;
            for (int k = s; valid && k < e; k++) {
                const int ch = (int)((uint8)c.pat[k]);
                valid = ch == '_' || (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
            }
            if (!valid) {
                if (c.err == null) {
                    c.err = "invalid named capture";
                }
                return _re_node(c, N_EMPTY);
            }
            c.pos = e + 1;
            g = ++c.ngroup;
        } else {
            int[1] nf;
            if (_re_parse_flags(c, &nf[0]) != ':') {
                return _re_node(c, N_EMPTY);
            }
            c.flags = nf[0];
        }
    } else {
        c.pos++;
        g = ++c.ngroup;
    }
    c.depth++;
    _ReNode* inner = _re_parse_alt(c);
    c.depth--;
    c.flags = saved;
    if (c.err != null) {
        return inner;
    }
    if (_re_peek(c) != ')') {
        if (c.err == null) {
            c.err = "missing )";
        }
        return _re_node(c, N_EMPTY);
    }
    c.pos++;
    if (g == 0) {
        return inner;
    }
    _ReNode* n = _re_node(c, N_GROUP);
    n.grp = g;
    n.left = inner;
    return n;
}

_ReNode* _re_parse_atom(_ReComp* c) {
    if (c.inquote == 1) {
        const int r = _re_next_rune(c);
        if (r < 0) {
            return _re_node(c, N_EMPTY);
        }
        return _re_lit(c, r);
    }
    const int pk = _re_peek(c);
    if (pk == '(') {
        return _re_parse_group(c);
    }
    if (pk == '[') {
        return _re_parse_class(c);
    }
    if (pk == '.') {
        c.pos++;
        _ReNode* n = _re_node(c, N_ANY);
        n.ch = (c.flags & RF_DOTNL) != 0 ? 1 : 0;
        return n;
    }
    if (pk == '^' || pk == '$') {
        c.pos++;
        _ReNode* n = _re_node(c, pk == '^' ? N_BOL : N_EOL);
        n.ch = (c.flags & RF_MULTI) != 0 ? 1 : 0;
        return n;
    }
    if (pk == '\\') {
        return _re_parse_escape(c);
    }
    if (pk == '*' || pk == '+' || pk == '?' || (pk == '{' && _re_repeat_ahead(c) == 1)) {
        if (c.err == null) {
            c.err = "nothing to repeat";
        }
        return _re_node(c, N_EMPTY);
    }
    if (pk == -1) {
        if (c.err == null) {
            c.err = "unexpected end of pattern";
        }
        return _re_node(c, N_EMPTY);
    }
    // ordinary literal
    const int r = _re_next_rune(c);
    if (r < 0) {
        return _re_node(c, N_EMPTY);
    }
    return _re_lit(c, r);
}

// Read a repeat count: -1 when there are no digits, -2 when it exceeds
// RE_MAX_REPEAT (the value is clamped while reading, so it cannot wrap).
int _re_read_int(_ReComp* c) {
    const int start = c.pos;
    int v = 0;
    while (_re_peek(c) >= '0' && _re_peek(c) <= '9') {
        if (v <= RE_MAX_REPEAT) {
            v = v * 10 + (_re_peek(c) - '0');
        }
        c.pos++;
    }
    if (c.pos == start) {
        return -1;
    }
    return v > RE_MAX_REPEAT ? -2 : v;
}

// 1 if the '{' at c.pos starts a repeat: {n}, {n,} or {n,m}. Any other '{'
// ('{', 'a{', 'a{,2}', 'a{x}') is a literal, as in RE2.
int _re_repeat_ahead(_ReComp* c) {
    int p = c.pos + 1;
    const int s = p;
    while (p < c.len && c.pat[p] >= '0' && c.pat[p] <= '9') {
        p++;
    }
    if (p == s) {
        return 0;
    }
    if (p < c.len && c.pat[p] == ',') {
        p++;
        while (p < c.len && c.pat[p] >= '0' && c.pat[p] <= '9') {
            p++;
        }
    }
    return p < c.len && c.pat[p] == '}' ? 1 : 0;
}

// Read the quantifier at c.pos into out[0..2] (min, max with -1 unbounded,
// greedy). Returns 1 if one was read, 0 if none is there, -1 on error.
int _re_quantifier(_ReComp* c, *int out) {
    const int pk = _re_peek(c);
    int rmin = 0;
    int rmax = 0;
    if (pk == '*') {
        c.pos++;
        rmin = 0;
        rmax = -1;
    }
    else if (pk == '+') {
        c.pos++;
        rmin = 1;
        rmax = -1;
    }
    else if (pk == '?') {
        c.pos++;
        rmin = 0;
        rmax = 1;
    }
    else if (pk == '{' && _re_repeat_ahead(c) == 1) {
        c.pos++;
        const int m1 = _re_read_int(c);
        if (m1 == -2) {
            if (c.err == null) {
                c.err = "invalid repeat count";
            }
            return -1;
        }
        rmin = m1;
        if (_re_peek(c) == ',') {
            c.pos++;
            if (_re_peek(c) == '}') {
                rmax = -1;
            }
            else {
                const int m2 = _re_read_int(c);
                if (m2 == -2) {
                    if (c.err == null) {
                        c.err = "invalid repeat count";
                    }
                    return -1;
                }
                rmax = m2;
            }
        } else {
            rmax = rmin;
        }
        if (rmax != -1 && rmax < rmin) {
            if (c.err == null) {
                c.err = "invalid {n,m}: max below min";
            }
            return -1;
        }
        c.pos++;   // '}' (_re_repeat_ahead checked it is there)
    } else {
        return 0;
    }
    int greedy = 1;
    if (_re_peek(c) == '?') {
        c.pos++;
        greedy = 0;
    }
    if ((c.flags & RF_UNGREEDY) != 0) {
        greedy = 1 - greedy;
    }
    out[0] = rmin;
    out[1] = rmax;
    out[2] = greedy;
    return 1;
}

_ReNode* _re_parse_repeat(_ReComp* c) {
    _ReNode* a = _re_parse_atom(c);
    if (c.err != null) {
        return a;
    }
    if (c.inquote == 1) {
        // Only the last quoted character takes a quantifier (\Qab\E* is ab*).
        if (_re_peek(c) == '\\' && _re_peek_at(c, 1) == 'E') {
            c.pos += 2;
            c.inquote = 0;
        }
        else if (c.pos >= c.len) {
            c.inquote = 0;
        }
        else {
            return a;
        }
    }
    bool applied = false;
    while (true) {
        const int skipped = _re_skip_nops(c);
        if (c.err != null) {
            return a;
        }
        // a** is an error (RE2): the second '*' is left for _re_parse_atom.
        if (applied && skipped == 0) {
            break;
        }
        int[3] q;
        const int got = _re_quantifier(c, &q[0]);
        if (got < 0) {
            return a;
        }
        if (got == 0) {
            break;
        }
        _ReNode* n = _re_node(c, N_REPEAT);
        n.left = a;
        n.rmin = q[0];
        n.rmax = q[1];
        n.greedy = q[2];
        a = n;
        applied = true;
    }
    return a;
}

_ReNode* _re_parse_concat(_ReComp* c) {
    _ReNode* left = null;
    while (c.err == null) {
        _re_skip_nops(c);
        if (c.err != null) {
            break;
        }
        const int pk = _re_peek(c);
        if (pk == -1) {
            break;
        }
        if (c.inquote == 0 && (pk == '|' || pk == ')')) {
            break;
        }
        _ReNode* atom = _re_parse_repeat(c);
        if (left == null) {
            left = atom;
        }
        else {
            _ReNode* n = _re_node(c, N_CONCAT);
            n.left = left;
            n.right = atom;
            left = n;
        }
    }
    return left == null ? _re_node(c, N_EMPTY) : left;
}

_ReNode* _re_parse_alt(_ReComp* c) {
    _ReNode* left = _re_parse_concat(c);
    while (_re_peek(c) == '|' && c.err == null) {
        c.pos++;
        _ReNode* right = _re_parse_concat(c);
        _ReNode* n = _re_node(c, N_ALT);
        n.left = left;
        n.right = right;
        left = n;
    }
    return left;
}

// =========================== compilation ===================================

int _re_emit(_ReComp* c, int op, int a, int b) {
    if (c.err != null) {
        return 0;
    }
    Regex* re = c.re;
    if (re.ninst >= RE_MAX_INST) {
        c.err = "regex program too large";
        return 0;
    }
    const int idx = re.ninst++;
    re.inst[idx].op = op;
    re.inst[idx].a = a;
    re.inst[idx].b = b;
    return idx;
}

void _re_compile_node(_ReComp* c, _ReNode* n);

// Can `n` match the empty string?
bool _re_nullable(_ReNode* n) {
    if (n == null) {
        return true;
    }
    switch (n.kind) {
        case N_LIT: return false;
        case N_ANY: return false;
        case N_CLASS: return false;
        case N_CONCAT: return _re_nullable(n.left) && _re_nullable(n.right);
        case N_ALT: return _re_nullable(n.left) || _re_nullable(n.right);
        case N_GROUP: return _re_nullable(n.left);
        case N_REPEAT: return n.rmin == 0 || _re_nullable(n.left);
        default: return true;
    }
}

void _re_compile_repeat(_ReComp* c, _ReNode* n) {
    const int rmin = n.rmin;
    const int rmax = n.rmax;
    const bool greedy = n.greedy == 1;
    _ReNode* child = n.left;

    // Unbounded repeats follow RE2: x{n,} is n-1 copies of x then x+, and x*
    // is a loop, or (x+)? when x can match empty (the loop form would reach
    // its already-visited split after an empty iteration and drop that path).
    const int copies = rmax == -1 && rmin > 0 ? rmin - 1 : rmin;
    for (int i = 0; i < copies && c.err == null; i++) {
        _re_compile_node(c, child);
    }
    if (c.err != null) {
        return;
    }

    if (rmax == -1 && (rmin > 0 || _re_nullable(child))) {
        // x+:     body: child; l: split(body, end); end:
        // (x+)?:  q: split(body, end); then x+
        int q = -1;
        if (rmin == 0) {
            q = _re_emit(c, OP_SPLIT, 0, 0);
        }
        const int body = c.re.ninst;
        _re_compile_node(c, child);
        const int l = _re_emit(c, OP_SPLIT, 0, 0);
        const int end = c.re.ninst;
        if (c.err != null) {
            return;
        }
        if (greedy) {
            c.re.inst[l].a = body;
            c.re.inst[l].b = end;
        }
        else {
            c.re.inst[l].a = end;
            c.re.inst[l].b = body;
        }
        if (q >= 0) {
            if (greedy) {
                c.re.inst[q].a = body;
                c.re.inst[q].b = end;
            }
            else {
                c.re.inst[q].a = end;
                c.re.inst[q].b = body;
            }
        }
        return;
    }
    if (rmax == -1) {
        // x*: L: split(body,end); body: child; jmp L; end:
        const int lsplit = _re_emit(c, OP_SPLIT, 0, 0);
        const int body = c.re.ninst;
        _re_compile_node(c, child);
        _re_emit(c, OP_JMP, lsplit, 0);
        const int end = c.re.ninst;
        if (greedy) {
            c.re.inst[lsplit].a = body;
            c.re.inst[lsplit].b = end;
        }
        else {
            c.re.inst[lsplit].a = end;
            c.re.inst[lsplit].b = body;
        }
        return;
    }

    // Each optional copy: split(body, end); body: child. All splits exit to end.
    const int reps = rmax - rmin;
    if (reps <= 0) {
        return;
    }
    if (reps > RE_MAX_INST) {
        c.err = "regex program too large";
        return;
    }
    *int splits = alloc<int>(reps);
    defer free(splits);
    for (int i = 0; i < reps && c.err == null; i++) {
        const int s = _re_emit(c, OP_SPLIT, 0, 0);
        splits[i] = s;
        const int body = c.re.ninst;
        _re_compile_node(c, child);
        if (greedy) {
            c.re.inst[s].a = body;
        }
        else {
            c.re.inst[s].b = body;
        }
    }
    const int end = c.re.ninst;
    for (i in 0..reps) {
        const int s = splits[i];
        if (greedy) {
            c.re.inst[s].b = end;
        }
        else {
            c.re.inst[s].a = end;
        }
    }
}

void _re_compile_node(_ReComp* c, _ReNode* n) {
    if (n == null || c.err != null) {
        return;
    }
    switch (n.kind) {
        case N_LIT: _re_emit(c, OP_CHAR, n.ch, n.fold);
        break;
        case N_ANY: _re_emit(c, OP_ANY, n.ch, 0);
        break;
        case N_CLASS: _re_emit(c, OP_CLASS, n.cls, 0);
        break;
        case N_BOL: _re_emit(c, OP_BOL, n.ch, 0);
        break;
        case N_EOL: _re_emit(c, OP_EOL, n.ch, 0);
        break;
        case N_WORDB: _re_emit(c, OP_WORDB, n.ch, 0);
        break;
        case N_CONCAT:
        if (c.rev == 1) {
            _re_compile_node(c, n.right);
            _re_compile_node(c, n.left);
        } else {
            _re_compile_node(c, n.left);
            _re_compile_node(c, n.right);
        }
        break;
        case N_GROUP:
        if (c.rev == 1) {
            _re_compile_node(c, n.left);
            break;
        }
        _re_emit(c, OP_SAVE, 2 * n.grp, 0);
        _re_compile_node(c, n.left);
        _re_emit(c, OP_SAVE, 2 * n.grp + 1, 0);
        break;
        case N_ALT: {
            // split(a, b); a: left; jmp end; b: right; end:
            const int s = _re_emit(c, OP_SPLIT, 0, 0);
            const int a = c.re.ninst;
            _re_compile_node(c, n.left);
            const int j = _re_emit(c, OP_JMP, 0, 0);
            const int b = c.re.ninst;
            _re_compile_node(c, n.right);
            const int end = c.re.ninst;
            c.re.inst[s].a = a;
            c.re.inst[s].b = b;
            c.re.inst[j].a = end;
        }
        break;
        case N_REPEAT: _re_compile_repeat(c, n);
        break;
        default: break;                // N_EMPTY emits nothing
    }
}

// Allocate a search scratch block for a compiled program. Each thread list
// holds at most one thread per instruction (visited dedups a pc per
// generation), so ninst + 2 capture slots per list always suffice.
*_ReScratch _re_scratch_new(Regex* re) {
    const int ninst = re.ninst;
    const int ncap = 2 * (re.ngroup + 1);
    const int64 slots = (int64)(ninst + 2) * ncap;
    *_ReScratch sc = alloc<_ReScratch>(1);
    sc.visited = alloc<int>(ninst + 1);
    for (i in 0..ninst) {
        sc.visited[i] = -1;
    }
    sc.la = alloc<_ReThread>(ninst + 2);
    sc.lb = alloc<_ReThread>(ninst + 2);
    sc.capsA = alloc<int>(slots);
    sc.capsB = alloc<int>(slots);
    sc.work = alloc<int>(2 * ncap);
    return sc;
}

void _re_dfa_free(*_ReDfa d);

void _re_scratch_free(*_ReScratch sc) {
    if (sc == null) {
        return;
    }
    _re_dfa_free(sc.fdfa);
    _re_dfa_free(sc.rdfa);
    free(sc.visited);
    free(sc.la);
    free(sc.lb);
    free(sc.capsA);
    free(sc.capsB);
    free(sc.work);
    free(sc);
}

void _re_analyze(Regex* re);

// Mark in req the ASCII bytes that every match of `n` contains: those of its
// case-sensitive literals that it cannot skip (outside optional repeats, and in
// both sides of an alternation).
void _re_required(_ReNode* n, *uint8 req) {
    if (n == null) {
        return;
    }
    if (n.kind == N_LIT) {
        if (n.fold == 0 && n.ch < 128) {
            req[n.ch] = (uint8)1;
        }
    } else if (n.kind == N_CONCAT) {
        _re_required(n.left, req);
        _re_required(n.right, req);
    } else if (n.kind == N_GROUP) {
        _re_required(n.left, req);
    } else if (n.kind == N_REPEAT) {
        if (n.rmin > 0) {
            _re_required(n.left, req);
        }
    } else if (n.kind == N_ALT) {
        *uint8 a = alloc<uint8>(128);
        *uint8 b = alloc<uint8>(128);
        _re_required(n.left, a);
        _re_required(n.right, b);
        for (i in 0..128) {
            if (a[i] != (uint8)0 && b[i] != (uint8)0) {
                req[i] = (uint8)1;
            }
        }
        free(a);
        free(b);
    }
}

// Choose the required byte the search checks for first: one that cannot start
// a match (the start prefilter already looks for those) and that is not a
// letter or digit (punctuation tends to be rarer in text). -1 for none.
int _re_pick_required(Regex* re, _ReNode* ast) {
    *uint8 req = alloc<uint8>(128);
    defer free(req);
    _re_required(ast, req);
    int best = -1;
    int best_rank = 0;
    for (i in 0..128) {
        if (req[i] == (uint8)0 || i == re._pfbyte) {
            continue;
        }
        const bool alnum = (i >= '0' && i <= '9') || (i >= 'a' && i <= 'z') || (i >= 'A' && i <= 'Z');
        const int rank = (re._first[i] == (uint8)0 ? 2 : 0) + (alnum ? 1 : 2);
        if (rank > best_rank) {
            best = i;
            best_rank = rank;
        }
    }
    return best;
}

// Compile a pattern. Check the returned Regex.ok before matching; on failure
// Regex.err holds the reason. Free with Regex_free either way.
Regex regex_compile(string pattern) {
    let re: Regex;
    re.inst = alloc<_ReInst>(RE_MAX_INST);
    re.ninst = 0;
    re.classes = alloc<_ReClassInfo>(RE_MAX_CLASS);
    re.nclass = 0;
    re.ranges = alloc<_ReRange>(RE_MAX_RANGE);
    re.nrange = 0;
    re.props = alloc<_ReProp>(RE_MAX_PROP);
    re.nprop = 0;
    re.ngroup = 0;
    re.ok = 0;
    re.err = null;
    re._rinst = null;
    re._rninst = 0;
    re._ramask = null;

    let c: _ReComp;
    c.pat = pattern;
    c.len = (int)strlen(pattern);
    c.pos = 0;
    c.ngroup = 0;
    c.err = null;
    c.re = &re;
    c.nodes = alloc<_ReNode>(RE_MAX_NODES);
    c.nnode = 0;
    c.depth = 0;
    c.flags = 0;
    c.inquote = 0;
    c.rev = 0;
    defer free(c.nodes);

    _ReNode* ast = _re_parse_alt(&c);
    if (c.err == null && c.pos != c.len) {
        c.err = "unexpected trailing characters";
    }
    if (c.err != null) {
        re.err = c.err;
        return re;
    }
    re.ngroup = c.ngroup;

    _re_emit(&c, OP_SAVE, 0, 0);
    _re_compile_node(&c, ast);
    _re_emit(&c, OP_SAVE, 1, 0);
    _re_emit(&c, OP_MATCH, 0, 0);

    if (c.err != null) {
        re.err = c.err;
        return re;
    }
    // The reversed program: ast right to left, then MATCH. A pattern whose
    // reversed program does not fit only loses the DFA.
    *_ReInst fwd = re.inst;
    const int nfwd = re.ninst;
    re.inst = alloc<_ReInst>(RE_MAX_INST);
    re.ninst = 0;
    c.rev = 1;
    _re_compile_node(&c, ast);
    _re_emit(&c, OP_MATCH, 0, 0);
    c.rev = 0;
    if (c.err == null) {
        re._rinst = re.inst;
        re._rninst = re.ninst;
    } else {
        free(re.inst);
        c.err = null;
    }
    re.inst = fwd;
    re.ninst = nfwd;

    re._scratch = _re_scratch_new(&re);
    _re_analyze(&re);
    if (re._rinst != null) {
        re._ramask = _re_masks(&re, re._rinst, re._rninst);
    }
    re._req = _re_pick_required(&re, ast);
    re.ok = 1;
    return re;
}

void Regex_free(Regex* re) {
    free(re.inst);
    free(re.classes);
    free(re.ranges);
    free(re.props);
    free(re._amask);
    free(re._first);
    free(re._inmatch);
    _re_scratch_free(re._scratch);
    free(re._rinst);
    free(re._ramask);
    re._rinst = null;
    re._ramask = null;
    re.inst = null;
    re.classes = null;
    re.ranges = null;
    re.props = null;
    re._amask = null;
    re._first = null;
    re._inmatch = null;
    re._scratch = null;
}

// =========================== matching (Pike VM) ============================

// An ASCII word byte (\w): the side test of \b and \B.
bool _re_is_word(int ch) {
    return (ch >= '0' && ch <= '9') || (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || ch == '_';
}

bool _re_prop_has(_ReProp* p, int ch) {
    switch (p.kind) {
        case P_ASCII: return _re_class_has(p.val, ch) == 1;
        case P_CAT: {
            const int id = _re_cat_of(ch);
            return id != 255 && ((p.val >> id) & 1) == 1;
        }
        case P_SCRIPT: return _re_script_of(ch) == p.val;
        default: return true;          // P_ANY
    }
}

int _re_in_class(Regex* re, int id, int ch) {
    const _ReClassInfo ci = re.classes[id];
    int[8] orb;
    const int no = _re_orbit(ch, ci.fold, &orb[0]);
    bool found = false;
    for (k in 0..no) {
        for (i in ci.start..ci.start + ci.count) {
            if (orb[k] >= re.ranges[i].lo && orb[k] <= re.ranges[i].hi) {
                found = true;
                break;
            }
        }
        if (found) {
            break;
        }
    }
    for (int i = ci.pstart; !found && i < ci.pstart + ci.pcount; i++) {
        bool any = false;
        for (k in 0..no) {
            if (_re_prop_has(&re.props[i], orb[k])) {
                any = true;
                break;
            }
        }
        found = any != (re.props[i].neg == 1);
    }
    return found != (ci.negate == 1) ? 1 : 0;
}

// 1 if code point `ch` matches the literal `lit`, folded when `fold` is set.
int _re_char_eq(int lit, int fold, int ch) {
    if (ch == lit) {
        return 1;
    }
    if (fold == 0) {
        return 0;
    }
    int f = _re_simple_fold(lit);
    while (f != lit) {
        if (f == ch) {
            return 1;
        }
        f = _re_simple_fold(f);
    }
    return 0;
}

// Copy `src` into the capture slot of thread `slot` in list `which`.
*int _re_slotcaps(_ReVm* vm, int which, int slot, *int src) {
    *int dst = which == 0 ? &vm.capsA[slot * vm.ncap] : &vm.capsB[slot * vm.ncap];
    for (i in 0..vm.ncap) {
        dst[i] = src[i];
    }
    return dst;
}

// Epsilon-closure add of pc (and its reachable pcs) into list `which`. `caps` is
// a working array: SAVE writes it in place and restores it on the way back, and
// only a thread that is enqueued gets its own copy.
void _re_addthread(_ReVm* vm, int which, int gen, int pc, *int caps, int sp) {
    if (vm.visited[pc] == gen) {
        return;
    }
    vm.visited[pc] = gen;
    _ReInst* ins = &vm.prog.inst[pc];
    switch (ins.op) {
        case OP_JMP:
        _re_addthread(vm, which, gen, ins.a, caps, sp);
        break;
        case OP_SPLIT:
        _re_addthread(vm, which, gen, ins.a, caps, sp);
        _re_addthread(vm, which, gen, ins.b, caps, sp);
        break;
        case OP_SAVE: {
            const int old = caps[ins.a];
            caps[ins.a] = sp;
            _re_addthread(vm, which, gen, pc + 1, caps, sp);
            caps[ins.a] = old;
        }
        break;
        case OP_BOL:
        if (sp == 0 || (ins.a == 1 && vm.text[sp - 1] == '\n')) {
            _re_addthread(vm, which, gen, pc + 1, caps, sp);
        }
        break;
        case OP_EOL:
        if (sp == vm.len || (ins.a == 1 && vm.text[sp] == '\n')) {
            _re_addthread(vm, which, gen, pc + 1, caps, sp);
        }
        break;
        case OP_WORDB: {
            const bool before = sp > 0 && _re_is_word((int)((uint8)vm.text[sp - 1]));
            const bool after = sp < vm.len && _re_is_word((int)((uint8)vm.text[sp]));
            if ((before != after) != (ins.a == 1)) {
                _re_addthread(vm, which, gen, pc + 1, caps, sp);
            }
        }
        break;
        default:
        // CHAR / ANY / CLASS / MATCH: a thread that consumes (or accepts). One
        // that cannot consume what is at sp (the end, or an ASCII byte it does
        // not accept) would die at the next step: it is not enqueued (its pc
        // stays marked, which changes nothing since it adds no thread).
        if (ins.op != OP_MATCH) {
            if (sp >= vm.len) {
                return;
            }
            const int b = (int)((uint8)vm.text[sp]);
            if (b < 128 && ((vm.prog._amask[2 * pc + (b >> 6)] >> (uint64)(b & 63)) & (uint64)1) == (uint64)0) {
                return;
            }
        }
        if (which == 0) {
            vm.la[vm.nA].pc = pc;
            vm.la[vm.nA].caps = _re_slotcaps(vm, 0, vm.nA, caps);
            vm.nA++;
        } else {
            vm.lb[vm.nB].pc = pc;
            vm.lb[vm.nB].caps = _re_slotcaps(vm, 1, vm.nB, caps);
            vm.nB++;
        }
    }
}

// =========================== search prefilter ==============================

// The first byte of the UTF-8 encoding of r (r >= 0x80).
int _re_lead_byte(int r) {
    if (r < 0x800) {
        return 0xC0 | (r >> 6);
    }
    if (r < 0x10000) {
        return 0xE0 | (r >> 12);
    }
    return 0xF0 | (r >> 18);
}

// Mark in fb the bytes from 0x80 up that can begin a code point the consuming
// instruction `ins` accepts. A byte that is not valid UTF-8 reads as U+FFFD, so
// an instruction that may accept U+FFFD marks all of them; so does one whose
// non-ASCII members are not simply known (a negated or case-folded class, a
// Unicode property, `.`).
void _re_high_bytes(Regex* re, _ReInst* ins, *uint8 fb) {
    bool all = false;
    if (ins.op == OP_CHAR) {
        int[8] orb;
        const int no = _re_orbit(ins.a, ins.b, &orb[0]);
        for (k in 0..no) {
            if (orb[k] == 0xFFFD) {
                all = true;
            } else if (orb[k] >= 0x80) {
                fb[_re_lead_byte(orb[k])] = (uint8)1;
            }
        }
    } else if (ins.op == OP_CLASS) {
        const _ReClassInfo ci = re.classes[ins.a];
        all = ci.negate == 1 || ci.fold == 1;
        for (int i = ci.pstart; !all && i < ci.pstart + ci.pcount; i++) {
            all = re.props[i].kind != P_ASCII || re.props[i].neg == 1;
        }
        for (int i = ci.start; !all && i < ci.start + ci.count; i++) {
            const int lo = re.ranges[i].lo < 0x80 ? 0x80 : re.ranges[i].lo;
            const int hi = re.ranges[i].hi;
            if (hi < 0x80) {
                continue;
            }
            if (lo <= 0xFFFD && hi >= 0xFFFD) {
                all = true;
            } else {
                for (int b = _re_lead_byte(lo); b <= _re_lead_byte(hi); b++) {
                    fb[b] = (uint8)1;
                }
            }
        }
    } else {
        all = true;
    }
    if (all) {
        for (b in 0x80..0x100) {
            fb[b] = (uint8)1;
        }
    }
}

// Walk the instructions reachable from pc without consuming, marking in fb the
// bytes the consuming ones can start with. flags[0] is set when a MATCH is
// reachable (the pattern can match empty), flags[1] when a consuming
// instruction or a MATCH is reachable without passing a `^` that holds only at
// offset 0 (bol is 1 once the path has passed one). seen holds, per pc, a bit
// for each bol state already walked.
void _re_first_walk(Regex* re, int pc, int bol, *int seen, *uint8 fb, *int flags) {
    const int bit = bol == 1 ? 2 : 1;
    if ((seen[pc] & bit) != 0) {
        return;
    }
    seen[pc] = seen[pc] | bit;
    _ReInst* ins = &re.inst[pc];
    const int op = ins.op;
    if (op == OP_JMP) {
        _re_first_walk(re, ins.a, bol, seen, fb, flags);
    } else if (op == OP_SPLIT) {
        _re_first_walk(re, ins.a, bol, seen, fb, flags);
        _re_first_walk(re, ins.b, bol, seen, fb, flags);
    } else if (op == OP_BOL) {
        _re_first_walk(re, pc + 1, ins.a == 0 ? 1 : bol, seen, fb, flags);
    } else if (op == OP_SAVE || op == OP_EOL || op == OP_WORDB) {
        _re_first_walk(re, pc + 1, bol, seen, fb, flags);
    } else {
        if (op == OP_MATCH) {
            flags[0] = 1;
        } else {
            for (ch in 0..128) {
                if (((re._amask[2 * pc + (ch >> 6)] >> (uint64)(ch & 63)) & (uint64)1) != (uint64)0) {
                    fb[ch] = (uint8)1;
                }
            }
            _re_high_bytes(re, ins, fb);
        }
        if (bol == 0) {
            flags[1] = 1;
        }
    }
}

// For each of the `n` instructions of `insts`, the ASCII code points it
// consumes, as two words of bits.
*uint64 _re_masks(Regex* re, *_ReInst insts, int n) {
    *uint64 am = alloc<uint64>(2 * n + 2);
    for (pc in 0..n) {
        const _ReInst ins = insts[pc];
        if (ins.op != OP_CHAR && ins.op != OP_ANY && ins.op != OP_CLASS) {
            continue;
        }
        for (ch in 0..128) {
            bool step = false;
            if (ins.op == OP_CHAR) {
                step = _re_char_eq(ins.a, ins.b, ch) == 1;
            } else if (ins.op == OP_ANY) {
                step = ch != '\n' || ins.a == 1;
            } else {
                step = _re_in_class(re, ins.a, ch) == 1;
            }
            if (step) {
                am[2 * pc + (ch >> 6)] = am[2 * pc + (ch >> 6)] | ((uint64)1 << (uint64)(ch & 63));
            }
        }
    }
    return am;
}

// Fill the ASCII masks of the instructions and the start prefilter.
void _re_analyze(Regex* re) {
    const int ninst = re.ninst;
    re._amask = _re_masks(re, re.inst, ninst);
    re._inmatch = alloc<uint8>(256);
    for (pc in 0..ninst) {
        const int op = re.inst[pc].op;
        if (op == OP_CHAR || op == OP_ANY || op == OP_CLASS) {
            for (ch in 0..128) {
                if (((re._amask[2 * pc + (ch >> 6)] >> (uint64)(ch & 63)) & (uint64)1) != (uint64)0) {
                    re._inmatch[ch] = (uint8)1;
                }
            }
            _re_high_bytes(re, &re.inst[pc], re._inmatch);
        }
    }
    re._reqscan = 1;
    for (b in 0x80..0x100) {
        if (re._inmatch[b] != (uint8)0) {
            re._reqscan = 0;
        }
    }
    re._first = alloc<uint8>(256);
    *int seen = alloc<int>(ninst);
    defer free(seen);
    int[2] flags;
    flags[0] = 0;
    flags[1] = 0;
    _re_first_walk(re, 0, 0, seen, re._first, &flags[0]);
    int count = 0;
    int last = -1;
    for (b in 0..256) {
        if (re._first[b] != (uint8)0) {
            count++;
            last = b;
        }
    }
    re._bolonly = flags[1] == 0 ? 1 : 0;
    re._pf = flags[0] == 0 && count < 256 ? 1 : 0;
    re._pfbyte = count == 1 && last < 0x80 ? last : -1;
}

// The first offset from sp on (sp itself included) where a match can start,
// by the prefilter (_pf is 1); len when there is none. Only offsets the search
// would step to are returned: an ASCII byte always starts a code point, and
// other bytes are passed a whole code point at a time.
int _re_skip(Regex* re, string text, int len, int sp) {
    if (re._pfbyte >= 0) {
        *uint8 base = (*uint8)text;
        *void p = memchr((*void)(base + sp), re._pfbyte, (size_t)(len - sp));
        if (p == null) {
            return len;
        }
        return (int)((*uint8)p - base);
    }
    *uint8 fb = re._first;
    int[1] w;
    while (sp < len) {
        const int b = (int)((uint8)text[sp]);
        if (fb[b] != (uint8)0) {
            return sp;
        }
        if (b < 0x80) {
            sp++;
        } else {
            _re_decode(text, len, sp, &w[0]);
            sp += w[0];
        }
    }
    return len;
}

// =========================== lazy DFA ======================================

#define RE_DFA_RESTART -1
#define RE_DFA_DEAD -2
#define RE_DFA_FAIL -3
#define RE_DFA_MAX_STATES 4096
#define RE_DFA_MAX_POOL 1048576

// The side flags of a point's neighbour: none (the text's edge), a newline, an
// ASCII word character (what ^, $, \b and \B look at), or 0 for anything else.
#define DF_NONE 1
#define DF_NL   2
#define DF_WORD 4

int _re_side(int ch) {
    if (ch < 0) {
        return DF_NONE;
    }
    if (ch == '\n') {
        return DF_NL;
    }
    return ch < 128 && _re_is_word(ch) ? DF_WORD : 0;
}

*_ReDfa _re_dfa_new(Regex* re, int reverse) {
    *_ReDfa d = alloc<_ReDfa>(1);
    d.re = re;
    d.reverse = reverse;
    d.insts = reverse == 1 ? re._rinst : re.inst;
    d.amask = reverse == 1 ? re._ramask : re._amask;
    d.ninst = reverse == 1 ? re._rninst : re.ninst;
    d.restart = 1 - reverse;
    d.cut = 1 - reverse;
    d.cpool = 1024;
    d.pool = alloc<int>(d.cpool);
    d.cst = 32;
    d.off = alloc<int>(d.cst);
    d.len = alloc<int>(d.cst);
    d.flags = alloc<int>(d.cst);
    d.isstart = alloc<uint8>(d.cst);
    d.trans = alloc<int>(d.cst * 128);
    d.hcap = 64;
    d.hash = alloc<int>(d.hcap);
    d.mark = alloc<int>(d.ninst + 1);
    d.buf1 = alloc<int>(d.ninst + 2);
    d.buf2 = alloc<int>(d.ninst + 2);
    return d;
}

void _re_dfa_free(*_ReDfa d) {
    if (d == null) {
        return;
    }
    free(d.pool);
    free(d.off);
    free(d.len);
    free(d.flags);
    free(d.isstart);
    free(d.trans);
    free(d.hash);
    free(d.mark);
    free(d.buf1);
    free(d.buf2);
    free(d);
}

// Does the zero-width assertion `ins` hold between neighbours with side flags
// `left` and `right`?
bool _re_holds(_ReInst* ins, int left, int right) {
    if (ins.op == OP_BOL) {
        return (left & DF_NONE) != 0 || (ins.a == 1 && (left & DF_NL) != 0);
    }
    if (ins.op == OP_EOL) {
        return (right & DF_NONE) != 0 || (ins.a == 1 && (right & DF_NL) != 0);
    }
    const bool b = ((left & DF_WORD) != 0) != ((right & DF_WORD) != 0);
    return b != (ins.a == 1);
}

// Add pc and what it reaches without consuming to `list` (*n items), in the
// Pike VM's priority order. With `resolve`, assertions are decided between
// `left` and `right`; without, they are kept in the list to decide later.
void _re_dfa_add(_ReDfa* d, int pc, *int list, *int n, bool resolve, int left, int right) {
    if (d.mark[pc] == d.gen) {
        return;
    }
    d.mark[pc] = d.gen;
    _ReInst* ins = &d.insts[pc];
    const int op = ins.op;
    if (op == OP_JMP) {
        _re_dfa_add(d, ins.a, list, n, resolve, left, right);
    } else if (op == OP_SPLIT) {
        _re_dfa_add(d, ins.a, list, n, resolve, left, right);
        _re_dfa_add(d, ins.b, list, n, resolve, left, right);
    } else if (op == OP_SAVE) {
        _re_dfa_add(d, pc + 1, list, n, resolve, left, right);
    } else if (op == OP_BOL || op == OP_EOL || op == OP_WORDB) {
        if (!resolve) {
            list[*n] = pc;
            *n = *n + 1;
        } else if (_re_holds(ins, left, right)) {
            _re_dfa_add(d, pc + 1, list, n, resolve, left, right);
        }
    } else {
        list[*n] = pc;
        *n = *n + 1;
    }
}

// Does the consuming instruction pc accept code point ch?
bool _re_dfa_accepts(_ReDfa* d, int pc, int ch) {
    if (ch < 128) {
        return ((d.amask[2 * pc + (ch >> 6)] >> (uint64)(ch & 63)) & (uint64)1) != (uint64)0;
    }
    _ReInst* ins = &d.insts[pc];
    if (ins.op == OP_CHAR) {
        return _re_char_eq(ins.a, ins.b, ch) == 1;
    }
    if (ins.op == OP_ANY) {
        return true;
    }
    if (ins.op == OP_CLASS) {
        return _re_in_class(d.re, ins.a, ch) == 1;
    }
    return false;
}

void _re_dfa_grow(_ReDfa* d) {
    const int nc = d.cst * 2;
    *int off = alloc<int>(nc);
    *int len = alloc<int>(nc);
    *int flags = alloc<int>(nc);
    *uint8 isstart = alloc<uint8>(nc);
    *int trans = alloc<int>(nc * 128);
    memcpy((*void)off, (*void)d.off, (size_t)(d.nst * 4));
    memcpy((*void)len, (*void)d.len, (size_t)(d.nst * 4));
    memcpy((*void)flags, (*void)d.flags, (size_t)(d.nst * 4));
    memcpy((*void)isstart, (*void)d.isstart, (size_t)d.nst);
    memcpy((*void)trans, (*void)d.trans, (size_t)(d.nst * 128 * 4));
    free(d.off);
    free(d.len);
    free(d.flags);
    free(d.isstart);
    free(d.trans);
    d.off = off;
    d.len = len;
    d.flags = flags;
    d.isstart = isstart;
    d.trans = trans;
    d.cst = nc;
}

int _re_dfa_hash(*int list, int n, int flags) {
    int64 h = (int64)flags * 31 + (int64)n;
    for (i in 0..n) {
        h = (h * 1000003 + (int64)list[i]) & 0x7fffffff;
    }
    return (int)h;
}

int _re_dfa_find(_ReDfa* d, *int list, int n, int flags, int h) {
    int i = h & (d.hcap - 1);
    while (d.hash[i] != 0) {
        const int st = d.hash[i] - 1;
        if (d.len[st] == n && d.flags[st] == flags) {
            *int items = &d.pool[d.off[st]];
            bool same = true;
            for (k in 0..n) {
                if (items[k] != list[k]) {
                    same = false;
                    break;
                }
            }
            if (same) {
                return st;
            }
        }
        i = (i + 1) & (d.hcap - 1);
    }
    return -1 - i;
}

// The state with these items and flags, made when new: RE_DFA_DEAD for no item,
// RE_DFA_FAIL past the budget.
int _re_dfa_state(_ReDfa* d, *int list, int n, int flags) {
    if (n == 0) {
        return RE_DFA_DEAD;
    }
    const int h = _re_dfa_hash(list, n, flags);
    int slot = _re_dfa_find(d, list, n, flags, h);
    if (slot >= 0) {
        return slot;
    }
    if (d.nst >= RE_DFA_MAX_STATES || d.npool + n > RE_DFA_MAX_POOL) {
        return RE_DFA_FAIL;
    }
    if (d.npool + n > d.cpool) {
        int nc = d.cpool * 2;
        while (nc < d.npool + n) {
            nc = nc * 2;
        }
        *int pool = alloc<int>(nc);
        memcpy((*void)pool, (*void)d.pool, (size_t)(d.npool * 4));
        free(d.pool);
        d.pool = pool;
        d.cpool = nc;
    }
    if (d.nst == d.cst) {
        _re_dfa_grow(d);
    }
    if ((d.nst + 1) * 2 > d.hcap) {
        const int nh = d.hcap * 2;
        free(d.hash);
        d.hash = alloc<int>(nh);
        d.hcap = nh;
        for (st in 0..d.nst) {
            const int sh = _re_dfa_hash(&d.pool[d.off[st]], d.len[st], d.flags[st]);
            const int e = _re_dfa_find(d, &d.pool[d.off[st]], d.len[st], d.flags[st], sh);
            d.hash[-1 - e] = st + 1;
        }
        slot = _re_dfa_find(d, list, n, flags, h);
    }
    const int st = d.nst++;
    d.off[st] = d.npool;
    d.len[st] = n;
    d.flags[st] = flags;
    for (k in 0..n) {
        d.pool[d.npool + k] = list[k];
    }
    d.npool += n;
    d.hash[-1 - slot] = st + 1;
    return st;
}

// The start state at a point whose consumed-side neighbour has side flags
// `flags`: what pc 0 reaches, then the restart (forward).
int _re_dfa_start(_ReDfa* d, int flags) {
    d.gen++;
    int n = 0;
    _re_dfa_add(d, 0, d.buf1, &n, false, 0, 0);
    if (d.restart == 1) {
        d.buf1[n] = RE_DFA_RESTART;
        n++;
    }
    const int st = _re_dfa_state(d, d.buf1, n, flags);
    if (st >= 0) {
        d.isstart[st] = (uint8)1;
    }
    return st;
}

// From state st, with `ch` (-1 for none) the next code point: *match is 1 when a
// match ends at this point; with `step`, returns the state after `ch`
// (RE_DFA_DEAD, or RE_DFA_FAIL past the budget).
int _re_dfa_next(_ReDfa* d, int st, int ch, bool step, *int hit) {
    const int consumed = d.flags[st];
    const int ahead = _re_side(ch);
    const int left = d.reverse == 1 ? ahead : consumed;
    const int right = d.reverse == 1 ? consumed : ahead;
    *int items = &d.pool[d.off[st]];
    const int ni = d.len[st];
    d.gen++;
    int n1 = 0;
    for (i in 0..ni) {
        if (items[i] == RE_DFA_RESTART) {
            d.buf1[n1] = RE_DFA_RESTART;
            n1++;
        } else {
            _re_dfa_add(d, items[i], d.buf1, &n1, true, left, right);
        }
    }
    *hit = 0;
    for (i in 0..n1) {
        if (d.buf1[i] >= 0 && d.insts[d.buf1[i]].op == OP_MATCH) {
            *hit = 1;
            if (d.cut == 1) {
                n1 = i;
            }
            break;
        }
    }
    if (!step) {
        return RE_DFA_DEAD;
    }
    d.gen++;
    int n2 = 0;
    for (i in 0..n1) {
        const int it = d.buf1[i];
        if (it == RE_DFA_RESTART) {
            _re_dfa_add(d, 0, d.buf2, &n2, false, 0, 0);
            d.buf2[n2] = RE_DFA_RESTART;
            n2++;
        } else if (d.insts[it].op != OP_MATCH && _re_dfa_accepts(d, it, ch)) {
            _re_dfa_add(d, it + 1, d.buf2, &n2, false, 0, 0);
        }
    }
    return _re_dfa_state(d, d.buf2, n2, _re_side(ch));
}

// _re_dfa_next for a step over `ch`, through the state's cache for ASCII.
int _re_dfa_step(_ReDfa* d, int st, int ch, *int hit) {
    if (ch >= 128) {
        return _re_dfa_next(d, st, ch, true, hit);
    }
    const int t = d.trans[st * 128 + ch];
    if (t != 0) {
        *hit = t & 1;
        return (t >> 1) - 3;
    }
    const int nx = _re_dfa_next(d, st, ch, true, hit);
    if (nx != RE_DFA_FAIL) {
        d.trans[st * 128 + ch] = (nx + 3) * 2 + *hit;
    }
    return nx;
}

// The side flags of the code point before byte offset p (ASCII decides them).
int _re_side_before(string text, int p) {
    if (p <= 0) {
        return DF_NONE;
    }
    const int b = (int)((uint8)text[p - 1]);
    return b < 128 ? _re_side(b) : 0;
}

int _re_side_at(string text, int len, int p) {
    if (p >= len) {
        return DF_NONE;
    }
    const int b = (int)((uint8)text[p]);
    return b < 128 ? _re_side(b) : 0;
}

// The code point that ends at byte offset p (> lo), with its width in w[0], as
// Go's utf8.DecodeLastRune over the bytes from lo: a byte that does not end a
// valid sequence is one U+FFFD. The forward search reads the same code points
// from lo (a search from the middle of a sequence sees its rest as U+FFFDs).
int _re_decode_last(string text, int len, int lo, int p, *int w) {
    const int b = (int)((uint8)text[p - 1]);
    if (b < 0x80) {
        w[0] = 1;
        return b;
    }
    int lead = p - 1;
    while (lead > lo && lead > p - 4 && ((int)((uint8)text[lead]) & 0xC0) == 0x80) {
        lead--;
    }
    int[1] fw;
    const int r = _re_decode(text, len, lead, &fw[0]);
    if (r >= 0 && lead + fw[0] == p) {
        w[0] = fw[0];
        return r;
    }
    w[0] = 1;
    return 0xFFFD;
}

// The end of the leftmost-first match at or after `start` (the one the Pike VM
// reports), in *end: 1, 0 for none, -1 when the DFA outgrew its budget.
int _re_dfa_forward(Regex* re, _ReDfa* d, string text, int len, int start, *int end) {
    int st = _re_dfa_start(d, _re_side_before(text, start));
    if (st < 0) {
        return -1;
    }
    // In a start state the search jumps to the next byte a match can begin with,
    // when that is one byte (memchr); otherwise the cached transitions are as fast.
    const bool pf = re._pf == 1 && re._pfbyte >= 0;
    int last = -1;
    int p = start;
    int[1] w;
    int[1] m;
    while (true) {
        if (pf && last < 0 && d.isstart[st] != (uint8)0) {
            const int np = _re_skip(re, text, len, p);
            if (np >= len) {
                break;                  // _pf: no empty match, so none at the end either
            }
            if (np != p) {
                p = np;
                st = _re_dfa_start(d, _re_side_before(text, p));
                if (st < 0) {
                    return -1;
                }
            }
        }
        if (p >= len) {
            _re_dfa_next(d, st, -1, false, &m[0]);
            if (m[0] == 1) {
                last = len;
            }
            break;
        }
        // The cached ASCII transitions, without leaving the loop (a start state
        // goes back to the prefilter above).
        *int trans = d.trans;
        *uint8 isstart = d.isstart;
        bool moved = false;
        while (p < len) {
            const int b = (int)((uint8)text[p]);
            if (b >= 128) {
                break;
            }
            const int t = trans[st * 128 + b];
            if (t == 0) {
                break;
            }
            if ((t & 1) != 0) {
                last = p;
            }
            const int nx = (t >> 1) - 3;
            if (nx < 0) {
                st = nx;
                break;
            }
            st = nx;
            p++;
            moved = true;
            if (pf && last < 0 && isstart[st] != (uint8)0) {
                break;
            }
        }
        if (st == RE_DFA_DEAD) {
            break;
        }
        if (moved) {
            continue;
        }
        if (p >= len) {
            continue;
        }
        int ch = (int)((uint8)text[p]);
        w[0] = 1;
        if (ch >= 128) {
            ch = _re_decode(text, len, p, &w[0]);
            if (ch < 0) {
                ch = 0xFFFD;
            }
        }
        const int nx = _re_dfa_step(d, st, ch, &m[0]);
        if (m[0] == 1) {
            last = p;
        }
        if (nx == RE_DFA_FAIL) {
            return -1;
        }
        if (nx == RE_DFA_DEAD) {
            break;
        }
        st = nx;
        p += w[0];
    }
    if (last < 0) {
        return 0;
    }
    *end = last;
    return 1;
}

// The leftmost start, at or after `start`, of a match ending at `end` (the
// reversed program run backwards from `end`, keeping the last point where it
// matches), or -1 when the DFA outgrew its budget.
int _re_dfa_reverse(_ReDfa* d, string text, int len, int start, int end) {
    int st = _re_dfa_start(d, _re_side_at(text, len, end));
    if (st < 0) {
        return -1;
    }
    int best = -1;
    int p = end;
    int[1] w;
    int[1] m;
    while (true) {
        if (p <= start) {
            int la = -1;
            if (start > 0) {
                la = _re_decode_last(text, len, 0, start, &w[0]);
            }
            _re_dfa_next(d, st, la, false, &m[0]);
            if (m[0] == 1) {
                best = p;
            }
            break;
        }
        const int ch = _re_decode_last(text, len, start, p, &w[0]);
        const int nx = _re_dfa_step(d, st, ch, &m[0]);
        if (m[0] == 1) {
            best = p;
        }
        if (nx == RE_DFA_FAIL) {
            return -1;
        }
        if (nx == RE_DFA_DEAD) {
            break;
        }
        st = nx;
        p -= w[0];
    }
    return best;
}

// Set to make every search run the Pike VM alone (tests compare it with the DFA).
bool _re_force_vm = false;

// Regex_search_at, writing the groups of a match into `buf` (2 * (ngroup + 1)
// ints, or null to allocate them). `buf` is not freed when there is no match.
int _re_search(Regex* re, string text, int64 len, int64 start, Match* m, *int buf) {
    m.ok = 0;
    m.ngroup = re.ngroup;
    m.start = -1;
    m.end = -1;
    m.cap = null;
    if (re.ok == 0 || start < 0 || start > len || len > 2147483646) {
        return 0;
    }
    if (re._bolonly == 1 && start > 0) {
        return 0;
    }
    // The Regex's scratch when no other search holds it, else one for this call.
    *_ReScratch sc = re._scratch;
    const bool own = !atomic_cas(&sc.busy, 0, 1);
    if (own) {
        sc = _re_scratch_new(re);
    }
    const int ncap = 2 * (re.ngroup + 1);
    *int caps = &sc.work[ncap];
    bool matched = false;
    bool done = false;
    // The DFAs find where the match ends and where it starts; the Pike VM then
    // runs over that span only, for the groups (none to find: no run at all).
    if (sc.dfa_off == 0 && re._rinst != null && !_re_force_vm) {
        if (sc.fdfa == null) {
            sc.fdfa = _re_dfa_new(re, 0);
            sc.rdfa = _re_dfa_new(re, 1);
        }
        int[1] e;
        const int f = _re_dfa_forward(re, sc.fdfa, text, (int)len, (int)start, &e[0]);
        if (f == 0) {
            done = true;
        } else if (f == 1) {
            const int b = _re_dfa_reverse(sc.rdfa, text, (int)len, (int)start, e[0]);
            if (b >= 0) {
                done = true;
                matched = true;
                if (re.ngroup == 0) {
                    caps[0] = b;
                    caps[1] = e[0];
                } else {
                    matched = _re_pike(re, sc, text, len, (int64)b, true, caps);
                }
            }
        }
        if (!done) {
            sc.dfa_off = 1;
        }
    }
    if (!done) {
        matched = _re_pike(re, sc, text, len, start, false, caps);
    }
    if (matched) {
        m.ok = 1;
        m.cap = buf != null ? buf : alloc<int>(ncap);
        for (j in 0..ncap) {
            m.cap[j] = caps[j];
        }
        m.start = m.cap[0];
        m.end = m.cap[1];
    }
    if (own) {
        _re_scratch_free(sc);
    } else {
        atomic_store(&sc.busy, 0);
    }
    return m.ok;
}

// The Pike VM from `start` (only there when `anchored`): true and the groups of
// the leftmost-first match in `out` (2 * (ngroup + 1) ints), or false.
bool _re_pike(Regex* re, *_ReScratch sc, string text, int64 len, int64 start, bool anchored, *int out) {
    let vm: _ReVm;
    vm.prog = re;
    vm.text = text;
    vm.len = (int)len;
    vm.ncap = 2 * (re.ngroup + 1);
    const int ninst = re.ninst;
    vm.visited = sc.visited;
    vm.la = sc.la;
    vm.lb = sc.lb;
    vm.capsA = sc.capsA;
    vm.capsB = sc.capsB;
    vm.nA = 0;
    vm.nB = 0;
    *int workcaps = sc.work;
    *int bestcaps = &sc.work[vm.ncap];

    // Generations count up across searches; a search uses at most two per
    // step, and the stamps restart when the count could overflow.
    int glob = sc.visited[ninst];
    if ((int64)glob + 2 * (len - start) + 8 > (int64)2147483647) {
        for (i in 0..ninst) {
            sc.visited[i] = -1;
        }
        glob = 0;
    }
    glob++;

    bool matched = false;
    int cur = 0;
    int curgen = glob;
    int[1] w;

    // One step per code point: every thread reads the one at sp, whose width
    // (1 for a byte that is not valid UTF-8, read as U+FFFD) moves sp.
    *uint64 am = re._amask;
    *uint8 fb = re._first;
    const bool pf = re._pf == 1;
    const int req = re._req;
    int reqpos = -1;
    int reqmin = 0;
    int sp = (int)start;
    while (sp <= vm.len) {
        if (!matched && (cur == 0 ? vm.nA : vm.nB) == 0) {
            // No thread is alive: a match can only start where the prefilter
            // allows (and only at offset 0 when every match starts there).
            if (re._bolonly == 1 && sp > 0) {
                break;
            }
            if (anchored) {
                if (sp > (int)start) {
                    break;
                }
            }
            int nsp = sp;
            if (req >= 0 && !anchored) {
                // A match holds a `req` byte at or after its start, so none
                // starts at sp or later if no `req` byte follows. With _reqscan,
                // every byte of a match is in _inmatch, so a match starting
                // before the first `req` byte must cover the run of _inmatch
                // bytes that ends there: none starts before that run (reqmin).
                if (sp > reqpos) {
                    *uint8 base = (*uint8)text;
                    *void p = memchr((*void)(base + sp), req, (size_t)(vm.len - sp));
                    if (p == null) {
                        break;
                    }
                    reqpos = (int)((*uint8)p - base);
                    reqmin = sp;
                    if (re._reqscan == 1) {
                        reqmin = reqpos;
                        while (reqmin > sp && re._inmatch[(int)((uint8)text[reqmin - 1])] != (uint8)0) {
                            reqmin--;
                        }
                    }
                }
                if (reqmin > nsp) {
                    nsp = reqmin;
                }
            }
            if (pf && !anchored) {
                nsp = _re_skip(re, text, vm.len, nsp);
                if (nsp >= vm.len) {
                    break;
                }
            }
            if (nsp != sp) {
                sp = nsp;
                curgen = ++glob;
            }
        }
        int ch = -1;
        w[0] = 1;
        if (sp < vm.len) {
            ch = _re_decode(text, vm.len, sp, &w[0]);
            if (ch < 0) {
                ch = 0xFFFD;
            }
        }
        // Until a match is found, start a new thread at every position where a
        // match can start (a thread started elsewhere would die at once).
        if (!matched && (!pf || (sp < vm.len && fb[(int)((uint8)text[sp])] != (uint8)0)) && (re._bolonly == 0 || sp == 0)
            && (!anchored || sp == (int)start)) {
            for (k in 0..vm.ncap) {
                workcaps[k] = -1;
            }
            _re_addthread(&vm, cur, curgen, 0, workcaps, sp);
        }
        const int cn = cur == 0 ? vm.nA : vm.nB;
        if (cn == 0 && matched) {
            break;
        }
        const int oth = 1 - cur;
        const int nextgen = ++glob;
        if (oth == 0) {
            vm.nA = 0;
        } else {
            vm.nB = 0;
        }

        for (ci in 0..cn) {
            const int tpc = cur == 0 ? vm.la[ci].pc : vm.lb[ci].pc;
            *int tcaps = cur == 0 ? vm.la[ci].caps : vm.lb[ci].caps;
            _ReInst* ins = &re.inst[tpc];
            const int op = ins.op;
            if (op == OP_MATCH) {
                for (j in 0..vm.ncap) {
                    bestcaps[j] = tcaps[j];
                }
                matched = true;
                break;                          // cut lower-priority threads
            }
            if (sp >= vm.len) {
                continue;
            }
            bool step = false;
            if (ch < 128) {
                step = ((am[2 * tpc + (ch >> 6)] >> (uint64)(ch & 63)) & (uint64)1) != (uint64)0;
            }
            else if (op == OP_CHAR) {
                step = _re_char_eq(ins.a, ins.b, ch) == 1;
            }
            else if (op == OP_ANY) {
                step = ch != '\n' || ins.a == 1;
            }
            else if (op == OP_CLASS) {
                step = _re_in_class(re, ins.a, ch) == 1;
            }
            if (step) {
                _re_addthread(&vm, oth, nextgen, tpc + 1, tcaps, sp + w[0]);
            }
        }
        cur = oth;
        curgen = nextgen;
        sp += w[0];
    }
    sc.visited[ninst] = glob;
    if (matched) {
        for (j in 0..vm.ncap) {
            out[j] = bestcaps[j];
        }
    }
    return matched;
}

// Search the `len` bytes of `text` for the leftmost match of `re` that starts
// at byte offset `start` or later. The bytes before `start` are left context:
// `^` matches at `start` only when it is 0 (or, with (?m), after a newline),
// and `\b` / `\B` look at the byte before it. Match offsets are offsets into
// `text`, not from `start`. `text` needs no terminating NUL. On success fills
// `m` and returns 1; otherwise returns 0 (also for `start` outside 0..len).
// `m` must be freed with Match_free.
int Regex_search_at(Regex* re, string text, int64 len, int64 start, Match* m) {
    return _re_search(re, text, len, start, m, null);
}

// Search the NUL-terminated `text` for the leftmost match of `re`. On success
// fills `m` and returns 1; otherwise returns 0. `m` must be freed with
// Match_free. To search from an offset, or to find every match, use
// Regex_search_at or Regex_iter: searching `text + off` loses the left context
// that `^`, `\b` and `\B` read.
int Regex_search(Regex* re, string text, Match* m) {
    return Regex_search_at(re, text, (int64)strlen(text), 0, m);
}

// Iterates over the successive non-overlapping matches of a Regex in a text,
// left to right, as Go's FindAll and RE2: after an empty match the search goes
// on one code point later, and an empty match right where the previous match
// ended is skipped.
//
//   RegexIter it = Regex_iter(&re, text, len);
//   let m: Match;
//   while (RegexIter_next(&it, &m) == 1) {
//       // m.start, m.end, Match_group(&m, text, 1, &out) ...
//   }
//   Match_free(&m);
struct RegexIter {
    Regex* re;
    string text;
    int64 len;
    int64 pos;        // where the next search starts; len + 1 when done
    int64 prev_end;   // end of the last match, -1 before the first
    *int last_cap;    // the groups handed out by the last RegexIter_next
}

// An iterator over the matches of `re` in the `len` bytes of `text`.
RegexIter Regex_iter(Regex* re, string text, int64 len) {
    let it: RegexIter;
    it.re = re;
    it.text = text;
    it.len = len;
    it.pos = 0;
    it.prev_end = -1;
    it.last_cap = null;
    return it;
}

// Find the next match: fills `m` and returns 1, or returns 0 when there are no
// more. The groups of the match the previous call left in `m` are freed here,
// so only the last one needs a Match_free.
int RegexIter_next(RegexIter* it, Match* m) {
    // The groups buffer handed out last time is reused for this match.
    *int buf = null;
    if (it.last_cap != null && m.cap == it.last_cap) {
        buf = m.cap;
    }
    it.last_cap = null;
    while (it.pos <= it.len) {
        if (_re_search(it.re, it.text, it.len, it.pos, m, buf) == 0) {
            free(buf);
            it.pos = it.len + 1;
            return 0;
        }
        buf = m.cap;
        bool accept = true;
        if ((int64)m.end == it.pos) {
            // An empty match: the next search starts one code point later.
            if ((int64)m.start == it.prev_end) {
                accept = false;
            }
            if (it.pos < it.len) {
                int[1] w;
                _re_decode(it.text, (int)it.len, (int)it.pos, &w[0]);
                it.pos += (int64)w[0];
            } else {
                it.pos = it.len + 1;
            }
        } else {
            it.pos = (int64)m.end;
        }
        it.prev_end = (int64)m.end;
        if (accept) {
            it.last_cap = m.cap;
            return 1;
        }
    }
    free(buf);
    m.cap = null;
    m.ok = 0;
    return 0;
}

void Match_free(Match* m) {
    if (m.cap != null) {
        free(m.cap);
        m.cap = null;
    }
}

// Append capture group `i` (0 = whole match) of the last search into `out`,
// which must already be String_init'd. Does nothing if the group is unset.
void Match_group(Match* m, string text, int i, String* out) {
    if (m.ok == 0) {
        return;
    }
    if (i < 0 || i > m.ngroup) {
        return;
    }
    const int s = m.cap[2 * i];
    const int e = m.cap[2 * i + 1];
    if (s < 0 || e < 0 || e < s) {
        return;
    }
    for (k in s..e) {
        out.push(text[k]);
    }
}

// Convenience: does `pattern` match anywhere in `text`? Returns 1/0. Compiles
// and frees internally, so for repeated use prefer regex_compile + Regex_search.
int regex_match(string pattern, string text) {
    Regex re = regex_compile(pattern);
    if (re.ok == 0) {
        Regex_free(&re);
        return 0;
    }
    let m: Match;
    const int r = Regex_search(&re, text, &m);
    Match_free(&m);
    Regex_free(&re);
    return r;
}
