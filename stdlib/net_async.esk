// net_async.esk — leaf futures for non-blocking network I/O over <eventloop>.
//
// These are the `await`-able primitives an async function bottoms out on. Each
// registers an fd on the event loop and completes its Future when the fd is
// ready; the completion runs on the loop thread, so the awaiter's resume runs
// there too (no cross-thread marshaling needed for I/O — see <executor> for the
// cross-thread case). Each future's on_drop deregisters the fd, so cancelling a
// pending read/accept cleanly releases its loop registration. Lifetime: a
// pending future points at its loop, so drop (or finish) it before
// EventLoop_free; its on_drop would otherwise deregister from freed memory.
//
//   Future<int>* f = net_read_async(lp, fd, buf, 4096);
//   // await f  ->  number of bytes read (0 = EOF, <0 = error)

import <ctypes>;
import <c/unistd>;   // read, write, fcntl
import <c/socket>;   // ioctlsocket (Windows)
import <mem>;
import <future>;
import <eventloop>;
import <net>;
import <timer>;

// Socket I/O + non-blocking mode + the "would block" errno, all platform-specific. On
// Windows a socket is not a file descriptor, so read/write/fcntl/errno do not apply: use
// recv/send, ioctlsocket, and WSAGetLastError. `_net_read`/`_net_write` unify the two so the
// async bodies below stay platform-agnostic.
// The errno helpers (_net_errno, _NET_EAGAIN) live in <net>.
#ifdef _WIN32
// FIONBIO = 0x8004667E as a signed 32-bit value (its top bit is set).
void net_set_nonblocking(int fd) {
    int one = 1;
    ioctlsocket(fd, 0 - 2147195266, &one);
}

int64 _net_read(int fd, *void buf, int64 n) {
    return net_recv(fd, buf, n);
}

int64 _net_write(int fd, *void buf, int64 n) {
    return net_send(fd, buf, n);
}
#else
#ifdef __APPLE__
const int _NET_NONBLOCK = 4;     // O_NONBLOCK
const int _NET_ENOTSOCK = 38;
#else
const int _NET_NONBLOCK = 2048;  // O_NONBLOCK (0x800)
const int _NET_ENOTSOCK = 88;
#endif

// Put `fd` into non-blocking mode (so read/write return EAGAIN instead of
// blocking the event-loop thread). F_GETFL = 3, F_SETFL = 4.
void net_set_nonblocking(int fd) {
    const int fl = fcntl(fd, 3, 0);
    fcntl(fd, 4, fl | _NET_NONBLOCK);
}

int64 _net_read(int fd, *void buf, int64 n) {
    return read(fd, buf, n);
}

// A socket goes through net_send (no SIGPIPE on a closed peer); any other
// descriptor (a pipe) falls back to write.
int64 _net_write(int fd, *void buf, int64 n) {
    const int64 w = net_send(fd, buf, n);
    if (w < 0 && _net_errno() == _NET_ENOTSOCK) {
        return write(fd, buf, n);
    }
    return w;
}
#endif

// Write all `len` bytes of `buf` to `fd` without blocking the loop: write what
// the socket buffer accepts, then park on writability and resume when it drains,
// until everything is sent. Completes with the byte count, or -1 on a hard error.
// Requires `fd` to be non-blocking (see net_set_nonblocking).
Future<int>* net_write_async(EventLoop* lp, int fd, *uint8 buf, int64 len) {
    Future<int>* f = future_new<int>();
    *int64 sent = alloc<int64>(1);   // bytes written so far (alloc zeroes it)
    // on_drop (cancel before completion): release the loop registration and the
    // counter. On completion the callback frees the counter itself.
    f.on_drop = void() {
        EventLoop_del_free(lp, fd);
        free((*void)sent);
    };
    EventLoop_add_write(lp, fd, void(EventLoop* l, int wfd) {
        while (*sent < len) {
            const int64 w = _net_write(wfd, (*void)(buf + *sent), len - *sent);
            if (w > 0) {
                *sent += w;
            }
            else if (w < 0 && _net_errno() == _NET_EAGAIN) {  // buffer full: wait
                return;
            }
            else {   // hard error / 0
                EventLoop_del(l, wfd);
                free((*void)sent);
                Future_complete<int>(f, -1);
                return;
            }
        }
        EventLoop_del(l, wfd);                          // all sent; one-shot
        free((*void)sent);                       // completed: on_drop will not run, so free it here
        Future_complete<int>(f, (int)len);
    });
    return f;
}

// Complete once `fd` is readable / writable, doing no I/O itself. Used to drive
// a non-blocking TLS handshake / SSL_read / SSL_write, which decide *what* I/O
// to retry based on WANT_READ / WANT_WRITE.
Future<int>* net_readable_async(EventLoop* lp, int fd) {
    Future<int>* f = future_new<int>();
    f.on_drop = void() {
        EventLoop_del_free(lp, fd);
    };
    EventLoop_add_read(lp, fd, void(EventLoop* l, int rfd) {
        EventLoop_del(l, rfd);
        Future_complete<int>(f, 0);
    });
    return f;
}

Future<int>* net_writable_async(EventLoop* lp, int fd) {
    Future<int>* f = future_new<int>();
    f.on_drop = void() {
        EventLoop_del_free(lp, fd);
    };
    EventLoop_add_write(lp, fd, void(EventLoop* l, int wfd) {
        EventLoop_del(l, wfd);
        Future_complete<int>(f, 0);
    });
    return f;
}

// Complete with the number of bytes read into `buf` (capacity `cap`) once `fd`
// is readable. One-shot: the fd is deregistered when it fires.
Future<int>* net_read_async(EventLoop* lp, int fd, *uint8 buf, int64 cap) {
    Future<int>* f = future_new<int>();
    // on_drop (cancel path, callback never fired): release the loop registration
    // and its callback env. Future_drop frees the future struct itself.
    f.on_drop = void() {
        EventLoop_del_free(lp, fd);
    };
    EventLoop_add_read(lp, fd, void(EventLoop* l, int rfd) {
        const int64 n = _net_read(rfd, (*void)buf, cap);
        EventLoop_del(l, rfd);                          // one-shot; EventLoop_run frees this env on return
        Future_complete<int>(f, (int)n);         // resumes the awaiter (loop thread)
    });
    return f;
}

// net_read_async with a deadline (an absolute monotonic time, see <net>'s
// net_deadline; 0 waits forever): the byte count as net_read_async, or
// NET_TIMED_OUT if nothing arrived by then. The pending read and the timer race
// through select2, so the loser is dropped (deregistered and freed).
async int net_read_deadline_async(EventLoop* lp, int fd, *uint8 buf, int64 cap, int64 deadline) {
    if (deadline == 0) {
        int n = await net_read_async(lp, fd, buf, cap);
        return n;
    }
    int64 left = deadline - time_monotonic_ms();
    if (left <= 0) {
        return NET_TIMED_OUT;
    }
    Future<int>* rd = net_read_async(lp, fd, buf, cap);
    Future<int>* tm = timer_after(lp, left);
    int w = await select2(rd, tm);
    if (w == 0) {
        int n = rd.value;
        Future_free<int>(rd);
        return n;
    }
    Future_free<int>(tm);
    return NET_TIMED_OUT;
}

// net_write_async with a deadline (0 = none): `len`, -1 on a hard error, or
// NET_TIMED_OUT if the peer did not take all of it by then (a client that stops
// reading). What was already written stays written; close the connection.
async int net_write_deadline_async(EventLoop* lp, int fd, *uint8 buf, int64 len, int64 deadline) {
    if (deadline == 0) {
        int n = await net_write_async(lp, fd, buf, len);
        return n;
    }
    int64 left = deadline - time_monotonic_ms();
    if (left <= 0) {
        return NET_TIMED_OUT;
    }
    Future<int>* wr = net_write_async(lp, fd, buf, len);
    Future<int>* tm = timer_after(lp, left);
    int w = await select2(wr, tm);
    if (w == 0) {
        int n = wr.value;
        Future_free<int>(wr);
        return n;
    }
    Future_free<int>(tm);
    return NET_TIMED_OUT;
}

// Wait until `fd` is readable (as net_readable_async) or writable, with a
// deadline (0 = none): 0 when ready, NET_TIMED_OUT past the deadline. Drives a
// non-blocking TLS pump that must not wait forever.
async int net_ready_deadline_async(EventLoop* lp, int fd, int writable, int64 deadline) {
    if (deadline == 0) {
        if (writable != 0) {
            int x = await net_writable_async(lp, fd);
            return x;
        }
        int y = await net_readable_async(lp, fd);
        return y;
    }
    int64 left = deadline - time_monotonic_ms();
    if (left <= 0) {
        return NET_TIMED_OUT;
    }
    Future<int>* rd = writable != 0 ? net_writable_async(lp, fd) : net_readable_async(lp, fd);
    Future<int>* tm = timer_after(lp, left);
    int w = await select2(rd, tm);
    if (w == 0) {
        Future_free<int>(rd);
        return 0;
    }
    Future_free<int>(tm);
    return NET_TIMED_OUT;
}

// Complete with an accepted client fd once `listen_fd` has a pending connection.
Future<int>* net_accept_async(EventLoop* lp, int listen_fd) {
    Future<int>* f = future_new<int>();
    f.on_drop = void() {
        EventLoop_del_free(lp, listen_fd);
    };
    EventLoop_add_read(lp, listen_fd, void(EventLoop* l, int sfd) {
        const int c = net_accept(sfd);
        EventLoop_del(l, sfd);
        Future_complete<int>(f, c);
    });
    return f;
}

// Accept one connection, retrying after a short backoff (1 ms doubling to
// 128 ms) while accept fails, e.g. with EMFILE when the process is out of
// descriptors. Never completes with a negative fd, so a server loop can hand the
// result straight to a handler.
async int net_accept_retry_async(EventLoop* lp, int listen_fd) {
    int c = -1;
    int64 backoff = 1;
    while (c < 0) {
        c = await net_accept_async(lp, listen_fd);
        if (c < 0) {
            int slept = await timer_after(lp, backoff);
            if (backoff < 128) {
                backoff = backoff * 2;
            }
        }
    }
    return c;
}
