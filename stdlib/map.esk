// map.esk — Map<V>: a string-keyed hash map (open addressing, linear probing).
//
// Keys are strings (the common case — config, headers, identities); values are
// any type V. A fully generic Map<K,V> would need a hash/eq for arbitrary K,
// which Eskiu can't synthesise, so the key is fixed to string.
//
//   let m: Map<int>;  Map_init<int>(&m, 16);
//   int created = 0;
//   *int slot = Map_at<int>(&m, "hits", &created);   // get-or-insert
//   if (created == 1) { slot[0] = 0; }
//   slot[0] = slot[0] + 1;
//   int v;  if (Map_get<int>(&m, "hits", &v) == 1) { /* v == count */ }
//   Map_free<int>(&m);

import <mem>;
import <list>;   // Map_keys / Map_values / Set_items fill a List

struct Map<V> {
    **char keys;    // owned key copies; null marks an empty slot
    *V vals;
    int cap;     // bucket count
    int count;   // live entries
    *int _hs;    // each slot's key hash (_map_hash), so probes and moves skip rehashing
}

// djb2 in wrapping uint32 arithmetic, folded to a non-negative int (used only
// for bucketing). A hash with the top bit set maps to its two's-complement
// magnitude, as the signed version did, so bucket order is unchanged; the one
// value whose magnitude does not fit (0x80000000) maps to 0 instead of staying
// negative (a negative bucket index).
int _map_hash(string s) {
    uint32 h = (uint32)5381;
    for (int i = 0; s[i] != 0; i++) {
        h = h * (uint32)33 + (uint32)((int)s[i] & 255);
    }
    if ((h & (uint32)2147483648) != (uint32)0) {
        h = (uint32)0 - h;
    }
    return (int)(h & (uint32)2147483647);
}

int _map_streq(*char a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) {
            return 0;
        }
        i++;
    }
    return a[i] == b[i] ? 1 : 0;
}

*char map_dup(string s) {
    const int n = strlen(s);
    *char d = alloc<char>(n + 1);
    memcpy((*void)d, s, n + 1);   // the key and its trailing NUL
    return d;
}

void Map_init<V>(Map<V>* m, int cap) {
    if (cap < 8) {
        cap = 8;
    }
    m.keys = alloc<*char>(cap);   // zeroed: every slot starts empty (null)
    m.vals = alloc<V>(cap);
    m._hs = alloc<int>(cap);
    m.cap = cap;
    m.count = 0;
}

void Map_free<V>(Map<V>* m) {
    for (i in 0..m.cap) {
        if (m.keys[i] != null) {
            free((*void)m.keys[i]);
        }
    }
    free((*void)m.keys);
    free((*void)m.vals);
    free((*void)m._hs);
    m.keys = null;
    m.vals = null;
    m._hs = null;
    m.cap = 0;
    m.count = 0;
}

// Double the table and rehash. Keys are moved (not re-duplicated).
void _Map_grow<V>(Map<V>* m) {
    const int oldcap = m.cap;
    **char oldk = m.keys;
    *V oldv = m.vals;
    const int newcap = oldcap < 4 ? 8 : oldcap * 2;   // a freed map (cap 0) starts over
    *int oldh = m._hs;
    **char nk = alloc<*char>(newcap);   // zeroed: all slots empty
    *V nv = alloc<V>(newcap);
    *int nh = alloc<int>(newcap);
    for (i in 0..oldcap) {
        if (oldk[i] != null) {
            const int h = oldh != null ? oldh[i] : _map_hash(oldk[i]);
            int j = h % newcap;
            while (nk[j] != null) {
                j = j + 1 == newcap ? 0 : j + 1;
            }
            nk[j] = oldk[i];
            nv[j] = oldv[i];
            nh[j] = h;
        }
    }
    free((*void)oldk);
    free((*void)oldv);
    free((*void)oldh);
    m.keys = nk;
    m.vals = nv;
    m._hs = nh;
    m.cap = newcap;
}

// Get-or-insert. Returns a pointer to the value slot for `key`; sets
// *created to 1 if the key was just inserted (slot value is uninitialised —
// the caller must initialise it) or 0 if it already existed. The pointer is
// valid until the next insert that grows the map.
*V Map_at<V>(Map<V>* m, string key, *int created) {
    if ((m.count + 1) * 4 >= m.cap * 3) {   // load factor 0.75
        _Map_grow<V>(m);
    }
    const int h = _map_hash(key);
    int i = h % m.cap;
    while (m.keys[i] != null) {
        if (m._hs[i] == h && _map_streq(m.keys[i], key) == 1) {
            created[0] = 0;
            return &m.vals[i];
        }
        i = i + 1 == m.cap ? 0 : i + 1;
    }
    m.keys[i] = map_dup(key);
    m._hs[i] = h;
    m.count++;
    created[0] = 1;
    return &m.vals[i];
}

// Read-only lookup. Copies the value into *out and returns 1, or returns 0.
int Map_get<V>(Map<V>* m, string key, *V out) {
    const int i = _map_slot<V>(m, key);
    if (i < 0) {                          // absent, or a freed (never grown) map
        return 0;
    }
    out[0] = m.vals[i];
    return 1;
}

// Slot index of `key`, or -1.
int _map_slot<V>(Map<V>* m, string key) {
    if (m.cap == 0) {
        return -1;
    }
    const int h = _map_hash(key);
    int i = h % m.cap;
    for (int n = 0; m.keys[i] != null && n < m.cap; n++) {
        if (m._hs[i] == h && _map_streq(m.keys[i], key) == 1) {
            return i;
        }
        i = i + 1 == m.cap ? 0 : i + 1;
    }
    return -1;
}

// 1 if `key` is present, else 0.
int Map_has<V>(Map<V>* m, string key) {
    return _map_slot<V>(m, key) >= 0 ? 1 : 0;
}

// The value for `key`, or `dflt` when it is absent.
V Map_get_or<V>(Map<V>* m, string key, V dflt) {
    const int i = _map_slot<V>(m, key);
    if (i < 0) {
        return dflt;
    }
    return m.vals[i];
}

// Number of entries.
int Map_len<V>(Map<V>* m) {
    return m.count;
}

// 1 if slot `home` lies cyclically in (hole, j]: the entry at j, whose probe
// started at `home`, cannot move back into `hole`.
int _map_home_between(int home, int hole, int j) {
    if (hole <= j) {
        return (home > hole && home <= j) ? 1 : 0;
    }
    return (home > hole || home <= j) ? 1 : 0;
}

// Remove `key`, freeing the map's copy of it. Returns 1 if it was present, else
// 0. A value that owns memory is not freed (read it first with Map_get). The
// later entries of the probe run move back one by one (backward-shift
// deletion, no tombstones), so a pointer from Map_at is invalid after a remove.
int Map_remove<V>(Map<V>* m, string key) {
    int hole = _map_slot<V>(m, key);
    if (hole < 0) {
        return 0;
    }
    free((*void)m.keys[hole]);
    m.keys[hole] = null;
    m.count--;
    int j = hole + 1 == m.cap ? 0 : hole + 1;
    while (m.keys[j] != null) {
        const int home = m._hs[j] % m.cap;
        if (_map_home_between(home, hole, j) == 0) {
            m.keys[hole] = m.keys[j];
            m.vals[hole] = m.vals[j];
            m._hs[hole] = m._hs[j];
            m.keys[j] = null;
            hole = j;
        }
        j = j + 1 == m.cap ? 0 : j + 1;
    }
    return 1;
}

// Append every key to `out` (an initialised List<string>), in table order. The
// strings are the map's own copies: valid until the entry is removed or the map
// freed.
void Map_keys<V>(Map<V>* m, List<string>* out) {
    for (i in 0..m.cap) {
        if (m.keys[i] != null) {
            List_push<string>(out, (string)m.keys[i]);
        }
    }
}

// Append every value to `out` (an initialised List<V>), in table order (the
// same order as Map_keys).
void Map_values<V>(Map<V>* m, List<V>* out) {
    for (i in 0..m.cap) {
        if (m.keys[i] != null) {
            List_push<V>(out, m.vals[i]);
        }
    }
}

// Call f(key, value) for every entry, in table order. f must not insert into or
// remove from the map.
void Map_each<V>(Map<V>* m, fn(string, V)->void f) {
    for (i in 0..m.cap) {
        if (m.keys[i] != null) {
            f((string)m.keys[i], m.vals[i]);
        }
    }
}

// ── HashMap<K,V> — generic over the key type ────────────────────────────────────
//
// Map<V> above is string-keyed and owns its keys (the common case). HashMap<K,V>
// keys on ANY value type K — you supply hash/eq at init, since Eskiu has no
// trait/constraint system to synthesise them (the systems-language answer: pass
// the comparator, like C's qsort). Keys are stored BY VALUE, so use it for value
// types (int, small structs); for owned string keys use Map<V>.
//
//   let m: HashMap<int, int>;
//   HashMap_init<int,int>(&m, 16, int_hash, int_eq);
//   int created = 0;
//   *int slot = HashMap_at<int,int>(&m, 42, &created);
//   if (created == 1) { slot[0] = 0; }
//   slot[0] = slot[0] + 1;
//   HashMap_free<int,int>(&m);

struct HashMap<K, V> {
    *K keys;
    *V vals;
    *uint8 used;            // 0 = empty slot, 1 = occupied
    int cap;
    int count;
    fn(*K)->uint64 hash;
    fn(*K, *K)->int eq;
}

void HashMap_init<K, V>(HashMap<K, V>* m, int cap,
                        fn(*K)->uint64 hash, fn(*K, *K)->int eq) {
    if (cap < 8) {
        cap = 8;
    }
    m.keys = alloc<K>(cap);
    m.vals = alloc<V>(cap);
    m.used = alloc<uint8>(cap);   // zeroed: every slot starts empty
    m.cap = cap;
    m.count = 0;
    m.hash = hash;
    m.eq = eq;
}

void HashMap_free<K, V>(HashMap<K, V>* m) {
    free((*void)m.keys);
    free((*void)m.vals);
    free((*void)m.used);
    m.keys = null;
    m.vals = null;
    m.used = null;
    m.cap = 0;
    m.count = 0;
}

void _HashMap_grow<K, V>(HashMap<K, V>* m) {
    const int oldcap = m.cap;
    *K ok = m.keys;
    *V ov = m.vals;
    *uint8 ou = m.used;
    const int newcap = oldcap < 4 ? 8 : oldcap * 2;   // a freed map (cap 0) starts over
    *K nk = alloc<K>(newcap);
    *V nv = alloc<V>(newcap);
    *uint8 nu = alloc<uint8>(newcap);   // zeroed: all slots empty
    let hashfn: fn(*K)->uint64 = m.hash;
    for (i in 0..oldcap) {
        if (ou[i] == 1) {
            const uint64 h = hashfn(&ok[i]);
            int j = (int)(h % (uint64)newcap);
            while (nu[j] == 1) {
                j = (j + 1) % newcap;
            }
            nu[j] = 1;
            nk[j] = ok[i];
            nv[j] = ov[i];
        }
    }
    free((*void)ok);
    free((*void)ov);
    free((*void)ou);
    m.keys = nk;
    m.vals = nv;
    m.used = nu;
    m.cap = newcap;
}

// Get-or-insert. Returns a pointer to the value slot; *created = 1 if the key
// was just inserted (value slot uninitialised — caller initialises it).
*V HashMap_at<K, V>(HashMap<K, V>* m, K key, *int created) {
    if ((m.count + 1) * 4 >= m.cap * 3) {
        _HashMap_grow<K, V>(m);
    }
    let hashfn: fn(*K)->uint64 = m.hash;
    let eqfn: fn(*K, *K)->int = m.eq;
    const uint64 h = hashfn(&key);
    int i = (int)(h % (uint64)m.cap);
    while (m.used[i] == 1) {
        if (eqfn(&key, &m.keys[i]) == 1) {
            created[0] = 0;
            return &m.vals[i];
        }
        i = (i + 1) % m.cap;
    }
    m.used[i] = 1;
    m.keys[i] = key;
    m.count++;
    created[0] = 1;
    return &m.vals[i];
}

// Read-only lookup. Copies the value into *out and returns 1, or returns 0.
int HashMap_get<K, V>(HashMap<K, V>* m, K key, *V out) {
    if (m.cap == 0) {                     // freed: empty
        return 0;
    }
    let hashfn: fn(*K)->uint64 = m.hash;
    let eqfn: fn(*K, *K)->int = m.eq;
    const uint64 h = hashfn(&key);
    int i = (int)(h % (uint64)m.cap);
    for (int n = 0; m.used[i] == 1 && n < m.cap; n++) {
        if (eqfn(&key, &m.keys[i]) == 1) {
            out[0] = m.vals[i];
            return 1;
        }
        i = (i + 1) % m.cap;
    }
    return 0;
}

// Built-in hash/eq for int keys (Knuth multiplicative hash).
uint64 int_hash(*int k) {
    return (uint64)k[0] * 2654435761;
}

int int_eq(*int a, *int b) {
    return a[0] == b[0] ? 1 : 0;
}

// Hash/eq for `string` keys by content (FNV-1a). The map stores the pointer,
// not a copy: the text must outlive its entry (use Map<V> for owned keys).
uint64 cstr_hash(*string k) {
    string s = k[0];
    uint64 h = (uint64)14695981039346656037;
    for (int i = 0; s[i] != 0; i++) {
        h = (h ^ (uint64)((int)s[i] & 255)) * (uint64)1099511628211;
    }
    return h;
}

int cstr_eq(*string a, *string b) {
    return _map_streq((*char)a[0], b[0]);
}

// Slot index of `key`, or -1.
int _hashmap_slot<K, V>(HashMap<K, V>* m, K key) {
    if (m.cap == 0) {
        return -1;
    }
    let hashfn: fn(*K)->uint64 = m.hash;
    let eqfn: fn(*K, *K)->int = m.eq;
    int i = (int)(hashfn(&key) % (uint64)m.cap);
    for (int n = 0; m.used[i] == 1 && n < m.cap; n++) {
        if (eqfn(&key, &m.keys[i]) == 1) {
            return i;
        }
        i = (i + 1) % m.cap;
    }
    return -1;
}

// 1 if `key` is present, else 0.
int HashMap_has<K, V>(HashMap<K, V>* m, K key) {
    return _hashmap_slot<K, V>(m, key) >= 0 ? 1 : 0;
}

// The value for `key`, or `dflt` when it is absent.
V HashMap_get_or<K, V>(HashMap<K, V>* m, K key, V dflt) {
    const int i = _hashmap_slot<K, V>(m, key);
    if (i < 0) {
        return dflt;
    }
    return m.vals[i];
}

// Number of entries.
int HashMap_len<K, V>(HashMap<K, V>* m) {
    return m.count;
}

// Remove `key`. Returns 1 if it was present, else 0. Neither the key nor the
// value is freed. Uses backward-shift deletion like Map_remove, so a pointer
// from HashMap_at is invalid after a remove.
int HashMap_remove<K, V>(HashMap<K, V>* m, K key) {
    int hole = _hashmap_slot<K, V>(m, key);
    if (hole < 0) {
        return 0;
    }
    let hashfn: fn(*K)->uint64 = m.hash;
    m.used[hole] = 0;
    m.count--;
    int j = (hole + 1) % m.cap;
    while (m.used[j] == 1) {
        const int home = (int)(hashfn(&m.keys[j]) % (uint64)m.cap);
        if (_map_home_between(home, hole, j) == 0) {
            m.keys[hole] = m.keys[j];
            m.vals[hole] = m.vals[j];
            m.used[hole] = 1;
            m.used[j] = 0;
            hole = j;
        }
        j = (j + 1) % m.cap;
    }
    return 1;
}

// Append every key to `out` (an initialised List<K>), in table order.
void HashMap_keys<K, V>(HashMap<K, V>* m, List<K>* out) {
    for (i in 0..m.cap) {
        if (m.used[i] == 1) {
            List_push<K>(out, m.keys[i]);
        }
    }
}

// Append every value to `out` (an initialised List<V>), in table order (the same
// order as HashMap_keys).
void HashMap_values<K, V>(HashMap<K, V>* m, List<V>* out) {
    for (i in 0..m.cap) {
        if (m.used[i] == 1) {
            List_push<V>(out, m.vals[i]);
        }
    }
}

// Call f(key, value) for every entry, in table order. f must not insert into or
// remove from the map.
void HashMap_each<K, V>(HashMap<K, V>* m, fn(K, V)->void f) {
    for (i in 0..m.cap) {
        if (m.used[i] == 1) {
            f(m.keys[i], m.vals[i]);
        }
    }
}

// ── Set<T>: a hash set over HashMap ─────────────────────────────────────────────
//
// Elements are stored by value and compared with the hash/eq given at init (the
// same callbacks as HashMap: int_hash/int_eq, cstr_hash/cstr_eq, or your own).
//
//   let s: Set<int>;  Set_init<int>(&s, 16, int_hash, int_eq);
//   s.add(3);  s.add(3);          // the second add returns 0
//   if (s.has(3) == 1) { ... }
//   s.free();

struct Set<T> {
    HashMap<T, uint8> table;
}

void Set_init<T>(Set<T>* s, int cap, fn(*T)->uint64 hash, fn(*T, *T)->int eq) {
    HashMap_init<T, uint8>(&s.table, cap, hash, eq);
}

void Set_free<T>(Set<T>* s) {
    HashMap_free<T, uint8>(&s.table);
}

// Add `item`. Returns 1 if it was new, 0 if it was already there.
int Set_add<T>(Set<T>* s, T item) {
    int created = 0;
    *uint8 slot = HashMap_at<T, uint8>(&s.table, item, &created);
    slot[0] = (uint8)1;
    return created;
}

// 1 if `item` is in the set, else 0.
int Set_has<T>(Set<T>* s, T item) {
    return HashMap_has<T, uint8>(&s.table, item);
}

// Remove `item`. Returns 1 if it was there, else 0.
int Set_remove<T>(Set<T>* s, T item) {
    return HashMap_remove<T, uint8>(&s.table, item);
}

// Number of elements.
int Set_len<T>(Set<T>* s) {
    return s.table.count;
}

// Call f(item) for every element, in table order. f must not add or remove.
void Set_each<T>(Set<T>* s, fn(T)->void f) {
    for (i in 0..s.table.cap) {
        if (s.table.used[i] == 1) {
            f(s.table.keys[i]);
        }
    }
}

// Append every element to `out` (an initialised List<T>), in table order.
void Set_items<T>(Set<T>* s, List<T>* out) {
    HashMap_keys<T, uint8>(&s.table, out);
}
