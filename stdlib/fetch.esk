// fetch.esk: an HTTP/1.1 client for http:// and https:// URLs, blocking and
// async.
//
//   import <fetch>;
//   let r: Response;
//   if (fetch("https://api.example.com/items", &r) == 0 && Response_ok(&r) == 1) {
//       printf("%s\n", Response_text(&r));
//   } else {
//       printf("error: %s\n", fetch_last_error());
//   }
//   Response_free(&r);
//
// With options:
//
//   let o: FetchOptions;  FetchOptions_init(&o);
//   defer FetchOptions_free(&o);
//   FetchOptions_method(&o, "POST");
//   FetchOptions_header(&o, "Authorization", "Bearer abc");
//   FetchOptions_body_text(&o, "{\"name\":\"eskiu\"}");
//   o.timeout_ms = 5000;
//   let r: Response;
//   int rc = fetch_with("https://api.example.com/items", &o, &r);
//
// fetch and fetch_with return 0 when a response arrived (whatever its status:
// a 404 is a response, check Response_ok or r.status), or a negative FETCH_ERR_*
// code; fetch_last_error() then describes the failure. They initialize *out
// themselves, so free it with Response_free in either case.
//
// The client sends one request per connection ("Connection: close"), with Host,
// User-Agent ("eskiu/0.12.0" unless set), Accept ("*/*" unless set) and, when
// there is a body (or the method is POST, PUT or PATCH), Content-Length. A
// Host, Content-Length, Connection or Transfer-Encoding header in the options
// is not sent: the client frames the request itself. The response body is
// framed by chunked transfer coding, by Content-Length, or by the end of the
// connection; a body cut short is an error. Transfer and content codings other
// than chunked are not decoded (the client sends no Accept-Encoding, so servers
// do not compress).
//
// Redirects (301, 302, 303, 307, 308 with a Location) are followed up to
// o.max_redirects times (10); one more is FETCH_ERR_REDIRECTS. A relative
// Location is resolved against the current URL. 301, 302 and 303 turn the
// request into a GET without a body (a HEAD stays a HEAD); 307 and 308 repeat
// it as it was. A redirect from https to http is followed, as browsers and curl
// -L do. When a redirect leaves the origin (scheme, host or port changes) the
// Authorization and Cookie headers are dropped. r.url is the final URL and
// r.redirects the number followed.
//
// o.timeout_ms (30 s by default, 0 for none) bounds the whole call, redirects
// included: connecting, the TLS handshake, sending and receiving. The host name
// lookup (getaddrinfo) is not bounded by it. o.max_body (64 MiB by default)
// caps the response body: FETCH_ERR_TOO_LARGE past it.
//
// Header injection: a method that is not a token, a header name that is not a
// token, or a CR or LF in a header value is rejected (FetchOptions_header
// returns 0 and the request fails with FETCH_ERR_REQUEST; so does a CR or LF
// in o.user_agent or a CR in o.headers set directly); url_parse already
// rejects control bytes in the URL, so the request target cannot hold a CR or
// LF.
//
// HTTPS uses OpenSSL, loaded on the first https:// request (see <fetch_tls>), so
// programs link without it. Certificates are checked against the system trust
// store (and o.ca_file when set) and the host name; o.verify_tls = 0 turns the
// check off (local tests with a self-signed certificate only). Define
// ESKIU_FETCH_NO_TLS before importing <fetch> to leave HTTPS out entirely:
// https:// URLs then fail with FETCH_ERR_NO_TLS.
//
// fetch_async(lp, url, &o, &r) is the same request over an <eventloop>: it
// returns a Future<int> with the same code, filling *out (which, like the url
// string, must stay valid until the future completes; the options are copied
// when the call starts). Connecting, TLS and the I/O wait on the loop; the host
// name lookup runs on a thread of its own, which the loop checks on a short
// timer (a dropped fetch leaves the lookup to finish and free itself).
//
// fetch_last_error() keeps one message for the whole program (not per thread).

import <mem>;
import <string>;
import <bytes>;
import <url>;
import <json>;
import <net>;
import <dns>;
import <http>;
import <time>;
import <future>;
import <eventloop>;
import <net_async>;
import <timer>;
import <atomic>;

#ifndef ESKIU_FETCH_NO_TLS
import <fetch_tls>;
#else
int fetch_tls_available() {
    return 0;
}

const int _FTLS_WANT_READ = 2;
const int _FTLS_WANT_WRITE = 3;
*void _ftls_ctx(int verify, string ca_file) {
    return null;
}

void _ftls_ctx_free(*void ctx) {}
*void _ftls_new(*void ctx, int fd, string host, int verify) {
    return null;
}

int _ftls_handshake(*void ssl) {
    return -1;
}

int64 _ftls_read(*void ssl, *uint8 buf, int64 cap) {
    return -1;
}

int64 _ftls_write(*void ssl, *uint8 buf, int64 n) {
    return -1;
}

int _ftls_verify_error(*void ssl, String* out) {
    return 0;
}

void _ftls_free(*void ssl) {}
#endif

extern int getsockopt(int fd, int level, int opt, *void val, *int len);
#ifndef _WIN32
extern string strerror(int e);
#endif

// ── Errors ───────────────────────────────────────────────────────────────────

const int FETCH_OK = 0;
const int FETCH_ERR_URL = -1;    // invalid URL, or a scheme other than http/https
const int FETCH_ERR_DNS = -2;    // the host name does not resolve
const int FETCH_ERR_CONNECT = -3;    // no address accepted the connection
const int FETCH_ERR_TIMEOUT = -4;    // o.timeout_ms ran out
const int FETCH_ERR_TLS = -5;    // TLS handshake or certificate check failed
const int FETCH_ERR_IO = -6;    // the connection failed while sending or receiving
const int FETCH_ERR_RESPONSE = -7;    // a malformed or truncated response
const int FETCH_ERR_REDIRECTS = -8;    // more than o.max_redirects redirects
const int FETCH_ERR_TOO_LARGE = -9;    // the body is longer than o.max_body
const int FETCH_ERR_REQUEST = -10;   // an invalid method or header (CR/LF injection)
const int FETCH_ERR_NO_TLS = -11;   // https:// without OpenSSL

String _fetch_err;

int _fetch_fail(int code, string msg) {
    if (_fetch_err.data == null) {
        String_init(&_fetch_err, 64);
    }
    String_clear(&_fetch_err);
    String_append(&_fetch_err, msg);
    return code;
}

// What went wrong in the last failed fetch (any thread), or "no error".
string fetch_last_error() {
    if (_fetch_err.data == null || _fetch_err.len == 0) {
        return "no error";
    }
    return _fetch_err.data;
}

// ── Options ──────────────────────────────────────────────────────────────────

const int64 FETCH_DEFAULT_TIMEOUT_MS = 30000;
const int64 FETCH_DEFAULT_MAX_BODY = 67108864;
const int FETCH_DEFAULT_REDIRECTS = 10;
const string FETCH_USER_AGENT = "eskiu/0.12.0";

struct FetchOptions {
    String method;            // "GET"
    String headers;           // "Name: value\n" per header (FetchOptions_header)
    Bytes body;
    int has_body;          // 1 once a body was set
    int64 timeout_ms;        // whole call; 0 = none
    int follow_redirects;  // 1: follow, 0: return the 3xx response
    int max_redirects;     // 10
    int64 max_body;          // response body cap in bytes
    String user_agent;        // "" sends no User-Agent
    int verify_tls;        // 1: check the certificate and host name
    String ca_file;           // extra PEM CA bundle to trust ("" = system store only)
    int bad_header;        // 1 if FetchOptions_header rejected a header
}

void FetchOptions_init(FetchOptions* self) {
    String_from(&self.method, "GET");
    String_init(&self.headers, 64);
    Bytes_init(&self.body, 8);
    self.has_body = 0;
    self.timeout_ms = FETCH_DEFAULT_TIMEOUT_MS;
    self.follow_redirects = 1;
    self.max_redirects = FETCH_DEFAULT_REDIRECTS;
    self.max_body = FETCH_DEFAULT_MAX_BODY;
    String_from(&self.user_agent, FETCH_USER_AGENT);
    self.verify_tls = 1;
    String_init(&self.ca_file, 8);
    self.bad_header = 0;
}

void FetchOptions_free(FetchOptions* self) {
    String_free(&self.method);
    String_free(&self.headers);
    Bytes_free(&self.body);
    String_free(&self.user_agent);
    String_free(&self.ca_file);
}

// Set the request method ("GET", "POST", "PUT", "DELETE", "HEAD", ...). One
// that is not a token fails the request with FETCH_ERR_REQUEST.
void FetchOptions_method(FetchOptions* self, string method) {
    String_clear(&self.method);
    String_append(&self.method, method);
}

// Add the header `name: value`. 1, or 0 when the name is not a token or the
// value holds a CR or LF; then nothing is added and the request will fail with
// FETCH_ERR_REQUEST (a header that would split into an injected line is never
// sent).
int FetchOptions_header(FetchOptions* self, string name, string value) {
    if (_http_field_ok(name, value) == 0) {
        self.bad_header = 1;
        return 0;
    }
    String_append(&self.headers, name);
    String_append(&self.headers, ": ");
    String_append(&self.headers, value);
    String_push(&self.headers, '\n');
    return 1;
}

// Set the request body to `n` bytes at `data`.
void FetchOptions_body_bytes(FetchOptions* self, *uint8 data, int64 n) {
    self.body.len = 0;
    Bytes_append_raw(&self.body, data, n);
    self.has_body = 1;
}

// Set the request body to the text `s`.
void FetchOptions_body_text(FetchOptions* self, string s) {
    FetchOptions_body_bytes(self, (*uint8)s, strlen(s));
}

// Set the request body to the JSON built in `j`, with
// "Content-Type: application/json" unless a Content-Type was set.
void FetchOptions_body_json(FetchOptions* self, Json* j) {
    FetchOptions_body_bytes(self, (*uint8)j.buf.data, j.buf.len);
    if (_http_header_count(&self.headers, "content-type") == 0) {
        FetchOptions_header(self, "Content-Type", "application/json");
    }
}

// ── Response ─────────────────────────────────────────────────────────────────

struct Response {
    int status;      // 200, 404, ... (0 when the fetch failed)
    String reason;      // "OK"
    String headers;     // "Name: value\n" per header line, as received
    Bytes body;
    String url;         // the final URL, after redirects
    int redirects;   // redirects followed
}

void Response_init(Response* self) {
    self.status = 0;
    String_init(&self.reason, 16);
    String_init(&self.headers, 256);
    Bytes_init(&self.body, 256);
    String_init(&self.url, 64);
    self.redirects = 0;
}

void Response_free(Response* self) {
    String_free(&self.reason);
    String_free(&self.headers);
    Bytes_free(&self.body);
    String_free(&self.url);
}

void _fetch_response_clear(Response* self) {
    self.status = 0;
    String_clear(&self.reason);
    String_clear(&self.headers);
    self.body.len = 0;
    self.body.data[0] = 0;
}

// Copy the value of header `name` (any case) into `out` (cleared first): 1, or
// 0 when the response has no such header. A repeated header gives its first
// value.
int Response_header(Response* self, string name, String* out) {
    return _http_header_lookup(&self.headers, name, out);
}

// The body as text (NUL-terminated; a body holding a NUL byte reads up to it,
// use Response_bytes for binary data). Valid until Response_free.
string Response_text(Response* self) {
    return (string)self.body.data;
}

// The body as a non-owning Bytes view (no copy), valid until Response_free.
Bytes Response_bytes(Response* self) {
    return Bytes_slice(&self.body, 0, self.body.len);
}

// The body parsed as JSON, or null when it is not valid JSON. Free the tree
// with JsonValue_free.
*JsonValue Response_json(Response* self) {
    return json_parse((string)self.body.data);
}

// 1 for a 2xx status, else 0.
int Response_ok(Response* self) {
    return self.status >= 200 && self.status < 300 ? 1 : 0;
}

// ── Response parser ──────────────────────────────────────────────────────────
//
// An incremental parser for one HTTP/1.x response: feed it bytes as they
// arrive (FetchParser_feed), and call FetchParser_finish when the connection
// closes. It fills a Response (cleared by the caller). Interim 1xx responses
// are skipped; a 101 is an error.

const int _FP_HEAD = 0;
const int _FP_LENGTH = 1;
const int _FP_CHUNKED = 2;
const int _FP_CLOSE = 3;
const int _FP_DONE = 4;
const int FETCH_MAX_HEAD = 65536;

struct FetchParser {
    Bytes buf;        // input not consumed yet (the head, a chunked body)
    int stage;
    int64 need;       // Content-Length bytes still to come
    int64 max_body;
    int no_body;    // 1: the request was a HEAD
    int64 scan;       // bytes already searched for the end of the head
    int64 bpos;       // chunked decoder state (see <http>'s _http_chunked_run)
    int trailer;
    int64 tbytes;
    HttpChunkOut chunks;
}

void FetchParser_init(FetchParser* p, int64 max_body, int no_body) {
    Bytes_init(&p.buf, 4096);
    p.stage = _FP_HEAD;
    p.need = 0;
    p.max_body = max_body;
    p.no_body = no_body;
    p.scan = 0;
    p.bpos = 0;
    p.trailer = 0;
    p.tbytes = 0;
    p.chunks.data = null;
    p.chunks.len = 0;
    p.chunks.cap = 0;
}

void FetchParser_free(FetchParser* p) {
    Bytes_free(&p.buf);
    if (p.chunks.data != null) {
        free(p.chunks.data);
        p.chunks.data = null;
    }
}

int _fp_bad(string msg) {
    _fetch_fail(FETCH_ERR_RESPONSE, "malformed response: ");
    String_append(&_fetch_err, msg);
    return FETCH_ERR_RESPONSE;
}

int _fp_too_large(int64 max) {
    _fetch_fail(FETCH_ERR_TOO_LARGE, "");
    String_appendf(&_fetch_err, "response body larger than %lld bytes", max);
    return FETCH_ERR_TOO_LARGE;
}

// 1 if the last coding of the last non-empty Transfer-Encoding line is
// "chunked" (or there is no coding at all), else 0.
int _fp_te_final_chunked(String* h) {
    int last = 1;
    const int64 n = h.len;
    int64 i = 0;
    while (i < n) {
        int64 e = i;
        while (e < n && h.data[e] != '\n') {
            e++;
        }
        if (_http_line_named(h, i, e, "transfer-encoding") == 1) {
            int64 t = e;
            while (t > i && (h.data[t - 1] == ' ' || h.data[t - 1] == '\t' || h.data[t - 1] == ',')) {
                t--;
            }
            int64 b = t;
            while (b > i && h.data[b - 1] != ',' && h.data[b - 1] != ':' && h.data[b - 1] != ' ' && h.data[b - 1] != '\t') {
                b--;
            }
            if (t > b) {
                let item: String;
                item.init(16);
                for (k in b..t) {
                    item.push(_http_lc(h.data[k]));
                }
                last = String_eq_cstr(&item, "chunked");
                item.free();
            }
        }
        i = e + 1;
    }
    return last;
}

// Parse the head b[0..hend) into r and pick the body framing.
int _fp_head(FetchParser* p, Response* r, int hend) {
    *uint8 b = p.buf.data;
    String_clear(&r.reason);
    String_clear(&r.headers);
    if (hend < 14) {
        return _fp_bad("status line too short");
    }
    const int version = _http_parse_version(b, 0, 8);
    if (version < 10 || version >= 20) {
        return _fp_bad("not an HTTP/1.x status line");
    }
    if (b[8] != ' ') {
        return _fp_bad("bad status line");
    }
    int status = 0;
    for (k in 9..12) {
        if (b[k] < '0' || b[k] > '9') {
            return _fp_bad("bad status code");
        }
        status = status * 10 + ((int)b[k] - '0');
    }
    if (status < 100) {
        return _fp_bad("bad status code");
    }
    int pos = 12;
    if (b[pos] == ' ') {
        pos++;
        while (pos < hend && b[pos] != '\r' && b[pos] != '\n') {
            if (b[pos] < 32 && b[pos] != '\t') {
                return _fp_bad("control byte in the reason phrase");
            }
            String_push(&r.reason, (char)b[pos]);
            pos++;
        }
    }
    if (_http_crlf_at(b, pos, hend) == 0) {
        return _fp_bad("status line not ended by CRLF");
    }
    pos += 2;
    while (pos < hend && _http_crlf_at(b, pos, hend) == 0) {
        for (; pos < hend && _http_is_crlf_byte(b[pos]) == 0; pos++) {
            String_push(&r.headers, (char)b[pos]);
        }
        String_push(&r.headers, '\n');
        if (_http_crlf_at(b, pos, hend) == 0) {
            return _fp_bad("a header line not ended by CRLF");
        }
        pos += 2;
    }
    if (_http_headers_valid(&r.headers) == 0) {
        return _fp_bad("invalid header line");
    }
    r.status = status;
    if (status == 101) {
        return _fp_bad("unexpected protocol switch (101)");
    }
    if (status < 200) {                      // interim: the caller skips it
        return 0;
    }
    if (p.no_body == 1 || status == 204 || status == 304) {
        p.stage = _FP_DONE;
        return 0;
    }
    const int te = _http_transfer_encoding(&r.headers);
    if (te == 1 || te == 501) {
        p.stage = _FP_CHUNKED;
        p.bpos = 0;
        return 0;
    }
    if (te != 0) {
        // A response whose final transfer coding is not chunked runs to the end
        // of the connection (RFC 9112 6.3); the body is returned undecoded.
        if (_fp_te_final_chunked(&r.headers) == 0) {
            p.stage = _FP_CLOSE;
            return 0;
        }
        return _fp_bad("invalid Transfer-Encoding");
    }
    const int64 cl = _http_content_length(&r.headers);
    if (cl == -1) {
        return _fp_bad("invalid Content-Length");
    }
    if (cl == -2) {
        p.stage = _FP_CLOSE;
        return 0;
    }
    if (cl > p.max_body) {
        return _fp_too_large(p.max_body);
    }
    p.need = cl;
    p.stage = cl == 0 ? _FP_DONE : _FP_LENGTH;
    return 0;
}

// Body bytes of a Content-Length or close-delimited body.
int _fp_body(FetchParser* p, Response* r, *uint8 data, int64 n) {
    if (p.stage == _FP_LENGTH) {
        const int64 take = n < p.need ? n : p.need;
        Bytes_append_raw(&r.body, data, take);
        p.need -= take;
        if (p.need == 0) {
            p.stage = _FP_DONE;
            return 1;
        }
        return 0;
    }
    if (r.body.len + n > p.max_body) {
        return _fp_too_large(p.max_body);
    }
    Bytes_append_raw(&r.body, data, n);
    return 0;
}

int _fp_run(FetchParser* p, Response* r) {
    while (p.stage == _FP_HEAD) {
        const int64 from = p.scan > 3 ? p.scan - 3 : 0;
        const int64 lim = p.buf.len < FETCH_MAX_HEAD + 4 ? p.buf.len : FETCH_MAX_HEAD + 4;
        const int hend = _http_idx_header_end_from(p.buf.data, (int)from, (int)lim);
        if (hend < 0) {
            if (p.buf.len > FETCH_MAX_HEAD) {
                return _fp_bad("response head too large");
            }
            p.scan = p.buf.len;
            return 0;
        }
        const int rc = _fp_head(p, r, hend);
        if (rc < 0) {
            return rc;
        }
        const int64 rest = p.buf.len - hend;
        memmove(p.buf.data, p.buf.data + hend, rest);
        p.buf.len = rest;
        p.scan = 0;
    }
    if (p.stage == _FP_LENGTH || p.stage == _FP_CLOSE) {
        const int64 n = p.buf.len;
        p.buf.len = 0;
        return _fp_body(p, r, p.buf.data, n);
    }
    if (p.stage == _FP_CHUNKED) {
        int64 n = p.buf.len;
        const int st = _http_chunked_feed(p.buf.data, &n, &p.bpos, 0, &p.chunks, p.max_body, &p.trailer, &p.tbytes);
        p.buf.len = n;
        if (st == 1) {
            Bytes_append_raw(&r.body, p.chunks.data, p.chunks.len);
            p.stage = _FP_DONE;
            return 1;
        }
        if (st == -2) {
            return _fp_too_large(p.max_body);
        }
        if (st < 0) {
            return _fp_bad("bad chunked body");
        }
        return 0;
    }
    return 1;
}

// Feed the next `n` bytes of the response: 1 once the response is complete
// (bytes past its end are ignored), 0 when more are needed, or a FETCH_ERR_*
// code (FETCH_ERR_RESPONSE for a malformed response, FETCH_ERR_TOO_LARGE for a
// body over the limit).
int FetchParser_feed(FetchParser* p, Response* r, *uint8 data, int64 n) {
    if (p.stage == _FP_DONE) {
        return 1;
    }
    if (p.stage == _FP_LENGTH || p.stage == _FP_CLOSE) {
        return _fp_body(p, r, data, n);
    }
    Bytes_append_raw(&p.buf, data, n);
    return _fp_run(p, r);
}

// The connection closed: 1 if the response is complete (a body that runs to
// the end of the connection ends here), else a FETCH_ERR_* code.
int FetchParser_finish(FetchParser* p, Response* r) {
    if (p.stage == _FP_DONE) {
        return 1;
    }
    if (p.stage == _FP_CLOSE) {
        p.stage = _FP_DONE;
        return 1;
    }
    if (p.stage == _FP_HEAD && p.buf.len == 0 && r.status == 0) {
        return _fetch_fail(FETCH_ERR_IO, "the server closed the connection without a response");
    }
    if (p.stage == _FP_LENGTH) {
        _fetch_fail(FETCH_ERR_RESPONSE, "");
        String_appendf(&_fetch_err, "connection closed after %lld body bytes, %lld short of the Content-Length",
                       r.body.len, p.need);
        return FETCH_ERR_RESPONSE;
    }
    return _fetch_fail(FETCH_ERR_RESPONSE, "connection closed before the end of the response");
}

// ── The request machine ──────────────────────────────────────────────────────
//
// One fetch is a state machine over a non-blocking socket. _fetch_step runs it
// as far as it can and returns 0 when the response is complete, a negative
// FETCH_ERR_* code, or what it waits for: _FETCH_WANT_READ / _FETCH_WANT_WRITE
// on call.fd. fetch_with waits with poll (net_wait_ready), fetch_async on the
// event loop; both then call _fetch_step again.

const int _FETCH_WANT_READ = 1;
const int _FETCH_WANT_WRITE = 2;
const int _FETCH_WANT_DNS = 3;   // fetch_async: the lookup runs on a thread

const int _FC_RESOLVE = 0;
const int _FC_NEXT_ADDR = 1;
const int _FC_CONNECTING = 2;
const int _FC_CONNECTED = 3;
const int _FC_TLS = 4;
const int _FC_SEND = 5;
const int _FC_RECV = 6;
const int _FC_DONE = 7;

#ifdef _WIN32
const int _FETCH_EINPROGRESS = 10035;   // WSAEWOULDBLOCK
const int _FETCH_SOL_SOCKET = 65535;
const int _FETCH_SO_ERROR = 4103;
#else
#ifdef __APPLE__
const int _FETCH_EINPROGRESS = 36;
const int _FETCH_SOL_SOCKET = 65535;
const int _FETCH_SO_ERROR = 4103;
#else
const int _FETCH_EINPROGRESS = 115;
const int _FETCH_SOL_SOCKET = 1;
const int _FETCH_SO_ERROR = 4;
#endif
#endif

// A lookup for fetch_async on a thread of its own, so getaddrinfo does not block
// the event loop. state: 0 running, 1 done, 2 abandoned by a dropped fetch. The
// side that comes second frees the job.
struct _FetchDns {
    String host;
    String port;
    *_dns_addrinfo addrs;
    int rc;
    int state;
}

extern int pthread_detach(*void t);

void _fetch_dns_free(_FetchDns* j) {
    if (j.addrs != null) {
        freeaddrinfo(j.addrs);
    }
    String_free(&j.host);
    String_free(&j.port);
    free((*void)j);
}

void _fetch_dns_work(_FetchDns* j) {
    j.rc = _dns_getaddrinfo(j.host.cstr(), j.port.cstr(), &j.addrs);
    if (atomic_swap(&j.state, 1) == 2) {
        _fetch_dns_free(j);
    }
}

// Leave a running lookup to its thread, or free a finished one.
void _fetch_dns_drop(_FetchDns* j) {
    if (atomic_swap(&j.state, 2) == 1) {
        _fetch_dns_free(j);
    }
}

struct _FetchCall {
    // From the options (copied when the call starts).
    String method;
    String headers;
    Bytes body;
    int send_body;
    int64 deadline;
    int64 timeout_ms;
    int follow;
    int max_redirects;
    int64 max_body;
    String user_agent;
    int verify;
    String ca_file;
    int cross_origin;
    // The current request.
    Url url;
    int https;
    int phase;
    int fd;
    *void ctx;
    *void ssl;
    *_dns_addrinfo addrs;
    *_dns_addrinfo next;
    int dns_async;
    _FetchDns* dns_job;
    int conn_err;
    Bytes req;
    int64 sent;
    FetchParser parser;
    int parser_live;
    *uint8 rbuf;
    Response* out;
}

const int64 _FETCH_RBUF = 16384;

int _fetch_is_token(String* s) {
    if (s.len == 0) {
        return 0;
    }
    for (i in 0..s.len) {
        if (_http_is_tchar((uint8)s.data[i]) == 0) {
            return 0;
        }
    }
    return 1;
}

// 1 if `s` holds a CR (a header value set through the fields, not
// FetchOptions_header, could otherwise end its line early on the wire).
int _fetch_has_cr(String* s) {
    return String_index_of(s, '\r') >= 0 ? 1 : 0;
}

// Close the connection of the current request (the call stays usable).
void _fetch_close(_FetchCall* c) {
    if (c.ssl != null) {
        _ftls_free(c.ssl);
        c.ssl = null;
    }
    if (c.ctx != null) {
        _ftls_ctx_free(c.ctx);
        c.ctx = null;
    }
    if (c.fd >= 0) {
        net_close(c.fd);
        c.fd = -1;
    }
    if (c.addrs != null) {
        freeaddrinfo(c.addrs);
        c.addrs = null;
        c.next = null;
    }
    if (c.parser_live == 1) {
        FetchParser_free(&c.parser);
        c.parser_live = 0;
    }
}

void _fetch_call_free(_FetchCall* c) {
    _fetch_close(c);
    if (c.dns_job != null) {
        _fetch_dns_drop(c.dns_job);
        c.dns_job = null;
    }
    String_free(&c.method);
    String_free(&c.headers);
    Bytes_free(&c.body);
    String_free(&c.user_agent);
    String_free(&c.ca_file);
    Url_free(&c.url);
    Bytes_free(&c.req);
    if (c.rbuf != null) {
        free((*void)c.rbuf);
        c.rbuf = null;
    }
}

// Point the call at `u` (taken over), checking the scheme.
int _fetch_target(_FetchCall* c, Url* u) {
    Url_free(&c.url);
    c.url = *u;
    c.https = String_eq_cstr(&c.url.scheme, "https");
    if (c.https == 0 && String_eq_cstr(&c.url.scheme, "http") == 0) {
        _fetch_fail(FETCH_ERR_URL, "unsupported scheme '");
        String_append(&_fetch_err, c.url.scheme.cstr());
        String_append(&_fetch_err, "' (only http and https)");
        return FETCH_ERR_URL;
    }
    if (c.https == 1 && fetch_tls_available() == 0) {
#ifdef ESKIU_FETCH_NO_TLS
        return _fetch_fail(FETCH_ERR_NO_TLS, "https is not available: the program was built with ESKIU_FETCH_NO_TLS");
#else
        return _fetch_fail(FETCH_ERR_NO_TLS, "https needs OpenSSL (libssl 3 or 1.1), which could not be loaded (set ESKIU_LIBSSL to its path)");
#endif
    }
    String_clear(&c.out.url);
    Url_to_string(&c.url, &c.out.url);
    c.phase = _FC_RESOLVE;
    return 0;
}

void _fetch_put(Bytes* b, string s) {
    Bytes_append_raw(b, (*uint8)s, strlen(s));
}

void _fetch_put_str(Bytes* b, String* s) {
    Bytes_append_raw(b, (*uint8)s.data, s.len);
}

// Render the request for the current URL into c.req.
void _fetch_render(_FetchCall* c) {
    Bytes* b = &c.req;
    b.len = 0;
    _fetch_put_str(b, &c.method);
    _fetch_put(b, " ");
    let t: String;
    String_init(&t, 64);
    Url_target(&c.url, &t);
    _fetch_put_str(b, &t);
    _fetch_put(b, " HTTP/1.1\r\nHost: ");
    String_clear(&t);
    Url_host_port(&c.url, &t);
    _fetch_put_str(b, &t);
    String_free(&t);
    _fetch_put(b, "\r\n");
    if (c.user_agent.len > 0 && _http_header_count(&c.headers, "user-agent") == 0) {
        _fetch_put(b, "User-Agent: ");
        _fetch_put_str(b, &c.user_agent);
        _fetch_put(b, "\r\n");
    }
    if (_http_header_count(&c.headers, "accept") == 0) {
        _fetch_put(b, "Accept: */*\r\n");
    }
    const int64 n = c.headers.len;
    int64 i = 0;
    while (i < n) {
        int64 e = i;
        while (e < n && c.headers.data[e] != '\n') {
            e++;
        }
        bool skip = _http_line_named(&c.headers, i, e, "host") == 1
                 || _http_line_named(&c.headers, i, e, "content-length") == 1
                 || _http_line_named(&c.headers, i, e, "connection") == 1
                 || _http_line_named(&c.headers, i, e, "transfer-encoding") == 1;
        if (c.cross_origin == 1 && (_http_line_named(&c.headers, i, e, "authorization") == 1
                                    || _http_line_named(&c.headers, i, e, "cookie") == 1)) {
            skip = true;
        }
        if (!skip && e > i) {
            Bytes_append_raw(b, (*uint8)(c.headers.data + i), e - i);
            _fetch_put(b, "\r\n");
        }
        i = e + 1;
    }
    const bool wants_length = String_eq_cstr(&c.method, "POST") == 1 || String_eq_cstr(&c.method, "PUT") == 1
                           || String_eq_cstr(&c.method, "PATCH") == 1;
    if (c.send_body == 1 || wants_length) {
        let cl: String;
        String_init(&cl, 32);
        String_appendf(&cl, "Content-Length: %lld\r\n", c.send_body == 1 ? c.body.len : (int64)0);
        _fetch_put_str(b, &cl);
        String_free(&cl);
    }
    _fetch_put(b, "Connection: close\r\n\r\n");
    if (c.send_body == 1) {
        Bytes_append_raw(b, c.body.data, c.body.len);
    }
    c.sent = 0;
}

// Resolve the host into c.addrs: 0, FETCH_ERR_DNS, or _FETCH_WANT_DNS while
// fetch_async's lookup thread runs (fetch_async polls; call again).
int _fetch_resolve(_FetchCall* c) {
    int rc = 0;
    if (c.dns_async == 1) {
        _FetchDns* j = c.dns_job;
        if (j == null) {
            _dns_wsa_init();
            j = alloc<_FetchDns>(1);
            String_from(&j.host, c.url.host.cstr());
            String_init(&j.port, 8);
            String_appendf(&j.port, "%d", c.url.port);
            c.dns_job = j;
            pthread_detach(thread_create(void() {
                _fetch_dns_work(j);
            }));
        }
        if (atomic_load(&j.state) == 0) {
            return _FETCH_WANT_DNS;
        }
        rc = j.rc;
        _dns_last = rc;
        c.addrs = j.addrs;
        j.addrs = null;
        _fetch_dns_free(j);
        c.dns_job = null;
    } else {
        let port: String;
        String_init(&port, 8);
        String_appendf(&port, "%d", c.url.port);
        rc = _dns_lookup(c.url.host.cstr(), port.cstr(), &c.addrs);
        String_free(&port);
    }
    if (rc != 0 || c.addrs == null) {
        if (c.addrs != null) {
            freeaddrinfo(c.addrs);
        }
        c.addrs = null;
        _fetch_fail(FETCH_ERR_DNS, "cannot resolve host '");
        String_append(&_fetch_err, c.url.host.cstr());
        String_append(&_fetch_err, "': ");
        String_append(&_fetch_err, dns_last_error());
        return FETCH_ERR_DNS;
    }
    c.next = c.addrs;
    c.conn_err = 0;
    return 0;
}

int _fetch_connect_failed(_FetchCall* c) {
    _fetch_fail(FETCH_ERR_CONNECT, "cannot connect to ");
    let hp: String;
    String_init(&hp, 32);
    Url_host_port(&c.url, &hp);
    String_append(&_fetch_err, hp.cstr());
    String_free(&hp);
    if (c.conn_err != 0) {
#ifdef _WIN32
        if (c.conn_err == 10061) {
            String_append(&_fetch_err, ": Connection refused");
        }
        else {
            String_appendf(&_fetch_err, ": socket error %d", c.conn_err);
        }
#else
        String_append(&_fetch_err, ": ");
        String_append(&_fetch_err, strerror(c.conn_err));
#endif
    }
    return FETCH_ERR_CONNECT;
}

// Start a connection to the next address: 0 when connected, _FETCH_WANT_WRITE
// while it is in progress, or FETCH_ERR_CONNECT when no address is left.
int _fetch_connect_next(_FetchCall* c) {
    while (c.next != null) {
        *_dns_addrinfo ai = c.next;
        c.next = ai.ai_next;
        const int s = socket(ai.ai_family, ai.ai_socktype, ai.ai_protocol);
        if (s < 0) {
            continue;
        }
        net_set_nonblocking(s);
        _net_nosigpipe(s);
        if (connect(s, ai.ai_addr, (int)ai.ai_addrlen) == 0) {
            c.fd = s;
            return 0;
        }
        const int e = _net_errno();
        if (e == _FETCH_EINPROGRESS || e == _NET_EAGAIN) {
            c.fd = s;
            return _FETCH_WANT_WRITE;
        }
        c.conn_err = e;
        net_close(s);
    }
    return _fetch_connect_failed(c);
}

int _fetch_timed_out(_FetchCall* c) {
    _fetch_fail(FETCH_ERR_TIMEOUT, "");
    String_appendf(&_fetch_err, "timed out after %lld ms (", c.timeout_ms);
    if (c.phase == _FC_RESOLVE) {
        String_append(&_fetch_err, "resolving the host");
    }
    else if (c.phase == _FC_CONNECTING) {
        String_append(&_fetch_err, "connecting");
    }
    else if (c.phase == _FC_TLS) {
        String_append(&_fetch_err, "TLS handshake");
    }
    else if (c.phase == _FC_SEND) {
        String_append(&_fetch_err, "sending the request");
    }
    else {
        String_append(&_fetch_err, "waiting for the response");
    }
    String_append(&_fetch_err, ")");
    return FETCH_ERR_TIMEOUT;
}

int _fetch_io_failed(string what) {
    _fetch_fail(FETCH_ERR_IO, "connection failed while ");
    String_append(&_fetch_err, what);
    return FETCH_ERR_IO;
}

// After a complete response: 1 to follow a redirect (the call now targets
// the new URL), 0 when this is the final response, or an error.
int _fetch_redirect(_FetchCall* c) {
    Response* r = c.out;
    const int s = r.status;
    if (c.follow == 0 || (s != 301 && s != 302 && s != 303 && s != 307 && s != 308)) {
        return 0;
    }
    let loc: String;
    String_init(&loc, 64);
    defer String_free(&loc);
    if (Response_header(r, "location", &loc) == 0) {
        return 0;
    }
    if (r.redirects >= c.max_redirects) {
        _fetch_fail(FETCH_ERR_REDIRECTS, "");
        String_appendf(&_fetch_err, "too many redirects (more than %d)", c.max_redirects);
        return FETCH_ERR_REDIRECTS;
    }
    let next: Url;
    if (Url_resolve(&c.url, loc.cstr(), &next) == 0) {
        Url_free(&next);
        _fetch_fail(FETCH_ERR_RESPONSE, "malformed response: invalid Location '");
        String_append(&_fetch_err, loc.cstr());
        String_append(&_fetch_err, "'");
        return FETCH_ERR_RESPONSE;
    }
    if (String_eq(&next.scheme, &c.url.scheme) == 0 || String_eq(&next.host, &c.url.host) == 0
        || next.port != c.url.port) {
        c.cross_origin = 1;
    }
    if (s == 301 || s == 302 || s == 303) {
        if (String_eq_cstr(&c.method, "HEAD") == 0) {
            String_clear(&c.method);
            String_append(&c.method, "GET");
        }
        c.send_body = 0;
    }
    r.redirects++;
    _fetch_response_clear(r);
    const int rc = _fetch_target(c, &next);
    return rc < 0 ? rc : 1;
}

// Run the call until it completes, fails or must wait (see above).
int _fetch_step(_FetchCall* c) {
    while (true) {
        if (c.phase == _FC_RESOLVE) {
            const int rc = _fetch_resolve(c);
            if (rc != 0) {
                return rc;
            }
            c.phase = _FC_NEXT_ADDR;
        } else if (c.phase == _FC_NEXT_ADDR) {
            const int rc = _fetch_connect_next(c);
            if (rc < 0) {
                return rc;
            }
            if (rc == _FETCH_WANT_WRITE) {
                c.phase = _FC_CONNECTING;
                return rc;
            }
            c.phase = _FC_CONNECTED;
        } else if (c.phase == _FC_CONNECTING) {
            int err = 0;
            int len = 4;
            if (getsockopt(c.fd, _FETCH_SOL_SOCKET, _FETCH_SO_ERROR, (*void)&err, &len) != 0) {
                err = _net_errno();
            }
            if (err == 0) {
                c.phase = _FC_CONNECTED;
            }
            else {
                c.conn_err = err;
                net_close(c.fd);
                c.fd = -1;
                c.phase = _FC_NEXT_ADDR;
            }
        } else if (c.phase == _FC_CONNECTED) {
            freeaddrinfo(c.addrs);
            c.addrs = null;
            c.next = null;
            _fetch_render(c);
            if (c.https == 1) {
                c.ctx = _ftls_ctx(c.verify, c.ca_file.cstr());
                if (c.ctx != null) {
                    c.ssl = _ftls_new(c.ctx, c.fd, c.url.host.cstr(), c.verify);
                }
                if (c.ssl == null) {
                    if (c.ca_file.len > 0 && c.ctx == null) {
                        _fetch_fail(FETCH_ERR_TLS, "cannot load the CA file '");
                        String_append(&_fetch_err, c.ca_file.cstr());
                        String_append(&_fetch_err, "'");
                        return FETCH_ERR_TLS;
                    }
                    return _fetch_fail(FETCH_ERR_TLS, "cannot set up the TLS connection");
                }
                c.phase = _FC_TLS;
            } else {
                c.phase = _FC_SEND;
            }
        } else if (c.phase == _FC_TLS) {
            const int h = _ftls_handshake(c.ssl);
            if (h == _FTLS_WANT_READ) {
                return _FETCH_WANT_READ;
            }
            if (h == _FTLS_WANT_WRITE) {
                return _FETCH_WANT_WRITE;
            }
            if (h < 0) {
                _fetch_fail(FETCH_ERR_TLS, "TLS handshake with ");
                String_append(&_fetch_err, c.url.host.cstr());
                String_append(&_fetch_err, " failed");
                let why: String;
                String_init(&why, 64);
                if (_ftls_verify_error(c.ssl, &why) == 1) {
                    String_append(&_fetch_err, ": ");
                    String_append(&_fetch_err, why.cstr());
                }
                String_free(&why);
                return FETCH_ERR_TLS;
            }
            c.phase = _FC_SEND;
        } else if (c.phase == _FC_SEND) {
            while (c.sent < c.req.len) {
                int64 w = 0;
                if (c.ssl != null) {
                    w = _ftls_write(c.ssl, c.req.data + c.sent, c.req.len - c.sent);
                }
                else {
                    w = net_send(c.fd, (*void)(c.req.data + c.sent), c.req.len - c.sent);
                    if (w < 0 && net_would_block() == 1) {
                        w = -3;
                    }
                    else if (w <= 0) {
                        w = -1;
                    }
                }
                if (w == -2) {
                    return _FETCH_WANT_READ;
                }
                if (w == -3) {
                    return _FETCH_WANT_WRITE;
                }
                if (w < 0) {
                    return _fetch_io_failed("sending the request");
                }
                c.sent += w;
            }
            FetchParser_init(&c.parser, c.max_body, String_eq_cstr(&c.method, "HEAD"));
            c.parser_live = 1;
            c.phase = _FC_RECV;
        } else if (c.phase == _FC_RECV) {
            int done = 0;
            while (done == 0) {
                int64 n = 0;
                if (c.ssl != null) {
                    n = _ftls_read(c.ssl, c.rbuf, _FETCH_RBUF);
                }
                else {
                    n = net_recv(c.fd, (*void)c.rbuf, _FETCH_RBUF);
                    if (n < 0 && net_would_block() == 1) {
                        n = -2;
                    }
                    else if (n < 0) {
                        n = -1;
                    }
                }
                if (n == -2) {
                    return _FETCH_WANT_READ;
                }
                if (n == -3) {
                    return _FETCH_WANT_WRITE;
                }
                if (n == -1) {
                    return _fetch_io_failed("receiving the response");
                }
                int st = 0;
                if (n == 0) {
                    st = FetchParser_finish(&c.parser, c.out);
                }
                else {
                    st = FetchParser_feed(&c.parser, c.out, c.rbuf, n);
                }
                if (st < 0) {
                    return st;
                }
                if (st == 1) {
                    done = 1;
                }
            }
            _fetch_close(c);
            const int rd = _fetch_redirect(c);
            if (rd < 0) {
                return rd;
            }
            if (rd == 0) {
                c.phase = _FC_DONE;
                return 0;
            }
        } else {
            return 0;
        }
    }
    return 0;
}

// Set up the call for `url` with options `o` and run its first step.
int _fetch_begin(_FetchCall* c, string url, FetchOptions* o, Response* out) {
    c.fd = -1;
    c.out = out;
    String_init(&c.method, 8);
    String_append(&c.method, o.method.cstr());
    String_from(&c.headers, o.headers.cstr());
    Bytes_init(&c.body, o.body.len + 1);
    Bytes_append_raw(&c.body, o.body.data, o.body.len);
    c.send_body = o.has_body;
    c.timeout_ms = o.timeout_ms;
    c.deadline = net_deadline(o.timeout_ms);
    c.follow = o.follow_redirects;
    c.max_redirects = o.max_redirects;
    c.max_body = o.max_body;
    String_from(&c.user_agent, o.user_agent.cstr());
    c.verify = o.verify_tls;
    String_from(&c.ca_file, o.ca_file.cstr());
    Url_init(&c.url);
    Bytes_init(&c.req, 512);
    c.rbuf = alloc<uint8>(_FETCH_RBUF);
    if (o.bad_header == 1 || _http_headers_valid(&c.headers) == 0 || _fetch_has_cr(&c.headers) == 1
        || _fetch_has_cr(&c.user_agent) == 1 || String_index_of(&c.user_agent, '\n') >= 0) {
        return _fetch_fail(FETCH_ERR_REQUEST, "invalid request header (a name must be a token; a value may not hold CR or LF)");
    }
    if (_fetch_is_token(&c.method) == 0) {
        return _fetch_fail(FETCH_ERR_REQUEST, "invalid request method");
    }
    let u: Url;
    if (url_parse(url, &u) == 0) {
        Url_free(&u);
        _fetch_fail(FETCH_ERR_URL, "invalid URL '");
        if (url == null) {
            String_append(&_fetch_err, "(null)");
        }
        else {
            for (int i = 0; url[i] != 0 && i < 200; i++) {
                const int ch = (int)((uint8)url[i]);
                String_push(&_fetch_err, ch < 32 || ch == 127 ? '?' : (char)ch);
            }
        }
        String_append(&_fetch_err, "'");
        return FETCH_ERR_URL;
    }
    const int rc = _fetch_target(c, &u);
    if (rc < 0) {
        return rc;
    }
    return _fetch_step(c);
}

// Fetch `url` with the options in `o` into *out (see the top of the file): 0,
// or a FETCH_ERR_* code.
int fetch_with(string url, FetchOptions* o, Response* out) {
    Response_init(out);
    _FetchCall* c = alloc<_FetchCall>(1);
    int rc = _fetch_begin(c, url, o, out);
    while (rc > 0) {
        const int w = net_wait_ready(c.fd, rc == _FETCH_WANT_WRITE ? 1 : 0, c.deadline);
        if (w == NET_TIMED_OUT) {
            rc = _fetch_timed_out(c);
        }
        else if (w < 0) {
            rc = _fetch_io_failed("waiting for the socket");
        }
        else {
            rc = _fetch_step(c);
        }
    }
    _fetch_call_free(c);
    free((*void)c);
    if (rc < 0) {
        _fetch_response_clear(out);
    }
    return rc;
}

// Fetch `url` with the default options (a GET; see the top of the file).
int fetch(string url, Response* out) {
    let o: FetchOptions;
    FetchOptions_init(&o);
    const int rc = fetch_with(url, &o, out);
    FetchOptions_free(&o);
    return rc;
}

// fetch_with over the event loop `lp`: the future completes with the same
// code. `url` and `out` must stay valid until then; `o` is copied at once.
async int fetch_async(EventLoop* lp, string url, FetchOptions* o, Response* out) {
    Response_init(out);
    _FetchCall* c = alloc<_FetchCall>(1);
    defer {
        _fetch_call_free(c);
        free((*void)c);
    }
    c.dns_async = 1;
    int rc = _fetch_begin(c, url, o, out);
    int64 nap = 1;
    while (rc > 0) {
        if (rc == _FETCH_WANT_DNS) {
            if (c.deadline > 0 && time_monotonic_ms() >= c.deadline) {
                rc = _fetch_timed_out(c);
            }
            else {
                await timer_after(lp, nap);
                if (nap < 16) {
                    nap = nap * 2;
                }
                rc = _fetch_step(c);
            }
        } else {
            nap = 1;
            const int w = await net_ready_deadline_async(lp, c.fd, rc == _FETCH_WANT_WRITE ? 1 : 0, c.deadline);
            if (w == NET_TIMED_OUT) {
                rc = _fetch_timed_out(c);
            }
            else {
                rc = _fetch_step(c);
            }
        }
    }
    if (rc < 0) {
        _fetch_response_clear(out);
    }
    return rc;
}

// ── Result forms ───────────────────────────────────────────────────────────

// fetch as a Result: the response (whatever its status: a 404 is a response), or the
// failure described by fetch_last_error. Free the response with Response_free.
Result<Response, string> fetch_result(string url) {
    let r: Response;
    if (fetch(url, &r) != 0) {
        Response_free(&r);
        return Err<Response, string>(fetch_last_error());
    }
    return Ok<Response, string>(r);
}

// fetch_with as a Result, like fetch_result.
Result<Response, string> fetch_with_result(string url, FetchOptions* o) {
    let r: Response;
    if (fetch_with(url, o, &r) != 0) {
        Response_free(&r);
        return Err<Response, string>(fetch_last_error());
    }
    return Ok<Response, string>(r);
}
