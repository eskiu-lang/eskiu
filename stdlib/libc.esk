// libc.esk: the C library, declared once for code ported from C.
//
//   import <libc>;
//   *char copy = strdup("text");
//   int64 n = strtoll("-42", null, 10);
//   if (libc_errno() == LIBC_ENOENT) { perror("open"); }
//
// This module is the umbrella over the internal modules in stdlib/c/, which declare
// the C functions the stdlib itself calls, one module per header (<c/string>,
// <c/stdlib>, <c/stdio>, <c/unistd>, <c/time>, <c/signal>, <c/errno>). Importing it
// also brings <mem> (calloc, free, alloc<T>), <io> (printf, puts, the standard
// streams, ...) and <math> (sqrt, pow, floor, ...), and adds below the rest of the C
// library that no other stdlib module declares. The rest of libm lives here rather
// than in <math> so that a program importing <math> may still define its own `log`
// or `round`; the other functions below stay here for the same reason, so that the
// modules most programs import (<mem>, <string>, <fs>, <net>, ...) do not claim
// names like `strcpy`, `snprintf` or `qsort`. A program that declares one of these
// functions itself must use the same types (a different spelling is a conflicting
// declaration; sema compares types with aliases expanded).
//
// `char*` is `*char` for a buffer that is written and `string` for text that is
// read. The C types whose width depends on the target come from <ctypes>: `size_t`
// and `ssize_t` are as wide as a pointer, `c_long` is C's `long` (32 bits on
// Windows and on 32-bit targets); `long long` is int64.
import <ctypes>;
import <c/string>;
import <c/stdlib>;
import <c/stdio>;
import <c/unistd>;
import <c/time>;
import <c/signal>;
import <c/errno>;
import <mem>;
import <io>;
import <math>;

// ── string.h ─────────────────────────────────────────────────────────────────
extern *char strcpy(*char dst, string src);
extern *char strncpy(*char dst, string src, size_t n);
extern *char strcat(*char dst, string src);
extern *char strncat(*char dst, string src, size_t n);
extern *char strrchr(string s, int c);
extern *char strpbrk(string s, string accept);
extern size_t strspn(string s, string accept);
extern size_t strcspn(string s, string reject);
#ifdef _WIN32
extern *char _strdup(string s);
*char strdup(string s) {
    return _strdup(s);
}
#else
extern *char strdup(string s);
extern int strcasecmp(string a, string b);
extern int strncasecmp(string a, string b, size_t n);
#endif

// ── stdlib.h ─────────────────────────────────────────────────────────────────
extern *void malloc(size_t n);
extern *void realloc(*void p, size_t n);
extern c_long atol(string s);
extern int64 atoll(string s);
extern c_long strtol(string s, *string end, int base);
extern int64 strtoll(string s, *string end, int base);
extern uint64 strtoull(string s, *string end, int base);
extern c_long labs(c_long x);
extern int64 llabs(int64 x);
extern int rand();
extern void srand(uint32 seed);
extern void abort();
extern int system(string command);
extern int atexit(fn()->void f);
extern void qsort(*void base, size_t n, size_t size, fn(*void, *void)->int cmp);
extern *void bsearch(*void key, *void base, size_t n, size_t size, fn(*void, *void)->int cmp);

// ── stdio.h ──────────────────────────────────────────────────────────────────
extern int snprintf(*char buf, size_t n, string fmt, ...);
extern int sscanf(string s, string fmt, ...);
extern int fputc(int c, *void fp);
extern void perror(string s);
extern int remove(string path);

// ── ctype.h ──────────────────────────────────────────────────────────────────
extern int isalpha(int c);
extern int isdigit(int c);
extern int isalnum(int c);
extern int isspace(int c);
extern int isupper(int c);
extern int islower(int c);
extern int isxdigit(int c);
extern int isprint(int c);
extern int ispunct(int c);
extern int toupper(int c);
extern int tolower(int c);

// ── math.h (beyond <math>) ───────────────────────────────────────────────────
extern double sin(double x);
extern double cos(double x);
extern double tan(double x);
extern double asin(double x);
extern double acos(double x);
extern double atan(double x);
extern double atan2(double y, double x);
extern double sinh(double x);
extern double cosh(double x);
extern double tanh(double x);
extern double exp(double x);
extern double exp2(double x);
extern double log(double x);
extern double log2(double x);
extern double log10(double x);
extern double cbrt(double x);
extern double hypot(double x, double y);
extern double round(double x);
extern double trunc(double x);
extern double fmin(double a, double b);
extern double fmax(double a, double b);
extern double copysign(double x, double y);
extern float sqrtf(float x);
extern float fabsf(float x);
extern float powf(float base, float exp);
extern float floorf(float x);
extern float ceilf(float x);
extern float roundf(float x);
extern float sinf(float x);
extern float cosf(float x);
extern float tanf(float x);
extern float atan2f(float y, float x);
extern float expf(float x);
extern float logf(float x);
const double LIBC_PI = 3.14159265358979323846;
const double LIBC_E = 2.71828182845904523536;

// ── errno ────────────────────────────────────────────────────────────────────
// The calling thread's errno, read and set through the C library's per-thread cell.
int libc_errno() {
    return _c_errno();
}

void libc_set_errno(int e) {
    _c_set_errno(e);
}
#ifdef __wasm__
// WebAssembly (emscripten, WASI) numbers errno as WASI does.
const int LIBC_EPERM = 63;
const int LIBC_ENOENT = 44;
const int LIBC_EINTR = 27;
const int LIBC_EIO = 29;
const int LIBC_EBADF = 8;
const int LIBC_ENOMEM = 48;
const int LIBC_EACCES = 2;
const int LIBC_EEXIST = 20;
const int LIBC_EINVAL = 28;
const int LIBC_EAGAIN = 6;
const int LIBC_ERANGE = 68;
#else
const int LIBC_EPERM = 1;
const int LIBC_ENOENT = 2;
const int LIBC_EINTR = 4;
const int LIBC_EIO = 5;
const int LIBC_EBADF = 9;
const int LIBC_ENOMEM = 12;
const int LIBC_EACCES = 13;
const int LIBC_EEXIST = 17;
const int LIBC_EINVAL = 22;
#ifdef _WIN32
const int LIBC_EAGAIN = 11;
const int LIBC_ERANGE = 34;
#else
#ifdef __APPLE__
const int LIBC_EAGAIN = 35;
#else
const int LIBC_EAGAIN = 11;
#endif
const int LIBC_ERANGE = 34;
#endif
#endif

// ── unistd.h (POSIX) ─────────────────────────────────────────────────────────
#ifndef _WIN32
extern int getppid();
extern int access(string path, int mode);
#endif
