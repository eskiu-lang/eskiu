// tls.esk — TLS for HTTP/2 over OpenSSL, with ALPN negotiating "h2".
//
// HTTP/2 in browsers runs over TLS, with the protocol chosen during the
// handshake via ALPN (Application-Layer Protocol Negotiation): the client
// offers a list, the server picks "h2". This module wraps OpenSSL (libssl) by
// FFI: a server SSL_CTX that loads a cert/key and installs an ALPN callback
// selecting "h2", and the h2-over-TLS connection handlers that run the <http2>
// frame protocol over the encrypted stream. Two flavours are provided: a
// blocking, thread-per-connection server (http2_tls_serve_conn) and an async one
// (http2_tls_serve_async) that runs many TLS connections on one event-loop
// thread via a non-blocking SSL pump (retrying SSL_* on WANT_READ/WANT_WRITE).
//
// Build: link with OpenSSL, e.g.
//   eskiuc app.esk -o app -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto

import <c/signal>;   // signal (Linux)
import <mem>;
import <future>;
import <eventloop>;
import <net_async>;
import <http2>;
import <hpack>;
import <http>;
import <http2_server>;
import <string>;
import <channel>;
import <net>;
import <time>;

// ── OpenSSL FFI (libssl, OpenSSL 1.1 / 3.x) ──────────────────────────────────
extern *void TLS_server_method();
extern *void SSL_CTX_new(*void method);
extern void SSL_CTX_free(*void ctx);
extern int SSL_CTX_use_certificate_file(*void ctx, string file, int type);
extern int SSL_CTX_use_PrivateKey_file(*void ctx, string file, int type);
extern void SSL_CTX_set_alpn_select_cb(*void ctx, *void cb, *void arg);
extern *void SSL_new(*void ctx);
extern int SSL_set_fd(*void ssl, int fd);
extern int SSL_get_fd(*void ssl);
extern int SSL_accept(*void ssl);
extern int SSL_read(*void ssl, *void buf, int n);
extern int SSL_write(*void ssl, *void buf, int n);
extern int SSL_shutdown(*void ssl);
extern void SSL_free(*void ssl);
extern int SSL_get_error(*void ssl, int ret);

const int X509_FILETYPE_PEM = 1;
const int SSL_ERROR_WANT_READ = 2;
const int SSL_ERROR_WANT_WRITE = 3;
const int SSL_TLSEXT_ERR_OK = 0;   // ALPN: a protocol was selected
const int SSL_TLSEXT_ERR_NOACK = 3;   // ALPN: none acceptable

// OpenSSL writes a socket BIO with write(), so a peer that closed raises
// SIGPIPE. macOS marks the socket SO_NOSIGPIPE; Linux has no per-socket switch,
// so the first TLS connection sets SIGPIPE to ignored for the process (every
// write to a closed peer then fails with EPIPE, which SSL_write reports).
#ifdef __linux__
bool _tls_sigpipe_off = false;
#endif
void _tls_nosigpipe(int fd) {
    _net_nosigpipe(fd);
#ifdef __linux__
    if (!_tls_sigpipe_off) {
        signal(13, (*void)(int64)1);
        _tls_sigpipe_off = true;
    }
#endif
}

// ── ALPN: select "h2" ────────────────────────────────────────────────────────

// Scan the wire-format protocol list `protos` (each entry: a 1-byte length then
// that many name bytes) for "h2". On a match, point *out at the name and set
// *outlen to 2, returning 1; otherwise 0. Pure — unit-testable without a socket.
// An entry whose length runs past `len` (a malformed list) ends the scan: no
// byte at or past protos[len] is read.
int _tls_alpn_pick_h2(*uint8 protos, int len, **uint8 out, *uint8 outlen) {
    int i = 0;
    while (i < len) {
        const int plen = (int)protos[i];
        if (plen > len - i - 1) {
            return 0;
        }
        if (plen == 2 && protos[i + 1] == 'h' && protos[i + 2] == '2') {
            *out = protos + i + 1;
            *outlen = (uint8)2;
            return 1;
        }
        i += 1 + plen;
    }
    return 0;
}

// OpenSSL ALPN select callback (C ABI). Passed to SSL_CTX_set_alpn_select_cb as a
// raw C function pointer — `(*void)_tls_alpn_select`.
int _tls_alpn_select(*void ssl, **uint8 out, *uint8 outlen, *uint8 protos, uint inlen, *void arg) {
    return _tls_alpn_pick_h2(protos, (int)inlen, out, outlen) != 0 ? SSL_TLSEXT_ERR_OK : SSL_TLSEXT_ERR_NOACK;
}

// ── Server context + connection ──────────────────────────────────────────────

// Build a server SSL_CTX: load the PEM cert + key and install the ALPN-"h2"
// callback. Returns null on failure.
*void tls_server_ctx(string cert_file, string key_file) {
    *void ctx = SSL_CTX_new(TLS_server_method());
    if (ctx == null) {
        return null;
    }
    if (SSL_CTX_use_certificate_file(ctx, cert_file, X509_FILETYPE_PEM) <= 0) {
        SSL_CTX_free(ctx);
        return null;
    }
    if (SSL_CTX_use_PrivateKey_file(ctx, key_file, X509_FILETYPE_PEM) <= 0) {
        SSL_CTX_free(ctx);
        return null;
    }
    SSL_CTX_set_alpn_select_cb(ctx, (*void)_tls_alpn_select, null);
    return ctx;
}

// The blocking TLS calls below run the socket non-blocking and wait for it with
// poll (<net>'s net_wait_ready) whenever OpenSSL asks for more (WANT_READ /
// WANT_WRITE), so a deadline bounds the whole call. A socket timeout
// (SO_RCVTIMEO) would not: OpenSSL loops recv() inside one SSL_read until a
// record is complete, and every byte a peer trickles restarts that timeout.

// Wait for what SSL error `e` wants on `fd` (WANT_READ: readable, else
// writable) by `deadline` (0 = none): 0 when ready, NET_TIMED_OUT, or -1.
int _tls_wait(int fd, int e, int64 deadline) {
    return net_wait_ready(fd, e == SSL_ERROR_WANT_READ ? 0 : 1, deadline);
}

// Complete the server handshake on `ssl` by `deadline` (0 = none), waiting for
// writes at most `write_ms` each (0 = no limit): 1 on success, NET_TIMED_OUT,
// or -1 on failure.
int tls_accept_deadline(*void ssl, int64 deadline, int64 write_ms) {
    const int fd = SSL_get_fd(ssl);
    while (true) {
        const int r = SSL_accept(ssl);
        if (r == 1) {
            return 1;
        }
        const int e = SSL_get_error(ssl, r);
        if (e != SSL_ERROR_WANT_READ && e != SSL_ERROR_WANT_WRITE) {
            return -1;
        }
        const int64 dl = e == SSL_ERROR_WANT_WRITE ? _h2_dl_min(deadline, time_monotonic_ms(), write_ms) : deadline;
        const int w = _tls_wait(fd, e, dl);
        if (w == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
        if (w < 0) {
            return -1;
        }
    }
    return -1;
}

// Wrap an accepted socket in TLS and complete the handshake (ALPN runs here).
// Returns the SSL* on success, null on handshake failure. The whole handshake
// must be done within lim.header_ms, and each of its writes taken within
// lim.write_ms (a peer that stalls or trickles it fails it). The socket is left
// non-blocking: the tls_* calls here wait for it themselves.
*void tls_accept_with(*void ctx, int fd, HttpLimits* lim) {
    *void ssl = SSL_new(ctx);
    if (ssl == null) {
        return null;
    }
    _tls_nosigpipe(fd);
    SSL_set_fd(ssl, fd);
    net_set_nonblocking(fd);
    const int r = tls_accept_deadline(ssl, net_deadline(lim.header_ms), lim.write_ms);
    if (r != 1) {
        SSL_free(ssl);
        return null;
    }
    return ssl;
}

// tls_accept_with under the default HttpLimits.
*void tls_accept(*void ctx, int fd) {
    let lim: HttpLimits;
    lim.init();
    return tls_accept_with(ctx, fd, &lim);
}

// Read exactly `n` bytes (blocking); returns the count (< n on close/error).
int tls_read_full(*void ssl, *uint8 buf, int n) {
    return tls_read_full_deadline(ssl, buf, n, 0);
}

// tls_read_full with a deadline (<net>'s net_deadline; 0 = none) for all `n`
// bytes: the count, or NET_TIMED_OUT once it passes. The deadline holds on a
// non-blocking socket (tls_accept_with leaves it so); on a blocking one an
// SSL_read may wait past it.
int tls_read_full_deadline(*void ssl, *uint8 buf, int n, int64 deadline) {
    int got = 0;
    while (got < n) {
        const int r = SSL_read(ssl, (*void)(buf + got), n - got);
        if (r > 0) {
            got += r;
            continue;
        }
        const int e = SSL_get_error(ssl, r);
        if (e != SSL_ERROR_WANT_READ && e != SSL_ERROR_WANT_WRITE) {
            break;
        }
        const int w = _tls_wait(SSL_get_fd(ssl), e, deadline);
        if (w == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
        if (w < 0) {
            break;
        }
    }
    return got;
}

// Write all `n` bytes (blocking).
void tls_write_all(*void ssl, *uint8 buf, int n) {
    const int w = tls_write_all_n(ssl, buf, n);
}

// tls_write_all returning `n`, or -1 once a write fails (a closed peer).
int tls_write_all_n(*void ssl, *uint8 buf, int n) {
    const int w = tls_write_all_deadline(ssl, buf, n, 0);
    return w == n ? n : -1;
}

// tls_write_all_n with a deadline for all `n` bytes (0 = none, and as for
// tls_read_full_deadline it holds on a non-blocking socket): `n`, -1 once a
// write fails, or NET_TIMED_OUT (a peer that stops reading, or reads slowly).
int tls_write_all_deadline(*void ssl, *uint8 buf, int n, int64 deadline) {
    int sent = 0;
    while (sent < n) {
        const int w = SSL_write(ssl, (*void)(buf + sent), n - sent);
        if (w > 0) {
            sent += w;
            continue;
        }
        const int e = SSL_get_error(ssl, w);
        if (e != SSL_ERROR_WANT_READ && e != SSL_ERROR_WANT_WRITE) {
            return -1;
        }
        const int x = _tls_wait(SSL_get_fd(ssl), e, deadline);
        if (x == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
        if (x < 0) {
            return -1;
        }
    }
    return sent;
}

void tls_close(*void ssl) {
    SSL_shutdown(ssl);
    SSL_free(ssl);
}

// Frame buffers here are 16384 + 9 bytes: the payload cap is the default
// SETTINGS_MAX_FRAME_SIZE, which this server never raises (RFC 9113 §4.2).
const int TLS_H2_MAX_PAYLOAD = 16384;

// Read one whole frame (header into `hdr`, payload into buf+9; `buf` must hold
// TLS_H2_MAX_PAYLOAD + 9 bytes). Returns the payload length, -1 on close/error,
// or -2 if the peer's frame exceeds the maximum frame size (FRAME_SIZE_ERROR).
int tls_read_frame(*void ssl, *uint8 buf, H2Frame* hdr) {
    return tls_read_frame_deadline(ssl, buf, hdr, 0);
}

// tls_read_frame with a deadline for the whole frame (0 = none): also
// NET_TIMED_OUT.
int tls_read_frame_deadline(*void ssl, *uint8 buf, H2Frame* hdr, int64 deadline) {
    const int h = tls_read_full_deadline(ssl, buf, 9, deadline);
    if (h == NET_TIMED_OUT) {
        return NET_TIMED_OUT;
    }
    if (h < 9) {
        return -1;
    }
    h2_read_header(buf, hdr);
    if (hdr.length > TLS_H2_MAX_PAYLOAD) {
        return -2;
    }
    if (hdr.length > 0) {
        const int p = tls_read_full_deadline(ssl, buf + 9, hdr.length, deadline);
        if (p == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
        if (p < hdr.length) {
            return -1;
        }
    }
    return hdr.length;
}

// Serve one h2-over-TLS connection (blocking): the client preface, then frames
// through the <http2_server> H2Server engine (the same protocol handling as the
// h2c server: flow control both ways, padding, CONTINUATION, PING, SETTINGS
// validation) until either side ends it. Closes the TLS connection on return.
// Under the default HttpLimits (see http2_tls_serve_conn_with).
void http2_tls_serve_conn(*void ssl, escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    http2_tls_serve_conn_with(ssl, handler, http_limits());
}

// http2_tls_serve_conn with the deadlines of `lim`, as the h2c server (see
// H2Server_deadline in <http2_server>), counted from this call: the preface and
// SETTINGS within header_ms, GOAWAY NO_ERROR and close after idle_ms with no
// open stream, and a write the peer does not take within write_ms ends it. The
// socket is made non-blocking (the reads and writes wait with poll), so a peer
// that trickles bytes cannot stretch a deadline.
void http2_tls_serve_conn_with(*void ssl, escaping fn(HttpRequest*, HttpResponse*)->void handler, HttpLimits lim) {
    const int64 start = time_monotonic_ms();
    net_set_nonblocking(SSL_get_fd(ssl));
    *uint8 pf = alloc<uint8>(24);
    const int pn = tls_read_full_deadline(ssl, pf, 24, _h2_dl_min(0, start, lim.header_ms));
    const bool ok = pn == 24 && h2_is_preface(pf) != 0;
    free((*void)pf);
    if (!ok) {
        tls_close(ssl);
        return;
    }

    *uint8 fb = alloc<uint8>(TLS_H2_MAX_PAYLOAD + H2_FRAME_HEADER_LEN);
    H2Server* s = alloc<H2Server>(1);
    H2Server_init(s, -1);
    s.start_ms = start;
    bool running = true;
    while (running) {
        if (s.outlen > 0) {
            const int w = tls_write_all_deadline(ssl, s.out, (int)s.outlen, net_deadline(lim.write_ms));
            s.outlen = 0;
            if (w < 0) {
                break;
            }
        }
        if (H2Server_done(s) != 0) {
            break;
        }
        H2Server_tick(s, time_monotonic_ms());
        let fr: H2Frame;
        const int fl = tls_read_frame_deadline(ssl, fb, &fr, H2Server_deadline(s, &lim));
        if (fl == NET_TIMED_OUT) {
            running = H2Server_timed_out_with(s, &lim, time_monotonic_ms()) != 0;
        }
        else if (fl == -2) {
            H2Server_goaway(s, H2_FRAME_SIZE_ERROR);
        }
        else if (fl < 0) {
            running = false;
        }
        else {
            H2Server_step(s, &fr, fb + H2_FRAME_HEADER_LEN, handler);
        }
    }
    H2Server_free(s);
    free((*void)s);
    free((*void)fb);
    tls_close(ssl);
}

// ── Async (event-loop) TLS ───────────────────────────────────────────────────
// The async server runs many TLS connections on one thread (like the h2c
// <http2_server>). SSL over a non-blocking fd drives I/O by retrying SSL_*
// whenever the error is WANT_READ / WANT_WRITE and parking on that readiness.

// Create an SSL for `fd` (no handshake yet). The fd should be non-blocking.
*void tls_new(*void ctx, int fd) {
    *void ssl = SSL_new(ctx);
    if (ssl != null) {
        _tls_nosigpipe(fd);
        SSL_set_fd(ssl, fd);
    }
    return ssl;
}

// Park until `fd` is ready for what SSL error `e` wants (WANT_READ: readable,
// else writable), by `deadline` (0 = none): 0 when ready, NET_TIMED_OUT past it.
Future<int>* _tls_wait_async(EventLoop* lp, int fd, int e, int64 deadline) {
    return net_ready_deadline_async(lp, fd, e == SSL_ERROR_WANT_READ ? 0 : 1, deadline);
}

// Drive SSL_accept to completion over the loop. Returns 1 on success, -1 on error.
Future<int>* tls_accept_async(EventLoop* lp, int fd, *void ssl) {
    return tls_accept_deadline_async(lp, fd, ssl, 0);
}

// tls_accept_async with a deadline (<net>'s net_deadline; 0 = none): also
// NET_TIMED_OUT when the handshake is not done by then.
async int tls_accept_deadline_async(EventLoop* lp, int fd, *void ssl, int64 deadline) {
    int done = 0;
    while (done == 0) {
        int r = SSL_accept(ssl);
        if (r == 1) {
            return 1;
        }
        int e = SSL_get_error(ssl, r);
        if (e != SSL_ERROR_WANT_READ && e != SSL_ERROR_WANT_WRITE) {
            return -1;
        }
        int x = await _tls_wait_async(lp, fd, e, deadline);
        if (x == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
    }
    return -1;
}

// Read once; retry across readiness on WANT_READ/WANT_WRITE. Returns bytes (>0),
// or <= 0 on a clean close / error.
Future<int>* tls_read_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, int n) {
    return tls_read_deadline_async(lp, fd, ssl, buf, n, 0);
}

// tls_read_async with a deadline (0 = none): also NET_TIMED_OUT.
async int tls_read_deadline_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, int n, int64 deadline) {
    int done = 0;
    while (done == 0) {
        int r = SSL_read(ssl, (*void)buf, n);
        if (r > 0) {
            return r;
        }
        int e = SSL_get_error(ssl, r);
        if (e != SSL_ERROR_WANT_READ && e != SSL_ERROR_WANT_WRITE) {
            return -1;
        }
        int x = await _tls_wait_async(lp, fd, e, deadline);
        if (x == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
    }
    return -1;
}

// Read exactly `n` bytes; a result < n means the peer closed.
Future<int>* tls_read_full_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, int n) {
    return tls_read_full_deadline_async(lp, fd, ssl, buf, n, 0);
}

// tls_read_full_async with a deadline for all `n` bytes (0 = none): also
// NET_TIMED_OUT.
async int tls_read_full_deadline_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, int n, int64 deadline) {
    int got = 0;
    while (got < n) {
        int r = await tls_read_deadline_async(lp, fd, ssl, buf + got, n - got, deadline);
        if (r == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
        if (r <= 0) {
            return got;
        }
        got += r;
    }
    return got;
}

// Write all `n` bytes (looping SSL_write, parking on readiness). Returns n or -1.
Future<int>* tls_write_all_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, int n) {
    return tls_write_all_deadline_async(lp, fd, ssl, buf, n, 0);
}

// tls_write_all_async with a deadline (0 = none): also NET_TIMED_OUT (a peer
// that stops reading).
async int tls_write_all_deadline_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, int n, int64 deadline) {
    int sent = 0;
    while (sent < n) {
        int w = SSL_write(ssl, (*void)(buf + sent), n - sent);
        if (w > 0) {
            sent += w;
        }
        if (w <= 0) {
            int e = SSL_get_error(ssl, w);
            if (e != SSL_ERROR_WANT_READ && e != SSL_ERROR_WANT_WRITE) {
                return -1;
            }
            int x = await _tls_wait_async(lp, fd, e, deadline);
            if (x == NET_TIMED_OUT) {
                return NET_TIMED_OUT;
            }
        }
    }
    return sent;
}

// Read one whole frame over TLS into `buf` (TLS_H2_MAX_PAYLOAD + 9 bytes; header
// into `hdr`). Returns the payload length, -1 on close/error, or -2 if the frame
// exceeds the maximum frame size.
Future<int>* tls_read_frame_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, H2Frame* hdr) {
    return tls_read_frame_deadline_async(lp, fd, ssl, buf, hdr, 0);
}

// tls_read_frame_async with a deadline for the whole frame (0 = none): also
// NET_TIMED_OUT.
async int tls_read_frame_deadline_async(EventLoop* lp, int fd, *void ssl, *uint8 buf, H2Frame* hdr, int64 deadline) {
    int h = await tls_read_full_deadline_async(lp, fd, ssl, buf, 9, deadline);
    if (h == NET_TIMED_OUT) {
        return NET_TIMED_OUT;
    }
    if (h < 9) {
        return -1;
    }
    h2_read_header(buf, hdr);
    if (hdr.length > TLS_H2_MAX_PAYLOAD) {
        return -2;
    }
    if (hdr.length > 0) {
        int p = await tls_read_full_deadline_async(lp, fd, ssl, buf + 9, hdr.length, deadline);
        if (p == NET_TIMED_OUT) {
            return NET_TIMED_OUT;
        }
        if (p < hdr.length) {
            return -1;
        }
    }
    return hdr.length;
}

// The post-preface frame loop over TLS: frames through the H2Server engine
// until either side ends the connection or the peer closes. `fb` holds
// TLS_H2_MAX_PAYLOAD + 9 bytes. Under the default HttpLimits, counted from now.
Future<uint8>* _http2_tls_dispatch_async(EventLoop* lp, int fd, *void ssl, *uint8 fb,
                                        escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    return _http2_tls_dispatch_async_with(lp, fd, ssl, fb, handler, http_limits(), time_monotonic_ms());
}

// _http2_tls_dispatch_async with the deadlines of `lim` (see H2Server_deadline in
// <http2_server>); `start` is when the connection began (the SETTINGS deadline
// counts from it).
async void _http2_tls_dispatch_async_with(EventLoop* lp, int fd, *void ssl, *uint8 fb,
                                         escaping fn(HttpRequest*, HttpResponse*)->void handler,
                                         HttpLimits lim, int64 start) {
    H2Server* s = alloc<H2Server>(1);
    H2Server_init(s, fd);
    s.start_ms = start;
    int running = 1;
    while (running != 0) {
        if (s.outlen > 0) {
            int64 wdl = net_deadline(lim.write_ms);
            int w = await tls_write_all_deadline_async(lp, fd, ssl, s.out, (int)s.outlen, wdl);
            s.outlen = 0;
            if (w < 0) {
                running = 0;
            }
        }
        if (running != 0 && H2Server_done(s) != 0) {
            running = 0;
        }
        if (running != 0) {
            H2Server_tick(s, time_monotonic_ms());
            int64 dl = H2Server_deadline(s, &lim);
            let fr: H2Frame;
            int fl = await tls_read_frame_deadline_async(lp, fd, ssl, fb, &fr, dl);
            if (fl == NET_TIMED_OUT) {
                running = H2Server_timed_out_with(s, &lim, time_monotonic_ms());
            }
            else if (fl == -2) {
                H2Server_goaway(s, H2_FRAME_SIZE_ERROR);
            }
            else if (fl < 0) {
                running = 0;
            }
            else {
                H2Server_step(s, &fr, fb + H2_FRAME_HEADER_LEN, handler);
            }
        }
    }
    H2Server_free(s);
    free((*void)s);
}

// Serve one h2-over-TLS connection asynchronously over the event loop: the SSL
// handshake (ALPN -> h2), the client preface, then the frame loop. Detached per
// connection by http2_tls_serve_async, so many TLS connections share one thread.
// The handshake and the preface must be done within lim.header_ms of the
// accept; then the h2c deadlines apply. `open` (may be null) is decremented on
// the way out.
async void http2_tls_conn_async_with(EventLoop* lp, int fd, *void ctx,
                                     escaping fn(HttpRequest*, HttpResponse*)->void handler,
                                     Chan<int>* done, HttpLimits lim, *int open) {
    net_set_nonblocking(fd);
    int64 start = time_monotonic_ms();
    int64 hdl = _h2_dl_min(0, start, lim.header_ms);
    *void ssl = tls_new(ctx, fd);
    int ok = 0;
    if (ssl != null) {
        ok = await tls_accept_deadline_async(lp, fd, ssl, hdl);
    }
    if (ok == 1) {
        *uint8 fb = alloc<uint8>(TLS_H2_MAX_PAYLOAD + H2_FRAME_HEADER_LEN);
        int pn = await tls_read_full_deadline_async(lp, fd, ssl, fb, 24, hdl);
        if (pn == 24 && h2_is_preface(fb) != 0) {
            await _http2_tls_dispatch_async_with(lp, fd, ssl, fb, handler, lim, start);
        }
        free((*void)fb);
    }
    if (ssl != null) {
        tls_close(ssl);
    }
    net_close(fd);
    if (open != null) {
        *open = *open - 1;
    }
    Chan_send<int>(done, 1);
}

// http2_tls_conn_async_with under the default HttpLimits.
Future<uint8>* http2_tls_conn_async(EventLoop* lp, int fd, *void ctx,
                                    escaping fn(HttpRequest*, HttpResponse*)->void handler,
                                    Chan<int>* done) {
    return http2_tls_conn_async_with(lp, fd, ctx, handler, done, http_limits(), null);
}

// Accept and serve `max_conns` TLS connections concurrently over one event loop,
// at most lim.max_open at once (one past that is closed right away).
async void http2_tls_serve_async_with(EventLoop* lp, int listen_fd, *void ctx,
                                      escaping fn(HttpRequest*, HttpResponse*)->void handler,
                                      int max_conns, HttpLimits lim) {
    Chan<int>* done = chan_new<int>(max_conns);
    *int open = alloc<int>(1);
    for (int accepted = 0; accepted < max_conns; accepted++) {
        int c = await net_accept_retry_async(lp, listen_fd);   // a failed accept is retried, never served
        if (lim.max_open > 0 && *open >= lim.max_open) {
            net_close(c);                               // over the limit: refused
            Chan_send<int>(done, 1);
        } else {
            *open = *open + 1;
            spawn(http2_tls_conn_async_with(lp, c, ctx, handler, done, lim, open));
        }
    }
    for (int finished = 0; finished < max_conns; finished++) {
        int sig = await Chan_recv(done);
    }
    free((*void)open);
    Chan_free<int>(done);
}

// http2_tls_serve_async_with under the default HttpLimits.
Future<uint8>* http2_tls_serve_async(EventLoop* lp, int listen_fd, *void ctx,
                                     escaping fn(HttpRequest*, HttpResponse*)->void handler,
                                     int max_conns) {
    return http2_tls_serve_async_with(lp, listen_fd, ctx, handler, max_conns, http_limits());
}
