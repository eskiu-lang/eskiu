// eventloop.esk — a general-purpose readiness reactor.
//
// A single thread watches many file descriptors and dispatches a callback when
// one becomes readable, via kqueue (macOS) or epoll (Linux). This is the shared
// foundation for async I/O, the HTTP stack, and (later) the UI framework — it
// dispatches readiness, not just sockets.
//
//   void on_accept(EventLoop* lp, int fd) {
//       int c = net_accept(fd);
//       EventLoop_add_read(lp, c, on_data);     // register the new connection
//   }
//   int main() {
//       EventLoop* lp = el_new(256);
//       EventLoop_add_read(lp, listen_fd, on_accept);
//       EventLoop_run(lp);                       // blocks, dispatching callbacks
//   }

import <mem>;
import <time>;

// A read-ready callback receives the loop (so it can register/remove fds or
// stop) and the fd that became readable.
struct EvHandler {
    fn(EventLoop*, int)->void on_read;   // the callback (read- or write-readiness)
    int active;
    // Bumped on every (re-)registration. EventLoop_run uses it to tell whether the
    // callback it just invoked is still the installed one: a one-shot read loop
    // on a single fd re-arms that fd *from inside the callback* (via resume), so
    // `active` is back to 1 by the time EventLoop_run checks — `gen` is not.
    int gen;
    int isWrite;   // 0 = waiting for readable, 1 = waiting for writable
}

// A one-shot timer: fire `on_fire` once the monotonic clock reaches `deadline`.
struct EvTimer {
    int64 deadline;   // monotonic ms (time_monotonic_ms)
    fn()->void on_fire;
    int active;
}

struct EventLoop {
    int backend;   // kqueue / epoll descriptor
    int running;
    *EvHandler slots;     // indexed by fd
    int cap;
    *EvTimer timers;    // timer slots [0, tcap)
    int tcap;
    int dispatching;   // the fd whose callback EventLoop_run is running, or -1
}

// ── Platform backend ─────────────────────────────────────────────────────────
#ifdef __APPLE__

extern int kqueue();
extern int kevent(int kq, *void changelist, int nchanges,
                  *void eventlist, int nevents, *void timeout);

// struct kevent (macOS, 64-bit): natural layout, 32 bytes.
struct EvNative {
    uint64 ident;
    int16 filter;
    uint16 flags;
    uint32 fflags;
    int64 data;
    *void udata;
}

extern int close(int fd);

int _el_backend_new() {
    return kqueue();
}

void _el_backend_free(int kq) {
    close(kq);
}

// One kevent change: filter (-1 = EVFILT_READ, -2 = EVFILT_WRITE), flag
// (1 = EV_ADD, 2 = EV_DELETE).
void _el_kev(int kq, int fd, int filter, int flag) {
    let ev: EvNative;
    ev.ident = (uint64)fd;
    ev.filter = (int16)filter;
    ev.flags = (uint16)flag;
    ev.fflags = 0;
    ev.data = 0;
    ev.udata = null;
    kevent(kq, (*void)&ev, 1, null, 0, null);
}

// Set fd's interest: mode 0 = none, 1 = readable, 2 = writable. kqueue filters
// are independent, so we add the wanted one and delete the other (ENOENT on a
// not-registered filter is harmless). `wasActive` is unused here (epoll needs it).
void _el_ctl(int kq, int fd, int mode, int wasActive) {
    if (mode == 0) {
        _el_kev(kq, fd, -1, 2);
        _el_kev(kq, fd, -2, 2);
        return;
    }
    if (mode == 2) {   // want write
        _el_kev(kq, fd, -2, 1);
        _el_kev(kq, fd, -1, 2);
    }
    else {   // want read
        _el_kev(kq, fd, -1, 1);
        _el_kev(kq, fd, -2, 2);
    }
}

// struct timespec (64-bit macOS): { time_t tv_sec; long tv_nsec; } = 16 bytes.
struct EvTimespec {
    int64 tv_sec;
    int64 tv_nsec;
}

// Wait for readiness (or until `timeout_ms`, -1 = forever); fill fds[0..) with
// ready descriptors, return the count (0 on timeout).
int _el_wait(int kq, *EvNative evs, *int fds, int max, int64 timeout_ms) {
    let ts: EvTimespec;
    *void tsp = null;                     // NULL timeout = wait forever
    if (timeout_ms >= 0) {
        ts.tv_sec = timeout_ms / 1000;
        ts.tv_nsec = (timeout_ms % 1000) * 1000000;
        tsp = (*void)&ts;
    }
    const int n = kevent(kq, null, 0, (*void)evs, max, tsp);
    for (i in 0..n) {
        fds[i] = (int)evs[i].ident;
    }
    return n;
}

#else
#ifdef _WIN32  // Windows: WSAPoll

// Unlike epoll/kqueue (kernel-side interest state), WSAPoll is stateless: it takes the whole
// pollfd array each call. So the interest set lives in a user-space table, rebuilt in place by
// _el_ctl and handed to WSAPoll by _el_wait. One event loop is assumed (a single global set).
#pragma link("ws2_32")
extern int WSAPoll(*void fdarray, int nfds, int timeout);

// WSAPOLLFD: { SOCKET fd; SHORT events; SHORT revents; }. On x64 SOCKET is 8 bytes and forces
// 8-byte alignment, so the record is 16 bytes: fd@0, events@8, revents@10, then 4 pad.
packed struct EvNative {
    int64 fd;
    int16 events;
    int16 revents;
    int32 _pad;
}

// POLLRDNORM = 0x0100, POLLWRNORM = 0x0010 (the readiness bits WSAPoll reports/accepts).
const int _EL_POLLRD = 256;
const int _EL_POLLWR = 16;

struct _ElPollSet {
    EvNative[4096] pfds;
    int n;
}

_ElPollSet _el_wsa;

int _el_backend_new() {   // state is the global set; the id is unused
    _el_wsa.n = 0;
    return 0;
}

void _el_backend_free(int backend) {
    _el_wsa.n = 0;
}

int _el_wsa_find(int fd) {
    for (i in 0.._el_wsa.n) {
        if (_el_wsa.pfds[i].fd == (int64)fd) {
            return i;
        }
    }
    return -1;
}

// Set fd's interest: mode 0 = none (drop), 1 = readable, 2 = writable.
void _el_ctl(int backend, int fd, int mode, int wasActive) {
    int idx = _el_wsa_find(fd);
    if (mode == 0) {                                   // remove: swap with the last entry
        if (idx >= 0) {
            _el_wsa.pfds[idx] = _el_wsa.pfds[_el_wsa.n - 1];
            _el_wsa.n--;
        }
        return;
    }
    const int16 ev = (int16)(mode == 2 ? _EL_POLLWR : _EL_POLLRD);
    if (idx < 0) {                                     // first registration
        idx = _el_wsa.n;
        _el_wsa.n++;
        _el_wsa.pfds[idx].fd = (int64)fd;
    }
    _el_wsa.pfds[idx].events = ev;
    _el_wsa.pfds[idx].revents = 0;
}

int _el_wait(int backend, *EvNative evs, *int fds, int max, int64 timeout_ms) {
    if (_el_wsa.n == 0) {                  // WSAPoll rejects a 0-length set
        return 0;
    }
    int r = WSAPoll((*void)&_el_wsa.pfds[0], _el_wsa.n, (int)timeout_ms);
    if (r <= 0) {                          // 0 = timeout, <0 = error
        return 0;
    }
    int cnt = 0;
    for (int i = 0; i < _el_wsa.n && cnt < max; i++) {
        if (_el_wsa.pfds[i].revents != 0) {
            fds[cnt] = (int)_el_wsa.pfds[i].fd;
            cnt++;
        }
    }
    return cnt;
}

#elif defined(__wasm__)  // WebAssembly (emscripten, WASI): POSIX poll

// poll is stateless like WSAPoll: the interest set is a user-space table handed to it on
// each wait. struct pollfd is { int fd; short events; short revents; } (8 bytes).
// nfds_t is a C unsigned long, 32 bits on wasm32 (as <net> and <process> spell it).
extern int poll(*void fds, int32 nfds, int timeout);

struct EvNative {
    int fd;
    int16 events;
    int16 revents;
}

const int _EL_POLLRD = 1;    // POLLIN
const int _EL_POLLWR = 4;    // POLLOUT

struct _ElPollSet {
    EvNative[1024] pfds;
    int n;
}

_ElPollSet _el_pset;

int _el_backend_new() {   // state is the global set; the id is unused
    _el_pset.n = 0;
    return 0;
}

void _el_backend_free(int backend) {
    _el_pset.n = 0;
}

int _el_pset_find(int fd) {
    for (i in 0.._el_pset.n) {
        if (_el_pset.pfds[i].fd == fd) {
            return i;
        }
    }
    return -1;
}

// Set fd's interest: mode 0 = none (drop), 1 = readable, 2 = writable.
void _el_ctl(int backend, int fd, int mode, int wasActive) {
    int idx = _el_pset_find(fd);
    if (mode == 0) {                                   // remove: swap with the last entry
        if (idx >= 0) {
            _el_pset.pfds[idx] = _el_pset.pfds[_el_pset.n - 1];
            _el_pset.n--;
        }
        return;
    }
    if (idx < 0) {                                     // first registration
        idx = _el_pset.n;
        _el_pset.n++;
        _el_pset.pfds[idx].fd = fd;
    }
    _el_pset.pfds[idx].events = (int16)(mode == 2 ? _EL_POLLWR : _EL_POLLRD);
    _el_pset.pfds[idx].revents = 0;
}

extern int usleep(uint32 us);

int _el_wait(int backend, *EvNative evs, *int fds, int max, int64 timeout_ms) {
    // emscripten's poll takes no timeout: check the descriptors without waiting, then
    // sleep until the nearest timer when none is ready (a wait with no timer returns).
    int r = poll(_el_pset.n == 0 ? null : (*void)&_el_pset.pfds[0], (int32)_el_pset.n, 0);
    if (r <= 0) {
        if (timeout_ms > 0) {
            usleep((uint32)(timeout_ms * 1000));
        }
        return 0;
    }
    int cnt = 0;
    for (int i = 0; i < _el_pset.n && cnt < max; i++) {
        if (_el_pset.pfds[i].revents != 0) {
            fds[cnt] = _el_pset.pfds[i].fd;
            cnt++;
        }
    }
    return cnt;
}

#else  // Linux: epoll

extern int epoll_create1(int flags);
extern int epoll_ctl(int epfd, int op, int fd, *void ev);
extern int epoll_wait(int epfd, *void events, int maxevents, int timeout);

// struct epoll_event { u32 events; u64 data; } is packed (12 bytes) only on x86-64;
// elsewhere (AArch64, ARM) `data` is 8-aligned and the struct is 16 bytes.
#ifdef __x86_64__
packed struct EvNative {
    uint32 events;
    uint64 data;
}
#else
struct EvNative {
    uint32 events;
    uint64 data;
}
#endif

extern int close(int fd);

int _el_backend_new() {
    return epoll_create1(0);
}

void _el_backend_free(int ep) {
    close(ep);
}

// Set fd's interest: mode 0 = none (DEL), 1 = readable (EPOLLIN), 2 = writable
// (EPOLLOUT). epoll keeps one entry per fd, so switching read<->write is a MOD
// (the fd was already registered) and the first registration is an ADD.
void _el_ctl(int ep, int fd, int mode, int wasActive) {
    if (mode == 0) {       // EPOLL_CTL_DEL
        epoll_ctl(ep, 2, fd, null);
        return;
    }
    let ev: EvNative;
    ev.events = mode == 2 ? 4 : 1;                               // EPOLLOUT=4, EPOLLIN=1
    ev.data = (uint64)fd;
    const int op = wasActive != 0 ? 3 : 1;                       // MOD=3 (EPOLL_CTL_MOD), ADD=1
    epoll_ctl(ep, op, fd, (*void)&ev);
}

int _el_wait(int ep, *EvNative evs, *int fds, int max, int64 timeout_ms) {
    const int n = epoll_wait(ep, (*void)evs, max, (int)timeout_ms);   // -1 = forever
    for (i in 0..n) {
        fds[i] = (int)evs[i].data;
    }
    return n;
}

#endif
#endif

// ── Public API ───────────────────────────────────────────────────────────────

// Create a loop that can track fds in [0, max_fds).
EventLoop* el_new(int max_fds) {
    EventLoop* lp = alloc<EventLoop>(1);
    lp.backend = _el_backend_new();
    lp.running = 0;
    lp.dispatching = -1;
    if (max_fds < 1) {              // the tables grow by doubling: never from 0
        max_fds = 1;
    }
    lp.cap = max_fds;
    lp.slots = alloc<EvHandler>(max_fds);
    // alloc zeroes the slot (active/gen/isWrite = 0, on_read = null). A null on_read is
    // never dispatched (the loop guards on `active == 0`), but install a no-op closure so
    // that even a stray dispatch is a safe no-op rather than a null-function-pointer call.
    for (i in 0..max_fds) {
        lp.slots[i].on_read = void(EventLoop* e, int fd) {};
    }
    lp.tcap = max_fds;
    lp.timers = alloc<EvTimer>(max_fds);
    // Same as the slots: alloc zeroes the timer (active = 0, on_fire = null); install a
    // no-op so a stray fire is safe rather than a null call.
    for (t in 0..max_fds) {
        lp.timers[t].on_fire = void() {};
    }
    return lp;
}

// Double the timer table (a full table must not drop a timer: its future would
// never fire). Existing ids are slot indices and stay valid.
void _el_grow_timers(EventLoop* lp) {
    const int newcap = lp.tcap * 2 < 8 ? 8 : lp.tcap * 2;
    EvTimer* nt = alloc<EvTimer>(newcap);
    for (i in 0..lp.tcap) {
        nt[i] = lp.timers[i];
    }
    for (i in lp.tcap..newcap) {
        nt[i].on_fire = void() {};
    }
    free((*void)lp.timers);
    lp.timers = nt;
    lp.tcap = newcap;
}

// Register a one-shot timer firing at monotonic `deadline` (ms). Returns a timer
// id (slot index); the table grows when every slot is armed. `EventLoop_run` fires it
// once, then frees `on_fire`.
int EventLoop_add_timer(EventLoop* lp, int64 deadline, escaping fn()->void on_fire) {
    int t = 0;
    while (t < lp.tcap && lp.timers[t].active != 0) {
        t++;
    }
    if (t == lp.tcap) {
        _el_grow_timers(lp);
    }
    lp.timers[t].deadline = deadline;
    lp.timers[t].on_fire = on_fire;
    lp.timers[t].active = 1;
    return t;
}

// Cancel a pending timer and free its env. Safe to call after it has fired
// (no-op then). Use from outside the timer's own on_fire.
void EventLoop_del_timer(EventLoop* lp, int id) {
    if (id < 0 || id >= lp.tcap) {
        return;
    }
    if (lp.timers[id].active != 0) {
        free_closure(lp.timers[id].on_fire);
        lp.timers[id].active = 0;
    }
}

// Grow the fd-indexed slot table so `slots[fd]` is valid. POSIX fds are small and dense, so
// this rarely fires; Windows SOCKET handles are large and sparse (e.g. 236), so a fixed
// `el_new(max)` would silently drop their registration. Doubling keeps the table valid for
// any fd while staying O(fds) overall.
void _el_ensure_slots(EventLoop* lp, int fd) {
    if (fd < lp.cap) {
        return;
    }
    int newcap = lp.cap * 2 < 8 ? 8 : lp.cap * 2;
    while (newcap <= fd) {
        newcap *= 2;
    }
    EvHandler* ns = alloc<EvHandler>(newcap);
    for (i in 0..lp.cap) {                            // keep existing registrations
        ns[i] = lp.slots[i];
    }
    for (i in lp.cap..newcap) {   // no-op the rest
        ns[i].on_read = void(EventLoop* e, int fd) {};
    }
    free((*void)lp.slots);
    lp.slots = ns;
    lp.cap = newcap;
}

// Replacing an active registration releases the old callback's env, unless the
// old callback is the one running right now (EventLoop_run frees it on return).
void _el_release_old(EventLoop* lp, int fd) {
    if (lp.slots[fd].active != 0 && lp.dispatching != fd) {
        free_closure(lp.slots[fd].on_read);
    }
}

// Register `fd` for read-readiness; `cb` fires each time it is readable. A
// registration already on `fd` is replaced (and its callback env freed).
void EventLoop_add_read(EventLoop* lp, int fd, escaping fn(EventLoop*, int)->void cb) {
    if (fd < 0) {
        return;
    }
    _el_ensure_slots(lp, fd);
    const int was = lp.slots[fd].active;
    _el_release_old(lp, fd);
    lp.slots[fd].on_read = cb;
    lp.slots[fd].active = 1;
    lp.slots[fd].isWrite = 0;
    lp.slots[fd].gen++;                            // new registration identity
    _el_ctl(lp.backend, fd, 1, was);
}

// Register `fd` for write-readiness; `cb` fires once it is writable. Used by the
// async write path and the non-blocking TLS pump. A fd waits for read OR write
// at a time; this replaces any prior read interest on the fd.
void EventLoop_add_write(EventLoop* lp, int fd, escaping fn(EventLoop*, int)->void cb) {
    if (fd < 0) {
        return;
    }
    _el_ensure_slots(lp, fd);
    const int was = lp.slots[fd].active;
    _el_release_old(lp, fd);
    lp.slots[fd].on_read = cb;
    lp.slots[fd].active = 1;
    lp.slots[fd].isWrite = 1;
    lp.slots[fd].gen++;
    _el_ctl(lp.backend, fd, 2, was);
}

// Stop watching `fd`. (Does not free the callback env — on the normal path the
// callback is still running when it calls this; EventLoop_run frees the env on return.)
void EventLoop_del(EventLoop* lp, int fd) {
    if (fd < 0 || fd >= lp.cap) {
        return;
    }
    lp.slots[fd].active = 0;
    _el_ctl(lp.backend, fd, 0, 1);
}

// Deregister `fd` and free its callback's heap env. For deregistering from
// OUTSIDE the callback (e.g. cancelling a pending one-shot whose callback never
// fired) — never call this from within `fd`'s own callback (use EventLoop_del there).
void EventLoop_del_free(EventLoop* lp, int fd) {
    if (fd < 0 || fd >= lp.cap) {
        return;
    }
    if (lp.slots[fd].active != 0) {
        free_closure(lp.slots[fd].on_read);
    }
    EventLoop_del(lp, fd);
}

// Ask the loop to return from EventLoop_run after the current batch.
void EventLoop_stop(EventLoop* lp) {
    lp.running = 0;
}

// Run until EventLoop_stop is called: wait for readiness and dispatch callbacks.
void EventLoop_run(EventLoop* lp) {
    const int max = 64;
    *EvNative evs = alloc<EvNative>(max);
    *int fds = alloc<int>(max);
    defer free((*void)evs);
    defer free((*void)fds);
    lp.running = 1;
    while (lp.running != 0) {
        // Block only until the nearest timer deadline (forever if none), so the
        // loop wakes in time to fire timers even with no fd activity.
        int64 now = time_monotonic_ms();
        int64 timeout = -1;                             // -1 = wait forever
        for (t in 0..lp.tcap) {
            if (lp.timers[t].active != 0) {
                int64 d = lp.timers[t].deadline - now;
                if (d < 0) {
                    d = 0;
                }
                if (timeout < 0 || d < timeout) {
                    timeout = d;
                }
            }
        }
        const int n = _el_wait(lp.backend, evs, fds, max, timeout);
        for (i in 0..n) {
            const int fd = fds[i];
            if (fd >= 0 && fd < lp.cap && lp.slots[fd].active != 0) {
                let cb: fn(EventLoop*, int)->void = lp.slots[fd].on_read;
                const int g = lp.slots[fd].gen;
                lp.dispatching = fd;
                cb(lp, fd);
                lp.dispatching = -1;
                // Free `cb`'s heap env once it is no longer the installed
                // registration: either it deregistered (active -> 0) or it re-armed
                // the same fd with a *new* closure during its own run (gen bumped).
                // A still-installed persistent callback (same gen, active) is left.
                if (lp.slots[fd].active == 0 || lp.slots[fd].gen != g) {
                    free_closure(cb);
                }
            }
        }
        // Fire expired timers. Deactivate before firing so on_fire (-> resume) can
        // reuse the slot; free the snapshot env afterwards (one-shot, now spent).
        // The bound is re-read each step: an on_fire that adds a timer may grow the table.
        now = time_monotonic_ms();
        for (int t = 0; t < lp.tcap; t++) {
            if (lp.timers[t].active != 0 && lp.timers[t].deadline <= now) {
                let fire: fn()->void = lp.timers[t].on_fire;
                lp.timers[t].active = 0;
                fire();
                free_closure(fire);
            }
        }
    }
}

// Free the loop and every callback env still registered on it (armed timers and
// watched fds). Lifetime rule: a pending leaf future on this loop (<net_async>,
// <timer>) points at it, so drop or finish every such future BEFORE freeing the
// loop; dropping one afterwards would deregister it from freed memory.
void EventLoop_free(EventLoop* lp) {
    // Release any still-armed timer envs (e.g. the loop stopped with timers pending).
    for (t in 0..lp.tcap) {
        if (lp.timers[t].active != 0) {
            free_closure(lp.timers[t].on_fire);
        }
    }
    for (f in 0..lp.cap) {
        if (lp.slots[f].active != 0) {
            free_closure(lp.slots[f].on_read);
        }
    }
    free((*void)lp.timers);
    free((*void)lp.slots);
    _el_backend_free(lp.backend);    // close the kqueue / epoll descriptor
    free((*void)lp);
}
