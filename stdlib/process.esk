// process.esk: run and control child processes.
//
//   import <process>;
//
//   let r: ProcessResult;
//   if (sh("ls -l | wc -l", &r) == 0) { printf("%d: %s", r.exit_code, r.stdout.data); }
//   ProcessResult_free(&r);
//
//   let argv: List<string>;  List_init<string>(&argv, 4);
//   argv.push("git");  argv.push("status");  argv.push("--short");
//   let opts: ProcessOptions;              // zero value: capture both streams
//   opts.cwd = "/path/to/repo";
//   opts.timeout_ms = 5000;
//   process_run(&argv, &opts, &r);         // r.timed_out, r.exit_code, r.stdout, r.stderr
//
// process_run starts argv[0] (looked up in PATH) with argv as its arguments, no
// shell involved, feeds it `stdin_text`, collects stdout and stderr (both pipes
// are drained together, so a child that fills one while the other waits cannot
// deadlock) and waits for it. It returns 0 when the program ran, whatever its
// exit code, and -1 when it could not be started (not found, bad cwd); then
// process_last_error says why and r.exit_code is -1. exit_code is the exit
// status, or 128+N when a signal N ended the child (POSIX). A timeout kills the
// child and what it started (its process group on POSIX, a Job object on
// Windows, so `sh -c` pipelines die too; on POSIX only the child itself when
// it inherits a terminal stdin, which it could not read from another process
// group), sets timed_out and reports exit code 137.
//
// process_spawn starts a child and returns at once with pipe handles in a
// Process: Process_write_stdin / Process_close_stdin feed it, Process_read reads
// what it wrote, Process_wait reaps it and Process_kill ends it; Process_free
// closes the handles. Reading one pipe to the end while the child fills the
// other can block: set merge_stderr or inherit_stderr when that matters.
//
// A ProcessOptions or a ProcessResult is plain data: its zero value (`let o:
// ProcessOptions;`, which starts at zero) is the default.
// process_run fills every field of the result; free it with ProcessResult_free.

import <ctypes>;
import <c/stdlib>;
import <c/unistd>;
import <c/signal>;
import <c/poll>;
import <c/windows>;
import <mem>;
import <string>;
import <list>;
import <time>;
import <fs>;
import <env>;
import <result>;

struct ProcessOptions {
    string stdin_text;      // process_run: written to the child's stdin, which is then closed
    string cwd;             // working directory of the child; null inherits the parent's
    List<string>* env;      // extra "NAME=value" entries, replacing same-named ones; null: none
    int64 timeout_ms;       // process_run: kill the child after this long; 0: no limit
    bool inherit_stdin;     // the child reads the parent's stdin (else empty input or stdin_text)
    bool inherit_stdout;    // the child writes to the parent's stdout (not captured)
    bool inherit_stderr;    // the child writes to the parent's stderr (not captured)
    bool merge_stderr;      // the child's stderr goes where its stdout goes ("2>&1")
}

struct ProcessResult {
    int exit_code;       // exit status; 128+N for signal N; 137 after a timeout; -1 if not started
    String stdout;          // captured standard output ("" when inherited)
    String stderr;          // captured standard error ("" when inherited or merged)
    bool timed_out;
}

// A running child started by process_spawn. A handle is -1 (POSIX) or null
// (Windows) when that stream is not a pipe.
struct Process {
    int pid;
    int exit_code;         // set by Process_wait
    bool exited;
#ifdef _WIN32
    *void hproc;
    *void hjob;             // a Job object holding the child and what it starts (process_run with a timeout)
    *void hin;
    *void hout;
    *void herr;
#else
    int stdin_fd;
    int stdout_fd;
    int stderr_fd;
    bool group;             // the child leads its own process group
#endif
}

// A child that writes to our stdout or stderr directly would otherwise print before
// what this process still holds in its stdio buffers.
void _proc_flush_inherited(ProcessOptions* o) {
    if (o.inherit_stdout || o.inherit_stderr) {
        fflush(null);
    }
}

void ProcessResult_free(ProcessResult* r) {
    r.stdout.free();
    r.stderr.free();
}

// A readable message for the last failure of a process_* / Process_* call.
void process_last_error(String* out) {
    fs_last_error(out);
}

// ── Platform layer ────────────────────────────────────────────────────────

#ifdef _WIN32
extern int CreatePipe(**void rd, **void wr, *void sa, uint32 size);
extern int SetHandleInformation(*void h, uint32 mask, uint32 flags);
extern *void GetCurrentProcess();
extern int DuplicateHandle(*void sp, *void h, *void tp, **void out, uint32 access, int inherit, uint32 opts);
extern int CreateProcessW(*uint16 app, *uint16 cmd, *void pa, *void ta, int inherit, uint32 flags, *void env, *uint16 cwd, *void si, *void pi);
extern int ReadFile(*void h, *void buf, uint32 n, *uint32 got, *void ov);
extern int WriteFile(*void h, *void buf, uint32 n, *uint32 put, *void ov);
extern uint32 WaitForSingleObject(*void h, uint32 ms);
extern int GetExitCodeProcess(*void h, *uint32 code);
extern int TerminateProcess(*void h, uint32 code);
extern uint32 GetCurrentProcessId();
extern *void CreateJobObjectW(*void sa, *uint16 name);
extern int AssignProcessToJobObject(*void job, *void proc);
extern int TerminateJobObject(*void job, uint32 code);
extern uint32 ResumeThread(*void thread);

struct _proc_sa {
    uint32 n;
    *void desc;
    int inherit;
}
#else
extern int fork();
extern int execvp(string file, *string argv);
extern int waitpid(int pid, *int status, int options);
extern void _exit(int code);
extern int kill(int pid, int sig);
extern int setpgid(int pid, int pgid);

struct _proc_pollfd {
    int fd;
    int16 events;
    int16 revents;
}

// The environment block (environ, or _NSGetEnviron() on Apple) is declared in <env>.
#ifdef __APPLE__
void _proc_set_environ(*string e) {
    *_NSGetEnviron() = e;
}
#define _PROC_O_NONBLOCK 4
#define _PROC_O_CLOEXEC  16777216
#define _PROC_EAGAIN     35
#define _PROC_SIG_BLOCK   1
#define _PROC_SIG_SETMASK 3
#else
extern int pipe2(*int fds, int flags);
void _proc_set_environ(*string e) {
    environ = e;
}
#define _PROC_O_NONBLOCK 2048
#define _PROC_O_CLOEXEC  524288
#define _PROC_EAGAIN     11
#define _PROC_SIG_BLOCK   0
#define _PROC_SIG_SETMASK 2
#endif
#define _PROC_F_SETFD 2
#define _PROC_F_GETFL 3
#define _PROC_F_SETFL 4
#define _PROC_EINTR   4
#define _PROC_SIGPIPE 13
#define _PROC_SIGKILL 9

// A pipe whose two ends are close-on-exec: fds[0] reads, fds[1] writes.
int _proc_pipe(*int fds) {
#ifdef __APPLE__
    if (pipe(fds) != 0) {
        return -1;
    }
    fcntl(fds[0], _PROC_F_SETFD, 1);
    fcntl(fds[1], _PROC_F_SETFD, 1);
    return 0;
#else
    return pipe2(fds, _PROC_O_CLOEXEC);
#endif
}

void _proc_close(*int fd) {
    if (*fd >= 0) {
        close(*fd);
        *fd = -1;
    }
}

// In the child: make `src` the descriptor `dst` (kept across exec).
void _proc_dup_to(int src, int dst) {
    if (src == dst) {
        fcntl(dst, _PROC_F_SETFD, 0);
        return;
    }
    dup2(src, dst);
}

extern int pthread_sigmask(int how, *void set, *void old);
extern int sigemptyset(*void set);
extern int sigaddset(*void set, int sig);
extern int sigismember(*void set, int sig);
extern int sigpending(*void set);
extern int sigwait(*void set, *int sig);

// write() to a child's stdin where a closed read end is EPIPE, not a SIGPIPE that
// kills the program, without changing the process-wide disposition (other threads
// may be writing to pipes of their own). macOS sends that SIGPIPE to the process,
// so the descriptor itself is marked F_SETNOSIGPIPE. Linux sends it to the writing
// thread: only this thread blocks it, for the one call, and takes the signal the
// failed write left pending.
int64 _proc_write_nosig(int fd, *void buf, int64 n) {
#ifdef __APPLE__
    fcntl(fd, 73, 1);   // F_SETNOSIGPIPE
    return write(fd, buf, n);
#else
    uint64[16] set;    // a sigset_t (128 bytes covers every libc)
    uint64[16] old;
    uint64[16] pend;
    sigemptyset((*void)&set[0]);
    sigaddset((*void)&set[0], _PROC_SIGPIPE);
    pthread_sigmask(_PROC_SIG_BLOCK, (*void)&set[0], (*void)&old[0]);
    const int64 w = write(fd, buf, n);
    const int e = _fs_errno_now();
    if (w < 0 && e == 32 && sigismember((*void)&old[0], _PROC_SIGPIPE) == 0) {   // EPIPE
        sigemptyset((*void)&pend[0]);
        if (sigpending((*void)&pend[0]) == 0 && sigismember((*void)&pend[0], _PROC_SIGPIPE) == 1) {
            int sig = 0;
            sigwait((*void)&set[0], &sig);
        }
    }
    pthread_sigmask(_PROC_SIG_SETMASK, (*void)&old[0], null);
    return w;
#endif
}
#endif

int process_pid() {
#ifdef _WIN32
    return (int)GetCurrentProcessId();
#else
    return getpid();
#endif
}

// End the current process with `code` (stdio buffers are flushed).
void process_exit(int code) {
    exit(code);
}

// The environment for a child: the parent's plus `extra` (same-named entries
// replaced), as "NAME=value" Strings in `out`.
void _proc_env_merge(List<string>* extra, List<String>* out) {
    let cur: List<String>;
    List_init<String>(&cur, 64);
    env_list(&cur);
    for (i in 0..List_len<String>(&cur)) {
        let e: String = List_get<String>(&cur, i);
        bool replaced = false;
        for (k in 0..List_len<string>(extra)) {
            const string x = List_get<string>(extra, k);
            int j = 0;
            while (x[j] != 0 && x[j] != '=' && (int64)j < e.len && e.data[j] == x[j]) {
                j++;
            }
            if (x[j] == '=' && (int64)j < e.len && e.data[j] == '=') {
                replaced = true;
            }
        }
        if (replaced) {
            e.free();
        } else {
            List_push<String>(out, e);
        }
    }
    List_free<String>(&cur);
    for (k in 0..List_len<string>(extra)) {
        let s: String;
        s.from(List_get<string>(extra, k));
        List_push<String>(out, s);
    }
}

#ifdef _WIN32
// ── Windows ───────────────────────────────────────────────────────────────

// Append `arg` to a command line quoted for CommandLineToArgvW / the C runtime.
void _proc_quote_arg(String* cmd, string arg) {
    if (cmd.len > 0) {
        cmd.push(' ');
    }
    bool plain = arg[0] != 0;
    for (int i = 0; arg[i] != 0; i++) {
        const char c = arg[i];
        if (c == ' ' || c == '\t' || c == '\n' || c == 11 || c == '"') {
            plain = false;
        }
    }
    if (plain) {
        cmd.append(arg);
        return;
    }
    cmd.push('"');
    int i = 0;
    while (true) {
        int slashes = 0;
        while (arg[i] == '\\') {
            slashes++;
            i++;
        }
        if (arg[i] == 0) {
            for (k in 0..slashes * 2) {
                cmd.push('\\');
            }
            break;
        }
        if (arg[i] == '"') {
            for (k in 0..slashes * 2 + 1) {
                cmd.push('\\');
            }
            cmd.push('"');
        } else {
            for (k in 0..slashes) {
                cmd.push('\\');
            }
            cmd.push(arg[i]);
        }
        i++;
    }
    cmd.push('"');
}

*void _proc_inheritable(*void h) {
    if (h == null || (int64)h == -1) {
        return null;
    }
    let d: *void = null;
    if (DuplicateHandle(GetCurrentProcess(), h, GetCurrentProcess(), &d, (uint32)0, 1, (uint32)2) == 0) {
        return null;
    }
    return d;
}

// Start the child for `cmdline` (UTF-8). Pipes the streams the options ask
// for: stdin when `pipe_in`, stdout/stderr unless inherited (stderr not when merged).
// With `job`, the child starts suspended inside a new Job object (p.hjob), so
// a timeout can end every process it starts.
int _proc_start(String* cmdline, ProcessOptions* o, bool pipe_in, bool job, Process* p) {
    p.pid = 0;
    p.exit_code = -1;
    p.exited = false;
    p.hproc = null;
    p.hjob = null;
    p.hin = null;
    p.hout = null;
    p.herr = null;
    let sa: _proc_sa;
    sa.n = (uint32)24;
    sa.desc = null;
    sa.inherit = 1;
    let c_in: *void = null;
    let c_out: *void = null;
    let c_err: *void = null;
    if (pipe_in) {
        let r: *void = null;
        let w: *void = null;
        if (CreatePipe(&r, &w, (*void)&sa, (uint32)0) == 0) {
            return _fs_fail_os();
        }
        SetHandleInformation(w, (uint32)1, (uint32)0);
        c_in = r;
        p.hin = w;
    } else if (o.inherit_stdin) {
        c_in = _proc_inheritable(GetStdHandle((uint32)4294967286));
    } else {
        *uint16 nul = _fs_wide("NUL");
        c_in = CreateFileW(nul, (uint32)2147483648, (uint32)3, (*void)&sa, (uint32)3, (uint32)0, null);
        free((*void)nul);
    }
    if (o.inherit_stdout) {
        c_out = _proc_inheritable(GetStdHandle((uint32)4294967285));
    } else {
        let r: *void = null;
        let w: *void = null;
        if (CreatePipe(&r, &w, (*void)&sa, (uint32)0) == 0) {
            return _fs_fail_os();
        }
        SetHandleInformation(r, (uint32)1, (uint32)0);
        c_out = w;
        p.hout = r;
    }
    if (o.merge_stderr) {
        c_err = _proc_inheritable(c_out);
    } else if (o.inherit_stderr) {
        c_err = _proc_inheritable(GetStdHandle((uint32)4294967284));
    } else {
        let r: *void = null;
        let w: *void = null;
        if (CreatePipe(&r, &w, (*void)&sa, (uint32)0) == 0) {
            return _fs_fail_os();
        }
        SetHandleInformation(r, (uint32)1, (uint32)0);
        c_err = w;
        p.herr = r;
    }
    int64[13] si;   // STARTUPINFOW, 104 bytes
    *uint8 sb = (*uint8)&si;
    memset((*void)sb, 0, 104);
    *int32 cb = (*int32)sb;
    cb[0] = 104;
    cb[15] = 256;   // dwFlags = STARTF_USESTDHANDLES
    **void hs = (**void)(sb + 80);
    hs[0] = c_in;
    hs[1] = c_out;
    hs[2] = c_err;
    int64[3] pi;    // PROCESS_INFORMATION
    *uint16 wcmd = _fs_wide(cmdline.cstr());
    *uint16 wcwd = o.cwd != null ? _fs_wide(o.cwd) : null;
    *uint16 wenv = null;
    uint32 flags = (uint32)0;
    if (o.env != null && List_len<string>(o.env) > 0) {
        let all: List<String>;
        List_init<String>(&all, 64);
        _proc_env_merge(o.env, &all);
        let block: String;
        block.init(4096);
        for (i in 0..List_len<String>(&all)) {
            let e: String = List_get<String>(&all, i);
            _fs_append_bytes(&block, (*uint8)e.data, e.len + 1);
        }
        let zero: uint8 = (uint8)0;
        _fs_append_bytes(&block, &zero, 1);
        // Convert the NUL-separated UTF-8 block to UTF-16 in one call (length given).
        const int wn = MultiByteToWideChar((uint32)65001, (uint32)0, (string)block.data, (int)block.len, null, 0);
        wenv = alloc<uint16>((int64)wn + 1);
        MultiByteToWideChar((uint32)65001, (uint32)0, (string)block.data, (int)block.len, wenv, wn);
        block.free();
        fs_list_free(&all);
        flags = (uint32)1024;   // CREATE_UNICODE_ENVIRONMENT
    }
    if (job) {   // CREATE_SUSPENDED
        flags = flags | (uint32)4;
    }
    const int ok = wcmd != null ? CreateProcessW(null, wcmd, null, null, 1, flags, (*void)wenv, wcwd, (*void)sb, (*void)&pi) : 0;
    if (ok == 0) {
        _fs_fail_os();
    }
    free((*void)wcmd);
    free((*void)wcwd);
    free((*void)wenv);
    if (c_in != null) {
        CloseHandle(c_in);
    }
    if (c_out != null) {
        CloseHandle(c_out);
    }
    if (c_err != null) {
        CloseHandle(c_err);
    }
    if (ok == 0) {
        if (p.hin != null) {
            CloseHandle(p.hin);
            p.hin = null;
        }
        if (p.hout != null) {
            CloseHandle(p.hout);
            p.hout = null;
        }
        if (p.herr != null) {
            CloseHandle(p.herr);
            p.herr = null;
        }
        return -1;
    }
    **void ph = (**void)&pi;
    p.hproc = ph[0];
    if (job) {
        p.hjob = CreateJobObjectW(null, null);
        if (p.hjob != null && AssignProcessToJobObject(p.hjob, p.hproc) == 0) {
            CloseHandle(p.hjob);
            p.hjob = null;
        }
        ResumeThread(ph[1]);
    }
    CloseHandle(ph[1]);
    *int32 ids = (*int32)&pi;
    p.pid = (int)ids[4];
    return 0;
}

void _proc_cmdline(List<string>* argv, String* out) {
    out.clear();
    for (i in 0..List_len<string>(argv)) {
        _proc_quote_arg(out, List_get<string>(argv, i));
    }
}

struct _proc_job {
    *void h;
    String* buf;
    string text;
}

void _proc_drain(_proc_job* j) {
    *uint8 buf = alloc<uint8>(65536);
    while (true) {
        let got: uint32 = (uint32)0;
        if (ReadFile(j.h, (*void)buf, (uint32)65536, &got, null) == 0 || got == (uint32)0) {
            break;
        }
        _fs_append_bytes(j.buf, buf, (int64)got);
    }
    free((*void)buf);
}

void _proc_feed(_proc_job* j) {
    int64 off = 0;
    const int64 n = strlen(j.text);
    while (off < n) {
        const int64 chunk = n - off > 65536 ? 65536 : n - off;
        let put: uint32 = (uint32)0;
        if (WriteFile(j.h, (*void)((*uint8)j.text + off), (uint32)chunk, &put, null) == 0) {
            break;
        }
        off += (int64)put;
    }
    CloseHandle(j.h);
}

int _proc_run_cmd(String* cmdline, ProcessOptions* o, ProcessResult* r) {
    r.stdout.init(256);
    r.stderr.init(64);
    r.exit_code = -1;
    r.timed_out = false;
    let p: Process;
    if (_proc_start(cmdline, o, o.stdin_text != null, o.timeout_ms > 0, &p) != 0) {
        return -1;
    }
    let jout: _proc_job;
    jout.h = p.hout;
    jout.buf = &r.stdout;
    jout.text = null;
    let jerr: _proc_job;
    jerr.h = p.herr;
    jerr.buf = &r.stderr;
    jerr.text = null;
    let jin: _proc_job;
    jin.h = p.hin;
    jin.buf = null;
    jin.text = o.stdin_text;
    *_proc_job po = &jout;
    *_proc_job pe = &jerr;
    *_proc_job pn = &jin;
    *void t_out = null;
    *void t_err = null;
    *void t_in = null;
    if (p.hout != null) {
        t_out = thread_create(void() {
            _proc_drain(po);
        });
    }
    if (p.herr != null) {
        t_err = thread_create(void() {
            _proc_drain(pe);
        });
    }
    if (p.hin != null) {
        t_in = thread_create(void() {
            _proc_feed(pn);
        });
    }
    uint32 wait_ms = (uint32)4294967295;   // INFINITE
    if (o.timeout_ms > 0) {
        wait_ms = o.timeout_ms >= 4294967295 ? (uint32)4294967294 : (uint32)o.timeout_ms;
    }
    if (WaitForSingleObject(p.hproc, wait_ms) == (uint32)258) {   // WAIT_TIMEOUT
        if (p.hjob != null) {
            TerminateJobObject(p.hjob, (uint32)137);
        }
        TerminateProcess(p.hproc, (uint32)137);
        WaitForSingleObject(p.hproc, (uint32)4294967295);
        r.timed_out = true;
    }
    if (t_in != null) {
        thread_join(t_in);
    }
    if (t_out != null) {
        thread_join(t_out);
    }
    if (t_err != null) {
        thread_join(t_err);
    }
    let code: uint32 = (uint32)0;
    GetExitCodeProcess(p.hproc, &code);
    r.exit_code = r.timed_out ? 137 : (int)code;
    if (p.hout != null) {
        CloseHandle(p.hout);
    }
    if (p.herr != null) {
        CloseHandle(p.herr);
    }
    CloseHandle(p.hproc);
    if (p.hjob != null) {
        CloseHandle(p.hjob);
    }
    return 0;
}

int process_run(List<string>* argv, ProcessOptions* opts, ProcessResult* out) {
    let def: ProcessOptions;            // the defaults: every field zero
    ProcessOptions* o = opts != null ? opts : &def;
    _proc_flush_inherited(o);
    let cmd: String;
    cmd.init(64);
    defer cmd.free();
    _proc_cmdline(argv, &cmd);
    return _proc_run_cmd(&cmd, o, out);
}

int sh_with(string command, ProcessOptions* opts, ProcessResult* out) {
    let def: ProcessOptions;            // the defaults: every field zero
    ProcessOptions* o = opts != null ? opts : &def;
    _proc_flush_inherited(o);
    let cmd: String;
    cmd.init(64);
    defer cmd.free();
    cmd.append("cmd.exe /d /s /c \"");
    cmd.append(command);
    cmd.append("\"");
    return _proc_run_cmd(&cmd, o, out);
}

int process_spawn(List<string>* argv, ProcessOptions* opts, Process* p) {
    let def: ProcessOptions;            // the defaults: every field zero
    ProcessOptions* o = opts != null ? opts : &def;
    _proc_flush_inherited(o);
    let cmd: String;
    cmd.init(64);
    defer cmd.free();
    _proc_cmdline(argv, &cmd);
    return _proc_start(&cmd, o, !o.inherit_stdin, false, p);
}

int Process_write_stdin(Process* p, string text) {
    if (p.hin == null) {
        return -1;
    }
    int64 off = 0;
    const int64 n = strlen(text);
    while (off < n) {
        const int64 chunk = n - off > 65536 ? 65536 : n - off;
        let put: uint32 = (uint32)0;
        if (WriteFile(p.hin, (*void)((*uint8)text + off), (uint32)chunk, &put, null) == 0) {
            return _fs_fail_os();
        }
        off += (int64)put;
    }
    return 0;
}

void Process_close_stdin(Process* p) {
    if (p.hin != null) {
        CloseHandle(p.hin);
        p.hin = null;
    }
}

int64 Process_read(Process* p, int stream, String* out) {
    *void h = stream == 2 ? p.herr : p.hout;
    if (h == null) {
        return -1;
    }
    *uint8 buf = alloc<uint8>(65536);
    defer free((*void)buf);
    let got: uint32 = (uint32)0;
    if (ReadFile(h, (*void)buf, (uint32)65536, &got, null) == 0) {
        if (GetLastError() == (uint32)109) {   // ERROR_BROKEN_PIPE: end of output
            return 0;
        }
        return (int64)_fs_fail_os();
    }
    _fs_append_bytes(out, buf, (int64)got);
    return (int64)got;
}

int Process_wait(Process* p) {
    if (p.exited) {
        return p.exit_code;
    }
    Process_close_stdin(p);
    WaitForSingleObject(p.hproc, (uint32)4294967295);
    let code: uint32 = (uint32)0;
    GetExitCodeProcess(p.hproc, &code);
    p.exit_code = (int)code;
    p.exited = true;
    return p.exit_code;
}

int Process_kill(Process* p) {
    if (p.exited) {
        return 0;
    }
    return TerminateProcess(p.hproc, (uint32)137) != 0 ? 0 : _fs_fail_os();
}

void Process_free(Process* p) {
    Process_close_stdin(p);
    if (p.hout != null) {
        CloseHandle(p.hout);
        p.hout = null;
    }
    if (p.herr != null) {
        CloseHandle(p.herr);
        p.herr = null;
    }
    if (p.hproc != null) {
        CloseHandle(p.hproc);
        p.hproc = null;
    }
}

#else
// ── POSIX ─────────────────────────────────────────────────────────────────

// Fork and exec argv. Pipes stdin when `pipe_in`, stdout/stderr unless
// inherited (stderr not when merged). `group` puts the child in its own
// process group (so a timeout can kill everything it started).
int _proc_start(List<string>* argv, ProcessOptions* o, bool pipe_in, bool group, Process* p) {
    p.pid = -1;
    p.exit_code = -1;
    p.exited = false;
    p.stdin_fd = -1;
    p.stdout_fd = -1;
    p.stderr_fd = -1;
    p.group = group;
    const int argc = List_len<string>(argv);
    if (argc == 0) {   // EINVAL
        _fs_err = 22;
        _fs_err_win = false;
        return -1;
    }
    int[2] in_p;
    in_p[0] = -1;
    in_p[1] = -1;
    int[2] out_p;
    out_p[0] = -1;
    out_p[1] = -1;
    int[2] err_p;
    err_p[0] = -1;
    err_p[1] = -1;
    int[2] st_p;
    st_p[0] = -1;
    st_p[1] = -1;
    int nul = -1;
    bool ok = _proc_pipe(&st_p[0]) == 0;
    if (ok && pipe_in) {
        ok = _proc_pipe(&in_p[0]) == 0;
    }
    if (ok && !pipe_in && !o.inherit_stdin) {
        nul = open("/dev/null", _PROC_O_CLOEXEC);
        ok = nul >= 0;
    }
    if (ok && !o.inherit_stdout) {
        ok = _proc_pipe(&out_p[0]) == 0;
    }
    if (ok && !o.merge_stderr && !o.inherit_stderr) {
        ok = _proc_pipe(&err_p[0]) == 0;
    }
    // Everything the child needs is built before fork: it only calls
    // async-signal-safe functions until exec.
    *string args = alloc<string>((int64)argc + 1);
    for (i in 0..argc) {
        args[i] = List_get<string>(argv, i);
    }
    let envs: List<String>;
    List_init<String>(&envs, 4);
    *string envp = null;
    if (ok && o.env != null && List_len<string>(o.env) > 0) {
        _proc_env_merge(o.env, &envs);
        const int ne = List_len<String>(&envs);
        envp = alloc<string>((int64)ne + 1);
        for (i in 0..ne) {
            envp[i] = (string)List_get<String>(&envs, i).data;
        }
    }
    int pid = -1;
    if (ok) {
        pid = fork();
        ok = pid >= 0;
    }
    if (!ok) {
        _fs_fail_os();
    }
    if (pid == 0) {
        if (in_p[0] >= 0) {
            _proc_dup_to(in_p[0], 0);
        }
        else if (nul >= 0) {
            _proc_dup_to(nul, 0);
        }
        if (out_p[1] >= 0) {
            _proc_dup_to(out_p[1], 1);
        }
        if (o.merge_stderr) {
            dup2(1, 2);
        }
        else if (err_p[1] >= 0) {
            _proc_dup_to(err_p[1], 2);
        }
        signal(_PROC_SIGPIPE, null);   // SIG_DFL: the parent may ignore SIGPIPE
        if (group) {
            setpgid(0, 0);
        }
        if (o.cwd == null || chdir(o.cwd) == 0) {
            if (envp != null) {
                _proc_set_environ(envp);
            }
            execvp(args[0], args);
        }
        int e = _fs_errno_now();
        write(st_p[1], (*void)&e, 4);
        _exit(127);
    }
    if (pid > 0 && group) {
        setpgid(pid, pid);
    }
    _proc_close(&st_p[1]);
    _proc_close(&in_p[0]);
    _proc_close(&out_p[1]);
    _proc_close(&err_p[1]);
    _proc_close(&nul);
    free((*void)args);
    free((*void)envp);
    fs_list_free(&envs);
    if (ok) {
        // Exec closes the status pipe (close-on-exec); a failed exec sends its errno.
        int e = 0;
        int64 n = -1;
        while (true) {
            n = read(st_p[0], (*void)&e, 4);
            if (n >= 0 || _fs_errno_now() != _PROC_EINTR) {
                break;
            }
        }
        if (n == 4) {
            int status = 0;
            waitpid(pid, &status, 0);
            _fs_err = e;
            _fs_err_win = false;
            ok = false;
        }
    }
    _proc_close(&st_p[0]);
    if (!ok) {
        _proc_close(&in_p[1]);
        _proc_close(&out_p[0]);
        _proc_close(&err_p[0]);
        return -1;
    }
    p.pid = pid;
    p.stdin_fd = in_p[1];
    p.stdout_fd = out_p[0];
    p.stderr_fd = err_p[0];
    return 0;
}

int _proc_decode(int status) {
    const int sig = status & 127;
    if (sig == 0) {
        return (status >> 8) & 255;
    }
    return 128 + sig;
}

// Only a child that started is signalled: kill(-1) would reach every process of the
// user and kill(0) the caller's own process group.
void _proc_kill(Process* p) {
    if (p.pid <= 0) {
        return;
    }
    if (p.group) {
        kill(-p.pid, _PROC_SIGKILL);
    }
    kill(p.pid, _PROC_SIGKILL);
}

// Reap the child; with a deadline (monotonic ms, 0 = none) kill it once the
// deadline passes and set *timed_out.
int _proc_reap(Process* p, int64 deadline, *bool timed_out) {
    int status = 0;
    if (p.pid <= 0) {             // never started: waitpid(-1) would reap any child
        p.exited = true;
        p.exit_code = -1;
        return -1;
    }
    while (true) {
        const int flags = deadline > 0 ? 1 : 0;   // WNOHANG while a deadline runs
        const int r = waitpid(p.pid, &status, flags);
        if (r == p.pid) {
            break;
        }
        if (r < 0 && _fs_errno_now() != _PROC_EINTR) {
            status = 0;
            break;
        }
        if (r == 0) {
            if (time_monotonic_ms() >= deadline) {
                _proc_kill(p);
                *timed_out = true;
                deadline = 0;
            } else {
                _c_poll(null, 0, 5);
            }
        }
    }
    p.exited = true;
    p.exit_code = _proc_decode(status);
    return p.exit_code;
}

int _proc_run(List<string>* argv, ProcessOptions* o, ProcessResult* r) {
    r.stdout.init(256);
    r.stderr.init(64);
    r.exit_code = -1;
    r.timed_out = false;
    let p: Process;
    bool group = o.timeout_ms > 0;
#ifndef _WIN32
    // A child in its own process group is in the background for the terminal,
    // so reading the inherited terminal would stop it (SIGTTIN): keep it in ours.
    if (o.inherit_stdin && isatty(0) == 1) {
        group = false;
    }
#endif
    if (_proc_start(argv, o, o.stdin_text != null, group, &p) != 0) {
        return -1;
    }
    int64 deadline = o.timeout_ms > 0 ? time_monotonic_ms() + o.timeout_ms : 0;
    bool killed = false;
    const string text = o.stdin_text;
    const int64 tlen = text != null ? strlen(text) : 0;
    int64 toff = 0;
    if (p.stdin_fd >= 0) {
        if (tlen == 0) {
            _proc_close(&p.stdin_fd);
        }
        else {
            fcntl(p.stdin_fd, _PROC_F_SETFL, fcntl(p.stdin_fd, _PROC_F_GETFL) | _PROC_O_NONBLOCK);
        }
    }
    *uint8 buf = alloc<uint8>(65536);
    _proc_pollfd[3] fds;
    while (p.stdin_fd >= 0 || p.stdout_fd >= 0 || p.stderr_fd >= 0) {
        int nf = 0;
        int i_in = -1;
        int i_out = -1;
        int i_err = -1;
        if (p.stdin_fd >= 0) {
            i_in = nf;
            fds[nf].fd = p.stdin_fd;
            fds[nf].events = (int16)4;
            nf++;
        }
        if (p.stdout_fd >= 0) {
            i_out = nf;
            fds[nf].fd = p.stdout_fd;
            fds[nf].events = (int16)1;
            nf++;
        }
        if (p.stderr_fd >= 0) {
            i_err = nf;
            fds[nf].fd = p.stderr_fd;
            fds[nf].events = (int16)1;
            nf++;
        }
        for (k in 0..nf) {
            fds[k].revents = (int16)0;
        }
        int wait_ms = -1;
        if (deadline > 0) {
            const int64 left = deadline - time_monotonic_ms();
            wait_ms = left <= 0 ? 0 : (left > 1000000 ? 1000000 : (int)left);
        }
        const int pr = _c_poll((*void)&fds[0], nf, wait_ms);
        if (pr < 0) {
            if (_fs_errno_now() == _PROC_EINTR) {
                continue;
            }
            break;
        }
        if (pr == 0) {
            if (killed) {   // the grace period after the kill ran out
                break;
            }
            // The child exited in time and something it started still holds the
            // pipes open: that is the child's result, not a timeout. Stop reading
            // and leave the descendants alone.
            int st = 0;
            if (waitpid(p.pid, &st, 1) == p.pid) {   // WNOHANG
                p.exited = true;
                p.exit_code = _proc_decode(st);
                break;
            }
            _proc_kill(&p);
            killed = true;
            r.timed_out = true;
            deadline = time_monotonic_ms() + 2000;   // drain what is left, briefly
            continue;
        }
        if (i_in >= 0 && fds[i_in].revents != (int16)0) {
            const int64 chunk = tlen - toff > 65536 ? 65536 : tlen - toff;
            const int64 w = _proc_write_nosig(p.stdin_fd, (*void)((*uint8)text + toff), chunk);
            if (w > 0) {
                toff += w;
            }
            else if (w < 0 && _fs_errno_now() != _PROC_EAGAIN && _fs_errno_now() != _PROC_EINTR) {
                toff = tlen;
            }
            if (toff >= tlen) {
                _proc_close(&p.stdin_fd);
            }
        }
        if (i_out >= 0 && fds[i_out].revents != (int16)0) {
            const int64 n = read(p.stdout_fd, (*void)buf, 65536);
            if (n > 0) {
                _fs_append_bytes(&r.stdout, buf, n);
            }
            else if (n == 0 || _fs_errno_now() != _PROC_EINTR) {
                _proc_close(&p.stdout_fd);
            }
        }
        if (i_err >= 0 && fds[i_err].revents != (int16)0) {
            const int64 n = read(p.stderr_fd, (*void)buf, 65536);
            if (n > 0) {
                _fs_append_bytes(&r.stderr, buf, n);
            }
            else if (n == 0 || _fs_errno_now() != _PROC_EINTR) {
                _proc_close(&p.stderr_fd);
            }
        }
    }
    free((*void)buf);
    _proc_close(&p.stdin_fd);
    _proc_close(&p.stdout_fd);
    _proc_close(&p.stderr_fd);
    bool late = false;
    if (!p.exited) {
        _proc_reap(&p, killed ? 0 : deadline, &late);
    }
    if (late) {
        r.timed_out = true;
    }
    r.exit_code = r.timed_out ? 137 : p.exit_code;
    return 0;
}

// Run argv[0] with arguments argv (PATH lookup, no shell) and collect its
// output into `out` (see the top of the file). opts may be null. 0 if the
// program ran, -1 if it could not be started.
int process_run(List<string>* argv, ProcessOptions* opts, ProcessResult* out) {
    let def: ProcessOptions;            // the defaults: every field zero
    ProcessOptions* o = opts != null ? opts : &def;
    _proc_flush_inherited(o);
    return _proc_run(argv, o, out);
}

// Run `command` through the shell (/bin/sh -c, or cmd.exe /c on Windows), like
// process_run with options.
int sh_with(string command, ProcessOptions* opts, ProcessResult* out) {
    let argv: List<string>;
    List_init<string>(&argv, 3);
    defer List_free<string>(&argv);
    List_push<string>(&argv, "/bin/sh");
    List_push<string>(&argv, "-c");
    List_push<string>(&argv, command);
    return process_run(&argv, opts, out);
}

// Start argv and return at once; stdin is a pipe unless opts.inherit_stdin,
// stdout/stderr are pipes unless inherited (stdin_text and timeout_ms are not
// used). 0, or -1 if it could not be started.
int process_spawn(List<string>* argv, ProcessOptions* opts, Process* p) {
    let def: ProcessOptions;            // the defaults: every field zero
    ProcessOptions* o = opts != null ? opts : &def;
    _proc_flush_inherited(o);
    return _proc_start(argv, o, !o.inherit_stdin, false, p);
}

// Write all of `text` to the child's stdin (blocking). 0, or -1 (no pipe, or
// the child closed its end).
int Process_write_stdin(Process* p, string text) {
    if (p.stdin_fd < 0) {
        return -1;
    }
    const int64 n = strlen(text);
    int64 off = 0;
    int rc = 0;
    while (off < n) {
        const int64 w = _proc_write_nosig(p.stdin_fd, (*void)((*uint8)text + off), n - off);
        if (w > 0) {
            off += w;
            continue;
        }
        if (w < 0 && _fs_errno_now() == _PROC_EINTR) {
            continue;
        }
        rc = _fs_fail_os();
        break;
    }
    return rc;
}

// Close the child's stdin so it sees end of input.
void Process_close_stdin(Process* p) {
    _proc_close(&p.stdin_fd);
}

// Read what the child wrote to stdout (stream 1) or stderr (stream 2), up to
// 64 KiB, appending it to `out`; blocks until some is available. The byte
// count, 0 at end of output, or -1 (no such pipe, or an error).
int64 Process_read(Process* p, int stream, String* out) {
    const int fd = stream == 2 ? p.stderr_fd : p.stdout_fd;
    if (fd < 0) {
        return -1;
    }
    *uint8 buf = alloc<uint8>(65536);
    defer free((*void)buf);
    while (true) {
        const int64 n = read(fd, (*void)buf, 65536);
        if (n >= 0) {
            _fs_append_bytes(out, buf, n);
            return n;
        }
        if (_fs_errno_now() != _PROC_EINTR) {
            return (int64)_fs_fail_os();
        }
    }
    return -1;
}

// Close stdin, wait for the child to end and return its exit code (as in
// ProcessResult). Calling it again returns the same code.
int Process_wait(Process* p) {
    if (p.exited) {
        return p.exit_code;
    }
    Process_close_stdin(p);
    let unused: bool = false;
    return _proc_reap(p, 0, &unused);
}

// Kill the child (SIGKILL; TerminateProcess on Windows). Reap it with
// Process_wait. 0, or -1.
int Process_kill(Process* p) {
    if (p.exited) {
        return 0;
    }
    if (p.pid <= 0) {             // never started (see _proc_kill)
        return -1;
    }
    return kill(p.pid, _PROC_SIGKILL) == 0 ? 0 : _fs_fail_os();
}

// Close the pipe handles (does not wait for or kill the child).
void Process_free(Process* p) {
    _proc_close(&p.stdin_fd);
    _proc_close(&p.stdout_fd);
    _proc_close(&p.stderr_fd);
}
#endif

// Read the child's stream to its end into `out`. Returns the bytes read, or -1.
int64 Process_read_all(Process* p, int stream, String* out) {
    int64 total = 0;
    while (true) {
        const int64 n = Process_read(p, stream, out);
        if (n < 0) {
            return -1;
        }
        if (n == 0) {
            return total;
        }
        total += n;
    }
    return total;
}

// Run `command` through the shell with default options (capture both streams).
int sh(string command, ProcessResult* out) {
    return sh_with(command, null, out);
}

// ── Result forms ───────────────────────────────────────────────────────────

// process_run as a Result: the finished process (whatever its exit code), or an error
// when it could not be started; process_last_error gives the reason. Free the result
// with ProcessResult_free.
Result<ProcessResult, string> process_run_result(List<string>* argv, ProcessOptions* opts) {
    let r: ProcessResult;
    if (process_run(argv, opts, &r) != 0) {
        ProcessResult_free(&r);
        return Err<ProcessResult, string>("the command could not be started");
    }
    return Ok<ProcessResult, string>(r);
}

// sh as a Result, like process_run_result.
Result<ProcessResult, string> sh_result(string command) {
    let r: ProcessResult;
    if (sh(command, &r) != 0) {
        ProcessResult_free(&r);
        return Err<ProcessResult, string>("the command could not be started");
    }
    return Ok<ProcessResult, string>(r);
}
