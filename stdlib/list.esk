// List<T> — growable dynamic array.
// Capacity doubles on overflow; element-by-element copy avoids needing sizeof.

import <mem>;

struct List<T> {
    *T data;
    int size;
    int cap;
}

void List_init<T>(List<T>* self, int initial_cap) {
    const int cap = initial_cap < 4 ? 4 : initial_cap;
    self.data = alloc<T>(cap);
    self.size = 0;
    self.cap = cap;
}

void List_push<T>(List<T>* self, T item) {
    if (self.size >= self.cap) {
        const int new_cap = self.cap * 2 < 4 ? 4 : self.cap * 2;
        let new_data: *T = alloc<T>(new_cap);
        for (i in 0..self.size) {
            new_data[i] = self.data[i];
        }
        free(self.data);
        self.data = new_data;
        self.cap = new_cap;
    }
    self.data[self.size] = item;
    self.size++;
}

T List_get<T>(List<T>* self, int i) {
    return self.data[i];
}

void List_set<T>(List<T>* self, int i, T item) {
    self.data[i] = item;
}

// Make room for at least n elements without changing the size.
void List_reserve<T>(List<T>* self, int n) {
    if (n <= self.cap) {
        return;
    }
    let new_data: *T = alloc<T>(n);
    for (i in 0..self.size) {
        new_data[i] = self.data[i];
    }
    free(self.data);
    self.data = new_data;
    self.cap = n;
}

// Set the size to n. Elements past the old size are zero: in generic code a declared T
// starts at zero, field defaults included, so a struct with field defaults comes back
// zeroed, not as T{}.
void List_resize<T>(List<T>* self, int n) {
    if (n < 0) {
        n = 0;
    }
    if (n > self.cap) {
        List_reserve<T>(self, n > self.cap * 2 ? n : self.cap * 2);
    }
    for (i in self.size..n) {
        T fresh;
        self.data[i] = fresh;
    }
    self.size = n;
}

// Make self a copy of src's elements (copied by value; self's old elements are dropped).
void List_copy_from<T>(List<T>* self, List<T>* src) {
    List_reserve<T>(self, src.size);
    for (i in 0..src.size) {
        self.data[i] = src.data[i];
    }
    self.size = src.size;
}

// Remove the element at index i, shifting the tail down one slot. Out-of-range
// indices are ignored. O(n) in the number of trailing elements.
void List_remove<T>(List<T>* self, int i) {
    if (i < 0 || i >= self.size) {
        return;
    }
    for (int j = i; j + 1 < self.size; j++) {
        self.data[j] = self.data[j + 1];
    }
    self.size--;
}

int List_len<T>(List<T>* self) {
    return self.size;
}

// Leaves an empty list: push after free regrows it, and a second free is a no-op.
void List_free<T>(List<T>* self) {
    free(self.data);
    self.data = null;
    self.size = 0;
    self.cap = 0;
}

// ── Scripting helpers ─────────────────────────────────────────────────────────
//
// Callbacks: a predicate or mapper takes the element by value (`fn(T)->bool`,
// `fn(T)->U`), so a lambda reads naturally; an equality takes two pointers and
// returns 1 or 0 (`fn(*T, *T)->int`), the shape HashMap and <sort> use, so
// `int_eq` from <map> fits. A function that builds a list appends to `out`, a
// List the caller initialised and frees. Elements are copied by value: a list of
// pointers or Strings shares what they point to.

// Remove every element, keeping the buffer.
void List_clear<T>(List<T>* self) {
    self.size = 0;
}

// Remove and return the last element. On an empty list it returns a zeroed T
// and leaves the list as it is.
T List_pop<T>(List<T>* self) {
    if (self.size <= 0) {
        let z: *T = alloc<T>(1);
        const T v = z[0];
        free(z);
        return v;
    }
    self.size--;
    return self.data[self.size];
}

// Insert `item` before index i, shifting the tail up. An index past the end
// appends; a negative one inserts at the front.
void List_insert<T>(List<T>* self, int i, T item) {
    if (i < 0) {
        i = 0;
    }
    if (i > self.size) {
        i = self.size;
    }
    List_push<T>(self, item);
    for (int j = self.size - 1; j > i; j--) {
        self.data[j] = self.data[j - 1];
    }
    self.data[i] = item;
}

// Reverse the order of the elements, in place.
void List_reverse<T>(List<T>* self) {
    int i = 0;
    int j = self.size - 1;
    while (i < j) {
        const T t = self.data[i];
        self.data[i] = self.data[j];
        self.data[j] = t;
        i++;
        j--;
    }
}

// Append the elements in [start, end) to `out`. Indices are clamped to the list,
// so an empty or reversed range appends nothing.
void List_slice<T>(List<T>* self, int start, int end, List<T>* out) {
    if (start < 0) {
        start = 0;
    }
    if (end > self.size) {
        end = self.size;
    }
    for (int i = start; i < end; i++) {
        List_push<T>(out, self.data[i]);
    }
}

// Append f(x) for every element x to `out`, in order.
void List_map<T, U>(List<T>* self, fn(T)->U f, List<U>* out) {
    for (i in 0..self.size) {
        List_push<U>(out, f(self.data[i]));
    }
}

// Append every element for which `keep` returns true to `out`, in order.
void List_filter<T>(List<T>* self, fn(T)->bool keep, List<T>* out) {
    for (i in 0..self.size) {
        if (keep(self.data[i])) {
            List_push<T>(out, self.data[i]);
        }
    }
}

// Fold left: acc = f(acc, x) for every element, starting from `init`.
A List_reduce<T, A>(List<T>* self, A init, fn(A, T)->A f) {
    A acc = init;
    for (i in 0..self.size) {
        acc = f(acc, self.data[i]);
    }
    return acc;
}

// Index of the first element for which `pred` is true, or -1.
int List_find<T>(List<T>* self, fn(T)->bool pred) {
    for (i in 0..self.size) {
        if (pred(self.data[i])) {
            return i;
        }
    }
    return -1;
}

// 1 if `pred` is true for some element, else 0 (0 on an empty list).
int List_any<T>(List<T>* self, fn(T)->bool pred) {
    return List_find<T>(self, pred) >= 0 ? 1 : 0;
}

// 1 if `pred` is true for every element, else 0 (1 on an empty list).
int List_all<T>(List<T>* self, fn(T)->bool pred) {
    for (i in 0..self.size) {
        if (!pred(self.data[i])) {
            return 0;
        }
    }
    return 1;
}

// Index of the first element equal to `item` under `eq`, or -1.
int List_index_of<T>(List<T>* self, T item, fn(*T, *T)->int eq) {
    for (i in 0..self.size) {
        if (eq(&self.data[i], &item) == 1) {
            return i;
        }
    }
    return -1;
}

// 1 if some element equals `item` under `eq`, else 0.
int List_contains<T>(List<T>* self, T item, fn(*T, *T)->int eq) {
    return List_index_of<T>(self, item, eq) >= 0 ? 1 : 0;
}

// Drop every element equal (under `eq`) to an earlier one, in place, keeping
// the first occurrences in order. O(n^2) comparisons.
void List_unique<T>(List<T>* self, fn(*T, *T)->int eq) {
    int kept = 0;
    for (i in 0..self.size) {
        int dup = 0;
        for (int j = 0; j < kept && dup == 0; j++) {
            if (eq(&self.data[j], &self.data[i]) == 1) {
                dup = 1;
            }
        }
        if (dup == 0) {
            self.data[kept] = self.data[i];
            kept++;
        }
    }
    self.size = kept;
}
