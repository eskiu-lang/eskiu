// http.esk — a small HTTP/1.1 stack: request parser, response builder, and a
// threaded worker pool, built on <net> + <threading>.
//
//   import <http>;
//   void hello(HttpRequest* req, HttpResponse* res) {
//       HttpResponse_header(res, "Content-Type", "text/plain");
//       HttpResponse_set_body(res, "Hello from Eskiu\n");
//   }
//   int main() { http_serve(8080, 4, hello); return 0; }   // 4 worker threads

import <mem>;
import <string>;
import <net>;
import <time>;
import <threading>;
import <bytes>;

// ── Request (parsed) ─────────────────────────────────────────────────────────

struct HttpRequest {
    String method;    // "GET"
    String path;      // "/index.html"
    String version;   // "HTTP/1.1"
    String headers;   // raw block, one "Key: Value" per line (\n-separated)
    String body;
}

void HttpRequest_init(HttpRequest* self) {
    self.method.init(8);
    self.path.init(32);
    self.version.init(16);
    self.headers.init(128);
    self.body.init(64);
}

void HttpRequest_free(HttpRequest* self) {
    self.method.free();
    self.path.free();
    self.version.free();
    self.headers.free();
    self.body.free();
}

// 1 if buf[pos..pos+2) is a CRLF within the first `len` bytes.
int _http_crlf_at(*uint8 buf, int pos, int len) {
    return (pos + 1 < len && buf[pos] == '\r' && buf[pos + 1] == '\n') ? 1 : 0;
}

// 1 if `c` is a CR or LF byte (a line break may only appear as CRLF).
int _http_is_crlf_byte(uint8 c) {
    return (c == '\r' || c == '\n') ? 1 : 0;
}

// 1 if `c` is a token character (RFC 9110 §5.6.2 tchar): a header name or a
// method is one or more of these.
int _http_is_tchar(uint8 c) {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
        return 1;
    }
    switch (c) {
        case '!': case '#': case '$': case '%': case '&': case '\'': case '*': case '+':
        case '-': case '.': case '^': case '_': case '`': case '|': case '~':
        return 1;
    }
    return 0;
}

// The HTTP-version in b[from..to) ("HTTP/" DIGIT "." DIGIT, RFC 9112 §2.3) as
// major * 10 + minor, or -1 if it is not one.
int _http_parse_version(*uint8 b, int from, int to) {
    if (to - from != 8) {
        return -1;
    }
    if (b[from] != 'H' || b[from + 1] != 'T' || b[from + 2] != 'T' || b[from + 3] != 'P' || b[from + 4] != '/') {
        return -1;
    }
    const uint8 ma = b[from + 5];
    const uint8 mi = b[from + 7];
    if (ma < '0' || ma > '9' || b[from + 6] != '.' || mi < '0' || mi > '9') {
        return -1;
    }
    return ((int)ma - '0') * 10 + ((int)mi - '0');
}

// 1 if every line of a "Key: Value\n" block is a field line: a token name
// directly followed by ':'. Whitespace before the colon (RFC 9112 §5.1) and a
// line starting with SP/HTAB, an obsolete line fold (§5.2), are rejected, and
// so is a NUL in a field value (RFC 9110 §5.5: a lookup would stop at it).
int _http_headers_valid(String* headers) {
    const int64 n = headers.len;
    int64 i = 0;
    while (i < n) {
        int64 j = i;
        while (j < n && _http_is_tchar((uint8)headers.data[j]) == 1) {
            j++;
        }
        if (j == i || j >= n || headers.data[j] != ':') {
            return 0;
        }
        while (i < n && headers.data[i] != '\n') {
            if (headers.data[i] == 0) {
                return 0;
            }
            i++;
        }
        i++;
    }
    return 1;
}

// Number of header lines named `name` (case-insensitive) in a "Key: Value\n" block.
int _http_header_count(String* headers, string name) {
    const int64 n = headers.len;
    int64 i = 0;
    int count = 0;
    while (i < n) {
        int64 j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || _http_lc(headers.data[i + j]) != _http_lc(name[j])) {
                matched = false;
                break;
            }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            count++;
        }
        while (i < n && headers.data[i] != '\n') {
            i++;
        }
        i++;
    }
    return count;
}

// Transfer-Encoding of a request (RFC 9112 §6.1, §6.3): 0 if there is none, 1
// if it is exactly "chunked" (the only coding supported), 400 if chunked is not
// the final coding or appears twice (the length cannot be determined), 501 for
// any other coding. Every Transfer-Encoding line and list member counts.
int _http_transfer_encoding(String* headers) {
    const string name = "transfer-encoding";
    const int64 n = headers.len;
    int64 i = 0;
    int codings = 0;
    int chunked = 0;
    bool last_chunked = false;
    bool other = false;
    bool present = false;
    while (i < n) {
        int64 j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || _http_lc(headers.data[i + j]) != _http_lc(name[j])) {
                matched = false;
                break;
            }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            present = true;
            int64 k = i + j + 1;
            while (true) {
                let item: String;
                item.init(16);
                while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) {
                    k++;
                }
                for (; k < n && headers.data[k] != ',' && headers.data[k] != '\n'; k++) {
                    item.push(_http_lc(headers.data[k]));
                }
                _http_trim_ows_tail(&item);
                if (item.len > 0) {
                    codings++;
                    last_chunked = String_eq_cstr(&item, "chunked") == 1;
                    if (last_chunked) {
                        chunked++;
                    } else {
                        other = true;
                    }
                }
                item.free();
                if (k >= n || headers.data[k] != ',') {
                    break;
                }
                k++;
            }
        }
        while (i < n && headers.data[i] != '\n') {
            i++;
        }
        i++;
    }
    if (!present) {
        return 0;
    }
    if (codings == 0 || chunked > 1 || !last_chunked) {
        return 400;
    }
    if (other) {
        return 501;
    }
    return 1;
}

// 1 if `c` may appear in a reg-name or IP-literal of a Host (RFC 3986 §3.2.2:
// unreserved, sub-delims, and the '%' of a pct-encoded byte). A ',' is not
// accepted: in a Host it only comes from two values joined into a list.
int _http_host_char(uint8 c) {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
        return 1;
    }
    switch (c) {
        case '-': case '.': case '_': case '~': case '%':
        case '!': case '$': case '&': case '\'': case '(': case ')': case '*': case '+': case ';': case '=':
        return 1;
    }
    return 0;
}

// 1 if the request's Host value is uri-host [ ":" port ] (RFC 9110 §7.2): a
// reg-name or IPv4 address, or an IP-literal in brackets, then an optional
// port of digits. An empty Host is allowed (§7.2: a target without an
// authority). Whitespace, a list ("a, b") or any other byte is rejected.
int _http_host_valid(String* headers) {
    let v: String;
    v.init(32);
    defer v.free();
    if (_http_header_lookup(headers, "host", &v) == 0) {
        return 0;
    }
    const int64 n = v.len;
    int64 i = 0;
    if (n > 0 && v.data[0] == '[') {
        i = 1;
        while (i < n && v.data[i] != ']' && (_http_host_char((uint8)v.data[i]) == 1 || v.data[i] == ':')) {
            i++;
        }
        if (i >= n || v.data[i] != ']' || i == 1) {
            return 0;
        }
        i++;
    } else {
        while (i < n && _http_host_char((uint8)v.data[i]) == 1) {
            if (v.data[i] == '%') {           // pct-encoded: '%' HEXDIG HEXDIG
                if (i + 2 >= n || _http_hex_digit((uint8)v.data[i + 1]) < 0 || _http_hex_digit((uint8)v.data[i + 2]) < 0) {
                    return 0;
                }
                i += 2;
            }
            i++;
        }
    }
    if (i < n && v.data[i] == ':') {
        i++;
        while (i < n && v.data[i] >= '0' && v.data[i] <= '9') {
            i++;
        }
    }
    return i == n ? 1 : 0;
}

// Checks shared by both request parsers once the head is split into lines:
// the version (1.x, else 505), field-line syntax, a single Host (required in
// HTTP/1.1, RFC 9112 §3.2), and the framing headers. Returns 0 if the request
// has a Content-Length body or none, 1 if its body is chunked, or an error
// status (400 / 501 / 505).
int _http_check_head(String* headers, int version) {
    if (version / 10 != 1) {
        return 505;
    }
    if (_http_headers_valid(headers) == 0) {
        return 400;
    }
    const int hosts = _http_header_count(headers, "host");
    if (hosts > 1 || (hosts == 0 && version >= 11)) {
        return 400;
    }
    if (hosts == 1 && _http_host_valid(headers) == 0) {
        return 400;
    }
    const int te = _http_transfer_encoding(headers);
    if (te == 0) {
        return 0;
    }
    // Transfer-Encoding with Content-Length is a smuggling vector (§6.3), and an
    // HTTP/1.0 message with Transfer-Encoding has faulty framing (§6.1).
    if (_http_header_count(headers, "content-length") > 0 || version < 11) {
        return 400;
    }
    return te;
}

int _http_hex_digit(uint8 c) {
    if (c >= '0' && c <= '9') {
        return (int)c - '0';
    }
    if (c >= 'a' && c <= 'f') {
        return (int)c - 'a' + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return (int)c - 'A' + 10;
    }
    return -1;
}

// Growable binary output of the chunked decoder (start zeroed; free `data`).
struct HttpChunkOut {
    *uint8 data;
    int64 len;
    int64 cap;
}

// Longest chunk-size line (with its extensions) or trailer line the chunked
// decoder waits for; a longer one is malformed. It bounds the bytes rescanned
// each time more input arrives.
const int HTTP_CHUNK_LINE_MAX = 8192;

// Largest trailer section (after the last chunk) a reader that drops consumed
// input (_http_chunked_feed) takes; a longer one is malformed.
const int HTTP_CHUNK_TRAILER_MAX = 65536;

// 0 (wait for more input) while the unfinished line starting at `from` in
// b[..n) is within HTTP_CHUNK_LINE_MAX, else -1. A complete line is held to
// the same limit (CRLF included), so the verdict does not depend on how the
// input was split into reads.
int _http_chunk_wait(int64 from, int64 n) {
    return n - from > HTTP_CHUNK_LINE_MAX ? -1 : 0;
}

// Decode the complete chunks of a chunked body (RFC 9112 §7.1) in b[*pos..n),
// appending their data to `out` (at most `max` bytes in total). *pos advances
// past each complete chunk, so a caller that receives more input calls again
// with the same state. Returns 1 once the last chunk and the trailer section
// (discarded) are consumed, with *pos just past the body; 0 if more input is
// needed; -1 if the body is malformed (also a chunk-size or trailer line
// longer than HTTP_CHUNK_LINE_MAX); -2 if it exceeds `max`.
int http_chunked_step(*uint8 b, int64 n, *int64 pos, HttpChunkOut* out, int64 max) {
    return _http_chunked_run(b, n, pos, out, max, null);
}

// http_chunked_step, plus: with a non-null `trailer` (start it at 0), *pos
// also advances past the last chunk and each complete trailer line, and
// *trailer becomes 1 in the trailer section, so a caller that feeds more
// input never rescans what was consumed. On reaching the trailer section it
// returns 2 (call again), so the caller sees where that section starts.
int _http_chunked_run(*uint8 b, int64 n, *int64 pos, HttpChunkOut* out, int64 max, *int trailer) {
    int64 p = *pos;
    while (trailer == null || *trailer == 0) {
        int64 size = 0;
        int64 q = p;
        while (q < n && _http_hex_digit(b[q]) >= 0) {
            const int64 d = _http_hex_digit(b[q]);
            if (size > (9223372036854775807 - d) / 16) {
                return -1;
            }
            size = size * 16 + d;
            q++;
        }
        if (q >= n) {
            return _http_chunk_wait(p, n);
        }
        if (q == p) {
            return -1;
        }
        // chunk-ext: BWS ";" ... up to the line end (extensions are ignored).
        int64 e = q;
        while (e < n && (b[e] == ' ' || b[e] == '\t')) {
            e++;
        }
        if (e >= n) {
            return _http_chunk_wait(p, n);
        }
        if (b[e] == ';') {
            while (e < n && _http_is_crlf_byte(b[e]) == 0) {
                e++;
            }
            q = e;
        }
        if (q + 1 >= n) {
            return _http_chunk_wait(p, n);
        }
        if (b[q] != '\r' || b[q + 1] != '\n') {
            return -1;
        }
        q += 2;
        if (q - p > HTTP_CHUNK_LINE_MAX) {
            return -1;
        }
        if (size == 0) {
            p = q;
            if (trailer != null) {
                *trailer = 1;
                *pos = p;
                return 2;
            }
            break;
        }
        if (size > max - out.len) {
            return -2;
        }
        if (n - q - 2 < size) {                  // not size + 2: it overflows near INT64_MAX
            if (n - q > size && b[q + size] != '\r') {
                return -1;
            }
            return 0;
        }
        if (b[q + size] != '\r' || b[q + size + 1] != '\n') {
            return -1;
        }
        if (out.len + size > out.cap) {
            int64 nc = out.cap < 256 ? 256 : out.cap;
            while (nc < out.len + size) {
                nc *= 2;
            }
            *uint8 nd = alloc<uint8>(nc);
            if (out.len > 0) {
                memcpy(nd, out.data, out.len);
            }
            if (out.data != null) {
                free(out.data);
            }
            out.data = nd;
            out.cap = nc;
        }
        memcpy(out.data + out.len, b + q, size);
        out.len += size;
        p = q + size + 2;
        *pos = p;
    }
    // Trailer section: field lines up to a blank line.
    while (true) {
        if (p + 1 >= n) {
            return 0;
        }
        if (b[p] == '\r') {
            if (b[p + 1] != '\n') {
                return -1;
            }
            *pos = p + 2;
            return 1;
        }
        int64 q = p;
        while (q < n && _http_is_tchar(b[q]) == 1) {
            q++;
        }
        if (q >= n) {
            return _http_chunk_wait(p, n);
        }
        if (q == p || b[q] != ':') {
            return -1;
        }
        while (q < n && _http_is_crlf_byte(b[q]) == 0) {
            q++;
        }
        if (q + 1 >= n) {
            return _http_chunk_wait(p, n);
        }
        if (b[q] != '\r' || b[q + 1] != '\n') {
            return -1;
        }
        if (q + 2 - p > HTTP_CHUNK_LINE_MAX) {
            return -1;
        }
        p = q + 2;
        if (trailer != null) {
            *pos = p;
        }
    }
    return -1;
}

// _http_chunked_run on b[..*n) for a reader that keeps the buffer small: when
// more input is needed, the consumed bytes b[base..*pos) are dropped (the rest
// moves down to `base`, *n and *pos follow), so the buffer holds only the
// unfinished line or chunk however many chunks and trailer lines went by.
// *tbytes (start it at 0) counts the trailer bytes consumed; past
// HTTP_CHUNK_TRAILER_MAX the body is malformed (-1). Same results otherwise.
int _http_chunked_feed(*uint8 b, *int64 n, *int64 pos, int64 base, HttpChunkOut* out, int64 max, *int trailer, *int64 tbytes) {
    int st = 2;
    while (st == 2) {
        const int64 p0 = *pos;
        const int t0 = *trailer;
        st = _http_chunked_run(b, *n, pos, out, max, trailer);
        if (t0 == 1) {
            *tbytes += *pos - p0;
        }
    }
    if (st >= 0 && *tbytes > HTTP_CHUNK_TRAILER_MAX) {
        return -1;
    }
    if (st != 0) {
        return st;
    }
    if (*pos > base) {
        memmove(b + base, b + *pos, *n - *pos);
        *n -= *pos - base;
        *pos = base;
    }
    return 0;
}

// The message-body framing of a request whose head is parsed (RFC 9112 §6):
// 0 for a Content-Length body, with its length in *clen (0 when there is no
// Content-Length), 1 for a chunked body, or the error status: 400 for an
// invalid, repeated-and-differing or combined framing header, a bad Host or
// field line, 413 for a Content-Length above `max_body`, 501 for a coding
// other than chunked, 505 for an HTTP major version other than 1. Shared by
// http_recv and HttpRequest_parse_status.
int _http_body_framing(String* headers, int version, int64 max_body, *int64 clen) {
    *clen = 0;
    const int framing = _http_check_head(headers, version);
    if (framing != 0) {
        return framing;
    }
    const int64 cl = _http_content_length(headers);
    if (cl == -1) {
        return 400;
    }
    if (cl > max_body) {
        return 413;
    }
    if (cl > 0) {
        *clen = cl;
    }
    return 0;
}

void _http_request_clear(HttpRequest* self) {
    self.method.clear();
    self.path.clear();
    self.version.clear();
    self.headers.clear();
    self.body.clear();
}

// Parse the head buf[0..hend) (`hend` just past the blank line) into the
// cleared `self`: the body framing of _http_body_framing (0 with the
// Content-Length in *clen, 1 for chunked), or 400 for a malformed head.
int _http_request_head(HttpRequest* self, *uint8 buf, int hend, int64 max_body, *int64 clen) {
    *clen = 0;
    int version = 0;
    if (_http_parse_head_into(&self.method, &self.path, &self.version, &self.headers, buf, hend, &version) == 0) {
        return 400;
    }
    return _http_body_framing(&self.headers, version, max_body, clen);
}

// Parse the request in buf[0..len) into self (its fields are cleared first).
// *need is set to the total byte count the request needs once its head and
// Content-Length are known (else 0), so a reader can wait for that much
// before calling again. Returns 0 when the request is complete, -1 when more
// bytes are needed (the head has no blank line yet, or the body is short), or
// the error status (400, 413, 501, 505; see _http_body_framing). Bytes past
// the end of the request are ignored.
int _http_request_parse(HttpRequest* self, *uint8 buf, int len, int64 max_body, *int64 need) {
    *need = 0;
    _http_request_clear(self);
    const int hend = _http_idx_header_end(buf, len);
    if (hend < 0) {
        return -1;
    }
    int64 clen = 0;
    const int framing = _http_request_head(self, buf, hend, max_body, &clen);
    if (framing > 1) {
        return framing;
    }
    if (framing == 1) {
        let out: HttpChunkOut;
        out.data = null;
        out.len = 0;
        out.cap = 0;
        int64 bpos = hend;
        const int st = http_chunked_step(buf, len, &bpos, &out, max_body);
        if (st == 1) {
            for (i in 0..out.len) {
                self.body.push((char)out.data[i]);
            }
        }
        if (out.data != null) {
            free(out.data);
        }
        if (st == 1) {
            return 0;
        }
        if (st == 0) {
            return -1;
        }
        return st == -2 ? 413 : 400;
    }
    *need = (int64)hend + clen;
    if ((int64)len < *need) {
        return -1;
    }
    for (int64 i = 0; i < clen; i++) {
        self.body.push((char)buf[hend + i]);
    }
    return 0;
}

// Parse the request in buf[0..len) into self, framed by RFC 9112 like
// http_recv: returns 0 when it is complete, -1 when more bytes are needed
// (the head has no blank line yet, a body is shorter than its Content-Length
// or a chunked body has no last chunk), or the HTTP error status: 400 for a
// malformed request (a method that is not a token, an empty path, a line
// break that is not CRLF, a malformed field line, a missing, repeated or
// invalid Host, an invalid or conflicting Content-Length, Transfer-Encoding
// with Content-Length, a malformed chunked body), 413 for a body above
// `max_body`, 501 for a transfer coding other than chunked, 505 for an HTTP
// major version other than 1. The body is exactly the Content-Length bytes or
// the decoded chunks.
int HttpRequest_parse_status(HttpRequest* self, *uint8 buf, int len, int64 max_body) {
    int64 need = 0;
    return _http_request_parse(self, buf, len, max_body, &need);
}

// Parse a raw request from `buf` (len bytes): 1 if it holds one complete,
// well-formed request (HttpRequest_parse_status returns 0), else 0 (a
// malformed request, or one cut short).
int HttpRequest_parse(HttpRequest* self, *uint8 buf, int len) {
    return HttpRequest_parse_status(self, buf, len, len) == 0 ? 1 : 0;
}

// Drop trailing optional whitespace (SP / HTAB, plus a stray CR) from a header
// value just copied into `out` (RFC 9110 §5.5: OWS around a field value is not
// part of it).
void _http_trim_ows_tail(String* out) {
    while (out.len > 0) {
        const char c = out.data[out.len - 1];
        if (c != ' ' && c != '\t' && c != '\r') {
            return;
        }
        out.data[--out.len] = 0;
    }
}

char _http_lc(char c) {
    return (c >= 'A' && c <= 'Z') ? (char)((int)c + 32) : c;
}

// Find header `name` (case-insensitive) in a "Key: Value\n" block and copy its
// value into `out` (cleared first) without surrounding whitespace. 1 = hit.
int _http_header_lookup(String* headers, string name, String* out) {
    out.clear();
    const int n = headers.len;
    int i = 0;
    while (i < n) {
        // Compare the line's key against `name`.
        int j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || _http_lc(headers.data[i + j]) != _http_lc(name[j])) {
                matched = false;
                break;
            }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            int k = i + j + 1;
            while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) {   // leading OWS
                k++;
            }
            for (; k < n && headers.data[k] != '\n'; k++) {
                out.push(headers.data[k]);
            }
            _http_trim_ows_tail(out);
            return 1;
        }
        // Skip to the start of the next line.
        while (i < n && headers.data[i] != '\n') {
            i++;
        }
        i++;
    }
    return 0;
}

// Look up a header by name (case-insensitive). On success copies the value into
// `out` (cleared first), without surrounding whitespace, and returns 1;
// otherwise returns 0.
int HttpRequest_header(HttpRequest* self, string name, String* out) {
    return _http_header_lookup(&self.headers, name, out);
}

// ── Response (builder) ───────────────────────────────────────────────────────

struct HttpResponse {
    int status;
    String headers;   // accumulated "Key: Value\r\n"
    String body;
}

void HttpResponse_init(HttpResponse* self, int status) {
    self.status = status;
    self.headers.init(128);
    self.body.init(128);
}

void HttpResponse_free(HttpResponse* self) {
    self.headers.free();
    self.body.free();
}

// 1 if `key` is a field name (one or more tchar) and `val` a field value with
// no CR or LF, so the pair is one header line when written out.
int _http_field_ok(string key, string val) {
    if (key[0] == 0) {
        return 0;
    }
    for (int i = 0; key[i] != 0; i++) {
        if (_http_is_tchar((uint8)key[i]) == 0) {
            return 0;
        }
    }
    for (int i = 0; val[i] != 0; i++) {
        if (_http_is_crlf_byte((uint8)val[i]) == 1) {
            return 0;
        }
    }
    return 1;
}

// Add the header `key: val`. Returns 1, or 0 (and adds nothing) when `key` is
// not a token or `val` holds a CR or LF: such a pair would split into a
// second, injected header line (_http_field_ok). A Content-Length set here is
// not sent when the response gets the automatic one.
int HttpResponse_header(HttpResponse* self, string key, string val) {
    if (_http_field_ok(key, val) == 0) {
        return 0;
    }
    self.headers.append(key);
    self.headers.append(": ");
    self.headers.append(val);
    self.headers.append("\r\n");
    return 1;
}

void HttpResponse_set_body(HttpResponse* self, string s) {
    self.body.clear();
    self.body.append(s);
}

void HttpResponse_body_append(HttpResponse* self, string s) {
    self.body.append(s);
}

// Reason phrase for the common status codes; any other code gets the generic
// phrase of its class ("" outside 100..599).
string _http_reason(int s) {
    switch (s) {
        case 200: return "OK";
        case 201: return "Created";
        case 204: return "No Content";
        case 206: return "Partial Content";
        case 301: return "Moved Permanently";
        case 302: return "Found";
        case 304: return "Not Modified";
        case 400: return "Bad Request";
        case 401: return "Unauthorized";
        case 403: return "Forbidden";
        case 404: return "Not Found";
        case 405: return "Method Not Allowed";
        case 408: return "Request Timeout";
        case 409: return "Conflict";
        case 413: return "Payload Too Large";
        case 422: return "Unprocessable Entity";
        case 429: return "Too Many Requests";
        case 431: return "Request Header Fields Too Large";
        case 500: return "Internal Server Error";
        case 501: return "Not Implemented";
        case 502: return "Bad Gateway";
        case 503: return "Service Unavailable";
        case 504: return "Gateway Timeout";
        case 505: return "HTTP Version Not Supported";
    }
    if (s >= 100 && s < 200) {
        return "Informational";
    }
    if (s >= 200 && s < 300) {
        return "Success";
    }
    if (s >= 300 && s < 400) {
        return "Redirection";
    }
    if (s >= 400 && s < 500) {
        return "Client Error";
    }
    if (s >= 500 && s < 600) {
        return "Server Error";
    }
    return "";
}

// Append `v` in decimal to `out`. Takes int64 so a Content-Length above 2 GiB is
// written in full (String_from_int is int-only).
void _http_append_int(String* out, int64 v) {
    if (v < 0) {
        out.push('-');
    }
    char[20] digits;
    int n = 0;
    uint64 u = v < 0 ? (uint64)0 - (uint64)v : (uint64)v;
    do {
        digits[n++] = (char)('0' + (int)(u % 10));
        u /= 10;
    } while (u != 0);
    while (n > 0) {
        out.push(digits[--n]);
    }
}

// 1 if a response with this status has no content and so no body and no
// Content-Length (RFC 9110 §8.6, §15.2, §15.3.5, §15.4.5: 1xx, 204 and 304;
// a 304 Content-Length would describe the selected representation, which
// the handler's body need not be).
int _http_status_no_content(int status) {
    return (status >= 100 && status < 200) || status == 204 || status == 304 ? 1 : 0;
}

// Serialize the full HTTP/1.1 response (status line, headers, auto
// Content-Length, blank line, body) into `out`. A 1xx, 204 or 304 response
// gets no Content-Length and no body.
void HttpResponse_render(HttpResponse* self, String* out) {
    _http_render(self, out, false);
}

// Serialize the response to a HEAD request into `out`: as HttpResponse_render,
// with the Content-Length of the body a GET would get, but no body (RFC 9110
// §9.3.2).
void HttpResponse_render_head(HttpResponse* self, String* out) {
    _http_render(self, out, true);
}

// 1 if the header line s[from..to) is named `name` (case-insensitive).
int _http_line_named(String* s, int64 from, int64 to, string name) {
    int64 j = 0;
    for (; name[j] != 0; j++) {
        if (from + j >= to || _http_lc(s.data[from + j]) != _http_lc(name[j])) {
            return 0;
        }
    }
    return from + j < to && s.data[from + j] == ':' ? 1 : 0;
}

void _http_render(HttpResponse* self, String* out, bool head) {
    out.append("HTTP/1.1 ");
    _http_append_int(out, self.status);
    out.push(' ');
    out.append(_http_reason(self.status));
    out.append("\r\n");
    const int nocontent = _http_status_no_content(self.status);
    // The handler's lines, less a Content-Length when the automatic one is sent
    // (two would be a conflicting length, RFC 9112 §6.3).
    const int64 n = self.headers.len;
    int64 i = 0;
    while (i < n) {
        int64 e = i;
        while (e < n && self.headers.data[e] != '\n') {
            e++;
        }
        if (e < n) {
            e++;
        }
        if (nocontent == 1 || _http_line_named(&self.headers, i, e, "content-length") == 0) {
            for (k in i..e) {
                out.push(self.headers.data[k]);
            }
        }
        i = e;
    }
    if (nocontent == 1) {
        out.append("\r\n");
        return;
    }
    out.append("Content-Length: ");
    _http_append_int(out, self.body.len);
    out.append("\r\n\r\n");
    if (head) {
        return;
    }
    // All body.len bytes: the body may hold a NUL, which cstr() would cut at.
    for (i in 0..self.body.len) {
        out.push(self.body.data[i]);
    }
}

// ── Worker pool ──────────────────────────────────────────────────────────────

// Limits of the http_serve / http_serve_async servers: a request head
// longer than HTTP_SERVE_MAX_HEAD bytes is answered 400, a body longer than
// HttpLimits.max_body (HTTP_SERVE_MAX_BODY by default) 413.
const int HTTP_SERVE_MAX_HEAD = 65536;
const int HTTP_SERVE_MAX_BODY = 1048576;

// Timeouts and connection limits of every stdlib server (http_serve, <http_async>,
// <http2_server>, <tls>), in milliseconds; 0 turns one off. A client that sends
// nothing, trickles its bytes or stops reading is disconnected once one runs out:
//   header_ms  the whole request head (HTTP/1.1), or the HTTP/2 preface and first
//              SETTINGS (and each header block), must arrive within this;
//   body_ms    a request body must arrive within this once its head is in (an
//              HTTP/2 stream: the whole request from its first HEADERS);
//   idle_ms    an HTTP/2 connection with no open stream is closed (GOAWAY
//              NO_ERROR) after this long; frames such as PING do not extend it;
//   write_ms   an answer (or an HTTP/2 stream's response data) must be taken by
//              the client within this;
//   write_total_ms an HTTP/2 stream's whole response must be sent within this
//              from when it is ready, however the peer paces its window updates
//              (write_ms counts from the last data sent); past it the stream is
//              reset (CANCEL) and its buffered response freed, the connection
//              stays open;
//   max_open   the async servers hold at most this many connections at once; one
//              accepted past it is closed at once (so idle peers cannot use up
//              every file descriptor);
//   max_body   a request body (Content-Length or decoded chunks, HTTP/1.1 and
//              HTTP/2) longer than this many bytes is answered 413 (default
//              HTTP_SERVE_MAX_BODY, 1 MiB); a server taking uploads raises it.
// A request cut by header_ms or body_ms after some of it arrived is answered 408
// before the connection closes (HTTP/1.1); nothing is sent to a peer that sent
// nothing. The HTTP/1.1 servers answer one request per connection, so they have
// no idle wait between requests.
const int64 HTTP_HEADER_TIMEOUT_MS = 10000;
const int64 HTTP_BODY_TIMEOUT_MS = 60000;
const int64 HTTP_IDLE_TIMEOUT_MS = 60000;
const int64 HTTP_WRITE_TIMEOUT_MS = 30000;
const int64 HTTP_WRITE_TOTAL_MS = 300000;
const int HTTP_MAX_OPEN_CONNS = 1024;

struct HttpLimits {
    int64 header_ms;
    int64 body_ms;
    int64 idle_ms;
    int64 write_ms;
    int max_open;
    int64 write_total_ms;
    int64 max_body;
}

// Set `self` to the defaults above; change the fields after, then pass it to a
// *_with server (http_serve_with, http_serve_async_with, http2_serve_async_with,
// http2_tls_serve_async_with, http2_tls_serve_conn_with).
void HttpLimits_init(HttpLimits* self) {
    self.header_ms = HTTP_HEADER_TIMEOUT_MS;
    self.body_ms = HTTP_BODY_TIMEOUT_MS;
    self.idle_ms = HTTP_IDLE_TIMEOUT_MS;
    self.write_ms = HTTP_WRITE_TIMEOUT_MS;
    self.max_open = HTTP_MAX_OPEN_CONNS;
    self.write_total_ms = HTTP_WRITE_TOTAL_MS;
    self.max_body = HTTP_SERVE_MAX_BODY;
}

// The default limits, by value.
HttpLimits http_limits() {
    let l: HttpLimits;
    l.init();
    return l;
}

// The bytes of one request as a server reads them from a connection.
struct HttpConnBuf {
    *uint8 data;
    int len;
    int cap;
    int64 need;     // bytes the request needs in total, once known (else 0)
    int hend;     // just past the head's blank line, once found (else 0)
    int scan;     // bytes already searched for the blank line
    int chunked;  // 1 if the body is chunked
    int trailer;  // chunked decoder state (see _http_chunked_run)
    int64 bpos;     // chunked: where the undecoded input starts
    int64 tbytes;   // chunked: trailer bytes consumed
    HttpChunkOut out;   // chunked: the body decoded so far
    int64 max_body;     // the body cap (HttpLimits.max_body)
}

void HttpConnBuf_init(HttpConnBuf* self) {
    self.cap = 8192;
    self.data = alloc<uint8>(self.cap);
    self.len = 0;
    self.need = 0;
    self.hend = 0;
    self.scan = 0;
    self.chunked = 0;
    self.trailer = 0;
    self.bpos = 0;
    self.tbytes = 0;
    self.out.data = null;
    self.out.len = 0;
    self.out.cap = 0;
    self.max_body = HTTP_SERVE_MAX_BODY;
}

void HttpConnBuf_free(HttpConnBuf* self) {
    if (self.data != null) {
        free(self.data);
        self.data = null;
    }
    if (self.out.data != null) {
        free(self.out.data);
        self.out.data = null;
    }
}

// After more bytes were added to b.len: -1 if the request is still incomplete
// (the buffer then has room for the next read at b.data + b.len, cap - len
// bytes), 0 when `req` holds the complete request, or the status to answer
// (400, 413, 501, 505, as HttpRequest_parse_status; 400 also for a head
// longer than HTTP_SERVE_MAX_HEAD). A request split over any number of reads
// is parsed once its bytes are all in. The work is incremental: the head is
// searched and parsed once, and a chunked body is decoded as it arrives, so
// each call only looks at the new bytes (a request fed in small pieces used
// to be reparsed from the start every time, quadratic in its size).
int HttpConnBuf_feed(HttpConnBuf* b, HttpRequest* req) {
    if (b.hend == 0) {
        const int h = _http_idx_header_end_from(b.data, b.scan > 3 ? b.scan - 3 : 0, b.len);
        b.scan = b.len;
        if (h < 0) {
            if (b.len > HTTP_SERVE_MAX_HEAD) {
                return 400;
            }
        } else {
            b.hend = h;
            _http_request_clear(req);
            int64 clen = 0;
            const int framing = _http_request_head(req, b.data, h, b.max_body, &clen);
            if (framing > 1) {
                return framing;
            }
            if (framing == 1) {
                b.chunked = 1;
                b.bpos = h;
            }
            else {
                b.need = (int64)h + clen;
            }
        }
    }
    if (b.hend > 0) {
        if (b.chunked == 1) {
            // Decoded input is dropped, so tiny chunks (many framing bytes
            // per body byte) do not run into the buffer limit below.
            int64 n = b.len;
            const int st = _http_chunked_feed(b.data, &n, &b.bpos, b.hend, &b.out, b.max_body, &b.trailer, &b.tbytes);
            b.len = (int)n;
            if (st == 1) {
                for (i in 0..b.out.len) {
                    req.body.push((char)b.out.data[i]);
                }
                return 0;
            }
            if (st < 0) {
                return st == -2 ? 413 : 400;
            }
        } else if ((int64)b.len >= b.need) {
            for (int64 i = b.hend; i < b.need; i++) {
                req.body.push((char)b.data[i]);
            }
            return 0;
        }
    }
    if (b.len < b.cap) {
        return -1;
    }
    // A Content-Length request needs at most HEAD + max_body bytes; a chunked
    // one holds its head and one unfinished chunk (at most max_body) or line.
    // The buffer is an int-sized allocation, so the bound stops below 2 GiB.
    int64 limit = (int64)HTTP_SERVE_MAX_HEAD + 2 * b.max_body;
    if (limit > (int64)2147483647) {
        limit = (int64)2147483647;
    }
    if ((int64)b.cap >= limit) {
        return 413;
    }
    int64 nc = (int64)b.cap * 2;
    if (nc < b.need) {
        nc = b.need;
    }
    if (nc > limit) {
        nc = limit;
    }
    b.data = http_buf_grow(b.data, b.len, (int)nc);
    b.cap = (int)nc;
    return -1;
}

// The answer to a request read by a server, rendered into `out`: `st` is
// HttpConnBuf_feed's result, 0 to call `handler` (a HEAD request gets no
// body), else the error status answered without calling it.
void _http_conn_render(HttpRequest* req, int st, fn(HttpRequest*, HttpResponse*)->void handler, String* out) {
    let res: HttpResponse;
    res.init(200);
    if (st == 0) {
        handler(req, &res);
    }
    else {                   // malformed: the handler never sees it
        res.status = st;
    }
    if (st == 0 && req.method.eq_cstr("HEAD") == 1) {
        res.render_head(out);
    }
    else {
        res.render(out);
    }
    res.free();
}

// Answer a request read by a server over the blocking socket `c` (see
// _http_conn_render). The whole answer must be taken within `write_ms` from the
// first byte: SO_SNDTIMEO is set to what is left of that deadline before each
// send, so a peer that reads slowly cannot stretch it.
void _http_conn_answer(int c, HttpRequest* req, int st, fn(HttpRequest*, HttpResponse*)->void handler, int64 write_ms) {
    let out: String;
    out.init(256);
    _http_conn_render(req, st, handler, &out);
    const int64 dl = net_deadline(write_ms);
    int64 off = 0;
    while (off < (int64)out.len) {
        int64 left = 0;
        if (dl != 0) {
            left = dl - time_monotonic_ms();
            if (left <= 0) {
                break;
            }
        }
        net_set_send_timeout(c, left);
        const int64 sent = net_send(c, out.cstr() + off, (int64)out.len - off);
        if (sent < 0 && dl != 0 && net_would_block() == 1) {   // SO_SNDTIMEO ran out: the check above decides
            continue;
        }
        if (sent <= 0) {
            break;
        }
        off += sent;
    }
    out.free();
}

// Read one request from the blocking socket `c` into `b` / `req` under the
// limits: HttpConnBuf_feed's result, -2 if the peer closed or timed out before
// sending anything, or 408 if the head (header_ms) or the body (body_ms) did not
// arrive in time. SO_RCVTIMEO is set to what is left of the deadline before each
// recv, so trickled bytes cannot stretch it.
int _http_conn_read(int c, HttpConnBuf* b, HttpRequest* req, HttpLimits* lim) {
    const int64 head_dl = net_deadline(lim.header_ms);
    int64 body_dl = 0;
    bool body_armed = false;
    while (true) {
        if (b.hend > 0 && !body_armed) {
            body_dl = net_deadline(lim.body_ms);
            body_armed = true;
        }
        const int64 dl = b.hend > 0 ? body_dl : head_dl;
        int64 left = 0;
        if (dl != 0) {
            left = dl - time_monotonic_ms();
            if (left <= 0) {
                return b.len == 0 ? -2 : 408;
            }
        }
        net_set_recv_timeout(c, left);
        const int64 got = net_recv(c, b.data + b.len, b.cap - b.len);
        if (got < 0 && dl != 0 && net_would_block() == 1) {   // SO_RCVTIMEO ran out: the check above decides
            continue;
        }
        if (got <= 0) {   // closed: nothing sent, or a cut request
            return b.len == 0 ? -2 : 400;
        }
        b.len += (int)got;
        const int st = b.feed(req);
        if (st != -1) {
            return st;
        }
    }
    return -1;
}

// A handler reads the request and fills the response.
//
// Accept-and-serve loop for one worker. Each connection is read until its
// request is complete (or known to be bad, or out of time: see HttpLimits),
// parsed, handed to `handler`, and answered (the whole answer must be taken
// within lim.write_ms). Runs forever.
void http_worker_loop_with(int fd, fn(HttpRequest*, HttpResponse*)->void handler, HttpLimits lim) {
    while (true) {
        const int c = net_accept(fd);
        if (c < 0) {
            continue;
        }
        let b: HttpConnBuf;
        b.init();
        b.max_body = lim.max_body;
        let req: HttpRequest;
        req.init();
        const int st = _http_conn_read(c, &b, &req, &lim);
        if (st != -2) {
            _http_conn_answer(c, &req, st, handler, lim.write_ms);
        }
        net_close(c);
        req.free();
        b.free();
    }
}

void http_worker_loop(int fd, fn(HttpRequest*, HttpResponse*)->void handler) {
    http_worker_loop_with(fd, handler, http_limits());
}

// Listen on `port` and serve with `nworkers` threads (the calling thread is one
// of them, so it blocks here) under the default HttpLimits. Returns immediately
// only if the bind fails.
void http_serve(int port, int nworkers, escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    http_serve_with(port, nworkers, handler, http_limits());
}

// http_serve with the timeouts in `lim` (max_open does not apply: the workers
// are the bound).
void http_serve_with(int port, int nworkers, escaping fn(HttpRequest*, HttpResponse*)->void handler, HttpLimits lim) {
    const int fd = net_tcp_listen((uint16)port);
    if (fd < 0) {
        return;
    }
    // Each worker's closure is written in the call, so its thread owns (and frees) it.
    for (int spawned = 1; spawned < nworkers; spawned++)
        thread_create(void() {
        http_worker_loop_with(fd, handler, lim);
    });
    http_worker_loop_with(fd, handler, lim);
}

// ── Binary-safe request (full body) ────────────────────────────────────────────
//
// HttpRequest above does a single 8 KB recv and stores the body as a String
// (signed char) — fine for small text requests, but it truncates large bodies
// and corrupts binary ones. HttpReq instead reads the *complete* request,
// looping recv until Content-Length bytes arrive, into a binary-safe `*uint8`
// body. Use it for uploads (images, arbitrary bytes).
//
//   let r: HttpReq;  HttpReq_init(&r);
//   int st = http_recv(fd, &r, 25 * 1024 * 1024);   // 0 ok, or an HTTP error code
//   // ... route on r.method / r.path, read r.body[0..r.body_len) ...
//   http_reply(fd, 200, "application/json", "", &someStringBody);
//   HttpReq_free(&r);

struct HttpReq {
    String method;
    String path;
    String headers;    // "Key: Value\n" lines (CRLF normalised to \n)
    *uint8 body;        // heap, binary-safe (NOT a String)
    int64 body_len;
}

void HttpReq_init(HttpReq* self) {
    self.method.init(8);
    self.path.init(32);
    self.headers.init(256);
    self.body = null;
    self.body_len = 0;
}

void HttpReq_free(HttpReq* self) {
    self.method.free();
    self.path.free();
    self.headers.free();
    if (self.body != null) {
        free(self.body);
        self.body = null;
    }
}

// The request body as a non-owning, binary-safe Bytes view (no copy).
Bytes HttpReq_body(HttpReq* self) {
    let v: Bytes;
    v.data = self.body;
    v.len = self.body_len;
    v.cap = 0;
    return v;
}

// Index just past the "\r\n\r\n" header terminator in b[0..n), or -1.
int _http_idx_header_end(*uint8 b, int n) {
    return _http_idx_header_end_from(b, 0, n);
}

// _http_idx_header_end for a terminator starting at `from` or later.
int _http_idx_header_end_from(*uint8 b, int from, int n) {
    for (int i = from; i + 3 < n; i++) {
        if (b[i] == '\r' && b[i + 1] == '\n' && b[i + 2] == '\r' && b[i + 3] == '\n') {
            return i + 4;
        }
    }
    return -1;
}

*uint8 http_buf_grow(*uint8 old, int used, int newcap) {
    *uint8 nb = alloc<uint8>(newcap);
    if (used > 0) {
        memcpy(nb, old, used);
    }
    free(old);
    return nb;
}

// Parse request line + headers from buf[0..hend) (`hend` is just past the
// blank line) into the method, path, version text (`ver`, may be null) and
// "Key: Value\n" header block, storing the HTTP-version as major * 10 + minor
// in *version. Returns 1, or 0 if the head is malformed: a method that is not
// a token, an empty path, a missing or invalid HTTP-version, a line break that
// is not CRLF (a bare LF must not start a new header line, RFC 9112 §2.2), or
// a line that is not a field line (whitespace before the colon, an obsolete
// line fold).
int _http_parse_head_into(String* method, String* path, String* ver, String* headers, *uint8 buf, int hend, *int version) {
    int pos = 0;
    for (; pos < hend && _http_is_tchar(buf[pos]) == 1; pos++) {
        method.push((char)buf[pos]);
    }
    if (pos >= hend || buf[pos] != ' ' || method.len == 0) {
        return 0;
    }
    pos++;
    for (; pos < hend && buf[pos] != ' ' && buf[pos] != 0 && _http_is_crlf_byte(buf[pos]) == 0; pos++) {
        path.push((char)buf[pos]);
    }
    if (pos >= hend || buf[pos] != ' ' || path.len == 0) {
        return 0;
    }
    pos++;
    const int vstart = pos;
    while (pos < hend && _http_is_crlf_byte(buf[pos]) == 0) {
        pos++;
    }
    *version = _http_parse_version(buf, vstart, pos);
    if (*version < 0) {
        return 0;
    }
    if (ver != null) {
        for (i in vstart..pos) {
            ver.push((char)buf[i]);
        }
    }
    if (_http_crlf_at(buf, pos, hend) == 0) {
        return 0;
    }
    pos += 2;
    while (pos < hend && _http_crlf_at(buf, pos, hend) == 0) {
        for (; pos < hend && _http_is_crlf_byte(buf[pos]) == 0; pos++) {
            headers.push((char)buf[pos]);
        }
        headers.push('\n');
        if (_http_crlf_at(buf, pos, hend) == 0) {   // a bare CR or LF
            return 0;
        }
        pos += 2;
    }
    return _http_headers_valid(headers);
}

// Parse request line + headers from buf[0..hend) into r (see
// _http_parse_head_into), storing the HTTP-version in *version.
int _http_parse_head_v(HttpReq* r, *uint8 buf, int hend, *int version) {
    return _http_parse_head_into(&r.method, &r.path, null, &r.headers, buf, hend, version);
}

// Parse request line + headers from buf[0..hend) into r; 1, or 0 if the head
// is malformed (see _http_parse_head_v).
int HttpReq_parse_head(HttpReq* r, *uint8 buf, int hend) {
    int version = 0;
    return _http_parse_head_v(r, buf, hend, &version);
}

// Case-insensitive header lookup; copies the value (without surrounding
// whitespace) into `out`. 1 = hit.
int HttpReq_header(HttpReq* r, string name, String* out) {
    return _http_header_lookup(&r.headers, name, out);
}

// Parse a Content-Length style value (1*DIGIT). Returns -1 if it is empty, has
// a non-digit, or does not fit in an int64 (it used to wrap: 2^64 read as 0).
int64 _http_str_to_i64(String* s) {
    if (s.len == 0) {
        return -1;
    }
    int64 v = 0;
    for (i in 0..s.len) {
        const char c = s.data[i];
        if (c < '0' || c > '9') {
            return -1;
        }
        const int64 d = (int)c - '0';
        if (v > (9223372036854775807 - d) / 10) {
            return -1;
        }
        v = v * 10 + d;
    }
    return v;
}

// The request's Content-Length: -2 if there is none, -1 if it is invalid, else
// the length. Every Content-Length line counts, and a line may carry a
// comma-separated list; all the values must be the same number (RFC 9112 §6.3:
// differing lengths are unrecoverable, a request-smuggling vector).
int64 _http_content_length(String* headers) {
    const string name = "content-length";
    int64 found = -2;
    const int64 n = headers.len;
    int64 i = 0;
    while (i < n) {
        int64 j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || _http_lc(headers.data[i + j]) != _http_lc(name[j])) {
                matched = false;
                break;
            }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            int64 k = i + j + 1;
            while (true) {
                let item: String;
                item.init(16);
                while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) {
                    k++;
                }
                for (; k < n && headers.data[k] != ',' && headers.data[k] != '\n'; k++) {
                    item.push(headers.data[k]);
                }
                _http_trim_ows_tail(&item);
                const int64 v = _http_str_to_i64(&item);
                item.free();
                if (v < 0 || (found >= 0 && v != found)) {
                    return -1;
                }
                found = v;
                if (k >= n || headers.data[k] != ',') {
                    break;
                }
                k++;
            }
        }
        while (i < n && headers.data[i] != '\n') {
            i++;
        }
        i++;
    }
    return found;
}

// Read the rest of a chunked body: `have` bytes of it already arrived at
// `head`. Decodes into r.body; 0 on success, 400 if it is malformed or cut
// short, 413 if it decodes to more than `max_body` bytes.
int _http_recv_chunked(int fd, HttpReq* r, int64 max_body, *uint8 head, int have) {
    int64 cap = 8192;
    while (cap < (int64)have) {
        cap *= 2;
    }
    *uint8 raw = alloc<uint8>(cap);
    int64 n = have;
    if (have > 0) {
        memcpy(raw, head, have);
    }
    int64 pos = 0;
    int trailer = 0;
    int64 tbytes = 0;
    let out: HttpChunkOut;
    out.data = null;
    out.len = 0;
    out.cap = 0;
    int status = 0;
    while (true) {
        // Decoded chunks and trailer lines are dropped: what is left is one
        // partial chunk or line, never rescanned from the last chunk.
        const int st = _http_chunked_feed(raw, &n, &pos, 0, &out, max_body, &trailer, &tbytes);
        if (st == 1) {
            break;
        }
        if (st < 0) {
            status = st == -2 ? 413 : 400;
            break;
        }
        if (n >= cap) {
            if (cap > max_body + 65536) {
                status = 413;
                break;
            }
            *uint8 nr = alloc<uint8>(cap * 2);
            memcpy(nr, raw, n);
            free(raw);
            raw = nr;
            cap *= 2;
        }
        const int64 got = net_recv(fd, raw + n, cap - n);
        if (got <= 0) {   // closed early: a truncated body
            status = 400;
            break;
        }
        n += got;
    }
    free(raw);
    if (status != 0 || out.len == 0) {
        if (out.data != null) {
            free(out.data);
        }
        r.body = null;
        r.body_len = 0;
        return status;
    }
    r.body = out.data;
    r.body_len = out.len;
    return 0;
}

// Read a complete request from `fd`. Returns 0 on success, or an HTTP error
// status on failure: 400 malformed (including a missing Host in HTTP/1.1,
// Transfer-Encoding together with Content-Length, whitespace before a header
// colon, an obsolete line fold), 413 too large, 501 a transfer coding other than
// chunked, 505 an HTTP major version other than 1. A chunked body is decoded
// (trailers are discarded; a trailer section over HTTP_CHUNK_TRAILER_MAX
// bytes is 400). A peer that closes before the whole body arrives
// gets 400 (never a short body reported as success).
int http_recv(int fd, HttpReq* r, int64 max_body) {
    int cap = 8192;
    *uint8 buf = alloc<uint8>(cap);
    defer free(buf);
    int n = 0;
    int hend = -1;
    while (hend < 0) {
        if (n >= cap) {
            cap *= 2;
            buf = http_buf_grow(buf, n, cap);
        }
        const int64 got = net_recv(fd, buf + n, cap - n);
        if (got <= 0) {
            return 400;
        }
        n += (int)got;
        hend = _http_idx_header_end(buf, n);
        if (hend < 0 && n > 65536) {
            return 400;
        }
    }
    int version = 0;
    if (_http_parse_head_v(r, buf, hend, &version) == 0) {
        return 400;
    }
    int64 clen = 0;
    const int framing = _http_body_framing(&r.headers, version, max_body, &clen);
    if (framing > 1) {
        return framing;
    }
    if (framing == 1) {
        return _http_recv_chunked(fd, r, max_body, buf + hend, n - hend);
    }

    const int have = n - hend;
    if (clen <= 0) {
        r.body = null;
        r.body_len = 0;
        return 0;
    }

    // The header read may already hold the start of the body; the rest follows.
    *uint8 body = alloc<uint8>(clen);
    const int64 copy0 = (int64)have > clen ? clen : (int64)have;   // clamp in int64: clen may exceed INT_MAX
    if (copy0 > 0) {
        memcpy(body, buf + hend, copy0);
    }

    int64 bgot = copy0;
    while (bgot < clen) {
        const int64 got = net_recv(fd, body + bgot, clen - bgot);
        if (got <= 0) {       // closed early: a truncated body
            free(body);
            return 400;
        }
        bgot += got;
    }
    r.body = body;
    r.body_len = bgot;
    return 0;
}

// Send a full HTTP/1.1 response. `extra` is pre-formatted "K: V\r\n" lines (may
// be empty). `body` is sent verbatim (its String length is honoured, so it may
// hold bytes a NUL would otherwise cut short). A null `body` sends an empty body.
// A 1xx or 204 status sends no Content-Length and no body (RFC 9110 §8.6).
void http_reply(int fd, int status, string ctype, string extra, String* body) {
    const int nocontent = _http_status_no_content(status);
    const int64 blen = body == null || nocontent == 1 ? 0 : body.len;
    let out: String;
    out.init(blen + 256);
    defer out.free();
    out.append("HTTP/1.1 ");
    _http_append_int(&out, status);
    out.push(' ');
    out.append(_http_reason(status));
    out.append("\r\nContent-Type: ");
    out.append(ctype);
    out.append("\r\n");
    out.append(extra);
    if (nocontent == 0) {
        out.append("Content-Length: ");
        _http_append_int(&out, blen);
        out.append("\r\n");
    }
    out.append("Connection: close\r\n\r\n");
    net_send(fd, out.cstr(), out.len);
    if (blen > 0) {
        net_send(fd, body.data, blen);
    }
}

// Append `s` to `out` as the body of a JSON string: `"` and backslash escaped,
// control bytes as \n \r \t or \u00XX.
void _http_json_escape(String* out, string s) {
    for (int i = 0; s[i] != 0; i++) {
        const char c = s[i];
        const int u = (int)(uint8)c;
        if (c == '"' || c == '\\') {
            out.push('\\');
            out.push(c);
        }
        else if (c == '\n') {
            out.append("\\n");
        }
        else if (c == '\r') {
            out.append("\\r");
        }
        else if (c == '\t') {
            out.append("\\t");
        }
        else if (u < 32) {
            out.append("\\u00");
            out.push("0123456789abcdef"[u >> 4]);
            out.push("0123456789abcdef"[u & 15]);
        }
        else {
            out.push(c);
        }
    }
}

// Convenience: reply with a small JSON error {"error":"..."} (msg is escaped).
void http_reply_error(int fd, int status, string extra, string msg) {
    let b: String;
    b.init(64);
    defer b.free();
    b.append("{\"error\":\"");
    _http_json_escape(&b, msg);
    b.append("\"}");
    http_reply(fd, status, "application/json", extra, &b);
}
