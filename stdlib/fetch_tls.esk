// fetch_tls.esk: the HTTPS side of <fetch>, over OpenSSL (libssl 3.x or 1.1)
// loaded when the first https:// request runs.
//
// The library is opened with dlopen (LoadLibraryA on Windows) rather than
// linked, so a program that imports <fetch> links and runs without OpenSSL;
// only an https:// request needs it, and fails with FETCH_ERR_NO_TLS when it
// is missing. The names tried, in order:
//   - the file named by the ESKIU_LIBSSL environment variable, if set;
//   - macOS: libssl.3.dylib, then Homebrew (/opt/homebrew/opt/openssl@3/lib,
//     /usr/local/opt/openssl@3/lib) and MacPorts (/opt/local/lib), then the
//     same for libssl.1.1.dylib (the system /usr/lib/libssl.dylib is LibreSSL
//     and is never loaded);
//   - Linux: libssl.so.3, libssl.so.1.1, libssl.so;
//   - Windows: libssl-3-x64.dll, libssl-3.dll, libssl-1_1-x64.dll (with its
//     libcrypto next to it, as MSYS2 and the OpenSSL installers ship them).
// fetch_tls_available() says whether one was found.
//
// On Windows, where OpenSSL's default trust store is usually empty, a verifying
// context without a CA file also trusts the system "ROOT" certificate store.
//
// The OpenSSL entry points are plain C functions reached through a pointer
// from dlsym. Eskiu calls a fn value as code(env, args...), so each call here
// builds a fn value whose code is the OpenSSL function and whose env is its
// first argument (the SSL*, the SSL_CTX*, or null for a function without
// arguments, where the extra argument is ignored as C calling conventions
// allow). This needs no C shim and no extern for any OpenSSL symbol.
//
// The socket is non-blocking: every SSL_* step returns at once and says
// whether it needs the socket readable or writable (<fetch> waits with poll,
// or with the event loop in fetch_async).

import <c/stdlib>;   // getenv
import <c/signal>;   // signal (Linux)
import <mem>;
import <string>;
import <net>;
import <atomic>;

#ifdef _WIN32
extern *void LoadLibraryA(string name);
extern *void GetProcAddress(*void lib, string name);
*void _ftls_dlopen(string name) {
    return LoadLibraryA(name);
}

*void _ftls_dlsym(*void lib, string name) {
    return GetProcAddress(lib, name);
}
#else
#ifdef __linux__
#pragma link("dl")
#endif
extern *void dlopen(string path, int flags);
extern *void dlsym(*void lib, string name);
*void _ftls_dlopen(string name) {   // RTLD_NOW
    return dlopen(name, 2);
}

*void _ftls_dlsym(*void lib, string name) {
    return dlsym(lib, name);
}
#endif

// A fn value laid out by hand: { code, env }.
struct _FtRaw {
    *void code;
    *void env;
}

struct _FtP0 {
    fn()->*void f;
}

struct _FtI0 {
    fn()->int f;
}

struct _FtV0 {
    fn()->void f;
}

struct _FtII {
    fn(int)->int f;
}

struct _FtIS {
    fn(string)->int f;
}

struct _FtIPI {
    fn(*void, int)->int f;
}

struct _FtVIP {
    fn(int, *void)->void f;
}

struct _FtILP {
    fn(int, int64, *void)->int f;
}

struct _FtLL {
    fn(int64)->int64 f;
}

struct _FtISI {
    fn(string, int)->int f;
}

struct _FtISS {
    fn(string, string)->int f;
}

struct _FtSI {
    fn()->string f;
}

struct _FtIP {
    fn(*void)->int f;
}

struct _FtPPI {
    fn(*void, int)->*void f;
}

// Call the C function `code` with `a` as its first argument (or no argument).
*void _ftls_call_p(*void code, *void a) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn()->*void = ((*_FtP0)&r).f;
    return f();
}

int _ftls_call_i(*void code, *void a) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn()->int = ((*_FtI0)&r).f;
    return f();
}

void _ftls_call_v(*void code, *void a) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn()->void = ((*_FtV0)&r).f;
    f();
}

int _ftls_call_ii(*void code, *void a, int x) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(int)->int = ((*_FtII)&r).f;
    return f(x);
}

int _ftls_call_is(*void code, *void a, string s) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(string)->int = ((*_FtIS)&r).f;
    return f(s);
}

int _ftls_call_ipi(*void code, *void a, *void p, int n) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(*void, int)->int = ((*_FtIPI)&r).f;
    return f(p, n);
}

void _ftls_call_vip(*void code, *void a, int x, *void p) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(int, *void)->void = ((*_FtVIP)&r).f;
    f(x, p);
}

int _ftls_call_ilp(*void code, *void a, int x, int64 l, *void p) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(int, int64, *void)->int = ((*_FtILP)&r).f;
    return f(x, l, p);
}

int64 _ftls_call_ll(*void code, *void a, int64 x) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(int64)->int64 = ((*_FtLL)&r).f;
    return f(x);
}

int _ftls_call_isi(*void code, *void a, string s, int x) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(string, int)->int = ((*_FtISI)&r).f;
    return f(s, x);
}

int _ftls_call_iss(*void code, *void a, string s, string t) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(string, string)->int = ((*_FtISS)&r).f;
    return f(s, t);
}

string _ftls_call_s(*void code, *void a) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn()->string = ((*_FtSI)&r).f;
    return f();
}

int _ftls_call_ip(*void code, *void a, *void p) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(*void)->int = ((*_FtIP)&r).f;
    return f(p);
}

*void _ftls_call_ppi(*void code, *void a, *void p, int n) {
    let r: _FtRaw;
    r.code = code;
    r.env = a;
    let f: fn(*void, int)->*void = ((*_FtPPI)&r).f;
    return f(p, n);
}

// ── Loading ──────────────────────────────────────────────────────────────────

int _ftls_state = 0;     // 0 not tried, 2 loading, 1 loaded, -1 not found
*void _ftls_ssl = null;
*void _ftls_crypto = null;
*void _ftls_ctx_verify = null;
*void _ftls_ctx_noverify = null;

*void _ftls_try(string name) {
    if (name == null || name[0] == 0) {
        return null;
    }
    return _ftls_dlopen(name);
}

// The OpenSSL function `name` (null if neither library has it).
*void _ftls_sym(string name) {
    if (_ftls_ssl == null) {
        return null;
    }
    *void p = _ftls_dlsym(_ftls_ssl, name);
    if (p == null && _ftls_crypto != null) {
        p = _ftls_dlsym(_ftls_crypto, name);
    }
    return p;
}

int _ftls_load_once() {
    *void lib = _ftls_try(getenv("ESKIU_LIBSSL"));
#ifdef __APPLE__
    if (lib == null) {
        lib = _ftls_try("libssl.3.dylib");
    }
    if (lib == null) {
        lib = _ftls_try("/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib");
    }
    if (lib == null) {
        lib = _ftls_try("/usr/local/opt/openssl@3/lib/libssl.3.dylib");
    }
    if (lib == null) {
        lib = _ftls_try("/opt/local/lib/libssl.3.dylib");
    }
    if (lib == null) {
        lib = _ftls_try("libssl.1.1.dylib");
    }
    if (lib == null) {
        lib = _ftls_try("/opt/homebrew/opt/openssl@1.1/lib/libssl.1.1.dylib");
    }
    if (lib == null) {
        lib = _ftls_try("/usr/local/opt/openssl@1.1/lib/libssl.1.1.dylib");
    }
#else
#ifdef _WIN32
    if (lib == null) {
        lib = _ftls_try("libssl-3-x64.dll");
        if (lib != null) {
            _ftls_crypto = _ftls_try("libcrypto-3-x64.dll");
        }
    }
    if (lib == null) {
        lib = _ftls_try("libssl-3.dll");
        if (lib != null) {
            _ftls_crypto = _ftls_try("libcrypto-3.dll");
        }
    }
    if (lib == null) {
        lib = _ftls_try("libssl-1_1-x64.dll");
        if (lib != null) {
            _ftls_crypto = _ftls_try("libcrypto-1_1-x64.dll");
        }
    }
    // A libssl named by ESKIU_LIBSSL: its libcrypto is already loaded with it.
    if (lib != null && _ftls_crypto == null) {
        _ftls_crypto = _ftls_try("libcrypto-3-x64.dll");
    }
    if (lib != null && _ftls_crypto == null) {
        _ftls_crypto = _ftls_try("libcrypto-3.dll");
    }
#else
    if (lib == null) {
        lib = _ftls_try("libssl.so.3");
    }
    if (lib == null) {
        lib = _ftls_try("libssl.so.1.1");
    }
    if (lib == null) {
        lib = _ftls_try("libssl.so");
    }
#endif
#endif
    if (lib == null) {
        return -1;
    }
    _ftls_ssl = lib;
    // TLS_client_method is 1.1+; SSL_set1_host is 1.0.2+.
    if (_ftls_sym("TLS_client_method") == null || _ftls_sym("SSL_set1_host") == null) {
        _ftls_ssl = null;
        return -1;
    }
    return 1;
}

// Load OpenSSL once: the first caller loads it while the others (threads making their
// first https request at the same time) wait for its result.
int _ftls_load() {
    int s = atomic_load(&_ftls_state);
    if (s == 1 || s == -1) {
        return s;
    }
    if (atomic_cas(&_ftls_state, 0, 2)) {
        const int r = _ftls_load_once();
        atomic_store(&_ftls_state, r);
        return r;
    }
    s = atomic_load(&_ftls_state);
    while (s == 2) {
        s = atomic_load(&_ftls_state);
    }
    return s;
}

// 1 if an OpenSSL library was found (see the top of the file), else 0. Loads
// it on the first call.
int fetch_tls_available() {
    return _ftls_load() == 1 ? 1 : 0;
}

// ── Client ───────────────────────────────────────────────────────────────────

const int _FTLS_WANT_READ = 2;   // SSL_ERROR_WANT_READ
const int _FTLS_WANT_WRITE = 3;   // SSL_ERROR_WANT_WRITE

void _ftls_clear_errors() {
    *void p = _ftls_sym("ERR_clear_error");
    if (p != null) {
        _ftls_call_v(p, null);
    }
}

#ifdef _WIN32
// OpenSSL's default trust store is a directory that usually does not exist on
// Windows, so a verifying context without a CA file also trusts the
// certificates of the Windows "ROOT" system store (what the system itself
// trusts), copied into the context's X509_STORE.
#pragma link("crypt32")
struct _FtlsCertContext {
    uint32 encoding;
    *uint8 encoded;
    uint32 encoded_len;
    *void info;
    *void store;
}

extern *void CertOpenSystemStoreW(*void prov, *uint16 name);
extern *_FtlsCertContext CertEnumCertificatesInStore(*void store, *_FtlsCertContext prev);
extern int CertCloseStore(*void store, uint32 flags);

// The number of certificates added (0 when the store or a symbol is missing).
int _ftls_add_system_roots(*void ctx) {
    *void d2i = _ftls_sym("d2i_X509");
    *void get_store = _ftls_sym("SSL_CTX_get_cert_store");
    *void add = _ftls_sym("X509_STORE_add_cert");
    *void xfree = _ftls_sym("X509_free");
    if (d2i == null || get_store == null || add == null || xfree == null) {
        return 0;
    }
    *void xs = _ftls_call_p(get_store, ctx);
    if (xs == null) {
        return 0;
    }
    uint16[5] name = { (uint16)'R', (uint16)'O', (uint16)'O', (uint16)'T', (uint16)0 };
    *void sys = CertOpenSystemStoreW(null, &name[0]);
    if (sys == null) {
        return 0;
    }
    int added = 0;
    *_FtlsCertContext c = CertEnumCertificatesInStore(sys, null);
    while (c != null) {
        if (c.encoding == (uint32)1 && c.encoded != null) {   // X509_ASN_ENCODING
            *uint8 der = c.encoded;
            // d2i_X509(null, &der, len): the env slot is its first argument.
            *void x = _ftls_call_ppi(d2i, null, (*void)&der, (int)c.encoded_len);
            if (x != null) {
                if (_ftls_call_ip(add, xs, x) == 1) {
                    added++;
                }
                _ftls_call_v(xfree, x);
            }
        }
        c = CertEnumCertificatesInStore(sys, c);
    }
    CertCloseStore(sys, (uint32)0);
    // A certificate the store already held leaves an error queued.
    _ftls_clear_errors();
    return added;
}
#endif

const int _FTLS_CTRL_SET_MIN_PROTO_VERSION = 123;   // SSL_CTX_set_min_proto_version is a macro
const int64 _FTLS_TLS1_2_VERSION = 0x0303;
// SSL_OP_NO_COMPRESSION | SSL_OP_NO_RENEGOTIATION (same bits in OpenSSL 1.1 and 3).
const int64 _FTLS_OPTIONS = 0x00020000 | 0x40000000;

// TLS 1.2 or newer, no compression, no renegotiation, whatever the library's defaults
// (OpenSSL 1.1.1 still accepts TLS 1.0 unless its configuration says otherwise). 0 when
// the minimum version cannot be set.
int _ftls_harden(*void ctx) {
    if (_ftls_call_ilp(_ftls_sym("SSL_CTX_ctrl"), ctx, _FTLS_CTRL_SET_MIN_PROTO_VERSION,
                       _FTLS_TLS1_2_VERSION, null) != 1) {
        return 0;
    }
    _ftls_call_ll(_ftls_sym("SSL_CTX_set_options"), ctx, _FTLS_OPTIONS);
    return 1;
}

// Keep `ctx` as the shared context in `cell` unless another thread stored one first;
// then free `ctx` and return the one stored.
*void _ftls_publish(**void cell, *void ctx) {
    if (atomic_cas_ptr(cell, null, ctx)) {
        return ctx;
    }
    _ftls_call_v(_ftls_sym("SSL_CTX_free"), ctx);
    return atomic_load_ptr(cell);
}

// A client SSL_CTX: verification on (OpenSSL's default trust store, plus
// `ca_file` when it is not empty, or on Windows without one the system "ROOT"
// store) or off. The two contexts without a CA file are made
// once and kept; one with a CA file is the caller's to free (_ftls_ctx_free).
*void _ftls_ctx(int verify, string ca_file) {
    const bool own = ca_file != null && ca_file[0] != 0;
    if (!own) {
        *void shared = atomic_load_ptr(verify != 0 ? &_ftls_ctx_verify : &_ftls_ctx_noverify);
        if (shared != null) {
            return shared;
        }
    }
    *void method = _ftls_call_p(_ftls_sym("TLS_client_method"), null);
    *void ctx = _ftls_call_p(_ftls_sym("SSL_CTX_new"), method);
    if (ctx == null) {
        return null;
    }
    if (_ftls_harden(ctx) == 0) {
        _ftls_call_v(_ftls_sym("SSL_CTX_free"), ctx);
        return null;
    }
    if (verify != 0) {
        _ftls_call_i(_ftls_sym("SSL_CTX_set_default_verify_paths"), ctx);
#ifdef _WIN32
        if (!own) {
            _ftls_add_system_roots(ctx);
        }
#endif
        if (own && _ftls_call_iss(_ftls_sym("SSL_CTX_load_verify_locations"), ctx, ca_file, null) != 1) {
            _ftls_call_v(_ftls_sym("SSL_CTX_free"), ctx);
            return null;
        }
        _ftls_call_vip(_ftls_sym("SSL_CTX_set_verify"), ctx, 1, null);   // SSL_VERIFY_PEER
    } else {
        _ftls_call_vip(_ftls_sym("SSL_CTX_set_verify"), ctx, 0, null);   // SSL_VERIFY_NONE
    }
    if (!own) {
        return _ftls_publish(verify != 0 ? &_ftls_ctx_verify : &_ftls_ctx_noverify, ctx);
    }
    return ctx;
}

// Free a context made for a CA file (the shared ones are kept).
void _ftls_ctx_free(*void ctx) {
    if (ctx != null && ctx != _ftls_ctx_verify && ctx != _ftls_ctx_noverify) {
        _ftls_call_v(_ftls_sym("SSL_CTX_free"), ctx);
    }
}

// 1 if `host` is an IP address (IPv4 digits and dots, or IPv6 with ':').
int _ftls_is_ip(string host) {
    bool digits = true;
    for (int i = 0; host[i] != 0; i++) {
        if (host[i] == ':') {
            return 1;
        }
        if (host[i] != '.' && (host[i] < '0' || host[i] > '9')) {
            digits = false;
        }
    }
    return digits ? 1 : 0;
}

#ifdef __linux__
bool _ftls_sigpipe_off = false;
#endif

// A client SSL over the connected socket `fd` for `host`: SNI (unless the host
// is an IP address) and, with `verify`, the certificate name check against
// `host`. Null on failure.
*void _ftls_new(*void ctx, int fd, string host, int verify) {
#ifdef __linux__
    // OpenSSL writes the socket with write(), which raises SIGPIPE on a peer
    // that closed; Linux has no per-socket switch (macOS: SO_NOSIGPIPE, set by
    // <net>), so SIGPIPE is ignored for the process, as <tls> does.
    if (!_ftls_sigpipe_off) {
        signal(13, (*void)(int64)1);
        _ftls_sigpipe_off = true;
    }
#endif
    *void ssl = _ftls_call_p(_ftls_sym("SSL_new"), ctx);
    if (ssl == null) {
        return null;
    }
    if (_ftls_call_ii(_ftls_sym("SSL_set_fd"), ssl, fd) != 1) {
        _ftls_call_v(_ftls_sym("SSL_free"), ssl);
        return null;
    }
    if (_ftls_is_ip(host) == 0) {
        // SSL_set_tlsext_host_name is a macro: SSL_ctrl(ssl, 55, 0, name).
        _ftls_call_ilp(_ftls_sym("SSL_ctrl"), ssl, 55, 0, (*void)host);
    }
    if (verify != 0 && _ftls_call_is(_ftls_sym("SSL_set1_host"), ssl, host) != 1) {
        _ftls_call_v(_ftls_sym("SSL_free"), ssl);
        return null;
    }
    return ssl;
}

// The outcome of an SSL_* call that returned `ret`: 0 for success, the WANT
// constants, or -1 for an error (SSL_ERROR_SYSCALL, SSL_ERROR_SSL) and -6 for
// a clean close (SSL_ERROR_ZERO_RETURN).
int _ftls_outcome(*void ssl, int ret) {
    const int e = _ftls_call_ii(_ftls_sym("SSL_get_error"), ssl, ret);
    if (e == _FTLS_WANT_READ || e == _FTLS_WANT_WRITE) {
        return e;
    }
    if (e == 6) {
        return -6;
    }
    return -1;
}

// One handshake step: 0 when it is done, _FTLS_WANT_READ / _FTLS_WANT_WRITE to
// wait and call again, -1 when it failed.
int _ftls_handshake(*void ssl) {
    _ftls_clear_errors();
    const int r = _ftls_call_i(_ftls_sym("SSL_connect"), ssl);
    if (r == 1) {
        return 0;
    }
    const int o = _ftls_outcome(ssl, r);
    return o > 0 ? o : -1;
}

// Read up to `cap` bytes: the count, 0 at the end of the stream (close_notify),
// a WANT constant (negated: -2 read, -3 write) to wait and call again, or -1. A
// peer that closes without close_notify is -1, so a body that ends with the
// connection cannot be cut short by a forged TCP close.
int64 _ftls_read(*void ssl, *uint8 buf, int64 cap) {
    if (cap > 1073741824) {
        cap = 1073741824;
    }
    _ftls_clear_errors();
    const int r = _ftls_call_ipi(_ftls_sym("SSL_read"), ssl, (*void)buf, (int)cap);
    if (r > 0) {
        return (int64)r;
    }
    const int o = _ftls_outcome(ssl, r);
    if (o == _FTLS_WANT_READ) {
        return -2;
    }
    if (o == _FTLS_WANT_WRITE) {
        return -3;
    }
    return o == -6 ? 0 : -1;
}

// Write up to `n` bytes: the count written, -2 / -3 to wait, or -1.
int64 _ftls_write(*void ssl, *uint8 buf, int64 n) {
    if (n > 1073741824) {
        n = 1073741824;
    }
    _ftls_clear_errors();
    const int r = _ftls_call_ipi(_ftls_sym("SSL_write"), ssl, (*void)buf, (int)n);
    if (r > 0) {
        return (int64)r;
    }
    const int o = _ftls_outcome(ssl, r);
    if (o == _FTLS_WANT_READ) {
        return -2;
    }
    if (o == _FTLS_WANT_WRITE) {
        return -3;
    }
    return -1;
}

// Why the certificate check failed (into `out`), when it did: 1, else 0.
int _ftls_verify_error(*void ssl, String* out) {
    *void p = _ftls_sym("SSL_get_verify_result");
    if (p == null) {
        return 0;
    }
    // A C long: only the low 32 bits are read (Windows' long is 32-bit).
    const int code = _ftls_call_i(p, ssl);
    if (code == 0) {
        return 0;
    }
    out.append("certificate verify failed: ");
    *void es = _ftls_sym("X509_verify_cert_error_string");
    if (es != null) {
        out.append(_ftls_call_s(es, (*void)(int64)code));
    } else {
        String_appendf(out, "X509 error %d", code);
    }
    return 1;
}

void _ftls_free(*void ssl) {
    if (ssl == null) {
        return;
    }
    _ftls_clear_errors();
    _ftls_call_i(_ftls_sym("SSL_shutdown"), ssl);
    _ftls_call_v(_ftls_sym("SSL_free"), ssl);
}
