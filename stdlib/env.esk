// env.esk — environment variables.
//
//   import <env>;
//   string home = env_get("HOME");          // null if unset
//   int port    = env_get_int("PORT", 8080); // parsed, or the fallback
//
//   env_set("MODE", "fast");                 // 0, or -1 on failure
//   env_unset("MODE");
//   let all: List<String>;  List_init<String>(&all, 32);
//   env_list(&all);                           // sorted "NAME=value" entries
//   fs_list_free(&all);
//
// CLI arguments come straight from `int main(int argc, string* argv)`; this
// module covers the process environment. Changes made with env_set/env_unset
// are seen by env_get and inherited by processes started afterwards (<process>).

import <c/stdlib>;   // getenv, atoi
import <fs>;   // String/List helpers, UTF-16 conversion on Windows

#ifdef _WIN32
extern int _putenv_s(string name, string value);
extern int SetEnvironmentVariableW(*uint16 name, *uint16 value);
extern *uint16 GetEnvironmentStringsW();
extern int FreeEnvironmentStringsW(*uint16 block);
#else
extern int setenv(string name, string value, int overwrite);
extern int unsetenv(string name);
#ifdef __APPLE__
extern **string _NSGetEnviron();
#else
extern *string environ;
#endif
#endif

// The value of an environment variable, or null if it is not set.
string env_get(string name) {
    return getenv(name);
}

// 1 if the variable is set, else 0.
int env_has(string name) {
    return getenv(name) != null ? 1 : 0;
}

// The variable's value, or `fallback` if it is not set.
string env_get_or(string name, string fallback) {
    const string v = getenv(name);
    return v == null ? fallback : v;
}

// The variable parsed as a decimal integer, or `fallback` if it is unset, not a
// number (anything but optional surrounding spaces/tabs, an optional sign, and
// digits), or out of the int range.
int env_get_int(string name, int fallback) {
    const string v = getenv(name);
    if (v == null) {
        return fallback;
    }
    int i = 0;
    while (v[i] == ' ' || v[i] == '\t') {
        i++;
    }
    bool neg = false;
    if (v[i] == '-') {
        neg = true;
        i++;
    } else if (v[i] == '+') {
        i++;
    }
    int64 n = 0;
    int digits = 0;
    for (; v[i] >= '0' && v[i] <= '9'; i++) {
        n = n * 10 + (int64)((int)v[i] - 48);
        if (n > 2147483648) {
            return fallback;
        }
        digits++;
    }
    while (v[i] == ' ' || v[i] == '\t') {
        i++;
    }
    if (digits == 0 || v[i] != 0) {
        return fallback;
    }
    if (neg) {
        n = -n;
    }
    if (n > 2147483647 || n < -2147483648) {
        return fallback;
    }
    return (int)n;
}

// 1 if `name` can name a variable: non-empty and without '='.
int _env_name_ok(string name) {
    if (name == null || name[0] == 0) {
        return 0;
    }
    for (int i = 0; name[i] != 0; i++) {
        if (name[i] == '=') {
            return 0;
        }
    }
    return 1;
}

// Set (or replace) a variable. 0, or -1 for an invalid name or a failure.
// On Windows an empty value removes the variable (the C runtime's rule).
int env_set(string name, string value) {
    if (_env_name_ok(name) == 0 || value == null) {
        return -1;
    }
#ifdef _WIN32
    if (_putenv_s(name, value) != 0) {
        return -1;
    }
    *uint16 wn = _fs_wide(name);
    *uint16 wv = _fs_wide(value);
    int ok = 0;
    if (wn != null && wv != null) {
        ok = SetEnvironmentVariableW(wn, value[0] == 0 ? null : wv);
    }
    free((*void)wn);
    free((*void)wv);
    return ok != 0 ? 0 : -1;
#else
    return setenv(name, value, 1) == 0 ? 0 : -1;
#endif
}

// Remove a variable (removing an unset one is success). 0, or -1.
int env_unset(string name) {
    if (_env_name_ok(name) == 0) {
        return -1;
    }
#ifdef _WIN32
    _putenv_s(name, "");
    *uint16 wn = _fs_wide(name);
    if (wn == null) {
        return -1;
    }
    SetEnvironmentVariableW(wn, null);
    free((*void)wn);
    return 0;
#else
    return unsetenv(name) == 0 ? 0 : -1;
#endif
}

// Append every variable to `out` as a "NAME=value" String, sorted bytewise;
// returns how many were added. Free the list with fs_list_free.
int env_list(List<String>* out) {
    let all: List<String>;
    List_init<String>(&all, 64);
#ifdef _WIN32
    *uint16 block = GetEnvironmentStringsW();
    if (block != null) {
        *uint16 p = block;
        while (p[0] != (uint16)0) {
            int64 n = 0;
            while (p[n] != (uint16)0) {
                n++;
            }
            // Entries starting with '=' are per-drive working directories, not variables.
            if (p[0] != (uint16)61) {
                let s: String;
                s.init(n + 1);
                _fs_append_wide(&s, p);
                List_push<String>(&all, s);
            }
            p = p + n + 1;
        }
        FreeEnvironmentStringsW(block);
    }
#else
#ifdef __APPLE__
    *string env = *_NSGetEnviron();
#else
    *string env = environ;
#endif
    for (int i = 0; env != null && env[i] != null; i++) {
        let s: String;
        s.from(env[i]);
        List_push<String>(&all, s);
    }
#endif
    _fs_sort(&all);
    const int n = List_len<String>(&all);
    for (i in 0..n) {
        List_push<String>(out, List_get<String>(&all, i));
    }
    List_free<String>(&all);
    return n;
}
