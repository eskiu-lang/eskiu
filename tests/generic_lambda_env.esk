// A lambda in a generic body gets a stack env when no instance lets it escape: passed to
// a non-escaping param, directly or through generics that only call or forward it.
// One passed to a generic that keeps its param (marked `escaping` or not) keeps a heap
// env and still works after the creating call returned. tests/run.sh and
// tests/selfhost/cg_parity.sh count the heap envs in the gl_ functions (3).
import <io>;
import <sort>;

fn()->int gl_kept;

int gl_apply(int x, fn(int)->int f) { return f(x); }
int gl_add<T>(T k) { return gl_apply(1, int(int v) { return v + (int)k; }); }

int gl_call<T>(T x, fn(int)->int f) { return f((int)x); }
int gl_twice<T>(T x, fn(int)->int f) { return gl_call<T>(x, f) + gl_call(x, f); }
int gl_scale<T>(T k) { return gl_twice<T>(k, int(int v) { return v * (int)k; }); }

void gl_keep<T>(T x, fn()->int f) { gl_kept = f; }
void gl_store<T>(T k) { gl_keep<T>(k, int() { return (int)k + 100; }); }
void gl_pass<T>(T k, fn()->int f) { gl_keep<T>(k, f); }
void gl_store2<T>(T k) { gl_pass<T>(k, int() { return (int)k + 200; }); }
void gl_keep_marked<T>(T x, escaping fn()->int f) { gl_kept = f; }
void gl_store3<T>(T k) { gl_keep_marked<T>(k, int() { return (int)k + 300; }); }

int gl_cmp(*int a, *int b) { return *a - *b; }

// Overwrites the stack where a returned frame was.
void gl_clobber() {
    int[64] junk;
    for (i in 0..64) { junk[i] = i * 7; }
    printf("%d\n", junk[63] - 441);
}

int main() {
    printf("%d %d\n", gl_add<int>(41), gl_add<int64>(1));
    printf("%d\n", gl_scale<int>(3));
    int[5] xs = {5, 3, 4, 1, 2};
    sort<int>(&xs[0], 5, gl_cmp);
    printf("%d %d %d %d %d\n", xs[0], xs[1], xs[2], xs[3], xs[4]);
    gl_store<int>(1);
    gl_clobber();
    printf("%d\n", gl_kept());
    gl_store2<int>(2);
    gl_clobber();
    printf("%d\n", gl_kept());
    gl_store3<int>(3);
    gl_clobber();
    printf("%d\n", gl_kept());
    return 0;
}
