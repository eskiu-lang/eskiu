// `thread_create`/`thread_join`: output order is non-deterministic.
extern int printf(string fmt, ...);
extern int sleep(int seconds);

int main() {
    printf("main: starting threads\n");

    int id1 = 1;
    int id2 = 2;

    // Closures that capture their thread id
    let worker1: fn()->void = void() {
        printf("thread %d: hello\n", id1);
    };

    let worker2: fn()->void = void() {
        printf("thread %d: hello\n", id2);
    };

    // Joined one at a time so the two lines print in a fixed order.
    *void t1 = thread_create(worker1);
    thread_join(t1);
    *void t2 = thread_create(worker2);
    thread_join(t2);
    free_closure(worker1);   // a closure value passed to thread_create stays its owner's
    free_closure(worker2);

    printf("main: all threads done\n");
    return 0;
}
