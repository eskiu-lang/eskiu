import <list>;

struct Point { int x; int y; }
union Bits { int i; float f; }
enum Color { Red, Green }
enum Shape { Circle(int), Square(int) }
interface Shower { int show(); }
type Pt = Point;
struct Box<T: Shower> { T v; }

int Point_show(*Point self) { return self.x; }

Point make(Pt a, *Point b, ?*Point c, Point[] s, Color k) {
    Point[2] arr;
    let l: List<Point>;
    int n = (int)sizeof(Point) + (int)k;
    Shape sh = Circle(n);
    Bits u;
    *Point q = (*Point)b;
    return Point{x: a.x + arr[0].y + s.len, y: q.y};
}

int main() {
    let b: Box<Point>;
    Point[2] pa;
    return make(Point{x: 1, y: 2}, null, null, pa[0..2], Red).x;
}
