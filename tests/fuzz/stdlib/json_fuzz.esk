// Fuzz target: <json> json_parse (and json_parse_doc, which must agree) on arbitrary
// text, then a walk of the whole tree.
import "harness.esk";
import <json>;
import <string>;

int64 json_walk(JsonValue* v, int depth) {
    int64 h = (int64)v.kind;
    if (v.kind == JString) { h = h + (int64)v.str.len; }
    if (v.kind == JNumber) { h = h + (int64)(v.num != v.num); }
    h = h + (int64)v.key.len;
    if (depth > 100000) { fuzz_fail("tree deeper than the input"); }
    *JsonValue c = v.child;
    int n = 0;
    while (c != null) { h = h * (int64)31 + json_walk(c, depth + 1); c = c.next; n = n + 1; }
    if ((v.kind == JArray || v.kind == JObject) && n != JsonValue_len(v)) { fuzz_fail("JsonValue_len disagrees with the children"); }
    if (v.kind == JObject && n > 0) {
        *JsonValue first = JsonValue_get(v, (string)String_cstr(&v.child.key));
        if (first == null) { fuzz_fail("JsonValue_get misses a present key"); }
        // The same member through a ["key"] path step (a key without NUL bytes).
        *String k = &v.child.key;
        if (String_index_of(k, (char)0) < 0) {
            let path: String;  path.init(16);
            path.append("[\"");
            for (i in 0..k.len) {
                if (k.data[i] == '"' || k.data[i] == '\\') { path.push('\\'); }
                path.push(k.data[i]);
            }
            path.append("\"]");
            if (json_get(v, path.cstr()) != first) { fuzz_fail("json_get [\"key\"] misses a present key"); }
            path.free();
        }
    }
    if (v.kind == JArray && n > 0 && json_get(v, "[0]") != v.child) { fuzz_fail("json_get [0] misses the first element"); }
    if (json_get(v, "") != v) { fuzz_fail("json_get of an empty path is not the value"); }
    if (v.kind == JArray && n > 0 && JsonValue_at(v, n - 1) == null) { fuzz_fail("JsonValue_at misses the last element"); }
    return h;
}

// stringify(parse(stringify(v))) must equal stringify(v), and the pretty form
// must parse back to the same compact text.
void json_roundtrip(JsonValue* v) {
    let a: String;  a.init(64);
    let b: String;  b.init(64);
    JsonValue_stringify(v, &a);
    *JsonValue w = json_parse((string)a.data);
    if (w == null) { fuzz_fail("stringify output does not parse"); }
    JsonValue_stringify(w, &b);
    if (String_eq(&a, &b) == 0) { fuzz_fail("stringify is not stable across a parse"); }
    JsonValue_free(w);
    JsonValue_pretty(v, 2, &b);
    w = json_parse((string)b.data);
    if (w == null) { fuzz_fail("pretty output does not parse"); }
    JsonValue_stringify(w, &b);
    if (String_eq(&a, &b) == 0) { fuzz_fail("pretty does not round-trip"); }
    JsonValue_free(w);
    a.free();
    b.free();
}

void fuzz_one(*uint8 data, int len, string s) {
    *JsonValue v = json_parse(s);
    // json_parse_doc accepts exactly what json_parse accepts, into the same tree.
    JsonDoc doc = json_parse_doc(s);
    if ((v == null) != (doc.root == null)) { fuzz_fail("json_parse_doc and json_parse disagree on validity"); }
    if (v != null) {
        json_walk(v, 0);
        json_walk(doc.root, 0);
        let a: String;  a.init(64);
        let b: String;  b.init(64);
        JsonValue_stringify(v, &a);
        JsonValue_stringify(doc.root, &b);
        if (String_eq(&a, &b) == 0) { fuzz_fail("json_parse_doc and json_parse trees differ"); }
        a.free();
        b.free();
        json_roundtrip(v);
        JsonValue_free(v);
    }
    JsonDoc_free(&doc);
    // The input as a path, over a fixed document.
    *JsonValue d = json_parse("{\"a\":{\"b\":[1,{\"c\":\"x\"}]},\"a.b\":[[2]],\"\":3}");
    json_get(d, s);
    JsonValue_free(d);
}
