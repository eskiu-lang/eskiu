// Fuzz target: <regex> compile of an arbitrary pattern (the input's first line) and a
// search of the rest of the input, reading back every capture group.
import "harness.esk";
import <regex>;
import <string>;

void fuzz_one(*uint8 data, int len, string s) {
    int nl = 0;
    while (nl < len && data[nl] != 10) { nl = nl + 1; }
    *uint8 pat = alloc<uint8>(nl + 1);
    int i = 0;
    while (i < nl) { pat[i] = data[i]; i = i + 1; }
    pat[nl] = (uint8)0;
    string text = "";
    if (nl < len) { text = (string)((*uint8)s + nl + 1); }

    Regex re = regex_compile((string)pat);
    if (re.ok == 1) {
        let m: Match;
        int hit = Regex_search(&re, text, &m);
        if (hit == 1) {
            if (m.start < 0 || m.end < m.start) { fuzz_fail("match bounds"); }
            int g = 0;
            while (g <= m.ngroup) {
                let grp: String; String_init(&grp, 8);
                Match_group(&m, text, g, &grp);
                String_free(&grp);
                g = g + 1;
            }
        }
        Match_free(&m);
        // Every match, in order and in bounds, with the text's own length (no NUL
        // read), and a search from the middle that cannot start before it.
        const int64 tlen = (int64)(len - nl - 1 > 0 ? len - nl - 1 : 0);
        RegexIter it = Regex_iter(&re, text, tlen);
        int64 last = 0;
        while (RegexIter_next(&it, &m) == 1) {
            if ((int64)m.start < last || m.end < m.start || (int64)m.end > tlen) { fuzz_fail("iter bounds"); }
            last = (int64)m.end;
        }
        Match_free(&m);
        if (Regex_search_at(&re, text, tlen, tlen / 2, &m) == 1) {
            if ((int64)m.start < tlen / 2 || m.end < m.start || (int64)m.end > tlen) { fuzz_fail("search_at bounds"); }
        }
        Match_free(&m);
    }
    Regex_free(&re);
    free(pat);
}
