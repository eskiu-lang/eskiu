// `if`/`else if`/`else`, `while`, `for`, `break`, `continue`.
extern int printf(string fmt, ...);

int main() {
    // if / else if / else
    int n = 7;
    if (n < 0) {
        printf("neg\n");
    } else if (n == 0) {
        printf("zero\n");
    } else {
        printf("pos\n");                 // pos
    }

    // while loop with accumulator
    int sum = 0;
    int i = 1;
    while (i <= 5) {
        sum = sum + i;
        i = i + 1;
    }
    printf("sum=%d\n", sum);             // sum=15

    // for loop
    int prod = 1;
    for (int k = 1; k <= 4; k = k + 1) {
        prod = prod * k;
    }
    printf("prod=%d\n", prod);           // prod=24

    // break
    int found = 0;
    for (int j = 0; j < 100; j = j + 1) {
        if (j == 9) { found = j; break; }
    }
    printf("found=%d\n", found);         // found=9

    // continue (count evens 0..9)
    int evens = 0;
    for (int m = 0; m < 10; m = m + 1) {
        if (m % 2 == 1) { continue; }
        evens = evens + 1;
    }
    printf("evens=%d\n", evens);         // evens=5

    return 0;
}
