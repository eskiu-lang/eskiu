// A struct literal's array field takes `{...}` (nested, zero-filled) in a local, an
// assignment, a bitfield struct and a global.
extern int printf(string fmt, ...);
struct S { int a; int[2] b; int[2][2] m; }
struct B { uint8 f : 4; int[3] v; }
S g = S{a: 1, b: {10, 20}, m: {{1, 2}, {3}}};
int main() {
    S s = S{a: 1, b: {10, 20}, m: {{5}, {6, 7}}};
    printf("%d %d %d %d %d %d\n", s.a, s.b[0], s.b[1], s.m[0][0], s.m[0][1], s.m[1][1]);
    s = S{a: 2, b: {30}};
    printf("%d %d %d %d\n", s.a, s.b[0], s.b[1], s.m[1][1]);
    B b = B{f: 9, v: {4, 5}};
    printf("%d %d %d %d\n", b.f, b.v[0], b.v[1], b.v[2]);
    printf("%d %d %d\n", g.b[1], g.m[1][0], g.m[1][1]);
    return 0;
}
