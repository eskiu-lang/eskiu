plain:
  [3] <a>/1 <b>/1 <c>/1
  [3] <1>/1 <2>/1 <3>/1
  end 0 '' again 0 out-of-range 1 -1
crlf and cr:
  [2] <a>/1 <b>/1
  [2] <1>/1 <2>/1
  [2] <3>/1 <4>/1
  end 0 '' again 0 out-of-range 1 -1
quoted:
  [3] <x,y>/3 <say "hi">/8 <two
lines>/9
  [2] <end>/3 <>/0
  end 0 '' again 0 out-of-range 1 -1
blank line:
  [1] <a>/1
  [1] <>/0
  [1] <b>/1
  end 0 '' again 0 out-of-range 1 -1
trailing delimiter:
  [2] <a>/1 <>/0
  [2] <>/0 <b>/1
  end 0 '' again 0 out-of-range 1 -1
semicolon:
  [3] <a>/1 <b,c>/3 <d;e>/3
  end 0 '' again 0 out-of-range 1 -1
empty:
  end 0 '' again 0 out-of-range 1 -1
one newline:
  [1] <>/0
  end 0 '' again 0 out-of-range 1 -1
unterminated:
  [2] <ok>/2 <row>/3
  end -1 'line 2, col 5: unterminated quoted field' again 0 out-of-range 1 -1
after quote:
  [1] <a>/1
  end -1 'line 2, col 4: unexpected character after a closing quote' again 0 out-of-range 1 -1
bad delimiter:
  end -1 'line 1, col 1: the delimiter cannot be a quote or a line ending' again 0 out-of-range 1 -1
nul in quotes:
  [2] <a>/3 <c>/1
  [1] <d>/1
  end 0 '' again 0 out-of-range 1 -1
