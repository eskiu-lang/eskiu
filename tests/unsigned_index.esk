// An unsigned index narrower than 64 bits is zero-extended (C): a uint8 255 is
// element 255, not -1, for arrays, pointers and slices, reads and writes.
import <io>;

float[256] table;
float[65536] wide;

int main() {
    for (i in 0..256) table[i] = (float)i;
    wide[65535] = 7.0;
    uint8[3] idx = {255, 200, 128};
    *uint8 ip = &idx[0];
    uint8 b = 255;
    uint16 w = 65535;
    *float p = &table[0];
    float[] s = table[0..256];
    printf("%.0f %.0f %.0f %.0f %.0f\n", (double)table[ip[0]], (double)table[idx[1]], (double)p[b], (double)s[idx[2]], (double)wide[w]);
    table[b] = -1.0;
    p[idx[1]] = -2.0;
    printf("%.0f %.0f %.0f\n", (double)table[255], (double)table[200], (double)*(p + b));
    float sum = 0.0;
    for (k in 0..3) sum = sum + table[ip[k]];
    printf("%.0f\n", (double)sum);
    return 0;
}
