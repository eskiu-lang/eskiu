// A lambda typed by a type parameter (`T() {...}`, `fn(T)->T`) in a generic function or
// inline method.
extern int printf(string f, ...);
struct Box<T> { T v; fn()->T getter() { T c = self.v; return T() { return c; }; } }
fn()->T konst<T>(T v) { return T() { return v; }; }
T twice<T>(T v) { fn(T)->T d = T(T x) { return x + x; }; return d(v); }
int main() {
    let b: Box<int>; b.v = 5;
    fn()->int g = b.getter();
    fn()->double k = konst<double>(2.5);
    printf("%d %.1f\n", g(), k());
    printf("%d %.1f\n", twice<int>(5), twice<double>(1.5));
    return 0;
}
