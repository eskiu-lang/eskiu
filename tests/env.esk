// `<env>` `env_get`/`has`/`get_or`/`get_int`.
import <env>;

extern int printf(string fmt, ...);

int main() {
    // PATH is set in every shell environment.
    if (env_has("PATH") == 1)                 { printf("has_path\n"); }
    if (env_get("ESKIU_DOES_NOT_EXIST_XYZ") == null) { printf("unset_null\n"); }
    printf("%s\n", env_get_or("ESKIU_DOES_NOT_EXIST_XYZ", "fallback"));
    printf("%d\n", env_get_int("ESKIU_DOES_NOT_EXIST_XYZ", 42));
    return 0;
}
