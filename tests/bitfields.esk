// Bitfield assignment + masked read; signed fields sign-extend.
extern int printf(string fmt, ...);

struct Flags {
    uint32 a : 1;
    uint32 b : 3;
    uint32 c : 4;
    int    tag;        // a normal field after the bitfields
}

struct Signed {
    int x : 4;         // signed 4-bit field, range -8..7
}

int main() {
    // Field assignment + read
    Flags f;
    f.a = 1;
    f.b = 5;
    f.c = 9;
    f.tag = 42;
    printf("%d %d %d %d\n", f.a, f.b, f.c, f.tag);   // 1 5 9 42

    // Updating one field leaves the neighbours in the same word intact
    f.b = 2;
    printf("%d %d %d\n", f.a, f.b, f.c);             // 1 2 9

    // Struct literal initialisation
    Flags g = Flags { a: 1, b: 7, c: 15 };
    printf("%d %d %d\n", g.a, g.b, g.c);             // 1 7 15

    // Signed bitfield sign-extends
    Signed s;
    s.x = 7;
    printf("%d\n", s.x);                             // 7
    s.x = 0 - 1;
    printf("%d\n", s.x);                             // -1

    return 0;
}
