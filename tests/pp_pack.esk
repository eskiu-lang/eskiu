// Backslash-continued function-like macro; `#pragma pack`.
extern int printf(string fmt, ...);

// Multi-line (backslash-continued) function-like macro: (x+1)^2 expanded.
#define POLY(x) \
    ((x) * (x) \
     + 2 * (x) \
     + 1)

// Natural layout: uint8 + uint32 padded to 8 bytes.
struct Natural {
    uint8  tag;
    uint32 value;
}

// Explicit packed qualifier: 5 bytes, no padding.
packed struct PackedKw {
    uint8  tag;
    uint32 value;
}

// #pragma pack(1) applies to structs declared under it.
#pragma pack(push, 1)
struct PackedPragma {
    uint8  tag;
    uint32 value;
}
#pragma pack(pop)

// After pop, back to natural alignment.
struct NaturalAgain {
    uint8  tag;
    uint32 value;
}

int main() {
    printf("%d\n", POLY(3));   // (3+1)^2 = 16
    printf("%d\n", POLY(0));   // 1
    printf("%d\n", POLY(9));   // 100

    printf("%lld\n", sizeof(Natural));      // 8
    printf("%lld\n", sizeof(PackedKw));     // 5
    printf("%lld\n", sizeof(PackedPragma)); // 5
    printf("%lld\n", sizeof(NaturalAgain)); // 8
    return 0;
}
