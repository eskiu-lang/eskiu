// `for x in …` over a fixed-size array.
extern int printf(string fmt, ...);

import <list>;

struct Bag {
    int[4] vals;
}

int main() {
    // for-in over a fixed-size array field
    let b: Bag;
    b.vals[0] = 10;
    b.vals[1] = 20;
    b.vals[2] = 30;
    b.vals[3] = 40;
    let sum: int = 0;
    for (v in b.vals) {
        sum += v;
    }
    printf("%d\n", sum);          // 100

    // for-in over a List<int>
    let nums: List<int>;
    nums.init(4);
    let i: int = 0;
    while (i < 5) {
        nums.push(i);
        i += 1;
    }
    let total: int = 0;
    for (n in nums) {
        if (n == 2) { continue; }  // skip 2; continue must still advance
        total += n;
    }
    printf("%d\n", total);        // 0+1+3+4 = 8

    nums.free();
    return 0;
}
