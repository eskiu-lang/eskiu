// An empty slice `s[len..len]` at the end is valid; a mid slice reads the right element.
extern int printf(string fmt, ...);
int main() {
    int[5] a; for (i in 0..5) { a[i] = i; }
    int[] s = a[0..5];
    int[] e = s[5..5];          // valid empty slice at the end
    printf("len=%lld\n", e.len);
    int[] mid = a[1..3];
    printf("mid=%lld %d\n", mid.len, mid[1]);
    return 0;
}
