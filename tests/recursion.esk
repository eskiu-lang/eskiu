// Self-recursion: factorial, fibonacci, Ackermann.
extern int printf(string fmt, ...);

int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

// Ackermann — deeper nested self-recursion
int ack(int m, int n) {
    if (m == 0) { return n + 1; }
    if (n == 0) { return ack(m - 1, 1); }
    return ack(m - 1, ack(m, n - 1));
}

int main() {
    printf("%d\n", factorial(5));   // 120
    printf("%d\n", fib(10));        // 55
    printf("%d\n", ack(2, 3));      // 9
    return 0;
}
