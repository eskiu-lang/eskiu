// Multidimensional `int[N][M]` in C order: the leftmost bracket is the outer dimension.
extern int printf(string fmt, ...);

// Multidimensional arrays follow C order: `int[N][M]` is N rows of M, so the
// leftmost bracket is the outer dimension and a[i] selects a row.
int main() {
    int[2][3] a = { {1,2,3}, {4,5,6} };
    int[2][2] b = { {7,8} };              // second row zero-filled
    int[2][2][2] c = { { {1,2},{3,4} }, { {5,6},{7,8} } };

    a[1][1] = 50;
    b[1][0] = 9;

    printf("%d %d %d\n", a[0][0], a[0][2], a[1][1]);   // 1 3 50
    printf("%d %d %d\n", b[0][0], b[1][0], b[1][1]);   // 7 9 0
    printf("%d %d %d\n", c[0][0][0], c[1][0][1], c[1][1][1]);   // 1 6 8

    int s = 0;
    for (i in 0..2) { for (j in 0..3) { s = s + a[i][j]; } }
    printf("sum=%d\n", s);   // 1+2+3+4+50+6 = 66
    return 0;
}
