// Slice `T[]` fat pointer: carries its length and aliases the backing array.
extern int printf(string fmt, ...);

// A slice `T[]` is a fat pointer (data + length). It carries its length, so a
// function never needs a separate count argument, and it aliases the backing array.
int sum(int[] s) {
    int total = 0;
    for (x in s) { total = total + x; }
    return total;
}

int main() {
    int[6] a = {10, 20, 30, 40, 50, 60};

    int[] mid = a[1..4];                 // view of {20, 30, 40}, len 3
    printf("len=%lld first=%d\n", mid.len, mid[0]);   // 3, 20

    mid[1] = 99;                          // writes through to a[2]
    printf("a2=%d\n", a[2]);              // 99

    printf("sum(mid)=%d\n", sum(mid));    // 20 + 99 + 40 = 159
    printf("sum(all)=%d\n", sum(a[0..6]));// whole array as a slice: 10+20+99+40+50+60 = 279

    return 0;
}
