// `catch (T e)` / `catch (Err<T> e)` in a generic body matches the instance's thrown type.
extern int printf(string f, ...);
struct Err<T> { T v; }
struct Plain { int v; }
int a2<T>(T v) { try { throw Plain{v: 2}; } catch (Plain e) { return e.v; } return 0; }
int a3<T>(T v) { try { throw Err<T>{v: v}; } catch (Err<T> e) { return (int)e.v; } return 0; }
int a4<T>(T v) { try { throw v; } catch (T e) { return (int)e + 1; } return 0; }
int a5<T>(T v) { try { throw v; } catch (Err<T> e) { return 0; } catch (T e) { return 5; } return 0; }
int main() {
    printf("%d %d %d %d\n", a2<int>(0), a3<int>(3), a4<int>(3), a5<double>(1.0));
    printf("%d %d\n", a3<double>(7.0), a4<int8>((int8)9));
    return 0;
}
