// An array of closures `fn(int)->int[3]` (indexed and called) and a pointer to a closure
// `*fn(int)->int` (`&f`, `*pf`, store through it).
extern int printf(string fmt, ...);
int dbl(int x) { return x * 2; }
int inc(int x) { return x + 1; }
int main() {
    let fs: fn(int)->int[3];
    fs[0] = dbl; fs[1] = inc; fs[2] = dbl;
    printf("%d %d %d\n", fs[0](5), fs[1](5), fs[2](fs[1](1)));
    int[3] a = {1, 2, 3};
    fn()->int[3] gs;
    int i = 0;
    for (v in a) { gs[i] = int() { return v * 10; }; i++; }
    printf("%d %d %d\n", gs[0](), gs[1](), gs[2]());
    let f: fn(int)->int = dbl;
    let pf: *fn(int)->int = &f;
    let g: fn(int)->int = *pf;
    *pf = inc;
    printf("%d %d %d\n", g(4), f(4), (*pf)(9));
    return 0;
}
