// `<http2>` 9-byte frame-header encode/decode round-trip (incl. 31-bit stream id).
import <http2>;
extern int printf(string fmt, ...);
int main() {
    // Encode a HEADERS frame: length=4096, type=HEADERS, flags=END_HEADERS|END_STREAM, stream=5.
    uint8[9] buf;
    let f: H2Frame;
    f.length = 4096; f.type = H2_HEADERS; f.flags = H2_FLAG_END_HEADERS | H2_FLAG_END_STREAM; f.stream_id = 5;
    h2_write_header(&buf[0], &f);
    // Decode it back.
    let g: H2Frame;
    h2_read_header(&buf[0], &g);
    printf("%d %d %d %d\n", g.length, g.type, g.flags, g.stream_id);   // 4096 1 5 5
    // A large stream id round-trips through 31 bits.
    f.length = 0; f.type = H2_DATA; f.flags = 0; f.stream_id = 2147483647;  // 2^31-1
    h2_write_header(&buf[0], &f);
    h2_read_header(&buf[0], &g);
    printf("%d %d\n", g.stream_id, (g.stream_id == 2147483647));  // 2147483647 1
    return 0;
}
