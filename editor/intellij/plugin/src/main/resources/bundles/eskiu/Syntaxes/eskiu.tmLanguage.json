{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eskiu",
  "scopeName": "source.eskiu",
  "fileTypes": ["esk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#import" },
    { "include": "#type-alias" },
    { "include": "#operator-decl" },
    { "include": "#function-decl" },
    { "include": "#closure-type" },
    { "include": "#struct-decl" },
    { "include": "#union-decl" },
    { "include": "#interface-decl" },
    { "include": "#enum-decl" },
    { "include": "#member-access" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#generics" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {

    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#)\\s*(define|undef|ifdef|ifndef|if|elif|else|endif|pragma|error)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.directive.eskiu" },
            "2": { "name": "keyword.control.directive.eskiu" }
          }
        }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.eskiu",
          "match": "//.*$"
        },
        {
          "name": "comment.block.eskiu",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.eskiu" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.comment.end.eskiu" } }
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.eskiu",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.eskiu" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.eskiu" } },
      "patterns": [
        {
          "name": "constant.character.escape.eskiu",
          "match": "\\\\([ntrfvab\\\\\"'?]|[0-7]{1,3}|x[0-9A-Fa-f]{1,2})"
        }
      ]
    },

    "char-literals": {
      "name": "string.quoted.single.eskiu",
      "begin": "'",
      "end": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.eskiu" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.eskiu" } },
      "patterns": [
        { "name": "constant.character.escape.eskiu", "match": "\\\\." }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.eskiu",
          "match": "\\b0[xX]_?[0-9a-fA-F]+(_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.eskiu",
          "match": "\\b0[bB]_?[01]+(_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.eskiu",
          "match": "\\b[0-9]+(_[0-9]+)*\\.[0-9]+(_[0-9]+)*([eE][+-]?[0-9]+(_[0-9]+)*)?\\b|\\b[0-9]+(_[0-9]+)*[eE][+-]?[0-9]+(_[0-9]+)*\\b|(?<![\\w.])\\.[0-9]+(_[0-9]+)*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.eskiu",
          "match": "\\b[0-9]+(_[0-9]+)*\\b"
        }
      ]
    },

    "import": {
      "patterns": [
        {
          "comment": "Angle-bracket stdlib import: import <mem>;",
          "match": "^\\s*(import)\\s+(<)([a-zA-Z0-9_/]+)(>)",
          "captures": {
            "1": { "name": "keyword.declaration.eskiu" },
            "2": { "name": "punctuation.definition.import.begin.eskiu" },
            "3": { "name": "entity.name.namespace.eskiu" },
            "4": { "name": "punctuation.definition.import.end.eskiu" }
          }
        },
        {
          "comment": "Local file import: import \"path.esk\";",
          "match": "^\\s*(import)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.declaration.eskiu" },
            "2": { "name": "string.quoted.double.eskiu" }
          }
        }
      ]
    },

    "type-alias": {
      "comment": "Contextual: type Alias = Underlying;",
      "match": "^\\s*(type)\\s+([A-Za-z_][a-zA-Z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.declaration.eskiu" },
        "2": { "name": "entity.name.type.eskiu" },
        "3": { "name": "keyword.operator.assignment.eskiu" }
      }
    },

    "operator-decl": {
      "match": "\\b(operator)\\s*(\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%^&|~!=<>]|\\[\\])\\s*(?=\\()",
      "captures": {
        "1": { "name": "keyword.declaration.eskiu" },
        "2": { "name": "entity.name.function.eskiu" }
      }
    },

    "function-decl": {
      "patterns": [
        {
          "comment": "Function with closure return type: fn(params)->ret name(params)",
          "match": "\\b(fn)\\s*(\\([^)]*\\))\\s*(->)\\s*(\\*?[a-zA-Z_][a-zA-Z0-9_*]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:<([^>]+)>)?\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.eskiu" },
            "2": { "name": "punctuation.parenthesis.eskiu" },
            "3": { "name": "keyword.operator.arrow.eskiu" },
            "4": { "name": "support.type.primitive.eskiu" },
            "5": { "name": "entity.name.function.eskiu" },
            "6": { "name": "entity.name.type.parameter.eskiu" }
          }
        },
        {
          "comment": "Function declaration: [modifiers] [type] name<generics>(params)",
          "match": "(?:\\b(async|static|extern|intrinsic|must_use|export|const)\\s+)?(?:(\\*+\\s*)?(?:(void|int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|double|bool|char|string|va_list)|([A-Z][a-zA-Z0-9_]*(?:<[^>]+>)?))(\\s*\\*+)?)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:<([^>]+)>)?\\s*\\(",
          "captures": {
            "1": { "name": "storage.modifier.eskiu" },
            "2": { "name": "keyword.operator.dereference.eskiu" },
            "3": { "name": "support.type.primitive.eskiu" },
            "4": { "name": "entity.name.type.eskiu" },
            "5": { "name": "keyword.operator.dereference.eskiu" },
            "6": { "name": "entity.name.function.eskiu" },
            "7": { "name": "entity.name.type.parameter.eskiu" }
          }
        }
      ]
    },

    "closure-type": {
      "match": "\\b(fn)\\s*(\\([^)]*\\))\\s*(->)",
      "captures": {
        "1": { "name": "keyword.declaration.eskiu" },
        "2": { "name": "punctuation.parenthesis.eskiu" },
        "3": { "name": "keyword.operator.arrow.eskiu" }
      }
    },

    "struct-decl": {
      "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.eskiu" },
        "2": { "name": "entity.name.type.eskiu" }
      }
    },

    "union-decl": {
      "match": "\\b(union)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.eskiu" },
        "2": { "name": "entity.name.type.eskiu" }
      }
    },

    "interface-decl": {
      "match": "\\b(interface)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.eskiu" },
        "2": { "name": "entity.name.type.eskiu" }
      }
    },

    "enum-decl": {
      "match": "\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.eskiu" },
        "2": { "name": "entity.name.type.eskiu" }
      }
    },

    "member-access": {
      "patterns": [
        {
          "comment": "Method call: .method(",
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.eskiu" },
            "2": { "name": "entity.name.function.call.eskiu" }
          }
        },
        {
          "comment": "Field access: .field",
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.eskiu" },
            "2": { "name": "variable.other.member.eskiu" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "comment": "Labeled loop: label: for / while / do",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?=\\s*\\b(for|while|do)\\b)",
          "captures": {
            "1": { "name": "entity.name.label.eskiu" },
            "2": { "name": "punctuation.separator.label.eskiu" }
          }
        },
        {
          "comment": "Labeled jump: break / continue label;",
          "match": "\\b(break|continue)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.eskiu" },
            "2": { "name": "entity.name.label.eskiu" }
          }
        },
        {
          "name": "keyword.control.eskiu",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|in|await|match)\\b"
        },
        {
          "name": "keyword.control.exception.eskiu",
          "match": "\\b(try|catch|finally|throw|defer|errdefer)\\b"
        },
        {
          "name": "keyword.declaration.eskiu",
          "match": "\\b(let|struct|packed|union|interface|enum|fn|operator|extern|intrinsic|import)\\b"
        },
        {
          "name": "storage.modifier.eskiu",
          "match": "\\b(const|volatile|static|escaping|must_use|async)\\b"
        },
        {
          "comment": "deprecated(\"use X\") before a declaration (a contextual word, not a keyword)",
          "name": "storage.modifier.eskiu",
          "match": "^\\s*deprecated(?=\\s*\\(\\s*\")"
        },
        {
          "name": "keyword.other.eskiu",
          "match": "\\b(sizeof|free_closure|asm|alloc_with|thread_create|thread_join|va_start|va_arg|va_end)\\b"
        }
      ]
    },

    "types": {
      "name": "support.type.primitive.eskiu",
      "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|double|bool|char|string|void|va_list)\\b"
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.eskiu",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.eskiu",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.preprocessor.eskiu",
          "match": "\\b(__FILE__|__LINE__)\\b"
        }
      ]
    },

    "generics": {
      "comment": "Type arguments start right after a name (List<int>, f<T>); `i < n` is a comparison. The rule also ends before ; { } ( ) quotes = | & so a stray < never runs past its line.",
      "begin": "(?<=[A-Za-z0-9_])(<)(?=[A-Za-z0-9_*, <>\\[\\]?]*>)",
      "beginCaptures": {
        "1": { "name": "punctuation.bracket.angle.begin.eskiu" }
      },
      "end": "(>)|(?=[;{}()\"'=|&])",
      "endCaptures": {
        "1": { "name": "punctuation.bracket.angle.end.eskiu" }
      },
      "patterns": [
        { "include": "#types" },
        { "include": "#identifiers" },
        { "include": "#generics" },
        { "match": ",", "name": "punctuation.separator.comma.eskiu" },
        { "match": "\\*", "name": "keyword.operator.dereference.eskiu" }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.increment-decrement.eskiu",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.assignment.eskiu",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.comparison.eskiu",
          "match": "==|!=|<=|>=|<(?!<)|>(?!>)"
        },
        {
          "name": "keyword.operator.logical.eskiu",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.eskiu",
          "match": "&(?!&)|\\|(?!\\|)|\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.eskiu",
          "match": "\\+|-(?!>)|\\*|/(?!/)|%"
        },
        {
          "name": "keyword.operator.arrow.eskiu",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.eskiu",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.null-coalescing.eskiu",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.assignment.eskiu",
          "match": "(?<![=!<>])=(?!=)"
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "comment": "ALL_CAPS constants like SPIN_SECONDS, TICK_HZ",
          "name": "constant.other.caps.eskiu",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "comment": "Types starting with uppercase like Event, Point, or single-letter T",
          "name": "entity.name.type.eskiu",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "comment": "Call expressions: foo(",
          "name": "entity.name.function.call.eskiu",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }

  }
}
