// Part of codegen.esk (types and layout), imported from it in order; compile codegen.esk, not this file alone.

// ---- Type layout ----------------------------------------------------------------------
// Sizes and alignments are computed from the LLVM type text this codegen emits, with the
// DataLayout rules of the 64-bit hosts we target (iN/float/double/ptr naturally aligned,
// `{…}` padded per field and rounded to its max field align, `<{…}>` packed, `[N x T]`
// = N elements). Reading the emitted types (not re-deriving from Eskiu spellings) keeps
// `sizeof`, ADT payload slots and union/pack layouts equal to what LLVM (and the C++
// codegen, via DataLayout) sees for bitfield words, arrays, nested enums and unions.

// Emit a named type line `%name = type body` and record its body for the layout queries.
void cg_deftype(Codegen* g, string name, string body) {
    let d: CgSub;
    d.param = name;
    d.arg = body;
    List_push<CgSub>(&g.tydefs, d);
    NameIdx_push(&g.tydefs_ix, name);
    String_append(&g.globals, "%");
    String_append(&g.globals, name);
    String_append(&g.globals, " = type ");
    String_append(&g.globals, body);
    String_append(&g.globals, "\n");
}

// Body of an emitted named type ("" if not emitted yet).
string cg_tydef_body(Codegen* g, string name) {
    int i = NameIdx_first(&g.tydefs_ix, name);
    if (i < 0) {
        return "";
    }
    return List_get<CgSub>(&g.tydefs, i).arg;
}

*DeclNode cg_find_tydecl(Codegen* g, string name) {
    int i = NameIdx_first(&g.tydecls_ix, name);
    if (i < 0) {
        return null;
    }
    return List_get<*DeclNode>(&g.tydecls, i);
}

void cg_emit_tydecl(Codegen* g, *DeclNode d);                     // fwd: emits a type line on demand
int cg_ll_layout(Codegen* g, string s, int* pos, int* al);        // fwd: mutually recursive

void cg_ll_ws(string s, int* pos) {
    while ((int)s[pos[0]] == 32) {
        pos[0] = pos[0] + 1;
    }
}

int cg_ll_num(string s, int* pos) {
    int v = 0;
    while ((int)s[pos[0]] >= 48 && (int)s[pos[0]] <= 57) {
        if (v > 214748363) {   // saturates
            v = 2147483647;
        } else {
            v = v * 10 + ((int)s[pos[0]] - 48);
        }
        pos[0] = pos[0] + 1;
    }
    return v;
}

int cg_ll_kw(string s, int* pos, string kw) {                    // consume keyword `kw` if present
    int i = 0;
    while (kw[i] != 0) {
        if (s[pos[0] + i] != kw[i]) {
            return 0;
        }
        i = i + 1;
    }
    pos[0] = pos[0] + i;
    return 1;
}

// Fields of `{ … }` / `<{ … }>` after the opening brace, through the closing `}`.
// Layout sizes saturate at 2^31-1 instead of wrapping, so a huge type never looks small.
int cg_sat_add(int a, int b) {
    if (a > 2147483647 - b) {
        return 2147483647;
    }
    return a + b;
}

int cg_sat_mul(int a, int b) {
    if (a > 0 && b > 2147483647 / a) {
        return 2147483647;
    }
    return a * b;
}

int cg_ll_fields(Codegen* g, string s, int* pos, int* al, int pk) {
    int bytes = 0;
    int maxal = 1;
    cg_ll_ws(s, pos);
    while (s[pos[0]] != 0 && (int)s[pos[0]] != 125) {            // '}'
        int fal = 1;
        int fsz = cg_ll_layout(g, s, pos, &fal);
        if (pk == 1) {
            fal = 1;
        }
        if (fal > maxal) {
            maxal = fal;
        }
        bytes = cg_sat_add(cg_align_up(bytes, fal), fsz);
        cg_ll_ws(s, pos);
        if ((int)s[pos[0]] == 44) {       // ','
            pos[0] = pos[0] + 1;
        }
        cg_ll_ws(s, pos);
    }
    if (s[pos[0]] != 0) {
        pos[0] = pos[0] + 1;
    }
    al[0] = maxal;
    return cg_align_up(bytes, maxal);
}

// Layout of the named type `%name`, emitting its (pending) declaration first if needed.
int cg_ll_named(Codegen* g, string name, int* al) {
    string body = cg_tydef_body(g, name);
    if (body[0] == 0) {
        *DeclNode d = cg_find_tydecl(g, name);
        if (d != null) {
            cg_emit_tydecl(g, d);
            body = cg_tydef_body(g, name);
        }
    }
    if (body[0] == 0) {
        al[0] = 8;
        return 8;
    }
    int p = 0;
    return cg_ll_layout(g, body, &p, al);
}

// Size of the LLVM type starting at s[*pos] (advancing past it); its ABI alignment → *al.
int cg_ll_layout(Codegen* g, string s, int* pos, int* al) {
    cg_ll_ws(s, pos);
    int c = (int)s[pos[0]];
    al[0] = 1;
    if (c == 123) {   // '{'
        pos[0] = pos[0] + 1;
        return cg_ll_fields(g, s, pos, al, 0);
    }
    if (c == 60) {                                                                  // '<'
        pos[0] = pos[0] + 1;
        cg_ll_ws(s, pos);
        if ((int)s[pos[0]] == 123) {                                                // packed `<{ … }>`
            pos[0] = pos[0] + 1;
            int psz = cg_ll_fields(g, s, pos, al, 1);
            cg_ll_ws(s, pos);
            if ((int)s[pos[0]] == 62) {
                pos[0] = pos[0] + 1;
            }
            al[0] = 1;
            return psz;
        }
        int vn = cg_ll_num(s, pos);     // vector `<N x T>`
        cg_ll_ws(s, pos);
        cg_ll_kw(s, pos, "x");
        int val = 1;
        int vsz = cg_ll_layout(g, s, pos, &val);
        cg_ll_ws(s, pos);
        if ((int)s[pos[0]] == 62) {
            pos[0] = pos[0] + 1;
        }
        al[0] = cg_sat_mul(vn, vsz);
        return cg_sat_mul(vn, vsz);
    }
    if (c == 91) {                                                                  // '[N x T]'
        pos[0] = pos[0] + 1;
        cg_ll_ws(s, pos);
        int an = cg_ll_num(s, pos);
        cg_ll_ws(s, pos);
        cg_ll_kw(s, pos, "x");
        int eal = 1;
        int esz = cg_ll_layout(g, s, pos, &eal);
        cg_ll_ws(s, pos);
        if ((int)s[pos[0]] == 93) {
            pos[0] = pos[0] + 1;
        }
        al[0] = eal;
        return cg_sat_mul(an, esz);
    }
    if (c == 37) {                                                                  // '%name'
        pos[0] = pos[0] + 1;
        int st = pos[0];
        while (s[pos[0]] != 0) {
            int ch = (int)s[pos[0]];
            if ((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95 || ch == 46) {
                pos[0] = pos[0] + 1;
            } else {
                break;
            }
        }
        return cg_ll_named(g, cg_sub_str(s, st, pos[0]), al);
    }
    if (c == 105) {                                                                 // 'iN'
        pos[0] = pos[0] + 1;
        int w = cg_ll_num(s, pos);
        int b = 1;
        while (b * 8 < w) {
            b = b * 2;
        }
        al[0] = b;
        if (b == 8 && g.i64al < 8) {
            al[0] = g.i64al;
        }
        return b;
    }
    if (cg_ll_kw(s, pos, "ptr") == 1) {
        al[0] = g.ptrsz;
        return g.ptrsz;
    }
    if (cg_ll_kw(s, pos, "double") == 1) {
        al[0] = g.i64al;
        return 8;
    }
    if (cg_ll_kw(s, pos, "float") == 1) {
        al[0] = 4;
        return 4;
    }
    if (cg_ll_kw(s, pos, "void") == 1) {
        return 0;
    }
    if (s[pos[0]] != 0) {                                    // unknown: skip
        pos[0] = pos[0] + 1;
    }
    return 0;
}

int cg_layout_size(Codegen* g, List<string>* fields);   // fwd: mutually recursive with cg_size

int cg_align_up(int x, int a) {
    if (x > 2147483647 - a) {
        return 2147483647;
    }
    return ((x + a - 1) / a) * a;
}

// ABI alignment of an Eskiu type (of its LLVM lowering).
int cg_align(Codegen* g, string t) {
    int al = 1;
    int p = 0;
    cg_ll_layout(g, cg_lltype(g, t), &p, &al);
    return al;
}

// Allocation size of an Eskiu type (of its LLVM lowering), as LLVM's DataLayout gives it.
int cg_size(Codegen* g, string t) {
    int al = 1;
    int p = 0;
    return cg_ll_layout(g, cg_lltype(g, t), &p, &al);
}

// Natural LLVM size of the literal struct `{ fields }`: each field placed at its
// alignment, the total rounded up to the struct's own (max-field) alignment. This is
// exactly how LLVM lays out the `{ payload fields }` view used to read/write a variant,
// so an ADT enum's `[N x i64]` payload area must hold `cg_layout_size` bytes (the C++
// codegen sizes it the same way, via DataLayout, in makeAdtStruct).
int cg_layout_size(Codegen* g, List<string>* fields) {
    int bytes = 0;
    int maxal = 1;
    int i = 0;
    int n = List_len<string>(fields);
    while (i < n) {
        string ft = List_get<string>(fields, i);
        int al = cg_align(g, ft);
        if (al > maxal) {
            maxal = al;
        }
        bytes = cg_align_up(bytes, al) + cg_size(g, ft);
        i = i + 1;
    }
    return cg_align_up(bytes, maxal);
}

// The "not found" sentinel returned by the variant lookups below (.ename == "").
CgVariant cg_variant_none(string vname) {
    let none: CgVariant;
    none.vname = vname;
    none.ename = "";
    none.tag = 0;
    List_init<string>(&none.ptys, 1);
    return none;
}

// Find an ADT variant by name; sentinel with .ename == "" if not a known variant.
CgVariant cg_find_variant(Codegen* g, string vname) {
    int i = NameIdx_first(&g.variants_ix, vname);
    if (i >= 0) {
        return List_get<CgVariant>(&g.variants, i);
    }
    return cg_variant_none(vname);
}

// Find a variant by name WITHIN a specific (mangled) enum — disambiguates same-named
// variants across generic-enum instantiations (Option_int.Some vs Option_int64.Some).
CgVariant cg_find_variant_in(Codegen* g, string vname, string enumName) {
    int i = NameIdx_first(&g.variants_ix, vname);
    while (i >= 0) {
        CgVariant v = List_get<CgVariant>(&g.variants, i);
        if (cg_streq(v.ename, enumName) == 1) {
            return v;
        }
        i = NameIdx_next(&g.variants_ix, i);
    }
    return cg_variant_none(vname);
}

// A generic ADT variant pattern (e.g. Option's `Some(T)`), by variant name.
CgVariant cg_find_gvariant(Codegen* g, string vname) {
    int i = NameIdx_first(&g.gvariants_ix, vname);
    if (i >= 0) {
        return List_get<CgVariant>(&g.gvariants, i);
    }
    return cg_variant_none(vname);
}

*DeclNode cg_find_genum(Codegen* g, string name) {
    int i = NameIdx_first(&g.genums_ix, name);
    if (i < 0) {
        return null;
    }
    return List_get<*DeclNode>(&g.genums, i);
}

int cg_is_genum(Codegen* g, string name) {
    if (cg_find_genum(g, name) == null) {
        return 0;
    }
    return 1;
}

// Monomorphize a generic ADT enum spelling ("Option<int>") into `%Option_int = type
// { i32, [N x i64] }` (N sized by BYTES across variants, type params substituted) and
// register its concrete variants (ename = mangled). Mirrors cg_ensure_struct_inst.
string cg_ensure_enum_inst(Codegen* g, string spelling) {
    spelling = cg_dealias(g, cg_apply_sub(g, spelling));   // an alias type arg names its target (Opt<F> = Opt<int>)
    string mangled = cg_mangle(spelling);
    if (cg_seen_inst(g, mangled) == 1) {
        return mangled;
    }
    string base = cg_gen_base(spelling);
    *DeclNode gd = cg_find_genum(g, base);
    if (gd == null) {
        return mangled;
    }
    cg_push_inst(g, mangled);

    List<string> targs;
    List_init<string>(&targs, 4);
    cg_gen_args(spelling, &targs);
    List<CgSub> oldsub = g.cursub;
    List_init<CgSub>(&g.cursub, 4);
    int tp = 0;
    int ntp = List_len<TypeParam>(&gd.type_params);
    while (tp < ntp && tp < List_len<string>(&targs)) {
        let sb: CgSub;
        sb.param = List_get<TypeParam>(&gd.type_params, tp).name;
        sb.arg = List_get<string>(&targs, tp);
        List_push<CgSub>(&g.cursub, sb);
        tp = tp + 1;
    }

    int m = List_len<Param>(&gd.params);
    int slots = 0;
    int j = 0;
    while (j < m) {
        List<string> pl = List_get<List<string>>(&gd.payloads, j);
        List<string> spl;
        List_init<string>(&spl, List_len<string>(&pl));
        int k = 0;
        while (k < List_len<string>(&pl)) {
            List_push<string>(&spl, cg_apply_sub(g, List_get<string>(&pl, k)));
            k = k + 1;
        }
        int isl = (cg_layout_size(g, &spl) + 7) / 8;
        if (isl > slots) {
            slots = isl;
        }
        j = j + 1;
    }
    if (slots < 1) {
        slots = 1;
    }
    List_push<string>(&g.adt_names, mangled);
    NameIdx_push(&g.adt_ix, mangled);
    cg_deftype(g, mangled, cg_cat("{ i32, [", cg_cat(cg_itoa(slots), " x i64] }")));

    j = 0;
    while (j < m) {
        let var: CgVariant;
        var.vname = List_get<Param>(&gd.params, j).name;
        var.ename = mangled;
        var.tag = j;
        List<string> pl = List_get<List<string>>(&gd.payloads, j);
        List_init<string>(&var.ptys, List_len<string>(&pl));
        int k = 0;
        while (k < List_len<string>(&pl)) {
            List_push<string>(&var.ptys, cg_apply_sub(g, List_get<string>(&pl, k)));
            k = k + 1;
        }
        List_push<CgVariant>(&g.variants, var);
        NameIdx_push(&g.variants_ix, var.vname);
        j = j + 1;
    }
    g.cursub = oldsub;
    return mangled;
}

// LLVM literal struct type for a variant's payload fields, e.g. "{ i32, i32 }" — used to
// view the tagged union's [N x i64] storage as the variant's fields for load/store.
string cg_payload_lltype(Codegen* g, CgVariant* v) {
    String t;
    String_init(&t, 16);
    String_append(&t, "{ ");
    int i = 0;
    int n = List_len<string>(&v.ptys);
    while (i < n) {
        if (i > 0) {
            String_append(&t, ", ");
        }
        String_append(&t, cg_lltype(g, List_get<string>(&v.ptys, i)));
        i = i + 1;
    }
    String_append(&t, " }");
    return (string)String_cstr(&t);
}

int cg_is_unsigned(string t);   // fwd (defined later); for signedness-aware widening
string cg_ext_attr(Codegen* g, string t);   // fwd: signext/zeroext of a narrow C int
int cg_is_fn(Codegen* g, string name);
string cg_fn_to_closure(Codegen* g, string fnname);   // fwd: decay a top-level fn to a {thunk,null} closure
string cg_cabi_callback(Codegen* g, string name);     // fwd: a top-level fn as a raw C callback address

// Coerce a value to a target LLVM type, emitting the conversion if needed; returns the
// operand to use. Mirrors the casts in EK_CAST — for ABI-correct call arguments (e.g. an
// i32 count passed to an `int64 n` parameter must be widened, not reinterpreted).
string cg_coerce(Codegen* g, CgVal val, string target) {
    // A bare top-level function used where a closure is expected (`apply2(add, …)`): decay
    // it to a fat pointer {__fnptr_<name>, null} (the thunk drops the closure env arg). A
    // function used as a raw pointer (`(*void)cmp`) is just `@name` (target "ptr" below).
    if (cg_streq(target, "%closure") == 1 && (int)val.op[0] == 64) {   // op is "@name"
        int ln = 0;
        while (val.op[ln] != 0) {
            ln = ln + 1;
        }
        string fnm = cg_sub_str(val.op, 1, ln);
        if (cg_is_fn(g, fnm) == 1) {
            return cg_fn_to_closure(g, fnm);
        }
    }
    if (cg_streq(val.ty, target) == 1) {
        return val.op;
    }
    int tptr = cg_streq(target, "ptr");
    int sptr = cg_streq(val.ty, "ptr");
    if (tptr == 1 && sptr == 1) {
        return val.op;
    }
    int tf = cg_is_float(target);
    int sf = cg_is_float(val.ty);
    int tw = cg_int_w(target);
    int sw = cg_int_w(val.ty);
    if (tf == 0 && sf == 0 && tw == 0 && sw == 0) {   // non-scalar (struct)
        return val.op;
    }
    string t = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = ");
    if (tw == 1) {                                        // to bool: `!= 0`, never a truncation
        if (sf == 1) {
            cg_emit(g, "fcmp une ");
            cg_emit(g, val.ty);
            cg_emit(g, " ");
            cg_emit(g, val.op);
            cg_emit(g, ", 0.0");
        }
        else if (sptr == 1) {
            cg_emit(g, "icmp ne ptr ");
            cg_emit(g, val.op);
            cg_emit(g, ", null");
        }
        else {
            cg_emit(g, "icmp ne ");
            cg_emit(g, val.ty);
            cg_emit(g, " ");
            cg_emit(g, val.op);
            cg_emit(g, ", 0");
        }
    }
    else if (tf == 1 && sw > 0) {                              // int→float: unsigned source uses uitofp
        if (cg_is_unsigned(val.ety) == 1) {
            cg_emit(g, "uitofp ");
        } else {
            cg_emit(g, "sitofp ");
        }
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, " to ");
        cg_emit(g, target);
    }
    else if (tw > 0 && sf == 1) {
        cg_emit_fp_sat(g, 0, val.ty, val.op, target);
    }
    else if (tf == 1 && sf == 1) {                        // float<->double
        if (cg_streq(target, "double") == 1) {
            cg_emit(g, "fpext ");
        } else {
            cg_emit(g, "fptrunc ");
        }
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, " to ");
        cg_emit(g, target);
    }
    else if (tptr == 1 && sw > 0) {
        cg_emit(g, "inttoptr ");
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, " to ptr");
    }
    else if (sptr == 1 && tw > 0) {
        cg_emit(g, "ptrtoint ptr ");
        cg_emit(g, val.op);
        cg_emit(g, " to ");
        cg_emit(g, target);
    }
    else if (tw > 0 && sw > 0 && tw < sw) {
        cg_emit(g, "trunc ");
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, " to ");
        cg_emit(g, target);
    }
    else if (sw == 1 && tw > 1) {  // bool→int is 0/1
        cg_emit(g, "zext ");
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, " to ");
        cg_emit(g, target);
    }
    else if (tw > 0 && sw > 0 && tw > sw) {   // widen — honor the SOURCE's signedness (unsigned → zext)
        if (cg_is_unsigned(val.ety) == 1) {
            cg_emit(g, "zext ");
        } else {
            cg_emit(g, "sext ");
        }
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, " to ");
        cg_emit(g, target);
    }
    else {
        cg_emit(g, "bitcast ");
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, " to ");
        cg_emit(g, target);
    }
    cg_emit(g, "\n");
    return t;
}

// The declared LLVM type of parameter `i` (0-based) of `f`, or "" if out of range.
string cg_pty(CgFn* f, int i) {
    if (i < 0 || i >= List_len<string>(&f.ptys)) {
        return "";
    }
    return List_get<string>(&f.ptys, i);
}

// The declared Eskiu type of parameter `i` (0-based) of `f`, or "" if out of range.
string cg_pety(CgFn* f, int i) {
    if (i < 0 || i >= List_len<string>(&f.petys)) {
        return "";
    }
    return List_get<string>(&f.petys, i);
}

// Is `name` a declared interface type?
int cg_is_iface(Codegen* g, string name) {
    return NameIdx_first(&g.ifaces_ix, name) >= 0;
}

CgIface cg_find_iface(Codegen* g, string name) {
    int i = NameIdx_first(&g.ifaces_ix, name);
    if (i >= 0) {
        return List_get<CgIface>(&g.ifaces, i);
    }
    let e: CgIface;
    e.name = "";
    List_init<string>(&e.mnames, 1);
    List_init<string>(&e.mrets, 1);
    List_init<List<string>>(&e.mparams, 1);
    return e;
}

// Index of method `m` in interface `f`'s method order, or -1.
int cg_iface_midx(CgIface* f, string m) {
    int i = 0;
    int n = List_len<string>(&f.mnames);
    while (i < n) {
        if (cg_streq(List_get<string>(&f.mnames, i), m) == 1) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

CgFn cg_find_fn(Codegen* g, string name) {
    int i = NameIdx_first(&g.fns_ix, name);
    if (i >= 0) {
        return List_get<CgFn>(&g.fns, i);
    }
    let none: CgFn;
    none.name = name;
    none.retty = "i32";
    none.rety = "";
    none.variadic = 0;
    none.fixedtypes = "";
    List_init<string>(&none.ptys, 1);
    return none;
}

// Is `name` a registered top-level function (free fn or extern, not a struct method)?
int cg_is_fn(Codegen* g, string name) {
    return NameIdx_first(&g.fns_ix, name) >= 0;
}

// Build a closure fat pointer {@__fnptr_<name>, null} for a top-level function used as a
// value where a `fn(...)->R` is expected. The thunk (queued, emitted once via
// cg_drain_thunks) drops the closure's leading env arg and forwards to the real function.
void cg_queue_fn_thunk(Codegen* g, string fnname) {
    if (cg_seen_inst(g, cg_cat("thunk:", fnname)) == 0) {
        cg_push_inst(g, cg_cat("thunk:", fnname));
        List_push<string>(&g.fnthunks, fnname);
    }
}

string cg_fn_to_closure(Codegen* g, string fnname) {
    cg_queue_fn_thunk(g, fnname);
    string c1 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, c1);
    cg_emit(g, " = insertvalue %closure undef, ptr @__fnptr_");
    cg_emit(g, fnname);
    cg_emit(g, ", 0\n");
    string c2 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, c2);
    cg_emit(g, " = insertvalue %closure ");
    cg_emit(g, c1);
    cg_emit(g, ", ptr null, 1\n");
    return c2;
}

void cg_emit_cabi_thunk(Codegen* g, string name);   // fwd: a C-ABI callback thunk

// Emit one `__fnptr_<name>` thunk: `R __fnptr_f(ptr env, <params>) { return f(<params>); }`.
// A `cabi:<name>` entry is a C-ABI callback thunk instead (cg_cabi_callback).
void cg_emit_thunk(Codegen* g, string fnname) {
    int fl = 0;
    while (fnname[fl] != 0) {
        fl = fl + 1;
    }
    if (fl > 5 && cg_streq(cg_sub_str(fnname, 0, 5), "cabi:") == 1) {
        cg_emit_cabi_thunk(g, cg_sub_str(fnname, 5, fl));
        return;
    }
    CgFn f = cg_find_fn(g, fnname);
    int np = List_len<string>(&f.ptys);
    CgCabi cab = cg_find_cabi(g, fnname);
    if (cab.name[0] != 0) {                             // a C-ABI extern: lower inside the thunk
        cg_emit(g, "define ");
        cg_emit(g, f.retty);
        cg_emit(g, " @__fnptr_");
        cg_emit(g, fnname);
        cg_emit(g, "(ptr %e");
        List<CgVal> targs;
        List_init<CgVal>(&targs, np);
        int ti = 0;
        while (ti < np) {
            let ta: CgVal;
            ta.ty = List_get<string>(&f.ptys, ti);
            ta.op = cg_cat("%a", cg_itoa(ti));
            ta.ety = "";
            cg_emit(g, ", ");
            cg_emit(g, ta.ty);
            cg_emit(g, " ");
            cg_emit(g, ta.op);
            List_push<CgVal>(&targs, ta);
            ti = ti + 1;
        }
        cg_emit(g, ") {\n");
        String_init(&g.entry_buf, 128);
        String saved = g.out;
        String_init(&g.out, 256);
        CgVal r = cg_cabi_call(g, &cab, &f, &targs);
        if (cg_streq(f.retty, "void") == 1) {
            cg_emit(g, "  ret void\n");
        }
        else {
            cg_emit(g, "  ret ");
            cg_emit(g, f.retty);
            cg_emit(g, " ");
            cg_emit(g, r.op);
            cg_emit(g, "\n");
        }
        string bodytext = (string)String_cstr(&g.out);
        g.out = saved;
        cg_emit(g, "entry:\n");
        cg_emit(g, (string)String_cstr(&g.entry_buf));
        cg_emit(g, bodytext);
        cg_emit(g, "}\n\n");
        return;
    }
    cg_emit(g, "define ");
    cg_emit(g, f.retty);
    cg_emit(g, " @__fnptr_");
    cg_emit(g, fnname);
    cg_emit(g, "(ptr %e");
    string args = "";
    int i = 0;
    while (i < np) {
        string pt = List_get<string>(&f.ptys, i);
        cg_emit(g, ", ");
        cg_emit(g, pt);
        cg_emit(g, " %a");
        cg_emit(g, cg_itoa(i));
        if (i > 0) {
            args = cg_cat(args, ", ");
        }
        args = cg_cat(args, cg_cat(pt, cg_cat(" %a", cg_itoa(i))));
        i = i + 1;
    }
    cg_emit(g, ") {\n");
    if (cg_streq(f.retty, "void") == 1) {
        cg_emit(g, "  call void @");
        cg_emit(g, fnname);
        cg_emit(g, "(");
        cg_emit(g, args);
        cg_emit(g, ")\n");
        cg_emit(g, "  ret void\n}\n\n");
    } else {
        cg_emit(g, "  %r = call ");
        cg_emit(g, f.retty);
        cg_emit(g, " @");
        cg_emit(g, fnname);
        cg_emit(g, "(");
        cg_emit(g, args);
        cg_emit(g, ")\n");
        cg_emit(g, "  ret ");
        cg_emit(g, f.retty);
        cg_emit(g, " %r\n}\n\n");
    }
}

void cg_drain_thunks(Codegen* g) {
    while (g.thk_i < List_len<string>(&g.fnthunks)) {
        cg_emit_thunk(g, List_get<string>(&g.fnthunks, g.thk_i));
        g.thk_i = g.thk_i + 1;
    }
}

// Emit a runtime `declare` once for a libc/pthread symbol the codegen calls directly
// (pthread_create/join, free). Skips it if the symbol is already a declared extern.
// The heap a closure environment lives on: libc's, or under --freestanding the program's
// esk_alloc/esk_free (the same pair <mem> uses there).
string cg_heap_alloc(Codegen* g) {
    if (g.freestanding == 1) {
        return "esk_alloc";
    }
    return "malloc";
}

string cg_heap_free(Codegen* g) {
    if (g.freestanding == 1) {
        return "esk_free";
    }
    return "free";
}

void cg_ensure_extern(Codegen* g, string name, string decl) {
    if (cg_is_fn(g, name) == 1) {
        return;
    }
    if (cg_seen_inst(g, cg_cat("decl:", name)) == 1) {
        return;
    }
    cg_push_inst(g, cg_cat("decl:", name));
    String_append(&g.globals, decl);
}

void cg_emit(Codegen* g, string s) {
    String_append(&g.out, s);
}

// Emit a `call` — or, inside a try body (cur_unwind set), an `invoke` that routes
// unwinding to the landingpad and continues in a fresh block. Returns the result temp
// ("" for a void call). `callty` is the call type (ret type, or a variadic fn type),
// `target` the callee (`@name` or `%fp`).
string cg_emit_callish(Codegen* g, string callty, string target, string args, int isvoid) {
    string t = "";
    cg_emit(g, "  ");
    if (isvoid == 0) {
        t = cg_tmp(g);
        cg_emit(g, t);
        cg_emit(g, " = ");
    }
    if (g.cur_unwind[0] != 0) {
        string cont = cg_lbl(g);
        cg_emit(g, "invoke ");
        cg_emit(g, callty);
        cg_emit(g, " ");
        cg_emit(g, target);
        cg_emit(g, "(");
        cg_emit(g, args);
        cg_emit(g, ") to label %");
        cg_emit(g, cont);
        cg_emit(g, " unwind label %");
        cg_emit(g, g.cur_unwind);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, cont);
    } else {
        cg_emit(g, "call ");
        cg_emit(g, callty);
        cg_emit(g, " ");
        cg_emit(g, target);
        cg_emit(g, "(");
        cg_emit(g, args);
        cg_emit(g, ")\n");
    }
    return t;
}

// Collect every identifier referenced in an expr/stmt subtree (for a lambda's free-
// variable analysis — the captures are those that are enclosing locals).
void cg_collect_idents_e(*ExprNode e, List<string>* out) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_IDENT) {
        List_push<string>(out, e.sval);
        return;
    }
    if (e.kind == EK_SIZEOF && e.a != null) {   // sizeof(expr)
        cg_collect_idents_e(e.a, out);
        return;
    }
    if (e.kind == EK_SIZEOF) {   // sizeof(var) uses var's type
        List_push<string>(out, e.sval);
        return;
    }
    // Recurse only into the sub-expr fields each kind populates (an unset field is now null,
    // not garbage, but reading a child a kind never sets is still a wrong-subtree bug).
    if (e.kind == EK_BINARY || e.kind == EK_INDEX) {
        cg_collect_idents_e(e.a, out);
        cg_collect_idents_e(e.b, out);
    }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
             || e.kind == EK_QUESTION || e.kind == EK_AWAIT || e.kind == EK_CALL
             || e.kind == EK_INCDEC) {
        cg_collect_idents_e(e.a, out);
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX) {   // EK_INDEX kids = a slice's hi bound
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            cg_collect_idents_e(List_get<*ExprNode>(&e.kids, i), out);
            i = i + 1;
        }
    }
    if (e.kind == EK_TERNARY) {                        // cond (a) + then (b) + else (kids[0])
        cg_collect_idents_e(e.a, out);
        cg_collect_idents_e(e.b, out);
        cg_collect_idents_e(List_get<*ExprNode>(&e.kids, 0), out);
    }
    if (e.kind == EK_LAMBDA) {
        // A lambda's identifiers are the same wherever it is walked from, so they are
        // collected once and replayed; otherwise each enclosing lambda would walk the
        // nested ones again (quadratic in the nesting depth).
        if (e.ids_done == 0) {
            List_init<string>(&e.ids_memo, 8);
            cg_collect_idents_s(e.stmt, &e.ids_memo);
            e.ids_done = 1;
        }
        int j = 0;
        int m = List_len<string>(&e.ids_memo);
        while (j < m) {
            List_push<string>(out, List_get<string>(&e.ids_memo, j));
            j = j + 1;
        }
    }
}

void cg_collect_idents_s(*StmtNode s, List<string>* out) {
    if (s == null) {
        return;
    }
    if (s.kind == SK_RETURN || s.kind == SK_EXPR || s.kind == SK_THROW || s.kind == SK_VARDECL
        || s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH) {
        cg_collect_idents_e(s.expr, out);
    }
    if (s.kind == SK_FOR) {
        cg_collect_idents_e(s.expr2, out);
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH) {
        cg_collect_idents_s(s.s1, out);
    }
    if (s.kind == SK_IF || s.kind == SK_FOR) {
        cg_collect_idents_s(s.s2, out);
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH
        || s.kind == SK_TRY) {
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            cg_collect_idents_s(List_get<*StmtNode>(&s.items, i), out);
            i = i + 1;
        }
    }
    if (s.kind == SK_TRY) {
        cg_collect_idents_s(s.s1, out);
        cg_collect_idents_s(s.s2, out);
    }
    if (s.kind == SK_DEFER) {
        cg_collect_idents_s(s.s1, out);
    }
}

// The LLVM literal struct type holding a closure's captured variables, e.g. "{ i32, double }".
string cg_env_lltype(Codegen* g, List<string>* capt) {
    String t;
    String_init(&t, 16);
    String_append(&t, "{ ");
    int i = 0;
    int n = List_len<string>(capt);
    while (i < n) {
        if (i > 0) {
            String_append(&t, ", ");
        }
        String_append(&t, cg_lltype(g, List_get<string>(capt, i)));
        i = i + 1;
    }
    String_append(&t, " }");
    return (string)String_cstr(&t);
}

// Mutually-recursive: expr (rvalue) ↔ lval (address of an lvalue).
CgVal cg_expr(Codegen* g, *ExprNode e);
CgVal cg_binary_builtin(Codegen* g, *ExprNode e, CgVal l);
CgVal cg_unary_apply(Codegen* g, *ExprNode e, CgVal operand);
CgVal cg_cond_val(Codegen* g, CgVal c);
CgVal cg_iface_data(Codegen* g, CgVal c);   // fwd: an interface value's data pointer
CgVal cg_lval(Codegen* g, *ExprNode e);
CgVal cg_addr(Codegen* g, *ExprNode e);   // fwd: address for a read (materializes an rvalue)
string cg_etype(Codegen* g, *ExprNode e);
string cg_ensure_struct_inst(Codegen* g, string spelling);   // monomorphize a generic struct
CgVal cg_build_variant(Codegen* g, CgVariant var, *ExprNode call);   // construct an ADT value
CgVal cg_emit_atomic(Codegen* g, string nm, *ExprNode e);            // atomic intrinsic
CgVal cg_indirect_call(Codegen* g, string cval, string fnty, *ExprNode e);  // call a closure value
CgVal cg_call_mangled(Codegen* g, string mangled, *ExprNode e);      // call a monomorphized fn
string cg_box_iface(Codegen* g, string ifaceName, string structName, string dataop);  // struct → interface fat ptr
CgVal cg_dispatch_iface(Codegen* g, string ifaceName, string fatop, string method, *ExprNode e);  // vtable dispatch
string cg_member_baseptr(Codegen* g, *ExprNode ea, *string out_sname);  // struct ptr + name
CgBF cg_bf(Codegen* g, string sname, string fname);
string cg_bf_read_ety(Codegen* g, CgBF slot);   // fwd
string cg_bf_wordptr(Codegen* g, string baseptr, string sname, CgBF slot);   // fwd
string cg_infer_generic(Codegen* g, *DeclNode gd, *ExprNode e);      // infer `name<args>` from arg types
void cg_collect_idents_e(*ExprNode e, List<string>* out);
void cg_collect_idents_s(*StmtNode s, List<string>* out);
string cg_ensure_fn_inst(Codegen* g, string spelling);       // monomorphize a generic function
void cg_emit_fn(Codegen* g, *DeclNode d, string llname, string self_struct);

int cg_strlen(string s) {
    int i = 0;
    while (s[i] != 0) {
        i = i + 1;
    }
    return i;
}

int cg_hexd(int d) {   // 0-9, A-F
    if (d < 10) {
        return 48 + d;
    }
    return 55 + d;
}

string cg_hex2(int b) {
    *uint8 buf = alloc<uint8>(3);
    buf[0] = (uint8)cg_hexd((b / 16) % 16);
    buf[1] = (uint8)cg_hexd(b % 16);
    buf[2] = 0;
    return (string)buf;
}

// `s` escaped for an LLVM IR string: printables verbatim, `"`/`\`/others as \NN.
string cg_ll_escape(string s) {
    String o;
    String_init(&o, 32);
    int i = 0;
    while (s[i] != 0) {
        int b = (int)s[i];
        if (b < 0) {
            b = b + 256;
        }
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            String_push(&o, (char)b);
        }
        else {
            String_push(&o, '\\');
            String_append(&o, cg_hex2(b));
        }
        i = i + 1;
    }
    return (string)String_cstr(&o);
}

// Emit a private string-literal constant for `s` and return its global name (a `ptr`).
// Bytes are LLVM-escaped: printables verbatim, `"`/`\`/non-printables as \NN, + a NUL.
string cg_string_global(Codegen* g, string s) {
    return cg_string_global_n(g, s, cg_strlen(s));
}

// As cg_string_global, but with an explicit byte length so a literal with an embedded
// NUL (`"a\0b"`) emits all its bytes instead of truncating at the first zero.
string cg_string_global_n(Codegen* g, string s, int len) {
    string name = cg_cat("@.str", cg_itoa(g.strcount));
    g.strcount = g.strcount + 1;
    String_append(&g.globals, name);
    String_append(&g.globals, " = private unnamed_addr constant [");
    String_append(&g.globals, cg_itoa(len + 1));
    String_append(&g.globals, " x i8] c\"");
    int i = 0;
    while (i < len) {
        int b = (int)s[i];
        if (b < 0) {
            b = b + 256;
        }
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            String_push(&g.globals, (char)b);
        } else {
            String_push(&g.globals, '\\');
            String_append(&g.globals, cg_hex2(b));
        }
        i = i + 1;
    }
    String_append(&g.globals, "\\00\"\n");
    return name;
}

// Variadic parameter list: "<fixed>, ..." (or just "..." when there are no fixed types).
string cg_va(string fixed) {
    if (fixed[0] == 0) {
        return "...";
    }
    return cg_cat(fixed, ", ...");
}

string cg_tmp(Codegen* g) {
    string r = cg_cat("%t", cg_itoa(g.next));
    g.next = g.next + 1;
    return r;
}

string cg_lbl(Codegen* g) {
    string r = cg_cat("L", cg_itoa(g.next));
    g.next = g.next + 1;
    return r;
}

// Start a new basic block (resets the terminated flag).
void cg_label(Codegen* g, string name) {
    cg_emit(g, name);
    cg_emit(g, ":\n");
    g.terminated = 0;
    g.cur_lbl = name;
}

// Unconditional branch — skipped if the block is already terminated.
void cg_br(Codegen* g, string target) {
    if (g.terminated == 1) {
        return;
    }
    cg_emit(g, "  br label %");
    cg_emit(g, target);
    cg_emit(g, "\n");
    g.terminated = 1;
}

void cg_stmt(Codegen* g, *StmtNode st);

// Emit each pending cleanup body in frames at index >= depth, LIFO. On a normal exit
// (error_path 0) errdefer bodies are skipped; the `?`-propagation error path passes 1
// so both run. Does not shrink the stack — the owning scope truncates when it ends.
void cg_run_cleanups(Codegen* g, int depth, int error_path) {
    int i = List_len<*StmtNode>(&g.cleanups) - 1;
    while (i >= depth) {
        if (g.terminated == 1) {
            return;
        }
        if (List_get<int>(&g.cl_err, i) == 1 && error_path == 0) {
            i = i - 1;
        }
        else {
            // A cleanup body sees the names that were visible where it was registered,
            // not a later shadowing declaration: re-bind those locals on top, emit, drop.
            int base = List_len<CgLocal>(&g.locals);
            int nvis = List_get<int>(&g.cl_nloc, i);
            int k = 0;
            while (k < nvis && k < base) {
                cg_push_local(g, List_get<CgLocal>(&g.locals, k));
                k = k + 1;
            }
            string unw = g.cur_unwind;                   // the body runs under the landingpad
            g.cur_unwind = List_get<string>(&g.cl_unw, i);   // active before it was registered
            cg_stmt(g, List_get<*StmtNode>(&g.cleanups, i));
            g.cur_unwind = unw;
            cg_locals_trunc(g, base);
            i = i - 1;
        }
    }
}

// Register a cleanup (a defer/errdefer body or a `finally`) for the current scope.
void cg_push_cleanup(Codegen* g, *StmtNode body, int is_err) {
    List_push<*StmtNode>(&g.cleanups, body);
    List_push<int>(&g.cl_err, is_err);
    List_push<int>(&g.cl_nloc, List_len<CgLocal>(&g.locals));
    List_push<string>(&g.cl_unw, g.cur_unwind);
}

// Drop cleanup entries down to length `mark` (called on scope exit). Past the scope, calls
// unwind to the landingpad that was active before its first cleanup again.
void cg_cleanups_trunc(Codegen* g, int mark) {
    if (List_len<*StmtNode>(&g.cleanups) > mark) {
        g.cur_unwind = List_get<string>(&g.cl_unw, mark);
    }
    while (List_len<*StmtNode>(&g.cleanups) > mark) {
        List_remove<*StmtNode>(&g.cleanups, List_len<*StmtNode>(&g.cleanups) - 1);
        List_remove<int>(&g.cl_err, List_len<int>(&g.cl_err) - 1);
        List_remove<int>(&g.cl_nloc, List_len<int>(&g.cl_nloc) - 1);
        List_remove<string>(&g.cl_unw, List_len<string>(&g.cl_unw) - 1);
    }
}

// The landingpad for the calls after a defer (only in a program that throws). Inside a
// try body it catches everything, runs the pending cleanups down to that try and joins
// its catch dispatch with the exception pointer; outside any try it is a cleanup pad
// that runs the function's pending cleanups and resumes unwinding.
void cg_defer_pad(Codegen* g) {
    string cont = cg_lbl(g);
    string pad = cg_lbl(g);
    cg_br(g, cont);
    cg_label(g, pad);
    int nt = List_len<int>(&g.try_cld);
    string lp = cg_tmp(g);
    string ex = "";
    int depth = 0;
    if (nt > 0) {
        cg_emit(g, "  ");
        cg_emit(g, lp);
        cg_emit(g, " = landingpad { ptr, i32 } catch ptr null\n");
        ex = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, ex);
        cg_emit(g, " = extractvalue { ptr, i32 } ");
        cg_emit(g, lp);
        cg_emit(g, ", 0\n");
        depth = List_get<int>(&g.try_cld, nt - 1);
    } else {
        cg_emit(g, "  ");
        cg_emit(g, lp);
        cg_emit(g, " = landingpad { ptr, i32 } cleanup\n");
    }
    cg_run_cleanups(g, depth, 0);
    if (g.terminated == 0) {
        if (nt > 0) {
            string inc = cg_cat(", [ ", cg_cat(ex, cg_cat(", %", cg_cat(g.cur_lbl, " ]"))));
            List_set<string>(&g.try_phi, nt - 1, cg_cat(List_get<string>(&g.try_phi, nt - 1), inc));
            cg_emit(g, "  br label %");
            cg_emit(g, List_get<string>(&g.try_disp, nt - 1));
            cg_emit(g, "\n");
        } else {
            cg_emit(g, "  resume { ptr, i32 } ");
            cg_emit(g, lp);
            cg_emit(g, "\n");
        }
        g.terminated = 1;
    }
    cg_label(g, cont);
    g.cur_unwind = pad;
}

// Does a subtree contain a `throw` or a `try` (lambda bodies included)? Decides prog_eh.
int cg_has_eh_s(*StmtNode s);
int cg_has_eh_e(*ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_LAMBDA) {
        return cg_has_eh_s(e.stmt);
    }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX) {
        if (cg_has_eh_e(e.a) == 1 || cg_has_eh_e(e.b) == 1) {
            return 1;
        }
    } else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
               || e.kind == EK_QUESTION || e.kind == EK_AWAIT || e.kind == EK_CALL
               || e.kind == EK_INCDEC) {
        if (cg_has_eh_e(e.a) == 1) {
            return 1;
        }
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX) {
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            if (cg_has_eh_e(List_get<*ExprNode>(&e.kids, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    if (e.kind == EK_TERNARY) {
        if (cg_has_eh_e(e.a) == 1 || cg_has_eh_e(e.b) == 1) {
            return 1;
        }
        if (cg_has_eh_e(List_get<*ExprNode>(&e.kids, 0)) == 1) {
            return 1;
        }
    }
    return 0;
}

int cg_has_eh_s(*StmtNode s) {
    if (s == null) {
        return 0;
    }
    if (s.kind == SK_THROW || s.kind == SK_TRY) {
        return 1;
    }
    if (s.kind == SK_RETURN || s.kind == SK_EXPR || s.kind == SK_VARDECL
        || s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH) {
        if (cg_has_eh_e(s.expr) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_FOR) {
        if (cg_has_eh_e(s.expr2) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_DEFER) {
        if (cg_has_eh_s(s.s1) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR) {
        if (cg_has_eh_s(s.s2) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH) {
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (cg_has_eh_s(List_get<*StmtNode>(&s.items, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

// Drop local bindings down to length `mark` (a block/loop scope ends: an inner `let`
// that shadowed an outer one goes away and the outer binding is visible again).
void cg_locals_trunc(Codegen* g, int mark) {
    while (List_len<CgLocal>(&g.locals) > mark) {
        NameIdx_pop(&g.locals_ix, List_get<CgLocal>(&g.locals, List_len<CgLocal>(&g.locals) - 1).name);
        List_remove<CgLocal>(&g.locals, List_len<CgLocal>(&g.locals) - 1);
    }
}

// Start an empty set of local bindings (a function or lambda body).
void cg_locals_reset(Codegen* g) {
    cg_locals_trunc(g, 0);
    List_init<CgLocal>(&g.locals, 8);
}

// Emit a statement body as its own scope (locals + defer cleanups), even a single
// unbraced statement (`if (c) defer f();`, an unbraced loop body or match arm), so a
// `defer` in it runs when that body ends (mirrors CodeGen::emitScopedBody).
void cg_scoped_stmt(Codegen* g, *StmtNode st) {
    if (st == null) {
        return;
    }
    if (st.kind == SK_BLOCK) {
        cg_stmt(g, st);
        return;
    }
    int mark = List_len<*StmtNode>(&g.cleanups);
    int lmark = List_len<CgLocal>(&g.locals);
    cg_stmt(g, st);
    if (g.terminated == 0) {
        cg_run_cleanups(g, mark, 0);
    }
    cg_cleanups_trunc(g, mark);
    cg_locals_trunc(g, lmark);
}

// An expression with no side effects: evaluating it twice is the same as once.
int cg_is_pure(*ExprNode e) {
    if (e == null) {
        return 1;
    }
    if (e.kind == EK_IDENT || e.kind == EK_LITERAL || e.kind == EK_SIZEOF) {
        return 1;
    }
    if (e.kind == EK_MEMBER || e.kind == EK_UNARY || e.kind == EK_CAST) {
        return cg_is_pure(e.a);
    }
    if (e.kind == EK_INDEX) {
        if (cg_is_pure(e.a) == 0 || cg_is_pure(e.b) == 0) {
            return 0;
        }
        int i = 0;
        while (i < List_len<*ExprNode>(&e.kids)) {
            if (cg_is_pure(List_get<*ExprNode>(&e.kids, i)) == 0) {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }
    if (e.kind == EK_BINARY) {
        if (cg_streq(e.sval, "=") == 1) {
            return 0;
        }
        if (cg_is_pure(e.a) == 0) {
            return 0;
        }
        return cg_is_pure(e.b);
    }
    return 0;
}

int cg_is_struct(Codegen* g, string name) {
    return NameIdx_first(&g.structs_ix, name) >= 0;
}

// Eskiu type spelling → LLVM type. Pointers (anything with `*`) lower to opaque `ptr`;
// a registered struct name → its named type `%Name`.
// Drop a leading `?` (the checked-nullable marker on `?*T`). It is a sema-only concept:
// `?*T` lowers exactly like `*T`, so every type-inspection entry normalizes it away.
string cg_strip_nullable(string t) {
    if ((int)t[0] == 63) {   // '?'
        return cg_sub_str(t, 1, cg_strlen(t));
    }
    return t;
}

int cg_arr_open(string t);   // fwd
string cg_lltype(Codegen* g, string t) {
    t = cg_strip_nullable(t);            // `?*T` lowers as `*T`
    t = cg_apply_sub(g, t);               // T -> concrete during instantiation
    t = cg_dealias(g, t);                 // type alias -> underlying type
    // fn(...)->R first: its parameter / return spellings may hold `<`, `[` or `*`
    // (`fn(Box<int>)->int`), which are not the fn type's own shape.
    if (cg_is_fnty(t) == 1 && cg_arr_open(t) < 0) {   // fn(...)->R → fat pointer {fn,env}
        return "%closure";
    }
    if (cg_is_slice(t) == 1) {   // "T[]" -> fat pointer { data, len }
        return "{ ptr, i64 }";
    }
    if (cg_is_array(t) == 1) {            // "T[N]" -> [N x <T>]
        string cnt = cg_dim_val(g, cg_array_count(t));   // a named or folded dimension
        return cg_cat("[", cg_cat(cnt, cg_cat(" x ",
                       cg_cat(cg_lltype(g, cg_array_elem(t)), "]"))));
    }
    if (cg_is_fnty(t) == 1) {         // fn(...)->R → fat pointer {fn,env}
        return "%closure";
    }
    if (cg_is_ptr_ty(t) == 1) {   // top-level '*' (not one inside <...>)
        return "ptr";
    }
    if (cg_has_targs(t) == 1) {           // "Box<int>" / "Option<int>" -> monomorphize
        if (cg_is_genum(g, cg_gen_base(t)) == 1) {
            return cg_cat("%", cg_ensure_enum_inst(g, t));
        }
        return cg_cat("%", cg_ensure_struct_inst(g, t));
    }
    if (cg_streq(t, "void") == 1) {
        return "void";
    }
    if (cg_streq(t, "bool") == 1) {
        return "i1";
    }
    if (cg_streq(t, "char") == 1 || cg_streq(t, "int8") == 1 || cg_streq(t, "uint8") == 1) {
        return "i8";
    }
    if (cg_streq(t, "int16") == 1 || cg_streq(t, "uint16") == 1) {
        return "i16";
    }
    if (cg_streq(t, "int64") == 1 || cg_streq(t, "uint64") == 1) {
        return "i64";
    }
    if (cg_streq(t, "float") == 1) {
        return "float";
    }
    if (cg_streq(t, "double") == 1) {
        return "double";
    }
    if (cg_streq(t, "string") == 1) {
        return "ptr";
    }
    if (cg_streq(t, "va_list") == 1) {                     // {ptr,ptr,ptr,i32,i32} (AArch64 layout, x86-64 superset)
        if (cg_seen_inst(g, "type:__va_list") == 0) {
            cg_push_inst(g, "type:__va_list");
            cg_deftype(g, "__va_list", "{ ptr, ptr, ptr, i32, i32 }");
        }
        return "%__va_list";
    }
    if (cg_is_iface(g, t) == 1) {   // interface value = fat {data, vtable}, by value
        return "%iface_fat";
    }
    if (cg_is_struct(g, t) == 1) {
        return cg_cat("%", t);
    }
    if (cg_is_adt(g, t) == 1) {   // ADT enum → tagged-union type
        return cg_cat("%", t);
    }
    return "i32";   // int/int32/uint/... and the default
}

// The pointee/base name of a pointer type, stripping '*' and spaces from BOTH ends
// (Eskiu writes pointers either way: "*P" and "P*"). "*P"/"P*" -> "P".
string cg_strip_ptr(string t) {
    t = cg_strip_nullable(t);
    int a = 0;
    while ((int)t[a] == 42 || (int)t[a] == 32) {
        a = a + 1;
    }
    int b = 0;
    while (t[b] != 0) {
        b = b + 1;
    }
    while (b > a && ((int)t[b - 1] == 42 || (int)t[b - 1] == 32)) {
        b = b - 1;
    }
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0;
    while (k < len) {
        buf[k] = (uint8)t[a + k];
        k = k + 1;
    }
    buf[len] = 0;
    return (string)buf;
}

// Bit width of an LLVM integer type string ("i32"->32), or 0 if not an integer.
int cg_int_w(string t) {
    if ((int)t[0] != 105) {                  // not 'i...'
        return 0;
    }
    int w = 0;
    int i = 1;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (c < 48 || c > 57) {
            return 0;
        }
        w = w * 10 + (c - 48);
        i = i + 1;
    }
    return w;
}

// Pointee of a pointer type — strips exactly ONE '*' (the outermost, either end). For
// indexing/deref: `**ExprNode`→`*ExprNode`, `*int`→`int`, `int*`→`int`. Distinct from
// cg_strip_ptr, which strips ALL '*' to recover a struct's base name.
string cg_deref_ty(string t) {
    t = cg_strip_nullable(t);                             // `?*T` derefs like `*T`
    if (cg_streq(t, "string") == 1) {    // string = *char → element is a char
        return "char";
    }
    int b = 0;
    while (t[b] != 0) {
        b = b + 1;
    }
    if (b > 0 && (int)t[b - 1] == 42) {   // trailing '*'
        return cg_sub_str(t, 0, b - 1);
    }
    int a = 0;
    while ((int)t[a] == 32) {
        a = a + 1;
    }
    if ((int)t[a] == 42) {                                                  // leading '*'
        string r = cg_sub_str(t, a + 1, b);
        return cg_trim(r);
    }
    return t;
}

// Is `t` a pointer type? Only a '*' at the TOP level counts — a '*' nested inside generic
// args (`List<*ExprNode>`) belongs to a type argument, not the outer type, which is a
// generic struct (value), not a pointer.
int cg_is_ptr_ty(string t) {
    t = cg_strip_nullable(t);
    int depth = 0;
    int i = 0;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (c == 60 || c == 40) {       // '<' or '(' (generics / fn params)
            depth = depth + 1;
        }
        else if (c == 41) {   // ')'
            if (depth > 0) {
                depth = depth - 1;
            }
        }
        else if (c == 62 && (i == 0 || (int)t[i - 1] != 45)) {  // '>' but not "->"
            if (depth > 0) {
                depth = depth - 1;
            }
        }
        else if (c == 42 && depth == 0) {        // top-level '*'
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// A function type spelling: "fn(int)->int" (a closure value, lowered to a fat pointer).
int cg_is_fnty(string t) {
    return (int)t[0] == 102 && (int)t[1] == 110 && (int)t[2] == 40;   // "fn("
}

// Index of the first '[' that starts an array suffix (outside a fn type's '()' and a
// template's '<>', the '>' of a `->` not closing an angle), else -1. So
// "fn(int)->int[2]" is an array of 2 fns and "fn(int[3])->int" is not an array.
// With two runs of top-level brackets (`int[3]*[2]`, 2 pointers to int[3]) the last run is
// the suffix (type.cpp firstArraySuffixBracket).
int cg_arr_open(string t) {
    int i = 0;
    int paren = 0;
    int angle = 0;
    int br = 0;
    int run = -1;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (br > 0) {
            if (c == 91) {
                br = br + 1;
            }
            else if (c == 93) {
                br = br - 1;
            }
        }
        else if (c == 40) {
            paren = paren + 1;
        }
        else if (c == 41) {
            if (paren > 0) {
                paren = paren - 1;
            }
        }
        else if (c == 60) {
            angle = angle + 1;
        }
        else if (c == 62 && !(i > 0 && (int)t[i - 1] == 45)) {
            if (angle > 0) {
                angle = angle - 1;
            }
        }
        else if (c == 91 && paren == 0 && angle == 0) {
            if (!(run >= 0 && i > 0 && (int)t[i - 1] == 93)) {
                run = i;
            }
            br = 1;
        }
        i = i + 1;
    }
    return run;
}

// The ']' matching the '[' at `open`.
int cg_arr_close(string t, int open) {
    int i = open;
    int depth = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 91) {
            depth = depth + 1;
        }
        else if ((int)t[i] == 93) {
            depth = depth - 1;
            if (depth == 0) {
                return i;
            }
        }
        i = i + 1;
    }
    return i;
}

int cg_is_array(string t) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    if (n > 0 && (int)t[n - 1] == 42) {   // `T[N]*`: a pointer to an array
        return 0;
    }
    if (cg_arr_open(t) >= 0) {
        return 1;
    }
    return 0;
}

// A slice type `T[]`: its outer array suffix has empty brackets (`[` immediately `]`).
int cg_is_slice(string t) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    if (n > 0 && (int)t[n - 1] == 42) {   // `T[]*`: a pointer to a slice
        return 0;
    }
    int open = cg_arr_open(t);
    if (open >= 0 && (int)t[open + 1] == 93) {
        return 1;
    }
    return 0;
}

// Peel the outer (leftmost) array dimension: "int[4]" -> "int", "int[2][3]" -> "int[3]".
string cg_array_elem(string t) {
    int open = cg_arr_open(t);
    if (open < 0) {
        return t;
    }
    int close = cg_arr_close(t, open);
    int tn = 0;
    while (t[tn] != 0) {
        tn = tn + 1;
    }
    // element = prefix before '[' + suffix after ']'
    int suflen = tn - (close + 1);
    if (suflen < 0) {
        suflen = 0;
    }
    *uint8 buf = alloc<uint8>(open + suflen + 1);
    int k = 0;
    while (k < open) {
        buf[k] = (uint8)t[k];
        k = k + 1;
    }
    int j = 0;
    while (j < suflen) {
        buf[open + j] = (uint8)t[close + 1 + j];
        j = j + 1;
    }
    buf[open + suflen] = 0;
    return (string)buf;
}

// The return type a lambda initializing a `t` value takes: a fn type's return, through
// any array dimensions (`fn(int)->int[2]` holds fns returning int), else "".
string cg_lam_ret_of(string t) {
    while (cg_is_array(t) == 1) {
        t = cg_array_elem(t);
    }
    if (cg_is_fnty(t) == 1) {
        return cg_fnty_ret(t);
    }
    return "";
}

// "int[4]" -> count "4".
// The decimal count of dimension spelling `cnt`: a number, a named const/enum, or an
// integer constant expression over them (`(uint8)258`, `N*2`, mirrors the C++
// resolveArrayDim); `cnt` itself when it is none of these.
int64 cg_parse_i64(string t) {
    int i = 0;
    int64 base = (int64)10;
    int64 sign = (int64)1;
    if (t[0] == '-') {
        sign = (int64)-1;
        i = 1;
    }
    if (t[i] == '0' && (t[i + 1] == 'x' || t[i + 1] == 'X')) {
        base = (int64)16;
        i = i + 2;
    }
    else if (t[i] == '0' && t[i + 1] != 0) {
        base = (int64)8;
        i = i + 1;
    }
    int64 v = (int64)0;
    while (t[i] != 0) {
        int ch = (int)t[i];
        int64 d = (int64)0;
        if (ch >= 48 && ch <= 57) {
            d = (int64)(ch - 48);
        }
        else if (ch >= 97 && ch <= 102) {
            d = (int64)(ch - 87);
        }
        else if (ch >= 65 && ch <= 70) {
            d = (int64)(ch - 55);
        }
        else {
            return sign * v;
        }
        v = v * base + d;
        i = i + 1;
    }
    return sign * v;
}

string cg_dim_val(Codegen* g, string cnt) {
    if (cg_all_digits(cnt) == 1) {
        return cnt;
    }
    string rv = cg_enum_val(g, cnt);
    if (rv[0] != 0) {
        return rv;
    }
    int64 v = (int64)0;
    int folded = ast_fold_dim(cnt, int(string nm, *int64 out) {
        if (ast_has_prefix(nm, "sizeof(") == 1) {          // `sizeof(T)`, the type's allocation size
            int nl = 0;
            while (nm[nl] != 0) {
                nl = nl + 1;
            }
            *out = (int64)cg_size(g, cg_sub_str(nm, 7, nl - 1));
            return 1;
        }
        string ev = cg_enum_val(g, nm);
        if (ev[0] == 0) {
            return 0;
        }
        *out = cg_parse_i64(ev);
        return 1;
    }, &v);
    if (folded == 1 && v > (int64)0) {
        return cg_i64toa(v);
    }
    // The type checker leaves a `sizeof` dimension's value to codegen.
    if (folded == 1 && cg_has_sub(cnt, "sizeof(") == 1) {
        dprintf(2, "error: array size must be positive, got %lld ('%s')\n", v, cnt);
        exit(1);
    }
    return cnt;
}

string cg_array_count(string t) {
    int open = cg_arr_open(t);
    if (open < 0) {
        return "0";
    }
    int s = open + 1;                                     // past '['
    int i = cg_arr_close(t, open);                        // its ']'
    *uint8 buf = alloc<uint8>(i - s + 1);
    int k = 0;
    while (k < i - s) {
        buf[k] = (uint8)t[s + k];
        k = k + 1;
    }
    buf[i - s] = 0;
    return (string)buf;
}

CgStruct cg_find_struct(Codegen* g, string name) {
    if (cg_has_targs(name) == 1) {   // generic -> mangled
        name = cg_ensure_struct_inst(g, name);
    }
    int i = NameIdx_first(&g.structs_ix, name);
    if (i >= 0) {
        return List_get<CgStruct>(&g.structs, i);
    }
    let none: CgStruct;
    none.name = "";
    List_init<string>(&none.fnames, 1);
    List_init<string>(&none.fetys, 1);
    return none;
}

int cg_field_idx(CgStruct* s, string fname) {
    int i = 0;
    int n = List_len<string>(&s.fnames);
    if (n > 8 && s.name != null) {             // a hash index (ast_fx_*) for a wide struct
        string owner = cg_cat("c:", s.name);
        if (ast_fx_ready(owner, n) == 0) {
            while (i < n) {
                ast_fx_put(owner, List_get<string>(&s.fnames, i), i);
                i = i + 1;
            }
            ast_fx_done(owner, n);
            i = 0;
        }
        int k = ast_fx_get(owner, fname);
        if (k >= 0 && k < n && cg_streq(List_get<string>(&s.fnames, k), fname) == 1) {
            return k;
        }
        if (k < 0) {
            return 0 - 1;
        }
    }
    while (i < n) {
        if (cg_streq(List_get<string>(&s.fnames, i), fname) == 1) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Innermost local binding for `name` (slot == "" if none).
CgLocal cg_find_local(Codegen* g, string name) {
    int i = NameIdx_last(&g.locals_ix, name);
    if (i >= 0) {
        return List_get<CgLocal>(&g.locals, i);
    }
    let none: CgLocal;
    none.name = name;
    none.slot = "";
    none.ty = "i32";
    none.ety = "";
    return none;
}

// Drop a leading pointee "const " (`const P*` -> `P*`): const has no representation, and
// the type's consumers (member access, deref, method mangling) expect the bare spelling.
string cg_strip_lead_const(string t) {
    if (t[0] == 99 && t[1] == 111 && t[2] == 110 && t[3] == 115 && t[4] == 116 && t[5] == 32) {
        return (string)((*uint8)t + 6);
    }
    return t;
}

void cg_add_local(Codegen* g, string name, string slot, string ty, string ety) {
    let l: CgLocal;
    l.name = name;
    l.slot = slot;
    l.ty = ty;
    l.ety = cg_dealias(g, cg_strip_lead_const(ety));
    cg_push_local(g, l);
}

void cg_add_global(Codegen* g, string name, string slot, string ty, string ety) {
    let l: CgLocal;
    l.name = name;
    l.slot = slot;
    l.ty = ty;
    l.ety = cg_dealias(g, ety);
    List_push<CgLocal>(&g.gvars, l);
    NameIdx_push(&g.gvars_ix, l.name);
}

// A global variable by name, or a sentinel with empty .slot if not found.
CgLocal cg_find_global(Codegen* g, string name) {
    int i = NameIdx_first(&g.gvars_ix, name);
    if (i >= 0) {
        return List_get<CgLocal>(&g.gvars, i);
    }
    let none: CgLocal;
    none.name = name;
    none.slot = "";
    none.ty = "i32";
    none.ety = "";
    return none;
}

// `sizeof(x)` of a variable measures the variable's type (C semantics): the parser reads
// the operand as a type spelling, so a name bound to a local/global (and not a struct)
// resolves to that binding's type. Mirrors the C++ visit(SizeofExpr) rewrite.
string cg_sizeof_ty(Codegen* g, string t) {
    if (cg_is_struct(g, t) == 1) {
        return t;
    }
    CgLocal l = cg_find_local(g, t);
    if (l.slot[0] != 0 && l.ety[0] != 0) {
        return l.ety;
    }
    CgLocal gv = cg_find_global(g, t);
    if (gv.slot[0] != 0 && gv.ety[0] != 0) {
        return gv.ety;
    }
    return t;
}

// The type `sizeof` measures, with the active substitution applied: the operand's type
// for `sizeof(expr)` (never evaluated), else the named type or variable's type.
string cg_sizeof_operand(Codegen* g, *ExprNode e) {
    if (e.a != null) {
        return cg_apply_sub(g, cg_etype(g, e.a));
    }
    return cg_apply_sub(g, cg_sizeof_ty(g, e.sval));
}

// Constant initializer text for a global of LLVM type `llty`. Literal scalars fold to a
// constant; everything else (incl. a missing/non-constant init) is zeroinitializer —
// such a global must be set up at runtime (e.g. List_init in a session-init function).
// 64-bit value → "HHHHHHHHHHHHHHHH" (16 uppercase hex digits, MSB first).
string cg_hex16(uint64 bits) {
    *uint8 buf = alloc<uint8>(17);
    int i = 0;
    while (i < 16) {
        int shift = (15 - i) * 4;
        int nib = (int)((bits >> (uint64)shift) & (uint64)15);
        buf[i] = (uint8)cg_hexd(nib);
        i = i + 1;
    }
    buf[16] = 0;
    return (string)buf;
}

// LLVM constant text for a float (f32) slot: always the hex form `0x<double-bits>`
// of the value rounded to f32, since a plain decimal is rejected when it is not
// exactly representable in f32 (LLVM: "floating point constant invalid for type").
string cg_float_hex(string dec) {
    double d = atof(dec);
    float f = (float)d;             // round to f32
    double d2 = (double)f;          // widen back — LLVM's hex form is these double bits
    *uint64 pb = (*uint64)(&d2);
    return cg_cat("0x", cg_hex16(*pb));
}

// Does `s` already look like a floating literal (has '.', exponent, or hex marker)?
int cg_has_float_mark(string s) {
    int i = 0;
    while (s[i] != 0) {
        int c = (int)s[i];
        if (c == 46 || c == 101 || c == 69 || c == 120 || c == 88) {   // . e E x X
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Emit `text` (a numeric literal) as a valid LLVM constant for slot type `llty`:
// float → hex form; double → ensure a decimal point (LLVM rejects `double 1`);
// integer types → as-is.
// Normalize a double literal for LLVM textual IR, which requires a decimal point:
// an exponent-only form like "1e6" becomes "1.0e6"; a bare "5" becomes "5.0".
string cg_double_lit(string text) {
    double dv = atof(text);                                      // too large for double: infinity,
    *uint64 db = (*uint64)(&dv);                                 // in LLVM's hex form (as C++ emits)
    if (((*db >> 52) & (uint64)2047) == (uint64)2047) {
        return cg_cat("0x", cg_hex16(*db));
    }
    int i = 0;
    int has_dot = 0;
    int ei = 0 - 1;
    while (text[i] != 0) {
        int c = (int)text[i];
        if (c == 46) {                            // '.'
            has_dot = 1;
        }
        if ((c == 101 || c == 69) && ei == (0 - 1)) {  // first 'e'/'E'
            ei = i;
        }
        i = i + 1;
    }
    if (has_dot == 1) {
        return text;
    }
    if (ei == (0 - 1)) {
        return cg_cat(text, ".0");
    }
    let out: String;
    String_init(&out, 16);
    int j = 0;
    while (j < ei) {
        String_push(&out, (char)text[j]);
        j = j + 1;
    }
    String_append(&out, ".0");
    while (text[j] != 0) {
        String_push(&out, (char)text[j]);
        j = j + 1;
    }
    return (string)String_cstr(&out);
}

string cg_num_const(string llty, string text) {
    if (cg_streq(llty, "float") == 1) {
        return cg_float_hex(text);
    }
    if (cg_streq(llty, "double") == 1) {
        return cg_double_lit(text);
    }
    // Integer slot: LLVM textual IR only accepts decimal, so always normalize the literal
    // (hex `0xFF` / octal `0NN` / decimal) to a decimal magnitude, preserving the sign.
    string dec = cg_u64toa(cg_int_lit_mag(text));
    if (text[0] == 45) {
        return cg_cat("-", dec);
    }
    return dec;
}

// The byte image of a constant bitfield-struct or union literal (little-endian), as
// CodeGen::constAggregateImage builds it: `op` marks bytes held by a constant with no
// byte form (an address), which only the element at that exact offset (a `dir` entry:
// offset + LLVM type, with its constant text in `dtx`) can carry.
struct CgImg {
    *uint8 b;
    *uint8 op;
    int n;
    List<CgLeaf> dir;
    List<string> dtx;
}

string cg_global_init(Codegen* g, *ExprNode e, string llty);   // fwd
string cg_i64toa(int64 v);                                      // fwd
string cg_global_init_ty(Codegen* g, *ExprNode e, string ety);  // fwd
int64 cg_k_wrap(int64 v, int w, int uns);                       // fwd
int cg_is_bf_struct(Codegen* g, string sname);                  // fwd
int cg_ll_align_of(Codegen* g, string t);                       // fwd
int cg_ll_size_of(Codegen* g, string t);                        // fwd

// The value of an integer constant text ("-5", "true", "zeroinitializer") as 64 bits.
uint64 cg_img_ival(string t) {
    if (cg_streq(t, "true") == 1) {
        return (uint64)1;
    }
    if (cg_streq(t, "false") == 1 || cg_streq(t, "zeroinitializer") == 1 || cg_streq(t, "null") == 1) {
        return (uint64)0;
    }
    uint64 m = cg_int_lit_mag(t);
    if (t[0] == 45) {
        return (uint64)0 - m;
    }
    return m;
}

// The IEEE bits of a float/double constant text (hex `0x<double bits>` or decimal).
uint64 cg_img_fbits(string t, int isf) {
    double d = 0.0;
    if (t[0] == 48 && (t[1] == 120 || t[1] == 88)) {
        uint64 hb = cg_int_lit_mag(t);
        *uint64 ph = (*uint64)(&d);
        *ph = hb;
    } else if (cg_streq(t, "zeroinitializer") == 0) {
        d = atof(t);
    }
    if (isf == 1) {
        float f = (float)d;
        *uint32 pf = (*uint32)(&f);
        return (uint64)(*pf);
    }
    *uint64 pd = (*uint64)(&d);
    return *pd;
}

void cg_img_bytes(CgImg* im, int off, uint64 v, int nb) {
    int i = 0;
    while (i < nb && off + i < im.n) {
        im.b[off + i] = (uint8)((v >> (uint64)(i * 8)) & (uint64)255);
        i = i + 1;
    }
}

// Write the scalar constant `t` of LLVM type `llty` at `off`; a value with no byte form
// marks its bytes opaque.
// End of the constant value starting at `p` in `t`: its next top-level ',' or the
// bracket closing the enclosing aggregate (string literals skipped).
int cg_ll_val_end(string t, int p) {
    int depth = 0;
    int inq = 0;
    while (t[p] != 0) {
        int c = (int)t[p];
        if (inq == 1) {
            if (c == 34) {
                inq = 0;
            }
        }
        else if (c == 34) {
            inq = 1;
        }
        else if (c == 123 || c == 91 || c == 40) {
            depth = depth + 1;
        }
        else if (c == 125 || c == 93 || c == 41) {
            if (depth == 0) {
                return p;
            }
            depth = depth - 1;
        }
        else if (c == 44 && depth == 0) {
            return p;
        }
        p = p + 1;
    }
    return p;
}

void cg_img_put(Codegen* g, CgImg* im, int off, string llty, string t);   // fwd
void cg_ll_elem_offs(Codegen* g, string body, List<string>* tys, List<int>* offs);   // fwd

// Write an aggregate constant `t` of LLVM type `llty` (a struct `{ … }` / `<{ … }>` or an
// array `[N x T]`) into the image member by member, so a union holding a struct or an
// array member folds like one holding a scalar. 0 when `t` is not in that form.
int cg_img_put_agg(Codegen* g, CgImg* im, int off, string llty, string t) {
    string body = llty;
    if ((int)llty[0] == 37) {                                   // %name → its body
        body = cg_tydef_body(g, cg_sub_str(llty, 1, cg_strlen(llty)));
        if (body[0] == 0) {
            return 0;
        }
    }
    int b0 = (int)body[0];
    if (b0 != 123 && b0 != 60 && b0 != 91) {
        return 0;
    }
    List<string> tys;
    List_init<string>(&tys, 8);
    List<int> offs;
    List_init<int>(&offs, 8);
    if (b0 == 91) {
        int q = 1;
        cg_ll_ws(body, &q);
        int cnt = cg_ll_num(body, &q);
        cg_ll_ws(body, &q);
        cg_ll_kw(body, &q, "x");
        cg_ll_ws(body, &q);
        string et = cg_sub_str(body, q, cg_strlen(body) - 1);
        int esz = cg_ll_size_of(g, et);
        int k = 0;
        while (k < cnt) {
            List_push<string>(&tys, et);
            List_push<int>(&offs, k * esz);
            k = k + 1;
        }
    } else {
        cg_ll_elem_offs(g, body, &tys, &offs);
    }
    int p = 0;
    cg_ll_ws(t, &p);
    if ((int)t[p] == 60) {     // `<{` packed
        p = p + 1;
        cg_ll_ws(t, &p);
    }
    if (b0 == 91 && (int)t[p] != 91) {             // e.g. a `c"..."` byte string
        return 0;
    }
    if (b0 != 91 && (int)t[p] != 123) {
        return 0;
    }
    p = p + 1;
    int i = 0;
    while (i < List_len<string>(&tys)) {
        cg_ll_ws(t, &p);
        if ((int)t[p] == 125 || (int)t[p] == 93 || t[p] == 0) {
            return 1;
        }
        int al = 1;                // the element's type
        cg_ll_layout(g, t, &p, &al);
        cg_ll_ws(t, &p);
        int e = cg_ll_val_end(t, p);
        string v = cg_trim(cg_sub_str(t, p, e));
        string et = List_get<string>(&tys, i);
        int eoff = off + List_get<int>(&offs, i);
        let dl: CgLeaf;
        dl.off = eoff;
        dl.ty = et;
        List_push<CgLeaf>(&im.dir, dl);
        List_push<string>(&im.dtx, v);
        cg_img_put(g, im, eoff, et, v);
        p = e;
        if ((int)t[p] == 44) {
            p = p + 1;
        }
        i = i + 1;
    }
    return 1;
}

void cg_img_put(Codegen* g, CgImg* im, int off, string llty, string t) {
    int sz = cg_ll_size_of(g, llty);
    int w = cg_int_w(llty);
    if (w > 0) {
        cg_img_bytes(im, off, cg_img_ival(t), sz);
        return;
    }
    if (cg_streq(llty, "double") == 1) {
        cg_img_bytes(im, off, cg_img_fbits(t, 0), 8);
        return;
    }
    if (cg_streq(llty, "float") == 1) {
        cg_img_bytes(im, off, cg_img_fbits(t, 1), 4);
        return;
    }
    if (cg_streq(t, "zeroinitializer") == 1 || cg_streq(t, "null") == 1) {
        return;
    }
    if (cg_img_put_agg(g, im, off, llty, t) == 1) {
        return;
    }
    int i = 0;
    while (i < sz && off + i < im.n) {
        im.op[off + i] = (uint8)1;
        i = i + 1;
    }
}

// The element types of an LLVM struct body `{ a, b }` / `<{ a, b }>` (*packed = 1 for `<{`).
void cg_ll_elems(Codegen* g, string s, List<string>* out, int* pk) {
    int pos = 0;
    cg_ll_ws(s, &pos);
    pk[0] = 0;
    if ((int)s[pos] == 60) {
        pk[0] = 1;
        pos = pos + 1;
        cg_ll_ws(s, &pos);
    }
    if ((int)s[pos] == 123) {
        pos = pos + 1;
    }
    cg_ll_ws(s, &pos);
    while (s[pos] != 0 && (int)s[pos] != 125) {
        int st = pos;
        int al = 1;
        cg_ll_layout(g, s, &pos, &al);
        List_push<string>(out, cg_sub_str(s, st, pos));
        cg_ll_ws(s, &pos);
        if ((int)s[pos] == 44) {
            pos = pos + 1;
        }
        cg_ll_ws(s, &pos);
    }
}

// Byte offsets of the elements of an LLVM struct body.
void cg_ll_elem_offs(Codegen* g, string body, List<string>* tys, List<int>* offs) {
    int pkd = 0;
    cg_ll_elems(g, body, tys, &pkd);
    int off = 0;
    int i = 0;
    while (i < List_len<string>(tys)) {
        string t = List_get<string>(tys, i);
        if (pkd == 0) {
            off = cg_align_up(off, cg_ll_align_of(g, t));
        }
        List_push<int>(offs, off);
        off = off + cg_ll_size_of(g, t);
        i = i + 1;
    }
}

// Constant text of LLVM type `llty` at `off` read back from the image ("" = not representable).
string cg_img_render(Codegen* g, CgImg* im, string llty, int off) {
    int di = 0;
    while (di < List_len<CgLeaf>(&im.dir)) {
        CgLeaf dl = List_get<CgLeaf>(&im.dir, di);
        if (dl.off == off && cg_streq(dl.ty, llty) == 1) {
            return List_get<string>(&im.dtx, di);
        }
        // An address where the layout has a pointer-sized integer (a union laid out as int64).
        if (dl.off == off && cg_streq(dl.ty, "ptr") == 1 && cg_int_w(llty) > 0
            && cg_ll_size_of(g, llty) == cg_ll_size_of(g, "ptr")) {
            return cg_cat(cg_cat(cg_cat(cg_cat("ptrtoint (ptr ", List_get<string>(&im.dtx, di)), " to "), llty), ")");
        }
        di = di + 1;
    }
    int sz = cg_ll_size_of(g, llty);
    if (off + sz > im.n) {
        return "";
    }
    string body = llty;
    if ((int)llty[0] == 37) {                                   // %name → its body
        body = cg_tydef_body(g, cg_sub_str(llty, 1, cg_strlen(llty)));
        if (body[0] == 0) {
            return "";
        }
    }
    if ((int)body[0] == 123 || (int)body[0] == 60) {            // { … } / <{ … }>
        List<string> tys;
        List_init<string>(&tys, 8);
        List<int> offs;
        List_init<int>(&offs, 8);
        cg_ll_elem_offs(g, body, &tys, &offs);
        int pkd = 0;
        if ((int)body[0] == 60) {
            pkd = 1;
        }
        let out: String;
        String_init(&out, 64);
        if (pkd == 1) {
            String_append(&out, "<{ ");
        } else {
            String_append(&out, "{ ");
        }
        int i = 0;
        while (i < List_len<string>(&tys)) {
            string et = List_get<string>(&tys, i);
            string ev = cg_img_render(g, im, et, off + List_get<int>(&offs, i));
            if (ev[0] == 0) {
                return "";
            }
            if (i > 0) {
                String_append(&out, ", ");
            }
            String_append(&out, et);
            String_push(&out, ' ');
            String_append(&out, ev);
            i = i + 1;
        }
        if (pkd == 1) {
            String_append(&out, " }>");
        } else {
            String_append(&out, " }");
        }
        return (string)String_cstr(&out);
    }
    int i = 0;
    int zero = 1;
    while (i < sz) {
        if (im.op[off + i] != 0) {
            return "";
        }
        if (im.b[off + i] != 0) {
            zero = 0;
        }
        i = i + 1;
    }
    if ((int)body[0] == 91) {                                   // [N x T]
        int p = 1;
        cg_ll_ws(body, &p);
        int cnt = cg_ll_num(body, &p);
        cg_ll_ws(body, &p);
        cg_ll_kw(body, &p, "x");
        cg_ll_ws(body, &p);
        string et = cg_sub_str(body, p, cg_strlen(body) - 1);
        if (zero == 1) {
            return "zeroinitializer";
        }
        int esz = cg_ll_size_of(g, et);
        let out: String;
        String_init(&out, 64);
        String_push(&out, '[');
        int k = 0;
        while (k < cnt) {
            string ev = cg_img_render(g, im, et, off + k * esz);
            if (ev[0] == 0) {
                return "";
            }
            if (k > 0) {
                String_append(&out, ", ");
            }
            String_append(&out, et);
            String_push(&out, ' ');
            String_append(&out, ev);
            k = k + 1;
        }
        String_push(&out, ']');
        return (string)String_cstr(&out);
    }
    uint64 v = (uint64)0;
    i = 0;
    while (i < sz && i < 8) {
        v = v | ((uint64)im.b[off + i] << (uint64)(i * 8));
        i = i + 1;
    }
    int w = cg_int_w(body);
    if (w > 0) {
        if (w == 1) {
            if ((v & (uint64)1) != (uint64)0) {
                return "true";
            }
            return "false";
        }
        return cg_i64toa(cg_k_wrap((int64)v, w, 0));
    }
    if (cg_streq(body, "double") == 1) {
        return cg_cat("0x", cg_hex16(v));
    }
    if (cg_streq(body, "float") == 1) {
        uint32 fb = (uint32)v;
        float f = (float)0.0;
        if ((fb & (uint32)0x7F800000) == (uint32)0x7F800000) {   // inf/NaN: widen the bits exactly
            uint64 db = ((uint64)(fb & (uint32)0x80000000) << (uint64)32) | (uint64)0x7FF0000000000000
                      | ((uint64)(fb & (uint32)0x007FFFFF) << (uint64)29);
            return cg_cat("0x", cg_hex16(db));
        }
        *uint32 pf = (*uint32)(&f);
        *pf = fb;
        double d = (double)f;
        *uint64 pd = (*uint64)(&d);
        return cg_cat("0x", cg_hex16(*pd));
    }
    if (zero == 1) {
        if (cg_streq(body, "ptr") == 1) {
            return "null";
        }
        return "zeroinitializer";
    }
    if (cg_streq(body, "ptr") == 1) {                           // integer bytes where the layout has a pointer
        string it = "i64";
        if (sz == 4) {
            it = "i32";
        }
        return cg_cat(cg_cat(cg_cat(cg_cat("inttoptr (", it), " "), cg_i64toa((int64)v)), " to ptr)");
    }
    return "";
}

// Constant text of a bitfield-struct or union literal of `%sname`, folded through its
// byte image ("" if a member is not constant or has no byte form where one is needed).
string cg_split_const(string ty, string body);   // fwd

string cg_const_image(Codegen* g, string sname, *ExprNode e) {
    CgStruct s = cg_find_struct(g, sname);
    string llty = cg_cat("%", sname);
    let im: CgImg;
    im.n = cg_ll_size_of(g, llty);
    im.b = alloc<uint8>(im.n + 1);
    im.op = alloc<uint8>(im.n + 1);
    List_init<CgLeaf>(&im.dir, 4);
    List_init<string>(&im.dtx, 4);
    List<string> etys;
    List_init<string>(&etys, 8);
    List<int> eoffs;
    List_init<int>(&eoffs, 8);
    cg_ll_elem_offs(g, cg_tydef_body(g, sname), &etys, &eoffs);
    int isu = cg_is_union(g, sname);
    int nk = List_len<*ExprNode>(&e.kids);
    int k = 0;
    while (k < nk) {
        string fname = List_get<string>(&e.names, k);
        int idx = k;
        if (fname[0] != 0) {
            idx = cg_field_idx(&s, fname);
        }
        *ExprNode fe = List_get<*ExprNode>(&e.kids, k);
        k = k + 1;
        if (idx < 0 || idx >= List_len<string>(&s.fnames)) {
            continue;
        }
        string fety = List_get<string>(&s.fetys, idx);
        string mll = cg_lltype(g, fety);
        int base = 0;
        CgBF bf = cg_bf(g, sname, List_get<string>(&s.fnames, idx));
        if (isu == 0) {
            if (bf.boffs >= 0) {
                base = bf.boffs;
            }
            else if (bf.fidx >= 0 && bf.fidx < List_len<int>(&eoffs)) {
                base = List_get<int>(&eoffs, bf.fidx);
            }
        }
        if (bf.bw > 0) {
            uint64 v = cg_img_ival(cg_global_init(g, fe, bf.sty));
            int bitpos = base * 8 + bf.boff;
            int b = 0;
            while (b < bf.bw && b < 64) {
                int p = bitpos + b;
                if (p / 8 < im.n) {
                    int m = 1 << (p % 8);
                    if (((v >> (uint64)b) & (uint64)1) != (uint64)0) {
                        im.b[p / 8] = (uint8)((int)im.b[p / 8] | m);
                    }
                    else {
                        im.b[p / 8] = (uint8)((int)im.b[p / 8] & (255 - m));
                    }
                }
                b = b + 1;
            }
            continue;
        }
        string txt = cg_global_init(g, fe, mll);
        let dl: CgLeaf;
        dl.off = base;
        dl.ty = mll;
        List_push<CgLeaf>(&im.dir, dl);
        List_push<string>(&im.dtx, txt);
        cg_img_put(g, &im, base, mll, txt);
    }
    string r = cg_img_render(g, &im, llty, 0);
    // A union global holding an address narrower than its layout member (a pointer in
    // an int64-laid-out union on a 32-bit target) is `{ ptr, [N x i8] }` (C++
    // constAggregateImage).
    if (r[0] != 0 || isu == 0 || g.split_union_top == null || cg_streq(g.split_union_top, llty) == 0) {
        return r;
    }
    if (List_len<CgLeaf>(&im.dir) != 1 || List_get<CgLeaf>(&im.dir, 0).off != 0
        || cg_streq(List_get<CgLeaf>(&im.dir, 0).ty, "ptr") == 0) {
        return "";
    }
    int ps = cg_ll_size_of(g, "ptr");
    if (ps >= im.n) {
        return "";
    }
    int bi = ps;
    while (bi < im.n) {
        if (im.b[bi] != (uint8)0) {
            return "";
        }
        bi = bi + 1;
    }
    string pad = cg_cat("[", cg_cat(cg_itoa(im.n - ps), " x i8]"));
    return cg_split_const(cg_cat("{ ptr, ", cg_cat(pad, " }")),
                          cg_cat("{ ptr ", cg_cat(List_get<string>(&im.dtx, 0), cg_cat(", ", cg_cat(pad, " zeroinitializer }")))));
}

// A constant whose LLVM type is not the declared one (an array with a long zero tail
// folded as `{ given..., [tail x T] zeroinitializer }`) is spelled "!TYPE VALUE", the type
// a balanced `{ … }` / `<{ … }>`. cg_const_ty / cg_tyval read either spelling.
string cg_split_const(string ty, string body) {
    return cg_cat("!", cg_cat(ty, cg_cat(" ", body)));
}

string cg_const_ty(string declty, string v) {
    if ((int)v[0] != 33) {
        return declty;
    }
    int i = 1;
    int depth = 0;
    while (v[i] != 0) {
        int c = (int)v[i];
        if (c == 123) {
            depth = depth + 1;
        }
        if (c == 125) {
            depth = depth - 1;
            if (depth == 0) {
                i = i + 1;
                break;
            }
        }
        i = i + 1;
    }
    if ((int)v[i] == 62) {                  // the `>` closing a packed `<{ … }>`
        i = i + 1;
    }
    return cg_sub_str(v, 1, i);
}

string cg_tyval(string declty, string v) {
    if ((int)v[0] == 33) {
        return cg_sub_str(v, 1, cg_strlen(v));
    }
    return cg_cat(declty, cg_cat(" ", v));
}

// Constant struct-literal text "{ ty v, ty v, ... }" for a global initializer (a
// bitfield struct or a union goes through its byte image, cg_const_image; "" when it
// cannot be folded). Named + positional fields; missing → zero.
// Field defaults (mirrors the C++ defaultExprFor / withDefaults): the expression a value
// of type `t0` starts as when nothing initializes it (`S{}` for a struct with defaults,
// directly or in a field; an array literal of those for an array of it), or null.
StrTab cg_dflt_memo;   // struct name -> 1 has defaults, 2 none, 3 being computed
*ExprNode cg_default_expr(Codegen* g, string t0) {
    if (t0 == null || t0[0] == 0) {
        return null;
    }
    string t = cg_dealias(g, cg_strip_lead_const(t0));
    if (t[0] == 0 || cg_is_ptr_ty(t) == 1) {
        return null;
    }
    if (cg_is_array(t) == 1) {
        *ExprNode de = cg_default_expr(g, cg_array_elem(t));
        if (de == null) {
            return null;
        }
        string ln = cg_array_len_const(g, t);
        if (ln[0] == 0) {
            return null;
        }
        int n = (int)cg_parse_i64(ln);
        if (n <= 0 || n > 65536) {
            return null;
        }
        *ExprNode a = ast_new_expr();
        a.kind = EK_ARRAYLIT;
        int i = 0;
        while (i < n) {
            List_push<*ExprNode>(&a.kids, de);
            i = i + 1;
        }
        return a;
    }
    *DeclNode d = cg_find_tydecl(g, t);
    if (d == null || d.kind != DK_STRUCT || List_len<TypeParam>(&d.type_params) > 0) {
        return null;
    }
    int m = StrTab_get(&cg_dflt_memo, t, 0);
    if (m == 2 || m == 3) {
        return null;
    }
    if (m == 0) {
        StrTab_set(&cg_dflt_memo, t, 3);
        int any = 0;
        int i = 0;
        while (i < List_len<Param>(&d.params) && any == 0) {
            if (i < List_len<*ExprNode>(&d.field_dflts) && List_get<*ExprNode>(&d.field_dflts, i) != null) {
                any = 1;
            }
            else if (cg_default_expr(g, List_get<Param>(&d.params, i).ty) != null) {
                any = 1;
            }
            i = i + 1;
        }
        if (any == 1) {
            StrTab_set(&cg_dflt_memo, t, 1);
        } else {
            StrTab_set(&cg_dflt_memo, t, 2);
            return null;
        }
    }
    *ExprNode si = ast_new_expr();
    si.kind = EK_STRUCTINIT;
    si.sval = t;
    return si;
}

// `e` (a struct literal) with every field it omits given its default, as a named literal;
// `e` itself when the struct has none.
*ExprNode cg_with_defaults(Codegen* g, *ExprNode e) {
    string t = cg_dealias(g, e.sval);
    if (cg_default_expr(g, t) == null) {
        return e;
    }
    *DeclNode d = cg_find_tydecl(g, t);
    int nk = List_len<*ExprNode>(&e.kids);
    int named = 0;
    if (nk > 0 && List_len<string>(&e.names) > 0) {
        string n0 = List_get<string>(&e.names, 0);
        if (n0 != null && n0[0] != 0) {
            named = 1;
        }
    }
    *ExprNode out = ast_new_expr();
    out.kind = EK_STRUCTINIT;
    out.sval = e.sval;
    out.line = e.line;
    out.col = e.col;
    let given: StrTab;
    int i = 0;
    while (i < nk) {
        string fname = "";
        if (named == 1) {
            fname = List_get<string>(&e.names, i);
        }
        else if (i < List_len<Param>(&d.params)) {
            fname = List_get<Param>(&d.params, i).name;
        }
        if (fname[0] != 0) {
            StrTab_set(&given, fname, 1);
            List_push<string>(&out.names, fname);
            List_push<*ExprNode>(&out.kids, List_get<*ExprNode>(&e.kids, i));
        }
        i = i + 1;
    }
    i = 0;
    while (i < List_len<Param>(&d.params)) {
        Param f = List_get<Param>(&d.params, i);
        if (StrTab_has(&given, f.name) == 0) {
            *ExprNode dv = null;
            if (i < List_len<*ExprNode>(&d.field_dflts)) {
                dv = List_get<*ExprNode>(&d.field_dflts, i);
            }
            if (dv == null) {
                dv = cg_default_expr(g, f.ty);
            }
            if (dv != null) {
                List_push<string>(&out.names, f.name);
                List_push<*ExprNode>(&out.kids, dv);
            }
        }
        i = i + 1;
    }
    return out;
}

string cg_const_struct(Codegen* g, string sname0, *ExprNode e0) {
    *ExprNode e = cg_with_defaults(g, e0);             // omitted fields take their defaults
    string sname = cg_dealias(g, sname0);
    CgStruct s = cg_find_struct(g, sname);
    int nf = List_len<string>(&s.fnames);
    if (nf == 0) {
        return "";
    }
    if (cg_is_union(g, sname) == 1 || cg_is_bf_struct(g, sname) == 1) {
        int ns = g.no_split;             // the byte image reads `[N x T]` constants
        g.no_split = 1;
        string img = cg_const_image(g, sname, e);
        g.no_split = ns;
        if (img[0] == 0) {
            dprintf(2, "error: a '%s' literal initializer is not a compile-time constant\n", sname);
            exit(1);
        }
        return img;
    }
    // A `packed struct` is an LLVM packed type `<{ … }>`: its constant must be too.
    int pkd = 0;
    string sbody = cg_tydef_body(g, sname);
    if (sbody[0] == 0) {
        int pal = 1;
        cg_ll_named(g, sname, &pal);
        sbody = cg_tydef_body(g, sname);
    }
    if ((int)sbody[0] == 60) {
        pkd = 1;
    }
    let out: String;
    String_init(&out, 64);
    let tys: String;             // the field types, for a split form
    String_init(&tys, 64);
    int split = 0;
    if (pkd == 1) {
        String_append(&out, "<{ ");
        String_append(&tys, "<{ ");
    }
    else {
        String_append(&out, "{ ");
        String_append(&tys, "{ ");
    }
    int nk = List_len<*ExprNode>(&e.kids);
    int i = 0;
    while (i < nf) {
        if (i > 0) {
            String_append(&out, ", ");
            String_append(&tys, ", ");
        }
        string flty = cg_lltype(g, List_get<string>(&s.fetys, i));
        *ExprNode fe = null;                              // the init provided for field i, if any
        int k = 0;
        while (k < nk) {
            string fname = List_get<string>(&e.names, k);
            int idx = k;                                  // positional by default
            if (fname[0] != 0) {
                idx = cg_field_idx(&s, fname);
            }
            if (idx == i) {
                fe = List_get<*ExprNode>(&e.kids, k);
            }
            k = k + 1;
        }
        string fv = "zeroinitializer";
        if (fe != null) {
            fv = cg_global_init_ty(g, fe, List_get<string>(&s.fetys, i));
        }
        if ((int)fv[0] == 33) {
            split = 1;
        }
        String_append(&tys, cg_const_ty(flty, fv));
        String_append(&out, cg_tyval(flty, fv));
        i = i + 1;
    }
    if (pkd == 1) {
        String_append(&out, " }>");
        String_append(&tys, " }>");
    }
    else {
        String_append(&out, " }");
        String_append(&tys, " }");
    }
    // A field in the split array form makes the struct a literal one with the same layout.
    if (split == 1) {
        return cg_split_const((string)String_cstr(&tys), (string)String_cstr(&out));
    }
    return (string)String_cstr(&out);
}

// Signed decimal text of a 64-bit value.
string cg_i64toa(int64 v) {
    if (v < (int64)0) {
        return cg_cat("-", cg_u64toa((uint64)0 - (uint64)v));
    }
    return cg_u64toa((uint64)v);
}

// Truncate `v` to `w` bits and re-extend (sign- or zero-) to 64, C conversion semantics.
int64 cg_k_wrap(int64 v, int w, int uns) {
    if (w <= 0 || w >= 64) {
        return v;
    }
    uint64 m = ((uint64)1 << (uint64)w) - (uint64)1;
    uint64 u = (uint64)v & m;
    if (uns == 0 && (u >> (uint64)(w - 1)) != (uint64)0) {
        u = u | ~m;
    }
    return (int64)u;
}

// An integer constant of C type (w bits, uns): the value is converted to that type.
CgK cg_k_mk(int64 v, int w, int uns) {
    let k: CgK;
    k.ok = 1;
    k.isf = 0;
    k.dv = 0.0;
    k.w = w;
    k.uns = uns;
    if (w == 1) {
        if (v != (int64)0) {
            k.iv = (int64)1;
        } else {
            k.iv = (int64)0;
        }
    }
    else {
        k.iv = cg_k_wrap(v, w, uns);
    }
    return k;
}

CgK cg_k_int(int64 v) {
    return cg_k_mk(v, 64, 0);
}

CgK cg_k_flt(double v) {
    let k: CgK;
    k.ok = 1;
    k.isf = 1;
    k.iv = (int64)0;
    k.dv = v;
    k.w = 64;
    k.uns = 0;
    return k;
}

CgK cg_k_none() {
    let k: CgK;
    k.ok = 0;
    k.isf = 0;
    k.iv = (int64)0;
    k.dv = 0.0;
    k.w = 0;
    k.uns = 0;
    return k;
}

int cg_k_true(CgK k) {
    if (k.isf == 1) {
        if (k.dv != 0.0) {
            return 1;
        }
        return 0;
    }
    if (k.iv != (int64)0) {
        return 1;
    }
    return 0;
}

// The value of `k` as a double (an integer converts by its own signedness).
double cg_k_dbl(CgK k) {
    if (k.isf == 1) {
        return k.dv;
    }
    if (k.uns == 1) {
        return (double)(uint64)k.iv;
    }
    return (double)k.iv;
}

// Convert `k` to the Eskiu type `t` (what an implicit conversion or a cast computes).
CgK cg_k_conv(Codegen* g, CgK k, string t) {
    if (k.ok == 0) {
        return k;
    }
    string d = cg_dealias(g, t);
    if (cg_is_float(d) == 1) {
        double x = cg_k_dbl(k);
        if (cg_streq(d, "float") == 1) {
            float f = (float)x;
            x = (double)f;
        }
        CgK r = cg_k_flt(x);
        if (cg_streq(d, "float") == 1) {
            r.w = 32;
        }
        return r;
    }
    int w = cg_int_w(cg_lltype(g, d));
    if (w == 0) {              // a pointer/aggregate: not folded here
        return cg_k_none();
    }
    int uns = cg_is_unsigned(d);
    if (w == 1) {   // to bool: `!= 0`
        return cg_k_mk((int64)cg_k_true(k), 1, 1);
    }
    if (k.isf == 1) {
        if (uns == 1) {
            return cg_k_mk((int64)(uint64)k.dv, w, 1);
        }
        return cg_k_mk((int64)k.dv, w, 0);
    }
    return cg_k_mk(k.iv, w, uns);
}

// C integer promotion: an integer narrower than int is an int (its value is unchanged).
CgK cg_k_prom(CgK k) {
    if (k.isf == 0 && k.w < 32) {
        k.w = 32;
        k.uns = 0;
    }
    return k;
}

// Fold a constant scalar expression (a global/`static` initializer, a case label):
// literals, enum members and `const` globals, sizeof, casts, unary/binary operators,
// and `?:`. Every step follows the run-time codegen's C semantics (integer promotions,
// the usual arithmetic conversions, wrapping to the result width), so a constant
// initializer holds exactly what the same expression computes at run time. Mirrors
// the C++ back-end, which folds by running its expression codegen (foldViaCodegen).
// .ok == 0 when not foldable.
CgK cg_cfold(Codegen* g, *ExprNode e) {
    if (e == null) {
        return cg_k_none();
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {
            uint64 mag = cg_int_lit_mag(e.sval);
            int64 m = (int64)mag;
            if (e.sval[0] == 45) {
                m = (int64)0 - m;
            }
            int w = 32;                                  // int, or int64 when it does not fit
            if (e.sval[0] == 45) {
                if (mag > (uint64)2147483648) {
                    w = 64;
                }
            }
            else if (mag > (uint64)2147483647) {
                w = 64;
            }
            if (e.sval[0] != 45 && mag > (uint64)9223372036854775807) {   // uint64
                return cg_k_mk(m, 64, 1);
            }
            return cg_k_mk(m, w, 0);
        }
        if (e.lit_kind == LIT_FLOAT) {
            return cg_k_flt(atof(e.sval));
        }
        if (e.lit_kind == LIT_CHAR) {
            return cg_k_mk((int64)(uint8)e.sval[0], 8, 1);
        }
        if (e.lit_kind == LIT_BOOL) {
            if (cg_streq(e.sval, "true") == 1) {
                return cg_k_mk((int64)1, 1, 1);
            }
            return cg_k_mk((int64)0, 1, 1);
        }
        return cg_k_none();
    }
    if (e.kind == EK_IDENT) {
        string v = cg_enum_val(g, e.sval);
        if (v[0] != 0) {
            int64 m = (int64)cg_int_lit_mag(v);
            if (v[0] == 45) {
                m = (int64)0 - m;
            }
            return cg_k_mk(m, 32, 0);
        }
        int i = NameIdx_last(&g.fconsts_ix, e.sval);
        if (i >= 0) {
            return List_get<CgFK>(&g.fconsts, i).k;
        }
        return cg_k_none();
    }
    if (e.kind == EK_SIZEOF) {
        return cg_k_mk((int64)cg_size(g, cg_sizeof_operand(g, e)), 64, 0);
    }
    if (e.kind == EK_CAST) {
        CgK k = cg_cfold(g, e.a);
        if (k.ok == 0) {
            return k;
        }
        return cg_k_conv(g, k, cg_apply_sub(g, e.sval));
    }
    if (e.kind == EK_UNARY) {
        CgK k = cg_cfold(g, e.a);
        if (k.ok == 0) {
            return k;
        }
        if (cg_streq(e.sval, "+") == 1) {
            return k;
        }
        if (cg_streq(e.sval, "!") == 1) {
            return cg_k_mk((int64)(1 - cg_k_true(k)), 1, 1);
        }
        if (k.isf == 1) {
            if (cg_streq(e.sval, "-") == 1) {
                CgK r = cg_k_flt(0.0 - k.dv);
                r.w = k.w;
                return r;
            }
            return cg_k_none();
        }
        k = cg_k_prom(k);
        if (cg_streq(e.sval, "-") == 1) {
            return cg_k_mk((int64)((uint64)0 - (uint64)k.iv), k.w, k.uns);
        }
        if (cg_streq(e.sval, "~") == 1) {
            return cg_k_mk(~k.iv, k.w, k.uns);
        }
        return cg_k_none();
    }
    if (e.kind == EK_TERNARY) {
        CgK c = cg_cfold(g, e.a);
        if (c.ok == 0) {
            return c;
        }
        CgK arm = cg_k_none();
        if (cg_k_true(c) == 1) {
            arm = cg_cfold(g, e.b);
        }
        else {
            arm = cg_cfold(g, List_get<*ExprNode>(&e.kids, 0));
        }
        if (arm.ok == 0) {
            return arm;
        }
        string rt = cg_etype(g, e);                      // the arms' common type
        if (cg_is_num_ety(g, rt) == 1) {
            return cg_k_conv(g, arm, rt);
        }
        return arm;
    }
    if (e.kind == EK_BINARY) {
        string op = e.sval;
        CgK a = cg_cfold(g, e.a);
        if (a.ok == 0) {
            return a;
        }
        if (cg_streq(op, "&&") == 1 || cg_streq(op, "||") == 1) {
            int la = cg_k_true(a);                       // short-circuit, like the run time
            if (cg_streq(op, "&&") == 1 && la == 0) {
                return cg_k_mk((int64)0, 1, 1);
            }
            if (cg_streq(op, "||") == 1 && la == 1) {
                return cg_k_mk((int64)1, 1, 1);
            }
            CgK rb = cg_cfold(g, e.b);
            if (rb.ok == 0) {
                return rb;
            }
            return cg_k_mk((int64)cg_k_true(rb), 1, 1);
        }
        CgK b = cg_cfold(g, e.b);
        if (b.ok == 0) {
            return b;
        }
        int r = 0 - 1;
        if (a.isf == 1 || b.isf == 1) {
            double x = cg_k_dbl(a);
            double y = cg_k_dbl(b);
            int fw = 64;                                 // float only when no double is involved
            if ((a.isf == 0 || a.w == 32) && (b.isf == 0 || b.w == 32)) {
                fw = 32;
            }
            double z = 0.0;
            int arith = 1;
            if (cg_streq(op, "+") == 1) {
                z = x + y;
            }
            else if (cg_streq(op, "-") == 1) {
                z = x - y;
            }
            else if (cg_streq(op, "*") == 1) {
                z = x * y;
            }
            else if (cg_streq(op, "/") == 1) {
                z = x / y;
            }
            else {
                arith = 0;
            }
            if (arith == 1) {
                if (fw == 32) {
                    float f = (float)z;
                    z = (double)f;
                }
                CgK fr = cg_k_flt(z);
                fr.w = fw;
                return fr;
            }
            if (cg_streq(op, "==") == 1) {
                r = 0;
                if (x == y) {
                    r = 1;
                }
            }
            if (cg_streq(op, "!=") == 1) {
                r = 0;
                if (x != y) {
                    r = 1;
                }
            }
            if (cg_streq(op, "<") == 1) {
                r = 0;
                if (x < y) {
                    r = 1;
                }
            }
            if (cg_streq(op, ">") == 1) {
                r = 0;
                if (x > y) {
                    r = 1;
                }
            }
            if (cg_streq(op, "<=") == 1) {
                r = 0;
                if (x <= y) {
                    r = 1;
                }
            }
            if (cg_streq(op, ">=") == 1) {
                r = 0;
                if (x >= y) {
                    r = 1;
                }
            }
            if (r >= 0) {
                return cg_k_mk((int64)r, 1, 1);
            }
            return cg_k_none();
        }
        a = cg_k_prom(a);
        b = cg_k_prom(b);
        if (cg_streq(op, "<<") == 1 || cg_streq(op, ">>") == 1) {
            // The result has the promoted left operand's type; a count past its width
            // is undefined (folded to 0).
            uint64 cnt = (uint64)b.iv;
            if (cnt >= (uint64)a.w) {
                return cg_k_mk((int64)0, a.w, a.uns);
            }
            if (cg_streq(op, "<<") == 1) {
                return cg_k_mk((int64)((uint64)a.iv << cnt), a.w, a.uns);
            }
            if (a.uns == 1) {
                return cg_k_mk((int64)((uint64)a.iv >> cnt), a.w, 1);
            }
            return cg_k_mk(a.iv >> (int64)cnt, a.w, 0);
        }
        // The usual arithmetic conversions: a signed/unsigned pair is unsigned unless
        // the signed type is wider.
        int w = a.w;
        int uns = a.uns;
        if (a.uns == b.uns) {
            if (b.w > w) {
                w = b.w;
            }
        }
        else {
            int wu = a.w;
            int ws = b.w;
            if (b.uns == 1) {
                wu = b.w;
                ws = a.w;
            }
            if (wu >= ws) {
                w = wu;
                uns = 1;
            } else {
                w = ws;
                uns = 0;
            }
        }
        a = cg_k_mk(a.iv, w, uns);
        b = cg_k_mk(b.iv, w, uns);
        int64 x = a.iv;
        int64 y = b.iv;
        uint64 ux = (uint64)x;
        uint64 uy = (uint64)y;
        if (cg_streq(op, "+") == 1) {
            return cg_k_mk((int64)(ux + uy), w, uns);
        }
        if (cg_streq(op, "-") == 1) {
            return cg_k_mk((int64)(ux - uy), w, uns);
        }
        if (cg_streq(op, "*") == 1) {
            return cg_k_mk((int64)(ux * uy), w, uns);
        }
        if (cg_streq(op, "/") == 1 || cg_streq(op, "%") == 1) {
            if (y == (int64)0) {
                return cg_k_none();
            }
            if (uns == 1) {
                if (cg_streq(op, "/") == 1) {
                    return cg_k_mk((int64)(ux / uy), w, 1);
                }
                return cg_k_mk((int64)(ux % uy), w, 1);
            }
            if (y == (int64)(0 - 1)) {
                if (cg_streq(op, "/") == 1) {
                    return cg_k_mk((int64)((uint64)0 - ux), w, 0);
                }
                return cg_k_mk((int64)0, w, 0);
            }
            if (cg_streq(op, "/") == 1) {
                return cg_k_mk(x / y, w, 0);
            }
            return cg_k_mk(x % y, w, 0);
        }
        if (cg_streq(op, "&") == 1) {
            return cg_k_mk((int64)(ux & uy), w, uns);
        }
        if (cg_streq(op, "|") == 1) {
            return cg_k_mk((int64)(ux | uy), w, uns);
        }
        if (cg_streq(op, "^") == 1) {
            return cg_k_mk((int64)(ux ^ uy), w, uns);
        }
        if (cg_streq(op, "==") == 1) {
            r = 0;
            if (x == y) {
                r = 1;
            }
        }
        if (cg_streq(op, "!=") == 1) {
            r = 0;
            if (x != y) {
                r = 1;
            }
        }
        if (uns == 1) {
            if (cg_streq(op, "<") == 1) {
                r = 0;
                if (ux < uy) {
                    r = 1;
                }
            }
            if (cg_streq(op, ">") == 1) {
                r = 0;
                if (ux > uy) {
                    r = 1;
                }
            }
            if (cg_streq(op, "<=") == 1) {
                r = 0;
                if (ux <= uy) {
                    r = 1;
                }
            }
            if (cg_streq(op, ">=") == 1) {
                r = 0;
                if (ux >= uy) {
                    r = 1;
                }
            }
        } else {
            if (cg_streq(op, "<") == 1) {
                r = 0;
                if (x < y) {
                    r = 1;
                }
            }
            if (cg_streq(op, ">") == 1) {
                r = 0;
                if (x > y) {
                    r = 1;
                }
            }
            if (cg_streq(op, "<=") == 1) {
                r = 0;
                if (x <= y) {
                    r = 1;
                }
            }
            if (cg_streq(op, ">=") == 1) {
                r = 0;
                if (x >= y) {
                    r = 1;
                }
            }
        }
        if (r >= 0) {
            return cg_k_mk((int64)r, 1, 1);
        }
        return cg_k_none();
    }
    return cg_k_none();
}

// Fold a top-level `const` declaration's initializer in its declared type and record
// it: a signed int goes to econsts (read as an int operand), anything else to fconsts.
void cg_fold_const_decl(Codegen* g, *DeclNode d) {
    string dt = cg_dealias(g, d.ret_type);
    string dll = cg_lltype(g, dt);
    CgK k = cg_k_conv(g, cg_cfold(g, d.init), dt);
    if (k.ok == 1 && cg_streq(dll, "i32") == 1 && cg_is_unsigned(dt) == 0) {
        let ec2: CgEnumC;
        ec2.name = d.name;
        ec2.val = cg_i64toa(k.iv);
        List_push<CgEnumC>(&g.econsts, ec2);
        NameIdx_push(&g.econsts_ix, ec2.name);
    } else if (k.ok == 1) {
        let ik: CgFK;
        ik.name = d.name;
        ik.k = k;
        List_push<CgFK>(&g.fconsts, ik);
        NameIdx_push(&g.fconsts_ix, ik.name);
    }
}

// Render a folded constant as LLVM constant text for slot type `llty` ("" if the slot
// is not a scalar numeric type). Integers are wrapped to the slot width (C conversion).
string cg_k_text(CgK k, string llty) {
    if (cg_streq(llty, "double") == 1 || cg_streq(llty, "float") == 1) {
        double d = cg_k_dbl(k);
        if (cg_streq(llty, "float") == 1) {
            float f = (float)d;
            d = (double)f;
        }
        *uint64 pb = (*uint64)(&d);
        return cg_cat("0x", cg_hex16(*pb));
    }
    int w = cg_int_w(llty);
    if (w == 0) {
        return "";
    }
    if (w == 1) {
        if (cg_k_true(k) == 1) {
            return "true";
        }
        return "false";
    }
    int64 v = k.iv;
    if (k.isf == 1) {
        v = (int64)k.dv;
    }
    return cg_i64toa(cg_k_wrap(v, w, 0));
}

string cg_global_init(Codegen* g, *ExprNode e, string llty) {
    if (e == null) {
        return "zeroinitializer";
    }
    // `&global`: a link-time constant address.
    if (e.kind == EK_UNARY && cg_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        CgLocal gl = cg_find_global(g, e.a.sval);
        if (gl.slot[0] != 0) {
            return gl.slot;
        }
    }
    // A foldable operator expression (`3 + 1`, `A * 2`, `1.0 / 4.0`, `c ? a : b`, a cast).
    if (e.kind == EK_BINARY || e.kind == EK_TERNARY || e.kind == EK_UNARY || e.kind == EK_CAST
        || e.kind == EK_IDENT) {
        CgK k = cg_cfold(g, e);
        if (k.ok == 1) {
            string kt = cg_k_text(k, llty);
            if (kt[0] != 0) {
                return kt;
            }
        }
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_NULL) {
            return "null";
        }
        if (e.lit_kind == LIT_CHAR) {
            return cg_itoa((int)e.sval[0]);
        }
        if (e.lit_kind == LIT_BOOL) {      // e.sval is "true"/"false"
            return e.sval;
        }
        if (e.lit_kind == LIT_STRING) {   // ptr to a real constant
            return cg_string_global(g, e.sval);
        }
        return cg_num_const(llty, e.sval);                   // integer / float literal, slot-typed
    }
    if (e.kind == EK_CAST) {
        // Fold a numeric cast in a constant initializer: emit the operand as the cast's
        // LLVM target type (float → hex form, double → decimal, integer → as-is).
        string dll = cg_lltype(g, cg_apply_sub(g, e.sval));
        return cg_global_init(g, e.a, dll);
    }
    if (e.kind == EK_IDENT) {
        // An enum constant or a folded top-level `const int` (both live in econsts).
        string v = cg_enum_val(g, e.sval);
        if (v[0] != 0) {
            return cg_num_const(llty, v);
        }
        // A top-level function name is the constant closure { @__fnptr_f, null } (`Op g = add;`).
        if (cg_streq(llty, "%closure") == 1 && cg_find_global(g, e.sval).slot[0] == 0 && NameIdx_first(&g.topfns_ix, e.sval) >= 0) {
            cg_queue_fn_thunk(g, e.sval);
            return cg_cat(cg_cat("{ ptr @__fnptr_", e.sval), ", ptr null }");
        }
        return "zeroinitializer";
    }
    if (e.kind == EK_SIZEOF) {
        return cg_itoa(cg_size(g, cg_sizeof_operand(g, e)));   // static byte size
    }
    if (e.kind == EK_UNARY) {
        // `-` reaches here rarely (negatives are single literal tokens); `~`/`!` need folding.
        if (cg_streq(e.sval, "!") == 1) {
            string inner = cg_global_init(g, e.a, "i64");
            if (cg_streq(inner, "0") == 1 || cg_streq(inner, "false") == 1) {
                return "true";
            }
            return "false";
        }
        if (cg_streq(e.sval, "~") == 1) {
            // ~x == -x - 1. Fold the operand's magnitude and render the complement.
            string inner = cg_global_init(g, e.a, "i64");
            uint64 m = cg_int_lit_mag(inner);
            if (inner[0] == 45) {        // ~(-m) = m-1
                return cg_u64toa(m - (uint64)1);
            }
            return cg_cat("-", cg_u64toa(m + (uint64)1));                   // ~m = -(m+1)
        }
        if (cg_streq(e.sval, "-") == 1) {
            string inner = cg_global_init(g, e.a, llty);
            if (inner[0] == 45) {   // -(-5) → 5
                return cg_sub_str(inner, 1, cg_strlen(inner));
            }
            return cg_cat("-", inner);
        }
        return "zeroinitializer";
    }
    if (e.kind == EK_STRUCTINIT) {
        string sname = cg_apply_sub(g, e.sval);
        string cs = cg_const_struct(g, sname, e);
        if (cs[0] != 0) {
            return cs;
        }
        return "zeroinitializer";                             // a struct with no fields
    }
    if (e.kind == EK_LAMBDA) {
        // A non-capturing lambda is a compile-time-constant closure { @lambdaN, null }:
        // queue its body for emission and fold to the constant fat pointer, so a global
        // (or static) initializer holds a real callable, not a null closure. A capturing
        // closure needs a live frame, so it can't be a global constant (rare; deferred).
        List<string> pp;
        List_init<string>(&pp, 4);
        cg_paren_list(e.sval, &pp);
        List<string> ids;
        List_init<string>(&ids, 16);
        cg_collect_idents_s(e.stmt, &ids);
        int ci = 0;
        while (ci < List_len<string>(&ids)) {
            string nm = List_get<string>(&ids, ci);
            ci = ci + 1;
            int isparam = 0;
            int pj = 0;
            while (pj < List_len<string>(&pp)) {
                if (cg_streq(cg_last_word(List_get<string>(&pp, pj)), nm) == 1) {
                    isparam = 1;
                }
                pj = pj + 1;
            }
            if (isparam == 1) {
                continue;
            }
            CgLocal l = cg_find_local(g, nm);
            if (l.slot[0] != 0) {   // captures a local: can't fold
                return "zeroinitializer";
            }
        }
        string lname = cg_cat("__lambda", cg_itoa(g.lam_seq));
        g.lam_seq = g.lam_seq + 1;
        List<string> capn;
        List_init<string>(&capn, 1);
        List<string> capt;
        List_init<string>(&capt, 1);
        let lam: CgLambda;
        lam.name = lname;
        lam.node = e;
        lam.capn = capn;
        lam.capt = capt;
        List_init<CgLocal>(&lam.statics, 1);
        lam.sub = cg_copy_sub(&g.cursub);   // freeze the generic substitution for deferred emission
        if (g.lam_expret[0] != 0) {
            lam.rety = g.lam_expret;
        } else {
            lam.rety = cg_arm_var(e.sval);
        }
        List_push<CgLambda>(&g.lambdas, lam);
        return cg_cat(cg_cat("{ ptr @", lname), ", ptr null }");
    }
    if (e.kind == EK_ARRAYLIT) {
        // Fixed-size array literal `{...}`: llty is "[N x T]". Emit an LLVM array constant
        // "[T v0, T v1, ...]", folding each element to T and zero-filling any tail (C
        // semantics: `int[3] = {7}` -> {7,0,0}), recursing for nested arrays.
        if ((int)llty[0] != 91) {    // 91 = '[' ; not an array type
            return "zeroinitializer";
        }
        int L = cg_strlen(llty);
        int i = 1;                                               // past '['
        int64 cnt = (int64)0;
        while (llty[i] != 0 && (int)llty[i] >= 48 && (int)llty[i] <= 57) {
            cnt = cnt * (int64)10 + (int64)((int)llty[i] - 48);
            i = i + 1;
        }
        int es = i + 3;                                          // skip " x " to the element type
        int ee = L - 1;                                          // drop the trailing ']'
        *uint8 buf = alloc<uint8>(ee - es + 1);
        int k = 0;
        while (k < ee - es) {
            buf[k] = (uint8)llty[es + k];
            k = k + 1;
        }
        buf[ee - es] = 0;
        string elemty = (string)buf;
        int nk = List_len<*ExprNode>(&e.kids);
        if ((int64)nk > cnt) {                  // extra elements ignored
            nk = (int)cnt;
        }
        List<string> vals;
        List_init<string>(&vals, nk + 1);
        int split = 0;
        int idx = 0;
        while (idx < nk) {
            string v = cg_global_init(g, List_get<*ExprNode>(&e.kids, idx), elemty);
            if ((int)v[0] == 33) {
                split = 1;
            }
            List_push<string>(&vals, v);
            idx = idx + 1;
        }
        // A long zero tail (or an element already in this form) is a struct of the given
        // elements and one zeroinitializer array for the rest, as clang emits it: the same
        // bytes, without a constant per zero element (cg_split_const).
        int64 tail = cnt - (int64)nk;
        if (g.no_split == 0 && (split == 1 || tail >= (int64)1024)) {
            let tys: String;
            String_init(&tys, 64);
            let body: String;
            String_init(&body, 64);
            String_append(&tys, "{ ");
            String_append(&body, "{ ");
            idx = 0;
            while (idx < nk) {
                if (idx > 0) {
                    String_append(&tys, ", ");
                    String_append(&body, ", ");
                }
                string v = List_get<string>(&vals, idx);
                String_append(&tys, cg_const_ty(elemty, v));
                String_append(&body, cg_tyval(elemty, v));
                idx = idx + 1;
            }
            if (tail > (int64)0) {
                string tt = cg_cat("[", cg_cat(cg_i64toa(tail), cg_cat(" x ", cg_cat(elemty, "]"))));
                if (nk > 0) {
                    String_append(&tys, ", ");
                    String_append(&body, ", ");
                }
                String_append(&tys, tt);
                String_append(&body, tt);
                String_append(&body, " zeroinitializer");
            }
            String_append(&tys, " }");
            String_append(&body, " }");
            return cg_split_const((string)String_cstr(&tys), (string)String_cstr(&body));
        }
        let out: String;
        String_init(&out, 64);
        String_push(&out, '[');
        int64 j = (int64)0;
        while (j < cnt) {
            if (j > (int64)0) {
                String_append(&out, ", ");
            }
            String_append(&out, elemty);
            String_push(&out, ' ');
            if (j < (int64)nk) {
                String_append(&out, List_get<string>(&vals, (int)j));
            }
            else {
                String_append(&out, "zeroinitializer");
            }
            j = j + (int64)1;
        }
        String_push(&out, ']');
        return (string)String_cstr(&out);
    }
    return "zeroinitializer";
}

int cg_is_float(string ty) {
    return cg_streq(ty, "double") == 1 || cg_streq(ty, "float") == 1;
}
