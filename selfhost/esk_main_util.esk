// esk_main_util.esk: the archiver, --safe, files and fmt (part of esk_main.esk, imported in order)

// The archiver for a static library: llvm-ar next to $CLANG when there is one, else ar.
string archiver() {
    string cl = getenv("CLANG");
    if (cl != null && str_contains(cl, "/") == 1) {
        int n = (int)strlen(cl);
        while (n > 0 && cl[n - 1] != '/') {
            n = n - 1;
        }
        string ar = cg_cat(str_prefix(cl, n), "llvm-ar");
        if (fs_exists(ar) == 1) {
            return ar;
        }
    }
    return "ar";
}

// The run-time checks --safe[=LIST] names, as the C++ CodeGen::Safe* bits: 1 bounds,
// 2 overflow, 4 null. No list (a bare --safe) is all three; an unknown name is an
// error (-1).
int safe_checks(string list) {
    if (list == null || list[0] == 0) {
        return 7;
    }
    int mask = 0;
    int start = 0;
    while (1 == 1) {
        int end = start;
        while (list[end] != 0 && (int)list[end] != 44) {
            end = end + 1;
        }
        string name = str_prefix((string)((*uint8)list + start), end - start);
        if (cg_streq(name, "bounds") == 1) {
            mask = mask | 1;
        }
        else if (cg_streq(name, "overflow") == 1) {
            mask = mask | 2;
        }
        else if (cg_streq(name, "null") == 1) {
            mask = mask | 4;
        }
        else {
            eprint("error: unknown --safe check '");
            eprint(name);
            eprint("' (valid: bounds, overflow, null)\n");
            return -1;
        }
        if (list[end] == 0) {
            return mask;
        }
        start = end + 1;
    }
    return mask;
}

int str_contains(string s, string sub) {
    int i = 0;
    while (s[i] != 0) {
        int j = 0;
        while (sub[j] != 0 && s[i + j] == sub[j]) {
            j = j + 1;
        }
        if (sub[j] == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int file_exists(string path) {
    let n: int64 = 0;
    *uint8 b = fs_read_all(path, &n);
    if (b == null) {
        return 0;
    }
    return 1;
}

// Where stdlib/ lives, like the C++ resolveStdlibPath: $ESKIU_ROOT, else the install
// layout next to this binary (<prefix>/bin/eskiuc-esk → <prefix>/lib/eskiu, or the
// dev tree build/eskiuc-esk → build/..). null when none is found (imports then
// resolve against the current directory).
string find_stdlib_root() {
    string env = getenv("ESKIU_ROOT");
    if (env != null) {
        if (env[0] != 0) {
            return env;
        }
    }
    uint8[4096] buf;
    int got = 0;
#ifdef __APPLE__
    let sz: uint32 = 4096;
    if (_NSGetExecutablePath(&buf[0], &sz) == 0) {
        got = 1;
    }
#else
    int64 rn = readlink("/proc/self/exe", (string)&buf[0], 4095);
    if (rn > 0) {
        buf[rn] = 0;
        got = 1;
    }
#endif
    if (got == 0) {
        return null;
    }
    string exe = realpath((string)&buf[0], null);
    if (exe == null) {
        return null;
    }
    string bindir = str_dir(exe);
    string prefix = str_dir(bindir);
    string inst = cg_cat(prefix, "/lib/eskiu");
    if (file_exists(cg_cat(inst, "/stdlib/result.esk")) == 1) {
        return inst;
    }
    string dev = cg_cat(bindir, "/..");
    if (file_exists(cg_cat(dev, "/stdlib/result.esk")) == 1) {
        return dev;
    }
    return null;
}

// The platform temp dir, ending in a separator: $TMPDIR (else /tmp), or GetTempPathA on
// Windows (it honors TMP and TEMP), like the C++ driver's createTemporaryFile.
#ifdef _WIN32
extern uint32 GetTempPathA(uint32 n, *uint8 buf);
string temp_dir() {
    *uint8 buf = alloc<uint8>(1024);
    uint32 n = GetTempPathA(1024, buf);
    if (n == 0 || n >= 1024) {
        return ".\\";
    }
    return (string)buf;
}
#else
string temp_dir() {
    string dir = getenv("TMPDIR");
    if (dir == null) {
        dir = "/tmp";
    }
    else if (dir[0] == 0) {
        dir = "/tmp";
    }
    int dn = 0;
    while (dir[dn] != 0) {
        dn = dn + 1;
    }
    if ((int)dir[dn - 1] == 47) {
        return dir;
    }
    return cg_cat(dir, "/");
}
#endif

// A fresh, uniquely named file `eskiu-<stem>-XXXXXX<suffix>` in the temp dir, created
// with mkstemps so it never names (or replaces) an existing file, such as a user's
// `<out>.ll`. Returns its path, or null when it cannot be created. Windows has no
// mkstemps: the name is unique by process id there.
#ifdef _WIN32
string temp_file(string stem, string suffix) {
    uint8[64] nm;
    sprintf((string)&nm[0], "eskiu-%s-%d", stem, getpid());
    return cg_cat(temp_dir(), cg_cat((string)&nm[0], suffix));
}
#else
string temp_file(string stem, string suffix) {
    string path = cg_cat(temp_dir(), cg_cat("eskiu-", cg_cat(stem, cg_cat("-XXXXXX", suffix))));
    int sn = 0;
    while (suffix[sn] != 0) {
        sn = sn + 1;
    }
    int fd = mkstemps(path, sn);
    if (fd < 0) {
        return null;
    }
    close(fd);
    return path;
}
#endif

// The executable `run` builds: a temp file, named `.exe` on Windows as the linker
// driver would name it anyway.
string temp_exe_path() {
#ifdef _WIN32
    return temp_file("run", ".exe");
#else
    return temp_file("run", "");
#endif
}

// Run `cc ... args` (with -target for a cross build); `what` names the step in the error.
int eir_run_cc(string cc, string triple, List<string>* args, string what) {
    List<string> argv;
    List_init<string>(&argv, 12);
    push_words(&argv, cc);
    if (triple[0] != 0) {
        List_push<string>(&argv, "-target");
        List_push<string>(&argv, triple);
    }
    for (i in 0..List_len<string>(args)) {
        List_push<string>(&argv, List_get<string>(args, i));
    }
    if (spawn_wait(&argv) != 0) {
        eprint("error: ");
        eprint(what);
        eprint(" failed\n");
        return 0;
    }
    return 1;
}

// The EIR's ARM64 assembly `asm_path` and the runtime it calls as one object `out`
// (eir/eir_obj.cpp): the assembly assembled, the runtime C (EC_RT_STANDALONE, generated
// from eir_runtime.cpp) compiled at -O2, both joined with a relocatable link.
// Creates the directory that holds path, if path names one (`build/app` makes build/).
void make_parent_dir(string path) {
    if (path == null || cg_streq(path, "-") == 1) {
        return;
    }
    int last = -1;
    int i = 0;
    while (path[i] != 0) {
        if (path[i] == '/' || path[i] == '\\') {
            last = i;
        }
        i = i + 1;
    }
    if (last <= 0) {
        return;
    }
    let dir: String;
    dir.init(last + 1);
    int k = 0;
    while (k < last) {
        dir.push(path[k]);
        k = k + 1;
    }
    (void)fs_mkdir_p(dir.data);
    dir.free();
}

int eir_join_runtime(string cc, string triple, string asm_path, string out) {
    string code_obj = temp_file("eir", ".o");
    string rt_src = temp_file("rt", ".c");
    string rt_obj = temp_file("rt", ".o");
    if (code_obj == null || rt_src == null || rt_obj == null) {
        eprint("error: could not create a temporary file\n");
        return 0;
    }
    int ok = fs_write_all(rt_src, (*uint8)EC_RT_STANDALONE, (int64)et_len(EC_RT_STANDALONE));
    if (ok == 0) {
        eprint("error: cannot write to ");
        eprint(rt_src);
        eprint("\n");
    }
    List<string> a1;
    List_init<string>(&a1, 4);
    List_push<string>(&a1, "-c");
    List_push<string>(&a1, asm_path);
    List_push<string>(&a1, "-o");
    List_push<string>(&a1, code_obj);
    List<string> a2;
    List_init<string>(&a2, 6);
    List_push<string>(&a2, "-O2");
    List_push<string>(&a2, "-w");
    List_push<string>(&a2, "-c");
    List_push<string>(&a2, rt_src);
    List_push<string>(&a2, "-o");
    List_push<string>(&a2, rt_obj);
    List<string> a3;
    List_init<string>(&a3, 6);
    List_push<string>(&a3, "-r");
    List_push<string>(&a3, "-nostdlib");
    List_push<string>(&a3, code_obj);
    List_push<string>(&a3, rt_obj);
    List_push<string>(&a3, "-o");
    List_push<string>(&a3, out);
    if (ok == 1) {
        ok = eir_run_cc(cc, triple, &a1, "assembler");
    }
    if (ok == 1) {
        ok = eir_run_cc(cc, triple, &a2, "runtime compile");
    }
    if (ok == 1) {
        ok = eir_run_cc(cc, triple, &a3, "relocatable link");
    }
    remove(code_obj);
    remove(rt_src);
    remove(rt_obj);
    return ok;
}

int bytes_eq(*uint8 a, int an, *uint8 b, int bn) {
    if (an != bn) {
        return 0;
    }
    int i = 0;
    while (i < an) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// `eskiuc fmt [--check] [--width N] file.esk …` — reformat each file in place. With
// --check, don't write; exit non-zero if any file is not already formatted. With
// --width, also break long code lines (fmt_wrap). Mirrors the C++ runFmt.
int run_fmt(List<string>* files, int check, int width) {
    if (List_len<string>(files) == 0) {
        eprint("error: fmt: no input files\n");
        return 1;
    }
    int changed = 0;
    int failed = 0;
    int i = 0;
    while (i < List_len<string>(files)) {
        string f = List_get<string>(files, i);
        i = i + 1;
        let flen: int64 = 0;
        *uint8 raw = fs_read_all(f, &flen);
        if (raw == null) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: fmt: cannot open '%s'\n", f);
            eprint((string)&eb[0]);
            failed = failed + 1;
            continue;
        }
        let formatted: String = format_source(raw, (int)flen);
        if (width > 0) {
            formatted = fmt_wrap(&formatted, width);
        }
        *uint8 fb = (*uint8)String_cstr(&formatted);
        int fl = (int)String_len(&formatted);
        if (bytes_eq(fb, fl, raw, (int)flen) == 1) {
            continue;
        }
        changed = changed + 1;
        if (check == 1) {
            printf("%s\n", f);
            continue;
        }
        if (fs_write_all(f, fb, (int64)fl) == 0) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: fmt: cannot write '%s'\n", f);
            eprint((string)&eb[0]);
            failed = failed + 1;
            continue;
        }
    }
    if (failed > 0) {
        return 1;
    }
    if (check == 1 && changed > 0) {   // CI signal: files need formatting
        return 1;
    }
    return 0;
}
