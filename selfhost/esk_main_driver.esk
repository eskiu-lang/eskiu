// esk_main_driver.esk: the driver (esk_main) and main (part of esk_main.esk, imported in order)

// CLI: esk_main [-o <out>] <file.esk>. With -o, produce a native binary (write the IR to a
// temp .ll and invoke clang); without it, emit the .ll to stdout, the form the bootstrap
// harness pipes to clang. The phases (esk_main_args/front/link.esk) run in order; each
// returns ESK_GO_ON or the exit status.
int esk_main(int argc, string* argv) {
    int r = esk_commands(argc, argv);
    if (r != ESK_GO_ON) {
        return r;
    }
    let o: EskOpts;
    esk_opts_init(&o);
    r = esk_parse_args(&o, argc, argv);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_check_args(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_seed_macros(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_front(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_eir(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_codegen(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_write_ir(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_clang_args(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    r = esk_link_args(&o);
    if (r != ESK_GO_ON) {
        return r;
    }
    return esk_finish(&o);
}

// Run the driver on a thread with a large stack, so deeply nested input reaches the
// parser's nesting limit instead of overflowing the stack (see bigstack.esk).
void main_body() {
    big_rc = esk_main(big_argc, big_argv);
}

int main(int argc, string* argv) {
    if (diag_json_wanted(argc, argv) == 1) {
        int drc = diag_json_fork();      // the parent converts the child's stderr
        if (drc >= 0) {
            return drc;
        }
    }
    big_argc = argc;
    big_argv = argv;
    run_on_big_stack(main_body);
    return big_rc;
}
