// Part of sema.esk (nullable pointers and narrowing), imported from it in order; compile sema.esk, not this file alone.

// ── nullable-pointer safety (`?*T`) ──

// Narrowing key of the innermost binding of `name` ("name@depth"), so a shadowing
// declaration is a different variable; "" when unbound.
string sema_nkey(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) {
        return "";
    }
    Sym sy = List_get<Sym>(&s.syms, si);
    int d = sy.depth;
    uint8[24] buf;
    // A `static` local is one cell shared by every call and closure, like a global: its
    // key ends in "@0" (mirrors the C++ narrowKey).
    if (d > 0 && sy.is_static == 1) {
        sprintf((string)&buf[0], "@%d@0", d);
    }
    else {
        sprintf((string)&buf[0], "@%d", d);
    }
    return sema_cat(name, (string)&buf[0]);
}

// Is `name` proven non-null here (a null-check narrowed it, mirrors C++ narrowedNonNull)?
int sema_is_narrowed(Sema* s, string name) {
    string k = sema_nkey(s, name);
    if (k[0] == 0) {
        return 0;
    }
    return sema_in_list(&s.narrowed, k);
}

// Loop-label stack for labeled break/continue (mirrors C++ loopLabelStack).
void sema_lbl_push(Sema* s, string lbl) {
    if (lbl == null) {
        lbl = "";
    }
    List_push<string>(&s.loop_lbls, lbl);
}

void sema_lbl_pop(Sema* s) {
    int n = List_len<string>(&s.loop_lbls);
    if (n > 0) {
        List_remove<string>(&s.loop_lbls, n - 1);
    }
}

// Remove the first `narrowed` entry equal to key `k`.
void sema_narrow_drop(Sema* s, string k) {
    int i = 0;
    int n = List_len<string>(&s.narrowed);
    while (i < n) {
        if (sema_streq(List_get<string>(&s.narrowed, i), k) == 1) {
            List_remove<string>(&s.narrowed, i);
            sema_bump(s);
            return;
        }
        i = i + 1;
    }
}

// Forget every narrowing of variable `name` (any binding depth).
void sema_narrow_kill(Sema* s, string name) {
    int i = List_len<string>(&s.narrowed) - 1;
    while (i >= 0) {
        string k = List_get<string>(&s.narrowed, i);
        int j = 0;
        while (name[j] != 0 && k[j] == name[j]) {
            j = j + 1;
        }
        if (name[j] == 0 && (int)k[j] == 64) {   // '@'
            List_remove<string>(&s.narrowed, i);
            sema_bump(s);
        }
        i = i - 1;
    }
}

// Names whose address is taken (`&x`) anywhere in `e` / `st`, lambda bodies included
// (mirrors astwalk::collectAddressTaken; the same kind-aware walk as sema_drop_assigned).
void sema_addr_names(*StmtNode st, List<string>* out);
void sema_addr_names_e(*ExprNode e, List<string>* out) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        List_push<string>(out, e.a.sval);
    }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        sema_addr_names_e(e.a, out);
        sema_addr_names_e(e.b, out);
    }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST || e.kind == EK_QUESTION
             || e.kind == EK_AWAIT || e.kind == EK_CALL || e.kind == EK_INCDEC) {
        sema_addr_names_e(e.a, out);
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            sema_addr_names_e(List_get<*ExprNode>(&e.kids, i), out);
            i = i + 1;
        }
    }
    if (e.kind == EK_LAMBDA) {
        sema_addr_names(e.stmt, out);
    }
}

void sema_addr_names(*StmtNode st, List<string>* out) {
    if (st == null) {
        return;
    }
    sema_addr_names_e(st.expr, out);
    sema_addr_names_e(st.expr2, out);
    sema_addr_names(st.s1, out);
    sema_addr_names(st.s2, out);
    int i = 0;
    int n = List_len<*StmtNode>(&st.items);
    while (i < n) {
        sema_addr_names(List_get<*StmtNode>(&st.items, i), out);
        i = i + 1;
    }
}

// Mark the innermost binding of `name`: its address is taken, so a write through that
// pointer can null it behind a check (no narrowing).
void sema_mark_addr(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) {
        return;
    }
    Sym sy = List_get<Sym>(&s.syms, si);
    sy.addr_taken = 1;
    List_set<Sym>(&s.syms, si, sy);
    sema_bump(s);
}

// Before a loop body is checked: every `&x` in it (a later iteration's check must not
// trust a pointer taken further down; mirrors the C++ markAddrTakenIn).
void sema_mark_addr_in(Sema* s, *StmtNode st) {
    List<string> names;
    List_init<string>(&names, 4);
    sema_addr_names(st, &names);
    int i = 0;
    while (i < List_len<string>(&names)) {
        sema_mark_addr(s, List_get<string>(&names, i));
        i = i + 1;
    }
    List_free<string>(&names);
}

// A call (or an await) may run code that assigns any global: its narrowing ends.
void sema_drop_global_narrowings(Sema* s) {
    s.call_epoch = s.call_epoch + 1;
    int i = List_len<string>(&s.narrowed) - 1;
    while (i >= 0) {
        string k = List_get<string>(&s.narrowed, i);
        int n = 0;
        while (k[n] != 0) {
            n = n + 1;
        }
        if (n >= 2 && (int)k[n - 2] == 64 && (int)k[n - 1] == 48) {   // "@0"
            List_remove<string>(&s.narrowed, i);
            sema_bump(s);
        }
        i = i - 1;
    }
}

// The keys of global variables ("@0") removed from `keys`.
void sema_drop_global_keys(List<string>* keys) {
    int i = List_len<string>(keys) - 1;
    while (i >= 0) {
        string k = List_get<string>(keys, i);
        int n = 0;
        while (k[n] != 0) {
            n = n + 1;
        }
        if (n >= 2 && (int)k[n - 2] == 64 && (int)k[n - 1] == 48) {
            List_remove<string>(keys, i);
        }
        i = i - 1;
    }
}

// Does evaluating `e` make a call? (A lambda body is not evaluated there; mirrors the C++
// exprHasCall.)
int sema_is_op_call(Sema* s, *ExprNode e);
int sema_has_call(Sema* s, *ExprNode e) {
    if (e == null || e.kind == EK_LAMBDA) {
        return 0;
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_AWAIT
        || e.kind == EK_ALLOCWITH || e.kind == EK_THREADCREATE) {
        return 1;
    }
    if (sema_is_op_call(s, e) == 1) {
        return 1;
    }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        if (sema_has_call(s, e.a) == 1 || sema_has_call(s, e.b) == 1) {
            return 1;
        }
    } else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
               || e.kind == EK_QUESTION || e.kind == EK_INCDEC) {
        if (sema_has_call(s, e.a) == 1) {
            return 1;
        }
    }
    if (e.kind == EK_STRUCTINIT || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            if (sema_has_call(s, List_get<*ExprNode>(&e.kids, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

// The flat name of a generic instance spelling (`G<int>` -> `G_int`, `M<string, int>` ->
// `M_string_int`), like the C++ mangleTemplate; a plain name is itself.
string sema_flat_name(string t) {
    int n = sema_slen(t);
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0;
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            buf[o] = (uint8)c;
            o = o + 1;
        }
        else if (c == 42) {            // '*' -> 'p'
            buf[o] = 112;
            o = o + 1;
        }
        else if (c == 60 || c == 44) {   // '<' ',' -> '_'
            buf[o] = 95;
            o = o + 1;
        }
        i = i + 1;
    }
    buf[o] = 0;
    return (string)buf;
}

*DeclNode sema_variant_enum(Sema* s, string name);
int sema_variant_index(*DeclNode d, string name);
// A generic variant built where a known instance of its enum is expected (`Opt<int64> a =
// Some(5)`, `return None;`, an argument, an assignment, a struct-literal field, an array
// literal element, a variant's payload) takes that instance's type arguments: the node
// becomes the explicit form (`Some<int64>(5)`, `None<int>()`), which codegen lowers as
// written. A `?:` passes the target to both arms, an array literal its element type to
// each element. In a generic body, which every instance shares, only a `raw` target (as
// written: a declared type, the declared return type) is used and its argument spellings
// are kept (`return None;` in an `Opt<T>` function is `None<T>()`). Mirrors the C++
// inferVariantTarget.
void sema_infer_variant_r(Sema* s, *ExprNode x, string t, int raw) {
    int generic = 0;
    if (s.in_inst == 1 || List_len<string>(&s.tparams) > 0) {
        generic = 1;
    }
    if (x == null || t == null || t[0] == 0 || (generic == 1 && raw == 0)) {
        return;
    }
    if (x.kind == EK_TERNARY) {
        sema_infer_variant_r(s, x.b, t, raw);
        if (List_len<*ExprNode>(&x.kids) > 0) {
            sema_infer_variant_r(s, List_get<*ExprNode>(&x.kids, 0), t, raw);
        }
        return;
    }
    if (x.kind == EK_ARRAYLIT) {
        string at = sema_strip_const(t);
        int an = sema_slen(at);
        if (an == 0 || (int)at[an - 1] != 93 || sema_arr_bracket(at) <= 0) {
            return;
        }
        string et = sema_arr_elem(at);
        int ai = 0;
        while (ai < List_len<*ExprNode>(&x.kids)) {
            sema_infer_variant_r(s, List_get<*ExprNode>(&x.kids, ai), et, raw);
            ai = ai + 1;
        }
        return;
    }
    string name = "";
    if (x.kind == EK_CALL && x.a != null && x.a.kind == EK_IDENT) {
        name = x.a.sval;
    }
    else if (x.kind == EK_IDENT) {
        name = x.sval;
    }
    else {
        return;
    }
    if (sema_sym_depth(s, name) > 0) {
        return;
    }
    *DeclNode ve = sema_variant_enum(s, name);
    if (ve == null || List_len<TypeParam>(&ve.type_params) == 0 || sema_variant_index(ve, name) < 0) {
        return;
    }
    string c = sema_strip_const(t);
    if (generic == 0) {
        c = sema_canon(s, t);
    }
    if (c[0] == 0 || (int)c[0] == 63 || sema_has_lt(c) == 0 || sema_streq(sema_base_name(c), ve.name) == 0) {
        return;
    }
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(c, &targs);
    if (List_len<string>(&targs) != List_len<TypeParam>(&ve.type_params)) {
        return;
    }
    string sig = sema_cat(name, "<");
    int i = 0;
    while (i < List_len<string>(&targs)) {
        if (i > 0) {
            sig = sema_cat(sig, ",");
        }
        sig = sema_cat(sig, List_get<string>(&targs, i));
        i = i + 1;
    }
    sig = sema_cat(sig, ">");
    if (x.kind == EK_IDENT) {
        List_init<*ExprNode>(&x.kids, 1);
    }
    x.kind = EK_TEMPLATECALL;
    x.sval = sig;
    x.a = null;
}

void sema_infer_variant(Sema* s, *ExprNode x, string t) {
    sema_infer_variant_r(s, x, t, 0);
}

// The payload arguments of a generic variant built with type arguments `targs` (as
// written) take the payload's instance: `Some<Opt<int64>>(Some(5))`.
void sema_infer_variant_payload(Sema* s, *ExprNode e, string v, List<string>* targs) {
    *DeclNode ed = sema_variant_enum(s, v);
    if (ed == null || List_len<TypeParam>(&ed.type_params) == 0) {
        return;
    }
    int vi = sema_variant_index(ed, v);
    if (vi < 0 || vi >= List_len<List<string>>(&ed.payloads)) {
        return;
    }
    if (List_len<string>(targs) != List_len<TypeParam>(&ed.type_params)) {
        return;
    }
    List<string> pl = List_get<List<string>>(&ed.payloads, vi);
    List<string> names;
    List_init<string>(&names, 2);
    int k = 0;
    while (k < List_len<TypeParam>(&ed.type_params)) {
        List_push<string>(&names, List_get<TypeParam>(&ed.type_params, k).name);
        k = k + 1;
    }
    int i = 0;
    while (i < List_len<string>(&pl) && i < List_len<*ExprNode>(&e.kids)) {
        sema_infer_variant_r(s, List_get<*ExprNode>(&e.kids, i), sema_subst_names(List_get<string>(&pl, i), &names, targs), 1);
        i = i + 1;
    }
}

// A struct literal's generic-variant field values take the field's instance (`S{ o:
// Some(3) }`); the declared field types of a non-generic struct are the same in every
// instance.
void sema_infer_struct_fields(Sema* s, *ExprNode e) {
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(e.sval, &targs);
    if (List_len<string>(&targs) > 0) {
        return;
    }
    *DeclNode d = sema_find_struct(s, sema_base_name(e.sval));
    if (d == null || List_len<TypeParam>(&d.type_params) > 0) {
        return;
    }
    int nf = List_len<Param>(&d.params);
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        string nm = "";
        if (i < List_len<string>(&e.names)) {
            nm = List_get<string>(&e.names, i);
        }
        string ft = "";
        if (nm[0] != 0) {
            int fi = 0;
            while (fi < nf) {
                if (sema_streq(List_get<Param>(&d.params, fi).name, nm) == 1) {
                    ft = List_get<Param>(&d.params, fi).ty;
                }
                fi = fi + 1;
            }
        } else if (i < nf) {
            ft = List_get<Param>(&d.params, i).ty;
        }
        if (ft[0] != 0) {
            sema_infer_variant_r(s, List_get<*ExprNode>(&e.kids, i), ft, 1);
        }
        i = i + 1;
    }
}

// A `?:` whose value goes to an interface (a declaration, assignment, return or argument):
// each arm boxes into the interface on its own, so the arms may point at different
// conforming structs (mirrors the C++ ifaceTargetHint).
void sema_hint_iface(Sema* s, *ExprNode x, string t) {
    if (x == null || x.kind != EK_TERNARY || t == null || t[0] == 0) {
        return;
    }
    if (sema_find_iface(s, sema_strip_const(sema_strip_nullable(sema_canon(s, t)))) == null) {
        return;
    }
    List_push<*ExprNode>(&s.tern_ifn, x);
    List_push<string>(&s.tern_ift, t);
}

string sema_hint_of(Sema* s, *ExprNode x) {
    int i = List_len<*ExprNode>(&s.tern_ifn) - 1;
    while (i >= 0) {
        if (List_get<*ExprNode>(&s.tern_ifn, i) == x) {
            return List_get<string>(&s.tern_ift, i);
        }
        i = i - 1;
    }
    return "";
}

// Does `e` (a binary, unary or subscript node) resolve to a user operator overload? Then
// evaluating it is a call (mirrors the C++ operatorCallNodes).
*DeclNode sema_op_decl(Sema* s, *ExprNode e);

int sema_is_op_call(Sema* s, *ExprNode e) {
    if (sema_op_decl(s, e) != null) {
        return 1;
    }
    return 0;
}

// The `operator` declaration `e` calls (null for a built-in operation).
*DeclNode sema_op_decl(Sema* s, *ExprNode e) {
    if (s.has_ops == 0 || e == null || e.a == null) {
        return null;
    }
    string op = "";
    if (e.kind == EK_BINARY && e.b != null) {
        op = e.sval;
        if (sema_streq(op, "&&") == 1 || sema_streq(op, "||") == 1 || sema_streq(op, "=") == 1) {
            return null;
        }
        int n = 0;
        while (op[n] != 0) {
            n = n + 1;
        }
        if (n >= 2 && (int)op[n - 1] == 61 && sema_is_cmp_op(op) == 0) {   // `a += b`
            op = sema_sub_str(op, 0, n - 1);
        }
    } else if (e.kind == EK_UNARY && (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "!") == 1 || sema_streq(e.sval, "~") == 1)) {
        op = e.sval;
        if (sema_streq(op, "-") == 1) {
            op = "u-";
        }
    } else if (e.kind == EK_INDEX && e.b != null && List_len<*ExprNode>(&e.kids) == 0) {
        op = "[]";
    } else {
        return null;
    }
    List<string> tys;
    List_init<string>(&tys, 2);
    List_push<string>(&tys, sema_infer_type(s, e.a));
    if (e.kind != EK_UNARY) {
        List_push<string>(&tys, sema_infer_type(s, e.b));
    }
    *DeclNode d = sema_find_op(s, op, &tys);
    List_free<string>(&tys);
    return d;
}

// May `name` be narrowed? Not when its address is taken (a write through the pointer can
// store null behind the check); for a global, anywhere in the program.
int sema_narrowable(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) {
        return 1;
    }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.addr_taken == 1) {
        return 0;
    }
    if (sy.depth == 0 && StrTab_has(&s.gaddr_set, name) == 1) {
        return 0;
    }
    return 1;
}

void sema_cond_narrow_leaf(Sema* s, *ExprNode c, int when_true, List<string>* out);
// Keys of the `?*T` variables proven non-null when `c` evaluates to `when_true`
// (`p != null`, `p == null` false, `p`, `!c`, `a && b` true, `a || b` false).
void sema_cond_narrow(Sema* s, *ExprNode c, int when_true, List<string>* out) {
    // The left spine of a run of `&&` (or `||`) is followed with a loop; its right
    // operands are scanned afterwards, bottom-up, so the keys keep their source order.
    List<*ExprNode> rights;
    List_init<*ExprNode>(&rights, 4);
    List<int> senses;
    List_init<int>(&senses, 4);
    *ExprNode whole = c;
    while (c != null) {
        if (c.kind == EK_UNARY && sema_streq(c.sval, "!") == 1) {
            if (when_true == 1) {
                when_true = 0;
            } else {
                when_true = 1;
            }
            c = c.a;
            continue;
        }
        if (c.kind == EK_BINARY
            && ((sema_streq(c.sval, "&&") == 1 && when_true == 1) || (sema_streq(c.sval, "||") == 1 && when_true == 0))) {
            List_push<*ExprNode>(&rights, c.b);
            List_push<int>(&senses, when_true);
            c = c.a;
            continue;
        }
        break;
    }
    // A call may assign any global: a global proven non-null by an earlier operand is
    // not proven after this one runs.
    if (sema_has_call(s, c) == 1) {
        sema_drop_global_keys(out);
    }
    sema_cond_narrow_leaf(s, c, when_true, out);
    int i = List_len<*ExprNode>(&rights) - 1;
    while (i >= 0) {
        sema_cond_narrow(s, List_get<*ExprNode>(&rights, i), List_get<int>(&senses, i), out);
        i = i - 1;
    }
    List_free<*ExprNode>(&rights);
    List_free<int>(&senses);
    // A variable the condition itself assigns, steps, or takes the address of is not
    // proven by an earlier test in it (mirrors the C++ condNarrowings).
    if (List_len<string>(out) > 0) {
        List<string> asg;
        List_init<string>(&asg, 2);
        sema_assigned_names(whole, &asg);
        int k = List_len<string>(out) - 1;
        while (k >= 0 && List_len<string>(&asg) > 0) {
            string key = List_get<string>(out, k);
            int at = 0;   // '@'
            while (key[at] != 0 && (int)key[at] != 64) {
                at = at + 1;
            }
            if (sema_in_list(&asg, sema_sub_str(key, 0, at)) == 1) {
                List_remove<string>(out, k);
            }
            k = k - 1;
        }
    }
}

// Names of the variables `e` assigns, increments/decrements, or takes the address of (not
// inside a lambda body, whose captures are copies). Kind-aware, like sema_drop_assigned_e.
void sema_assigned_names(*ExprNode e, List<string>* out) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        List_push<string>(out, e.a.sval);
    }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        List_push<string>(out, e.a.sval);
    }
    if (e.kind == EK_INCDEC && e.a != null && e.a.kind == EK_IDENT) {
        List_push<string>(out, e.a.sval);
    }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        sema_assigned_names(e.a, out);
        sema_assigned_names(e.b, out);
    }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST || e.kind == EK_QUESTION
             || e.kind == EK_AWAIT || e.kind == EK_CALL || e.kind == EK_INCDEC) {
        sema_assigned_names(e.a, out);
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            sema_assigned_names(List_get<*ExprNode>(&e.kids, i), out);
            i = i + 1;
        }
    }
}

// sema_cond_narrow for an operand that is not itself `!`, or a `&&`/`||` run.
void sema_cond_narrow_leaf(Sema* s, *ExprNode c, int when_true, List<string>* out) {
    if (c == null) {
        return;
    }
    if (c.kind == EK_BINARY) {
        if (sema_streq(c.sval, "!=") == 1 || sema_streq(c.sval, "==") == 1) {
            *ExprNode idE = null;
            if (c.a != null && c.a.kind == EK_IDENT && c.b != null && c.b.kind == EK_LITERAL && c.b.lit_kind == LIT_NULL) {
                idE = c.a;
            }
            else if (c.b != null && c.b.kind == EK_IDENT && c.a != null && c.a.kind == EK_LITERAL && c.a.lit_kind == LIT_NULL) {
                idE = c.b;
            }
            if (idE != null && sema_lookup_type(s, idE.sval)[0] == 63 && sema_streq(c.sval, "!=") == when_true
                && sema_narrowable(s, idE.sval) == 1) {
                List_push<string>(out, sema_nkey(s, idE.sval));
            }
        }
        return;
    }
    if (when_true == 1 && c.kind == EK_IDENT && sema_lookup_type(s, c.sval)[0] == 63 && sema_narrowable(s, c.sval) == 1) {
        List_push<string>(out, sema_nkey(s, c.sval));   // `if (p)`
    }
}

// Insert `keys` into the narrowed set; the newly inserted ones go to `ins` (to undo).
void sema_narrow_apply(Sema* s, List<string>* keys, List<string>* ins) {
    int i = 0;
    int n = List_len<string>(keys);
    while (i < n) {
        string k = List_get<string>(keys, i);
        if (k[0] != 0 && sema_in_list(&s.narrowed, k) == 0) {
            List_push<string>(&s.narrowed, k);
            List_push<string>(ins, k);
            sema_bump(s);
        }
        i = i + 1;
    }
}

void sema_narrow_undo(Sema* s, List<string>* ins) {
    int i = 0;
    int n = List_len<string>(ins);
    while (i < n) {
        sema_narrow_drop(s, List_get<string>(ins, i));
        i = i + 1;
    }
}

// Forget narrowing of every variable assigned (or address-taken) in `e` / `st`, before a
// loop whose later iterations observe the assignment. Kind-aware walk (see uninit scan).
void sema_drop_assigned_e(Sema* s, *ExprNode e) {
    if (e == null || List_len<string>(&s.narrowed) == 0) {
        return;
    }
    if (e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        sema_narrow_kill(s, e.a.sval);
    }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        sema_narrow_kill(s, e.a.sval);
    }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        sema_drop_assigned_e(s, e.a);
        sema_drop_assigned_e(s, e.b);
    }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST || e.kind == EK_QUESTION
             || e.kind == EK_AWAIT || e.kind == EK_CALL || e.kind == EK_INCDEC) {
        sema_drop_assigned_e(s, e.a);
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            sema_drop_assigned_e(s, List_get<*ExprNode>(&e.kids, i));
            i = i + 1;
        }
    }
    if (e.kind == EK_LAMBDA) {
        sema_drop_assigned(s, e.stmt);
    }
}

void sema_drop_assigned(Sema* s, *StmtNode st) {
    if (st == null || List_len<string>(&s.narrowed) == 0) {
        return;
    }
    sema_drop_assigned_e(s, st.expr);
    sema_drop_assigned_e(s, st.expr2);
    sema_drop_assigned(s, st.s1);
    sema_drop_assigned(s, st.s2);
    int i = 0;
    int n = List_len<*StmtNode>(&st.items);
    while (i < n) {
        sema_drop_assigned(s, List_get<*StmtNode>(&st.items, i));
        i = i + 1;
    }
}

// A `?*T` (checked nullable pointer) may not be dereferenced / indexed / member-accessed
// without a null-check. Mirrors the C++ `checkNullableDeref`: the `?` prefix marks the type
// nullable; a narrowed ident is exempt in its guarded branch.
void sema_check_nullable_deref(Sema* s, *ExprNode operand, string how) {
    if (operand == null) {
        return;
    }
    string t = sema_infer_type(s, operand);
    if (t[0] != 63) {                        // not (or no longer) a `?…` nullable pointer
        return;
    }
    s.had_error = 1;
    int ol = s.line;                   // at the pointer (as the C++ checker)
    int oc = s.col;
    if (operand.line > 0) {
        ol = operand.line;
        oc = operand.col;
    }
    dprintf(2, "error: %s:%d:%d: cannot %s a possibly-null pointer of type '%s'; check it first (e.g. `if (x != null)`)\n",
           s.filename, ol, oc, how, t);
}

// `s.len` of a slice: a read-only view of the fat pointer's length.
int sema_is_slice_len(Sema* s, *ExprNode e) {
    if (e == null || e.kind != EK_MEMBER || sema_streq(e.sval, "len") == 0) {
        return 0;
    }
    string bt = sema_strip_nullable(sema_strip_const(sema_infer_type(s, e.a)));
    int n = 0;
    while (bt[n] != 0) {
        n = n + 1;
    }
    if (n >= 2 && (int)bt[n - 2] == 91 && (int)bt[n - 1] == 93) {   // "...[]"
        return 1;
    }
    return 0;
}

// An expression that denotes storage (a variable, field, element, or `*p`): it may be
// assigned to or have its address taken. Mirrors the C++ isLvalueExpr.
int sema_stored_base(Sema* s, *ExprNode base);
int sema_is_lvalue(Sema* s, *ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_IDENT) {
        if (sema_local_bound(s, e.sval) == 1) {
            return 1;
        }
        if (sema_find_fn(s, e.sval) >= 0) {
            return 0;
        }
        return 1;
    }
    if (e.kind == EK_UNARY) {
        return sema_streq(e.sval, "*");
    }
    if (e.kind == EK_MEMBER) {
        if (sema_is_slice_len(s, e) == 1) {
            return 0;
        }
        return sema_stored_base(s, e.a);
    }
    if (e.kind == EK_INDEX) {
        if (List_len<*ExprNode>(&e.kids) > 0) {
            return 0;
        }
        // `v[i]` on a struct value calls its `operator []`, which returns a value.
        string bc = sema_canon(s, sema_infer_type(s, e.a));
        if (sema_judgeable(s, bc) == 1 && sema_is_struct(s, sema_base_name(bc)) == 1 && sema_arr_bracket(bc) < 0) {
            return 0;
        }
        return sema_stored_base(s, e.a);
    }
    return 0;
}

// A field or an array element is storage only when its struct or array is: through a
// pointer (or a slice), or itself stored (`mk().x` and `arr()[0]` are temporaries).
// Mirrors the C++ isLvalueExpr.
int sema_stored_base(Sema* s, *ExprNode base) {
    string bc = sema_canon(s, sema_strip_nullable(sema_infer_type(s, base)));
    int n = sema_slen(bc);
    if (n == 0) {
        return 1;
    }
    if ((int)bc[n - 1] == 93 && !(n >= 2 && (int)bc[n - 2] == 91)) {   // T[N]
        return sema_is_lvalue(s, base);
    }
    if ((int)bc[0] == 42 || (int)bc[n - 1] == 42) {                                        // pointer
        return 1;
    }
    if ((int)bc[n - 1] == 93) {                                                             // slice
        return 1;
    }
    if (sema_is_struct(s, sema_base_name(bc)) == 1) {
        return sema_is_lvalue(s, base);
    }
    return 1;
}

// Parse an integer spelling (optional '-', decimal, 0x hex, leading-0 octal) as int64.
int64 sema_parse_int(string t) {
    int i = 0;
    int64 base = 10;
    int64 sign = (int64)1;
    if (t[0] == '-') {
        sign = (int64)-1;
        i = 1;
    }
    if (t[i] == '0' && (t[i + 1] == 'x' || t[i + 1] == 'X')) {
        base = 16;
        i = i + 2;
    }
    else if (t[i] == '0' && t[i + 1] != 0) {
        base = 8;
        i = i + 1;
    }
    int64 v = 0;
    while (t[i] != 0) {
        int ch = (int)t[i];
        int64 d = 0;
        if (ch >= 48 && ch <= 57) {
            d = (int64)(ch - 48);
        }
        else if (ch >= 97 && ch <= 102) {
            d = (int64)(ch - 87);
        }
        else if (ch >= 65 && ch <= 70) {
            d = (int64)(ch - 55);
        }
        else {
            return sign * v;
        }
        v = v * base + d;
        i = i + 1;
    }
    return sign * v;
}

// Value of an integer constant expression built from literals, enum members, unary and
// binary operators and casts (mirrors TypeChecker::foldConstInt). Returns 0 when the
// value is not known here (`sizeof`, a non-constant name, division by zero).
// `v` converted to the integer type `t` (C: truncate, then sign- or zero-extend); a
// non-integer or 64-bit type leaves it unchanged.
int64 sema_trunc_const(string t, int64 v) {
    if (sema_streq(t, "bool") == 1) {
        if (v != (int64)0) {
            return (int64)1;
        }
        return (int64)0;
    }
    if (sema_streq(t, "char") == 1 || sema_streq(t, "uint8") == 1) {
        return (int64)(uint8)v;
    }
    if (sema_streq(t, "int8") == 1) {
        return (int64)(int8)v;
    }
    if (sema_streq(t, "uint16") == 1) {
        return (int64)(uint16)v;
    }
    if (sema_streq(t, "int16") == 1) {
        return (int64)(int16)v;
    }
    if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) {
        return (int64)(uint32)v;
    }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1) {
        return (int64)(int32)v;
    }
    return v;
}

int sema_fold_ci(Sema* s, *ExprNode e, AstCInt* out);
int sema_fold_num_ci(Sema* s, *ExprNode e, int* is_int, AstCInt* iv, double* dv);

int sema_fold_int(Sema* s, *ExprNode e, int64* out) {
    AstCInt c = ast_ci_make((int64)0, 32, 0);
    if (sema_fold_ci(s, e, &c) == 0) {
        return 0;
    }
    out[0] = c.v;
    return 1;
}

// An integer literal spelling (an optional '-') with its type. A negative literal
// (`-2147483648`) is one token, typed by its value as the program sees it at run time:
// `int` when the value fits, else `int64` (mirrors the C++ foldConstIntT).
AstCInt sema_lit_ci(string t) {
    if (t[0] == '-') {
        return ast_ci_neg_lit(sema_parse_int(sema_sub_str(t, 1, sema_slen(t))));
    }
    return ast_ci_lit(sema_parse_int(t));
}

// The typed fold behind sema_fold_int (mirrors TypeChecker::foldConstIntT): the value
// keeps its C type, so the operators follow C's usual arithmetic conversions.
int sema_fold_ci(Sema* s, *ExprNode e, AstCInt* out) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {
            out[0] = sema_lit_ci(e.sval);
            return 1;
        }
        if (e.lit_kind == LIT_CHAR) {
            out[0] = ast_ci_make((int64)(uint8)e.sval[0], 32, 0);
            return 1;
        }
        if (e.lit_kind == LIT_BOOL) {
            out[0] = ast_ci_bool(sema_streq(e.sval, "true"));
            return 1;
        }
        return 0;
    }
    if (e.kind == EK_IDENT) {
        int si = sema_sym_index(s, e.sval);
        // An enum member is registered as an untyped global; it folds to its value below.
        if (si >= 0 && List_get<Sym>(&s.syms, si).depth == 0 && List_get<Sym>(&s.syms, si).type[0] == 0) {
            si = -1;
        }
        if (si >= 0) {
            // A `const` integer folds through its initializer (bounded against a
            // self-referential const).
            Sym sy = List_get<Sym>(&s.syms, si);
            if (sy.is_const == 0 && sy.depth == 0 && sy.type[0] == 0) {   // an enum member
                si = -1;
            }
        }
        if (si >= 0) {
            Sym sy = List_get<Sym>(&s.syms, si);
            if (sy.is_const == 0 || sy.init == null || sema_is_int_ty(sy.type) == 0) {
                return 0;
            }
            if (s.fold_depth > 64) {
                return 0;
            }
            s.fold_depth = s.fold_depth + 1;
            AstCInt v = ast_ci_make((int64)0, 32, 0);
            int ok = sema_fold_ci(s, sy.init, &v);
            s.fold_depth = s.fold_depth - 1;
            if (ok == 0) {
                return 0;
            }
            if (ast_ci_cast(sema_strip_const(sema_resolve_scalar(s, sy.type)), v, out) == 0) {
                out[0] = v;
            }
            return 1;
        }
        int i = NameIdx_first(&s.evars_ix, e.sval);
        while (i >= 0) {
            EVar ev = List_get<EVar>(&s.evars, i);
            if (ev.plain == 1) {
                out[0] = ast_ci_of(sema_parse_int(ev.val));
                return 1;
            }
            i = NameIdx_next(&s.evars_ix, i);
        }
        return 0;
    }
    if (e.kind == EK_UNARY) {
        AstCInt v = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, e.a, &v) == 0) {
            return 0;
        }
        return ast_ci_unary(e.sval, v, out);
    }
    if (e.kind == EK_BINARY) {
        // A left-leaning chain (`A + B + C ...`) is folded along its spine with a loop.
        List<*ExprNode> spine;
        List_init<*ExprNode>(&spine, 4);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY) {
            List_push<*ExprNode>(&spine, b);
            b = b.a;
        }
        AstCInt x = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, b, &x) == 0) {
            return 0;
        }
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            AstCInt y = ast_ci_make((int64)0, 32, 0);
            int land = sema_streq(n.sval, "&&");
            int lor = sema_streq(n.sval, "||");
            if (land == 1 || lor == 1) {
                // `&&` / `||` short-circuit: an unevaluated right operand need not fold.
                if ((land == 1 && x.v == (int64)0) || (lor == 1 && x.v != (int64)0)) {
                    x = ast_ci_bool(lor);
                }
                else {
                    if (sema_fold_ci(s, n.b, &y) == 0) {
                        return 0;
                    }
                    x = ast_ci_bool((int)(y.v != (int64)0));
                }
                i = i - 1;
                continue;
            }
            if (sema_fold_ci(s, n.b, &y) == 0) {
                return 0;
            }
            if (ast_ci_binary(n.sval, x, y, &x) == 0) {
                return 0;
            }
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        out[0] = x;
        return 1;
    }
    if (e.kind == EK_TERNARY) {
        AstCInt c = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, e.a, &c) == 0) {
            return 0;
        }
        *ExprNode taken = List_get<*ExprNode>(&e.kids, 0);
        *ExprNode other = e.b;
        if (c.v != (int64)0) {
            taken = e.b;
            other = List_get<*ExprNode>(&e.kids, 0);
        }
        AstCInt a = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, taken, &a) == 0) {
            return 0;
        }
        out[0] = a;
        // The arms meet at their common type (when the other one folds too).
        AstCInt o = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, other, &o) == 1) {
            int r = a.rank;
            if (o.rank > r) {
                r = o.rank;
            }
            int u = 0;
            if (a.rank == o.rank) {
                if (a.uns == 1 || o.uns == 1) {
                    u = 1;
                }
            }
            else if (a.rank > o.rank) {
                u = a.uns;
            } else {
                u = o.uns;
            }
            out[0] = ast_ci_make(a.v, r, u);
        }
        return 1;
    }
    if (e.kind == EK_CAST) {
        string to = sema_strip_const(sema_resolve_scalar(s, sema_isub(s, e.sval)));
        int is_int = 1;
        AstCInt iv = ast_ci_make((int64)0, 32, 0);
        double dv = 0.0;
        if (sema_fold_num_ci(s, e.a, &is_int, &iv, &dv) == 0) {
            return 0;
        }
        if (is_int == 0) {
            // A floating value converts toward zero; out of range it has no value (C).
            if (sema_is_int_ty(to) == 0) {
                return 0;
            }
            int64 fv = (int64)0;
            if (sema_streq(to, "bool") == 1) {
                if (dv != 0.0) {
                    fv = (int64)1;
                }
            }
            else {
                if (sema_float_fits_int(dv, to) == 0) {
                    return 0;
                }
                if (dv >= 9223372036854775808.0) {
                    fv = (int64)(uint64)dv;
                } else {
                    fv = (int64)dv;
                }
            }
            iv = ast_ci_make(fv, 64, sema_streq(to, "uint64"));
        }
        if (ast_ci_cast(to, iv, out) == 0) {
            out[0] = iv;
        }
        return 1;
    }
    if (e.kind == EK_SIZEOF) {
        // A type whose target layout is known here (scalars, pointers, arrays, structs and
        // unions of those) folds; the rest is left to codegen (mirrors the C++). A size is
        // unsigned 64-bit (C's size_t).
        if (s.in_inst == 1) {
            return 0;
        }
        string zt = e.sval;
        if (e.a != null) {
            zt = sema_infer_type(s, e.a);
        }
        else if (sema_known_type(s, zt) == 0 && sema_lookup(s, zt) == 1) {
            zt = sema_lookup_type(s, zt);
        }
        if (zt == null || zt[0] == 0) {
            return 0;
        }
        int64 sz = sema_const_sizeof(s, zt);
        if (sz == (int64)0) {
            return 0;
        }
        out[0] = ast_ci_make(sz, 64, 1);
        return 1;
    }
    return 0;
}

double sema_fold_to_float(string t, double v) {
    if (sema_streq(t, "float") == 1) {
        return (double)(float)v;
    }
    return v;
}

double sema_ci_double(AstCInt c) {
    if (c.uns == 1) {
        return (double)(uint64)c.v;
    }
    return (double)c.v;
}

// Fold an arithmetic constant expression that may involve floating values (C rules:
// integer operands stay integer; mirrors TypeChecker::foldConstNum). is_int says which
// of iv / dv holds the value.
int sema_fold_num(Sema* s, *ExprNode e, int* is_int, int64* iv, double* dv) {
    AstCInt c = ast_ci_make((int64)0, 32, 0);
    if (sema_fold_num_ci(s, e, is_int, &c, dv) == 0) {
        return 0;
    }
    iv[0] = c.v;
    return 1;
}

int sema_fold_num_ci(Sema* s, *ExprNode e, int* is_int, AstCInt* iv, double* dv) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_LITERAL && e.lit_kind == LIT_FLOAT) {
        is_int[0] = 0;
        dv[0] = strtod(e.sval, null);
        return 1;
    }
    if (e.kind == EK_IDENT) {
        int si = sema_sym_index(s, e.sval);
        if (si >= 0) {
            Sym sy = List_get<Sym>(&s.syms, si);
            string t = sema_strip_const(sema_resolve_scalar(s, sy.type));
            if (sy.is_const == 1 && sy.init != null && (sema_streq(t, "float") == 1 || sema_streq(t, "double") == 1)) {
                if (s.fold_depth > 64) {
                    return 0;
                }
                s.fold_depth = s.fold_depth + 1;
                int ok = sema_fold_num_ci(s, sy.init, is_int, iv, dv);
                s.fold_depth = s.fold_depth - 1;
                if (ok == 0) {
                    return 0;
                }
                if (is_int[0] == 1) {
                    dv[0] = sema_ci_double(iv[0]);
                }
                is_int[0] = 0;
                dv[0] = sema_fold_to_float(t, dv[0]);
                return 1;
            }
        }
    }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "-") == 1) {
        if (sema_fold_num_ci(s, e.a, is_int, iv, dv) == 0) {
            return 0;
        }
        if (is_int[0] == 1) {
            AstCInt t = iv[0];
            ast_ci_unary("-", t, iv);
        } else {
            dv[0] = 0.0 - dv[0];
        }
        return 1;
    }
    if (e.kind == EK_BINARY) {
        List<*ExprNode> spine;
        List_init<*ExprNode>(&spine, 4);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY) {
            List_push<*ExprNode>(&spine, b);
            b = b.a;
        }
        int ok = sema_fold_num_ci(s, b, is_int, iv, dv);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (ok == 1 && i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            int y_int = 1;
            AstCInt yi = ast_ci_make((int64)0, 32, 0);
            double yd = 0.0;
            if (sema_fold_num_ci(s, n.b, &y_int, &yi, &yd) == 0) {
                ok = 0;
            }
            else if (is_int[0] == 1 && y_int == 1) {
                AstCInt x0 = iv[0];
                if (ast_ci_binary(n.sval, x0, yi, iv) == 0) {
                    ok = 0;
                }
            } else {
                double x = dv[0];
                if (is_int[0] == 1) {
                    x = sema_ci_double(iv[0]);
                }
                double y = yd;
                if (y_int == 1) {
                    y = sema_ci_double(yi);
                }
                if (sema_streq(n.sval, "+") == 1) {
                    dv[0] = x + y;
                }
                else if (sema_streq(n.sval, "-") == 1) {
                    dv[0] = x - y;
                }
                else if (sema_streq(n.sval, "*") == 1) {
                    dv[0] = x * y;
                }
                else if (sema_streq(n.sval, "/") == 1) {
                    dv[0] = x / y;
                }
                else {
                    ok = 0;
                }
                is_int[0] = 0;
            }
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        return ok;
    }
    if (e.kind == EK_CAST) {
        string to = sema_strip_const(sema_resolve_scalar(s, sema_isub(s, e.sval)));
        if (sema_streq(to, "float") == 1 || sema_streq(to, "double") == 1) {
            if (sema_fold_num_ci(s, e.a, is_int, iv, dv) == 0) {
                return 0;
            }
            if (is_int[0] == 1) {
                dv[0] = sema_ci_double(iv[0]);
            }
            is_int[0] = 0;
            dv[0] = sema_fold_to_float(to, dv[0]);
            return 1;
        }
    }
    is_int[0] = 1;
    return sema_fold_ci(s, e, iv);
}

// A switch `case` label codegen can fold to an integer constant.
int sema_is_const_int(Sema* s, *ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT || e.lit_kind == LIT_CHAR || e.lit_kind == LIT_BOOL) {
            return 1;
        }
        return 0;
    }
    if (e.kind == EK_IDENT) {
        if (sema_local_bound(s, e.sval) == 0 && sema_is_enum_member(s, e.sval) == 1) {
            return 1;
        }
        // `const int K = 7` folds too
        int ci = sema_sym_index(s, e.sval);   // (a const parameter has no initializer to fold)
        if (sema_sym_const(s, e.sval) == 1 && ci >= 0 && List_get<Sym>(&s.syms, ci).init != null
            && sema_is_int_ty(sema_lookup_type(s, e.sval)) == 1) {
            return 1;
        }
        return 0;
    }
    if (e.kind == EK_UNARY) {
        if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "~") == 1 || sema_streq(e.sval, "!") == 1) {
            return sema_is_const_int(s, e.a);
        }
        return 0;
    }
    if (e.kind == EK_BINARY) {
        if (sema_streq(e.sval, "=") == 1 || sema_streq(e.sval, "&&") == 1 || sema_streq(e.sval, "||") == 1) {
            return 0;
        }
        if (sema_is_const_int(s, e.a) == 1 && sema_is_const_int(s, e.b) == 1) {
            return 1;
        }
        return 0;
    }
    if (e.kind == EK_CAST) {
        return sema_is_const_int(s, e.a);
    }
    if (e.kind == EK_SIZEOF) {
        return 1;
    }
    return 0;
}

// Coarse class of a type spelling for cast checking: 1 number (incl. enum), 2 pointer,
// 3 aggregate (struct/union value, array), 0 unknown (alias etc.: not judged).
int sema_cast_class(Sema* s, string t0) {
    string t = sema_strip_nullable(sema_strip_const(t0));
    if (t[0] == 0) {
        return 0;
    }
    if (sema_is_numeric_ty(t) == 1 || sema_is_enum(s, t) == 1) {
        *DeclNode ed = sema_find_tdecl(s, t);
        if (ed != null && ed.kind == DK_ENUM && sema_is_aggregate(s, t) == 1) {   // a sum type
            return 3;
        }
        return 1;
    }
    if (sema_is_fn_type(t) == 1) {
        return 3;
    }
    if (sema_is_ptrish(t) == 1) {
        return 2;
    }
    if (sema_is_arr_ty(t) == 1) {
        return 3;
    }
    *DeclNode d = sema_find_tdecl(s, sema_base_name(t));
    if (d != null && (d.kind == DK_STRUCT || d.kind == DK_UNION)) {
        return 3;
    }
    if (sema_find_iface(s, t) != null) {   // an interface value {data, vtable}
        return 3;
    }
    return 0;
}

// Is any `operator []` overload declared?
int sema_any_index_op(Sema* s) {
    int i = 0;
    int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.operator_sym != null && sema_streq(d.operator_sym, "[]") == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
