// async_lower.esk — the async/await lowering pass (a port of sema/async_transform.cpp),
// run on the parsed Program between parse and codegen. Each `async T name()` function is
// rewritten into three ordinary decls:
//
//   struct __name_frame { Future<T> ret; int st; *FutureHdr awaiting; <params>; <locals>;
//                         *Future<Ti> __awI; }          // ret FIRST: &fr.ret == fr
//   void __name_resume(*__name_frame fr) { while (1) { if (fr.st==0){…} else if … } }
//   *Future<T> name(params) { fr = alloc; init; fr.st=0; __name_resume(fr); return &fr.ret; }
//
// A state machine: each `await` splits a state — evaluate the future, `Future_poll` it,
// suspend (return) if pending, and resume in the next state reading `fr.__awI.value`. The
// waker is a closure `void(){ fr.st=<next>; __name_resume(fr); }` capturing the frame.
//
// Covers the full structure: sequential bodies, control flow around an await
// (if/while/do/for/for-in/switch/match/try-catch with break/continue, lowered into the
// state graph), a desugar pass that hoists every await, in evaluation order, into a let
// of its own (from any expression position), and the constructor's waker + on_drop
// (cancellation: it runs the defers and finally blocks pending at the parked await)
// closures. for-in desugars to a counted for (array `T[N]` or a list-like struct with
// `data`/`size`).

import "ast.esk";
import "parser.esk";   // mk_ident/mk_lit/mk_bin/mk_cast, str_concat/str_eq/int_to_str, new_decl

// ── AST builders ─────────────────────────────────────────────────────────────
*ExprNode al_member(*ExprNode base, string field) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_MEMBER;
    e.a = base;
    e.sval = field;
    return e;
}

// Names the lowering synthesizes for the async function being lowered: the frame pointer
// and the frame's bookkeeping fields. al_transform picks each outside every name spelled
// in the function (mirrors the C++ FrameNames), so a user local, parameter, or field named
// `__fr` / `st` / `ret` / `awaiting` cannot collide with them.
string al_frp = "__fr";
string al_fst = "st";
string al_fret = "ret";
string al_fawt = "awaiting";
// The frame fields of the function being lowered (name + declared type), so a
// `sizeof(local)` can be rewritten to the local's type once the local is a frame field.
List<Param>* al_cur_fields = null;
*ExprNode al_fr(string field) {
    return al_member(mk_ident(al_frp), field);
}

// The lowered function's type-parameter list spelled `<T, U>` ("" when it is not generic):
// a generic async function lowers to a generic frame, resume function, and constructor.
string al_tps = "";

*ExprNode al_call(string name, List<*ExprNode>* args) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_CALL;
    e.a = mk_ident(name);
    List_init<*ExprNode>(&e.kids, 4);
    int i = 0;
    while (i < List_len<*ExprNode>(args)) {
        List_push<*ExprNode>(&e.kids, List_get<*ExprNode>(args, i));
        i = i + 1;
    }
    return e;
}

*ExprNode al_tcall(string spelling, List<*ExprNode>* args) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_TEMPLATECALL;
    e.sval = spelling;
    List_init<*ExprNode>(&e.kids, 4);
    int i = 0;
    while (i < List_len<*ExprNode>(args)) {
        List_push<*ExprNode>(&e.kids, List_get<*ExprNode>(args, i));
        i = i + 1;
    }
    return e;
}

*ExprNode al_int(int n) {
    return mk_lit(LIT_INT, int_to_str(n));
}

*StmtNode al_exprstmt(*ExprNode e) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_EXPR;
    s.expr = e;
    return s;
}

*StmtNode al_assign(*ExprNode lhs, *ExprNode rhs) {
    return al_exprstmt(mk_bin("=", lhs, rhs));
}

*StmtNode al_return(*ExprNode v) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_RETURN;
    s.expr = v;
    return s;
}

*StmtNode al_block(List<*StmtNode>* items) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_BLOCK;
    List_init<*StmtNode>(&s.items, 4);
    int i = 0;
    while (i < List_len<*StmtNode>(items)) {
        List_push<*StmtNode>(&s.items, List_get<*StmtNode>(items, i));
        i = i + 1;
    }
    return s;
}

*StmtNode al_if(*ExprNode cond, *StmtNode then_s, *StmtNode else_s) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_IF;
    s.expr = cond;
    s.s1 = then_s;
    s.s2 = else_s;
    return s;
}

*StmtNode al_while(*ExprNode cond, *StmtNode body) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_WHILE;
    s.expr = cond;
    s.s1 = body;
    return s;
}

*StmtNode al_for(*StmtNode init, *ExprNode cond, *ExprNode step, *StmtNode body) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_FOR;
    s.s1 = init;
    s.expr = cond;
    s.expr2 = step;
    s.s2 = body;
    return s;
}

*StmtNode al_dowhile(*StmtNode body, *ExprNode cond) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_DOWHILE;
    s.s1 = body;
    s.expr = cond;
    return s;
}

*StmtNode al_defer(*StmtNode body, int is_err) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_DEFER;
    s.s1 = body;
    s.is_err = is_err;
    return s;
}

string al_substr(string s, int a, int b) {
    *uint8 buf = alloc<uint8>(b - a + 1);
    int k = 0;
    while (k < b - a) {
        buf[k] = (uint8)s[a + k];
        k = k + 1;
    }
    buf[b - a] = 0;
    return (string)buf;
}

*ExprNode al_index(*ExprNode base, *ExprNode idx) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_INDEX;
    e.a = base;
    e.b = idx;
    return e;
}

*StmtNode al_case(*ExprNode value, List<*StmtNode>* body) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_CASE;
    s.expr = value;
    List_init<*StmtNode>(&s.items, 4);
    int i = 0;
    while (i < List_len<*StmtNode>(body)) {
        List_push<*StmtNode>(&s.items, List_get<*StmtNode>(body, i));
        i = i + 1;
    }
    return s;
}

*StmtNode al_switch(*ExprNode subject, List<*StmtNode>* cases) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_SWITCH;
    s.expr = subject;
    List_init<*StmtNode>(&s.items, 4);
    int i = 0;
    while (i < List_len<*StmtNode>(cases)) {
        List_push<*StmtNode>(&s.items, List_get<*StmtNode>(cases, i));
        i = i + 1;
    }
    return s;
}

// `__name_resume(fr)`, or `__name_resume<T..>(fr)` for a generic async function.
*ExprNode al_resume_call(string resumeN) {
    List<*ExprNode> ra;
    List_init<*ExprNode>(&ra, 1);
    List_push<*ExprNode>(&ra, mk_ident(al_frp));
    if (al_tps[0] == 0) {
        return al_call(resumeN, &ra);
    }
    return al_tcall(str_concat(resumeN, al_tps), &ra);
}

// The waker closure `void() { fr.st = <state>; __name_resume(fr); }` (captures fr).
*ExprNode al_waker(string resumeN, int state) {
    List<*StmtNode> body;
    List_init<*StmtNode>(&body, 2);
    List_push<*StmtNode>(&body, al_assign(al_fr(al_fst), al_int(state)));
    List_push<*StmtNode>(&body, al_exprstmt(al_resume_call(resumeN)));
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_LAMBDA;
    e.sval = "void()";
    e.stmt = al_block(&body);
    return e;
}

// ── Frame-variable rewrite: a local/param reference `x` becomes `fr.x` ─────────
int al_in(List<string>* vars, string nm) {
    int i = 0;
    while (i < List_len<string>(vars)) {
        if (str_eq(List_get<string>(vars, i), nm) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// The direct child expressions of `e`, in the same order as the C++ astwalk::
// forEachChildExpr (the single child enumeration al_rewrite / al_expr_has_await share).
// A lambda is a scope boundary and is not descended.
void al_children(*ExprNode e, List<*ExprNode>* out) {
    if (e == null) {
        return;
    }
    int k = e.kind;
    if (k == EK_BINARY || k == EK_INDEX || k == EK_TERNARY || k == EK_ALLOCWITH) {
        List_push<*ExprNode>(out, e.a);
        List_push<*ExprNode>(out, e.b);
    } else if (k == EK_UNARY || k == EK_INCDEC || k == EK_MEMBER || k == EK_CAST || k == EK_QUESTION
               || k == EK_AWAIT || k == EK_CALL || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        List_push<*ExprNode>(out, e.a);
    }
    // kids: call args, template-call args, struct-literal field values, array-literal
    // elements, a slice's hi bound (EK_INDEX), a ternary's else arm (EK_TERNARY).
    if (k == EK_CALL || k == EK_TEMPLATECALL || k == EK_STRUCTINIT || k == EK_ARRAYLIT
        || k == EK_INDEX || k == EK_TERNARY) {
        int i = 0;
        while (i < List_len<*ExprNode>(&e.kids)) {
            List_push<*ExprNode>(out, List_get<*ExprNode>(&e.kids, i));
            i = i + 1;
        }
    }
}

void al_rewrite(*ExprNode e, List<string>* vars) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_IDENT) {
        if (al_in(vars, e.sval) == 1) {   // x -> fr.x
            e.kind = EK_MEMBER;
            e.a = mk_ident(al_frp);
        }
        return;
    }
    // `x += y` shares its target `x` with `x + y`; the C++ rewrite gives each frame-local
    // name a node of its own, so the two uses become two `fr.x` nodes.
    if (e.kind == EK_BINARY && e.b != null && e.b.kind == EK_BINARY && e.b.a == e.a && e.a != null
        && e.a.kind == EK_IDENT && al_in(vars, e.a.sval) == 1) {
        e.b.a = mk_ident(e.a.sval);
    }
    if (e.kind == EK_SIZEOF && e.a != null) {   // sizeof(expr)
        al_rewrite(e.a, vars);
        return;
    }
    if (e.kind == EK_SIZEOF) {                     // sizeof(x) of a frame local: x's declared type
        if (al_in(vars, e.sval) == 1 && al_cur_fields != null) {
            int fi = 0;
            while (fi < List_len<Param>(al_cur_fields)) {
                Param f = List_get<Param>(al_cur_fields, fi);
                if (str_eq(f.name, e.sval) == 1) {
                    e.sval = f.ty;
                    return;
                }
                fi = fi + 1;
            }
        }
        return;
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        al_rewrite(List_get<*ExprNode>(&ch, i), vars);
        i = i + 1;
    }
}

// ── Resolve the awaited inner type Ti: `await produce()` where produce returns
//    `Future<int>*` → Ti = "int". Looks the callee up in the program. ───────────
string al_inner_of_future(string ty) {        // "Future<int>*" / "*Future<int>" → "int"
    int i = 0;
    int n = 0;
    while (ty[n] != 0) {
        n = n + 1;
    }
    while (i < n && (int)ty[i] != 60) {   // to '<'
        i = i + 1;
    }
    if (i >= n) {
        return "int";
    }
    int start = i + 1;
    int depth = 1;
    i = start;
    while (i < n && depth > 0) {
        int c = (int)ty[i];
        if (c == 60) {
            depth = depth + 1;
        }
        else if (c == 62) {
            depth = depth - 1;
            if (depth == 0) {
                break;
            }
        }
        i = i + 1;
    }
    *uint8 buf = alloc<uint8>(i - start + 1);
    int k = 0;
    while (k < i - start) {
        buf[k] = (uint8)ty[start + k];
        k = k + 1;
    }
    buf[i - start] = 0;
    return (string)buf;
}

// `t` with each identifier run equal to a type parameter in `tps` replaced by the
// matching entry of `args` ("*List<T>" with T=int -> "*List<int>").
string al_subst(string t, List<TypeParam>* tps, List<string>* args) {
    if (List_len<TypeParam>(tps) == 0) {
        return t;
    }
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    string out = "";
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95) {
            int s0 = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            string id = al_substr(t, s0, i);
            int k = 0;
            int hit = 0 - 1;
            while (k < List_len<TypeParam>(tps) && k < List_len<string>(args)) {
                if (str_eq(List_get<TypeParam>(tps, k).name, id) == 1) {
                    hit = k;
                }
                k = k + 1;
            }
            if (hit >= 0) {
                out = str_concat(out, List_get<string>(args, hit));
            } else {
                out = str_concat(out, id);
            }
        } else {
            out = str_concat(out, al_substr(t, i, i + 1));
            i = i + 1;
        }
    }
    return out;
}

*DeclNode al_find_fn(*Program prog, string name) {
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && str_eq(d.name, name) == 1) {
            return d;
        }
        i = i + 1;
    }
    return null;
}

string al_var_type(*DeclNode curfn, string name);
*DeclNode al_find_struct(*Program prog, string name);
string al_deref(string t);
string al_call_rettype(*Program prog, *DeclNode curfn, *ExprNode e, int* is_async);

// The (source-form) type of expression `e` inside `curfn`, as far as this pass can tell
// without the type checker: literals, locals/params/globals, casts, `&`/`*`, fields, and
// calls. "" when unknown.
string al_expr_type(*Program prog, *DeclNode curfn, *ExprNode e) {
    if (e == null) {
        return "";
    }
    int k = e.kind;
    if (k == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {
            return "int";
        }
        if (e.lit_kind == LIT_FLOAT) {
            return "double";
        }
        if (e.lit_kind == LIT_STRING) {
            return "string";
        }
        if (e.lit_kind == LIT_CHAR) {
            return "char";
        }
        if (e.lit_kind == LIT_BOOL) {
            return "bool";
        }
        return "";
    }
    if (k == EK_IDENT) {
        string t = al_var_type(curfn, e.sval);
        if (t[0] != 0) {
            return t;
        }
        int i = 0;
        int n = List_len<*DeclNode>(&prog.decls);
        while (i < n) {
            *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
            if (d.kind == DK_VARDECL && str_eq(d.name, e.sval) == 1) {
                return d.ret_type;
            }
            i = i + 1;
        }
        return "";
    }
    if (k == EK_CAST) {
        return e.sval;
    }
    if (k == EK_AWAIT) {
        return al_await_type_or(prog, curfn, e.a);
    }
    if (k == EK_TERNARY) {
        string tt = al_expr_type(prog, curfn, e.b);
        if (tt[0] != 0) {
            return tt;
        }
        return al_expr_type(prog, curfn, List_get<*ExprNode>(&e.kids, 0));
    }
    if (k == EK_BINARY) {
        string op = e.sval;
        if (str_eq(op, "==") == 1 || str_eq(op, "!=") == 1 || str_eq(op, "<") == 1 || str_eq(op, ">") == 1
            || str_eq(op, "<=") == 1 || str_eq(op, ">=") == 1 || str_eq(op, "&&") == 1 || str_eq(op, "||") == 1) {
            return "bool";
        }
        string lt = al_expr_type(prog, curfn, e.a);
        if (lt[0] != 0) {
            return lt;
        }
        return al_expr_type(prog, curfn, e.b);
    }
    if (k == EK_UNARY && str_eq(e.sval, "&") == 1) {
        string t = al_expr_type(prog, curfn, e.a);
        if (t[0] == 0) {
            return "";
        }
        return str_concat("*", t);
    }
    if (k == EK_UNARY && str_eq(e.sval, "*") == 1) {
        string t = al_expr_type(prog, curfn, e.a);
        if (t[0] == 0) {
            return "";
        }
        return al_deref(t);
    }
    if (k == EK_MEMBER) {
        string bt = al_expr_type(prog, curfn, e.a);
        if (bt[0] == 0) {
            return "";
        }
        string sn = al_deref(bt);
        List<string> targs;
        List_init<string>(&targs, 2);
        ast_targs(sn, &targs);
        int lt = 0;
        while (sn[lt] != 0 && (int)sn[lt] != 60) {
            lt = lt + 1;
        }
        *DeclNode sd = al_find_struct(prog, al_substr(sn, 0, lt));
        if (sd == null) {
            return "";
        }
        int i = 0;
        while (i < List_len<Param>(&sd.params)) {
            Param f = List_get<Param>(&sd.params, i);
            if (str_eq(f.name, e.sval) == 1) {
                return al_subst(f.ty, &sd.type_params, &targs);
            }
            i = i + 1;
        }
        return "";
    }
    if (k == EK_CALL || k == EK_TEMPLATECALL) {
        int isa = 0;
        string rt = al_call_rettype(prog, curfn, e, &isa);
        if (rt[0] == 0) {
            return "";
        }
        if (isa == 1) {
            if (str_eq(rt, "void") == 1) {
                rt = "uint8";
            }
            return str_concat("*Future<", str_concat(rt, ">"));
        }
        return rt;
    }
    return "";
}

// Bind the type parameters of generic `d` by unifying its parameter types (from index
// `p0`) against the argument types of `args` (from index `a0`); `pre` holds bindings
// already known (or "" per parameter).
void al_infer_targs(*Program prog, *DeclNode curfn, *DeclNode d, List<*ExprNode>* args, int p0, int a0, List<string>* out) {
    int ti = 0;
    while (ti < List_len<TypeParam>(&d.type_params)) {
        string tp = List_get<TypeParam>(&d.type_params, ti).name;
        // Structural parameters first; by-value `T a` deductions meet at their common
        // integer type (as sema decides).
        int pass = 0;
        while (pass < 2 && List_get<string>(out, ti)[0] == 0) {
            int pi = p0;
            int ai = a0;
            while (pi < List_len<Param>(&d.params) && ai < List_len<*ExprNode>(args)) {
                int bare = 0;
                if (ast_streq(ast_unify_canon(List_get<Param>(&d.params, pi).ty), tp) == 1) {
                    bare = 1;
                }
                string at = "";
                if (bare == pass) {
                    at = al_expr_type(prog, curfn, List_get<*ExprNode>(args, ai));
                }
                if (at[0] != 0 && ast_streq(at, "null") == 0) {
                    string b = ast_unify_tparam(List_get<Param>(&d.params, pi).ty, at, tp);
                    string cur = List_get<string>(out, ti);
                    if (b[0] != 0 && cur[0] == 0) {
                        List_set<string>(out, ti, b);
                        if (pass == 0) {
                            break;
                        }
                    }
                    else if (b[0] != 0 && pass == 1 && ast_streq(cur, b) == 0) {
                        string common = ast_range_var_type(cur, b);
                        if (common[0] != 0) {
                            List_set<string>(out, ti, common);
                        }
                    }
                }
                pi = pi + 1;
                ai = ai + 1;
            }
            pass = pass + 1;
        }
        ti = ti + 1;
    }
}

// The declared return type (type parameters substituted) of the function a call `e`
// targets: a named function (generic ones infer their type arguments from the call's
// arguments), an explicit `name<args>(...)`, or a method call `recv.m(...)` (an inline
// method of the receiver's struct, `S_m`, or a generic free `S_m<T..>`). `*is_async`
// tells whether that function is `async` (its call then yields `*Future<ret>`). "" when
// the target is not found.
string al_call_rettype(*Program prog, *DeclNode curfn, *ExprNode e, int* is_async) {
    *is_async = 0;
    if (e.kind == EK_TEMPLATECALL) {
        string sp = e.sval;
        int lt = 0;
        while (sp[lt] != 0 && (int)sp[lt] != 60) {
            lt = lt + 1;
        }
        *DeclNode d = al_find_fn(prog, al_substr(sp, 0, lt));
        if (d == null) {
            return "";
        }
        List<string> targs;
        List_init<string>(&targs, 2);
        ast_targs(sp, &targs);
        *is_async = d.is_async;
        return al_subst(d.ret_type, &d.type_params, &targs);
    }
    if (e.kind != EK_CALL || e.a == null) {
        return "";
    }
    if (e.a.kind == EK_IDENT) {
        *DeclNode d = al_find_fn(prog, e.a.sval);
        if (d == null) {
            return "";
        }
        *is_async = d.is_async;
        if (List_len<TypeParam>(&d.type_params) == 0) {
            return d.ret_type;
        }
        List<string> targs;
        List_init<string>(&targs, 2);
        int ti = 0;
        while (ti < List_len<TypeParam>(&d.type_params)) {
            List_push<string>(&targs, "");
            ti = ti + 1;
        }
        al_infer_targs(prog, curfn, d, &e.kids, 0, 0, &targs);
        return al_subst(d.ret_type, &d.type_params, &targs);
    }
    if (e.a.kind == EK_MEMBER) {
        string rt = al_expr_type(prog, curfn, e.a.a);
        if (rt[0] == 0) {
            return "";
        }
        string sn = al_deref(rt);
        string m = e.a.sval;
        int lt = 0;
        while (sn[lt] != 0 && (int)sn[lt] != 60) {
            lt = lt + 1;
        }
        string base = al_substr(sn, 0, lt);
        List<string> sargs;
        List_init<string>(&sargs, 2);
        ast_targs(sn, &sargs);
        *DeclNode sd = al_find_struct(prog, base);
        if (sd != null) {
            int mi = 0;
            while (mi < List_len<*DeclNode>(&sd.methods)) {
                *DeclNode md = List_get<*DeclNode>(&sd.methods, mi);
                if (str_eq(md.name, m) == 1) {
                    *is_async = md.is_async;
                    return al_subst(md.ret_type, &sd.type_params, &sargs);
                }
                mi = mi + 1;
            }
        }
        *DeclNode d = al_find_fn(prog, str_concat(base, str_concat("_", m)));
        if (d == null) {
            return "";
        }
        *is_async = d.is_async;
        if (List_len<TypeParam>(&d.type_params) == 0) {
            return d.ret_type;
        }
        List<string> targs;
        List_init<string>(&targs, 2);
        int ti = 0;
        while (ti < List_len<TypeParam>(&d.type_params)) {
            List_push<string>(&targs, "");
            ti = ti + 1;
        }
        if (List_len<Param>(&d.params) > 0) {
            string selfp = List_get<Param>(&d.params, 0).ty;
            string recv = sn;
            if ((int)selfp[0] == 42) {
                recv = str_concat("*", sn);
            }
            ti = 0;
            while (ti < List_len<TypeParam>(&d.type_params)) {
                List_set<string>(&targs, ti, ast_unify_tparam(selfp, recv, List_get<TypeParam>(&d.type_params, ti).name));
                ti = ti + 1;
            }
        }
        al_infer_targs(prog, curfn, d, &e.kids, 1, 0, &targs);
        return al_subst(d.ret_type, &d.type_params, &targs);
    }
    return "";
}

// The awaited value type of `await E` (source form, so inside a generic async function it
// is spelled with the type parameters): the inner `T` of E's `*Future<T>` type, where E
// is a call (an `async` callee yields its declared return type), a future variable, or a
// future field. "" when it cannot be resolved.
string al_await_type_or(*Program prog, *DeclNode curfn, *ExprNode awaited) {
    if (awaited == null) {
        return "";
    }
    if (awaited.kind == EK_CALL || awaited.kind == EK_TEMPLATECALL) {
        int isa = 0;
        string rt = al_call_rettype(prog, curfn, awaited, &isa);
        if (rt[0] != 0) {
            if (isa == 1) {
                if (str_eq(rt, "void") == 1) {
                    return "uint8";
                }
                return rt;
            }
            return al_inner_of_future(rt);
        }
        return "";
    }
    string t = al_expr_type(prog, curfn, awaited);
    if (t[0] != 0) {
        return al_inner_of_future(t);
    }
    return "";
}

// As al_await_type_or, defaulting to "int".
string al_await_type(*Program prog, *DeclNode curfn, *ExprNode awaited) {
    string t = al_await_type_or(prog, curfn, awaited);
    if (t[0] == 0) {
        return "int";
    }
    return t;
}

// Declared type of a variable name (a param or a body local) in statement subtree `s`.
string al_find_vartype(*StmtNode s, string name) {
    if (s == null) {
        return "";
    }
    if (s.kind == SK_VARDECL && str_eq(s.name, name) == 1) {
        return s.type;
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_DOWHILE || s.kind == SK_DEFER || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_TRY) {
        string t = al_find_vartype(s.s1, name);
        if (t[0] != 0) {
            return t;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) {
        string t = al_find_vartype(s.s2, name);
        if (t[0] != 0) {
            return t;
        }
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            string t = al_find_vartype(List_get<*StmtNode>(&s.items, i), name);
            if (t[0] != 0) {
                return t;
            }
            i = i + 1;
        }
    }
    return "";
}

string al_var_type(*DeclNode curfn, string name) {
    int i = 0;
    while (i < List_len<Param>(&curfn.params)) {
        Param p = List_get<Param>(&curfn.params, i);
        if (str_eq(p.name, name) == 1) {
            return p.ty;
        }
        i = i + 1;
    }
    return al_find_vartype(curfn.body, name);
}

// Strip a leading/trailing '*' from a type (pointee), e.g. "*int" / "int*" → "int".
string al_deref(string t) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    if (n > 0 && (int)t[n - 1] == 42) {
        *uint8 b = alloc<uint8>(n);
        int k = 0;
        while (k<n-1) {
            b[k] = (uint8)t[k];
            k = k+1;
        }
        b[n-1] = 0;
        return (string)b;
    }
    if ((int)t[0] == 42) {
        *uint8 b = alloc<uint8>(n);
        int k = 1;
        while (k<n) {
            b[k-1] = (uint8)t[k];
            k = k+1;
        }
        b[n-1] = 0;
        return (string)b;
    }
    return t;
}

// Find a struct decl by name in the program (for list-like for-in: its `data` field type).
*DeclNode al_find_struct(*Program prog, string name) {
    int i = 0;
    while (i < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_STRUCT && str_eq(d.name, name) == 1) {
            return d;
        }
        i = i + 1;
    }
    return null;
}

// For a generic container instantiation like "List<double>", resolve the element
// type of its `data` field (`*T`) by substituting the type argument for the
// template's type parameter. Returns "" when `sn` is not a resolvable generic.
// Without this, an async `for (v in xs)` over a `List<T>` (T != int) defaulted the
// element type to `int` and miscompiled the loop body.
string al_generic_data_elem(*Program prog, string sn) {
    int lt = 0;   // find '<'
    while (sn[lt] != 0 && (int)sn[lt] != 60) {
        lt = lt + 1;
    }
    if (sn[lt] == 0) {                                        // not generic
        return "";
    }
    string base = al_substr(sn, 0, lt);
    List<string> args;
    List_init<string>(&args, 2);
    int i = lt + 1;
    int start = i;
    int depth = 1;
    while (sn[i] != 0 && depth > 0) {
        int ch = (int)sn[i];
        if (ch == 60 || ch == 40) {             // '<' or '(' (nested generic / fn params)
            depth = depth + 1;
        }
        else if (ch == 41) {   // ')'
            if (depth > 0) {
                depth = depth - 1;
            }
        }
        else if (ch == 62 && (i == 0 || (int)sn[i - 1] != 45)) {      // '>' closing a generic, NOT the "->" arrow
            depth = depth - 1;
            if (depth == 0) {
                List_push<string>(&args, al_substr(sn, start, i));
            }
        }
        else if (ch == 44 && depth == 1) {
            List_push<string>(&args, al_substr(sn, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    *DeclNode sd = al_find_struct(prog, base);
    if (sd == null) {
        return "";
    }
    string dft = "";
    int k = 0;
    while (k < List_len<Param>(&sd.params)) {
        Param p = List_get<Param>(&sd.params, k);
        if (str_eq(p.name, "data") == 1) {
            dft = p.ty;
        }
        k = k + 1;
    }
    if (dft[0] == 0) {
        return "";
    }
    string elem = al_deref(dft);                                           // "*T" -> "T"
    int tpi = 0;
    while (tpi < List_len<TypeParam>(&sd.type_params)) {
        TypeParam tp = List_get<TypeParam>(&sd.type_params, tpi);
        if (str_eq(tp.name, elem) == 1 && tpi < List_len<string>(&args)) {
            return List_get<string>(&args, tpi);
        }
        tpi = tpi + 1;
    }
    return elem;                                                           // concrete data element
}

// ── The transform ─────────────────────────────────────────────────────────────
// A state's pending defer frames: `flat` holds every frame's statements in order and
// frame f is flat[offs[f] .. offs[f + 1]).
struct AlSnap {
    List<*StmtNode> flat;
    List<int> offs;
}

// Shared state-graph context, threaded by pointer through the recursive lowering.
struct AlCtx {
    *Program prog;
    string resumeN;
    List<string> vars;             // frame variable names (locals → fr.<name>)
    List<Param> fields;            // frame fields (per-await __awI appended during lowering)
    List<List<*StmtNode>> states;  // one statement list per state
    List<int> brk;                 // break-target states (innermost last)
    List<int> cont;                // continue-target states
    // `defer` in a state-split block: the block no longer exists as a real scope, so its
    // defer bodies are kept here, one frame per split block (innermost last), and emitted
    // LIFO at each exit: fall-through (the block's frame), `return` (every frame),
    // `break`/`continue` (frames above the target's depth, parallel to brk/cont). errdefer
    // only runs on a `?` error exit, which async lowering never produces. A body without
    // an await is kept rewritten (al_rewrite_plain); one that awaits is kept as written and
    // lowered into states at each exit (al_run_frames).
    List<List<*StmtNode>> dfr;
    List<int> brk_dd;
    List<int> cont_dd;
    int awcount;                   // await counter → __aw0, __aw1, …
    List<*ExprNode> aw_nodes;      // each `let x = await E` (its await) and its future's field,
    List<string> aw_fields;        // named when the locals are scanned (as the C++ awIdx)
    List<string> aw_types;         // ... and its value type
    int tmpn;                      // desugar temp counter → __awt0, …
    int forinseq;                  // for-in index names → __forin_i_0, … (the C++ forinSeq)
    int inittmp;                   // a hoisted local's initializer temporaries → __zero_t0, __init_t1, … (the C++ initTmp)
    *DeclNode curfn;                  // the async function being lowered (for iterable type lookup)
    List<string>* used;            // every name in the function: synthesized names avoid them
    // A `try` split into states (mirrors the C++ Region): the states of its body form one
    // region and those of its handlers another. Each state of a region is wrapped at the
    // end in the region's handlers, innermost first. rg_start is the defer depth of the
    // try (its finally frame sits there), rg_base the depth where the region's frames begin.
    List<int> rg_parent;
    List<int> rg_start;
    List<int> rg_base;
    List<*StmtNode> rg_fin;        // the try's finally (rewritten), or null
    List<int> ci_region;           // the body regions' catch clauses: region, type, variable, state
    List<string> ci_type;
    List<string> ci_var;
    List<string> ci_txt;           // frame field holding the clause's exception_text() ("" if unused)
    List<int> ci_state;
    int cur_region;                // the region new states belong to (-1: none)
    List<int> st_region;           // each state's region (parallel to states)
    List<AlSnap> st_snap;          // each state's pending defer frames
    // Each await a future can be dropped at, with the defer frames pending there: a
    // cancelled future runs them once, from its on_drop.
    List<int> ds_state;
    List<AlSnap> ds_snap;
    List<int> drop_from;           // parked state -> its cleanup state
    List<int> drop_to;
    List<int> drop_det;            // 1: that cleanup awaits, so it runs detached
    // Lowering the cleanup a cancelled future runs (nobody can drop the frame again, so its
    // awaits record no drop sites), and that flag for each state.
    int cancel;
    List<int> st_cancel;
    List<int> exc_reg;             // region -> the frame field holding its captured exception
    List<string> exc_name;
    string errname;                // the async function's name, for diagnostics
}

int al_lower_seq(*AlCtx c, List<*StmtNode>* items, int entry);
int al_lower_stmt(*AlCtx c, *StmtNode s, int cur);
int al_stmt_has_await_deep(*StmtNode s);
*StmtNode al_rewrite_plain(*AlCtx c, *StmtNode s);
*StmtNode al_desugar_stmt(*AlCtx c, *StmtNode s);
void al_desugar_items(*AlCtx c, List<*StmtNode>* inp, List<*StmtNode>* out);
*ExprNode al_call_on(*ExprNode callee, List<*ExprNode>* args);
*ExprNode al_waker_noop();
*ExprNode al_ondrop(*AlCtx c);
int al_expr_has_await(*ExprNode e);
void al_error_at(*AlCtx c, int line, int col, string msg);
int al_lower_match(*AlCtx c, *StmtNode m, int cur);
int al_lower_try(*AlCtx c, *StmtNode t, int cur);
*ExprNode al_first_await_e(*ExprNode e);
*ExprNode al_any_await_s(*StmtNode s);

// A new state in `region`, whose pending defer frames are the first `depth` frames.
// The first `depth` frames of `frs` as a snapshot.
void al_snap_fill(AlSnap* snap, List<List<*StmtNode>>* frs, int depth) {
    List_init<*StmtNode>(&snap.flat, 4);
    List_init<int>(&snap.offs, 4);
    int nf = List_len<List<*StmtNode>>(frs);
    if (depth < nf) {
        nf = depth;
    }
    int f = 0;
    while (f < nf) {
        List_push<int>(&snap.offs, List_len<*StmtNode>(&snap.flat));
        List<*StmtNode> fr = List_get<List<*StmtNode>>(frs, f);
        int k = 0;
        while (k < List_len<*StmtNode>(&fr)) {
            List_push<*StmtNode>(&snap.flat, List_get<*StmtNode>(&fr, k));
            k = k + 1;
        }
        f = f + 1;
    }
    List_push<int>(&snap.offs, List_len<*StmtNode>(&snap.flat));
}

// The frames of a snapshot, as a new frame stack.
void al_snap_frames(List<List<*StmtNode>>* out, AlSnap* snap) {
    List_init<List<*StmtNode>>(out, 4);
    int f = 0;
    while (f + 1 < List_len<int>(&snap.offs)) {
        List<*StmtNode> fr;
        List_init<*StmtNode>(&fr, 2);
        int q = List_get<int>(&snap.offs, f);
        while (q < List_get<int>(&snap.offs, f + 1)) {
            List_push<*StmtNode>(&fr, List_get<*StmtNode>(&snap.flat, q));
            q = q + 1;
        }
        List_push<List<*StmtNode>>(out, fr);
        f = f + 1;
    }
}

// A copy of the first `nf` frames of `src`, the last one cut to `last` entries (-1: all).
void al_frames_copy(List<List<*StmtNode>>* out, List<List<*StmtNode>>* src, int nf, int last) {
    List_init<List<*StmtNode>>(out, nf + 1);
    int f = 0;
    while (f < nf && f < List_len<List<*StmtNode>>(src)) {
        List<*StmtNode> from = List_get<List<*StmtNode>>(src, f);
        int n = List_len<*StmtNode>(&from);
        if (f == nf - 1 && last >= 0 && last < n) {
            n = last;
        }
        List<*StmtNode> fr;
        List_init<*StmtNode>(&fr, n + 1);
        int k = 0;
        while (k < n) {
            List_push<*StmtNode>(&fr, List_get<*StmtNode>(&from, k));
            k = k + 1;
        }
        List_push<List<*StmtNode>>(out, fr);
        f = f + 1;
    }
}

// Does a cleanup in frames [from, to) await?
int al_frames_await(List<List<*StmtNode>>* frs, int from, int to) {
    int f = from;
    while (f < to && f < List_len<List<*StmtNode>>(frs)) {
        List<*StmtNode> fr = List_get<List<*StmtNode>>(frs, f);
        int k = 0;
        while (k < List_len<*StmtNode>(&fr)) {
            if (al_stmt_has_await_deep(List_get<*StmtNode>(&fr, k)) == 1) {
                return 1;
            }
            k = k + 1;
        }
        f = f + 1;
    }
    return 0;
}

int al_newst_in(*AlCtx c, int region, int depth) {
    List<*StmtNode> s;
    List_init<*StmtNode>(&s, 8);
    List_push<List<*StmtNode>>(&c.states, s);
    List_push<int>(&c.st_region, region);
    List_push<int>(&c.st_cancel, c.cancel);
    let snap: AlSnap;
    al_snap_fill(&snap, &c.dfr, depth);
    List_push<AlSnap>(&c.st_snap, snap);
    return List_len<List<*StmtNode>>(&c.states) - 1;
}

int al_newst(*AlCtx c) {
    return al_newst_in(c, c.cur_region, List_len<List<*StmtNode>>(&c.dfr));
}

// Append to states[st] (List_get copies the inner List, so write it back).
void al_push(*AlCtx c, int st, *StmtNode s) {
    List<*StmtNode> body = List_get<List<*StmtNode>>(&c.states, st);
    List_push<*StmtNode>(&body, s);
    List_set<List<*StmtNode>>(&c.states, st, body);
}

void al_goto(*AlCtx c, int st, int target) {
    al_push(c, st, al_assign(al_fr(al_fst), al_int(target)));
}

// A two-way state dispatch: `if (cond) fr.st = thenE; else fr.st = elseE;` as one stmt.
// Shared by the if/while/for lowerings, whose only difference is the target states.
*StmtNode al_dispatch2(*ExprNode cond, int thenE, int elseE) {
    List<*StmtNode> tb;
    List_init<*StmtNode>(&tb, 1);
    List_push<*StmtNode>(&tb, al_assign(al_fr(al_fst), al_int(thenE)));
    List<*StmtNode> eb;
    List_init<*StmtNode>(&eb, 1);
    List_push<*StmtNode>(&eb, al_assign(al_fr(al_fst), al_int(elseE)));
    return al_if(cond, al_block(&tb), al_block(&eb));
}

// Enter/leave a loop for break/continue lowering: push (pop) this loop's break and
// continue target states, kept in sync on the two parallel stacks.
void al_enter_loop(*AlCtx c, int brk, int cont) {
    List_push<int>(&c.brk, brk);
    List_push<int>(&c.cont, cont);
    int dd = List_len<List<*StmtNode>>(&c.dfr);
    List_push<int>(&c.brk_dd, dd);
    List_push<int>(&c.cont_dd, dd);
}

void al_leave_loop(*AlCtx c) {
    List_remove<int>(&c.brk, List_len<int>(&c.brk) - 1);
    List_remove<int>(&c.cont, List_len<int>(&c.cont) - 1);
    List_remove<int>(&c.brk_dd, List_len<int>(&c.brk_dd) - 1);
    List_remove<int>(&c.cont_dd, List_len<int>(&c.cont_dd) - 1);
}

// Append the pending split-block defer bodies of frames >= downTo to `out`, LIFO.
void al_emit_defers(*AlCtx c, List<*StmtNode>* out, int downTo) {
    if (al_frames_await(&c.dfr, downTo, List_len<List<*StmtNode>>(&c.dfr)) == 1) {
        al_error_at(c, 0, 0, "internal error: an awaiting cleanup emitted in place");
    }
    int f = List_len<List<*StmtNode>>(&c.dfr) - 1;
    while (f >= downTo) {
        List<*StmtNode> fr = List_get<List<*StmtNode>>(&c.dfr, f);
        int k = List_len<*StmtNode>(&fr) - 1;
        while (k >= 0) {
            List_push<*StmtNode>(out, List_get<*StmtNode>(&fr, k));
            k = k - 1;
        }
        f = f - 1;
    }
}

// Releases the exceptions captured for an awaiting cleanup that never rethrew them (filled
// in once every capture is known), run when the frame is finished.
*StmtNode al_exc_free = null;
// Publish the completion (the value is already in fr.ret.value), then return.
void al_publish(List<*StmtNode>* out) {
    if (al_exc_free != null) {
        List_push<*StmtNode>(out, al_exc_free);
    }
    List<*ExprNode> sa;
    List_init<*ExprNode>(&sa, 2);
    List_push<*ExprNode>(&sa, mk_un("&", al_member(al_fr(al_fret), "state")));
    List_push<*ExprNode>(&sa, al_int(2));
    *ExprNode swap = al_call("atomic_swap", &sa);
    List<*StmtNode> wk;
    List_init<*StmtNode>(&wk, 1);
    List<*ExprNode> wa;
    List_init<*ExprNode>(&wa, 1);
    List_push<*StmtNode>(&wk, al_exprstmt(al_call_on(al_member(al_fr(al_fret), "waker"), &wa)));
    List_push<*StmtNode>(out, al_if(mk_bin("==", swap, al_int(1)), al_block(&wk), null));
    List_push<*StmtNode>(out, al_return(null));
}

// The completion sequence (fr.ret.value = v; if(atomic_swap(&fr.ret.state,2)==1) fr.ret.waker(); return;)
void al_completion_items(*AlCtx c, *ExprNode v, List<*StmtNode>* out) {
    List_push<*StmtNode>(out, al_assign(al_member(al_fr(al_fret), "value"), v));
    al_emit_defers(c, out, 0);                       // pending defers, before publishing
    al_publish(out);
}

// Run the pending defer frames above `downTo`, innermost first, from state `st0`. A frame
// below a region's base runs in a state of the enclosing region (so an exception a finally
// throws is not caught by its own try's handlers), and a cleanup that awaits is lowered into
// states of its own, with the cleanups under it still pending. Returns the state where
// control continues (-1: never). Mirrors the C++ runFrames.
int al_run_frames(*AlCtx c, int st0, int downTo) {
    int st = st0;
    int reg = List_get<int>(&c.st_region, st);
    int f = List_len<List<*StmtNode>>(&c.dfr) - 1;
    while (f >= downTo) {
        while (reg != 0 - 1 && f < List_get<int>(&c.rg_base, reg)) {
            int p = List_get<int>(&c.rg_parent, reg);
            int s2 = al_newst_in(c, p, f);
            al_goto(c, st, s2);
            st = s2;
            reg = p;
        }
        List<List<*StmtNode>> saved = c.dfr;
        List<*StmtNode> fr = List_get<List<*StmtNode>>(&saved, f);
        int k = List_len<*StmtNode>(&fr) - 1;
        while (k >= 0) {
            *StmtNode b = List_get<*StmtNode>(&fr, k);
            if (al_stmt_has_await_deep(b) == 0) {
                al_push(c, st, b);
            }
            else {
                int sreg = c.cur_region;
                List<List<*StmtNode>> cut;
                al_frames_copy(&cut, &saved, f + 1, k);
                c.dfr = cut;
                c.cur_region = reg;
                int n = al_newst(c);
                al_goto(c, st, n);
                int e = al_lower_stmt(c, b, n);
                c.dfr = saved;
                c.cur_region = sreg;
                if (e == 0 - 1) {
                    return 0 - 1;
                }
                st = e;
            }
            k = k - 1;
        }
        f = f - 1;
    }
    return st;
}

// Leave state `st` for the enclosing defer depth `downTo`: run the pending defer frames
// above it (al_run_frames), then jump to `target`, or (`complete`) publish the completion
// outside every region (mirrors the C++ emitExit).
void al_emit_exit(*AlCtx c, int st0, int downTo, int target, int complete) {
    int st = al_run_frames(c, st0, downTo);
    if (st == 0 - 1) {
        return;
    }
    if (complete == 0) {
        al_goto(c, st, target);
        return;
    }
    int reg = List_get<int>(&c.st_region, st);
    while (reg != 0 - 1) {
        int p = List_get<int>(&c.rg_parent, reg);
        int s2 = al_newst_in(c, p, downTo);
        al_goto(c, st, s2);
        st = s2;
        reg = p;
    }
    List<*StmtNode> items;
    List_init<*StmtNode>(&items, 3);
    al_publish(&items);
    int i = 0;
    while (i < List_len<*StmtNode>(&items)) {
        al_push(c, st, List_get<*StmtNode>(&items, i));
        i = i + 1;
    }
}

void al_complete(*AlCtx c, int st, *ExprNode v) {
    List<*StmtNode> items;
    List_init<*StmtNode>(&items, 3);
    al_completion_items(c, v, &items);
    int i = 0;
    while (i < List_len<*StmtNode>(&items)) {
        al_push(c, st, List_get<*StmtNode>(&items, i));
        i = i + 1;
    }
}

*StmtNode al_complete_block(*AlCtx c, *ExprNode v) {
    List<*StmtNode> items;
    List_init<*StmtNode>(&items, 3);
    al_completion_items(c, v, &items);
    return al_block(&items);
}

// Does control definitely leave this statement (return on every path)?
int al_terminates(*StmtNode s) {
    if (s == null) {
        return 0;
    }
    if (s.kind == SK_RETURN || s.kind == SK_THROW) {
        return 1;
    }
    if (s.kind == SK_BLOCK) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            if (al_terminates(List_get<*StmtNode>(&s.items, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (s.kind == SK_IF) {
        return s.s2 != null && al_terminates(s.s1) == 1 && al_terminates(s.s2) == 1;
    }
    return 0;
}

// A break/continue binding to an ENCLOSING loop (not shadowed by a nested loop; a switch
// captures only `break`)? With `cont_only`, only a `continue` counts.
int al_escapes_in(*StmtNode s, int cont_only) {
    if (s == null) {
        return 0;
    }
    if (s.kind == SK_CONTINUE) {
        return 1;
    }
    if (s.kind == SK_BREAK) {
        return 1 - cont_only;
    }
    int co = cont_only;
    if (s.kind == SK_SWITCH) {
        co = 1;
    }
    if (s.kind == SK_IF || s.kind == SK_TRY) {
        if (al_escapes_in(s.s1, co) == 1 || al_escapes_in(s.s2, co) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_ARM || s.kind == SK_CATCH) {
        return al_escapes_in(s.s1, co);
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            if (al_escapes_in(List_get<*StmtNode>(&s.items, i), co) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

int al_loop_escapes(*StmtNode s) {
    return al_escapes_in(s, 0);
}

// Does a statement contain a `return` (a lambda is an expression: not descended)?
int al_has_return(*StmtNode s) {
    if (s == null) {
        return 0;
    }
    if (s.kind == SK_RETURN) {
        return 1;
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_TRY) {
        if (al_has_return(s.s1) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) {
        if (al_has_return(s.s2) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            if (al_has_return(List_get<*StmtNode>(&s.items, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

// `let x = E` of a hoisted local: `fr.x = E`. An array literal `{...}` is only a
// variable initializer, so it fills a temporary that is then copied to the field.
*StmtNode al_init_field(*AlCtx c, *StmtNode vd) {
    // `T x;` resets its field to zero at each declaration (a loop iteration), as a local
    // does: a fresh local of the type (zeroed by codegen) is copied in (as the C++ initField).
    if (vd.expr == null) {
        string zn = fresh_name(str_concat("__zero_t", int_to_str(c.inittmp)), c.used);
        c.inittmp = c.inittmp + 1;
        List<*StmtNode> zb;
        List_init<*StmtNode>(&zb, 2);
        List_push<*StmtNode>(&zb, mk_vardecl(zn, vd.type, null, 0));
        List_push<*StmtNode>(&zb, al_assign(al_fr(vd.name), mk_ident(zn)));
        return al_block(&zb);
    }
    al_rewrite(vd.expr, &c.vars);
    if (vd.expr.kind != EK_ARRAYLIT) {
        return al_assign(al_fr(vd.name), vd.expr);
    }
    string tn = fresh_name(str_concat("__init_t", int_to_str(c.inittmp)), c.used);
    c.inittmp = c.inittmp + 1;
    List<*StmtNode> blk;
    List_init<*StmtNode>(&blk, 2);
    List_push<*StmtNode>(&blk, mk_vardecl(tn, vd.type, vd.expr, 0));
    List_push<*StmtNode>(&blk, al_assign(al_fr(vd.name), mk_ident(tn)));
    return al_block(&blk);
}

// Rewrite a NO-await statement for inclusion in a state (locals→fr, return→completion).
*StmtNode al_rewrite_plain(*AlCtx c, *StmtNode s) {
    if (s == null) {
        return s;
    }
    if (s.kind == SK_BLOCK) {
        List<*StmtNode> out;
        List_init<*StmtNode>(&out, 8);
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            *StmtNode it = List_get<*StmtNode>(&s.items, i);
            i = i + 1;
            if (it.kind == SK_VARDECL) {
                List_push<*StmtNode>(&out, al_init_field(c, it));
            } else {
                List_push<*StmtNode>(&out, al_rewrite_plain(c, it));
            }
        }
        return al_block(&out);
    }
    if (s.kind == SK_TRY || s.kind == SK_MATCH) {
        // try: s1 body, items = catch clauses (s1 each), s2 finally. match: expr subject,
        // items = arms (s1 each). Rewritten in place.
        // Catches (arms), body, then finally, as the C++.
        al_rewrite(s.expr, &c.vars);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cl = List_get<*StmtNode>(&s.items, k);
            k = k + 1;
            cl.s1 = al_rewrite_plain(c, cl.s1);
        }
        s.s1 = al_rewrite_plain(c, s.s1);
        s.s2 = al_rewrite_plain(c, s.s2);
        return s;
    }
    if (s.kind == SK_RETURN) {
        *ExprNode v = s.expr;
        if (v == null) {
            v = al_int(0);
        }
        al_rewrite(v, &c.vars);
        return al_complete_block(c, v);
    }
    if (s.kind == SK_EXPR) {
        al_rewrite(s.expr, &c.vars);
        return s;
    }
    // An asm operand naming a local reads or writes its frame field.
    if (s.kind == SK_ASM) {
        int ak = 0;
        while (ak < List_len<*StmtNode>(&s.items)) {
            al_rewrite(List_get<*StmtNode>(&s.items, ak).expr, &c.vars);
            ak = ak + 1;
        }
        return s;
    }
    if (s.kind == SK_IF) {
        al_rewrite(s.expr, &c.vars);
        return al_if(s.expr, al_rewrite_plain(c, s.s1), al_rewrite_plain(c, s.s2));
    }
    if (s.kind == SK_WHILE) {
        al_rewrite(s.expr, &c.vars);
        return al_while(s.expr, al_rewrite_plain(c, s.s1));
    }
    if (s.kind == SK_DOWHILE) {
        al_rewrite(s.expr, &c.vars);
        return al_dowhile(al_rewrite_plain(c, s.s1), s.expr);
    }
    if (s.kind == SK_DEFER) {
        return al_defer(al_rewrite_plain(c, s.s1), s.is_err);
    }
    if (s.kind == SK_THROW) {
        al_rewrite(s.expr, &c.vars);
        return s;
    }
    if (s.kind == SK_FOR) {
        *StmtNode in2 = al_rewrite_plain(c, s.s1);
        al_rewrite(s.expr, &c.vars);
        al_rewrite(s.expr2, &c.vars);
        return al_for(in2, s.expr, s.expr2, al_rewrite_plain(c, s.s2));
    }
    if (s.kind == SK_SWITCH) {
        al_rewrite(s.expr, &c.vars);
        List<*StmtNode> ncases;
        List_init<*StmtNode>(&ncases, 4);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k);
            k = k + 1;
            al_rewrite(cs.expr, &c.vars);
            List<*StmtNode> nb;
            List_init<*StmtNode>(&nb, 4);
            int j = 0;
            while (j < List_len<*StmtNode>(&cs.items)) {
                *StmtNode ci = List_get<*StmtNode>(&cs.items, j);
                j = j + 1;
                if (ci.kind == SK_VARDECL) {           // a case's declaration (C scoping)
                    List_push<*StmtNode>(&nb, al_init_field(c, ci));
                } else {
                    List_push<*StmtNode>(&nb, al_rewrite_plain(c, ci));
                }
            }
            List_push<*StmtNode>(&ncases, al_case(cs.expr, &nb));
        }
        return al_switch(s.expr, &ncases);
    }
    return s;     // break/continue/etc.
}

// The frame field holding the future of `let x = await E` (s), named and added the first
// time it is asked for: when the locals are scanned, so it follows x as in the C++ frame.
string al_await_field(*AlCtx c, *StmtNode s) {
    int i = 0;
    while (i < List_len<*ExprNode>(&c.aw_nodes)) {
        if (List_get<*ExprNode>(&c.aw_nodes, i) == s.expr) {
            return List_get<string>(&c.aw_fields, i);
        }
        i = i + 1;
    }
    int idx = c.awcount;
    c.awcount = idx + 1;
    string awf = fresh_name(str_concat("__aw", int_to_str(idx)), c.used);
    // The future's value type, as the C++ transform uses it; when it cannot be
    // resolved, the declared type of the let variable (`let x: T = await E`).
    string Ti = al_await_type_or(c.prog, c.curfn, s.expr.a);
    if (Ti[0] == 0 && s.expr.aty != null) {   // sema's (or the hoist's) type
        Ti = s.expr.aty;
    }
    if (Ti[0] == 0) {
        Ti = s.type;
    }
    if (Ti == null || Ti[0] == 0) {
        Ti = "int";
    }
    let af: Param;
    af.name = awf;
    af.ty = str_concat("*Future<", str_concat(Ti, ">"));
    List_push<Param>(&c.fields, af);
    List_push<*ExprNode>(&c.aw_nodes, s.expr);
    List_push<string>(&c.aw_fields, awf);
    List_push<string>(&c.aw_types, Ti);
    return awf;
}

int al_await_index(*AlCtx c, *ExprNode aw) {
    int i = 0;
    while (i < List_len<*ExprNode>(&c.aw_nodes)) {
        if (List_get<*ExprNode>(&c.aw_nodes, i) == aw) {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

// Lower a top-level item (a decl or stmt) at state `cur`; returns the continuation state.
int al_lower_item(*AlCtx c, *StmtNode s, int cur) {
    if (s.kind == SK_VARDECL) {
        if (s.expr == null) {
            al_push(c, cur, al_init_field(c, s));
            return cur;
        }
        if (s.expr.kind == EK_AWAIT) {
            string awf = al_await_field(c, s);
            string Ti = List_get<string>(&c.aw_types, al_await_index(c, s.expr));
            *ExprNode callE = s.expr.a;
            al_rewrite(callE, &c.vars);
            al_push(c, cur, al_assign(al_fr(awf), callE));
            int next = al_newst(c);
            List<*ExprNode> pa;
            List_init<*ExprNode>(&pa, 2);
            List_push<*ExprNode>(&pa, al_fr(awf));
            List_push<*ExprNode>(&pa, al_waker(c.resumeN, next));
            *ExprNode poll = al_tcall(str_concat("Future_poll<", str_concat(Ti, ">")), &pa);
            List<*StmtNode> pk;
            List_init<*StmtNode>(&pk, 2);
            List_push<*StmtNode>(&pk, al_assign(al_fr(al_fawt), mk_cast("*FutureHdr", al_fr(awf))));
            List_push<*StmtNode>(&pk, al_return(null));
            al_push(c, cur, al_if(mk_bin("==", poll, al_int(0)), al_block(&pk), null));
            al_goto(c, cur, next);
            // Dropped while parked here: the pending defers and finally blocks run.
            int pending = 0;
            int pf = 0;
            while (pf < List_len<List<*StmtNode>>(&c.dfr)) {
                List<*StmtNode> pfr = List_get<List<*StmtNode>>(&c.dfr, pf);
                if (List_len<*StmtNode>(&pfr) > 0) {
                    pending = 1;
                }
                pf = pf + 1;
            }
            if (pending == 1 && c.cancel == 0) {
                List_push<int>(&c.ds_state, cur);
                let dsn: AlSnap;
                al_snap_fill(&dsn, &c.dfr, List_len<List<*StmtNode>>(&c.dfr));
                List_push<AlSnap>(&c.ds_snap, dsn);
            }
            al_push(c, next, al_assign(al_fr(al_fawt), mk_cast("*FutureHdr", al_int(0))));
            al_push(c, next, al_assign(al_fr(s.name), al_member(al_fr(awf), "value")));
            *ExprNode fw = ast_new_expr();                // the waker's env (C++: free_closure too)
            fw.kind = EK_FREECLOSURE;
            fw.a = al_member(al_fr(awf), "waker");
            al_push(c, next, al_exprstmt(fw));
            List<*ExprNode> fa;
            List_init<*ExprNode>(&fa, 1);
            List_push<*ExprNode>(&fa, al_fr(awf));
            al_push(c, next, al_exprstmt(al_tcall(str_concat("Future_free<", str_concat(Ti, ">")), &fa)));
            return next;
        }
        al_push(c, cur, al_init_field(c, s));
        return cur;
    }
    return al_lower_stmt(c, s, cur);
}

int al_lower_seq(*AlCtx c, List<*StmtNode>* items, int entry) {
    int cur = entry;
    List<*StmtNode> frame;
    List_init<*StmtNode>(&frame, 2);
    List_push<List<*StmtNode>>(&c.dfr, frame);     // this split block's defers
    int top = List_len<List<*StmtNode>>(&c.dfr) - 1;
    int i = 0;
    while (i < List_len<*StmtNode>(items)) {
        if (cur == 0 - 1) {             // rest unreachable
            break;
        }
        *StmtNode it = List_get<*StmtNode>(items, i);
        i = i + 1;
        if (it.kind == SK_DEFER) {
            if (it.is_err == 0) {
                List<*StmtNode> fr = List_get<List<*StmtNode>>(&c.dfr, top);
                if (al_stmt_has_await_deep(it.s1) == 1) {
                    List_push<*StmtNode>(&fr, it.s1);
                }
                else {
                    List_push<*StmtNode>(&fr, al_rewrite_plain(c, it.s1));
                }
                List_set<List<*StmtNode>>(&c.dfr, top, fr);
                // In a split try a state's pending defers are fixed: begin a new one.
                int creg = List_get<int>(&c.st_region, cur);
                if (creg != 0 - 1) {
                    int n = al_newst_in(c, creg, List_len<List<*StmtNode>>(&c.dfr));
                    al_goto(c, cur, n);
                    cur = n;
                }
            }
            continue;
        }
        cur = al_lower_item(c, it, cur);
    }
    List<*StmtNode> topfr = List_get<List<*StmtNode>>(&c.dfr, top);
    int had = 0;
    if (List_len<*StmtNode>(&topfr) > 0) {
        had = 1;
    }
    if (cur != 0 - 1) {   // fall-through exit
        cur = al_run_frames(c, cur, top);
    }
    List_remove<List<*StmtNode>>(&c.dfr, top);
    if (cur != 0 - 1 && had == 1) {
        int creg = List_get<int>(&c.st_region, cur);
        if (creg != 0 - 1) {
            int n = al_newst_in(c, creg, List_len<List<*StmtNode>>(&c.dfr));
            al_goto(c, cur, n);
            cur = n;
        }
    }
    return cur;
}

// Lower a statement that may contain an await into the state graph.
int al_lower_stmt(*AlCtx c, *StmtNode s, int cur) {
    if (s.kind == SK_RETURN) {
        *ExprNode v = s.expr;
        if (v == null) {
            v = al_int(0);
        }
        al_rewrite(v, &c.vars);
        al_push(c, cur, al_assign(al_member(al_fr(al_fret), "value"), v));
        al_emit_exit(c, cur, 0, 0, 1);
        return 0 - 1;
    }
    if (s.kind == SK_BREAK) {
        al_emit_exit(c, cur, List_get<int>(&c.brk_dd, List_len<int>(&c.brk_dd) - 1), List_get<int>(&c.brk, List_len<int>(&c.brk) - 1), 0);
        return 0 - 1;
    }
    if (s.kind == SK_CONTINUE) {
        al_emit_exit(c, cur, List_get<int>(&c.cont_dd, List_len<int>(&c.cont_dd) - 1), List_get<int>(&c.cont, List_len<int>(&c.cont) - 1), 0);
        return 0 - 1;
    }
    // No await, no escaping break/continue and (in a split try, or under a cleanup that
    // awaits) no `return`, whose exit must leave the try's region or run the cleanup in
    // states → emit verbatim in this state.
    int in_region = 0;
    if (List_get<int>(&c.st_region, cur) != 0 - 1) {
        in_region = 1;
    }
    if (al_frames_await(&c.dfr, 0, List_len<List<*StmtNode>>(&c.dfr)) == 1) {
        in_region = 1;
    }
    if (al_stmt_has_await_deep(s) == 0 && al_loop_escapes(s) == 0 && (in_region == 0 || al_has_return(s) == 0)) {
        al_push(c, cur, al_rewrite_plain(c, s));
        if (al_terminates(s) == 1) {
            return 0 - 1;
        }
        return cur;
    }
    if (s.kind == SK_IF) {
        al_rewrite(s.expr, &c.vars);
        int thenE = al_newst(c);
        int elseE = al_newst(c);
        int join = al_newst(c);
        al_push(c, cur, al_dispatch2(s.expr, thenE, elseE));
        int te = al_lower_stmt(c, s.s1, thenE);
        int ee = elseE;
        if (s.s2 != null) {
            ee = al_lower_stmt(c, s.s2, elseE);
        }
        if (te != 0 - 1) {
            al_goto(c, te, join);
        }
        if (ee != 0 - 1) {
            al_goto(c, ee, join);
        }
        if (te == 0 - 1 && ee == 0 - 1) {
            return 0 - 1;
        }
        return join;
    }
    if (s.kind == SK_WHILE) {
        al_rewrite(s.expr, &c.vars);
        int header = al_newst(c);
        int bodyE = al_newst(c);
        int after = al_newst(c);
        al_goto(c, cur, header);
        al_push(c, header, al_dispatch2(s.expr, bodyE, after));
        al_enter_loop(c, after, header);
        int be = al_lower_stmt(c, s.s1, bodyE);
        al_leave_loop(c);
        if (be != 0 - 1) {
            al_goto(c, be, header);
        }
        return after;
    }
    if (s.kind == SK_DOWHILE) {
        // do body while (cond): body first, then test(cond) → body | after. The test is
        // its own state so `continue` re-tests the condition (C semantics).
        al_rewrite(s.expr, &c.vars);
        int bodyE = al_newst(c);
        int test = al_newst(c);
        int after = al_newst(c);
        al_goto(c, cur, bodyE);
        al_push(c, test, al_dispatch2(s.expr, bodyE, after));
        al_enter_loop(c, after, test);
        int be = al_lower_stmt(c, s.s1, bodyE);
        al_leave_loop(c);
        if (be != 0 - 1) {
            al_goto(c, be, test);
        }
        return after;
    }
    if (s.kind == SK_FOR) {
        if (s.s1 != null) {                                                  // init
            if (al_stmt_has_await_deep(s.s1) == 1) {                         // a range bound that awaits
                cur = al_lower_stmt(c, s.s1, cur);
                if (cur == 0 - 1) {
                    return 0 - 1;
                }
            } else {
                al_push(c, cur, al_rewrite_plain(c, s.s1));
            }
        }
        int header = al_newst(c);
        int bodyE = al_newst(c);
        int step = al_newst(c);
        int after = al_newst(c);
        al_goto(c, cur, header);
        if (s.expr != null) {
            al_rewrite(s.expr, &c.vars);
            al_push(c, header, al_dispatch2(s.expr, bodyE, after));
        } else {
            al_goto(c, header, bodyE);
        }
        if (s.expr2 != null) {
            al_rewrite(s.expr2, &c.vars);
            al_push(c, step, al_exprstmt(s.expr2));
        }
        al_goto(c, step, header);
        al_enter_loop(c, after, step);
        int be = al_lower_stmt(c, s.s2, bodyE);
        al_leave_loop(c);
        if (be != 0 - 1) {
            al_goto(c, be, step);
        }
        return after;
    }
    if (s.kind == SK_SWITCH) {
        // Dispatch on the subject in `cur` (if subj==Vk → st=entry[k], else default), then
        // each case is a state with C-style fall-through; break → join.
        al_rewrite(s.expr, &c.vars);
        int nc = List_len<*StmtNode>(&s.items);
        List<int> entry;
        List_init<int>(&entry, nc);
        int k = 0;
        while (k < nc) {
            List_push<int>(&entry, al_newst(c));
            k = k + 1;
        }
        int join = al_newst(c);
        int dflt = join;
        k = 0;
        while (k < nc) {
            if (List_get<*StmtNode>(&s.items, k).expr == null) {
                dflt = List_get<int>(&entry, k);
            }
            k = k + 1;
        }
        // Build the dispatch chain bottom-up: ...else { st = dflt }
        *StmtNode chain = al_assign(al_fr(al_fst), al_int(dflt));
        k = nc - 1;
        while (k >= 0) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k);
            if (cs.expr != null) {
                al_rewrite(cs.expr, &c.vars);
                List<*StmtNode> tb;
                List_init<*StmtNode>(&tb, 1);
                List_push<*StmtNode>(&tb, al_assign(al_fr(al_fst), al_int(List_get<int>(&entry, k))));
                List<*StmtNode> eb;
                List_init<*StmtNode>(&eb, 1);
                List_push<*StmtNode>(&eb, chain);
                chain = al_if(mk_bin("==", s.expr, cs.expr), al_block(&tb), al_block(&eb));
            }
            k = k - 1;
        }
        al_push(c, cur, chain);
        List_push<int>(&c.brk, join);
        List_push<int>(&c.brk_dd, List_len<List<*StmtNode>>(&c.dfr));
        k = 0;
        while (k < nc) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k);
            int e = al_lower_seq(c, &cs.items, List_get<int>(&entry, k));
            if (e != 0 - 1) {                            // fall through to the next case (or join)
                if (k + 1 < nc) {
                    al_goto(c, e, List_get<int>(&entry, k + 1));
                } else {
                    al_goto(c, e, join);
                }
            }
            k = k + 1;
        }
        List_remove<int>(&c.brk, List_len<int>(&c.brk) - 1);
        List_remove<int>(&c.brk_dd, List_len<int>(&c.brk_dd) - 1);
        return join;
    }
    if (s.kind == SK_MATCH) {
        return al_lower_match(c, s, cur);
    }
    if (s.kind == SK_TRY) {
        return al_lower_try(c, s, cur);
    }
    if (s.kind == SK_BLOCK) {
        return al_lower_seq(c, &s.items, cur);
    }
    al_error_at(c, s.line, s.col, "'await' is not supported inside this statement");
    return cur;
}

// An arm label `V(a, b)` → "V" with `binds` = [a, b]; `*paren` = it has a payload list.
string al_arm_split(string lb, List<string>* binds, int* paren) {
    int n = cstr_len(lb);
    int i = 0;
    while (i < n && (int)lb[i] != 40) {
        i = i + 1;
    }
    string v = al_substr(lb, 0, i);
    *paren = 0;
    if (i >= n) {
        return v;
    }
    *paren = 1;
    i = i + 1;
    while (i < n) {
        while (i < n && ((int)lb[i] == 32 || (int)lb[i] == 44)) {
            i = i + 1;
        }
        int st = i;
        while (i < n && (int)lb[i] != 44 && (int)lb[i] != 41 && (int)lb[i] != 32) {
            i = i + 1;
        }
        if (i > st) {
            List_push<string>(binds, al_substr(lb, st, i));
        }
        if (i < n && (int)lb[i] == 41) {
            i = n;
        }
    }
    return v;
}

// `a;b;c` → [a, b, c] (a null or empty string → []).
// The `ch`-separated parts of `s` (none when `s` is empty).
void al_split_ch(string s, int ch, List<string>* out) {
    if (s == null) {
        return;
    }
    int n = cstr_len(s);
    if (n == 0) {
        return;
    }
    int st = 0;
    int i = 0;
    while (i <= n) {
        if (i == n || (int)s[i] == ch) {
            List_push<string>(out, al_substr(s, st, i));
            st = i + 1;
        }
        i = i + 1;
    }
}

void al_split_semi(string s, List<string>* out) {
    al_split_ch(s, 59, out);
}

int al_is_idc(int c) {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
        return 1;
    }
    return 0;
}

// `t` with each subtree spelled `from` (an occurrence not joined to an identifier on
// either side) spelled `to`.
string al_replace_type(string t, string from, string to) {
    int n = cstr_len(t);
    int m = cstr_len(from);
    if (m == 0) {
        return t;
    }
    string out = "";
    int st = 0;
    int i = 0;
    while (i + m <= n) {
        int hit = 1;
        int j = 0;
        while (j < m) {
            if (t[i + j] != from[j]) {
                hit = 0;
                break;
            }
            j = j + 1;
        }
        if (hit == 1 && i > 0 && al_is_idc((int)t[i - 1]) == 1 && al_is_idc((int)from[0]) == 1) {
            hit = 0;
        }
        if (hit == 1 && i + m < n && al_is_idc((int)t[i + m]) == 1 && al_is_idc((int)from[m - 1]) == 1) {
            hit = 0;
        }
        if (hit == 1) {
            out = str_concat(str_concat(out, al_substr(t, st, i)), to);
            i = i + m;
            st = i;
        } else {
            i = i + 1;
        }
    }
    return str_concat(out, al_substr(t, st, n));
}

int al_popcount(int m) {
    int c = 0;
    while (m > 0) {
        c = c + (m & 1);
        m = m >> 1;
    }
    return c;
}

// A type in generic function `c.curfn`, in terms of its type parameters, from its value
// in each checked instance (`recs`, from sema_inst_rec; `part` >= 0 picks that
// ';'-separated part of each record's type): a spelling S that al_subst turns into the
// type of every instance. Candidates put a type parameter in place of each subtree
// spelled as its argument (every subset of the parameters, most first), as the C++
// generalizeType does. "" when none fits.
string al_generalize(*AlCtx c, string recs, int part) {
    List<TypeParam>* tps = &c.curfn.type_params;
    int n = List_len<TypeParam>(tps);
    List<string> lines;
    List_init<string>(&lines, 4);
    al_split_ch(recs, 10, &lines);
    int nr = List_len<string>(&lines);
    if (nr > 0 && cstr_len(List_get<string>(&lines, nr - 1)) == 0) {   // after the last '\n'
        nr = nr - 1;
    }
    if (nr == 0) {
        return "";
    }
    List<List<string>> args;
    List_init<List<string>>(&args, nr);
    List<string> tys;
    List_init<string>(&tys, nr);
    int r = 0;
    while (r < nr) {
        string ln = List_get<string>(&lines, r);
        int f = 0;
        while (ln[f] != 0 && (int)ln[f] != 12) {
            f = f + 1;
        }
        if (ln[f] == 0) {
            return "";
        }
        List<string> as;
        List_init<string>(&as, 2);
        al_split_ch(al_substr(ln, 0, f), 9, &as);
        if (List_len<string>(&as) != n) {
            return "";
        }
        string t = al_substr(ln, f + 1, cstr_len(ln));
        if (part >= 0) {
            List<string> ps;
            List_init<string>(&ps, 2);
            al_split_semi(t, &ps);
            if (part >= List_len<string>(&ps)) {
                return "";
            }
            t = List_get<string>(&ps, part);
        }
        if (t[0] == 0 || str_eq(t, "unknown") == 1 || str_eq(t, "null") == 1 || str_eq(t, "void") == 1) {
            return "";
        }
        List_push<List<string>>(&args, as);
        List_push<string>(&tys, t);
        r = r + 1;
    }
    List<string> a0 = List_get<List<string>>(&args, 0);
    int pc = n;
    while (pc >= 0) {
        int m = 0;
        while (m < (1 << n)) {
            if (al_popcount(m) == pc) {
                string cand = List_get<string>(&tys, 0);
                int i = 0;
                while (i < n) {
                    if (((m >> i) & 1) == 1) {
                        cand = al_replace_type(cand, List_get<string>(&a0, i), List_get<TypeParam>(tps, i).name);
                    }
                    i = i + 1;
                }
                int ok = 1;
                r = 0;
                while (r < nr) {
                    List<string> ar = List_get<List<string>>(&args, r);
                    if (str_eq(al_subst(cand, tps, &ar), List_get<string>(&tys, r)) == 0) {
                        ok = 0;
                        break;
                    }
                    r = r + 1;
                }
                if (ok == 1) {
                    return cand;
                }
            }
            m = m + 1;
        }
        pc = pc - 1;
    }
    return "";
}

// A catch label `Type name` → its type / its variable (`_`, a catch-all: "" / "").
string al_catch_type(string lb) {
    if (str_eq(lb, "_") == 1) {
        return "";
    }
    int n = cstr_len(lb);
    int i = n;
    while (i > 0 && (int)lb[i - 1] != 32) {
        i = i - 1;
    }
    if (i == 0) {
        return lb;
    }
    return al_substr(lb, 0, i - 1);
}

string al_catch_var(string lb) {
    int n = cstr_len(lb);
    int i = n;
    while (i > 0 && (int)lb[i - 1] != 32) {
        i = i - 1;
    }
    if (i == 0) {
        return "";
    }
    return al_substr(lb, i, n);
}

void al_add_var(*AlCtx c, string nm, string ty) {
    if (al_in(&c.vars, nm) == 1) {
        return;
    }
    List_push<string>(&c.vars, nm);
    let f: Param;
    f.name = nm;
    f.ty = ty;
    List_push<Param>(&c.fields, f);
}

// The payload types of variant `v` when sema did not stamp a match arm's bindings (the
// codegen-only driver): the enum that declares `v`, its type parameters bound from the
// subject's type.
void al_variant_types(*AlCtx c, *ExprNode subj, string v, List<string>* out) {
    int i = 0;
    while (i < List_len<*DeclNode>(&c.prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&c.prog.decls, i);
        i = i + 1;
        if (d.kind != DK_ENUM) {
            continue;
        }
        int vi = 0 - 1;
        int j = 0;
        while (j < List_len<Param>(&d.params)) {
            if (str_eq(List_get<Param>(&d.params, j).name, v) == 1) {
                vi = j;
            }
            j = j + 1;
        }
        if (vi < 0 || vi >= List_len<List<string>>(&d.payloads)) {
            continue;
        }
        List<string> targs;
        List_init<string>(&targs, 2);
        if (List_len<TypeParam>(&d.type_params) > 0) {
            ast_targs(al_deref(al_expr_type(c.prog, c.curfn, subj)), &targs);
            if (List_len<string>(&targs) != List_len<TypeParam>(&d.type_params)) {
                return;
            }
        }
        List<string> pl = List_get<List<string>>(&d.payloads, vi);
        int k = 0;
        while (k < List_len<string>(&pl)) {
            List_push<string>(out, al_subst(List_get<string>(&pl, k), &d.type_params, &targs));
            k = k + 1;
        }
        return;
    }
}

// A match with an await: dispatch on the subject in `cur`; each arm copies its payload
// bindings to frame fields and selects its entry state; the arms join after.
int al_lower_match(*AlCtx c, *StmtNode m, int cur) {
    al_rewrite(m.expr, &c.vars);
    int n = List_len<*StmtNode>(&m.items);
    List<int> entry;
    List_init<int>(&entry, n + 1);
    int k = 0;
    while (k < n) {
        List_push<int>(&entry, al_newst(c));
        k = k + 1;
    }
    int join = al_newst(c);
    *StmtNode disp = ast_new_stmt();
    disp.kind = SK_MATCH;
    disp.expr = m.expr;
    disp.line = m.line;
    disp.col = m.col;
    List_init<*StmtNode>(&disp.items, n + 1);
    int generic = 0;
    if (List_len<TypeParam>(&c.curfn.type_params) > 0) {
        generic = 1;
    }
    k = 0;
    while (k < n) {
        *StmtNode arm = List_get<*StmtNode>(&m.items, k);
        List<string> binds;
        List_init<string>(&binds, 2);
        int paren = 0;
        string v = al_arm_split(arm.name, &binds, &paren);
        List<string> tys;
        List_init<string>(&tys, 2);
        string ats = arm.arm_types;
        if (generic == 1) {               // in terms of the type parameters
            ats = null;
            int b = 0;
            while (b < List_len<string>(&binds)) {
                string t = al_generalize(c, arm.arm_inst, b);
                if (t[0] == 0) {
                    break;
                }
                List_push<string>(&tys, t);
                if (b == 0) {
                    ats = t;
                } else {
                    ats = str_concat(str_concat(ats, ";"), t);
                }
                b = b + 1;
            }
        } else {
            al_split_semi(ats, &tys);
        }
        if (arm.arm_types == null && generic == 0) {   // not stamped
            al_variant_types(c, m.expr, v, &tys);
        }
        if (List_len<string>(&binds) > 0 && List_len<string>(&tys) != List_len<string>(&binds)) {
            *ExprNode fa = al_any_await_s(m);
            int fl = m.line;
            int fc = m.col;
            if (fa != null) {
                fl = fa.line;
                fc = fa.col;
            }
            al_error_at(c, fl, fc, "'await' in a 'match' arm that binds a payload is not supported in a generic async function");
        }
        List<*StmtNode> bi;
        List_init<*StmtNode>(&bi, 4);
        string lb = v;
        if (paren == 1) {
            lb = str_concat(lb, "(");
        }
        int b = 0;
        while (b < List_len<string>(&binds)) {
            string bn = List_get<string>(&binds, b);
            string nb = bn;
            if (str_eq(bn, "_") == 0) {
                al_add_var(c, bn, List_get<string>(&tys, b));
                nb = fresh_name("__mb", c.used);
                List_push<*StmtNode>(&bi, al_assign(al_fr(bn), mk_ident(nb)));
            }
            if (b > 0) {
                lb = str_concat(lb, ", ");
            }
            lb = str_concat(lb, nb);
            b = b + 1;
        }
        if (paren == 1) {
            lb = str_concat(lb, ")");
        }
        List_push<*StmtNode>(&bi, al_assign(al_fr(al_fst), al_int(List_get<int>(&entry, k))));
        *StmtNode na = ast_new_stmt();
        na.kind = SK_ARM;
        na.name = lb;
        na.s1 = al_block(&bi);
        na.arm_types = ats;
        na.line = arm.line;
        na.col = arm.col;
        List_push<*StmtNode>(&disp.items, na);
        k = k + 1;
    }
    al_goto(c, cur, join);                     // a value no arm names (a classic enum)
    al_push(c, cur, disp);
    k = 0;
    while (k < n) {
        *StmtNode arm = List_get<*StmtNode>(&m.items, k);
        int e = List_get<int>(&entry, k);
        if (arm.s1 != null) {
            e = al_lower_stmt(c, arm.s1, e);
        }
        if (e != 0 - 1) {
            al_goto(c, e, join);
        }
        k = k + 1;
    }
    return join;
}

// Rewrite the `exception_text()` calls of a split catch clause's body (nested lambdas
// and nested catch clauses excluded: they have their own) to the frame field `*tf`,
// made on first use; the synthetic handler fills it before leaving the landingpad.
void al_extext_e(*AlCtx c, *ExprNode e, string* tf) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_IDENT && str_eq(e.a.sval, "exception_text") == 1
        && List_len<*ExprNode>(&e.kids) == 0) {
        string cur = *tf;
        if (cur[0] == 0) {
            cur = fresh_name("__extxt", c.used);
            al_add_var(c, cur, "char[512]");   // the handler's buffer is gone at a suspension
            *tf = cur;
        }
        // (string)&field[0]: the frame's copy of the text.
        e.kind = EK_CAST;
        e.sval = "string";
        e.a = mk_un("&", al_index(mk_ident(cur), al_int(0)));
        List_init<*ExprNode>(&e.kids, 1);
        return;
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        al_extext_e(c, List_get<*ExprNode>(&ch, i), tf);
        i = i + 1;
    }
}

void al_extext_s(*AlCtx c, *StmtNode s, string* tf) {
    if (s == null) {
        return;
    }
    al_extext_e(c, s.expr, tf);
    al_extext_e(c, s.expr2, tf);
    al_extext_s(c, s.s1, tf);
    al_extext_s(c, s.s2, tf);
    if (s.kind == SK_TRY) {          // its catch clauses have their own exception
        return;
    }
    int i = 0;
    while (i < List_len<*StmtNode>(&s.items)) {
        al_extext_s(c, List_get<*StmtNode>(&s.items, i), tf);
        i = i + 1;
    }
}

// A try split into states: its body's states form one region and its handlers' another;
// the finally is a defer frame run on every exit, outside both (mirrors the C++).
int al_lower_try(*AlCtx c, *StmtNode t, int cur) {
    if (t.s2 != null && (al_loop_escapes(t.s2) == 1 || al_has_return(t.s2) == 1)) {
        al_error_at(c, t.line, t.col, "a 'finally' that leaves by 'break'/'continue' is not supported in an async function");
    }
    *StmtNode fin = null;
    if (t.s2 != null) {
        if (al_stmt_has_await_deep(t.s2) == 1) {
            fin = t.s2;
        } else {
            fin = al_rewrite_plain(c, t.s2);
        }
    }
    int after = al_newst(c);
    int start = List_len<List<*StmtNode>>(&c.dfr);
    if (fin != null) {
        List<*StmtNode> ff;
        List_init<*StmtNode>(&ff, 1);
        List_push<*StmtNode>(&ff, fin);
        List_push<List<*StmtNode>>(&c.dfr, ff);
    }
    int parent = c.cur_region;
    int base = List_len<List<*StmtNode>>(&c.dfr);
    int rb = List_len<int>(&c.rg_parent);
    List_push<int>(&c.rg_parent, parent);
    List_push<int>(&c.rg_start, start);
    List_push<int>(&c.rg_base, base);
    List_push<*StmtNode>(&c.rg_fin, fin);
    int rh = List_len<int>(&c.rg_parent);
    List_push<int>(&c.rg_parent, parent);
    List_push<int>(&c.rg_start, start);
    List_push<int>(&c.rg_base, base);
    List_push<*StmtNode>(&c.rg_fin, fin);
    c.cur_region = rh;
    int nc = List_len<*StmtNode>(&t.items);
    List<int> centry;
    List_init<int>(&centry, nc + 1);
    int k = 0;
    while (k < nc) {
        *StmtNode cl = List_get<*StmtNode>(&t.items, k);
        string ctype = al_catch_type(cl.name);
        string cvar = al_catch_var(cl.name);
        if (cvar[0] != 0) {
            al_add_var(c, cvar, ctype);
        }
        string tf = "";
        al_extext_s(c, cl.s1, &tf);
        int e = al_newst(c);
        List_push<int>(&centry, e);
        List_push<int>(&c.ci_region, rb);
        List_push<string>(&c.ci_type, ctype);
        List_push<string>(&c.ci_var, cvar);
        List_push<string>(&c.ci_txt, tf);
        List_push<int>(&c.ci_state, e);
        k = k + 1;
    }
    c.cur_region = rb;
    int bodyE = al_newst(c);
    al_goto(c, cur, bodyE);
    int reach = 0;
    int be = bodyE;
    if (t.s1 != null) {
        be = al_lower_stmt(c, t.s1, bodyE);
    }
    if (be != 0 - 1) {
        al_emit_exit(c, be, start, after, 0);
        reach = 1;
    }
    c.cur_region = rh;
    k = 0;
    while (k < nc) {
        *StmtNode cl = List_get<*StmtNode>(&t.items, k);
        int ce = List_get<int>(&centry, k);
        if (cl.s1 != null) {
            ce = al_lower_stmt(c, cl.s1, ce);
        }
        if (ce != 0 - 1) {
            al_emit_exit(c, ce, start, after, 0);
            reach = 1;
        }
        k = k + 1;
    }
    c.cur_region = parent;
    if (fin != null) {
        List_remove<List<*StmtNode>>(&c.dfr, List_len<List<*StmtNode>>(&c.dfr) - 1);
    }
    if (reach == 1) {
        return after;
    }
    return 0 - 1;
}

// A frame field of the captured exception of region `r` (made on first use).
string al_exc_field(*AlCtx c, int r) {
    int i = 0;
    while (i < List_len<int>(&c.exc_reg)) {
        if (List_get<int>(&c.exc_reg, i) == r) {
            return List_get<string>(&c.exc_name, i);
        }
        i = i + 1;
    }
    string f = fresh_name(str_concat("__exc", int_to_str(r)), c.used);
    let p: Param;
    p.name = f;
    p.ty = "*uint8";
    List_push<Param>(&c.fields, p);
    List_push<int>(&c.exc_reg, r);
    List_push<string>(&c.exc_name, f);
    return f;
}

// `if (fr.f != null) { __cxa_free_exception((*void)fr.f); fr.f = null; }`
*StmtNode al_free_exc(string f) {
    List<*ExprNode> a;
    List_init<*ExprNode>(&a, 1);
    List_push<*ExprNode>(&a, mk_cast("*void", al_fr(f)));
    List<*StmtNode> b;
    List_init<*StmtNode>(&b, 2);
    List_push<*StmtNode>(&b, al_exprstmt(al_call("__cxa_free_exception", &a)));
    List_push<*StmtNode>(&b, al_assign(al_fr(f), mk_cast("*uint8", al_int(0))));
    return al_if(mk_bin("!=", al_fr(f), mk_cast("*uint8", al_int(0))), al_block(&b), null);
}

// Lower the cleanups of `frames` (the first `top`) above `downTo` from a new state of
// `region` whose pending frames are the first `depth`: the entry in *s0, the continuation
// in *e (-1: never), a state whose pending frames are the first `downTo`, so the cleanups
// that ran are no longer pending there.
void al_cleanup_states(*AlCtx c, List<List<*StmtNode>>* frames, int top, int region, int depth, int downTo, int* s0, int* e) {
    List<List<*StmtNode>> saved = c.dfr;
    int sreg = c.cur_region;
    List<List<*StmtNode>> cp;
    al_frames_copy(&cp, frames, top, 0 - 1);
    c.dfr = cp;
    c.cur_region = region;
    *s0 = al_newst_in(c, region, depth);
    *e = al_run_frames(c, *s0, downTo);
    if (*e != 0 - 1) {
        int z = al_newst_in(c, List_get<int>(&c.st_region, *e), downTo);
        al_goto(c, *e, z);
        *e = z;
    }
    c.dfr = saved;
    c.cur_region = sreg;
}

// Each state of a split try runs inside its regions' handlers, innermost first:
//   try { <state> } catch (T x) { <pending defers>; fr.e = x; fr.st = <handler>; }
//   <finally, on unwinding only> { <pending defers>; <the try's finally> }
// A handler first runs the defers pending in that state inside the region, as an
// exception leaving a block does. When those cleanups await, a typed handler jumps to
// states that run them before the handler, and the unwinding path captures the exception
// (a catch-all keeping a copy, SK_CATCH is_err = 1), runs the cleanups in states of the
// enclosing region, then throws the copy again (SK_THROW is_err = 1). Mirrors the C++.
void al_wrap_state(*AlCtx c, int si, string cx) {
    int r = List_get<int>(&c.st_region, si);
    if (r == 0 - 1) {
        return;
    }
    int saved_cancel = c.cancel;
    c.cancel = List_get<int>(&c.st_cancel, si);
    AlSnap snap = List_get<AlSnap>(&c.st_snap, si);
    List<List<*StmtNode>> frames;
    al_snap_frames(&frames, &snap);
    int top = List_len<List<*StmtNode>>(&frames);
    List<*StmtNode> body = List_get<List<*StmtNode>>(&c.states, si);
    *StmtNode x = al_block(&body);
    while (r != 0 - 1) {
        int rbase = List_get<int>(&c.rg_base, r);
        int rstart = List_get<int>(&c.rg_start, r);
        int rpar = List_get<int>(&c.rg_parent, r);
        int pend_aw = al_frames_await(&frames, rbase, top);
        List<*StmtNode> pend;
        List_init<*StmtNode>(&pend, 4);
        if (pend_aw == 0) {
            int f = top - 1;
            while (f >= rbase) {
                List<*StmtNode> fr = List_get<List<*StmtNode>>(&frames, f);
                int q = List_len<*StmtNode>(&fr) - 1;
                while (q >= 0) {
                    List_push<*StmtNode>(&pend, List_get<*StmtNode>(&fr, q));
                    q = q - 1;
                }
                f = f - 1;
            }
        }
        List<*StmtNode> cs;
        List_init<*StmtNode>(&cs, 2);
        int ci = 0;
        while (ci < List_len<int>(&c.ci_region)) {
            if (List_get<int>(&c.ci_region, ci) == r) {
                List<*StmtNode> hb;
                List_init<*StmtNode>(&hb, 4);
                int pi = 0;
                while (pi < List_len<*StmtNode>(&pend)) {
                    List_push<*StmtNode>(&hb, List_get<*StmtNode>(&pend, pi));
                    pi = pi + 1;
                }
                string cvar = List_get<string>(&c.ci_var, ci);
                if (cvar[0] != 0) {
                    List_push<*StmtNode>(&hb, al_assign(al_fr(cvar), mk_ident(cx)));
                }
                string ctxt = List_get<string>(&c.ci_txt, ci);
                if (ctxt[0] != 0) {
                    List<*ExprNode> into;
                    List_init<*ExprNode>(&into, 1);
                    List_push<*ExprNode>(&into, mk_un("&", al_index(al_fr(ctxt), al_int(0))));
                    List_push<*StmtNode>(&hb, al_exprstmt(al_call("__exception_text_into", &into)));
                }
                int target = List_get<int>(&c.ci_state, ci);
                if (pend_aw == 1) {
                    int s0 = 0;
                    int e = 0;
                    al_cleanup_states(c, &frames, top, List_get<int>(&c.st_region, target), rbase, rbase, &s0, &e);
                    if (e != 0 - 1) {
                        al_goto(c, e, target);
                    }
                    target = s0;
                }
                List_push<*StmtNode>(&hb, al_assign(al_fr(al_fst), al_int(target)));
                *StmtNode cn = ast_new_stmt();
                cn.kind = SK_CATCH;
                string cty = List_get<string>(&c.ci_type, ci);
                if (cty[0] == 0) {
                    cn.name = "_";
                } else {
                    cn.name = str_concat(cty, str_concat(" ", cx));
                }
                cn.s1 = al_block(&hb);
                List_push<*StmtNode>(&cs, cn);
            }
            ci = ci + 1;
        }
        List<*StmtNode> ub;
        List_init<*StmtNode>(&ub, 4);
        if (al_frames_await(&frames, rstart, top) == 1) {
            string ef = al_exc_field(c, r);
            int s0 = 0;
            int e = 0;
            al_cleanup_states(c, &frames, top, rpar, rstart, rstart, &s0, &e);
            if (e != 0 - 1) {
                // { *uint8 t = fr.ef; fr.ef = null; <throw t again>; }
                string tn = fresh_name("__rx", c.used);
                List<*StmtNode> rb;
                List_init<*StmtNode>(&rb, 3);
                List_push<*StmtNode>(&rb, mk_vardecl(tn, "*uint8", al_fr(ef), 0));
                List_push<*StmtNode>(&rb, al_assign(al_fr(ef), mk_cast("*uint8", al_int(0))));
                *StmtNode th = ast_new_stmt();
                th.kind = SK_THROW;
                th.expr = mk_ident(tn);
                th.is_err = 1;
                List_push<*StmtNode>(&rb, th);
                al_push(c, e, al_block(&rb));
            }
            List<*StmtNode> kb;
            List_init<*StmtNode>(&kb, 3);
            List_push<*StmtNode>(&kb, al_free_exc(ef));
            List_push<*StmtNode>(&kb, al_assign(al_fr(ef), mk_ident(cx)));
            List_push<*StmtNode>(&kb, al_assign(al_fr(al_fst), al_int(s0)));
            *StmtNode kn = ast_new_stmt();
            kn.kind = SK_CATCH;
            kn.name = str_concat("*uint8 ", cx);
            kn.is_err = 1;
            kn.s1 = al_block(&kb);
            List_push<*StmtNode>(&cs, kn);
        } else {
            int pj = 0;
            while (pj < List_len<*StmtNode>(&pend)) {
                List_push<*StmtNode>(&ub, List_get<*StmtNode>(&pend, pj));
                pj = pj + 1;
            }
            *StmtNode rfin = List_get<*StmtNode>(&c.rg_fin, r);
            if (rfin != null) {
                List_push<*StmtNode>(&ub, rfin);
            }
        }
        if (List_len<*StmtNode>(&cs) > 0 || List_len<*StmtNode>(&ub) > 0) {
            *StmtNode tr = ast_new_stmt();
            tr.kind = SK_TRY;
            tr.s1 = x;
            tr.is_err = 1;
            List_init<*StmtNode>(&tr.items, 2);
            int ck = 0;
            while (ck < List_len<*StmtNode>(&cs)) {
                List_push<*StmtNode>(&tr.items, List_get<*StmtNode>(&cs, ck));
                ck = ck + 1;
            }
            if (List_len<*StmtNode>(&ub) > 0) {
                tr.s2 = al_block(&ub);
            }
            x = tr;
        }
        top = rstart;
        r = rpar;
    }
    List<*StmtNode> one;
    List_init<*StmtNode>(&one, 1);
    List_push<*StmtNode>(&one, x);
    List_set<List<*StmtNode>>(&c.states, si, one);
    c.cancel = saved_cancel;
}

// Cancellation: dropped while parked at an await, the future runs the defers and finally
// blocks pending there once, from states of their own (the on_drop closure resumes into
// them). A cleanup that awaits runs detached: on_drop marks the frame DETACHED (4), so
// Future_drop leaves the frame alone, and the last cleanup state frees it (or, when it ends
// inside Future_drop, lets that free it).
void al_build_drop(*AlCtx c, int i) {
    AlSnap snap = List_get<AlSnap>(&c.ds_snap, i);
    List<List<*StmtNode>> frames;
    al_snap_frames(&frames, &snap);
    List<List<*StmtNode>> saved = c.dfr;
    int sreg = c.cur_region;
    int scancel = c.cancel;
    c.dfr = frames;
    c.cur_region = 0 - 1;
    c.cancel = 1;
    int det = al_frames_await(&frames, 0, List_len<List<*StmtNode>>(&frames));
    int d = al_newst_in(c, 0 - 1, 0);
    int e = al_run_frames(c, d, 0);
    if (e != 0 - 1) {
        al_push(c, e, al_exc_free);
        if (det == 1) {
            // if (atomic_cas(&fr.ret.state, 4, 6)) return;  free((*void)fr); return;
            List<*ExprNode> ca;
            List_init<*ExprNode>(&ca, 3);
            List_push<*ExprNode>(&ca, mk_un("&", al_member(al_fr(al_fret), "state")));
            List_push<*ExprNode>(&ca, al_int(4));
            List_push<*ExprNode>(&ca, al_int(6));
            List<*StmtNode> rb;
            List_init<*StmtNode>(&rb, 1);
            List_push<*StmtNode>(&rb, al_return(null));
            al_push(c, e, al_if(al_call("atomic_cas", &ca), al_block(&rb), null));
            List<*ExprNode> fa;
            List_init<*ExprNode>(&fa, 1);
            List_push<*ExprNode>(&fa, mk_cast("*void", mk_ident(al_frp)));
            al_push(c, e, al_exprstmt(al_call("free", &fa)));
        }
        al_push(c, e, al_return(null));
    }
    c.dfr = saved;
    c.cur_region = sreg;
    c.cancel = scancel;
    List_push<int>(&c.drop_from, List_get<int>(&c.ds_state, i));
    List_push<int>(&c.drop_to, d);
    List_push<int>(&c.drop_det, det);
}

// The first await not placed as the whole initializer of a let (a defer body excluded).
*ExprNode al_unplaced_await(*StmtNode s) {
    if (s == null) {
        return null;
    }
    *ExprNode a = null;
    if (s.kind == SK_VARDECL) {
        if (s.expr != null && s.expr.kind == EK_AWAIT) {
            return al_first_await_e(s.expr.a);
        }
        return al_first_await_e(s.expr);
    }
    a = al_first_await_e(s.expr);
    if (a != null) {
        return a;
    }
    a = al_first_await_e(s.expr2);
    if (a != null) {
        return a;
    }
    a = al_unplaced_await(s.s1);
    if (a != null) {
        return a;
    }
    a = al_unplaced_await(s.s2);
    if (a != null) {
        return a;
    }
    int i = 0;
    while (i < List_len<*StmtNode>(&s.items)) {
        a = al_unplaced_await(List_get<*StmtNode>(&s.items, i));
        if (a != null) {
            return a;
        }
        i = i + 1;
    }
    return null;
}

// ── Desugar: hoist every await into a `let` of its own, in evaluation order ──────
//   return await E;       →  let __aw_tN = await E; return __aw_tN;
//   x += g() + await E;   →  let __sp_tN = g(); let __aw_tN = await E; x += __sp_tN + __aw_tN;
// An operand evaluated before an await in the same expression is held in a temporary
// first when it has a side effect, so effects keep the order of the synchronous
// expression; an assignment target's parts (an index, a pointer) are evaluated once,
// before the await. `&&`/`||` and `?:` become ifs, so an await in a conditional operand
// runs only when that operand is evaluated. A loop condition or step that awaits is
// re-evaluated at the top of each pass. Recurses into control flow (mirrors the C++).
void al_error_at(*AlCtx c, int line, int col, string msg) {
    string ff = c.curfn.file;
    if (ff == null) {
        ff = "";
    }
    int ln = line;
    int cl = col;
    if (ln == 0) {
        ln = c.curfn.line;
        cl = c.curfn.col;
    }
    dprintf(2, "error: %s:%d:%d: async function '%s': %s\n", ff, ln, cl, c.errname, msg);
    exit(1);
}

string al_fresh(*AlCtx c, string base) {
    string n = fresh_name(str_concat(base, int_to_str(c.tmpn)), c.used);
    c.tmpn = c.tmpn + 1;
    return n;
}

int al_is_assign_op(string op) {
    if (str_eq(op, "=") == 1) {
        return 1;
    }
    int n = cstr_len(op);
    if (n < 2 || (int)op[n - 1] != 61) {
        return 0;
    }
    if (str_eq(op, "==") == 1 || str_eq(op, "!=") == 1 || str_eq(op, "<=") == 1 || str_eq(op, ">=") == 1) {
        return 0;
    }
    return 1;
}

int al_has_opfn(*ExprNode e) {
    if (e.op_fn != null && e.op_fn[0] != 0) {
        return 1;
    }
    return 0;
}

// Whether evaluating `e` may have a side effect: a call (a user operator counts), an
// assignment, `++`/`--`, an await, `?`, `alloc_with`, `thread_create` or `free_closure`.
int al_has_side(*ExprNode e) {
    if (e == null) {
        return 0;
    }
    int k = e.kind;
    if (k == EK_LAMBDA || k == EK_SIZEOF) {
        return 0;
    }
    if (k == EK_CALL || k == EK_TEMPLATECALL || k == EK_AWAIT || k == EK_INCDEC || k == EK_QUESTION
        || k == EK_ALLOCWITH || k == EK_THREADCREATE || k == EK_FREECLOSURE) {
        return 1;
    }
    if (k == EK_BINARY && (al_is_assign_op(e.sval) == 1 || al_has_opfn(e) == 1)) {
        return 1;
    }
    if ((k == EK_UNARY || k == EK_INDEX) && al_has_opfn(e) == 1) {
        return 1;
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        if (al_has_side(List_get<*ExprNode>(&ch, i)) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// The type sema inferred for `e` ("" when unknown, and inside a generic function, whose
// instances differ; mirrors the C++).
string al_type_of(*AlCtx c, *ExprNode e) {
    if (List_len<TypeParam>(&c.curfn.type_params) > 0) {
        return al_generalize(c, e.ainst, 0 - 1);
    }
    string t = e.aty;
    if (t == null || t[0] == 0) {   // not stamped (the codegen-only driver)
        t = al_expr_type(c.prog, c.curfn, e);
    }
    if (t == null || t[0] == 0 || str_eq(t, "unknown") == 1 || str_eq(t, "null") == 1 || str_eq(t, "void") == 1) {
        return "";
    }
    return t;
}

*ExprNode al_hoist(*AlCtx c, *ExprNode e, List<*StmtNode>* pre);
*ExprNode al_spill(*AlCtx c, *ExprNode e, List<*StmtNode>* pre) {
    string t = al_type_of(c, e);
    if (t[0] == 0) {
        al_error_at(c, e.line, e.col, "an operand with a side effect is evaluated before an 'await' in the same expression and its type is not known here; bind it to a local first");
    }
    string tn = al_fresh(c, "__sp_t");
    List_push<*StmtNode>(pre, mk_vardecl(tn, t, e, 0));
    return mk_ident(tn);
}

*ExprNode al_rval(*AlCtx c, *ExprNode e, List<*StmtNode>* pre) {
    if (al_expr_has_await(e) == 1) {
        return al_hoist(c, e, pre);
    }
    if (al_has_side(e) == 1) {
        return al_spill(c, e, pre);
    }
    return e;
}

int al_place_shaped(*ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_IDENT || e.kind == EK_MEMBER || e.kind == EK_INDEX) {
        return 1;
    }
    if (e.kind == EK_UNARY && str_eq(e.sval, "*") == 1) {
        return 1;
    }
    return 0;
}

*ExprNode al_place_sub(*AlCtx c, *ExprNode x, List<*StmtNode>* pre, int spill) {
    if (al_expr_has_await(x) == 1) {
        return al_hoist(c, x, pre);
    }
    if (spill == 1 && al_has_side(x) == 1) {
        return al_spill(c, x, pre);
    }
    return x;
}

// An assignment target keeps its place; the sub-expressions that compute it are hoisted,
// or held when a later await follows (`spill`).
void al_place(*AlCtx c, *ExprNode e, List<*StmtNode>* pre, int spill) {
    if (e == null || e.kind == EK_IDENT) {
        return;
    }
    if (e.kind == EK_MEMBER) {
        if (al_place_shaped(e.a) == 1) {
            al_place(c, e.a, pre, spill);
        } else {
            e.a = al_place_sub(c, e.a, pre, spill);
        }
        return;
    }
    if (e.kind == EK_INDEX && al_has_opfn(e) == 0 && List_len<*ExprNode>(&e.kids) == 0) {
        if (al_place_shaped(e.a) == 1) {
            al_place(c, e.a, pre, spill);
        } else {
            e.a = al_place_sub(c, e.a, pre, spill);
        }
        e.b = al_place_sub(c, e.b, pre, spill);
        return;
    }
    if (e.kind == EK_UNARY && str_eq(e.sval, "*") == 1 && al_has_opfn(e) == 0) {
        e.a = al_place_sub(c, e.a, pre, spill);
        return;
    }
    if (al_expr_has_await(e) == 1 || (spill == 1 && al_has_side(e) == 1)) {
        al_error_at(c, e.line, e.col, "'await' is not supported with this assignment target; bind the value to a local first");
    }
}

*StmtNode al_set_true(string tn) {
    List<*StmtNode> b;
    List_init<*StmtNode>(&b, 1);
    List_push<*StmtNode>(&b, al_assign(mk_ident(tn), mk_lit(LIT_BOOL, "true")));
    return al_block(&b);
}

// The value type of `await E`, as the let that holds it is declared.
string al_hoist_await_type(*AlCtx c, *ExprNode aw) {
    string ti = al_await_type_or(c.prog, c.curfn, aw.a);
    if (ti[0] == 0 && aw.aty != null) {
        ti = aw.aty;
    }
    if (ti[0] == 0) {
        ti = "int";
    }
    return ti;
}

// Operand slots of `e` in evaluation order: -1 = e.a, -2 = e.b, -3 = e.a.a (a method
// call's receiver), k >= 0 = e.kids[k].
void al_slots(*ExprNode e, List<int>* out) {
    int k = e.kind;
    if (k == EK_CALL) {
        if (e.a != null && e.a.kind == EK_MEMBER) {
            List_push<int>(out, 0 - 3);
        }
        else if (e.a != null && e.a.kind != EK_IDENT) {
            List_push<int>(out, 0 - 1);
        }
    } else if (k == EK_BINARY || k == EK_INDEX || k == EK_TERNARY || k == EK_ALLOCWITH) {
        List_push<int>(out, 0 - 1);
        List_push<int>(out, 0 - 2);
    } else if (k == EK_UNARY || k == EK_INCDEC || k == EK_MEMBER || k == EK_CAST || k == EK_QUESTION
               || k == EK_AWAIT || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        List_push<int>(out, 0 - 1);
    }
    if (k == EK_CALL || k == EK_TEMPLATECALL || k == EK_STRUCTINIT || k == EK_ARRAYLIT
        || k == EK_INDEX || k == EK_TERNARY) {
        int i = 0;
        while (i < List_len<*ExprNode>(&e.kids)) {
            List_push<int>(out, i);
            i = i + 1;
        }
    }
}

*ExprNode al_slot_get(*ExprNode e, int sl) {
    if (sl == 0 - 1) {
        return e.a;
    }
    if (sl == 0 - 2) {
        return e.b;
    }
    if (sl == 0 - 3) {
        return e.a.a;
    }
    return List_get<*ExprNode>(&e.kids, sl);
}

void al_slot_set(*ExprNode e, int sl, *ExprNode v) {
    if (sl == 0 - 1) {
        e.a = v;
        return;
    }
    if (sl == 0 - 2) {
        e.b = v;
        return;
    }
    if (sl == 0 - 3) {
        e.a.a = v;
        return;
    }
    List_set<*ExprNode>(&e.kids, sl, v);
}

*ExprNode al_hoist(*AlCtx c, *ExprNode e, List<*StmtNode>* pre) {
    if (e == null) {
        return e;
    }
    int k = e.kind;
    if (k == EK_AWAIT) {
        string ti = al_hoist_await_type(c, e);
        e.aty = ti;
        if (al_expr_has_await(e.a) == 1) {
            e.a = al_hoist(c, e.a, pre);
        }
        string tn = al_fresh(c, "__aw_t");
        List_push<*StmtNode>(pre, mk_vardecl(tn, ti, e, 0));
        return mk_ident(tn);
    }
    if (k == EK_LAMBDA || k == EK_SIZEOF) {       // not evaluated here
        return e;
    }
    if (k == EK_BINARY) {
        if ((str_eq(e.sval, "&&") == 1 || str_eq(e.sval, "||") == 1) && al_expr_has_await(e.b) == 1) {
            if (al_expr_has_await(e.a) == 1) {
                e.a = al_hoist(c, e.a, pre);
            }
            string tn = al_fresh(c, "__sc_t");
            List_push<*StmtNode>(pre, mk_vardecl(tn, "bool", mk_lit(LIT_BOOL, "false"), 0));
            List<*StmtNode> rp;
            List_init<*StmtNode>(&rp, 4);
            *ExprNode r = al_hoist(c, e.b, &rp);
            List_push<*StmtNode>(&rp, al_if(r, al_set_true(tn), null));
            if (str_eq(e.sval, "&&") == 1) {
                List_push<*StmtNode>(pre, al_if(e.a, al_block(&rp), null));
            }
            else {
                List_push<*StmtNode>(pre, al_if(e.a, al_set_true(tn), al_block(&rp)));
            }
            return mk_ident(tn);
        }
        if (al_is_assign_op(e.sval) == 1) {
            int raw = al_expr_has_await(e.b);
            al_place(c, e.a, pre, raw);
            if (raw == 1) {
                e.b = al_hoist(c, e.b, pre);
            }
            return e;
        }
    }
    if (k == EK_TERNARY && (al_expr_has_await(e.b) == 1 || al_expr_has_await(List_get<*ExprNode>(&e.kids, 0)) == 1)) {
        string t = al_type_of(c, e);
        if (t[0] == 0) {
            al_error_at(c, e.line, e.col, "an 'await' in a '?:' arm needs the expression's type, which is not known here; use an 'if' statement");
        }
        if (al_expr_has_await(e.a) == 1) {
            e.a = al_hoist(c, e.a, pre);
        }
        string tn = al_fresh(c, "__tn_t");
        List_push<*StmtNode>(pre, mk_vardecl(tn, t, null, 0));
        List<*StmtNode> tp;
        List_init<*StmtNode>(&tp, 4);
        *ExprNode ta = e.b;
        if (al_expr_has_await(ta) == 1) {
            ta = al_hoist(c, ta, &tp);
        }
        List_push<*StmtNode>(&tp, al_assign(mk_ident(tn), ta));
        List<*StmtNode> ep;
        List_init<*StmtNode>(&ep, 4);
        *ExprNode ea = List_get<*ExprNode>(&e.kids, 0);
        if (al_expr_has_await(ea) == 1) {
            ea = al_hoist(c, ea, &ep);
        }
        List_push<*StmtNode>(&ep, al_assign(mk_ident(tn), ea));
        List_push<*StmtNode>(pre, al_if(e.a, al_block(&tp), al_block(&ep)));
        return mk_ident(tn);
    }
    if (k == EK_INCDEC) {
        al_place(c, e.a, pre, 0);
        return e;
    }
    if (k == EK_UNARY && str_eq(e.sval, "&") == 1 && al_has_opfn(e) == 0) {
        al_place(c, e.a, pre, 0);
        return e;
    }
    // Any other node: its operands in evaluation order. Those before the last one that
    // awaits are held when they have an effect; those after it run after it.
    List<int> sl;
    List_init<int>(&sl, 4);
    al_slots(e, &sl);
    int last = 0 - 1;
    int i = 0;
    while (i < List_len<int>(&sl)) {
        if (al_expr_has_await(al_slot_get(e, List_get<int>(&sl, i))) == 1) {
            last = i;
        }
        i = i + 1;
    }
    i = 0;
    while (i < last) {
        int s0 = List_get<int>(&sl, i);
        al_slot_set(e, s0, al_rval(c, al_slot_get(e, s0), pre));
        i = i + 1;
    }
    if (last >= 0) {
        int s1 = List_get<int>(&sl, last);
        al_slot_set(e, s1, al_hoist(c, al_slot_get(e, s1), pre));
    }
    return e;
}

*StmtNode al_with_pre(List<*StmtNode>* pre, *StmtNode s) {
    if (List_len<*StmtNode>(pre) == 0) {
        return s;
    }
    List_push<*StmtNode>(pre, s);
    return al_block(pre);
}

// `if (c) {} else break;`: leave the enclosing loop when `c` is false.
*StmtNode al_break_unless(*ExprNode cnd) {
    *StmtNode br = ast_new_stmt();
    br.kind = SK_BREAK;
    List<*StmtNode> e;
    List_init<*StmtNode>(&e, 1);
    List<*StmtNode> b;
    List_init<*StmtNode>(&b, 1);
    List_push<*StmtNode>(&b, br);
    return al_if(cnd, al_block(&e), al_block(&b));
}

// `if (first) { first = false; } else { <else_items> }`
*StmtNode al_first_pass(string first, List<*StmtNode>* else_items) {
    List<*StmtNode> tb;
    List_init<*StmtNode>(&tb, 1);
    List_push<*StmtNode>(&tb, al_assign(mk_ident(first), mk_lit(LIT_BOOL, "false")));
    return al_if(mk_ident(first), al_block(&tb), al_block(else_items));
}

void al_desugar_items(*AlCtx c, List<*StmtNode>* inp, List<*StmtNode>* out) {
    int i = 0;
    while (i < List_len<*StmtNode>(inp)) {
        *StmtNode s = List_get<*StmtNode>(inp, i);
        i = i + 1;
        if (s.kind == SK_VARDECL) {
            if (s.expr != null && al_expr_has_await(s.expr) == 1) {
                if (s.expr.kind == EK_AWAIT) {
                    if (al_expr_has_await(s.expr.a) == 1) {
                        s.expr.aty = al_hoist_await_type(c, s.expr);
                        s.expr.a = al_hoist(c, s.expr.a, out);
                    }
                } else {
                    s.expr = al_hoist(c, s.expr, out);
                }
            }
            List_push<*StmtNode>(out, s);
        } else {
            List_push<*StmtNode>(out, al_desugar_stmt(c, s));
        }
    }
}

*StmtNode al_desugar_stmt(*AlCtx c, *StmtNode s) {
    if (s == null) {
        return s;
    }
    List<*StmtNode> pre;
    List_init<*StmtNode>(&pre, 4);
    if (s.kind == SK_EXPR) {
        if (al_expr_has_await(s.expr) == 0) {
            return s;
        }
        if (s.expr.kind == EK_AWAIT) {                   // `await E;`: the value is discarded
            string ti = al_hoist_await_type(c, s.expr);
            s.expr.aty = ti;
            if (al_expr_has_await(s.expr.a) == 1) {
                s.expr.a = al_hoist(c, s.expr.a, &pre);
            }
            List_push<*StmtNode>(&pre, mk_vardecl(al_fresh(c, "__aw_t"), ti, s.expr, 0));
            return al_block(&pre);
        }
        *ExprNode ex = al_hoist(c, s.expr, &pre);
        if (ex.kind != EK_IDENT) {
            List_push<*StmtNode>(&pre, al_exprstmt(ex));
        }
        return al_block(&pre);
    }
    if (s.kind == SK_RETURN) {
        if (s.expr == null || al_expr_has_await(s.expr) == 0) {
            return s;
        }
        *ExprNode v = al_hoist(c, s.expr, &pre);
        return al_with_pre(&pre, al_return(v));
    }
    if (s.kind == SK_THROW) {
        if (al_expr_has_await(s.expr) == 0) {
            return s;
        }
        *ExprNode v = al_hoist(c, s.expr, &pre);
        *StmtNode nt = ast_new_stmt();
        nt.kind = SK_THROW;
        nt.expr = v;
        nt.line = s.line;
        nt.col = s.col;
        return al_with_pre(&pre, nt);
    }
    if (s.kind == SK_BLOCK) {
        List<*StmtNode> out;
        List_init<*StmtNode>(&out, 8);
        al_desugar_items(c, &s.items, &out);
        return al_block(&out);
    }
    if (s.kind == SK_IF) {
        *ExprNode cnd = s.expr;
        if (al_expr_has_await(cnd) == 1) {
            cnd = al_hoist(c, cnd, &pre);
        }
        return al_with_pre(&pre, al_if(cnd, al_desugar_stmt(c, s.s1), al_desugar_stmt(c, s.s2)));
    }
    if (s.kind == SK_WHILE) {
        if (al_expr_has_await(s.expr) == 0) {
            return al_while(s.expr, al_desugar_stmt(c, s.s1));
        }
        // while (C) B  →  while (true) { <C's awaits>; if (C) {} else break; B }
        List<*StmtNode> body;
        List_init<*StmtNode>(&body, 4);
        *ExprNode cnd = al_hoist(c, s.expr, &body);
        List_push<*StmtNode>(&body, al_break_unless(cnd));
        List_push<*StmtNode>(&body, al_desugar_stmt(c, s.s1));
        return al_while(mk_lit(LIT_BOOL, "true"), al_block(&body));
    }
    // A do/while or for whose condition or step awaits: a `while (true)` whose first pass
    // skips the test (do/while) or the step (for), so `continue` still runs them.
    if (s.kind == SK_DOWHILE) {
        if (al_expr_has_await(s.expr) == 0) {
            return al_dowhile(al_desugar_stmt(c, s.s1), s.expr);
        }
        string first = al_fresh(c, "__first");
        List<*StmtNode> test;
        List_init<*StmtNode>(&test, 4);
        *ExprNode cnd = al_hoist(c, s.expr, &test);
        List_push<*StmtNode>(&test, al_break_unless(cnd));
        List<*StmtNode> body;
        List_init<*StmtNode>(&body, 4);
        List_push<*StmtNode>(&body, al_first_pass(first, &test));
        List_push<*StmtNode>(&body, al_desugar_stmt(c, s.s1));
        List<*StmtNode> outer;
        List_init<*StmtNode>(&outer, 2);
        List_push<*StmtNode>(&outer, mk_vardecl(first, "bool", mk_lit(LIT_BOOL, "true"), 0));
        List_push<*StmtNode>(&outer, al_while(mk_lit(LIT_BOOL, "true"), al_block(&body)));
        return al_block(&outer);
    }
    if (s.kind == SK_FOR) {
        *StmtNode init = al_desugar_stmt(c, s.s1);
        if (al_expr_has_await(s.expr) == 0 && al_expr_has_await(s.expr2) == 0) {
            return al_for(init, s.expr, s.expr2, al_desugar_stmt(c, s.s2));
        }
        string first = al_fresh(c, "__first");
        List<*StmtNode> step;
        List_init<*StmtNode>(&step, 4);
        if (s.expr2 != null) {
            *ExprNode stp = s.expr2;
            if (al_expr_has_await(stp) == 1) {
                stp = al_hoist(c, stp, &step);
            }
            if (stp.kind != EK_IDENT) {
                List_push<*StmtNode>(&step, al_exprstmt(stp));
            }
        }
        List<*StmtNode> body;
        List_init<*StmtNode>(&body, 4);
        List_push<*StmtNode>(&body, al_first_pass(first, &step));
        if (s.expr != null) {
            *ExprNode cnd = s.expr;
            if (al_expr_has_await(cnd) == 1) {
                cnd = al_hoist(c, cnd, &body);
            }
            List_push<*StmtNode>(&body, al_break_unless(cnd));
        }
        List_push<*StmtNode>(&body, al_desugar_stmt(c, s.s2));
        List<*StmtNode> outer;
        List_init<*StmtNode>(&outer, 3);
        if (init != null) {
            List_push<*StmtNode>(&outer, init);
        }
        List_push<*StmtNode>(&outer, mk_vardecl(first, "bool", mk_lit(LIT_BOOL, "true"), 0));
        List_push<*StmtNode>(&outer, al_while(mk_lit(LIT_BOOL, "true"), al_block(&body)));
        return al_block(&outer);
    }
    if (s.kind == SK_FORIN) {
        // The iterable is evaluated once, before the loop (an await in it is hoisted).
        *ExprNode iter = s.expr;
        string ity = "";
        if (al_expr_has_await(iter) == 1) {
            if (iter.aty != null) {
                ity = iter.aty;
            }
            iter = al_hoist(c, iter, &pre);
        }
        // Desugar `for (v in it)` into a counted C-for, then let the for-lowering handle the
        // await + break/continue. Array `T[N]`: `it[i]`, length N. List-like struct (with
        // `data`/`size`): `it.data[i]`, length `it.size`. The iterable is an ident here.
        string itname = "";
        if (iter != null && iter.kind == EK_IDENT) {
            itname = iter.sval;
        }
        string ty = al_var_type(c.curfn, itname);
        if (ty[0] == 0) {
            ty = ity;
        }
        string fi = fresh_name(str_concat("__forin_i_", int_to_str(c.forinseq)), c.used);
        c.forinseq = c.forinseq + 1;
        List<*StmtNode> initb;
        List_init<*StmtNode>(&initb, 2);
        if (itname[0] == 0 && s.resolved_iter != null && s.resolved_iter[0] != 0) {
            // Any other iterable (a call) is evaluated once, into a local the loop reads.
            itname = fresh_name(str_concat(fi, "_v"), c.used);
            ty = s.resolved_iter;
            List_push<*StmtNode>(&initb, mk_vardecl(itname, ty, iter, 0));
        }
        string elemTy = "int";
        *ExprNode lengthE = al_int(0);
        *ExprNode elemE = al_int(0);
        int br = 0;   // '['
        int tn2 = 0;
        while (ty[tn2] != 0) {
            if ((int)ty[tn2] == 91) {
                br = tn2;
            }
            tn2 = tn2 + 1;
        }
        if (br > 0) {                                  // array "T[N]"
            elemTy = al_substr(ty, 0, br);             // before '['
            int e2 = br + 1;
            int s2 = e2;
            while (ty[e2] != 0 && (int)ty[e2] != 93) {
                e2 = e2 + 1;
            }
            if (e2 == s2) {   // a slice `T[]`
                lengthE = al_member(mk_ident(itname), "len");
            }
            else {
                lengthE = mk_lit(LIT_INT, al_substr(ty, s2, e2));
            }
            elemE = al_index(mk_ident(itname), mk_ident(fi));
        } else {                                       // list-like struct (data/size)
            string sn = al_deref(ty);
            string gelem = al_generic_data_elem(c.prog, sn);   // generic List<T>: substitute T
            if (gelem[0] != 0) {
                elemTy = gelem;
            } else {
                *DeclNode sd = al_find_struct(c.prog, sn);
                if (sd != null) {
                    int k = 0;
                    while (k < List_len<Param>(&sd.params)) {
                        Param p = List_get<Param>(&sd.params, k);
                        if (str_eq(p.name, "data") == 1) {
                            elemTy = al_deref(p.ty);
                        }
                        k = k + 1;
                    }
                }
            }
            lengthE = al_member(mk_ident(itname), "size");
            elemE = al_index(al_member(mk_ident(itname), "data"), mk_ident(fi));
        }
        List_push<*StmtNode>(&initb, mk_vardecl(fi, "int", al_int(0), 0));
        *ExprNode cond = mk_bin("<", mk_ident(fi), lengthE);
        *ExprNode step = mk_bin("=", mk_ident(fi), mk_bin("+", mk_ident(fi), al_int(1)));
        if (s.resolved_elem[0] != 0) {   // prefer the sema-stamped type (R1)
            elemTy = s.resolved_elem;
        }
        List<*StmtNode> body;
        List_init<*StmtNode>(&body, 2);
        List_push<*StmtNode>(&body, mk_vardecl(s.name, elemTy, elemE, 0));
        List_push<*StmtNode>(&body, al_desugar_stmt(c, s.s1));
        return al_with_pre(&pre, al_for(al_block(&initb), cond, step, al_block(&body)));
    }
    if (s.kind == SK_SWITCH) {
        // The subject is evaluated once, before the dispatch.
        *ExprNode subj = s.expr;
        if (al_expr_has_await(subj) == 1) {
            subj = al_hoist(c, subj, &pre);
        }
        List<*StmtNode> ncases;
        List_init<*StmtNode>(&ncases, 4);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k);
            k = k + 1;
            List<*StmtNode> nb;
            List_init<*StmtNode>(&nb, 4);
            al_desugar_items(c, &cs.items, &nb);
            List_push<*StmtNode>(&ncases, al_case(cs.expr, &nb));
        }
        return al_with_pre(&pre, al_switch(subj, &ncases));
    }
    if (s.kind == SK_MATCH) {
        if (al_expr_has_await(s.expr) == 1) {
            s.expr = al_hoist(c, s.expr, &pre);
        }
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode arm = List_get<*StmtNode>(&s.items, k);
            k = k + 1;
            arm.s1 = al_desugar_stmt(c, arm.s1);
        }
        return al_with_pre(&pre, s);
    }
    if (s.kind == SK_TRY) {                // catches, body, then finally (as the C++)
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cl = List_get<*StmtNode>(&s.items, k);
            k = k + 1;
            cl.s1 = al_desugar_stmt(c, cl.s1);
        }
        s.s1 = al_desugar_stmt(c, s.s1);
        s.s2 = al_desugar_stmt(c, s.s2);
        return s;
    }
    if (s.kind == SK_DEFER) {
        if (al_stmt_has_await_deep(s.s1) == 1) {
            s.s1 = al_desugar_stmt(c, s.s1);
        }
        return s;
    }
    return s;       // break/continue, asm, ...
}

// Recursively register body locals (vardecls anywhere) as frame fields.
void al_scan_locals(*AlCtx c, *StmtNode s) {
    if (s == null) {
        return;
    }
    if (s.kind == SK_VARDECL) {
        if (al_in(&c.vars, s.name) == 0) {
            List_push<string>(&c.vars, s.name);
            let lf: Param;
            lf.name = s.name;
            lf.ty = s.type;
            List_push<Param>(&c.fields, lf);
        }
        if (s.expr != null && s.expr.kind == EK_AWAIT) {   // its future's field follows it
            al_await_field(c, s);
        }
        return;
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_DOWHILE
        || s.kind == SK_DEFER || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_TRY) {
        al_scan_locals(c, s.s1);
    }
    if (s.kind == SK_IF || s.kind == SK_FOR) {
        al_scan_locals(c, s.s2);
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            al_scan_locals(c, List_get<*StmtNode>(&s.items, i));
            i = i + 1;
        }
    }
    if (s.kind == SK_TRY) {                // body, catches, then finally (as the C++ scan)
        al_scan_locals(c, s.s2);
    }
}

// ── Closure locals owning their env (mirrors the C++ OwnedClosureScan) ──────────
// Every local is a frame field, so a lambda bound to one gets a heap env (it must survive
// a suspension). A local qualifies when each of its bindings is a lambda literal (its
// initializer, or a statement `f = <lambda>`), at least one exists, and every other use
// is a call `f(...)` outside any lambda (a lambda that names it would copy the env
// pointer). Names are unique here (the renamer ran first).
struct AlOwn {
    List<string> names;
    List<int> uses;
    List<int> allowed;
    List<int> binds;
    List<int> bad;
}

int al_own_idx(AlOwn* o, string nm) {
    int i = 0;
    while (i < List_len<string>(&o.names)) {
        if (str_eq(List_get<string>(&o.names, i), nm) == 1) {
            return i;
        }
        i = i + 1;
    }
    List_push<string>(&o.names, nm);
    List_push<int>(&o.uses, 0);
    List_push<int>(&o.allowed, 0);
    List_push<int>(&o.binds, 0);
    List_push<int>(&o.bad, 0);
    return i;
}

void al_own_bump(List<int>* l, int i) {
    List_set<int>(l, i, List_get<int>(l, i) + 1);
}

void al_own_stmt(AlOwn* o, *StmtNode s, int in_lam);
void al_own_expr(AlOwn* o, *ExprNode e, int in_lam) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_IDENT) {
        al_own_bump(&o.uses, al_own_idx(o, e.sval));
        return;
    }
    if (e.kind == EK_LAMBDA) {
        al_own_stmt(o, e.stmt, 1);
        return;
    }
    if (e.kind == EK_CALL && in_lam == 0 && e.a != null && e.a.kind == EK_IDENT) {
        al_own_bump(&o.allowed, al_own_idx(o, e.a.sval));
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        al_own_expr(o, List_get<*ExprNode>(&ch, i), in_lam);
        i = i + 1;
    }
}

void al_own_decl(AlOwn* o, *StmtNode vd, int in_lam, int for_init) {
    if (in_lam == 0) {
        int i = al_own_idx(o, vd.name);
        if (for_init == 1 || (vd.expr != null && vd.expr.kind != EK_LAMBDA)) {
            List_set<int>(&o.bad, i, 1);
        }
        else if (vd.expr != null) {
            al_own_bump(&o.binds, i);
        }
    }
    al_own_expr(o, vd.expr, in_lam);
}

void al_own_items(AlOwn* o, List<*StmtNode>* items, int in_lam, int for_init) {
    int i = 0;
    while (i < List_len<*StmtNode>(items)) {
        *StmtNode it = List_get<*StmtNode>(items, i);
        i = i + 1;
        if (it.kind == SK_VARDECL) {
            al_own_decl(o, it, in_lam, for_init);
        } else {
            al_own_stmt(o, it, in_lam);
        }
    }
}

void al_own_stmt(AlOwn* o, *StmtNode s, int in_lam) {
    if (s == null) {
        return;
    }
    int k = s.kind;
    if (k == SK_VARDECL) {
        al_own_decl(o, s, in_lam, 0);
        return;
    }
    if (k == SK_BLOCK || k == SK_CASE) {
        if (k == SK_CASE) {
            al_own_expr(o, s.expr, in_lam);
        }
        al_own_items(o, &s.items, in_lam, 0);
        return;
    }
    if (k == SK_EXPR) {
        *ExprNode a = s.expr;
        if (in_lam == 0 && a != null && a.kind == EK_BINARY && str_eq(a.sval, "=") == 1 && a.a != null
            && a.a.kind == EK_IDENT && a.b != null && a.b.kind == EK_LAMBDA) {
            int i = al_own_idx(o, a.a.sval);
            al_own_bump(&o.allowed, i);
            al_own_bump(&o.binds, i);
        }
        al_own_expr(o, a, in_lam);
        return;
    }
    if (k == SK_FOR) {
        if (s.s1 != null && s.s1.kind == SK_BLOCK) {
            al_own_items(o, &s.s1.items, in_lam, 1);
        }
        else if (s.s1 != null && s.s1.kind == SK_VARDECL) {
            al_own_decl(o, s.s1, in_lam, 1);
        }
        else {
            al_own_stmt(o, s.s1, in_lam);
        }
        al_own_expr(o, s.expr, in_lam);
        al_own_expr(o, s.expr2, in_lam);
        al_own_stmt(o, s.s2, in_lam);
        return;
    }
    if (k == SK_ASM) {
        int ai = 0;
        while (ai < List_len<*StmtNode>(&s.items)) {
            al_own_expr(o, List_get<*StmtNode>(&s.items, ai).expr, in_lam);
            ai = ai + 1;
        }
        return;
    }
    // if / while / do-while / for-in / switch / match / arm / try / catch / defer / return /
    // throw / thread_join: the subject or condition, then the bodies.
    al_own_expr(o, s.expr, in_lam);
    al_own_stmt(o, s.s1, in_lam);
    al_own_stmt(o, s.s2, in_lam);
    if (k == SK_SWITCH || k == SK_MATCH || k == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            al_own_stmt(o, List_get<*StmtNode>(&s.items, i), in_lam);
            i = i + 1;
        }
    }
}

void al_owned_closures(List<*StmtNode>* body, List<string>* out) {
    let o: AlOwn;
    List_init<string>(&o.names, 8);
    List_init<int>(&o.uses, 8);
    List_init<int>(&o.allowed, 8);
    List_init<int>(&o.binds, 8);
    List_init<int>(&o.bad, 8);
    al_own_items(&o, body, 0, 0);
    int i = 0;
    while (i < List_len<string>(&o.names)) {
        if (List_get<int>(&o.binds, i) > 0 && List_get<int>(&o.bad, i) == 0
            && List_get<int>(&o.uses, i) == List_get<int>(&o.allowed, i)) {
            List_push<string>(out, List_get<string>(&o.names, i));
        }
        i = i + 1;
    }
}

// Before each binding of an owned closure local, free the env it holds (the field is zero
// before the first one, and free(null) is a no-op): a loop rebinding it each pass keeps one
// env alive.
*StmtNode al_free_closure_of(*ExprNode target) {
    *ExprNode fe = ast_new_expr();
    fe.kind = EK_FREECLOSURE;
    fe.a = target;
    return al_exprstmt(fe);
}

void al_free_rebind_items(List<*StmtNode>* items, List<string>* owned);
*StmtNode al_free_rebind(*StmtNode s, List<string>* owned) {
    if (s == null) {
        return s;
    }
    int k = s.kind;
    if (k == SK_BLOCK || k == SK_CASE) {
        al_free_rebind_items(&s.items, owned);
        return s;
    }
    if (k == SK_EXPR) {
        *ExprNode a = s.expr;
        if (a != null && a.kind == EK_BINARY && str_eq(a.sval, "=") == 1 && a.a != null && a.a.kind == EK_IDENT
            && al_in(owned, a.a.sval) == 1 && a.b != null && a.b.kind == EK_LAMBDA) {
            List<*StmtNode> two;
            List_init<*StmtNode>(&two, 2);
            List_push<*StmtNode>(&two, al_free_closure_of(mk_ident(a.a.sval)));
            List_push<*StmtNode>(&two, s);
            return al_block(&two);
        }
        return s;
    }
    if (k == SK_FOR) {
        s.s2 = al_free_rebind(s.s2, owned);
        return s;
    }
    if (k == SK_IF || k == SK_WHILE || k == SK_DOWHILE || k == SK_FORIN || k == SK_ARM || k == SK_CATCH
        || k == SK_TRY || k == SK_DEFER) {
        s.s1 = al_free_rebind(s.s1, owned);
        s.s2 = al_free_rebind(s.s2, owned);
    }
    if (k == SK_SWITCH || k == SK_MATCH || k == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            List_set<*StmtNode>(&s.items, i, al_free_rebind(List_get<*StmtNode>(&s.items, i), owned));
            i = i + 1;
        }
    }
    return s;
}

void al_free_rebind_items(List<*StmtNode>* items, List<string>* owned) {
    List<*StmtNode> out;
    List_init<*StmtNode>(&out, List_len<*StmtNode>(items) + 2);
    int i = 0;
    while (i < List_len<*StmtNode>(items)) {
        *StmtNode it = List_get<*StmtNode>(items, i);
        i = i + 1;
        if (it.kind == SK_VARDECL) {
            // Every declaration resets the field (to its initializer, or to zero), so the
            // env the field held is freed first (null on the first pass: a no-op).
            if (al_in(owned, it.name) == 1) {
                List_push<*StmtNode>(&out, al_free_closure_of(mk_ident(it.name)));
            }
            List_push<*StmtNode>(&out, it);
        } else {
            List_push<*StmtNode>(&out, al_free_rebind(it, owned));
        }
    }
    List_init<*StmtNode>(items, List_len<*StmtNode>(&out));
    i = 0;
    while (i < List_len<*StmtNode>(&out)) {
        List_push<*StmtNode>(items, List_get<*StmtNode>(&out, i));
        i = i + 1;
    }
}

// ── Lambdas capturing a frame-hoisted local ────────────────────────────────────
// The resume function has no local of that name (it lives in `fr.<name>`, and al_rewrite
// stops at a lambda), so each statement whose own expressions create such a lambda is
// wrapped as `{ T x = fr.x; <stmt> }`: a by-value snapshot at the creation point, exactly
// what the closure's capture takes. Mirrors the C++ AsyncTransform wrapCaps pass.
void al_collect_idents_s(*StmtNode s, List<string>* out);
void al_collect_idents_e(*ExprNode e, List<string>* out) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_IDENT) {
        List_push<string>(out, e.sval);
        return;
    }
    if (e.kind == EK_LAMBDA) {
        al_collect_idents_s(e.stmt, out);
        return;
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        al_collect_idents_e(List_get<*ExprNode>(&ch, i), out);
        i = i + 1;
    }
}

void al_collect_idents_s(*StmtNode s, List<string>* out) {
    if (s == null) {
        return;
    }
    al_collect_idents_e(s.expr, out);
    al_collect_idents_e(s.expr2, out);
    al_collect_idents_s(s.s1, out);
    al_collect_idents_s(s.s2, out);
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            al_collect_idents_s(List_get<*StmtNode>(&s.items, i), out);
            i = i + 1;
        }
    }
}

// Parameter names of a lambda signature `int(int y, fn(int)->int g)` → ["y", "g"].
void al_lambda_params(string sig, List<string>* out) {
    int i = 0;   // to '('
    while (sig[i] != 0 && (int)sig[i] != 40) {
        i = i + 1;
    }
    if (sig[i] == 0) {
        return;
    }
    i = i + 1;
    int depth = 1;
    int start = i;
    while (sig[i] != 0 && depth > 0) {
        int ch = (int)sig[i];
        if (ch == 40) {
            depth = depth + 1;
        }
        else if (ch == 41) {
            depth = depth - 1;
        }
        if ((ch == 44 && depth == 1) || depth == 0) {
            int e = i;
            while (e > start && (int)sig[e - 1] == 32) {
                e = e - 1;
            }
            int b = e;
            while (b > start && (int)sig[b - 1] != 32) {
                b = b - 1;
            }
            if (e > b) {
                List_push<string>(out, al_substr(sig, b, e));
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

// Is `a` before `b` byte by byte (std::string's order)?
int al_str_before(string a, string b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i = i + 1;
    }
    return (int)(uint8)a[i] < (int)(uint8)b[i];
}

// The frame locals each lambda in `e` captures, in order of the lambdas, a lambda's own
// by name (the checker's capture list is ordered by name).
void al_lambda_caps(*AlCtx c, *ExprNode e, List<string>* caps) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_LAMBDA) {
        List<string> ids;
        List_init<string>(&ids, 8);
        al_collect_idents_s(e.stmt, &ids);
        List<string> ps;
        List_init<string>(&ps, 2);
        al_lambda_params(e.sval, &ps);
        List<string> own;
        List_init<string>(&own, 4);
        int i = 0;
        while (i < List_len<string>(&ids)) {
            string nm = List_get<string>(&ids, i);
            i = i + 1;
            if (al_in(&c.vars, nm) == 1 && al_in(&ps, nm) == 0 && al_in(&own, nm) == 0) {
                int at = List_len<string>(&own);
                List_push<string>(&own, nm);
                while (at > 0 && al_str_before(nm, List_get<string>(&own, at - 1)) == 1) {
                    List_set<string>(&own, at, List_get<string>(&own, at - 1));
                    at = at - 1;
                }
                List_set<string>(&own, at, nm);
            }
        }
        i = 0;
        while (i < List_len<string>(&own)) {
            if (al_in(caps, List_get<string>(&own, i)) == 0) {
                List_push<string>(caps, List_get<string>(&own, i));
            }
            i = i + 1;
        }
        return;
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        al_lambda_caps(c, List_get<*ExprNode>(&ch, i), caps);
        i = i + 1;
    }
}

string al_field_type(*AlCtx c, string nm) {
    int i = 0;
    while (i < List_len<Param>(&c.fields)) {
        Param f = List_get<Param>(&c.fields, i);
        if (str_eq(f.name, nm) == 1) {
            return f.ty;
        }
        i = i + 1;
    }
    return "int";
}

*StmtNode al_wrap_caps(*AlCtx c, *StmtNode s) {
    if (s == null) {
        return s;
    }
    if (s.kind == SK_BLOCK) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            List_set<*StmtNode>(&s.items, i, al_wrap_caps(c, List_get<*StmtNode>(&s.items, i)));
            i = i + 1;
        }
        return s;
    }
    List<string> caps;
    List_init<string>(&caps, 2);
    if (s.kind == SK_SWITCH || s.kind == SK_MATCH) {
        al_lambda_caps(c, s.expr, &caps);
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, i);
            i = i + 1;
            if (s.kind == SK_SWITCH) {
                al_lambda_caps(c, cs.expr, &caps);
                int j = 0;
                while (j < List_len<*StmtNode>(&cs.items)) {
                    List_set<*StmtNode>(&cs.items, j, al_wrap_caps(c, List_get<*StmtNode>(&cs.items, j)));
                    j = j + 1;
                }
            } else {
                cs.s1 = al_wrap_caps(c, cs.s1);
            }
        }
    } else {
        // Every other kind: its own expressions (cond / step / value / initializer) and
        // its nested statements (then/else, body, for-init, defer body).
        al_lambda_caps(c, s.expr, &caps);
        al_lambda_caps(c, s.expr2, &caps);
        s.s1 = al_wrap_caps(c, s.s1);
        s.s2 = al_wrap_caps(c, s.s2);
        if (s.kind == SK_TRY) {                        // and each catch clause's body
            int i = 0;
            while (i < List_len<*StmtNode>(&s.items)) {
                *StmtNode cl = List_get<*StmtNode>(&s.items, i);
                cl.s1 = al_wrap_caps(c, cl.s1);
                i = i + 1;
            }
        }
    }
    if (List_len<string>(&caps) == 0) {
        return s;
    }
    List<*StmtNode> blk;
    List_init<*StmtNode>(&blk, 4);
    int k = 0;
    while (k < List_len<string>(&caps)) {
        string nm = List_get<string>(&caps, k);
        k = k + 1;
        List_push<*StmtNode>(&blk, mk_vardecl(nm, al_field_type(c, nm), al_fr(nm), 0));
    }
    List_push<*StmtNode>(&blk, s);
    return al_block(&blk);
}

// Every local becomes a frame field keyed by its name, so two declarations of one name
// (a nested-block `let x` shadowing an outer `x`, or two sibling blocks each declaring
// `x`) would collapse into one field. Before hoisting, give every re-declaration a
// unique name (`x__sN`) and rewrite the references in its lexical scope (mirrors the
// C++ ShadowRenamer). keys/vals is a scope stack of name → current spelling.
// `static` locals of the async function itself (not of a lambda in it) are one cell for
// every call, not frame fields: each gets a fresh name and is taken out of the body
// (`statics`); the lowering declares them at the top of the resume function.
struct AlRen {
    List<string> keys;
    List<string> vals;
    List<string> seen;
    List<string>* used;
    List<*StmtNode> statics;
    int ldepth;
}

string al_ren_lookup(AlRen* r, string n) {
    int i = List_len<string>(&r.keys) - 1;
    while (i >= 0) {
        if (str_eq(List_get<string>(&r.keys, i), n) == 1) {
            return List_get<string>(&r.vals, i);
        }
        i = i - 1;
    }
    return n;
}

void al_ren_bind(AlRen* r, string n, string v) {
    List_push<string>(&r.keys, n);
    List_push<string>(&r.vals, v);
}

string al_ren_declare(AlRen* r, string n) {
    string nn = n;
    if (al_in(&r.seen, n) == 1) {
        nn = fresh_name(str_concat(n, "__s"), r.used);
    }
    else {
        List_push<string>(&r.seen, n);
    }
    al_ren_bind(r, n, nn);
    return nn;
}

void al_ren_pop(AlRen* r, int mark) {
    while (List_len<string>(&r.keys) > mark) {
        List_remove<string>(&r.keys, List_len<string>(&r.keys) - 1);
        List_remove<string>(&r.vals, List_len<string>(&r.vals) - 1);
    }
}

void al_ren_stmt(AlRen* r, *StmtNode s);
void al_ren_expr(AlRen* r, *ExprNode e) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_SIZEOF && e.a != null) {   // sizeof(expr)
        al_ren_expr(r, e.a);
        return;
    }
    if (e.kind == EK_IDENT || e.kind == EK_SIZEOF) {
        e.sval = al_ren_lookup(r, e.sval);
        return;
    }
    if (e.kind == EK_LAMBDA) {                           // body follows renames; params shadow
        int lmark = List_len<string>(&r.keys);
        List<string> lps;
        List_init<string>(&lps, 2);
        al_lambda_params(e.sval, &lps);
        int li = 0;
        while (li < List_len<string>(&lps)) {
            al_ren_bind(r, List_get<string>(&lps, li), List_get<string>(&lps, li));
            li = li + 1;
        }
        r.ldepth = r.ldepth + 1;
        al_ren_stmt(r, e.stmt);
        r.ldepth = r.ldepth - 1;
        al_ren_pop(r, lmark);
        return;
    }
    if (e.kind == EK_MEMBER) {   // sval is the field name
        al_ren_expr(r, e.a);
        return;
    }
    al_ren_expr(r, e.a);
    al_ren_expr(r, e.b);
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        al_ren_expr(r, List_get<*ExprNode>(&e.kids, i));
        i = i + 1;
    }
}

void al_ren_scoped(AlRen* r, *StmtNode s) {
    int mark = List_len<string>(&r.keys);
    al_ren_stmt(r, s);
    al_ren_pop(r, mark);
}

void al_ren_items(AlRen* r, List<*StmtNode>* items) {
    List<*StmtNode> kept;
    List_init<*StmtNode>(&kept, List_len<*StmtNode>(items) + 1);
    int i = 0;
    while (i < List_len<*StmtNode>(items)) {
        *StmtNode it = List_get<*StmtNode>(items, i);
        i = i + 1;
        if (it.kind == SK_VARDECL && it.is_static == 1 && r.ldepth == 0) {
            al_ren_expr(r, it.expr);
            string nn = fresh_name(str_concat(it.name, "__st"), r.used);
            if (al_in(&r.seen, it.name) == 0) {
                List_push<string>(&r.seen, it.name);
            }
            al_ren_bind(r, it.name, nn);
            it.name = nn;
            List_push<*StmtNode>(&r.statics, it);
            continue;
        }
        al_ren_stmt(r, it);
        List_push<*StmtNode>(&kept, it);
    }
    while (List_len<*StmtNode>(items) > 0) {
        List_remove<*StmtNode>(items, List_len<*StmtNode>(items) - 1);
    }
    i = 0;
    while (i < List_len<*StmtNode>(&kept)) {
        List_push<*StmtNode>(items, List_get<*StmtNode>(&kept, i));
        i = i + 1;
    }
}

void al_ren_stmt(AlRen* r, *StmtNode s) {
    if (s == null) {
        return;
    }
    int mark = List_len<string>(&r.keys);
    if (s.kind == SK_VARDECL) {
        al_ren_expr(r, s.expr);                          // the initializer sees the outer binding
        s.name = al_ren_declare(r, s.name);
        return;
    }
    if (s.kind == SK_FOR) {
        if (s.s1 != null && s.s1.kind == SK_BLOCK) {
            al_ren_items(r, &s.s1.items);
        } else {
            al_ren_stmt(r, s.s1);
        }
        al_ren_expr(r, s.expr);
        al_ren_expr(r, s.expr2);
        al_ren_scoped(r, s.s2);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_FORIN) {
        al_ren_expr(r, s.expr);
        s.name = al_ren_declare(r, s.name);
        al_ren_scoped(r, s.s1);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_ARM) {                              // `V(a, b)`: the bindings shadow
        string lb = s.name;
        int n = 0;
        while (lb[n] != 0) {
            n = n + 1;
        }
        int i = 0;
        while (i < n && (int)lb[i] != 40) {
            i = i + 1;
        }
        i = i + 1;
        while (i < n) {
            while (i < n && ((int)lb[i] == 32 || (int)lb[i] == 44)) {
                i = i + 1;
            }
            int st = i;
            while (i < n && (int)lb[i] != 44 && (int)lb[i] != 41 && (int)lb[i] != 32) {
                i = i + 1;
            }
            if (i > st) {
                // A binding gets its own spelling too, so a hoisted local of the same name
                // is not substituted for it.
                string bn = al_substr(lb, st, i);
                string nb = bn;
                if (str_eq(bn, "_") == 0) {
                    nb = al_ren_declare(r, bn);
                }
                if (str_eq(nb, bn) == 0) {
                    lb = str_concat(al_substr(lb, 0, st), str_concat(nb, al_substr(lb, i, n)));
                    i = st + cstr_len(nb);
                    n = cstr_len(lb);
                }
            }
            if (i < n && (int)lb[i] == 41) {
                i = n;
            }
        }
        s.name = lb;
        al_ren_scoped(r, s.s1);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_CATCH) {                            // "Type name": the name shadows
        string cn = s.name;
        int n = 0;
        while (cn[n] != 0) {
            n = n + 1;
        }
        int i = n;
        while (i > 0 && (int)cn[i - 1] != 32) {
            i = i - 1;
        }
        string bn = al_substr(cn, i, n);
        if (bn[0] != 0 && str_eq(cn, "_") == 0) {
            string nb = al_ren_declare(r, bn);
            if (str_eq(nb, bn) == 0) {
                s.name = str_concat(al_substr(cn, 0, i), nb);
            }
        }
        al_ren_scoped(r, s.s1);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_BLOCK) {
        al_ren_items(r, &s.items);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_SWITCH) {                           // the switch body is one scope (C)
        al_ren_expr(r, s.expr);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k);
            k = k + 1;
            al_ren_expr(r, cs.expr);
            al_ren_items(r, &cs.items);
        }
        al_ren_pop(r, mark);
        return;
    }
    al_ren_expr(r, s.expr);
    al_ren_expr(r, s.expr2);
    al_ren_scoped(r, s.s1);
    al_ren_scoped(r, s.s2);
    al_ren_items(r, &s.items);
    al_ren_pop(r, mark);
}

// Lower one async function into [frame struct, resume fn, ctor fn], appended to `out`.
void al_transform(*Program prog, *DeclNode d, List<*DeclNode>* out) {
    string name = d.name;
    // Every synthesized name avoids the names already spelled in the function (and the
    // program's top-level names, for the frame type and resume function).
    List<string> used;
    List_init<string>(&used, 32);
    int ti = 0;
    while (ti < List_len<*DeclNode>(&prog.decls)) {
        List_push<string>(&used, List_get<*DeclNode>(&prog.decls, ti).name);
        ti = ti + 1;
    }
    collect_names_s(d.body, &used);
    int ui = 0;
    while (ui < List_len<Param>(&d.params)) {
        List_push<string>(&used, List_get<Param>(&d.params, ui).name);
        ui = ui + 1;
    }
    string frameName = fresh_name(str_concat("__", str_concat(name, "_frame")), &used);
    al_tps = "";
    int tpi = 0;
    while (tpi < List_len<TypeParam>(&d.type_params)) {
        if (tpi == 0) {
            al_tps = "<";
        } else {
            al_tps = str_concat(al_tps, ", ");
        }
        al_tps = str_concat(al_tps, List_get<TypeParam>(&d.type_params, tpi).name);
        tpi = tpi + 1;
    }
    if (al_tps[0] != 0) {
        al_tps = str_concat(al_tps, ">");
    }
    string frameT = str_concat(frameName, al_tps);   // the frame type's spelling
    string resumeN = fresh_name(str_concat("__", str_concat(name, "_resume")), &used);
    al_frp = fresh_name("__fr", &used);
    al_fst = fresh_name("st", &used);
    al_fret = fresh_name("ret", &used);
    al_fawt = fresh_name("awaiting", &used);
    string Tret = d.ret_type;
    if (str_eq(Tret, "void") == 1) {
        Tret = "uint8";
    }

    let c: AlCtx;
    c.prog = prog;
    c.resumeN = resumeN;
    c.awcount = 0;
    c.tmpn = 0;
    c.curfn = d;
    List_init<string>(&c.vars, 8);
    List_init<Param>(&c.fields, 8);
    al_cur_fields = &c.fields;
    List_init<List<*StmtNode>>(&c.states, 4);
    List_init<int>(&c.brk, 4);
    List_init<int>(&c.cont, 4);
    List_init<List<*StmtNode>>(&c.dfr, 4);
    List_init<int>(&c.brk_dd, 4);
    List_init<int>(&c.cont_dd, 4);
    List_init<int>(&c.rg_parent, 2);
    List_init<int>(&c.rg_start, 2);
    List_init<int>(&c.rg_base, 2);
    List_init<*StmtNode>(&c.rg_fin, 2);
    List_init<int>(&c.ci_region, 2);
    List_init<string>(&c.ci_type, 2);
    List_init<string>(&c.ci_var, 2);
    List_init<string>(&c.ci_txt, 2);
    List_init<int>(&c.ci_state, 2);
    c.cur_region = 0 - 1;
    List_init<int>(&c.st_region, 8);
    List_init<AlSnap>(&c.st_snap, 8);
    List_init<int>(&c.ds_state, 4);
    List_init<AlSnap>(&c.ds_snap, 4);
    List_init<int>(&c.drop_from, 4);
    List_init<int>(&c.drop_to, 4);
    List_init<int>(&c.drop_det, 4);
    c.cancel = 0;
    List_init<int>(&c.st_cancel, 8);
    List_init<int>(&c.exc_reg, 2);
    List_init<string>(&c.exc_name, 2);
    List<*StmtNode> exf;
    List_init<*StmtNode>(&exf, 1);
    al_exc_free = al_block(&exf);
    c.errname = name;
    c.used = &used;
    let fret: Param;
    fret.name = al_fret;
    fret.ty = str_concat("Future<", str_concat(Tret, ">"));
    List_push<Param>(&c.fields, fret);
    let fst: Param;
    fst.name = al_fst;
    fst.ty = "int";
    List_push<Param>(&c.fields, fst);
    let faw: Param;
    faw.name = al_fawt;
    faw.ty = "*FutureHdr";
    List_push<Param>(&c.fields, faw);
    int pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        Param p = List_get<Param>(&d.params, pi);
        List_push<string>(&c.vars, p.name);
        List_push<Param>(&c.fields, p);
        pi = pi + 1;
    }
    let ren: AlRen;
    List_init<string>(&ren.keys, 8);
    List_init<string>(&ren.vals, 8);
    List_init<string>(&ren.seen, 8);
    ren.used = &used;
    List_init<*StmtNode>(&ren.statics, 2);
    ren.ldepth = 0;
    pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        Param rp = List_get<Param>(&d.params, pi);
        List_push<string>(&ren.seen, rp.name);
        al_ren_bind(&ren, rp.name, rp.name);
        pi = pi + 1;
    }
    al_ren_items(&ren, &d.body.items);
    // Desugar awaits to let-bindings, then hoist all locals to frame fields.
    List<*StmtNode> dbody;
    List_init<*StmtNode>(&dbody, 8);
    al_desugar_items(&c, &d.body.items, &dbody);
    int bi = 0;
    while (bi < List_len<*StmtNode>(&dbody)) {
        al_scan_locals(&c, List_get<*StmtNode>(&dbody, bi));
        bi = bi + 1;
    }
    // Every await is now the initializer of a let, except where it can't be placed.
    bi = 0;
    while (bi < List_len<*StmtNode>(&dbody)) {
        *ExprNode ua = al_unplaced_await(List_get<*StmtNode>(&dbody, bi));
        if (ua != null) {
            al_error_at(&c, ua.line, ua.col, "'await' is not supported here (a 'sizeof' operand, an 'asm' input or a 'thread_join'); bind the value to a local first");
        }
        bi = bi + 1;
    }
    // Closure locals owning their env: each binding frees the env bound before it, and the
    // frame's end frees the last one (al_exc_free).
    List<string> owned;
    List_init<string>(&owned, 2);
    al_owned_closures(&dbody, &owned);
    if (List_len<string>(&owned) > 0) {
        al_free_rebind_items(&dbody, &owned);
    }

    int entry = al_newst(&c);                  // state 0
    int exit = al_lower_seq(&c, &dbody, entry);
    if (exit != 0 - 1) {
        al_complete(&c, exit, al_int(0));
    }
    // Wrapping and the cancellation states can each produce states the other needs.
    string cx = fresh_name("__cx", &used);
    int wrapped = 0;
    int ds_done = 0;
    while (1 == 1) {
        while (ds_done < List_len<int>(&c.ds_state)) {
            al_build_drop(&c, ds_done);
            ds_done = ds_done + 1;
        }
        if (wrapped == List_len<List<*StmtNode>>(&c.states)) {
            break;
        }
        while (wrapped < List_len<List<*StmtNode>>(&c.states)) {
            al_wrap_state(&c, wrapped, cx);
            wrapped = wrapped + 1;
        }
    }
    int xi = 0;
    while (xi < List_len<string>(&c.exc_name)) {
        List_push<*StmtNode>(&al_exc_free.items, al_free_exc(List_get<string>(&c.exc_name, xi)));
        xi = xi + 1;
    }
    xi = 0;
    while (xi < List_len<string>(&owned)) {
        List_push<*StmtNode>(&al_exc_free.items, al_free_closure_of(al_fr(List_get<string>(&owned, xi))));
        xi = xi + 1;
    }
    int wi = 0;                                // lambdas capturing hoisted locals
    while (wi < List_len<List<*StmtNode>>(&c.states)) {
        List<*StmtNode> stl = List_get<List<*StmtNode>>(&c.states, wi);
        int wk = 0;
        while (wk < List_len<*StmtNode>(&stl)) {
            List_set<*StmtNode>(&stl, wk, al_wrap_caps(&c, List_get<*StmtNode>(&stl, wk)));
            wk = wk + 1;
        }
        List_set<List<*StmtNode>>(&c.states, wi, stl);
        wi = wi + 1;
    }

    // resume fn: while (1) { if (fr.st==0){…} else if (fr.st==1){…} … else return; }
    *StmtNode chain = al_return(null);
    int si = List_len<List<*StmtNode>>(&c.states) - 1;
    while (si >= 0) {
        List<*StmtNode> body = List_get<List<*StmtNode>>(&c.states, si);
        List<*StmtNode> blk;
        List_init<*StmtNode>(&blk, 8);
        int k = 0;
        while (k < List_len<*StmtNode>(&body)) {
            List_push<*StmtNode>(&blk, List_get<*StmtNode>(&body, k));
            k = k + 1;
        }
        chain = al_if(mk_bin("==", al_fr(al_fst), al_int(si)), al_block(&blk), chain);
        si = si - 1;
    }
    *StmtNode wh = alloc<StmtNode>(1);
    wh.kind = SK_WHILE;
    wh.expr = mk_lit(LIT_BOOL, "true");
    List<*StmtNode> wb;
    List_init<*StmtNode>(&wb, 1);
    List_push<*StmtNode>(&wb, chain);
    wh.s1 = al_block(&wb);
    List<*StmtNode> rb;
    List_init<*StmtNode>(&rb, 1);
    int sti = 0;
    while (sti < List_len<*StmtNode>(&ren.statics)) {
        List_push<*StmtNode>(&rb, List_get<*StmtNode>(&ren.statics, sti));
        sti = sti + 1;
    }
    List_push<*StmtNode>(&rb, wh);
    *DeclNode resumeFn = new_decl(DK_FUNCTION);
    resumeFn.name = resumeN;
    resumeFn.ret_type = "void";
    resumeFn.body = al_block(&rb);
    List_init<Param>(&resumeFn.params, 1);
    let fp: Param;
    fp.name = al_frp;
    fp.ty = str_concat("*", frameT);
    List_push<Param>(&resumeFn.params, fp);
    resumeFn.type_params = d.type_params;

    // ctor: *Future<Tret> name(params) { fr = alloc<frameT>(1); init; resume(fr); return &fr.ret; }
    List<*StmtNode> ctor;
    List_init<*StmtNode>(&ctor, 8);
    List<*ExprNode> aa;
    List_init<*ExprNode>(&aa, 1);
    List_push<*ExprNode>(&aa, al_int(1));
    List_push<*StmtNode>(&ctor, mk_vardecl(al_frp, str_concat("*", frameT), al_tcall(str_concat("alloc<", str_concat(frameT, ">")), &aa), 0));
    List_push<*StmtNode>(&ctor, al_assign(al_fr(al_fst), al_int(0)));
    List_push<*StmtNode>(&ctor, al_assign(al_fr(al_fawt), mk_cast("*FutureHdr", al_int(0))));
    List_push<*StmtNode>(&ctor, al_assign(al_member(al_fr(al_fret), "state"), al_int(0)));
    List_push<*StmtNode>(&ctor, al_assign(al_member(al_fr(al_fret), "waker"), al_waker_noop()));
    List_push<*StmtNode>(&ctor, al_assign(al_member(al_fr(al_fret), "on_drop"), al_ondrop(&c)));
    pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        Param p = List_get<Param>(&d.params, pi);
        List_push<*StmtNode>(&ctor, al_assign(al_fr(p.name), mk_ident(p.name)));
        pi = pi + 1;
    }
    List_push<*StmtNode>(&ctor, al_exprstmt(al_resume_call(resumeN)));
    List_push<*StmtNode>(&ctor, al_return(mk_un("&", al_member(mk_ident(al_frp), al_fret))));
    *DeclNode ctorFn = new_decl(DK_FUNCTION);
    ctorFn.name = name;
    ctorFn.ret_type = str_concat("*Future<", str_concat(Tret, ">"));
    ctorFn.body = al_block(&ctor);
    List_init<Param>(&ctorFn.params, 2);
    pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        List_push<Param>(&ctorFn.params, List_get<Param>(&d.params, pi));
        pi = pi + 1;
    }
    // The frame retains every closure param (the resume calls it after the call returns),
    // so each escapes even when the async fn only calls it.
    List_init<int>(&ctorFn.param_escaping, 2);
    pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        int pesc = 0;
        if (pi < List_len<int>(&d.param_escaping)) {
            pesc = List_get<int>(&d.param_escaping, pi);
        }
        if (ast_has_prefix(List_get<Param>(&d.params, pi).ty, "fn(") == 1) {
            pesc = 1;
        }
        List_push<int>(&ctorFn.param_escaping, pesc);
        pi = pi + 1;
    }
    ctorFn.type_params = d.type_params;

    // frame struct
    *DeclNode frameD = new_decl(DK_STRUCT);
    frameD.name = frameName;
    frameD.type_params = d.type_params;
    List_init<Param>(&frameD.params, List_len<Param>(&c.fields));
    int ff = 0;
    while (ff < List_len<Param>(&c.fields)) {
        List_push<Param>(&frameD.params, List_get<Param>(&c.fields, ff));
        ff = ff + 1;
    }

    List_push<*DeclNode>(out, frameD);
    List_push<*DeclNode>(out, resumeFn);
    List_push<*DeclNode>(out, ctorFn);
}

// A no-op `void(){}` waker lambda.
*ExprNode al_waker_noop() {
    List<*StmtNode> empty;
    List_init<*StmtNode>(&empty, 1);
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_LAMBDA;
    e.sval = "void()";
    e.stmt = al_block(&empty);
    return e;
}

// The cancellation closure: `void() { if (fr.awaiting != (*FutureHdr)0) Future_drop(fr.awaiting);
// <cleanups> }` (captures fr). Run by Future_drop when a suspended async function is cancelled: it
// cascade-drops the future being awaited, then resumes into the cleanup state of the await it is
// parked at (its pending defers and finally blocks); Future_drop then frees the frame (== &fr.ret)
// and this env.
*ExprNode al_ondrop(*AlCtx c) {
    List<*ExprNode> da;
    List_init<*ExprNode>(&da, 1);
    List_push<*ExprNode>(&da, al_fr(al_fawt));
    List<*StmtNode> drop;
    List_init<*StmtNode>(&drop, 1);
    List_push<*StmtNode>(&drop, al_exprstmt(al_call("Future_drop", &da)));
    List<*StmtNode> body;
    List_init<*StmtNode>(&body, 1);
    List_push<*StmtNode>(&body, al_if(mk_bin("!=", al_fr(al_fawt), mk_cast("*FutureHdr", al_int(0))), al_block(&drop), null));
    // Parked where no cleanup is pending, the frame's end runs from here.
    *StmtNode cleanup = null;
    if (List_len<*StmtNode>(&al_exc_free.items) > 0) {
        cleanup = al_exc_free;
    }
    int di = List_len<int>(&c.drop_from) - 1;
    while (di >= 0) {
        List<*StmtNode> go;
        List_init<*StmtNode>(&go, 3);
        if (List_get<int>(&c.drop_det, di) == 1) {          // the cleanup awaits: it runs detached
            List<*ExprNode> sa;
            List_init<*ExprNode>(&sa, 2);
            List_push<*ExprNode>(&sa, mk_un("&", al_member(al_fr(al_fret), "state")));
            List_push<*ExprNode>(&sa, al_int(4));
            List_push<*StmtNode>(&go, al_exprstmt(al_call("atomic_store", &sa)));
        }
        List_push<*StmtNode>(&go, al_assign(al_fr(al_fst), al_int(List_get<int>(&c.drop_to, di))));
        List_push<*StmtNode>(&go, al_exprstmt(al_resume_call(c.resumeN)));
        cleanup = al_if(mk_bin("==", al_fr(al_fst), al_int(List_get<int>(&c.drop_from, di))), al_block(&go), cleanup);
        di = di - 1;
    }
    if (cleanup != null) {
        List_push<*StmtNode>(&body, cleanup);
    }
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_LAMBDA;
    e.sval = "void()";
    e.stmt = al_block(&body);
    return e;
}

// A call through an expression callee (e.g. `fr.ret.waker()`).
*ExprNode al_call_on(*ExprNode callee, List<*ExprNode>* args) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_CALL;
    e.a = callee;
    List_init<*ExprNode>(&e.kids, 1);
    int i = 0;
    while (i < List_len<*ExprNode>(args)) {
        List_push<*ExprNode>(&e.kids, List_get<*ExprNode>(args, i));
        i = i + 1;
    }
    return e;
}

// Does an expression contain an `await` anywhere?
int al_expr_has_await(*ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_AWAIT) {
        return 1;
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        if (al_expr_has_await(List_get<*ExprNode>(&ch, i)) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// The first await in an expression / statement subtree (source order), or null: the
// position an unsupported await is reported at.
*ExprNode al_first_await_e(*ExprNode e) {
    if (e == null) {
        return null;
    }
    if (e.kind == EK_AWAIT) {
        return e;
    }
    List<*ExprNode> ch;
    List_init<*ExprNode>(&ch, 4);
    al_children(e, &ch);
    int i = 0;
    while (i < List_len<*ExprNode>(&ch)) {
        *ExprNode a = al_first_await_e(List_get<*ExprNode>(&ch, i));
        if (a != null) {
            return a;
        }
        i = i + 1;
    }
    return null;
}

// The first await anywhere in a statement subtree.
*ExprNode al_any_await_s(*StmtNode s) {
    if (s == null) {
        return null;
    }
    *ExprNode a = al_first_await_e(s.expr);
    if (a != null) {
        return a;
    }
    a = al_first_await_e(s.expr2);
    if (a != null) {
        return a;
    }
    a = al_any_await_s(s.s1);
    if (a != null) {
        return a;
    }
    a = al_any_await_s(s.s2);
    if (a != null) {
        return a;
    }
    int i = 0;
    while (i < List_len<*StmtNode>(&s.items)) {
        a = al_any_await_s(List_get<*StmtNode>(&s.items, i));
        if (a != null) {
            return a;
        }
        i = i + 1;
    }
    return null;
}

// Does a statement subtree contain an await anywhere (recursing control flow)?
int al_stmt_has_await_deep(*StmtNode s) {
    if (s == null) {
        return 0;
    }
    if (al_expr_has_await(s.expr) == 1 || al_expr_has_await(s.expr2) == 1) {
        return 1;
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_DOWHILE || s.kind == SK_DEFER || s.kind == SK_TRY) {
        if (al_stmt_has_await_deep(s.s1) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) {
        if (al_stmt_has_await_deep(s.s2) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            if (al_stmt_has_await_deep(List_get<*StmtNode>(&s.items, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

// True if a statement contains a labeled `break`/`continue` anywhere. Async bodies are
// always state-split, and a labeled jump can't be threaded through the resume state
// machine, so we reject it (mirrors the C++ AsyncTransform guard).
int al_stmt_has_labeled_break(*StmtNode s) {
    if (s == null) {
        return 0;
    }
    if (s.kind == SK_BREAK || s.kind == SK_CONTINUE) {
        if (s.label != null && s.label[0] != 0) {
            return 1;
        }
        return 0;
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_DOWHILE || s.kind == SK_TRY) {
        if (al_stmt_has_labeled_break(s.s1) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) {
        if (al_stmt_has_labeled_break(s.s2) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            if (al_stmt_has_labeled_break(List_get<*StmtNode>(&s.items, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

// Rewrite every async function into a frame struct, a resume function and a constructor.
void async_lower(*Program prog) {
    List<*DeclNode> out;
    List_init<*DeclNode>(&out, List_len<*DeclNode>(&prog.decls));
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && d.is_async == 1 && d.body != null
            && al_stmt_has_labeled_break(d.body) == 1) {
            dprintf(2, "error: async function '%s': labeled 'break'/'continue' is not supported inside an async function\n", d.name);
            exit(1);
        }
        if (d.kind == DK_FUNCTION && d.is_async == 1 && d.body != null) {
            al_transform(prog, d, &out);
        } else {
            List_push<*DeclNode>(&out, d);
        }
        i = i + 1;
    }
    prog.decls = out;
}
