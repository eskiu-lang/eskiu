// diag_json.esk: `--diagnostics=json`, the diagnostics as JSON lines on stderr (C++
// diag_json.cpp, byte for byte). The compiler prints every diagnostic in its text form
// where it is raised; in JSON mode the driver runs in a child process whose stderr is a
// pipe, and the parent turns each `error:` / `warning:` / `note:` line it reads into one
// JSON object (dj_line), so the JSON form carries the same diagnostics as the text form.
// Format and id scheme: docs/dev/diagnostics.md.

import <string>;
import <fs>;

extern int dup(int fd);
extern int64 write(int fd, *void buf, int64 n);
extern int64 read(int fd, *void buf, int64 n);
extern int pipe(*int fds);
extern int dup2(int from, int to);
extern int close(int fd);
extern int fork();
extern int waitpid(int pid, *int status, int options);

int g_diag_json = 0;       // 1 in the child of a --diagnostics=json run (no summary lines)
int g_diag_stderr = -1;    // the real stderr there: programs the driver runs write to it

struct DjNote {
    string message;
    string file;
    int line;
    int col;
}

struct DjDiag {
    string severity;
    string message;
    string file;
    string option;
    int line;
    int col;
    int end_line;
    int end_col;
    List<string> hints;
    List<DjNote> notes;
}

struct DjSrc {
    string file;
    List<String> lines;
}

int dj_have = 0;           // a diagnostic is held back in dj_pending (notes may follow)
DjDiag dj_pending;
List<DjSrc> dj_srcs;

int dj_alpha(int c) {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ? 1 : 0;
}

int dj_digit(int c) {
    return c >= 48 && c <= 57 ? 1 : 0;
}

int dj_alnum(int c) {
    return dj_alpha(c) == 1 || dj_digit(c) == 1 ? 1 : 0;
}

int dj_ident(int c) {
    return dj_alnum(c) == 1 || c == 95 ? 1 : 0;
}

int dj_len(string s) {
    int n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    return n;
}

string dj_sub(string s, int a, int b) {
    *char out = alloc<char>((int64)(b - a + 1));
    int i = a;
    while (i < b) {
        out[i - a] = s[i];
        i = i + 1;
    }
    return (string)out;
}

int dj_streq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i = i + 1;
    }
    return a[i] == b[i] ? 1 : 0;
}

int dj_starts(string s, string p) {
    int i = 0;
    while (p[i] != 0) {
        if (s[i] != p[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// The last index of `p` in `s`, or -1.
int dj_rfind(string s, string p) {
    int n = dj_len(s);
    int m = dj_len(p);
    int i = n - m;
    while (i >= 0) {
        if (dj_starts(dj_sub(s, i, n), p) == 1) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

int dj_atoi(string s, int a, int b) {
    int v = 0;
    int i = a;
    while (i < b) {
        v = v * 10 + ((int)s[i] - 48);
        i = i + 1;
    }
    return v;
}

// `word` or `word-word...`: letters only.
int dj_id_word(string w) {
    int n = dj_len(w);
    if (n == 0 || dj_alpha((int)w[0]) == 0 || dj_alpha((int)w[n - 1]) == 0) {
        return 0;
    }
    int i = 0;
    while (i < n) {
        int c = (int)w[i];
        if (dj_alpha(c) == 0 && (c != 45 || dj_alpha((int)w[i + 1]) == 0)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// The stable id of a diagnostic message (C++ diagnosticId; docs/dev/diagnostics.md).
string diag_id(string message, string severity) {
    string m = message;
    List<string> pre;
    List_init<string>(&pre, 3);
    List_push<string>(&pre, "initializing '");
    List_push<string>(&pre, "In struct '");
    List_push<string>(&pre, "In union '");
    int pi = 0;
    while (pi < 3) {
        string p = List_get<string>(&pre, pi);
        pi = pi + 1;
        if (dj_starts(m, p) == 1) {
            int j = dj_len(p);
            int mn = dj_len(m);
            while (j + 2 < mn && !(m[j] == '\'' && m[j + 1] == ':' && m[j + 2] == ' ')) {
                j = j + 1;
            }
            if (j + 2 < mn) {
                m = dj_sub(m, j + 3, mn);
            }
            break;
        }
    }
    List<string> words;
    List_init<string>(&words, 8);
    String cur;
    String_init(&cur, 16);
    int n = dj_len(m);
    int i = 0;
    while (i < n) {
        char c = m[i];
        if (c == '\'' && (i == 0 || dj_alnum((int)m[i - 1]) == 0)) {   // a quoted name, type or value
            int j = i + 1;
            while (j < n && !(m[j] == '\'' && (j + 1 == n || dj_alnum((int)m[j + 1]) == 0))) {
                j = j + 1;
            }
            if (j >= n) {
                break;
            }
            List_push<string>(&words, dj_sub(cur.data, 0, (int)cur.len));
            String_clear(&cur);
            i = j + 1;
            continue;
        }
        if (c == ':' || c == ';' || c == ',' || c == '(') {
            break;
        }
        if (c == ' ' || c == '\t') {
            List_push<string>(&words, dj_sub(cur.data, 0, (int)cur.len));
            String_clear(&cur);
            i = i + 1;
            continue;
        }
        if (c != '`') {
            String_push(&cur, c);
        }
        i = i + 1;
    }
    List_push<string>(&words, dj_sub(cur.data, 0, (int)cur.len));
    String id;
    String_init(&id, 32);
    int kept = 0;
    int wi = 0;
    while (wi < List_len<string>(&words)) {
        string w = List_get<string>(&words, wi);
        wi = wi + 1;
        int wn = dj_len(w);
        if (wn >= 2 && w[wn - 2] == '\'' && w[wn - 1] == 's') {
            w = dj_sub(w, 0, wn - 2);
            wn = wn - 2;
        }
        if (wn > 0 && w[0] == '#') {
            w = dj_sub(w, 1, wn);
            wn = wn - 1;
        }
        if (dj_id_word(w) == 0) {
            continue;
        }
        String lw;
        String_init(&lw, (int64)(wn + 1));
        int k = 0;
        while (k < wn) {
            int ch = (int)w[k];
            if (ch >= 65 && ch <= 90) {
                ch = ch + 32;
            }
            String_push(&lw, (char)ch);
            k = k + 1;
        }
        if (dj_streq(lw.data, "a") == 1 || dj_streq(lw.data, "an") == 1 || dj_streq(lw.data, "the") == 1) {
            continue;
        }
        if (kept > 0) {
            String_push(&id, '-');
        }
        String_append(&id, lw.data);
        kept = kept + 1;
        if (kept == 5) {
            break;
        }
    }
    if (kept == 0) {
        return severity;
    }
    return id.data;
}

// `FILE:LINE:COL: ` at the start of `s`: the first `:<digits>:<digits>: ` after a
// non-empty file name.
int dj_split_loc(string s, *string file, *int line, *int col, *string rest) {
    int n = dj_len(s);
    int p = 1;
    while (p < n) {
        if (s[p] != ':') {
            p = p + 1;
            continue;
        }
        int i = p + 1;
        int a = i;
        while (i < n && dj_digit((int)s[i]) == 1) {
            i = i + 1;
        }
        if (i == a || i >= n || s[i] != ':') {
            p = p + 1;
            continue;
        }
        i = i + 1;
        int b = i;
        while (i < n && dj_digit((int)s[i]) == 1) {
            i = i + 1;
        }
        if (i == b || i + 1 >= n || s[i] != ':' || s[i + 1] != ' ' || i - a > 9 || i - b > 9) {
            p = p + 1;
            continue;
        }
        *file = dj_sub(s, 0, p);
        *line = dj_atoi(s, a, b - 1);
        *col = dj_atoi(s, b, i);
        *rest = dj_sub(s, i + 2, n);
        return 1;
    }
    return 0;
}

void dj_json_string(String* o, string s) {
    string hex = "0123456789abcdef";
    String_push(o, '"');
    int i = 0;
    while (s[i] != 0) {
        int c = (int)(uint8)s[i];
        i = i + 1;
        if (c == 34) {
            String_append(o, "\\\"");
        } else if (c == 92) {
            String_append(o, "\\\\");
        } else if (c == 10) {
            String_append(o, "\\n");
        } else if (c == 9) {
            String_append(o, "\\t");
        } else if (c == 13) {
            String_append(o, "\\r");
        } else if (c < 32) {
            String_append(o, "\\u00");
            String_push(o, hex[c >> 4]);
            String_push(o, hex[c & 15]);
        } else {
            String_push(o, (char)c);
        }
    }
    String_push(o, '"');
}

void dj_int(String* o, int v) {
    uint8[16] b;
    int n = 0;
    if (v == 0) {
        String_push(o, '0');
        return;
    }
    while (v > 0) {
        b[n] = (uint8)(48 + v % 10);
        v = v / 10;
        n = n + 1;
    }
    while (n > 0) {
        n = n - 1;
        String_push(o, (char)b[n]);
    }
}

void dj_emit(DjDiag* d, string fixed_id) {
    String o;
    String_init(&o, 256);
    String_append(&o, "{\"severity\":");
    dj_json_string(&o, d.severity);
    String_append(&o, ",\"id\":");
    if (fixed_id[0] != 0) {
        dj_json_string(&o, fixed_id);
    } else {
        dj_json_string(&o, diag_id(d.message, d.severity));
    }
    String_append(&o, ",\"message\":");
    dj_json_string(&o, d.message);
    if (d.line > 0) {
        String_append(&o, ",\"file\":");
        dj_json_string(&o, d.file);
        String_append(&o, ",\"line\":");
        dj_int(&o, d.line);
        String_append(&o, ",\"col\":");
        dj_int(&o, d.col);
        if (d.end_line > 0) {
            String_append(&o, ",\"end_line\":");
            dj_int(&o, d.end_line);
            String_append(&o, ",\"end_col\":");
            dj_int(&o, d.end_col);
        }
    }
    if (d.option[0] != 0) {
        String_append(&o, ",\"option\":");
        dj_json_string(&o, d.option);
    }
    String_append(&o, ",\"hints\":[");
    int i = 0;
    while (i < List_len<string>(&d.hints)) {
        if (i > 0) {
            String_push(&o, ',');
        }
        dj_json_string(&o, List_get<string>(&d.hints, i));
        i = i + 1;
    }
    String_append(&o, "],\"notes\":[");
    i = 0;
    while (i < List_len<DjNote>(&d.notes)) {
        DjNote nt = List_get<DjNote>(&d.notes, i);
        if (i > 0) {
            String_push(&o, ',');
        }
        String_append(&o, "{\"message\":");
        dj_json_string(&o, nt.message);
        if (nt.line > 0) {
            String_append(&o, ",\"file\":");
            dj_json_string(&o, nt.file);
            String_append(&o, ",\"line\":");
            dj_int(&o, nt.line);
            String_append(&o, ",\"col\":");
            dj_int(&o, nt.col);
        }
        String_push(&o, '}');
        i = i + 1;
    }
    String_append(&o, "]}\n");
    write(2, (*void)o.data, o.len);
}

DjDiag dj_new(string severity, string message) {
    DjDiag d;
    d.severity = severity;
    d.message = message;
    d.file = "";
    d.option = "";
    List_init<string>(&d.hints, 1);
    List_init<DjNote>(&d.notes, 1);
    return d;
}

// ` [-Wname]` at the end is the option; ` (did you mean 'x'?)` a hint.
void dj_split_message(DjDiag* d) {
    string m = d.message;
    int n = dj_len(m);
    int ob = dj_rfind(m, " [-W");
    if (ob >= 0 && n > 0 && m[n - 1] == ']') {
        string opt = dj_sub(m, ob + 2, n - 1);
        int on = dj_len(opt);
        int ok = on > 2 ? 1 : 0;
        int i = 2;
        while (i < on) {
            int c = (int)opt[i];
            if (!(dj_alnum(c) == 1 || c == 45 || c == 61)) {
                ok = 0;
            }
            i = i + 1;
        }
        if (ok == 1) {
            d.option = opt;
            m = dj_sub(m, 0, ob);
            n = ob;
        }
    }
    int hp = dj_rfind(m, " (did you mean '");
    if (hp >= 0 && n >= 2 && m[n - 2] == '?' && m[n - 1] == ')') {
        List_push<string>(&d.hints, dj_sub(m, hp + 2, n - 1));
        m = dj_sub(m, 0, hp);
    }
    d.message = m;
}

// The token at the diagnostic's position: an identifier or keyword, a number or a
// string literal. end_col is the column just past it.
void dj_token_range(DjDiag* d) {
    if (d.line <= 0 || d.col <= 0) {
        return;
    }
    int si = -1;
    int k = 0;
    while (k < List_len<DjSrc>(&dj_srcs)) {
        if (dj_streq(List_get<DjSrc>(&dj_srcs, k).file, d.file) == 1) {
            si = k;
        }
        k = k + 1;
    }
    if (si < 0) {
        DjSrc src;
        src.file = d.file;
        List_init<String>(&src.lines, 64);
        fs_read_lines(d.file, &src.lines);
        List_push<DjSrc>(&dj_srcs, src);
        si = List_len<DjSrc>(&dj_srcs) - 1;
    }
    DjSrc src = List_get<DjSrc>(&dj_srcs, si);
    if (d.line > List_len<String>(&src.lines)) {
        return;
    }
    String ls = List_get<String>(&src.lines, d.line - 1);
    string s = ls.data;
    int n = (int)ls.len;
    int i = d.col - 1;
    int j = i;
    if (i >= n) {
        return;
    }
    int c = (int)s[i];
    if (dj_alpha(c) == 1 || c == 95) {
        while (j < n && dj_ident((int)s[j]) == 1) {
            j = j + 1;
        }
    } else if (dj_digit(c) == 1) {
        while (j < n && (dj_ident((int)s[j]) == 1 || s[j] == '.')) {
            j = j + 1;
        }
    } else if (c == 34) {
        j = j + 1;
        while (j < n && s[j] != '"') {
            if (s[j] == '\\') {
                j = j + 2;
            } else {
                j = j + 1;
            }
        }
        if (j >= n) {
            return;
        }
        j = j + 1;
    } else {
        return;
    }
    d.end_line = d.line;
    d.end_col = j + 1;
}

void dj_flush() {
    if (dj_have == 0) {
        return;
    }
    dj_emit(&dj_pending, "");
    dj_have = 0;
}

// One line of the text form.
void dj_line(string line) {
    int n = dj_len(line);
    if (n > 0 && line[n - 1] == '\r') {
        line = dj_sub(line, 0, n - 1);
        n = n - 1;
    }
    if (n == 0) {
        return;
    }
    string sev = "";
    string rest = "";
    string file = "";
    int ln = 0;
    int col = 0;
    int located = 0;
    List<string> sevs;
    List_init<string>(&sevs, 3);
    List_push<string>(&sevs, "error");
    List_push<string>(&sevs, "warning");
    List_push<string>(&sevs, "note");
    int k = 0;
    while (k < 3) {
        string sv = List_get<string>(&sevs, k);
        k = k + 1;
        int sn = dj_len(sv);
        if (dj_starts(line, sv) == 1 && line[sn] == ':' && line[sn + 1] == ' ') {
            sev = sv;
            rest = dj_sub(line, sn + 2, n);
            string msg = "";
            if (dj_split_loc(rest, &file, &ln, &col, &msg) == 1) {
                located = 1;
                rest = msg;
            }
            break;
        }
    }
    if (sev[0] == 0) {
        string msg = "";
        if (dj_split_loc(line, &file, &ln, &col, &msg) == 1) {
            k = 0;
            while (k < 3) {
                string sv = List_get<string>(&sevs, k);
                k = k + 1;
                int sn = dj_len(sv);
                if (dj_starts(msg, sv) == 1 && msg[sn] == ':' && msg[sn + 1] == ' ') {
                    sev = sv;
                    rest = dj_sub(msg, sn + 2, dj_len(msg));
                    located = 1;
                    break;
                }
            }
        }
    }
    if (sev[0] == 0) {                     // not a diagnostic: the text of the one before
        if (dj_have == 1) {
            DjNote nt;
            nt.message = line;
            nt.file = "";
            List_push<DjNote>(&dj_pending.notes, nt);
            return;
        }
        DjDiag od = dj_new("note", line);
        dj_emit(&od, "output");
        return;
    }
    if (located == 0) {
        file = "";
        ln = 0;
        col = 0;
    }
    if (dj_streq(sev, "note") == 1 && dj_have == 1) {
        DjNote nt;
        nt.message = rest;
        nt.file = file;
        nt.line = ln;
        nt.col = col;
        List_push<DjNote>(&dj_pending.notes, nt);
        return;
    }
    dj_flush();
    DjDiag d = dj_new(sev, rest);
    if (located == 1) {
        d.file = file;
        d.line = ln;
        d.col = col;
    }
    dj_split_message(&d);
    if (located == 1) {
        dj_token_range(&d);
    }
    if (dj_streq(sev, "note") == 1) {
        dj_emit(&d, "");
        return;
    }
    dj_pending = d;
    dj_have = 1;
}

// `--diagnostics=json` (or `--diagnostics json`) among the arguments.
int diag_json_wanted(int argc, string* argv) {
    int i = 1;
    while (i < argc) {
        string a = argv[i];
        if (dj_streq(a, "--diagnostics=json") == 1 || dj_streq(a, "-diagnostics=json") == 1) {
            return 1;
        }
        if ((dj_streq(a, "--diagnostics") == 1 || dj_streq(a, "-diagnostics") == 1) && i + 1 < argc
            && dj_streq(argv[i + 1], "json") == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Run the driver in a child whose stderr is a pipe, and write what it prints there as
// JSON lines. Returns -1 in the child (it goes on as the driver), else the child's exit
// code (128 + N when signal N ended it).
int diag_json_fork() {
    let fds: int[2];
    if (pipe(&fds[0]) != 0) {
        return -1;
    }
    int pid = fork();
    if (pid < 0) {
        close(fds[0]);
        close(fds[1]);
        return -1;
    }
    if (pid == 0) {
        g_diag_stderr = dup(2);
        dup2(fds[1], 2);
        close(fds[0]);
        close(fds[1]);
        g_diag_json = 1;
        return -1;
    }
    close(fds[1]);
    List_init<DjSrc>(&dj_srcs, 4);
    String part;
    String_init(&part, 256);
    *uint8 buf = alloc<uint8>((int64)4096);
    while (true) {
        int64 got = read(fds[0], (*void)buf, (int64)4096);
        if (got <= 0) {
            break;
        }
        int64 i = 0;
        while (i < got) {
            if (buf[i] == (uint8)10) {
                dj_line(dj_sub(part.data, 0, (int)part.len));
                String_clear(&part);
            } else {
                String_push(&part, (char)buf[i]);
            }
            i = i + 1;
        }
    }
    close(fds[0]);
    if (part.len > 0) {
        dj_line(dj_sub(part.data, 0, (int)part.len));
    }
    dj_flush();
    let st: int = 0;
    if (waitpid(pid, &st, 0) < 0) {
        return 1;
    }
    int sig = st & 127;
    if (sig == 0) {
        return (st >> 8) & 255;
    }
    return 128 + sig;
}

// In a program the driver runs (clang, the linker, a `run` script): the real stderr.
void diag_json_restore_stderr() {
    if (g_diag_stderr >= 0) {
        dup2(g_diag_stderr, 2);
    }
}
