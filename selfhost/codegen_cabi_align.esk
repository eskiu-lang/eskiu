// codegen_cabi_align.esk: packed access alignment and type-based alias information (part of codegen_cabi.esk, imported in order)

// ---- Alignment of accesses inside packed structs (C++ CodeGen::alignPackedAccesses) ----
// A field of a packed struct (packed, #pragma pack, or a struct inside one) may sit at an
// address its type's alignment does not divide, and a load or store with no `align` gets
// the type's ABI alignment. Each access through a GEP chain that crosses a packed struct
// (`<{ … }>`) gets the alignment the chain proves: the base's (its own chain's, else the
// C alignment of the GEP's source type), lowered by each field offset and element stride.

// The end of the LLVM type starting at s[p]: the first `,` outside brackets (or the end).
int cg_ap_type_end(string s, int p) {
    int depth = 0;
    while (s[p] != 0) {
        int c = (int)s[p];
        if (c == 123 || c == 91 || c == 60 || c == 40) {
            depth = depth + 1;
        } else if (c == 125 || c == 93 || c == 62 || c == 41) {
            depth = depth - 1;
        } else if (c == 44 && depth == 0) {
            return p;
        }
        p = p + 1;
    }
    return p;
}

// The end of the token starting at s[p]: the next `,` or the end of the line.
int cg_ap_tok_end(string s, int p) {
    while (s[p] != 0 && (int)s[p] != 44) {
        p = p + 1;
    }
    return p;
}

// `a` lowered to what an offset of `off` bytes from an `a`-aligned address keeps.
int cg_ap_lower(int a, int64 off) {
    if (off == 0) {
        return a;
    }
    int64 low = off & (0 - off);
    if (low < 0) {
        low = 0 - low;
    }
    return low < (int64)a ? (int)low : a;
}

// Index of the last occurrence of `pat` in `s`, or -1.
int cg_ap_last(string s, string pat) {
    int n = (int)strlen(s);
    int m = (int)strlen(pat);
    int i = n - m;
    while (i >= 0) {
        if (strncmp((string)((*char)s + i), pat, (size_t)m) == 0) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

// Index of the first occurrence of `pat` in `s` at or after `from`, or -1.
int cg_ap_find(string s, string pat, int from) {
    *char hit = strstr((string)((*char)s + from), pat);
    if (hit == null) {
        return -1;
    }
    return (int)((int64)hit - (int64)s);
}

// The proven alignment recorded for the SSA value `name`, or -1.
int cg_ap_known(List<CgSub>* known, string name) {
    int i = List_len<CgSub>(known) - 1;
    while (i >= 0) {
        CgSub c = List_get<CgSub>(known, i);
        if (cg_streq(c.param, name) == 1) {
            return atoi(c.arg);
        }
        i = i - 1;
    }
    return -1;
}

// The type of field `k` of the struct body `{ … }` / `<{ … }>`.
string cg_ap_field_ty(string body, int k) {
    int p = 0;
    while ((int)body[p] == 32 || (int)body[p] == 60) {
        p = p + 1;
    }
    p = p + 1;   // `{`
    int i = 0;
    while (body[p] != 0) {
        while ((int)body[p] == 32) {
            p = p + 1;
        }
        int e = cg_ap_type_end(body, p);
        if (i == k) {
            string t = cg_trim(cg_sub_str(body, p, e));
            int n = (int)strlen(t);
            while (n > 0 && ((int)t[n - 1] == 125 || (int)t[n - 1] == 62 || (int)t[n - 1] == 32)) {
                n = n - 1;
            }
            return cg_sub_str(t, 0, n);
        }
        if (body[e] == 0) {
            return "";
        }
        p = e + 1;
        i = i + 1;
    }
    return "";
}

// A GEP line `%r = getelementptr [inbounds] T, ptr %b, i? x, …`: record %r's proven
// alignment when the chain crosses a packed struct.
void cg_ap_gep(Codegen* g, string line, List<CgSub>* known) {
    int p = 0;
    while ((int)line[p] == 32) {
        p = p + 1;
    }
    int ne = cg_ap_find(line, " = getelementptr ", p);
    string name = cg_sub_str(line, p, ne);
    int q = ne + 17;
    if (cg_has_prefix((string)((*char)line + q), "inbounds ") == 1) {
        q = q + 9;
    }
    int te = cg_ap_type_end(line, q);
    string cur = cg_trim(cg_sub_str(line, q, te));
    if (line[te] == 0) {
        return;
    }
    int bp = te + 2;
    if (cg_has_prefix((string)((*char)line + bp), "ptr ") == 0) {
        return;
    }
    bp = bp + 4;
    int be = cg_ap_tok_end(line, bp);
    int a = cg_ap_known(known, cg_trim(cg_sub_str(line, bp, be)));
    int pk = 0;
    if (a >= 0) {
        pk = 1;
    } else {
        a = cg_c_align(g, cur);
    }
    int ip = be;
    int first = 1;
    while (line[ip] != 0) {
        ip = ip + 1;                                   // the `,`
        while ((int)line[ip] == 32) {
            ip = ip + 1;
        }
        while (line[ip] != 0 && (int)line[ip] != 32) { // the index type
            ip = ip + 1;
        }
        while ((int)line[ip] == 32) {
            ip = ip + 1;
        }
        int ve = cg_ap_tok_end(line, ip);
        string v = cg_trim(cg_sub_str(line, ip, ve));
        ip = ve;
        int isc = ((int)v[0] >= 48 && (int)v[0] <= 57) || (int)v[0] == 45 ? 1 : 0;
        int64 c = isc == 1 ? (int64)atoi(v) : 0;
        if (first == 1) {
            int64 stride = (int64)cg_ll_size_of(g, cur);
            a = cg_ap_lower(a, isc == 1 ? stride * c : stride);
            first = 0;
            continue;
        }
        string body = cur;
        if ((int)cur[0] == 37) {
            body = cg_tydef_body(g, cg_sub_str(cur, 1, (int)strlen(cur)));
        }
        if ((int)body[0] == 123 || ((int)body[0] == 60 && (int)body[1] == 123)) {
            if ((int)body[0] == 60) {
                pk = 1;
            }
            if (isc == 0) {
                a = 1;
                break;
            }
            a = cg_ap_lower(a, (int64)cg_elem_offset(g, body, (int)c));
            cur = cg_ap_field_ty(body, (int)c);
        } else if ((int)body[0] == 91) {
            int xp = cg_ap_find(body, " x ", 0);
            string elem = cg_trim(cg_sub_str(body, xp + 3, (int)strlen(body) - 1));
            int64 stride = (int64)cg_ll_size_of(g, elem);
            a = cg_ap_lower(a, isc == 1 ? stride * c : stride);
            cur = elem;
        } else {
            a = 1;
            break;
        }
    }
    if (pk == 1) {
        let k: CgSub;
        k.param = name;
        k.arg = cg_itoa(a);
        List_push<CgSub>(known, k);
    }
}

// A load or store line through a recorded pointer: its `align` lowered to the proven one.
string cg_ap_access(Codegen* g, string line, List<CgSub>* known) {
    int pp = cg_ap_last(line, ", ptr ");
    if (pp < 0) {
        return line;
    }
    int oe = cg_ap_tok_end(line, pp + 6);
    int a = cg_ap_known(known, cg_trim(cg_sub_str(line, pp + 6, oe)));
    if (a < 0) {
        return line;
    }
    int cur = 0;
    int ap = cg_ap_find(line, ", align ", oe);
    if (ap >= 0) {
        cur = atoi((string)((*char)line + ap + 8));
    } else {
        int tp = cg_ap_find(line, "load ", 0);
        if (tp >= 0) {
            tp = tp + 5;
        } else {
            tp = cg_ap_find(line, "store ", 0) + 6;
        }
        if (cg_has_prefix((string)((*char)line + tp), "volatile ") == 1) {
            tp = tp + 9;
        }
        int te = tp;
        int depth = 0;
        while (line[te] != 0) {
            int ch = (int)line[te];
            if (ch == 123 || ch == 91 || ch == 60) {
                depth = depth + 1;
            } else if (ch == 125 || ch == 93 || ch == 62) {
                depth = depth - 1;
            } else if ((ch == 44 || ch == 32) && depth == 0) {
                break;
            }
            te = te + 1;
        }
        cur = cg_ll_align_of(g, cg_sub_str(line, tp, te));
    }
    if (a >= cur) {
        return line;
    }
    string head = cg_sub_str(line, 0, oe);
    string tail = "";
    if (ap >= 0) {
        int ae = cg_ap_tok_end(line, ap + 2);
        tail = cg_sub_str(line, ae, (int)strlen(line));
    } else {
        tail = cg_sub_str(line, oe, (int)strlen(line));
    }
    return cg_cat(head, cg_cat(", align ", cg_cat(cg_itoa(a), tail)));
}

// Rewrite g.out: lower the alignment of every load and store inside a packed struct.
void cg_align_packed(Codegen* g) {
    if (cg_ap_find((string)String_cstr(&g.globals), "<{", 0) < 0) {
        return;                                        // no packed struct type: nothing to do
    }
    string text = (string)String_cstr(&g.out);
    let res: String;
    String_init(&res, g.out.len + 64);
    let known: List<CgSub>;
    List_init<CgSub>(&known, 16);
    int p = 0;
    while (text[p] != 0) {
        int e = p;
        while (text[e] != 0 && (int)text[e] != 10) {
            e = e + 1;
        }
        string line = cg_sub_str(text, p, e);
        if (cg_has_prefix(line, "define ") == 1) {
            List_clear<CgSub>(&known);
        } else if (cg_ap_find(line, " = getelementptr ", 0) >= 0) {
            cg_ap_gep(g, line, &known);
        } else if ((cg_ap_find(line, " = load ", 0) >= 0 || cg_has_prefix(cg_trim(line), "store ") == 1)
                   && cg_ap_find(line, " atomic ", 0) < 0 && List_len<CgSub>(&known) > 0) {
            line = cg_ap_access(g, line, &known);
        }
        String_append(&res, line);
        if (text[e] == 10) {
            String_push(&res, '\n');
            e = e + 1;
        }
        p = e;
    }
    g.out = res;
}

// ── -fstrict-aliasing: scalar type-based alias information (C++ addTypeBasedAliasInfo) ──
// A load or store of i16, i32, i64, float, double or ptr gets the tag of its type, all
// under "omnipotent char" (i8 and i1 accesses stay untagged and alias anything), when its
// pointer is typed for it: a GEP whose indexed type is the accessed one and whose chain
// does not start at an i8 GEP (a union member, byte arithmetic), an alloca or global of
// that type, or a pointer the IR does not show the target of (a parameter, a loaded
// pointer, a call result).

// The end of the type token starting at s[p]: the first space or `,` outside brackets.
int cg_tb_type_end(string s, int p) {
    int depth = 0;
    while (s[p] != 0) {
        int c = (int)s[p];
        if (c == 123 || c == 91 || c == 60 || c == 40) {
            depth = depth + 1;
        } else if (c == 125 || c == 93 || c == 62 || c == 41) {
            depth = depth - 1;
        } else if ((c == 44 || c == 32) && depth == 0) {
            return p;
        }
        p = p + 1;
    }
    return p;
}

// The tag name of an accessed LLVM type, or "" for an untagged one.
string cg_tb_name(string t) {
    if (cg_streq(t, "i16") == 1) {
        return "short";
    }
    if (cg_streq(t, "i32") == 1) {
        return "int";
    }
    if (cg_streq(t, "i64") == 1) {
        return "long long";
    }
    if (cg_streq(t, "float") == 1) {
        return "float";
    }
    if (cg_streq(t, "double") == 1) {
        return "double";
    }
    if (cg_streq(t, "ptr") == 1) {
        return "any pointer";
    }
    return "";
}

// What a pointer value is typed for, by its name: "T" for a value of type T, "" for one
// typed for nothing (an i8 GEP chain, a GEP the pass cannot follow). Absent: unknown target.
int cg_tb_lookup(List<CgSub>* known, string name) {
    int i = List_len<CgSub>(known) - 1;
    while (i >= 0) {
        if (cg_streq(List_get<CgSub>(known, i).param, name) == 1) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

void cg_tb_record(List<CgSub>* known, string name, string ty) {
    let k: CgSub;
    k.param = name;
    k.arg = ty;
    List_push<CgSub>(known, k);
}

// `%r = getelementptr [inbounds] T, ptr %b, i? x, …`: record the type %r points at.
void cg_tb_gep(Codegen* g, string line, List<CgSub>* known) {
    int p = 0;
    while ((int)line[p] == 32) {
        p = p + 1;
    }
    int ne = cg_ap_find(line, " = getelementptr ", p);
    string name = cg_sub_str(line, p, ne);
    int q = ne + 17;
    if (cg_has_prefix((string)((*char)line + q), "inbounds ") == 1) {
        q = q + 9;
    }
    int te = cg_ap_type_end(line, q);
    string cur = cg_trim(cg_sub_str(line, q, te));
    if (line[te] == 0 || cg_streq(cur, "i8") == 1) {
        cg_tb_record(known, name, "");
        return;
    }
    int bp = te + 2;
    if (cg_has_prefix((string)((*char)line + bp), "ptr ") == 0) {
        cg_tb_record(known, name, "");
        return;
    }
    bp = bp + 4;
    int be = cg_ap_tok_end(line, bp);
    int bi = cg_tb_lookup(known, cg_trim(cg_sub_str(line, bp, be)));
    if (bi >= 0 && List_get<CgSub>(known, bi).arg[0] == 0) {
        cg_tb_record(known, name, "");                 // the chain starts at an i8 GEP
        return;
    }
    int ip = be;
    int first = 1;
    while (line[ip] != 0) {
        ip = ip + 1;
        while ((int)line[ip] == 32) {
            ip = ip + 1;
        }
        while (line[ip] != 0 && (int)line[ip] != 32) {
            ip = ip + 1;
        }
        while ((int)line[ip] == 32) {
            ip = ip + 1;
        }
        int ve = cg_ap_tok_end(line, ip);
        string v = cg_trim(cg_sub_str(line, ip, ve));
        ip = ve;
        if (first == 1) {
            first = 0;
            continue;
        }
        string body = cur;
        if ((int)cur[0] == 37) {
            body = cg_tydef_body(g, cg_sub_str(cur, 1, (int)strlen(cur)));
        }
        int isc = ((int)v[0] >= 48 && (int)v[0] <= 57) ? 1 : 0;
        if ((int)body[0] == 123 || ((int)body[0] == 60 && (int)body[1] == 123)) {
            if (isc == 0) {
                cg_tb_record(known, name, "");
                return;
            }
            cur = cg_ap_field_ty(body, atoi(v));
        } else if ((int)body[0] == 91) {
            int xp = cg_ap_find(body, " x ", 0);
            cur = cg_trim(cg_sub_str(body, xp + 3, (int)strlen(body) - 1));
        } else {
            cg_tb_record(known, name, "");
            return;
        }
    }
    cg_tb_record(known, name, cur);
}

// The tag index (into `names`) for the access on `line`, or -1 to leave it untagged.
int cg_tb_access(string line, List<CgSub>* known, List<CgSub>* globals, List<string>* names) {
    int tp = cg_ap_find(line, " = load ", 0);
    string ty = "";
    if (tp >= 0) {
        tp = tp + 8;
        if (cg_has_prefix((string)((*char)line + tp), "volatile ") == 1) {
            tp = tp + 9;
        }
        ty = cg_trim(cg_sub_str(line, tp, cg_ap_type_end(line, tp)));
    } else {
        tp = cg_ap_find(line, "store ", 0) + 6;
        if (cg_has_prefix((string)((*char)line + tp), "volatile ") == 1) {
            tp = tp + 9;
        }
        ty = cg_sub_str(line, tp, cg_tb_type_end(line, tp));
    }
    string tag = cg_tb_name(ty);
    if (tag[0] == 0) {
        return -1;
    }
    int pp = cg_ap_last(line, ", ptr ");
    if (pp < 0) {
        return -1;
    }
    string ptr = cg_trim(cg_sub_str(line, pp + 6, cg_ap_tok_end(line, pp + 6)));
    if ((int)ptr[0] == 37) {
        int ki = cg_tb_lookup(known, ptr);
        if (ki >= 0 && cg_streq(List_get<CgSub>(known, ki).arg, ty) == 0) {
            return -1;
        }
    } else if ((int)ptr[0] == 64) {
        int gi = cg_tb_lookup(globals, ptr);
        if (gi < 0 || cg_streq(List_get<CgSub>(globals, gi).arg, ty) == 0) {
            return -1;
        }
    } else {
        return -1;                                     // a constant expression
    }
    int i = 0;
    while (i < List_len<string>(names)) {
        if (cg_streq(List_get<string>(names, i), tag) == 1) {
            return i;
        }
        i = i + 1;
    }
    List_push<string>(names, tag);
    return i;
}

// The value type of each global defined in `text` (`@g = … global|constant T …`).
void cg_tb_globals(string text, List<CgSub>* out) {
    int p = 0;
    while (text[p] != 0) {
        int e = p;
        while (text[e] != 0 && (int)text[e] != 10) {
            e = e + 1;
        }
        if ((int)text[p] == 64) {
            string line = cg_sub_str(text, p, e);
            int eq = cg_ap_find(line, " = ", 0);
            int gp = cg_ap_find(line, " global ", 0);
            int cp = cg_ap_find(line, " constant ", 0);
            int at = -1;
            if (gp >= 0 && (cp < 0 || gp < cp)) {
                at = gp + 8;
            } else if (cp >= 0) {
                at = cp + 10;
            }
            if (eq > 0 && at > eq) {
                cg_tb_record(out, cg_sub_str(line, 0, eq), cg_sub_str(line, at, cg_tb_type_end(line, at)));
            }
        }
        p = text[e] == 10 ? e + 1 : e;
    }
}

// The largest `!N` metadata number used in `text`, or -1.
int cg_tb_max_md(string text) {
    int best = -1;
    int p = 0;
    while (text[p] != 0) {
        if ((int)text[p] == 33 && (int)text[p + 1] >= 48 && (int)text[p + 1] <= 57) {
            int n = atoi((string)((*char)text + p + 1));
            if (n > best) {
                best = n;
            }
        }
        p = p + 1;
    }
    return best;
}

// Rewrite g.out: tag every typed scalar load and store, and add the metadata.
void cg_tbaa(Codegen* g) {
    let globals: List<CgSub>;
    List_init<CgSub>(&globals, 16);
    cg_tb_globals((string)String_cstr(&g.globals), &globals);
    string text = (string)String_cstr(&g.out);
    cg_tb_globals(text, &globals);
    int m1 = cg_tb_max_md((string)String_cstr(&g.globals));
    int m2 = cg_tb_max_md(text);
    int base = (m1 > m2 ? m1 : m2) + 1;   // !base root, !base+1 char, then a type and a tag per name
    let names: List<string>;
    List_init<string>(&names, 6);
    let res: String;
    String_init(&res, g.out.len + 64);
    let known: List<CgSub>;
    List_init<CgSub>(&known, 16);
    int p = 0;
    while (text[p] != 0) {
        int e = p;
        while (text[e] != 0 && (int)text[e] != 10) {
            e = e + 1;
        }
        string line = cg_sub_str(text, p, e);
        string tl = cg_trim(line);
        if (cg_has_prefix(line, "define ") == 1) {
            List_clear<CgSub>(&known);
        } else if (cg_ap_find(line, " = getelementptr ", 0) >= 0) {
            cg_tb_gep(g, line, &known);
        } else if (cg_ap_find(line, " = alloca ", 0) >= 0) {
            int ap = cg_ap_find(line, " = alloca ", 0);
            cg_tb_record(&known, cg_trim(cg_sub_str(line, 0, ap)), cg_sub_str(line, ap + 10, cg_ap_type_end(line, ap + 10)));
        } else if ((cg_ap_find(line, " = load ", 0) >= 0 || cg_has_prefix(tl, "store ") == 1)
                   && cg_ap_find(line, " atomic ", 0) < 0) {
            int ti = cg_tb_access(line, &known, &globals, &names);
            if (ti >= 0) {
                line = cg_cat(line, cg_cat(", !tbaa !", cg_itoa(base + 2 + 2 * ti + 1)));
            }
        }
        String_append(&res, line);
        if (text[e] == 10) {
            String_push(&res, '\n');
            e = e + 1;
        }
        p = e;
    }
    if (List_len<string>(&names) > 0) {
        String_append(&res, cg_cat("\n!", cg_cat(cg_itoa(base), " = !{!\"Eskiu TBAA\"}\n")));
        String_append(&res, cg_cat("!", cg_cat(cg_itoa(base + 1), cg_cat(" = !{!\"omnipotent char\", !", cg_cat(cg_itoa(base), ", i64 0}\n")))));
        for (i in 0..List_len<string>(&names)) {
            int ty = base + 2 + 2 * i;
            String_append(&res, cg_cat("!", cg_cat(cg_itoa(ty), cg_cat(" = !{!\"", cg_cat(List_get<string>(&names, i),
                          cg_cat("\", !", cg_cat(cg_itoa(base + 1), ", i64 0}\n")))))));
            String_append(&res, cg_cat("!", cg_cat(cg_itoa(ty + 1), cg_cat(" = !{!", cg_cat(cg_itoa(ty),
                          cg_cat(", !", cg_cat(cg_itoa(ty), ", i64 0}\n")))))));
        }
    }
    g.out = res;
}
