// Part of codegen.esk (places, calls and builtins), imported from it in order; compile codegen.esk, not this file alone.

// Address of an lvalue: returns a `ptr` operand + the lvalue's Eskiu type.
CgVal cg_lval_k(Codegen* g, *ExprNode e);
CgVal cg_lval(Codegen* g, *ExprNode e) {
    if (cg_chain_begin(g, e) == 1) {
        CgVal r = cg_lval_k(g, e);
        g.mactive = 0;
        return r;
    }
    return cg_lval_k(g, e);
}

CgVal cg_lval_k(Codegen* g, *ExprNode e) {
    let v: CgVal;
    v.op = "";
    v.ty = "ptr";
    v.ety = "";
    if (e == null) {
        return v;
    }
    if (e.kind == EK_IDENT) {
        CgLocal l = cg_find_local(g, e.sval);
        if (l.slot[0] != 0) {   // slot is a pointer
            v.op = l.slot;
            v.ety = l.ety;
            return v;
        }
        CgLocal gv = cg_find_global(g, e.sval);        // global symbol IS its address
        v.op = gv.slot;
        v.ety = gv.ety;
        return v;
    }
    if (e.kind == EK_UNARY && cg_streq(e.sval, "*") == 1) {
        CgVal p = cg_expr(g, e.a);                      // value of the pointer = the address
        v.op = cg_safe_nonnull(g, p.op);
        v.ety = cg_deref_ty(cg_etype(g, e.a));
        return v;
    }
    if (e.kind == EK_INDEX) {
        string bet = cg_etype(g, e.a);
        // An overloaded `w[i]` is a call: its result is an rvalue with no address (a
        // member read of it, `w[i].v`, materializes it; see cg_member_baseptr).
        if (List_len<*ExprNode>(&e.kids) == 0 && cg_op_resolve(g, "[]", bet, cg_etype(g, e.b))[0] != 0) {
            return v;
        }
        CgVal idx = cg_expr(g, e.b);
        string t = cg_tmp(g);
        string ity = idx.ty;                            // index keeps its own width (i32/i64)
        if (cg_int_w(ity) == 0) {         // non-int (shouldn't happen) → i32
            ity = "i32";
        }
        // GEP reads its indices as signed: widen to i64 by the index's own signedness, so a
        // uint8 255 indexes element 255, not -1.
        string iop = idx.op;
        if (cg_int_w(ity) > 0 && cg_int_w(ity) < 64) {
            iop = cg_coerce(g, idx, "i64");
            ity = "i64";
        }
        if (cg_is_slice(bet) == 1) {                    // slice: load .data, then GEP elem
            CgVal fat = cg_expr(g, e.a);
            string data = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, data);
            cg_emit(g, " = extractvalue { ptr, i64 } ");
            cg_emit(g, fat.op);
            cg_emit(g, ", 0\n");
            if ((g.safe & 1) != 0) {
                cg_bounds_check(g, iop, ity, cg_slice_len(g, fat.op));
            }
            string elem = cg_array_elem(bet);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = getelementptr inbounds ");
            cg_emit(g, cg_lltype(g, elem));
            cg_emit(g, ", ptr ");
            cg_emit(g, data);
            cg_emit(g, ", ");
            cg_emit(g, ity);
            cg_emit(g, " ");
            cg_emit(g, iop);
            cg_emit(g, "\n");
            v.op = t;
            v.ety = elem;
            return v;
        }
        if (cg_is_array(bet) == 1) {                    // array: GEP [N x T], ptr, 0, idx
            string slot = cg_addr(g, e.a).op;
            if ((g.safe & 1) != 0) {
                string alen = cg_array_len_const(g, bet);
                if (cg_streq(alen, "") == 0) {
                    cg_bounds_check(g, iop, ity, alen);
                }
            }
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = getelementptr inbounds ");
            cg_emit(g, cg_lltype(g, bet));
            cg_emit(g, ", ptr ");
            cg_emit(g, slot);
            cg_emit(g, ", i32 0, ");
            cg_emit(g, ity);
            cg_emit(g, " ");
            cg_emit(g, iop);
            cg_emit(g, "\n");
            v.op = t;
            v.ety = cg_array_elem(bet);
            return v;
        }
        string pval = cg_safe_nonnull(g, cg_expr(g, e.a).op);   // pointer: GEP T, ptr, idx
        string elem = cg_deref_ty(bet);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, cg_lltype(g, elem));
        cg_emit(g, ", ptr ");
        cg_emit(g, pval);
        cg_emit(g, ", ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, iop);
        cg_emit(g, "\n");
        v.op = t;
        v.ety = elem;
        return v;
    }
    if (e.kind == EK_MEMBER) {
        string bet = cg_etype(g, e.a);
        string sptr = "";
        string sname = bet;
        if (cg_is_ptr_ty(bet) == 1) {
            sptr = cg_safe_nonnull(g, cg_expr(g, e.a).op);
            sname = cg_strip_ptr(bet);
        }
        else {
            CgVal base = cg_lval(g, e.a);
            if (base.op[0] != 0) {
                sptr = base.op;
                if (base.ety[0] != 0) {
                    sname = base.ety;
                }
            }
            else {
                // The base is an rvalue with no address (e.g. a function call returning a
                // struct by value) — materialize it into a fresh alloca, then GEP into that.
                CgVal val = cg_expr(g, e.a);
                if (val.ety[0] != 0) {
                    sname = val.ety;
                }
                string slot = cg_entry_alloca(g, val.ty);
                cg_emit(g, "  store ");
                cg_emit(g, val.ty);
                cg_emit(g, " ");
                cg_emit(g, val.op);
                cg_emit(g, ", ptr ");
                cg_emit(g, slot);
                cg_emit(g, "\n");
                sptr = slot;
            }
        }
        CgStruct s = cg_find_struct(g, sname);
        int idx = cg_field_idx(&s, e.sval);
        // A union's members all overlap at offset 0: GEP to the storage (field 0), and the
        // member's own type governs the later load/store. A struct uses the field index.
        int gepidx = idx;
        if (cg_is_union(g, s.name) == 1) {
            gepidx = 0;
        }
        else if (cg_is_bf_struct(g, s.name) == 1) {           // bitfield struct: its layout slot
            CgBF fs = cg_bf(g, s.name, e.sval);
            if (fs.boffs >= 0) {
                v.op = cg_bf_wordptr(g, sptr, s.name, fs);
                if (idx >= 0) {
                    v.ety = List_get<string>(&s.fetys, idx);
                }
                return v;
            }
            gepidx = fs.fidx;
        }
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = getelementptr inbounds %");
        cg_emit(g, s.name);
        cg_emit(g, ", ptr ");
        cg_emit(g, sptr);
        cg_emit(g, ", i32 0, i32 ");
        cg_emit(g, cg_itoa(gepidx));
        cg_emit(g, "\n");
        v.op = t;
        if (idx >= 0) {
            v.ety = List_get<string>(&s.fetys, idx);
        }
        return v;
    }
    return v;
}

// Address of `e` for a READ (a method receiver, an indexed array): its lvalue address, or,
// for an rvalue aggregate (a call result, `a + b`, a ternary), a temporary holding its
// value (mirrors CodeGen::evaluateAddress).
CgVal cg_addr(Codegen* g, *ExprNode e) {
    CgVal lv = cg_lval(g, e);
    if (lv.op[0] != 0) {
        return lv;
    }
    CgVal val = cg_expr(g, e);
    string slot = cg_entry_alloca(g, val.ty);
    cg_emit(g, "  store ");
    cg_emit(g, val.ty);
    cg_emit(g, " ");
    cg_emit(g, val.op);
    cg_emit(g, ", ptr ");
    cg_emit(g, slot);
    cg_emit(g, "\n");
    lv.op = slot;
    lv.ety = val.ety;
    if (lv.ety[0] == 0) {
        lv.ety = cg_etype(g, e);
    }
    return lv;
}

// --safe bounds check: trap when `idx_op` (type `ity`) is < 0 or >= `len_op` (an i64
// value or integer literal). Mirrors the C++ `emitBoundsCheck`: sext to i64, OR the two
// comparisons, cond-branch to a trap block (`@llvm.trap` + unreachable) or continue.
void cg_bounds_check(Codegen* g, string idx_op, string ity, string len_op) {
    g.uses_trap = 1;
    string idx64 = idx_op;
    if (cg_streq(ity, "i64") == 0) {                       // widen the index to i64 first
        idx64 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, idx64);
        cg_emit(g, " = sext ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, idx_op);
        cg_emit(g, " to i64\n");
    }
    string lo = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, lo);
    cg_emit(g, " = icmp slt i64 ");
    cg_emit(g, idx64);
    cg_emit(g, ", 0\n");
    string hi = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, hi);
    cg_emit(g, " = icmp sge i64 ");
    cg_emit(g, idx64);
    cg_emit(g, ", ");
    cg_emit(g, len_op);
    cg_emit(g, "\n");
    string oob = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, oob);
    cg_emit(g, " = or i1 ");
    cg_emit(g, lo);
    cg_emit(g, ", ");
    cg_emit(g, hi);
    cg_emit(g, "\n");
    string fail = cg_lbl(g);
    string ok = cg_lbl(g);
    cg_emit(g, "  br i1 ");
    cg_emit(g, oob);
    cg_emit(g, ", label %");
    cg_emit(g, fail);
    cg_emit(g, ", label %");
    cg_emit(g, ok);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, fail);
    cg_emit(g, "  call void @llvm.trap()\n");
    cg_emit(g, "  unreachable\n");
    g.terminated = 1;
    cg_label(g, ok);
}

// --safe check for a slice construction `base[lo..hi]`: trap unless 0 <= lo <= hi <= len.
// `lo`/`hi` are i64 operands; an empty len_op ("") skips the upper bound (unknown length,
// e.g. a raw-pointer base). `lo == len` is a valid empty end-slice (upper bound is hi>len).
void cg_slice_bounds_check(Codegen* g, string lo_op, string hi_op, string len_op) {
    g.uses_trap = 1;
    string c1 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, c1);
    cg_emit(g, " = icmp slt i64 ");
    cg_emit(g, lo_op);
    cg_emit(g, ", 0\n");
    string c2 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, c2);
    cg_emit(g, " = icmp slt i64 ");
    cg_emit(g, hi_op);
    cg_emit(g, ", ");
    cg_emit(g, lo_op);
    cg_emit(g, "\n");
    string bad = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, bad);
    cg_emit(g, " = or i1 ");
    cg_emit(g, c1);
    cg_emit(g, ", ");
    cg_emit(g, c2);
    cg_emit(g, "\n");
    if (cg_streq(len_op, "") == 0) {
        string c3 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, c3);
        cg_emit(g, " = icmp sgt i64 ");
        cg_emit(g, hi_op);
        cg_emit(g, ", ");
        cg_emit(g, len_op);
        cg_emit(g, "\n");
        string bad2 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, bad2);
        cg_emit(g, " = or i1 ");
        cg_emit(g, bad);
        cg_emit(g, ", ");
        cg_emit(g, c3);
        cg_emit(g, "\n");
        bad = bad2;
    }
    string fail = cg_lbl(g);
    string ok = cg_lbl(g);
    cg_emit(g, "  br i1 ");
    cg_emit(g, bad);
    cg_emit(g, ", label %");
    cg_emit(g, fail);
    cg_emit(g, ", label %");
    cg_emit(g, ok);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, fail);
    cg_emit(g, "  call void @llvm.trap()\n");
    cg_emit(g, "  unreachable\n");
    g.terminated = 1;
    cg_label(g, ok);
}

// Extract the length (field 1) of an already-evaluated slice fat pointer `fat_op`.
string cg_slice_len(Codegen* g, string fat_op) {
    string lenv = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, lenv);
    cg_emit(g, " = extractvalue { ptr, i64 } ");
    cg_emit(g, fat_op);
    cg_emit(g, ", 1\n");
    return lenv;
}

// The static element count of a fixed-array type, resolved through a named const/enum, or
// "" if it isn't a compile-time constant (then --safe skips the array check, as C++ does).
string cg_array_len_const(Codegen* g, string bet) {
    string rv = cg_dim_val(g, cg_array_count(bet));
    if (rv[0] != 0 && cg_all_digits(rv) == 1) {
        return rv;
    }
    return "";
}

// Address of element `idx_op` (already evaluated, type `ity`) of an indexable base
// (slice / fixed array / string / pointer). Used by slice construction so the low
// bound is evaluated exactly once (matching the C++ back-end).
string cg_slice_elem_addr(Codegen* g, *ExprNode base, string idx_op, string hi_op, string ity) {
    string bet = cg_etype(g, base);
    string t = cg_tmp(g);
    if (cg_is_slice(bet) == 1) {
        CgVal fat = cg_expr(g, base);
        string data = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, data);
        cg_emit(g, " = extractvalue { ptr, i64 } ");
        cg_emit(g, fat.op);
        cg_emit(g, ", 0\n");
        // 0 <= lo <= hi <= len (lo == len is a valid empty end-slice), not the element check.
        if ((g.safe & 1) != 0) {
            cg_slice_bounds_check(g, idx_op, hi_op, cg_slice_len(g, fat.op));
        }
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, cg_lltype(g, cg_array_elem(bet)));
        cg_emit(g, ", ptr ");
        cg_emit(g, data);
        cg_emit(g, ", ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, idx_op);
        cg_emit(g, "\n");
        return t;
    }
    if (cg_is_array(bet) == 1) {
        string slot = cg_lval(g, base).op;
        if ((g.safe & 1) != 0) {
            cg_slice_bounds_check(g, idx_op, hi_op, cg_array_len_const(g, bet));
        }
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, cg_lltype(g, bet));
        cg_emit(g, ", ptr ");
        cg_emit(g, slot);
        cg_emit(g, ", i32 0, ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, idx_op);
        cg_emit(g, "\n");
        return t;
    }
    string elem = "i8";
    if (cg_streq(bet, "string") == 0) {
        elem = cg_lltype(g, cg_deref_ty(bet));
    }
    string pval = cg_expr(g, base).op;
    if ((g.safe & 1) != 0) {   // raw pointer/string: len unknown, only lo<=hi
        cg_slice_bounds_check(g, idx_op, hi_op, "");
    }
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = getelementptr inbounds ");
    cg_emit(g, elem);
    cg_emit(g, ", ptr ");
    cg_emit(g, pval);
    cg_emit(g, ", ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, idx_op);
    cg_emit(g, "\n");
    return t;
}

// Evaluate argument `ax` for parameter `i` of `f`. A C function pointer parameter (an
// extern's fn-typed one, declared `ptr`) takes a top-level function's C address.
// A `?:` whose value goes to interface `tety` boxes each arm with its own struct's vtable
// (mirrors the C++ ifaceTargetHint), so the arms may point at different conforming structs.
void cg_hint_iface(Codegen* g, *ExprNode x, string tety) {
    if (x != null && x.kind == EK_TERNARY && tety != null && tety[0] != 0 && cg_is_iface(g, cg_dealias(g, tety)) == 1) {
        g.tern_node = x;
        g.tern_iface = tety;
    }
}

// A va_list argument of a C function (C++ CodeGen::evalCVaList): by address on x86-64
// System V and AArch64 outside Darwin and Windows (an array/struct `va_list`), else the
// `char*` that llvm.va_start stored at offset 0 of the storage.
CgVal cg_c_va_list(Codegen* g, *ExprNode ax) {
    let v: CgVal;
    v.ty = "ptr";
    v.ety = "*void";
    int byaddr = 0;
    if (g.abi == 3 || (g.abi == 2 && g.wintgt == 0)) {
        byaddr = 1;
    }
    int named = 0;
    if (ax.kind == EK_IDENT && (cg_find_local(g, ax.sval).slot[0] != 0 || cg_find_global(g, ax.sval).slot[0] != 0)) {
        named = 1;
    }
    string addr = "";
    if (named == 1) {
        addr = cg_addr(g, ax).op;
    }
    else {
        CgVal val = cg_expr(g, ax);
        addr = cg_entry_alloca(g, "%__va_list");
        cg_emit(g, "  store %__va_list ");
        cg_emit(g, val.op);
        cg_emit(g, ", ptr ");
        cg_emit(g, addr);
        cg_emit(g, "\n");
    }
    if (byaddr == 1) {
        v.op = addr;
        return v;
    }
    v.op = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, v.op);
    cg_emit(g, " = load ptr, ptr ");
    cg_emit(g, addr);
    cg_emit(g, "\n");
    return v;
}

// `va_arg<T>(ap)` of LLVM type `llty` from the va_list storage at `ap` (C++
// CodeGen::emitVaArg): on AArch64 outside Darwin and Windows the AAPCS64 va_list
// {__stack, __gr_top, __vr_top, __gr_offs, __vr_offs} is read as clang does (an integer
// or pointer from the general-register save area, a float or double from the FP/SIMD one
// while the offset is negative, then the stack in 8-byte slots); elsewhere the `va_arg`
// instruction.
string cg_va_arg(Codegen* g, string ap, string llty) {
    int isfp = 0;
    if (cg_streq(llty, "double") == 1 || cg_streq(llty, "float") == 1) {
        isfp = 1;
    }
    int isint = 0;
    if (cg_streq(llty, "ptr") == 1 || cg_streq(llty, "i64") == 1 || cg_streq(llty, "i32") == 1
        || cg_streq(llty, "i16") == 1 || cg_streq(llty, "i8") == 1) {
        isint = 1;
    }
    if (g.abi != 2 || g.wintgt == 1 || (isfp == 0 && isint == 0)) {
        string r = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, r);
        cg_emit(g, " = va_arg ptr ");
        cg_emit(g, ap);
        cg_emit(g, ", ");
        cg_emit(g, llty);
        cg_emit(g, "\n");
        return r;
    }
    int size = 8;
    if (cg_streq(llty, "i32") == 1 || cg_streq(llty, "float") == 1) {
        size = 4;
    }
    if (cg_streq(llty, "i16") == 1) {
        size = 2;
    }
    if (cg_streq(llty, "i8") == 1) {
        size = 1;
    }
    string offsf = "3";
    string topf = "1";
    string slot = "8";
    int nslot = 8;
    if (isfp == 1) {
        offsf = "4";
        topf = "2";
        slot = "16";
        nslot = 16;
    }
    string lmaybe = cg_lbl(g);
    string lreg = cg_lbl(g);
    string lstack = cg_lbl(g);
    string lend = cg_lbl(g);
    string offsp = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, offsp);
    cg_emit(g, " = getelementptr inbounds %__va_list, ptr ");
    cg_emit(g, ap);
    cg_emit(g, ", i32 0, i32 ");
    cg_emit(g, offsf);
    cg_emit(g, "\n");
    string offs = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, offs);
    cg_emit(g, " = load i32, ptr ");
    cg_emit(g, offsp);
    cg_emit(g, "\n");
    string ge = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, ge);
    cg_emit(g, " = icmp sge i32 ");
    cg_emit(g, offs);
    cg_emit(g, ", 0\n");
    cg_emit(g, "  br i1 ");
    cg_emit(g, ge);
    cg_emit(g, ", label %");
    cg_emit(g, lstack);
    cg_emit(g, ", label %");
    cg_emit(g, lmaybe);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, lmaybe);
    string nx = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, nx);
    cg_emit(g, " = add i32 ");
    cg_emit(g, offs);
    cg_emit(g, ", ");
    cg_emit(g, slot);
    cg_emit(g, "\n");
    cg_emit(g, "  store i32 ");
    cg_emit(g, nx);
    cg_emit(g, ", ptr ");
    cg_emit(g, offsp);
    cg_emit(g, "\n");
    string le = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, le);
    cg_emit(g, " = icmp sle i32 ");
    cg_emit(g, nx);
    cg_emit(g, ", 0\n");
    cg_emit(g, "  br i1 ");
    cg_emit(g, le);
    cg_emit(g, ", label %");
    cg_emit(g, lreg);
    cg_emit(g, ", label %");
    cg_emit(g, lstack);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, lreg);
    string topp = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, topp);
    cg_emit(g, " = getelementptr inbounds %__va_list, ptr ");
    cg_emit(g, ap);
    cg_emit(g, ", i32 0, i32 ");
    cg_emit(g, topf);
    cg_emit(g, "\n");
    string top = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, top);
    cg_emit(g, " = load ptr, ptr ");
    cg_emit(g, topp);
    cg_emit(g, "\n");
    string off64 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, off64);
    cg_emit(g, " = sext i32 ");
    cg_emit(g, offs);
    cg_emit(g, " to i64\n");
    string raddr = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, raddr);
    cg_emit(g, " = getelementptr i8, ptr ");
    cg_emit(g, top);
    cg_emit(g, ", i64 ");
    cg_emit(g, off64);
    cg_emit(g, "\n");
    if (g.bigend == 1 && size < nslot) {
        string ra2 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, ra2);
        cg_emit(g, " = getelementptr i8, ptr ");
        cg_emit(g, raddr);
        cg_emit(g, ", i64 ");
        cg_emit(g, cg_itoa(nslot - size));
        cg_emit(g, "\n");
        raddr = ra2;
    }
    cg_emit(g, "  br label %");
    cg_emit(g, lend);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, lstack);
    string stk = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, stk);
    cg_emit(g, " = load ptr, ptr ");
    cg_emit(g, ap);
    cg_emit(g, "\n");
    string stk2 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, stk2);
    cg_emit(g, " = getelementptr i8, ptr ");
    cg_emit(g, stk);
    cg_emit(g, ", i64 8\n");
    cg_emit(g, "  store ptr ");
    cg_emit(g, stk2);
    cg_emit(g, ", ptr ");
    cg_emit(g, ap);
    cg_emit(g, "\n");
    string saddr = stk;
    if (g.bigend == 1 && size < 8) {
        saddr = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, saddr);
        cg_emit(g, " = getelementptr i8, ptr ");
        cg_emit(g, stk);
        cg_emit(g, ", i64 ");
        cg_emit(g, cg_itoa(8 - size));
        cg_emit(g, "\n");
    }
    cg_emit(g, "  br label %");
    cg_emit(g, lend);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, lend);
    string addr = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, addr);
    cg_emit(g, " = phi ptr [ ");
    cg_emit(g, raddr);
    cg_emit(g, ", %");
    cg_emit(g, lreg);
    cg_emit(g, " ], [ ");
    cg_emit(g, saddr);
    cg_emit(g, ", %");
    cg_emit(g, lstack);
    cg_emit(g, " ]\n");
    string r = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, r);
    cg_emit(g, " = load ");
    cg_emit(g, llty);
    cg_emit(g, ", ptr ");
    cg_emit(g, addr);
    cg_emit(g, "\n");
    return r;
}

// "volatile " for an access through a `volatile` variable: the variable itself, or a
// place reached from it by `*`, `[]` or `.` (C++ CodeGen::volatileRooted); else "".
string cg_vol(Codegen* g, *ExprNode e) {
    if (List_len<string>(&g.vols) == 0) {
        return "";
    }
    while (e != null) {
        if (e.kind == EK_IDENT) {
            int i = 0;
            int n = List_len<string>(&g.vols);
            while (i < n) {
                if (cg_streq(List_get<string>(&g.vols, i), e.sval) == 1) {
                    return "volatile ";
                }
                i = i + 1;
            }
            return "";
        }
        if (e.kind == EK_UNARY && cg_streq(e.sval, "*") == 1) {
            e = e.a;
        }
        else if (e.kind == EK_INDEX || e.kind == EK_MEMBER) {
            e = e.a;
        }
        else {
            return "";
        }
    }
    return "";
}

CgVal cg_call_arg(Codegen* g, CgFn* f, int i, *ExprNode ax) {
    cg_hint_iface(g, ax, cg_pety(f, i));
    if (cg_streq(cg_pty(f, i), "ptr") == 1 && cg_streq(cg_dealias(g, cg_pety(f, i)), "va_list") == 1) {
        return cg_c_va_list(g, ax);
    }
    if (cg_streq(cg_pty(f, i), "ptr") == 1 && cg_is_fnty(cg_dealias(g, cg_pety(f, i))) == 1
        && ax.kind == EK_IDENT && cg_find_local(g, ax.sval).slot[0] == 0
        && cg_find_global(g, ax.sval).slot[0] == 0 && cg_is_fn(g, ax.sval) == 1) {
        let v: CgVal;
        v.op = cg_cabi_callback(g, ax.sval);
        v.ty = "ptr";
        v.ety = "";
        return v;
    }
    return cg_expr(g, ax);
}

// A prefix `-`, `!` or `~`. A chain of them (`- - - x`) nests as deep as it is long, so
// it is emitted along its operand spine with a loop, each operand's type (for the
// operator-overload lookup) computed once, bottom-up. An overloaded operator ends the
// spine (it is evaluated as an ordinary operand, through its own call).
CgVal cg_unary_chain(Codegen* g, *ExprNode e) {
    List<*ExprNode> spine;
    List_init<*ExprNode>(&spine, 4);
    *ExprNode u = e;
    while (u != null && u.kind == EK_UNARY
           && (cg_streq(u.sval, "-") == 1 || cg_streq(u.sval, "!") == 1 || cg_streq(u.sval, "~") == 1)) {
        List_push<*ExprNode>(&spine, u);
        u = u.a;
    }
    int n = List_len<*ExprNode>(&spine);
    List<string> opns;   // each node's overload fn ("" = built-in)
    List_init<string>(&opns, n);
    int i = 0;
    while (i < n) {
        List_push<string>(&opns, "");
        i = i + 1;
    }
    string at = cg_etype(g, u);
    i = n - 1;
    while (i >= 0) {
        *ExprNode sn = List_get<*ExprNode>(&spine, i);
        string uop = sn.sval;
        if (cg_streq(uop, "-") == 1) {
            uop = "u-";
        }
        List_set<string>(&opns, i, cg_op_resolve1(g, uop, at));   // unary operator overload
        at = cg_unary_ety(g, sn, at);
        i = i - 1;
    }
    string topn = List_get<string>(&opns, 0);
    if (topn[0] != 0) {
        return cg_op_call(g, topn, e.a, null);
    }
    int m = 1;
    while (m < n) {
        string mopn = List_get<string>(&opns, m);
        if (mopn[0] != 0) {
            break;
        }
        m = m + 1;
    }
    *ExprNode last = List_get<*ExprNode>(&spine, m - 1);
    CgVal val = cg_expr(g, last.a);
    i = m - 1;
    while (i >= 0) {
        val = cg_unary_apply(g, List_get<*ExprNode>(&spine, i), val);
        i = i - 1;
    }
    List_free<*ExprNode>(&spine);
    List_free<string>(&opns);
    return val;
}

// A built-in prefix `-`, `!` or `~` applied to its already evaluated operand.
CgVal cg_unary_apply(Codegen* g, *ExprNode e, CgVal operand) {
    let v: CgVal;
    v.ety = "";
    if (cg_streq(e.sval, "-") == 1 || cg_streq(e.sval, "~") == 1) {
        int nw = cg_int_w(operand.ty);                   // C: a narrow operand becomes int first
        if (nw > 0 && nw < 32) {
            operand.op = cg_coerce(g, operand, "i32");
            operand.ty = "i32";
            operand.ety = "int";
        }
    }
    if (cg_streq(e.sval, "-") == 1) {
        CgVal a = operand;
        string t = cg_tmp(g);
        if (cg_is_float(a.ty) == 1) {                  // floating-point negation
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = fneg ");
            cg_emit(g, a.ty);
            cg_emit(g, " ");
            cg_emit(g, a.op);
            cg_emit(g, "\n");
        } else {
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = sub ");
            cg_emit(g, a.ty);
            cg_emit(g, " 0, ");
            cg_emit(g, a.op);
            cg_emit(g, "\n");
        }
        v.op = t;   // keeps the (promoted) signedness
        v.ty = a.ty;
        v.ety = a.ety;
        return v;
    }
    if (cg_streq(e.sval, "!") == 1) {                // logical not: (x == 0) -> i1
        CgVal a = cg_iface_data(g, operand);
        string t = cg_tmp(g);
        if (cg_is_float(a.ty) == 1) {                  // !x on a float: x == 0.0
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = fcmp oeq ");
            cg_emit(g, a.ty);
            cg_emit(g, " ");
            cg_emit(g, a.op);
            cg_emit(g, ", 0.0\n");
        } else {
            string zero = "0";
            if (cg_streq(a.ty, "ptr") == 1) {   // !p on a pointer: p == null
                zero = "null";
            }
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = icmp eq ");
            cg_emit(g, a.ty);
            cg_emit(g, " ");
            cg_emit(g, a.op);
            cg_emit(g, ", ");
            cg_emit(g, zero);
            cg_emit(g, "\n");
        }
        v.op = t;
        v.ty = "i1";
        v.ety = "bool";
        return v;
    }
    if (cg_streq(e.sval, "~") == 1) {                // bitwise not: xor with all-ones
        CgVal a = operand;
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = xor ");
        cg_emit(g, a.ty);
        cg_emit(g, " ");
        cg_emit(g, a.op);
        cg_emit(g, ", -1\n");
        v.op = t;
        v.ty = a.ty;
        v.ety = a.ety;
        return v;
    }
    return operand;
}

// A non-assignment binary expression. A left-leaning chain (`a + b + c ...`) is as deep
// as it is long, so it is emitted along its left spine with a loop (mirrors
// CodeGen::visit(BinaryExpr)): the operand types are derived bottom-up once (as cg_etype
// does), then the leftmost operand is evaluated and each built-in operator is applied to
// the running value. An overloaded operator ends the spine (it is evaluated as an
// ordinary operand, through its own call).
CgVal cg_binary_chain(Codegen* g, *ExprNode e) {
    List<*ExprNode> spine;
    List_init<*ExprNode>(&spine, 8);
    *ExprNode b = e;
    while (b != null && b.kind == EK_BINARY && cg_streq(b.sval, "=") == 0) {
        List_push<*ExprNode>(&spine, b);
        b = b.a;
    }
    int n = List_len<*ExprNode>(&spine);
    List<string> opns;   // each node's overload fn ("" = built-in)
    List_init<string>(&opns, n);
    int i = 0;
    while (i < n) {
        List_push<string>(&opns, "");
        i = i + 1;
    }
    string lt = cg_etype(g, b);
    i = n - 1;
    while (i >= 0) {
        *ExprNode sn = List_get<*ExprNode>(&spine, i);
        string rt = cg_etype(g, sn.b);
        string bopn = cg_op_resolve(g, sn.sval, lt, rt);
        List_set<string>(&opns, i, bopn);
        if (bopn[0] != 0) {
            lt = cg_find_fn(g, bopn).rety;
        }
        else {
            lt = cg_binary_ety(g, sn.sval, lt, rt);
        }
        i = i - 1;
    }
    string topn = List_get<string>(&opns, 0);
    if (topn[0] != 0) {   // binary overload
        return cg_op_call(g, topn, e.a, e.b);
    }
    int m = 1;
    while (m < n) {
        string mopn = List_get<string>(&opns, m);
        if (mopn[0] != 0) {
            break;
        }
        m = m + 1;
    }
    *ExprNode last = List_get<*ExprNode>(&spine, m - 1);
    CgVal val = cg_expr(g, last.a);
    i = m - 1;
    while (i >= 0) {
        val = cg_binary_builtin(g, List_get<*ExprNode>(&spine, i), val);
        i = i - 1;
    }
    List_free<*ExprNode>(&spine);
    List_free<string>(&opns);
    return val;
}

// One built-in binary operator `e` applied to its already evaluated left operand `l`
// (the right operand is evaluated here).
CgVal cg_binary_builtin(Codegen* g, *ExprNode e, CgVal left) {
    CgVal l = left;
    let v: CgVal;
    v.ety = "";
    if (cg_streq(e.sval, "&&") == 1 || cg_streq(e.sval, "||") == 1) {
        // Short-circuit via a result slot: store the LHS, branch over the RHS when
        // the result is already decided (&& false / || true), else evaluate the RHS.
        int is_and = cg_streq(e.sval, "&&");
        string res = cg_entry_alloca(g, "i1");
        CgVal a = cg_cond_val(g, l);
        cg_emit(g, "  store i1 ");
        cg_emit(g, a.op);
        cg_emit(g, ", ptr ");
        cg_emit(g, res);
        cg_emit(g, "\n");
        string lrhs = cg_lbl(g);
        string lend = cg_lbl(g);
        cg_emit(g, "  br i1 ");
        cg_emit(g, a.op);
        if (is_and == 1) {
            cg_emit(g, ", label %");
            cg_emit(g, lrhs);
            cg_emit(g, ", label %");
            cg_emit(g, lend);
        }
        else {
            cg_emit(g, ", label %");
            cg_emit(g, lend);
            cg_emit(g, ", label %");
            cg_emit(g, lrhs);
        }
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, lrhs);
        CgVal b = cg_cond(g, e.b);
        cg_emit(g, "  store i1 ");
        cg_emit(g, b.op);
        cg_emit(g, ", ptr ");
        cg_emit(g, res);
        cg_emit(g, "\n");
        cg_br(g, lend);
        cg_label(g, lend);
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = load i1, ptr ");
        cg_emit(g, res);
        cg_emit(g, "\n");
        v.op = t;
        v.ty = "i1";
        v.ety = "bool";
        return v;
    }
    CgVal r = cg_expr(g, e.b);
    // An interface value compares with `null` by its data pointer.
    if ((cg_streq(e.sval, "==") == 1 || cg_streq(e.sval, "!=") == 1)
        && (cg_streq(l.ty, "%iface_fat") == 1) != (cg_streq(r.ty, "%iface_fat") == 1)) {
        l = cg_iface_data(g, l);
        r = cg_iface_data(g, r);
    }
    // C integer promotions: an integer operand narrower than `int` (bool, char, int8/16,
    // uint8/16) becomes a signed `int` (extended by its own signedness) before any
    // arithmetic, bitwise, shift, or comparison. Mirrors CodeGen::isIntPromotingOp.
    if (cg_arith_op(e.sval)[0] != 0 || cg_cmp_pred(e.sval)[0] != 0) {
        int plw = cg_int_w(l.ty);
        if (plw > 0 && plw < 32) {
            l.op = cg_coerce(g, l, "i32");
            l.ty = "i32";
            l.ety = "int";
        }
        int prw = cg_int_w(r.ty);
        if (prw > 0 && prw < 32) {
            r.op = cg_coerce(g, r, "i32");
            r.ty = "i32";
            r.ety = "int";
        }
    }
    // Floating-point: if either operand is float/double, promote both to the wider
    // and use fcmp/fadd/… (mixed int/float promotes the int via sitofp in cg_coerce).
    if (cg_is_float(l.ty) == 1 || cg_is_float(r.ty) == 1) {
        string fty = "float";
        if (cg_streq(l.ty, "double") == 1 || cg_streq(r.ty, "double") == 1) {
            fty = "double";
        }
        string lop = cg_coerce(g, l, fty);
        string rop = cg_coerce(g, r, fty);
        string fpred = cg_fcmp_pred(e.sval);
        if (fpred[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = fcmp ");
            cg_emit(g, fpred);
            cg_emit(g, " ");
            cg_emit(g, fty);
            cg_emit(g, " ");
            cg_emit(g, lop);
            cg_emit(g, ", ");
            cg_emit(g, rop);
            cg_emit(g, "\n");
            v.op = t;
            v.ty = "i1";
            v.ety = "bool";
            return v;
        }
        string fop = cg_farith_op(e.sval);
        if (fop[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = ");
            cg_emit(g, fop);
            if (g.fp_contract == 1 && cg_streq(fop, "fdiv") == 0 && cg_streq(fop, "frem") == 0) {
                cg_emit(g, " contract");
            }
            cg_emit(g, " ");
            cg_emit(g, fty);
            cg_emit(g, " ");
            cg_emit(g, lop);
            cg_emit(g, ", ");
            cg_emit(g, rop);
            cg_emit(g, "\n");
            v.op = t;
            v.ty = fty;
            v.ety = fty;
            return v;
        }
    }
    // Integer operand unification (C usual arithmetic conversions): widen the narrower
    // operand to the wider (signedness-aware via cg_coerce), and pick unsigned ops/
    // predicates when either operand is unsigned. Pointer operands skip this (handled
    // specially below); for them lw/rw are 0 so icty/ilop/irop stay the raw values.
    int lw = cg_int_w(l.ty);
    int rw = cg_int_w(r.ty);
    string icty = l.ty;
    string ilop = l.op;
    string irop = r.op;
    int uns = 0;
    if (lw > 0 && rw > 0) {
        if (rw > lw) {
            icty = r.ty;
        } else {
            icty = l.ty;
        }
        // A shift computes in the width of the value shifted; the count never widens it.
        if (cg_streq(e.sval, "<<") == 1 || cg_streq(e.sval, ">>") == 1) {
            icty = l.ty;
        }
        ilop = cg_coerce(g, l, icty);
        irop = cg_coerce(g, r, icty);
        // C usual arithmetic conversions: an op mixing signed and unsigned is unsigned
        // only when the unsigned operand's width is at least the signed one's; a wider
        // signed type represents every value of a narrower unsigned one (then signed).
        int lu = cg_is_unsigned(l.ety);
        int ru = cg_is_unsigned(r.ety);
        if (lu == ru) {
            uns = lu;
        }
        else if (lu == 1) {
            if (lw >= rw) {
                uns = 1;
            }
        }
        else {
            if (rw >= lw) {
                uns = 1;
            }
        }
    }
    string pred = cg_cmp_pred_s(e.sval, uns);
    if (pred[0] != 0) {
        // Pointer comparisons: use `ptr` as the icmp type and turn a literal `0` on
        // either side into `null` (Eskiu writes both `p != null` and `p != 0`).
        string cty = icty;
        string lop = ilop;
        string rop = irop;
        if (cg_streq(l.ty, "ptr") == 1 || cg_streq(r.ty, "ptr") == 1) {
            cty = "ptr";
            lop = l.op;
            rop = r.op;
            if (cg_streq(lop, "0") == 1) {
                lop = "null";
            }
            if (cg_streq(rop, "0") == 1) {
                rop = "null";
            }
        }
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = icmp ");
        cg_emit(g, pred);
        cg_emit(g, " ");
        cg_emit(g, cty);
        cg_emit(g, " ");
        cg_emit(g, lop);
        cg_emit(g, ", ");
        cg_emit(g, rop);
        cg_emit(g, "\n");
        v.op = t;
        v.ty = "i1";
        v.ety = "bool";
        return v;
    }
    // Pointer difference: `p - q` (both pointers) → (ptrtoint p - ptrtoint q) / sizeof(elem),
    // a signed count of elements (an integer, not a `ptr`). Must precede the ptr±int case.
    if (cg_streq(e.sval, "-") == 1
        && cg_streq(l.ty, "ptr") == 1 && cg_streq(r.ty, "ptr") == 1) {
        string li = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, li);
        cg_emit(g, " = ptrtoint ptr ");
        cg_emit(g, l.op);
        cg_emit(g, " to i64\n");
        string ri = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, ri);
        cg_emit(g, " = ptrtoint ptr ");
        cg_emit(g, r.op);
        cg_emit(g, " to i64\n");
        string d = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, d);
        cg_emit(g, " = sub i64 ");
        cg_emit(g, li);
        cg_emit(g, ", ");
        cg_emit(g, ri);
        cg_emit(g, "\n");
        string elem = cg_deref_ty(l.ety);
        string ell = cg_lltype(g, elem);
        if (cg_streq(ell, "i8") == 1 || cg_streq(ell, "void") == 1) {   // element size 1: byte diff is the count
            v.op = d;
            v.ty = "i64";
            v.ety = "int64";
            return v;
        }
        string szg = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, szg);
        cg_emit(g, " = getelementptr ");
        cg_emit(g, ell);
        cg_emit(g, ", ptr null, i32 1\n");
        string szi = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, szi);
        cg_emit(g, " = ptrtoint ptr ");
        cg_emit(g, szg);
        cg_emit(g, " to i64\n");
        string res = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, res);
        cg_emit(g, " = sdiv i64 ");
        cg_emit(g, d);
        cg_emit(g, ", ");
        cg_emit(g, szi);
        cg_emit(g, "\n");
        v.op = res;
        v.ty = "i64";
        v.ety = "int64";
        return v;
    }
    // Pointer arithmetic: `p + n` / `n + p` / `p - n` lower to getelementptr over the
    // pointee, not an integer add on a `ptr` (which is invalid IR).
    if ((cg_streq(e.sval, "+") == 1 || cg_streq(e.sval, "-") == 1)
        && (cg_streq(l.ty, "ptr") == 1 || cg_streq(r.ty, "ptr") == 1)) {
        CgVal base = l;
        CgVal off = r;
        if (cg_streq(l.ty, "ptr") == 0) {
            base = r;
            off = l;
        }
        string offop = off.op;
        if (cg_streq(e.sval, "-") == 1) {              // p - n: index by -n
            string nt = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, nt);
            cg_emit(g, " = sub ");
            cg_emit(g, off.ty);
            cg_emit(g, " 0, ");
            cg_emit(g, off.op);
            cg_emit(g, "\n");
            offop = nt;
        }
        string elem = cg_deref_ty(base.ety);
        string ell = cg_lltype(g, elem);
        if (cg_streq(ell, "void") == 1) {   // `*void` steps by bytes (as the C++ build does)
            ell = "i8";
        }
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, ell);
        cg_emit(g, ", ptr ");
        cg_emit(g, base.op);
        cg_emit(g, ", ");
        cg_emit(g, off.ty);
        cg_emit(g, " ");
        cg_emit(g, offop);
        cg_emit(g, "\n");
        v.op = t;
        v.ty = "ptr";
        v.ety = base.ety;
        return v;
    }
    // A right shift's kind (arithmetic vs logical) follows the value being shifted
    // (the left operand) only, independent of the count's signedness.
    int op_uns = uns;
    if (cg_streq(e.sval, ">>") == 1) {
        op_uns = cg_is_unsigned(l.ety);
    }
    string op = cg_arith_op_s(e.sval, op_uns);
    if (op[0] != 0) {
        if (cg_streq(op, "shl") == 1 || cg_streq(op, "ashr") == 1 || cg_streq(op, "lshr") == 1) {
            irop = cg_mask_shift(g, icty, irop);
        }
        if (cg_streq(op, "sdiv") == 1 || cg_streq(op, "srem") == 1
            || cg_streq(op, "udiv") == 1 || cg_streq(op, "urem") == 1) {
            v.op = cg_int_divrem(g, op, icty, ilop, irop);
            v.ty = icty;
            v.ety = cg_binary_ety(g, e.sval, l.ety, r.ety);
            if (v.ety[0] == 0) {
                v.ety = l.ety;
            }
            return v;
        }
        if ((g.safe & 2) != 0 && op_uns == 0 && cg_int_w(icty) >= 32
            && (cg_streq(op, "add") == 1 || cg_streq(op, "sub") == 1 || cg_streq(op, "mul") == 1)) {
            v.op = cg_safe_arith(g, op, icty, ilop, irop);
            v.ty = icty;
            v.ety = cg_binary_ety(g, e.sval, l.ety, r.ety);
            if (v.ety[0] == 0) {
                v.ety = l.ety;
            }
            return v;
        }
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = ");
        cg_emit(g, op);
        cg_emit(g, " ");
        cg_emit(g, icty);
        cg_emit(g, " ");
        cg_emit(g, ilop);
        cg_emit(g, ", ");
        cg_emit(g, irop);
        cg_emit(g, "\n");
        v.op = t;
        v.ty = icty;
        v.ety = cg_binary_ety(g, e.sval, l.ety, r.ety);
        if (v.ety[0] == 0) {
            v.ety = l.ety;
        }
        return v;
    }
    return l;                                       // unhandled binary (S1) → left
}
