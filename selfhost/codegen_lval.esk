// Part of codegen.esk (places, calls and builtins), imported from it in order; compile codegen.esk, not this file alone.

// Address of an lvalue: returns a `ptr` operand + the lvalue's Eskiu type.
CgVal cg_lval_k(Codegen* g, *ExprNode e);
CgVal cg_lval(Codegen* g, *ExprNode e) {
    if (cg_chain_begin(g, e) == 1) {
        CgVal r = cg_lval_k(g, e);
        g.mactive = 0;
        return r;
    }
    return cg_lval_k(g, e);
}

CgVal cg_lval_k(Codegen* g, *ExprNode e) {
    let v: CgVal;
    v.op = "";
    v.ty = "ptr";
    v.ety = "";
    if (e == null) {
        return v;
    }
    if (e.kind == EK_IDENT) {
        CgLocal l = cg_find_local(g, e.sval);
        if (l.slot[0] != 0) {   // slot is a pointer
            v.op = l.slot;
            v.ety = l.ety;
            return v;
        }
        CgLocal gv = cg_find_global(g, e.sval);        // global symbol IS its address
        v.op = gv.slot;
        v.ety = gv.ety;
        return v;
    }
    if (e.kind == EK_UNARY && cg_streq(e.sval, "*") == 1) {
        CgVal p = cg_expr(g, e.a);                      // value of the pointer = the address
        v.op = cg_safe_nonnull(g, p.op, e);
        v.ety = cg_deref_ty(cg_etype(g, e.a));
        return v;
    }
    if (e.kind == EK_INDEX) {
        string bet = cg_etype(g, e.a);
        // An overloaded `w[i]` is a call: its result is an rvalue with no address (a
        // member read of it, `w[i].v`, materializes it; see cg_member_baseptr).
        if (List_len<*ExprNode>(&e.kids) == 0 && cg_op_resolve(g, "[]", bet, cg_etype(g, e.b))[0] != 0) {
            return v;
        }
        CgVal idx = cg_expr(g, e.b);
        string t = cg_tmp(g);
        string ity = idx.ty;                            // index keeps its own width (i32/i64)
        if (cg_int_w(ity) == 0) {         // non-int (shouldn't happen) → i32
            ity = "i32";
        }
        // GEP reads its indices as signed: widen to i64 by the index's own signedness, so a
        // uint8 255 indexes element 255, not -1.
        string iop = idx.op;
        if (cg_int_w(ity) > 0 && cg_int_w(ity) < 64) {
            iop = cg_coerce(g, idx, "i64");
            ity = "i64";
        }
        if (cg_is_slice(bet) == 1) {                    // slice: load .data, then GEP elem
            CgVal fat = cg_expr(g, e.a);
            string data = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, data);
            cg_emit(g, " = extractvalue { ptr, i64 } ");
            cg_emit(g, fat.op);
            cg_emit(g, ", 0\n");
            if ((g.safe & 1) != 0) {
                cg_bounds_check(g, iop, ity, cg_slice_len(g, fat.op), e);
            }
            string elem = cg_array_elem(bet);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = getelementptr inbounds ");
            cg_emit(g, cg_lltype(g, elem));
            cg_emit(g, ", ptr ");
            cg_emit(g, data);
            cg_emit(g, ", ");
            cg_emit(g, ity);
            cg_emit(g, " ");
            cg_emit(g, iop);
            cg_emit(g, "\n");
            v.op = t;
            v.ety = elem;
            return v;
        }
        if (cg_is_array(bet) == 1) {                    // array: GEP [N x T], ptr, 0, idx
            string slot = cg_addr(g, e.a).op;
            if ((g.safe & 1) != 0) {
                string alen = cg_array_len_const(g, bet);
                if (cg_streq(alen, "") == 0) {
                    cg_bounds_check(g, iop, ity, alen, e);
                }
            }
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = getelementptr inbounds ");
            cg_emit(g, cg_lltype(g, bet));
            cg_emit(g, ", ptr ");
            cg_emit(g, slot);
            cg_emit(g, ", i32 0, ");
            cg_emit(g, ity);
            cg_emit(g, " ");
            cg_emit(g, iop);
            cg_emit(g, "\n");
            v.op = t;
            v.ety = cg_array_elem(bet);
            return v;
        }
        string pval = cg_safe_nonnull(g, cg_expr(g, e.a).op, e);   // pointer: GEP T, ptr, idx
        string elem = cg_deref_ty(bet);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, cg_lltype(g, elem));
        cg_emit(g, ", ptr ");
        cg_emit(g, pval);
        cg_emit(g, ", ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, iop);
        cg_emit(g, "\n");
        v.op = t;
        v.ety = elem;
        return v;
    }
    if (e.kind == EK_MEMBER) {
        string bet = cg_etype(g, e.a);
        string sptr = "";
        string sname = bet;
        if (cg_is_ptr_ty(bet) == 1) {
            sptr = cg_safe_nonnull(g, cg_expr(g, e.a).op, e);
            sname = cg_strip_ptr(bet);
        }
        else {
            CgVal base = cg_lval(g, e.a);
            if (base.op[0] != 0) {
                sptr = base.op;
                if (base.ety[0] != 0) {
                    sname = base.ety;
                }
            }
            else {
                // The base is an rvalue with no address (e.g. a function call returning a
                // struct by value) — materialize it into a fresh alloca, then GEP into that.
                CgVal val = cg_expr(g, e.a);
                if (val.ety[0] != 0) {
                    sname = val.ety;
                }
                string slot = cg_entry_alloca(g, val.ty);
                cg_emit(g, "  store ");
                cg_emit(g, val.ty);
                cg_emit(g, " ");
                cg_emit(g, val.op);
                cg_emit(g, ", ptr ");
                cg_emit(g, slot);
                cg_emit(g, "\n");
                sptr = slot;
            }
        }
        CgStruct s = cg_find_struct(g, sname);
        int idx = cg_field_idx(&s, e.sval);
        // A union's members all overlap at offset 0: GEP to the storage (field 0), and the
        // member's own type governs the later load/store. A struct uses the field index.
        int gepidx = idx;
        if (cg_is_union(g, s.name) == 1) {
            gepidx = 0;
        }
        else if (cg_is_bf_struct(g, s.name) == 1) {           // bitfield struct: its layout slot
            CgBF fs = cg_bf(g, s.name, e.sval);
            if (fs.boffs >= 0) {
                v.op = cg_bf_wordptr(g, sptr, s.name, fs);
                if (idx >= 0) {
                    v.ety = List_get<string>(&s.fetys, idx);
                }
                return v;
            }
            gepidx = fs.fidx;
        }
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        if (g.strict_alias == 1 && cg_is_union(g, s.name) == 1) {
            // -fstrict-aliasing: an i8 GEP keeps the member's accesses untagged (cg_tbaa),
            // so a union may be read through another member (C++ unionMemberPtr).
            cg_emit(g, " = getelementptr i8, ptr ");
            cg_emit(g, sptr);
            cg_emit(g, ", i64 0\n");
        }
        else {
            cg_emit(g, " = getelementptr inbounds %");
            cg_emit(g, s.name);
            cg_emit(g, ", ptr ");
            cg_emit(g, sptr);
            cg_emit(g, ", i32 0, i32 ");
            cg_emit(g, cg_itoa(gepidx));
            cg_emit(g, "\n");
        }
        v.op = t;
        if (idx >= 0) {
            v.ety = List_get<string>(&s.fetys, idx);
        }
        return v;
    }
    return v;
}

// Address of `e` for a READ (a method receiver, an indexed array): its lvalue address, or,
// for an rvalue aggregate (a call result, `a + b`, a ternary), a temporary holding its
// value (mirrors CodeGen::evaluateAddress).
CgVal cg_addr(Codegen* g, *ExprNode e) {
    CgVal lv = cg_lval(g, e);
    if (lv.op[0] != 0) {
        return lv;
    }
    CgVal val = cg_expr(g, e);
    string slot = cg_entry_alloca(g, val.ty);
    cg_emit(g, "  store ");
    cg_emit(g, val.ty);
    cg_emit(g, " ");
    cg_emit(g, val.op);
    cg_emit(g, ", ptr ");
    cg_emit(g, slot);
    cg_emit(g, "\n");
    lv.op = slot;
    lv.ety = val.ety;
    if (lv.ety[0] == 0) {
        lv.ety = cg_etype(g, e);
    }
    return lv;
}

// --safe bounds check at `at`: fail when `idx_op` (type `ity`) is < 0 or >= `len_op` (an
// i64 value or integer literal). Mirrors the C++ `emitBoundsCheck`: sext to i64, OR the two
// comparisons, cond-branch to the failure block (cg_safe_fail) or continue.
void cg_bounds_check(Codegen* g, string idx_op, string ity, string len_op, *ExprNode at) {
    string idx64 = idx_op;
    if (cg_streq(ity, "i64") == 0) {                       // widen the index to i64 first
        idx64 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, idx64);
        cg_emit(g, " = sext ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, idx_op);
        cg_emit(g, " to i64\n");
    }
    string lo = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, lo);
    cg_emit(g, " = icmp slt i64 ");
    cg_emit(g, idx64);
    cg_emit(g, ", 0\n");
    string hi = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, hi);
    cg_emit(g, " = icmp sge i64 ");
    cg_emit(g, idx64);
    cg_emit(g, ", ");
    cg_emit(g, len_op);
    cg_emit(g, "\n");
    string oob = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, oob);
    cg_emit(g, " = or i1 ");
    cg_emit(g, lo);
    cg_emit(g, ", ");
    cg_emit(g, hi);
    cg_emit(g, "\n");
    cg_safe_fail(g, oob, at, "index %lld out of bounds for length %lld", idx64, len_op, "0");
}

// The rest of codegen_lval.esk, in these parts (imported in order):
import "codegen_lval_slice.esk";
import "codegen_lval_binary.esk";
