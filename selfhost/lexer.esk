// Self-hosted lexer, the Eskiu port of `lexer/lexer.cpp`. Free functions over a
// `Lexer*` (explicit cursor state) with the C++ peek/advance/skip semantics: whitespace
// and comments, identifiers and keywords, numbers, string and char literals, operators,
// delimiters and pragmas. Its token stream is byte-identical to `eskiuc --test-lexer`
// (tests/selfhost/lex_parity.sh). The preprocessor is selfhost/preprocessor.esk.

import <ctype>;
import <io>;
import <mem>;
import "tokens.esk";

struct Lexer {
    *uint8 src;
    int len;
    int pos;
    int line;
    int col;
}

// Lexical diagnostics (mirrors Lexer::lexError). `g_lex_file` labels them ("" →
// "<input>"); `g_lex_errs` counts them so a driver can abort before parsing, like
// the C++ `hadError`. Lexing continues after an error, as in the C++ lexer.
string g_lex_file;
int g_lex_errs;

extern int64 write(int fd, *void buf, int64 n);
extern int dprintf(int fd, string fmt, ...);   // diagnostics go to stderr, like the C++

void lx_puts_err(string s) {
    int64 n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    write(2, (*void)s, n);
}

void lx_error(int line, int col, string msg) {
    uint8[32] nb;
    lx_puts_err("error: ");
    if (g_lex_file == null) {
        lx_puts_err("<input>");
    }
    else if (g_lex_file[0] == 0) {
        lx_puts_err("<input>");
    }
    else {
        lx_puts_err(g_lex_file);
    }
    sprintf((string)&nb[0], ":%d:%d: ", line, col);
    lx_puts_err((string)&nb[0]);
    lx_puts_err(msg);
    lx_puts_err("\n");
    g_lex_errs = g_lex_errs + 1;
}

int lx_at_end(Lexer* lx) {
    if (lx.pos >= lx.len) {
        return 1;
    }
    return 0;
}

// Stamp span/position on a token built by the operator dispatch and return it
// (keeps each operator case to one line). len is derived from the cursor.
Token lx_finish(Token t, int sp, int pos, int sl, int sc) {
    t.start = sp;
    t.len = pos - sp;
    t.line = sl;
    t.col = sc;
    return t;
}

// Current byte (0 at end), as an int — matches the C++ `peek()` returning '\0'.
int lx_peek(Lexer* lx) {
    if (lx_at_end(lx) == 1) {
        return 0;
    }
    return (int)lx.src[lx.pos];
}

// Next byte after the cursor (0 if none) — matches the C++ `peek_next()`.
int lx_peek_next(Lexer* lx) {
    if (lx.pos + 1 >= lx.len) {
        return 0;
    }
    return (int)lx.src[lx.pos + 1];
}

int lx_advance(Lexer* lx) {
    int c = lx_peek(lx);
    lx.pos = lx.pos + 1;
    if (c == 10) {           // '\n'
        lx.line = lx.line + 1;
        lx.col = 1;
    } else {
        lx.col = lx.col + 1;
    }
    return c;
}

void lx_skip_ws(Lexer* lx) {
    while (lx_at_end(lx) == 0 && is_space(lx_peek(lx)) == 1) {
        lx_advance(lx);
    }
}

// Skip a `//` line comment or a `/* */` block comment (mirror skip_comment). An
// unterminated block comment is reported and consumed to EOF.
void lx_skip_comment(Lexer* lx) {
    if (lx_peek(lx) == 47 && lx_peek_next(lx) == 47) {          // '//'
        while (lx_at_end(lx) == 0 && lx_peek(lx) != 10) {
            lx_advance(lx);
        }
    } else if (lx_peek(lx) == 47 && lx_peek_next(lx) == 42) {   // '/*'
        int sl = lx.line;
        int sc = lx.col;
        lx_advance(lx);                                         // '/'
        lx_advance(lx);                                         // '*'
        while (lx_at_end(lx) == 0) {
            if (lx_peek(lx) == 42 && lx_peek_next(lx) == 47) {  // '*/'
                lx_advance(lx);
                lx_advance(lx);
                return;
            }
            lx_advance(lx);
        }
        lx_error(sl, sc, "unterminated block comment");
    }
}

// Owned copy of src[a, b).
string lx_span(*uint8 src, int a, int b) {
    *uint8 buf = alloc<uint8>(b - a + 1);
    int i = a;
    while (i < b) {
        buf[i - a] = src[i];
        i = i + 1;
    }
    buf[b - a] = 0;
    return (string)buf;
}

string lx_cat3(string a, string b, string c) {
    int la = 0;
    while (a[la] != 0) {
        la = la + 1;
    }
    int lb = 0;
    while (b[lb] != 0) {
        lb = lb + 1;
    }
    int lc = 0;
    while (c[lc] != 0) {
        lc = lc + 1;
    }
    *uint8 buf = alloc<uint8>(la + lb + lc + 1);
    int i = 0;
    while (i < la) {
        buf[i] = (uint8)a[i];
        i = i + 1;
    }
    i = 0;
    while (i < lb) {
        buf[la + i] = (uint8)b[i];
        i = i + 1;
    }
    i = 0;
    while (i < lc) {
        buf[la + lb + i] = (uint8)c[i];
        i = i + 1;
    }
    buf[la + lb + lc] = 0;
    return (string)buf;
}

// Consume a run of digits of `base` (10, 16 or 2). A `_` between two digits is a
// separator (mirrors Lexer::readDigits); one that is not is an error.
int lx_is_base_digit(int c, int base) {
    if (base == 2) {
        if (c == 48 || c == 49) {
            return 1;
        }
        return 0;
    }
    if (base == 16) {
        return is_hex(c);
    }
    return is_digit(c);
}

void lx_digits(Lexer* lx, int base, int sl, int sc) {
    int any = 0;
    while (lx_at_end(lx) == 0) {
        int c = lx_peek(lx);
        if (lx_is_base_digit(c, base) == 1) {
            lx_advance(lx);
            any = 1;
            continue;
        }
        if (c == 95 && any == 1 && lx_is_base_digit(lx_peek_next(lx), base) == 1) {
            lx_advance(lx);
            continue;
        }
        if (c == 95 && any == 1) {
            lx_advance(lx);
            lx_error(sl, sc, "digit separator '_' must be between two digits");
            continue;
        }
        break;
    }
}

// A numeric literal as diagnostics show it: as written, without separators.
string lx_num_shown(*uint8 src, int start, int end) {
    *uint8 buf = alloc<uint8>(end - start + 1);
    int n = 0;
    int i = start;
    while (i < end) {
        if ((int)src[i] != 95) {
            buf[n] = src[i];
            n = n + 1;
        }
        i = i + 1;
    }
    buf[n] = 0;
    return (string)buf;
}

// The text of a numeric token: separators dropped, and a binary literal as the same
// value in hex (the C++ lexer stores it so), so every later phase reads it as before.
string lx_num_text(*uint8 src, int start, int len) {
    *uint8 buf = alloc<uint8>(len + 20);
    int n = 0;
    int i = start;
    while (i < start + len) {
        if ((int)src[i] != 95) {
            buf[n] = src[i];
            n = n + 1;
        }
        i = i + 1;
    }
    buf[n] = 0;
    if (n < 2 || (int)buf[0] != 48 || ((int)buf[1] != 98 && (int)buf[1] != 66)) {
        return (string)buf;
    }
    int b = 2;
    while (b < n && (int)buf[b] == 48) {
        b = b + 1;
    }
    if (n == 2) {
        return "0";
    }
    *uint8 out = alloc<uint8>(n + 4);
    out[0] = (uint8)48;
    out[1] = (uint8)120;
    int o = 2;
    int nb = n - b;
    if (nb == 0) {
        out[2] = (uint8)48;
        out[3] = 0;
        return (string)out;
    }
    int pad = (4 - nb % 4) % 4;
    int acc = 0;
    int cnt = pad;
    int k = b;
    while (k < n) {
        acc = acc * 2 + ((int)buf[k] - 48);
        cnt = cnt + 1;
        if (cnt == 4) {
            if (acc < 10) {
                out[o] = (uint8)(48 + acc);
            } else {
                out[o] = (uint8)(55 + acc);
            }
            o = o + 1;
            acc = 0;
            cnt = 0;
        }
        k = k + 1;
    }
    out[o] = 0;
    return (string)out;
}

// A number must not run straight into an identifier character (`3.5f`, `12abc`);
// report it and consume the tail (mirrors checkNumberSuffix). The token ends before
// the tail, like the C++.
void lx_check_suffix(Lexer* lx, int sp, int sl, int sc) {
    if (lx_at_end(lx) == 1 || is_ident_cont(lx_peek(lx)) == 0) {
        return;
    }
    int end = lx.pos;
    while (lx_at_end(lx) == 0 && is_ident_cont(lx_peek(lx)) == 1) {
        lx_advance(lx);
    }
    lx_error(sl, sc, lx_cat3(lx_cat3("invalid suffix '", lx_span(lx.src, end, lx.pos), "' on numeric literal '"),
                             lx_num_shown(lx.src, sp, end), "'"));
}

// An integer literal src[sp, pos) (decimal, 0x hex or 0 octal, digits already checked)
// must fit in 64 bits (mirrors checkIntegerRange).
void lx_check_int_range(Lexer* lx, int sp, int sl, int sc) {
    int i = sp;
    int base = 10;
    int n = lx.pos - sp;
    if (n > 2 && (int)lx.src[sp] == 48 && ((int)lx.src[sp + 1] == 120 || (int)lx.src[sp + 1] == 88)) {
        base = 16;
        i = sp + 2;
    }
    else if (n > 1 && (int)lx.src[sp] == 48) {
        base = 8;
    }
    uint64 v = 0;
    uint64 umax = (uint64)0 - (uint64)1;
    while (i < lx.pos) {
        int c = (int)lx.src[i];
        if (c == 95) {
            i = i + 1;
            continue;
        }
        int d = 0;
        if (c >= 48 && c <= 57) {
            d = c - 48;
        }
        else if (c >= 97 && c <= 102) {
            d = c - 87;
        }
        else {
            d = c - 55;
        }
        if (v > (umax - (uint64)d) / (uint64)base) {
            lx_error(sl, sc, lx_cat3("integer literal '", lx_num_shown(lx.src, sp, lx.pos), "' does not fit in 64 bits"));
            return;
        }
        v = v * (uint64)base + (uint64)d;
        i = i + 1;
    }
}

// Does the lexeme src[start, start+len) equal the NUL-terminated keyword `kw`?
int lexeme_eq(*uint8 src, int start, int len, string kw) {
    int i = 0;
    while (i < len) {
        if (kw[i] == 0) {                     // kw shorter than lexeme
            return 0;
        }
        if ((int)src[start + i] != (int)kw[i]) {
            return 0;
        }
        i = i + 1;
    }
    if (kw[len] == 0) {                       // kw ends exactly at len
        return 1;
    }
    return 0;
}

// Classify an identifier lexeme: keyword TokenType if it matches the table
// (mirrors Lexer::keywords in lexer/lexer.cpp), else IDENT.
int keyword_type(*uint8 src, int start, int len) {
    if (lexeme_eq(src, start, len, "let") == 1) {
        return LET;
    }
    if (lexeme_eq(src, start, len, "int") == 1) {
        return INT;
    }
    if (lexeme_eq(src, start, len, "float") == 1) {
        return FLOAT;
    }
    if (lexeme_eq(src, start, len, "double") == 1) {
        return DOUBLE;
    }
    if (lexeme_eq(src, start, len, "bool") == 1) {
        return BOOL;
    }
    if (lexeme_eq(src, start, len, "char") == 1) {
        return CHAR;
    }
    if (lexeme_eq(src, start, len, "string") == 1) {
        return STRING;
    }
    if (lexeme_eq(src, start, len, "void") == 1) {
        return VOID;
    }
    if (lexeme_eq(src, start, len, "struct") == 1) {
        return STRUCT;
    }
    if (lexeme_eq(src, start, len, "packed") == 1) {
        return PACKED;
    }
    if (lexeme_eq(src, start, len, "union") == 1) {
        return UNION;
    }
    if (lexeme_eq(src, start, len, "interface") == 1) {
        return INTERFACE;
    }
    if (lexeme_eq(src, start, len, "enum") == 1) {
        return ENUM;
    }
    if (lexeme_eq(src, start, len, "fn") == 1) {
        return FN;
    }
    if (lexeme_eq(src, start, len, "operator") == 1) {
        return OPERATOR;
    }
    if (lexeme_eq(src, start, len, "asm") == 1) {
        return ASM;
    }
    if (lexeme_eq(src, start, len, "volatile") == 1) {
        return VOLATILE;
    }
    if (lexeme_eq(src, start, len, "static") == 1) {
        return STATIC;
    }
    if (lexeme_eq(src, start, len, "escaping") == 1) {
        return ESCAPING;
    }
    if (lexeme_eq(src, start, len, "must_use") == 1) {
        return MUST_USE;
    }
    if (lexeme_eq(src, start, len, "async") == 1) {
        return ASYNC;
    }
    if (lexeme_eq(src, start, len, "await") == 1) {
        return AWAIT;
    }
    if (lexeme_eq(src, start, len, "const") == 1) {
        return CONST;
    }
    if (lexeme_eq(src, start, len, "sizeof") == 1) {
        return SIZEOF;
    }
    if (lexeme_eq(src, start, len, "free_closure") == 1) {
        return FREE_CLOSURE;
    }
    if (lexeme_eq(src, start, len, "thread_create") == 1) {
        return THREAD_CREATE;
    }
    if (lexeme_eq(src, start, len, "thread_join") == 1) {
        return THREAD_JOIN;
    }
    if (lexeme_eq(src, start, len, "for") == 1) {
        return FOR;
    }
    if (lexeme_eq(src, start, len, "in") == 1) {
        return IN;
    }
    if (lexeme_eq(src, start, len, "while") == 1) {
        return WHILE;
    }
    if (lexeme_eq(src, start, len, "do") == 1) {
        return DO;
    }
    if (lexeme_eq(src, start, len, "if") == 1) {
        return IF;
    }
    if (lexeme_eq(src, start, len, "else") == 1) {
        return ELSE;
    }
    if (lexeme_eq(src, start, len, "switch") == 1) {
        return SWITCH;
    }
    if (lexeme_eq(src, start, len, "match") == 1) {
        return MATCH;
    }
    if (lexeme_eq(src, start, len, "case") == 1) {
        return CASE;
    }
    if (lexeme_eq(src, start, len, "default") == 1) {
        return DEFAULT;
    }
    if (lexeme_eq(src, start, len, "break") == 1) {
        return BREAK;
    }
    if (lexeme_eq(src, start, len, "return") == 1) {
        return RETURN;
    }
    if (lexeme_eq(src, start, len, "import") == 1) {
        return IMPORT;
    }
    if (lexeme_eq(src, start, len, "extern") == 1) {
        return EXTERN;
    }
    if (lexeme_eq(src, start, len, "intrinsic") == 1) {
        return INTRINSIC;
    }
    if (lexeme_eq(src, start, len, "alloc_with") == 1) {
        return ALLOC_WITH;
    }
    if (lexeme_eq(src, start, len, "null") == 1) {
        return NULL_KW;
    }
    if (lexeme_eq(src, start, len, "true") == 1) {
        return TRUE;
    }
    if (lexeme_eq(src, start, len, "false") == 1) {
        return FALSE;
    }
    if (lexeme_eq(src, start, len, "try") == 1) {
        return TRY;
    }
    if (lexeme_eq(src, start, len, "catch") == 1) {
        return CATCH;
    }
    if (lexeme_eq(src, start, len, "finally") == 1) {
        return FINALLY;
    }
    if (lexeme_eq(src, start, len, "throw") == 1) {
        return THROW;
    }
    if (lexeme_eq(src, start, len, "defer") == 1) {
        return DEFER;
    }
    if (lexeme_eq(src, start, len, "errdefer") == 1) {
        return ERRDEFER;
    }
    if (lexeme_eq(src, start, len, "continue") == 1) {
        return CONTINUE;
    }
    if (lexeme_eq(src, start, len, "int8") == 1) {
        return INT8;
    }
    if (lexeme_eq(src, start, len, "int16") == 1) {
        return INT16;
    }
    if (lexeme_eq(src, start, len, "int32") == 1) {
        return INT32;
    }
    if (lexeme_eq(src, start, len, "int64") == 1) {
        return INT64;
    }
    if (lexeme_eq(src, start, len, "uint") == 1) {
        return UINT;
    }
    if (lexeme_eq(src, start, len, "uint8") == 1) {
        return UINT8;
    }
    if (lexeme_eq(src, start, len, "uint16") == 1) {
        return UINT16;
    }
    if (lexeme_eq(src, start, len, "uint32") == 1) {
        return UINT32;
    }
    if (lexeme_eq(src, start, len, "uint64") == 1) {
        return UINT64;
    }
    return IDENT;
}

// Scan one escape at the backslash (mirrors Lexer::readEscape): `\xNN` (one or two
// hex digits), octal `\NNN` (one to three digits, at most 255), or a simple escape;
// anything else is an error located at the backslash.
int lx_is_simple_esc(int e) {
    return e == 110 || e == 116 || e == 114 || e == 102 || e == 118 || e == 97 || e == 98
        || e == 92 || e == 34 || e == 39 || e == 63;
}

void lx_scan_escape(Lexer* lx) {
    int el = lx.line;
    int ec = lx.col;
    lx_advance(lx);                                  // backslash
    int e = lx_advance(lx);
    if (e == 120) {                                  // \x
        if (is_hex(lx_peek(lx)) == 0) {
            lx_error(el, ec, "\\x used with no following hex digits");
            return;
        }
        lx_advance(lx);
        if (is_hex(lx_peek(lx)) == 1) {
            lx_advance(lx);
        }
        return;
    }
    if (e >= 48 && e <= 55) {                        // octal
        int v = e - 48;
        int k = 0;
        while (k < 2 && lx_peek(lx) >= 48 && lx_peek(lx) <= 55) {
            v = v * 8 + (lx_advance(lx) - 48);
            k = k + 1;
        }
        if (v > 255) {
            lx_error(el, ec, "octal escape sequence out of range");
        }
        return;
    }
    if (lx_is_simple_esc(e) == 0) {
        uint8[48] mb;
        sprintf((string)&mb[0], "unknown escape sequence '\\%c'", e);
        lx_error(el, ec, (string)&mb[0]);
    }
}

// The rest of lexer.esk, in these parts (imported in order):
import "lexer_next.esk";
