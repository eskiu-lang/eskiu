// Self-hosted type checker. Consumes the AST (ast.esk) and mirrors sema/type_checker.cpp:
// name resolution over a scope stack, types and conversions, calls and generics,
// interfaces and constraints, control flow, the `-Wall` checks and the editor queries.
// A diagnostic has the same text and position as the C++ compiler's.
//
// The module is split into parts, imported here in order (each part relies on the
// declarations of the parts before it, so compile this file, not a part alone):
//   sema_base.esk          state, scopes, symbols and type helpers
//   sema_assign.esk        canonical spellings and assignability
//   sema_nullable.esk      nullable pointers and narrowing
//   sema_expr.esk          expressions
//   sema_stmt.esk          statements and the entry point
//   sema_flow.esk          definite return and -Wall flow checks
//   sema_tooling.esk       editor modes

import "sema_base.esk";
import "sema_assign.esk";
import "sema_nullable.esk";
import "sema_expr.esk";
import "sema_stmt.esk";
import "sema_flow.esk";
import "sema_tooling.esk";
import "sema_header.esk";
