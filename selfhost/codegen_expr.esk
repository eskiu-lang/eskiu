// Part of codegen.esk (expressions), imported from it in order; compile codegen.esk, not this file alone.

// An expression's Eskiu type never names an alias (like cg_etype), so every signedness
// and shape check on a value sees the target type (`(u8)x`, a call returning `u8`).
CgVal cg_expr_i(Codegen* g, *ExprNode e);
// `fmt` with each '%' doubled (literal text in a printf format).
void cg_dbg_lit(String* fmt, string t) {
    int i = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 37) {
            String_push(fmt, '%');
        }
        String_push(fmt, t[i]);
        i = i + 1;
    }
}

string cg_dbg_load(Codegen* g, string llty, string addr) {
    string v = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, v);
    cg_emit(g, " = load ");
    cg_emit(g, llty);
    cg_emit(g, ", ptr ");
    cg_emit(g, addr);
    cg_emit(g, "\n");
    return v;
}

string cg_dbg_conv(Codegen* g, string op, string from, string v, string to) {
    string r = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, r);
    cg_emit(g, " = ");
    cg_emit(g, op);
    cg_emit(g, " ");
    cg_emit(g, from);
    cg_emit(g, " ");
    cg_emit(g, v);
    cg_emit(g, " to ");
    cg_emit(g, to);
    cg_emit(g, "\n");
    return r;
}

// The printf format and arguments for the value of type `t0` at `addr` (C++
// CodeGen::dbgFormat): numbers, bool, char, string, pointers, arrays (16 elements at most)
// and plain structs field by field, 4 levels deep; any other type prints as `<T>`.
void cg_dbg_format(Codegen* g, string t0, string addr, String* fmt, String* args, int depth) {
    string t = cg_strip_nullable(cg_dealias(g, t0));
    string llty = cg_lltype(g, t);
    int sint = cg_streq(t, "int") | cg_streq(t, "int8") | cg_streq(t, "int16") | cg_streq(t, "int32") | cg_streq(t, "int64");
    int uns = cg_streq(t, "uint") | cg_streq(t, "uint8") | cg_streq(t, "uint16") | cg_streq(t, "uint32") | cg_streq(t, "uint64");
    if (sint == 1 || uns == 1) {
        string v = cg_dbg_load(g, llty, addr);
        if (cg_streq(llty, "i64") == 0) {
            v = cg_dbg_conv(g, sint == 1 ? "sext" : "zext", llty, v, "i64");
        }
        String_append(args, ", i64 ");
        String_append(args, v);
        String_append(fmt, sint == 1 ? "%lld" : "%llu");
    } else if (cg_streq(t, "bool") == 1) {
        string v = cg_dbg_load(g, llty, addr);
        string r = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, r);
        cg_emit(g, " = select i1 ");
        cg_emit(g, v);
        cg_emit(g, ", ptr ");
        cg_emit(g, cg_string_global(g, "true"));
        cg_emit(g, ", ptr ");
        cg_emit(g, cg_string_global(g, "false"));
        cg_emit(g, "\n");
        String_append(args, ", ptr ");
        String_append(args, r);
        String_append(fmt, "%s");
    } else if (cg_streq(t, "char") == 1) {
        string v = cg_dbg_conv(g, "zext", "i8", cg_dbg_load(g, llty, addr), "i32");
        String_append(args, ", i32 ");
        String_append(args, v);
        String_append(fmt, "'%c'");
    } else if (cg_streq(t, "float") == 1 || cg_streq(t, "double") == 1) {
        string v = cg_dbg_load(g, llty, addr);
        if (cg_streq(t, "float") == 1) {
            v = cg_dbg_conv(g, "fpext", "float", v, "double");
        }
        String_append(args, ", double ");
        String_append(args, v);
        String_append(fmt, "%g");
    } else if (cg_streq(t, "string") == 1) {
        string v = cg_dbg_load(g, "ptr", addr);
        string z = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, z);
        cg_emit(g, " = icmp eq ptr ");
        cg_emit(g, v);
        cg_emit(g, ", null\n");
        string q = cg_tmp(g);                  // a null string prints as `null`, unquoted
        cg_emit(g, "  ");
        cg_emit(g, q);
        cg_emit(g, " = select i1 ");
        cg_emit(g, z);
        cg_emit(g, ", ptr ");
        cg_emit(g, cg_string_global(g, ""));
        cg_emit(g, ", ptr ");
        cg_emit(g, cg_string_global(g, "\""));
        cg_emit(g, "\n");
        string r = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, r);
        cg_emit(g, " = select i1 ");
        cg_emit(g, z);
        cg_emit(g, ", ptr ");
        cg_emit(g, cg_string_global(g, "null"));
        cg_emit(g, ", ptr ");
        cg_emit(g, v);
        cg_emit(g, "\n");
        String_append(args, ", ptr ");
        String_append(args, q);
        String_append(args, ", ptr ");
        String_append(args, r);
        String_append(args, ", ptr ");
        String_append(args, q);
        String_append(fmt, "%s%s%s");
    } else if (cg_is_array(t) == 1 && cg_is_slice(t) == 0) {
        int64 n = cg_parse_i64(cg_dim_val(g, cg_array_count(t)));
        string et = cg_array_elem(t);
        String_append(fmt, "[");
        int64 i = (int64)0;
        while (i < n && i < (int64)16) {
            if (i > (int64)0) {
                String_append(fmt, ", ");
            }
            string ep = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, ep);
            cg_emit(g, " = getelementptr inbounds ");
            cg_emit(g, llty);
            cg_emit(g, ", ptr ");
            cg_emit(g, addr);
            cg_emit(g, ", i64 0, i64 ");
            cg_emit(g, cg_i64toa(i));
            cg_emit(g, "\n");
            if (depth < 4) {
                cg_dbg_format(g, et, ep, fmt, args, depth + 1);
            } else {
                String_append(fmt, "...");
            }
            i = i + (int64)1;
        }
        if (n > (int64)16) {
            String_append(fmt, ", ...");
        }
        String_append(fmt, "]");
    } else if (cg_is_ptr_ty(t) == 1 || cg_streq(llty, "ptr") == 1) {
        string v = cg_dbg_load(g, "ptr", addr);
        String_append(args, ", ptr ");
        String_append(args, v);
        String_append(fmt, "%p");
    } else {
        CgStruct st;
        st.name = "";
        if (cg_is_fnty(t) == 0 && cg_is_slice(t) == 0) {
            st = cg_find_struct(g, t);
        }
        if (st.name[0] != 0 && cg_is_union(g, st.name) == 0 && cg_is_bf_struct(g, st.name) == 0) {
            cg_dbg_lit(fmt, st.name);
            String_append(fmt, "{");
            int i = 0;
            int n = List_len<string>(&st.fnames);
            while (i < n) {
                if (i > 0) {
                    String_append(fmt, ", ");
                }
                cg_dbg_lit(fmt, List_get<string>(&st.fnames, i));
                String_append(fmt, ": ");
                string fp = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, fp);
                cg_emit(g, " = getelementptr inbounds %");
                cg_emit(g, st.name);
                cg_emit(g, ", ptr ");
                cg_emit(g, addr);
                cg_emit(g, ", i32 0, i32 ");
                cg_emit(g, cg_itoa(i));
                cg_emit(g, "\n");
                if (depth < 4) {
                    cg_dbg_format(g, List_get<string>(&st.fetys, i), fp, fmt, args, depth + 1);
                }
                else {
                    String_append(fmt, "...");
                }
                i = i + 1;
            }
            String_append(fmt, "}");
        } else if (cg_streq(llty, "i32") == 1) {   // a plain enum: `Color(5)`
            cg_dbg_lit(fmt, t);
            String_append(fmt, "(%lld)");
            string v = cg_dbg_conv(g, "sext", "i32", cg_dbg_load(g, "i32", addr), "i64");
            String_append(args, ", i64 ");
            String_append(args, v);
        } else {
            String_append(fmt, "<");
            cg_dbg_lit(fmt, t);
            String_append(fmt, ">");
        }
    }
}

// `dbg(e)`: print `[dbg L:C] <source of e> = <value>` to stderr and yield the value
// (C++ CodeGen::emitDbg).
CgVal cg_emit_dbg(Codegen* g, *ExprNode e) {
    *ExprNode a = List_get<*ExprNode>(&e.kids, 0);
    string t = cg_etype(g, a);
    string llty = cg_lltype(g, t);
    CgVal v = cg_expr(g, a);
    string op = cg_coerce(g, v, llty);
    string slot = cg_entry_alloca(g, llty);
    cg_emit(g, "  store ");
    cg_emit(g, llty);
    cg_emit(g, " ");
    cg_emit(g, op);
    cg_emit(g, ", ptr ");
    cg_emit(g, slot);
    cg_emit(g, "\n");
    let fmt: String;
    String_init(&fmt, 64);
    let args: String;
    String_init(&args, 64);
    String_append(&fmt, "[dbg ");
    String_append(&fmt, cg_itoa(e.a.line));
    String_append(&fmt, ":");
    String_append(&fmt, cg_itoa(e.a.col));
    String_append(&fmt, "] ");
    if (e.dbg_text != null) {
        cg_dbg_lit(&fmt, e.dbg_text);
    }
    String_append(&fmt, " = ");
    cg_dbg_format(g, t, slot, &fmt, &args, 0);
    String_append(&fmt, "\n");
    string err = "";
    if (g.wintgt == 1) {
        cg_ensure_extern(g, "__acrt_iob_func", "declare ptr @__acrt_iob_func(i32)\n");
        err = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, err);
        cg_emit(g, " = call ptr @__acrt_iob_func(i32 2)\n");
    } else {
        string nm = g.darwin == 1 ? "__stderrp" : "stderr";
        if (cg_count_global(g, nm) == 0) {
            cg_add_global(g, nm, cg_cat("@", nm), "ptr", "*void");
            String_append(&g.globals, "@");
            String_append(&g.globals, nm);
            String_append(&g.globals, " = external global ptr\n");
        }
        err = cg_dbg_load(g, "ptr", cg_cat("@", nm));
    }
    cg_ensure_extern(g, "fprintf", "declare i32 @fprintf(ptr, ptr, ...)\n");
    string cargs = cg_cat(cg_cat(cg_cat("ptr ", err), ", ptr "), cg_string_global(g, fmt.data));
    cg_emit_callish(g, "i32 (ptr, ptr, ...)", "@fprintf", cg_cat(cargs, args.data), 0);
    CgVal r;
    r.op = cg_dbg_load(g, llty, slot);
    r.ty = llty;
    r.ety = t;
    return r;
}

// The int64 Eskiu sees for the result of an extern whose C result (size_t, ssize_t,
// c_long) is narrower on the target (C++ CodeGen::widenCResult).
CgVal cg_widen_cret(Codegen* g, CgFn* f, CgVal v) {
    if (f.cret == null || f.cret[0] == 0 || cg_streq(v.ty, "i64") == 1 || cg_streq(v.ty, "void") == 1) {
        return v;
    }
    string r = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, r);
    if (cg_streq(f.cret, "z") == 1) {
        cg_emit(g, " = zext ");
    }
    else {
        cg_emit(g, " = sext ");
    }
    cg_emit(g, v.ty);
    cg_emit(g, " ");
    cg_emit(g, v.op);
    cg_emit(g, " to i64\n");
    let w: CgVal;
    w.op = r;
    w.ty = "i64";
    w.ety = v.ety;
    return w;
}

CgVal cg_expr(Codegen* g, *ExprNode e) {
    int opened = cg_chain_begin(g, e);
    CgVal v = cg_expr_i(g, e);
    if (opened == 1) {
        g.mactive = 0;
    }
    if (List_len<CgSub>(&g.aliases) > 0 && v.ety != null && v.ety[0] != 0) {
        v.ety = cg_dealias(g, v.ety);
    }
    return v;
}

CgVal cg_expr_i(Codegen* g, *ExprNode e) {
    let v: CgVal;
    v.ety = "";
    if (e == null) {
        v.op = "0";
        v.ty = "i32";
        return v;
    }

    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_STRING) {
            v.op = cg_string_global_n(g, e.sval, e.slen);
            v.ty = "ptr";
            return v;
        }
        // Literals carry their Eskiu type too, so an operation mixing one with an unsigned
        // operand gets C's conversions (`1 - u` is unsigned; a char literal is unsigned).
        if (e.lit_kind == LIT_CHAR) {
            v.op = cg_itoa((int)(uint8)e.sval[0]);
            v.ty = "i8";
            v.ety = "char";
            return v;
        }
        v.op = e.sval;
        if (e.lit_kind == LIT_BOOL) {
            v.ty = "i1";
            v.ety = "bool";
        }
        else if (e.lit_kind == LIT_NULL) {
            v.op = "null";
            v.ty = "ptr";
        }
        else if (e.lit_kind == LIT_FLOAT) {   // float literal defaults to double
            v.op = cg_double_lit(e.sval);
            v.ty = "double";
            v.ety = "double";
        }
        else {                            // integer literal: normalize base, i64 if it won't fit signed i32
            int neg = 0;
            if (e.sval[0] == 45) {
                neg = 1;
            }
            let mag: uint64 = cg_int_lit_mag(e.sval);
            string dec = cg_u64toa(mag);
            if (neg == 1) {
                v.op = cg_cat("-", dec);
            } else {
                v.op = dec;
            }
            v.ty = "i32";
            v.ety = "int";
            let lim: uint64 = 2147483647;                 // INT32_MAX; INT32_MIN is one larger in magnitude
            if (neg == 1) {
                lim = 2147483648;
            }
            if (mag > lim) {
                v.ty = "i64";
                v.ety = "int64";
            }
            if (neg == 0 && mag > (uint64)9223372036854775807) {
                v.ety = "uint64";
            }
        }
        return v;
    }

    if (e.kind == EK_IDENT) {
        CgLocal l = cg_find_local(g, e.sval);
        if (l.slot[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = load ");
            cg_emit(g, cg_vol(g, e));
            cg_emit(g, l.ty);
            cg_emit(g, ", ptr ");
            cg_emit(g, l.slot);
            cg_emit(g, "\n");
            v.op = t;
            v.ty = l.ty;
            v.ety = l.ety;
            return v;
        }
        string ev = cg_enum_val(g, e.sval);            // a plain-enum constant?
        if (ev[0] != 0) {
            v.op = ev;
            v.ty = "i32";
            v.ety = "int";
            return v;
        }
        CgLocal gv = cg_find_global(g, e.sval);        // a global variable?
        if (gv.slot[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = load ");
            cg_emit(g, cg_vol(g, e));
            cg_emit(g, gv.ty);
            cg_emit(g, ", ptr ");
            cg_emit(g, gv.slot);
            cg_emit(g, "\n");
            v.op = t;
            v.ty = gv.ty;
            v.ety = gv.ety;
            return v;
        }
        CgVariant var = cg_find_variant(g, e.sval);    // a payload-less ADT variant (e.g. None)?
        if (var.ename[0] != 0) {
            return cg_build_variant(g, var, null);
        }
        if (cg_is_fn(g, e.sval) == 1) {                // a top-level function used as a value
            v.op = cg_cat("@", e.sval);   // raw fn ptr; → closure via cg_coerce
            v.ty = "ptr";
            v.ety = "";
            return v;
        }
        v.op = e.sval;         // fallback
        v.ty = "i32";
        return v;
    }

    if (e.kind == EK_INCDEC) {                          // ++x / x++ / --x / x--
        int L0 = cg_strlen(e.sval);
        if (e.a != null && e.a.kind == EK_MEMBER) {     // a bitfield: masked read-modify-write
            string bet = cg_etype(g, e.a.a);
            string bsn = bet;
            if (cg_is_ptr_ty(bet) == 1) {
                bsn = cg_strip_ptr(bet);
            }
            CgBF bslot = cg_bf(g, bsn, e.a.sval);
            if (bslot.bw > 0) {
                string bsn2 = "";
                string bbase = cg_member_baseptr(g, e.a.a, &bsn2);
                string wa = cg_bf_wordptr(g, bbase, bsn2, bslot);
                g.bf_vol = cg_vol(g, e.a);
                CgVal bold = cg_bf_load(g, wa, bslot);
                string bnw = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, bnw);
                cg_emit(g, " = ");
                if ((int)e.sval[L0 - 1] == 45) {
                    cg_emit(g, "sub ");
                } else {
                    cg_emit(g, "add ");
                }
                cg_emit(g, bslot.sty);
                cg_emit(g, " ");
                cg_emit(g, bold.op);
                cg_emit(g, ", 1\n");
                cg_bf_store(g, wa, bslot, bnw);
                if ((int)e.sval[1] == 114) {                  // prefix: the stored (wrapped) value
                    CgVal bnv = cg_bf_promote(g, cg_bf_load(g, wa, bslot), bslot);
                    g.bf_vol = "";
                    return bnv;
                }
                g.bf_vol = "";
                return bold;                              // postfix: the declared type, unpromoted (as clang)
            }
        }
        CgVal lv = cg_lval(g, e.a);
        string ety = lv.ety;
        string llty = cg_lltype(g, ety);
        string old = cg_tmp(g);
        string ivol = cg_vol(g, e.a);
        cg_emit(g, "  ");
        cg_emit(g, old);
        cg_emit(g, " = load ");
        cg_emit(g, ivol);
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, lv.op);
        cg_emit(g, "\n");
        int L = cg_strlen(e.sval);
        int dec = 0;   // last char '-'
        if ((int)e.sval[L - 1] == 45) {
            dec = 1;
        }
        int pre = 0;      // "pre..." (index 1 is 'r')
        if ((int)e.sval[1] == 114) {
            pre = 1;
        }
        string nw = cg_tmp(g);
        if (cg_is_ptr_ty(ety) == 1 || cg_streq(llty, "ptr") == 1) {   // pointer / string: step one element
            string ellt = "i8";                         // a string (char pointer) or *void steps a byte
            if (cg_is_ptr_ty(ety) == 1) {
                ellt = cg_lltype(g, cg_strip_ptr(ety));
            }
            if (cg_streq(ellt, "void") == 1) {
                ellt = "i8";
            }
            cg_emit(g, "  ");
            cg_emit(g, nw);
            cg_emit(g, " = getelementptr ");
            cg_emit(g, ellt);
            cg_emit(g, ", ptr ");
            cg_emit(g, old);
            cg_emit(g, ", i64 ");
            if (dec == 1) {
                cg_emit(g, "-1");
            } else {
                cg_emit(g, "1");
            }
            cg_emit(g, "\n");
        } else {
            cg_emit(g, "  ");
            cg_emit(g, nw);
            cg_emit(g, " = ");
            if (dec == 1) {
                cg_emit(g, "sub ");
            } else {
                cg_emit(g, "add ");
            }
            cg_emit(g, llty);
            cg_emit(g, " ");
            cg_emit(g, old);
            cg_emit(g, ", 1\n");
        }
        cg_emit(g, "  store ");
        cg_emit(g, ivol);
        cg_emit(g, llty);
        cg_emit(g, " ");
        cg_emit(g, nw);
        cg_emit(g, ", ptr ");
        cg_emit(g, lv.op);
        cg_emit(g, "\n");
        if (pre == 1) {
            v.op = nw;
        } else {
            v.op = old;
        }
        v.ty = llty;
        v.ety = ety;
        return v;
    }

    if (e.kind == EK_MEMBER) {                          // a bitfield member read masks/shifts
        string bet = cg_etype(g, e.a);
        string sn = bet;
        if (cg_is_ptr_ty(bet) == 1) {
            sn = cg_strip_ptr(bet);
        }
        CgBF slot = cg_bf(g, sn, e.sval);
        if (slot.bw > 0) {
            string sn2 = "";
            string baseptr = cg_member_baseptr(g, e.a, &sn2);
            g.bf_vol = cg_vol(g, e);
            CgVal bv = cg_bf_read(g, baseptr, sn2, slot);
            g.bf_vol = "";
            return bv;
        }
    }
    // Slice construction: base[lo..hi] → a fat pointer { &base[lo], hi - lo }.
    if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) > 0) {
        string lo = cg_coerce(g, cg_expr(g, e.b), "i64");
        string hi = cg_coerce(g, cg_expr(g, List_get<*ExprNode>(&e.kids, 0)), "i64");
        string data = cg_slice_elem_addr(g, e.a, lo, hi, "i64");
        string len = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, len);
        cg_emit(g, " = sub i64 ");
        cg_emit(g, hi);
        cg_emit(g, ", ");
        cg_emit(g, lo);
        cg_emit(g, "\n");
        string s0 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, s0);
        cg_emit(g, " = insertvalue { ptr, i64 } undef, ptr ");
        cg_emit(g, data);
        cg_emit(g, ", 0\n");
        string s1 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, s1);
        cg_emit(g, " = insertvalue { ptr, i64 } ");
        cg_emit(g, s0);
        cg_emit(g, ", i64 ");
        cg_emit(g, len);
        cg_emit(g, ", 1\n");
        v.op = s1;
        v.ty = "{ ptr, i64 }";
        v.ety = cg_etype(g, e);
        return v;
    }
    // Slice `.len` → the fat pointer's length field (i64).
    if (e.kind == EK_MEMBER && cg_streq(e.sval, "len") == 1 && cg_is_slice(cg_etype(g, e.a)) == 1) {
        CgVal fat = cg_expr(g, e.a);
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = extractvalue { ptr, i64 } ");
        cg_emit(g, fat.op);
        cg_emit(g, ", 1\n");
        v.op = t;
        v.ty = "i64";
        v.ety = "int64";
        return v;
    }
    if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) == 0) {   // overloaded subscript `base[i]`
        string iopn = cg_op_resolve(g, "[]", cg_etype(g, e.a), cg_etype(g, e.b));
        if (iopn[0] != 0) {
            return cg_op_call(g, iopn, e.a, e.b);
        }
    }
    if (e.kind == EK_MEMBER || e.kind == EK_INDEX) {    // field/element read: GEP + load
        CgVal lv = cg_lval(g, e);
        string llty = cg_lltype(g, lv.ety);
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = load ");
        cg_emit(g, cg_vol(g, e));
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, lv.op);
        cg_emit(g, "\n");
        v.op = t;
        v.ty = llty;
        v.ety = lv.ety;
        return v;
    }

    if (e.kind == EK_UNARY) {
        if (cg_streq(e.sval, "&") == 1) {               // address-of
            // (an rvalue operand is only a synthesized receiver, `mk().get(0)` as
            // `List_get(&mk(), 0)`: it is held in a temporary)
            CgVal lv = cg_addr(g, e.a);
            v.op = lv.op;
            v.ty = "ptr";
            v.ety = cg_cat("*", lv.ety);
            return v;
        }
        if (cg_streq(e.sval, "*") == 1) {               // deref (rvalue)
            CgVal p = cg_expr(g, e.a);
            string ety = cg_deref_ty(cg_etype(g, e.a));
            string llty = cg_lltype(g, ety);
            string t = cg_tmp(g);
            string pnn = cg_safe_nonnull(g, p.op);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = load ");
            cg_emit(g, cg_vol(g, e));
            cg_emit(g, llty);
            cg_emit(g, ", ptr ");
            cg_emit(g, pnn);
            cg_emit(g, "\n");
            v.op = t;
            v.ty = llty;
            v.ety = ety;
            return v;
        }
        if (cg_streq(e.sval, "-") == 1 || cg_streq(e.sval, "!") == 1 || cg_streq(e.sval, "~") == 1) {
            return cg_unary_chain(g, e);
        }
        return cg_expr(g, e.a);
    }

    if (e.kind == EK_BINARY) {
        if (cg_streq(e.sval, "=") == 1) {              // assignment
            int is_bf = 0;
            if (e.a != null && e.a.kind == EK_MEMBER) {
                string bet0 = cg_etype(g, e.a.a);
                string sn0 = bet0;
                if (cg_is_ptr_ty(bet0) == 1) {
                    sn0 = cg_strip_ptr(bet0);
                }
                if (cg_bf(g, sn0, e.a.sval).bw > 0) {
                    is_bf = 1;
                }
            }
            // `lv op= v` (parsed as `lv = lv op v` sharing the lvalue node) where evaluating
            // `lv` has side effects (`a[f()] += 1`, `a[i++] += 1`): compute its address ONCE
            // into a temporary pointer, then run the ordinary `*p = *p op v` (mirrors
            // CodeGen::emitCompoundAssign), so overloads/coercions/--safe checks still apply.
            if (e.b != null && e.b.kind == EK_BINARY && e.b.a == e.a && cg_is_pure(e.a) == 0) {
                string ctmp = cg_cat("__cmpd", cg_itoa(g.lam_seq));
                g.lam_seq = g.lam_seq + 1;
                string cslot = cg_entry_alloca(g, "ptr");
                int clmark = List_len<CgLocal>(&g.locals);
                if (cg_vol(g, e.a)[0] != 0) {
                    List_push<string>(&g.vols, ctmp);
                }
                *ExprNode cder = alloc<ExprNode>(1);
                cder.kind = EK_UNARY;
                cder.sval = "*";
                cder.a = cgb_ident(ctmp);
                *ExprNode ctarget = cder;
                if (is_bf == 1) {
                    // A bitfield has no address of its own: evaluate the struct's address
                    // once instead, and read-modify-write `(*p).field`.
                    string bbt = cg_etype(g, e.a.a);
                    string bop = "";
                    string bety = bbt;
                    if (cg_is_ptr_ty(bbt) == 1) {
                        bop = cg_expr(g, e.a.a).op;
                    }
                    else {
                        bop = cg_addr(g, e.a.a).op;
                        bety = cg_cat("*", bbt);
                    }
                    cg_emit(g, "  store ptr ");
                    cg_emit(g, bop);
                    cg_emit(g, ", ptr ");
                    cg_emit(g, cslot);
                    cg_emit(g, "\n");
                    cg_add_local(g, ctmp, cslot, "ptr", bety);
                    ctarget = cgb_member(cder, e.a.sval);
                } else {
                    CgVal clv = cg_lval(g, e.a);
                    string clety = clv.ety;
                    if (clety[0] == 0) {
                        clety = cg_etype(g, e.a);
                    }
                    cg_emit(g, "  store ptr ");
                    cg_emit(g, clv.op);
                    cg_emit(g, ", ptr ");
                    cg_emit(g, cslot);
                    cg_emit(g, "\n");
                    cg_add_local(g, ctmp, cslot, "ptr", cg_cat("*", clety));
                }
                CgVal crv = cg_expr(g, cgb_bin("=", ctarget, cgb_bin(e.b.sval, ctarget, e.b.b)));
                cg_locals_trunc(g, clmark);
                return crv;
            }
            // Assignment to a bitfield member → read-modify-write the storage word.
            if (e.a != null && e.a.kind == EK_MEMBER) {
                string bet = cg_etype(g, e.a.a);
                string sn = bet;
                if (cg_is_ptr_ty(bet) == 1) {
                    sn = cg_strip_ptr(bet);
                }
                CgBF slot = cg_bf(g, sn, e.a.sval);
                if (slot.bw > 0) {
                    string sn2 = "";
                    string baseptr = cg_member_baseptr(g, e.a.a, &sn2);   // target first
                    CgVal rv = cg_expr(g, e.b);
                    string rop = cg_coerce(g, rv, slot.sty);
                    g.bf_vol = cg_vol(g, e.a);
                    cg_bf_write(g, baseptr, sn2, slot, rop);
                    g.bf_vol = "";
                    return rv;
                }
            }
            // Evaluation order (mirrors CodeGen::emitAssignment): the target's address
            // first, then the right-hand side, then the store.
            if (e.a != null && e.a.kind == EK_IDENT && cg_find_local(g, e.a.sval).slot[0] != 0) {
                cg_hint_iface(g, e.b, cg_find_local(g, e.a.sval).ety);
                CgVal rhs = cg_expr(g, e.b);
                CgLocal l = cg_find_local(g, e.a.sval);
                string rop = cg_coerce(g, rhs, l.ty);   // coerce RHS to the variable's type
                if (cg_is_iface(g, l.ety) == 1) {
                    rop = cg_iface_conv(g, l.ety, rhs, e.b);
                }
                cg_emit(g, "  store ");
                cg_emit(g, cg_vol(g, e.a));
                cg_emit(g, l.ty);
                cg_emit(g, " ");
                cg_emit(g, rop);
                cg_emit(g, ", ptr ");
                cg_emit(g, l.slot);
                cg_emit(g, "\n");
                // The assignment's value is the stored (converted) one: `l = s = 200` with
                // an int8 `s` gives `l` -56, not 200.
                v.op = rop;
                v.ty = l.ty;
                v.ety = l.ety;
                return v;
            }
            CgVal lv = cg_lval(g, e.a);                 // member / deref / index lvalue
            cg_hint_iface(g, e.b, lv.ety);
            CgVal rhs = cg_expr(g, e.b);
            string lty = cg_lltype(g, lv.ety);
            string rop = cg_coerce(g, rhs, lty);        // coerce RHS to the field/element type
            if (cg_is_iface(g, cg_dealias(g, lv.ety)) == 1) {
                rop = cg_iface_conv(g, lv.ety, rhs, e.b);
            }
            cg_emit(g, "  store ");
            cg_emit(g, cg_vol(g, e.a));
            cg_emit(g, lty);
            cg_emit(g, " ");
            cg_emit(g, rop);
            cg_emit(g, ", ptr ");
            cg_emit(g, lv.op);
            cg_emit(g, "\n");
            v.op = rop;
            v.ty = lty;
            v.ety = lv.ety;
            return v;
        }
        // Open the type stamps for the outermost binary expression (an expression declares
        // no local and function bodies are emitted from queues, so they hold until it is done).
        int bopen = 0;
        if (g.bactive == 0) {
            g.mstamp = g.mstamp + 1;
            g.bactive = g.mstamp;
            bopen = 1;
        }
        CgVal bv = cg_binary_chain(g, e);
        if (bopen == 1) {
            g.bactive = 0;
        }
        return bv;
    }

    if (e.kind == EK_CALL) {
        // Atomic intrinsics → LLVM atomic instructions (cell is *int, values i32).
        if (e.a != null && e.a.kind == EK_IDENT && cg_is_atomic(g, e.a.sval) == 1) {
            return cg_emit_atomic(g, e.a.sval, e);
        }
        if (e.dbg_builtin == 1) {
            return cg_emit_dbg(g, e);
        }
        // Variadic access: va_start(ap)/va_end(ap) → the llvm.va_{start,end} intrinsic on the
        // va_list's address (its alloca). `ap` is a local va_list.
        if (e.a != null && e.a.kind == EK_IDENT
            && (cg_streq(e.a.sval, "va_start") == 1 || cg_streq(e.a.sval, "va_end") == 1)) {
            string ap = cg_lval(g, List_get<*ExprNode>(&e.kids, 0)).op;
            string intr = "llvm.va_start.p0";
            if (cg_streq(e.a.sval, "va_end") == 1) {
                intr = "llvm.va_end.p0";
            }
            cg_ensure_extern(g, intr, cg_cat(cg_cat("declare void @", intr), "(ptr)\n"));
            cg_emit(g, "  call void @");
            cg_emit(g, intr);
            cg_emit(g, "(ptr ");
            cg_emit(g, ap);
            cg_emit(g, ")\n");
            v.op = "";
            v.ty = "void";
            return v;
        }
        // `__exception_text_into(buf)`, from the async lowering only: the text copied (512
        // bytes with its NUL) into a frame field that outlives the handler's stack.
        if (e.a != null && e.a.kind == EK_IDENT && cg_streq(e.a.sval, "__exception_text_into") == 1
            && List_len<*ExprNode>(&e.kids) == 1 && List_len<string>(&g.catch_text) > 0) {
            string dst = cg_expr(g, List_get<*ExprNode>(&e.kids, 0)).op;
            string tslot = List_get<string>(&g.catch_text, List_len<string>(&g.catch_text) - 1);
            string src = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, src);
            cg_emit(g, " = load ptr, ptr ");
            cg_emit(g, tslot);
            cg_emit(g, "\n");
            // llvm.memcpy is declared with the exception runtime, which a catch implies.
            cg_emit(g, "  call void @llvm.memcpy.p0.p0.i64(ptr ");
            cg_emit(g, dst);
            cg_emit(g, ", ptr ");
            cg_emit(g, src);
            cg_emit(g, ", i64 512, i1 false)\n");
            v.op = "";
            v.ty = "void";
            return v;
        }
        // The builtin, unless the program defines a function or variable of that name.
        if (e.a != null && e.a.kind == EK_IDENT && cg_streq(e.a.sval, "exception_text") == 1
            && List_len<*ExprNode>(&e.kids) == 0 && List_len<string>(&g.catch_text) > 0
            && cg_find_local(g, "exception_text").slot[0] == 0 && cg_is_fn(g, "exception_text") == 0) {
            string tslot = List_get<string>(&g.catch_text, List_len<string>(&g.catch_text) - 1);
            string tx = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, tx);
            cg_emit(g, " = load ptr, ptr ");
            cg_emit(g, tslot);
            cg_emit(g, "\n");
            v.op = tx;
            v.ty = "ptr";
            v.ety = "string";
            return v;
        }
        // An ADT variant constructor `Circle(4)` parses as a call with a bare-ident callee;
        // a local or global of that name shadows the variant.
        if (e.a != null && e.a.kind == EK_IDENT && cg_find_local(g, e.a.sval).slot[0] == 0
            && cg_find_global(g, e.a.sval).slot[0] == 0) {
            // A bare generic variant (`Some(v)`, in a generic body too): each type parameter
            // is the type of the argument whose payload slot is that parameter (C++
            // visit(CallExpr)), so every instance builds its own enum instance.
            CgVariant gvar = cg_find_gvariant(g, e.a.sval);
            *DeclNode gen = null;
            if (gvar.ename[0] != 0) {
                gen = cg_find_genum(g, gvar.ename);
            }
            if (gen != null) {
                String sp;
                String_init(&sp, 16);
                String_append(&sp, gvar.ename);
                String_append(&sp, "<");
                int ti = 0;
                int found = 0;
                while (ti < List_len<TypeParam>(&gen.type_params)) {
                    string tp = List_get<TypeParam>(&gen.type_params, ti).name;
                    string at = "int";
                    int pi = 0;
                    while (pi < List_len<string>(&gvar.ptys) && pi < List_len<*ExprNode>(&e.kids)) {
                        if (cg_streq(List_get<string>(&gvar.ptys, pi), tp) == 1) {
                            at = cg_apply_sub(g, cg_etype(g, List_get<*ExprNode>(&e.kids, pi)));
                            found = 1;
                            break;
                        }
                        pi = pi + 1;
                    }
                    if (ti > 0) {
                        String_append(&sp, ", ");
                    }
                    String_append(&sp, at);
                    ti = ti + 1;
                }
                String_append(&sp, ">");
                if (found == 1) {
                    string menum = cg_ensure_enum_inst(g, (string)String_cstr(&sp));
                    CgVariant cv = cg_find_variant_in(g, e.a.sval, menum);
                    if (cv.ename[0] != 0) {
                        return cg_build_variant(g, cv, e);
                    }
                }
            }
            CgVariant var = cg_find_variant(g, e.a.sval);
            if (var.ename[0] != 0) {
                return cg_build_variant(g, var, e);
            }
        }
        // Indirect call through a closure value: the callee is a local/param of fn type
        // (a `%closure` fat pointer). Extract { fn, env } and call fn(env, args...).
        if (e.a != null && e.a.kind == EK_IDENT) {
            CgLocal lf = cg_find_local(g, e.a.sval);
            if (lf.slot[0] != 0 && cg_is_fnty(lf.ety) == 1) {
                string cval = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, cval);
                cg_emit(g, " = load %closure, ptr ");
                cg_emit(g, lf.slot);
                cg_emit(g, "\n");
                return cg_indirect_call(g, cval, lf.ety, e);
            }
        }
        // Same, but the callee is a GLOBAL variable of fn type (`let f: fn(int)->int = ...`
        // at module scope, then `f(x)`): load the %closure from the global's address.
        if (e.a != null && e.a.kind == EK_IDENT) {
            CgLocal gf = cg_find_global(g, e.a.sval);
            if (gf.slot[0] != 0 && cg_is_fnty(gf.ety) == 1) {
                string cval = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, cval);
                cg_emit(g, " = load %closure, ptr ");
                cg_emit(g, gf.slot);
                cg_emit(g, "\n");
                return cg_indirect_call(g, cval, gf.ety, e);
            }
        }
        // A call through a closure-typed FIELD (e.g. `fr.ret.waker()`): not a method.
        if (e.a != null && e.a.kind == EK_MEMBER && cg_is_fnty(cg_etype(g, e.a)) == 1) {
            CgVal cv = cg_expr(g, e.a);                 // load the %closure field value
            return cg_indirect_call(g, cv.op, cg_etype(g, e.a), e);
        }
        // Any other callee expression yielding a closure (a call returning a fn value,
        // `pick(0)(3, 4)`, or an indexed/derefed closure): evaluate it, then call through it.
        if (e.a != null && e.a.kind != EK_IDENT && e.a.kind != EK_MEMBER) {
            string cft = cg_etype(g, e.a);
            if (cg_is_fnty(cft) == 1) {
                CgVal cv = cg_expr(g, e.a);
                return cg_indirect_call(g, cg_coerce(g, cv, "%closure"), cft, e);
            }
        }
        // A generic free function called WITHOUT explicit type args (`chan_recv(ch)`):
        // infer `chan_recv<int>` from the argument types, then instantiate + call.
        if (e.a != null && e.a.kind == EK_IDENT) {
            *DeclNode gd = cg_find_gfn(g, e.a.sval);
            if (gd != null) {
                string spelling = cg_infer_generic(g, gd, e);
                if (spelling[0] != 0) {
                    return cg_call_mangled(g, cg_ensure_fn_inst(g, spelling), e);
                }
                dprintf(2, "error: cannot infer the type arguments of generic function '%s' from the call; write them explicitly, e.g. %s<...>(...)\n", gd.name, gd.name);
                exit(1);
            }
        }
        // A method call whose receiver is an interface value → dynamic vtable dispatch.
        // The receiver's *value* is the fat pointer {data, vtable}.
        if (e.a != null && e.a.kind == EK_MEMBER && cg_is_iface(g, cg_etype(g, e.a.a)) == 1) {
            string ifn = cg_etype(g, e.a.a);
            string fatop = cg_expr(g, e.a.a).op;
            return cg_dispatch_iface(g, ifn, fatop, e.a.sval, e);
        }
        // Through a pointer to an interface value (`*I pi; pi.f()`): load the fat value.
        if (e.a != null && e.a.kind == EK_MEMBER) {
            string rty = cg_etype(g, e.a.a);
            if (cg_is_ptr_ty(rty) == 1 && cg_is_iface(g, cg_dealias(g, cg_deref_ty(rty))) == 1) {
                string ifn2 = cg_dealias(g, cg_deref_ty(rty));
                string pop = cg_expr(g, e.a.a).op;
                string fv = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, fv);
                cg_emit(g, " = load %iface_fat, ptr ");
                cg_emit(g, pop);
                cg_emit(g, "\n");
                return cg_dispatch_iface(g, ifn2, fv, e.a.sval, e);
            }
        }
        // `l.push(x)` on a generic struct instance whose `List_push<T>` is a generic free
        // function: emit it as that (type-inferred) call.
        *ExprNode gmc = cg_generic_method_call(g, e);
        if (gmc != null) {
            return cg_expr(g, gmc);
        }
        // Resolve the callee. A bare ident is a free function; a MemberExpr is a method
        // call `recv.m(...)` → `Struct_m(self, ...)` with `self` a pointer to the receiver.
        string fname = "";
        string args = "";
        int pbase = 0;                                  // 1 when an implicit self precedes args
        if (e.a != null && e.a.kind == EK_MEMBER) {
            string recv_ety = cg_etype(g, e.a.a);
            string sname = recv_ety;
            if (cg_is_ptr_ty(recv_ety) == 1) {
                sname = cg_strip_ptr(recv_ety);
            }
            // A primitive receiver satisfying a constraint via a free function: `a.cmp(b)`
            // where `a: int` lowers to `cmp(a, b)` (receiver passed BY VALUE as arg 0). The
            // struct-method path would index a non-existent struct's fields and crash.
            if (cg_is_struct(g, sname) == 0 && cg_is_adt(g, sname) == 0 && cg_is_fn(g, e.a.sval) == 1) {
                fname = e.a.sval;
                CgVal selfv = cg_expr(g, e.a.a);
                args = cg_cat(cg_cat(selfv.ty, " "), selfv.op);   // receiver by value
                pbase = 1;
            } else {
                string sptr = "";
                if (cg_is_ptr_ty(recv_ety) == 1) {
                    sptr = cg_expr(g, e.a.a).op;
                }
                else {
                    sptr = cg_addr(g, e.a.a).op;
                }
                fname = cg_method_fn(g, sname, e.a.sval);
                args = cg_cat("ptr ", sptr);                // self is the first argument
                pbase = 1;
            }
        } else if (e.a != null && e.a.kind == EK_IDENT) {
            fname = e.a.sval;
        }
        CgFn f = cg_find_fn(g, fname);
        if (pbase == 0 && List_len<CgCabi>(&g.cabis) > 0) {
            CgCabi cab = cg_find_cabi(g, fname);
            if (cab.name[0] != 0) {                     // a C-ABI-lowered extern
                List<CgVal> cargs;
                List_init<CgVal>(&cargs, 4);
                int ci = 0;
                while (ci < List_len<*ExprNode>(&e.kids)) {
                    CgVal a = cg_call_arg(g, &f, ci, List_get<*ExprNode>(&e.kids, ci));
                    string cpty = cg_pty(&f, ci);
                    let ca: CgVal;
                    ca.op = a.op;
                    ca.ty = a.ty;
                    ca.ety = a.ety;
                    if (cpty[0] != 0) {
                        ca.op = cg_coerce(g, a, cpty);
                        ca.ty = cpty;
                    }
                    else if (cg_streq(a.ty, "float") == 1) {
                        ca.op = cg_coerce(g, a, "double");
                        ca.ty = "double";
                    }
                    else if (cg_int_w(a.ty) > 0 && cg_int_w(a.ty) < 32) {
                        ca.op = cg_coerce(g, a, "i32");
                        ca.ty = "i32";
                    }
                    List_push<CgVal>(&cargs, ca);
                    ci = ci + 1;
                }
                return cg_widen_cret(g, &f, cg_cabi_call(g, &cab, &f, &cargs));
            }
        }
        // Evaluate the declared args (left to right), coercing each to the callee's
        // declared parameter type (so e.g. an i32 count widens to an `int64` parameter).
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            *ExprNode ax = List_get<*ExprNode>(&e.kids, i);
            CgVal a = cg_call_arg(g, &f, i + pbase, ax);
            string pety = cg_pety(&f, i + pbase);
            // Param expects an interface but we have a struct pointer → box it as a fat pointer.
            if (pety[0] != 0 && cg_is_iface(g, cg_dealias(g, pety)) == 1) {
                string boxed = cg_iface_conv(g, pety, a, ax);
                if (args[0] != 0) {
                    args = cg_cat(args, ", ");
                }
                args = cg_cat(args, cg_cat("%iface_fat ", boxed));
                i = i + 1;
            } else {
                string pty = cg_pty(&f, i + pbase);
                string aop = a.op;
                string aty = a.ty;
                if (pty[0] != 0) {
                    aop = cg_coerce(g, a, pty);
                    aty = pty;
                }
                else if (cg_streq(a.ty, "float") == 1) {     // C vararg promotion: float → double
                    aop = cg_coerce(g, a, "double");
                    aty = "double";
                }
                else if (cg_int_w(a.ty) > 0 && cg_int_w(a.ty) < 32) {   // C default arg promotion: small int → i32 (signedness-aware)
                    aop = cg_coerce(g, a, "i32");
                    aty = "i32";
                }
                if (args[0] != 0) {
                    args = cg_cat(args, ", ");
                }
                args = cg_cat(args, cg_cat(aty, cg_cat(" ", aop)));
                i = i + 1;
            }
        }
        // A variadic callee needs the explicit function type: `call i32 (ptr, ...) @printf`.
        string callty = f.retty;
        if (f.variadic == 1) {
            callty = cg_cat(f.retty, cg_cat(" (", cg_cat(cg_va(f.fixedtypes), ")")));
        }
        int isvoid = cg_streq(f.retty, "void");
        string t = cg_emit_callish(g, callty, cg_cat("@", fname), args, isvoid);
        if (isvoid == 1) {
            v.op = "";
            v.ty = "void";
            return v;
        }
        v.op = t;
        v.ty = f.retty;
        v.ety = f.rety;
        return cg_widen_cret(g, &f, v);
    }

    if (e.kind == EK_TEMPLATECALL) {
        // Variadic access: va_arg<T>(ap) → the LLVM `va_arg` instruction reading the next
        // argument of type T from the va_list's address.
        if (cg_streq(cg_gen_base(e.sval), "va_arg") == 1) {
            List<string> ta;
            List_init<string>(&ta, 1);
            cg_gen_args(e.sval, &ta);
            string ety = cg_apply_sub(g, List_get<string>(&ta, 0));
            string llty = cg_lltype(g, ety);
            string ap = cg_lval(g, List_get<*ExprNode>(&e.kids, 0)).op;
            v.op = cg_va_arg(g, ap, llty);
            v.ty = llty;
            v.ety = ety;
            return v;
        }
        // A generic ADT variant constructor: `Some<int>(42)` / `None<int>()`. Resolve the
        // concrete enum from the variant's generic enum + the explicit type args, ensure the
        // instance, then build the value through its concrete (substituted) variant.
        string vb = cg_gen_base(e.sval);
        CgVariant gvar = cg_find_gvariant(g, vb);
        if (gvar.ename[0] != 0) {
            List<string> targs;
            List_init<string>(&targs, 4);
            cg_gen_args(e.sval, &targs);
            String sp;
            String_init(&sp, 16);
            String_append(&sp, gvar.ename);
            String_append(&sp, "<");
            int ti = 0;
            while (ti < List_len<string>(&targs)) {
                if (ti > 0) {
                    String_append(&sp, ", ");
                }
                String_append(&sp, List_get<string>(&targs, ti));
                ti = ti + 1;
            }
            String_append(&sp, ">");
            string menum = cg_ensure_enum_inst(g, (string)String_cstr(&sp));
            CgVariant cv = cg_find_variant_in(g, vb, menum);
            return cg_build_variant(g, cv, e);
        }
        string mangled = cg_ensure_fn_inst(g, e.sval);     // "id<int>" -> "id_int" (queued)
        return cg_call_mangled(g, mangled, e);
    }

    if (e.kind == EK_SIZEOF) {
        // sizeof(T) without hardcoded sizes: ptrtoint of `gep T, null, 1`.
        string llty = cg_lltype(g, cg_sizeof_operand(g, e));   // applies the active sub
        string g1 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, g1);
        cg_emit(g, " = getelementptr ");
        cg_emit(g, llty);
        cg_emit(g, ", ptr null, i32 1\n");
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = ptrtoint ptr ");
        cg_emit(g, g1);
        cg_emit(g, " to i64\n");
        v.op = t;
        v.ty = "i64";
        v.ety = "int64";
        return v;
    }

    if (e.kind == EK_CAST) {
        string dstety = cg_apply_sub(g, e.sval);
        if (cg_streq(dstety, "void") == 1) {   // `(void)e`: evaluate for side effects, discard
            cg_expr(g, e.a);
            v.op = "";
            v.ty = "void";
            return v;
        }
        string dll = cg_lltype(g, dstety);
        // A top-level function cast to a pointer is the raw address C calls: through its
        // C-ABI thunk when it takes or returns a struct by value.
        if (cg_streq(dll, "ptr") == 1 && e.a != null && e.a.kind == EK_IDENT
            && cg_find_local(g, e.a.sval).slot[0] == 0 && cg_find_global(g, e.a.sval).slot[0] == 0
            && cg_is_fn(g, e.a.sval) == 1) {
            v.op = cg_cabi_callback(g, e.a.sval);
            v.ty = "ptr";
            v.ety = dstety;
            return v;
        }
        CgVal src = cg_expr(g, e.a);
        // float → unsigned int saturates to the unsigned range (cg_coerce saturates to the
        // signed one: (uint32)3e9 would be 2147483647 instead of 3e9).
        if (cg_is_float(src.ty) == 1 && cg_int_w(dll) > 1 && cg_is_unsigned(dstety) == 1) {
            string t = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = ");
            cg_emit_fp_sat(g, 1, src.ty, src.op, dll);
            cg_emit(g, "\n");
            v.op = t;
            v.ty = dll;
            v.ety = dstety;
            return v;
        }
        v.op = cg_coerce(g, src, dll);    // int/float/ptr conversions (sitofp/fptosi/…)
        v.ty = dll;
        v.ety = dstety;
        return v;
    }

    if (e.kind == EK_TERNARY) {
        int topen = cg_tern_begin(g, e);
        // `cond ? then : else` — branch and evaluate exactly one arm into a result slot,
        // each arm coerced to the common type (mirrors the short-circuit && lowering).
        // A chain of ternaries in else position is emitted with a loop: each link's else
        // arm is the next link, whose value is stored into the link's slot on the way out.
        List<*ExprNode> chain;
        List_init<*ExprNode>(&chain, 4);
        List<string> etys;
        List_init<string>(&etys, 4);
        cg_ternary_etys(g, e, &chain, &etys);
        int k = List_len<*ExprNode>(&chain);
        string forced = "";                             // bound for an interface: box every arm
        if (g.tern_node == e) {
            forced = g.tern_iface;
            g.tern_node = null;
            int fi = 0;
            while (fi < k) {
                List_set<string>(&etys, fi, forced);
                fi = fi + 1;
            }
        }
        List<string> rtys;
        List_init<string>(&rtys, k);
        List<string> ress;
        List_init<string>(&ress, k);
        List<string> lends;
        List_init<string>(&lends, k);
        int i = 0;
        while (i < k) {
            *ExprNode n = List_get<*ExprNode>(&chain, i);
            string rty = cg_lltype(g, List_get<string>(&etys, i));
            string res = "";                               // void arms (a statement): no slot
            if (cg_streq(rty, "void") == 0) {
                res = cg_entry_alloca(g, rty);
            }
            CgVal c = cg_cond(g, n.a);
            string lthen = cg_lbl(g);
            string lelse = cg_lbl(g);
            string lend = cg_lbl(g);
            cg_emit(g, "  br i1 ");
            cg_emit(g, c.op);
            cg_emit(g, ", label %");
            cg_emit(g, lthen);
            cg_emit(g, ", label %");
            cg_emit(g, lelse);
            cg_emit(g, "\n");
            g.terminated = 1;
            cg_label(g, lthen);
            if (forced[0] != 0) {
                cg_hint_iface(g, n.b, forced);
            }
            CgVal tv = cg_expr(g, n.b);
            if (res[0] != 0) {
                string top = cg_coerce(g, tv, rty);
                if (cg_is_iface(g, cg_dealias(g, List_get<string>(&etys, i))) == 1) {
                    top = cg_iface_conv(g, List_get<string>(&etys, i), tv, n.b);
                }
                cg_emit(g, "  store ");
                cg_emit(g, rty);
                cg_emit(g, " ");
                cg_emit(g, top);
                cg_emit(g, ", ptr ");
                cg_emit(g, res);
                cg_emit(g, "\n");
            }
            cg_br(g, lend);
            cg_label(g, lelse);
            List_push<string>(&rtys, rty);
            List_push<string>(&ress, res);
            List_push<string>(&lends, lend);
            i = i + 1;
        }
        *ExprNode last = List_get<*ExprNode>(&chain, k - 1);
        CgVal ev = cg_expr(g, List_get<*ExprNode>(&last.kids, 0));
        i = k - 1;
        while (i >= 0) {
            string rty = List_get<string>(&rtys, i);
            string res = List_get<string>(&ress, i);
            string lend = List_get<string>(&lends, i);
            if (res[0] == 0) {                             // void: nothing to merge
                cg_br(g, lend);
                cg_label(g, lend);
                ev.op = "";
                ev.ty = "void";
                ev.ety = "void";
                i = i - 1;
                continue;
            }
            string eop = cg_coerce(g, ev, rty);
            if (cg_is_iface(g, cg_dealias(g, List_get<string>(&etys, i))) == 1) {
                *ExprNode ex = List_get<*ExprNode>(&last.kids, 0);
                if (i < k - 1) {
                    ex = List_get<*ExprNode>(&chain, i + 1);
                }
                eop = cg_iface_conv(g, List_get<string>(&etys, i), ev, ex);
            }
            cg_emit(g, "  store ");
            cg_emit(g, rty);
            cg_emit(g, " ");
            cg_emit(g, eop);
            cg_emit(g, ", ptr ");
            cg_emit(g, res);
            cg_emit(g, "\n");
            cg_br(g, lend);
            cg_label(g, lend);
            string t = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, t);
            cg_emit(g, " = load ");
            cg_emit(g, rty);
            cg_emit(g, ", ptr ");
            cg_emit(g, res);
            cg_emit(g, "\n");
            ev.op = t;
            ev.ty = rty;
            ev.ety = List_get<string>(&etys, i);
            i = i - 1;
        }
        List_free<*ExprNode>(&chain);
        List_free<string>(&etys);
        List_free<string>(&rtys);
        List_free<string>(&ress);
        List_free<string>(&lends);
        if (topen == 1) {
            g.tactive = 0;
        }
        v.op = ev.op;
        v.ty = ev.ty;
        v.ety = ev.ety;
        return v;
    }

    if (e.kind == EK_QUESTION) {
        // `expr?` — if expr is an Err Result (`.ok == 0`), return it whole from the enclosing
        // function; otherwise the expression yields the unwrapped `.value` field.
        CgVal r = cg_expr(g, e.a);
        string llty = r.ty;
        string sname = llty;
        if ((int)llty[0] == 37) {
            int ll = 0;
            while (llty[ll] != 0) {
                ll = ll + 1;
            }
            sname = cg_sub_str(llty, 1, ll);
        }
        CgStruct s = cg_find_struct(g, sname);
        int okIdx = cg_field_idx(&s, "ok");
        int valIdx = cg_field_idx(&s, "value");
        string okllty = cg_lltype(g, List_get<string>(&s.fetys, okIdx));
        string valety = List_get<string>(&s.fetys, valIdx);
        string valllty = cg_lltype(g, valety);
        string tmp = cg_entry_alloca(g, llty);
        cg_emit(g, "  store ");
        cg_emit(g, llty);
        cg_emit(g, " ");
        cg_emit(g, r.op);
        cg_emit(g, ", ptr ");
        cg_emit(g, tmp);
        cg_emit(g, "\n");
        string okp = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, okp);
        cg_emit(g, " = getelementptr ");
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, tmp);
        cg_emit(g, ", i32 0, i32 ");
        cg_emit(g, cg_itoa(okIdx));
        cg_emit(g, "\n");
        string okv = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, okv);
        cg_emit(g, " = load ");
        cg_emit(g, okllty);
        cg_emit(g, ", ptr ");
        cg_emit(g, okp);
        cg_emit(g, "\n");
        string iserr = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, iserr);
        cg_emit(g, " = icmp eq ");
        cg_emit(g, okllty);
        cg_emit(g, " ");
        cg_emit(g, okv);
        cg_emit(g, ", 0\n");
        string errl = cg_lbl(g);
        string contl = cg_lbl(g);
        cg_emit(g, "  br i1 ");
        cg_emit(g, iserr);
        cg_emit(g, ", label %");
        cg_emit(g, errl);
        cg_emit(g, ", label %");
        cg_emit(g, contl);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, errl);                               // propagate the Err out of the function
        string whole = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, whole);
        cg_emit(g, " = load ");
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, tmp);
        cg_emit(g, "\n");
        // A Result of another success type with the same error type: a fresh one (zeroed)
        // gets the `ok` flag and the error (mirrors the C++).
        if (cg_streq(g.cur_ret, llty) == 0 && (int)g.cur_ret[0] == 37) {
            int rl = 0;
            while (g.cur_ret[rl] != 0) {
                rl = rl + 1;
            }
            CgStruct rs = cg_find_struct(g, cg_sub_str(g.cur_ret, 1, rl));
            if (rs.name[0] != 0) {
                string out = cg_entry_alloca(g, g.cur_ret);
                cg_emit(g, "  store ");
                cg_emit(g, g.cur_ret);
                cg_emit(g, " zeroinitializer, ptr ");
                cg_emit(g, out);
                cg_emit(g, "\n");
                int fi = 0;
                while (fi < List_len<string>(&s.fnames)) {
                    string fnm = List_get<string>(&s.fnames, fi);
                    int ri = cg_field_idx(&rs, fnm);
                    if ((cg_streq(fnm, "ok") == 1 || cg_streq(fnm, "error") == 1) && ri >= 0) {
                        string fty = cg_lltype(g, List_get<string>(&s.fetys, fi));
                        string src = cg_tmp(g);
                        cg_emit(g, "  ");
                        cg_emit(g, src);
                        cg_emit(g, " = getelementptr ");
                        cg_emit(g, llty);
                        cg_emit(g, ", ptr ");
                        cg_emit(g, tmp);
                        cg_emit(g, ", i32 0, i32 ");
                        cg_emit(g, cg_itoa(fi));
                        cg_emit(g, "\n");
                        string fv = cg_tmp(g);
                        cg_emit(g, "  ");
                        cg_emit(g, fv);
                        cg_emit(g, " = load ");
                        cg_emit(g, fty);
                        cg_emit(g, ", ptr ");
                        cg_emit(g, src);
                        cg_emit(g, "\n");
                        string dst = cg_tmp(g);
                        cg_emit(g, "  ");
                        cg_emit(g, dst);
                        cg_emit(g, " = getelementptr ");
                        cg_emit(g, g.cur_ret);
                        cg_emit(g, ", ptr ");
                        cg_emit(g, out);
                        cg_emit(g, ", i32 0, i32 ");
                        cg_emit(g, cg_itoa(ri));
                        cg_emit(g, "\n");
                        cg_emit(g, "  store ");
                        cg_emit(g, fty);
                        cg_emit(g, " ");
                        cg_emit(g, fv);
                        cg_emit(g, ", ptr ");
                        cg_emit(g, dst);
                        cg_emit(g, "\n");
                    }
                    fi = fi + 1;
                }
                whole = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, whole);
                cg_emit(g, " = load ");
                cg_emit(g, g.cur_ret);
                cg_emit(g, ", ptr ");
                cg_emit(g, out);
                cg_emit(g, "\n");
            }
        }
        cg_run_cleanups(g, 0, 1);                        // ? error exit: defers + errdefers
        cg_emit(g, "  ret ");
        cg_emit(g, g.cur_ret);
        cg_emit(g, " ");
        cg_emit(g, whole);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, contl);                              // success: unwrap .value
        string valp = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, valp);
        cg_emit(g, " = getelementptr ");
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, tmp);
        cg_emit(g, ", i32 0, i32 ");
        cg_emit(g, cg_itoa(valIdx));
        cg_emit(g, "\n");
        string val = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, val);
        cg_emit(g, " = load ");
        cg_emit(g, valllty);
        cg_emit(g, ", ptr ");
        cg_emit(g, valp);
        cg_emit(g, "\n");
        v.op = val;
        v.ty = valllty;
        v.ety = valety;
        return v;
    }

    if (e.kind == EK_ALLOCWITH) {
        // alloc_with(&a, T, n) → (*T) <AllocType>_alloc(&a, n * sizeof(T)). The allocator's
        // static struct type names the alloc method; the result is a `*T`.
        string elemty = cg_apply_sub(g, e.sval);
        CgVal av = cg_expr(g, e.a);                       // allocator pointer
        string at = cg_strip_ptr(cg_etype(g, e.a));       // allocator struct name
        string fname = cg_cat(at, "_alloc");
        if (cg_has_targs(cg_apply_sub(g, at)) == 1) {     // a generic instance: its inline method or `G_int_alloc`
            string ml = cg_ensure_method_inst(g, at, "alloc");
            if (ml[0] != 0) {
                fname = ml;
            }
            else {
                fname = cg_cat(cg_ensure_struct_inst(g, cg_apply_sub(g, at)), "_alloc");
            }
        }
        CgFn f = cg_find_fn(g, fname);
        CgVal cnt = cg_expr(g, e.b);
        string n64 = cg_coerce(g, cnt, "i64");
        // n * sizeof(T) as a signed 64-bit size: a count that overflows it, or is negative,
        // (or a size too wide for a narrower size parameter) yields null instead of a
        // wrapped, too-small allocation. Mirrors the C++ visit(AllocWithExpr).
        cg_ensure_extern(g, "llvm.smul.with.overflow.i64", "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\n");
        string prod = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, prod);
        cg_emit(g, " = call { i64, i1 } @llvm.smul.with.overflow.i64(i64 ");
        cg_emit(g, n64);
        cg_emit(g, ", i64 ");
        cg_emit(g, cg_itoa(cg_size(g, elemty)));
        cg_emit(g, ")\n");
        string total = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, total);
        cg_emit(g, " = extractvalue { i64, i1 } ");
        cg_emit(g, prod);
        cg_emit(g, ", 0\n");
        string ovf = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, ovf);
        cg_emit(g, " = extractvalue { i64, i1 } ");
        cg_emit(g, prod);
        cg_emit(g, ", 1\n");
        string neg = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, neg);
        cg_emit(g, " = icmp slt i64 ");
        cg_emit(g, total);
        cg_emit(g, ", 0\n");
        string bad = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, bad);
        cg_emit(g, " = or i1 ");
        cg_emit(g, ovf);
        cg_emit(g, ", ");
        cg_emit(g, neg);
        cg_emit(g, "\n");
        string p1 = cg_pty(&f, 1);
        string targ = total;
        string targty = "i64";
        if (p1[0] != 0 && cg_streq(p1, "i64") == 0) {
            int pw = cg_int_w(p1);
            if (pw > 1 && pw < 64) {
                string wide = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, wide);
                cg_emit(g, " = icmp sgt i64 ");
                cg_emit(g, total);
                cg_emit(g, ", ");
                cg_emit(g, cg_i64toa(((int64)1 << (int64)(pw - 1)) - (int64)1));
                cg_emit(g, "\n");
                string bad2 = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, bad2);
                cg_emit(g, " = or i1 ");
                cg_emit(g, bad);
                cg_emit(g, ", ");
                cg_emit(g, wide);
                cg_emit(g, "\n");
                bad = bad2;
            }
        }
        if (p1[0] != 0) {
            let tv: CgVal;
            tv.op = total;
            tv.ty = "i64";
            tv.ety = "int64";
            targ = cg_coerce(g, tv, p1);
            targty = p1;
        }
        string lcall = cg_lbl(g);
        string lfail = cg_lbl(g);
        string ldone = cg_lbl(g);
        cg_emit(g, "  br i1 ");
        cg_emit(g, bad);
        cg_emit(g, ", label %");
        cg_emit(g, lfail);
        cg_emit(g, ", label %");
        cg_emit(g, lcall);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, lcall);
        string r = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, r);
        cg_emit(g, " = call ");
        cg_emit(g, f.retty);
        cg_emit(g, " @");
        cg_emit(g, fname);
        cg_emit(g, "(ptr ");
        cg_emit(g, av.op);
        cg_emit(g, ", ");
        cg_emit(g, targty);
        cg_emit(g, " ");
        cg_emit(g, targ);
        cg_emit(g, ")\n");
        // A non-null block is zeroed, as alloc<T> returns zeroed memory whatever the
        // allocator (a reset Bump or a reused Pool block holds old bytes).
        string lzero = cg_lbl(g);
        string isnull = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, isnull);
        cg_emit(g, " = icmp eq ptr ");
        cg_emit(g, r);
        cg_emit(g, ", null\n");
        cg_emit(g, "  br i1 ");
        cg_emit(g, isnull);
        cg_emit(g, ", label %");
        cg_emit(g, ldone);
        cg_emit(g, ", label %");
        cg_emit(g, lzero);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, lzero);
        cg_zero_bytes(g, r, total);
        string lzend = g.cur_lbl;
        cg_br(g, ldone);
        cg_label(g, lfail);
        cg_br(g, ldone);
        cg_label(g, ldone);
        string res = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, res);
        cg_emit(g, " = phi ptr [ ");
        cg_emit(g, r);
        cg_emit(g, ", %");
        cg_emit(g, lcall);
        cg_emit(g, " ], [ ");
        cg_emit(g, r);
        cg_emit(g, ", %");
        cg_emit(g, lzend);
        cg_emit(g, " ], [ null, %");
        cg_emit(g, lfail);
        cg_emit(g, " ]\n");
        v.op = res;
        v.ty = "ptr";
        v.ety = cg_cat("*", elemty);
        return v;
    }

    if (e.kind == EK_THREADCREATE) {
        // thread_create(worker) → pthread_create(&tid, null, fn, env); returns the tid.
        CgVal fat = cg_expr(g, e.a);                      // %closure {fn, env}
        string fatop = cg_coerce(g, fat, "%closure");     // decay a bare fn arg to {@__fnptr, null}
        string fnp = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, fnp);
        cg_emit(g, " = extractvalue %closure ");
        cg_emit(g, fatop);
        cg_emit(g, ", 0\n");
        string env = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, env);
        cg_emit(g, " = extractvalue %closure ");
        cg_emit(g, fatop);
        cg_emit(g, ", 1\n");
        string tid = cg_entry_alloca(g, "ptr");
        cg_ensure_extern(g, "pthread_create", "declare i32 @pthread_create(ptr, ptr, ptr, ptr)\n");
        g.uses_threads = 1;
        // A lambda written in the call has no other owner, so the thread owns it: start it
        // through a trampoline that frees its env once the body returns. A closure value
        // stays its owner's (the same closure may start several threads). Mirrors C++.
        if (e.a != null && e.a.kind == EK_LAMBDA) {
            g.uses_heap_env = 1;                          // declares malloc (as for a heap env)
            cg_ensure_extern(g, "free", "declare void @free(ptr)\n");
            if (cg_seen_inst(g, "fn:__eskiu_thread_owned") == 0) {
                cg_push_inst(g, "fn:__eskiu_thread_owned");
                String_append(&g.globals, "define internal ptr @__eskiu_thread_owned(ptr %pack) {\nentry:\n");
                String_append(&g.globals, "  %fn = load ptr, ptr %pack\n");
                String_append(&g.globals, "  %envp = getelementptr { ptr, ptr }, ptr %pack, i32 0, i32 1\n");
                String_append(&g.globals, "  %env = load ptr, ptr %envp\n");
                String_append(&g.globals, "  call void @free(ptr %pack)\n");
                String_append(&g.globals, "  call void %fn(ptr %env)\n");
                String_append(&g.globals, "  call void @free(ptr %env)\n");
                String_append(&g.globals, "  ret ptr null\n}\n");
            }
            string pack = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, pack);
            cg_emit(g, cg_cat(" = call ptr @malloc(", cg_cat(cg_size_ty(g), " ")));
            cg_emit(g, cg_itoa(2 * g.ptrsz));
            cg_emit(g, ")\n");
            cg_emit(g, "  store ptr ");
            cg_emit(g, fnp);
            cg_emit(g, ", ptr ");
            cg_emit(g, pack);
            cg_emit(g, "\n");
            string pe = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, pe);
            cg_emit(g, " = getelementptr { ptr, ptr }, ptr ");
            cg_emit(g, pack);
            cg_emit(g, ", i32 0, i32 1\n");
            cg_emit(g, "  store ptr ");
            cg_emit(g, env);
            cg_emit(g, ", ptr ");
            cg_emit(g, pe);
            cg_emit(g, "\n");
            fnp = "@__eskiu_thread_owned";
            env = pack;
        }
        cg_emit(g, "  call i32 @pthread_create(ptr ");
        cg_emit(g, tid);
        cg_emit(g, ", ptr null, ptr ");
        cg_emit(g, fnp);
        cg_emit(g, ", ptr ");
        cg_emit(g, env);
        cg_emit(g, ")\n");
        string h = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, h);
        cg_emit(g, " = load ptr, ptr ");
        cg_emit(g, tid);
        cg_emit(g, "\n");
        v.op = h;
        v.ty = "ptr";
        v.ety = "*void";
        return v;
    }

    if (e.kind == EK_FREECLOSURE) {
        // free_closure(f) → free the closure's heap env (slot 1); free(null) is a safe no-op.
        CgVal fat = cg_expr(g, e.a);
        string fatop = cg_coerce(g, fat, "%closure");     // a bare fn decays to {@__fnptr, null} (env null)
        string env = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, env);
        cg_emit(g, " = extractvalue %closure ");
        cg_emit(g, fatop);
        cg_emit(g, ", 1\n");
        string hf = cg_heap_free(g);
        cg_ensure_extern(g, hf, cg_cat(cg_cat("declare void @", hf), "(ptr)\n"));
        cg_emit(g, "  call void @");
        cg_emit(g, hf);
        cg_emit(g, "(ptr ");
        cg_emit(g, env);
        cg_emit(g, ")\n");
        v.op = "";
        v.ty = "void";
        return v;
    }

    if (e.kind == EK_ARRAYLIT) {
        // Only a variable initializer takes `{...}` (cg_array_init / cg_global_init); as a
        // value anywhere else (a struct-literal field, an argument) it is an error, as in C++.
        dprintf(2, "error: an array literal '{...}' is only valid as a variable initializer\n");
        exit(1);
    }
    if (e.kind == EK_STRUCTINIT) {
        // A struct literal `P{ … }` used as an rvalue (e.g. `x = P{…}`): materialize into a
        // temp, fill its fields, and load the struct value. (Var-decls fill in place.)
        string sname = e.sval;
        string llty = cg_lltype(g, sname);
        string slot = cg_entry_alloca(g, llty);
        cg_struct_init(g, slot, sname, e);
        string r = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, r);
        cg_emit(g, " = load ");
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, slot);
        cg_emit(g, "\n");
        v.op = r;
        v.ty = llty;
        v.ety = sname;
        return v;
    }

    if (e.kind == EK_LAMBDA) {
        // Free-variable analysis: capture the enclosing locals the body references (not its
        // own params). The env is on the stack when sema proved the closure does not outlive
        // the call, else on the heap. Build a fat pointer { @lambdaN, env } and queue the body
        // for emission.
        string lname = cg_cat("__lambda", cg_itoa(g.lam_seq));
        g.lam_seq = g.lam_seq + 1;
        List<string> pp;
        List_init<string>(&pp, 4);
        cg_paren_list(e.sval, &pp);
        List<string> ids;
        List_init<string>(&ids, 16);
        cg_collect_idents_s(e.stmt, &ids);
        List<string> capn;
        List_init<string>(&capn, 4);
        List<string> capt;
        List_init<string>(&capt, 4);
        List<CgLocal> statics;
        List_init<CgLocal>(&statics, 1);
        int ii = 0;
        while (ii < List_len<string>(&ids)) {
            string nm = List_get<string>(&ids, ii);
            ii = ii + 1;
            if (cg_in_strlist(&capn, nm) == 1) {      // already captured
                continue;
            }
            int isparam = 0;
            int pj = 0;
            while (pj < List_len<string>(&pp)) {
                if (cg_streq(cg_last_word(List_get<string>(&pp, pj)), nm) == 1) {
                    isparam = 1;
                }
                pj = pj + 1;
            }
            if (isparam == 1) {
                continue;
            }
            CgLocal l = cg_find_local(g, nm);
            // A `static` local has static storage (its slot is a global, "@…"): the body
            // refers to that one cell, like a global, instead of capturing a copy.
            if (l.slot[0] == 64) {
                List_push<CgLocal>(&statics, l);
                continue;
            }
            if (l.slot[0] != 0) {
                List_push<string>(&capn, nm);
                List_push<string>(&capt, l.ety);
            }
        }
        let lam: CgLambda;
        lam.name = lname;
        lam.node = e;
        lam.capn = capn;
        lam.capt = capt;
        lam.statics = statics;
        lam.sub = cg_copy_sub(&g.cursub);   // freeze the generic substitution for deferred emission
        // Return type: the fn-type from the assignment context wins over the written one
        // (e.g. a lambda written `int(int x)` assigned to `fn(int)->float` returns float).
        if (g.lam_expret[0] != 0) {
            lam.rety = g.lam_expret;
        } else {
            lam.rety = cg_arm_var(e.sval);
        }
        List_push<CgLambda>(&g.lambdas, lam);

        string env = "null";
        int nc = List_len<string>(&capn);
        if (nc > 0) {
            string envty = cg_env_lltype(g, &capt);
            if (e.stack_env == 1) {
                // Sema proved the closure does not outlive this call (an argument to a
                // non-escaping param, or a local that is only called): the env is a stack slot.
                env = cg_entry_alloca(g, envty);
            } else {
                // Heap-allocate the env: the closure may escape (be stored/returned and called
                // after this frame returns, e.g. an event-loop callback), so the env must outlive
                // the frame. Its owner frees it with free_closure (an async frame frees its
                // closure locals itself).
                g.uses_heap_env = 1;
                string szg = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, szg);
                cg_emit(g, " = getelementptr ");
                cg_emit(g, envty);
                cg_emit(g, ", ptr null, i32 1\n");
                string szi = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, szi);
                cg_emit(g, " = ptrtoint ptr ");
                cg_emit(g, szg);
                cg_emit(g, cg_cat(" to ", cg_cat(cg_heap_size_ty(g), "\n")));
                env = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, env);
                cg_emit(g, " = call ptr @");
                cg_emit(g, cg_heap_alloc(g));
                cg_emit(g, cg_cat("(", cg_cat(cg_heap_size_ty(g), " ")));
                cg_emit(g, szi);
                cg_emit(g, ")\n");
            }
            int j = 0;
            while (j < nc) {
                CgLocal l = cg_find_local(g, List_get<string>(&capn, j));
                string ld = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, ld);
                cg_emit(g, " = load ");
                cg_emit(g, l.ty);
                cg_emit(g, ", ptr ");
                cg_emit(g, l.slot);
                cg_emit(g, "\n");
                string fp = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, fp);
                cg_emit(g, " = getelementptr ");
                cg_emit(g, envty);
                cg_emit(g, ", ptr ");
                cg_emit(g, env);
                cg_emit(g, ", i32 0, i32 ");
                cg_emit(g, cg_itoa(j));
                cg_emit(g, "\n");
                cg_emit(g, "  store ");
                cg_emit(g, l.ty);
                cg_emit(g, " ");
                cg_emit(g, ld);
                cg_emit(g, ", ptr ");
                cg_emit(g, fp);
                cg_emit(g, "\n");
                j = j + 1;
            }
        }
        string c = cg_entry_alloca(g, "%closure");
        string c0 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, c0);
        cg_emit(g, " = getelementptr %closure, ptr ");
        cg_emit(g, c);
        cg_emit(g, ", i32 0, i32 0\n");
        cg_emit(g, "  store ptr @");
        cg_emit(g, lname);
        cg_emit(g, ", ptr ");
        cg_emit(g, c0);
        cg_emit(g, "\n");
        string c1 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, c1);
        cg_emit(g, " = getelementptr %closure, ptr ");
        cg_emit(g, c);
        cg_emit(g, ", i32 0, i32 1\n");
        cg_emit(g, "  store ptr ");
        cg_emit(g, env);
        cg_emit(g, ", ptr ");
        cg_emit(g, c1);
        cg_emit(g, "\n");
        string r = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, r);
        cg_emit(g, " = load %closure, ptr ");
        cg_emit(g, c);
        cg_emit(g, "\n");
        v.op = r;
        v.ty = "%closure";
        v.ety = "";
        return v;
    }

    v.op = "0";
    v.ty = "i32";
    return v;
}

// Construct an ADT enum value: alloca the `{ i32, [N x i64] }` tagged union, zero it
// (the payload area past this variant's fields holds no garbage), store the
// variant tag, then write each payload field by viewing the storage as the variant's
// field struct. `call` is the EK_CALL node carrying the argument exprs (null for a
// payload-less variant like `None`). Returns the loaded value (by value, like a struct).
CgVal cg_build_variant(Codegen* g, CgVariant var, *ExprNode call) {
    let v: CgVal;
    v.ety = "";
    string llty = cg_cat("%", var.ename);
    string slot = cg_entry_alloca(g, llty);
    if (cg_ll_big(g, llty) == 1) {
        cg_zero_fill(g, slot, llty);
    }
    else {
        cg_emit(g, "  store ");
        cg_emit(g, llty);
        cg_emit(g, " zeroinitializer, ptr ");
        cg_emit(g, slot);
        cg_emit(g, "\n");
    }
    string tp = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, tp);
    cg_emit(g, " = getelementptr ");
    cg_emit(g, llty);
    cg_emit(g, ", ptr ");
    cg_emit(g, slot);
    cg_emit(g, ", i32 0, i32 0\n");
    cg_emit(g, "  store i32 ");
    cg_emit(g, cg_itoa(var.tag));
    cg_emit(g, ", ptr ");
    cg_emit(g, tp);
    cg_emit(g, "\n");
    int np = List_len<string>(&var.ptys);
    if (np > 0 && call != null) {
        string pstruct = cg_payload_lltype(g, &var);   // "{ i32, i32 }"
        string pp = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, pp);
        cg_emit(g, " = getelementptr ");
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, slot);
        cg_emit(g, ", i32 0, i32 1\n");
        int i = 0;
        while (i < np && i < List_len<*ExprNode>(&call.kids)) {
            *ExprNode kx = List_get<*ExprNode>(&call.kids, i);
            CgVal a = cg_expr(g, kx);
            string pety = List_get<string>(&var.ptys, i);
            string fty = cg_lltype(g, pety);
            string aop = "";
            if (cg_is_iface(g, cg_dealias(g, pety)) == 1) {   // box `&s`
                aop = cg_iface_conv(g, pety, a, kx);
            }
            else {
                aop = cg_coerce(g, a, fty);
            }
            string fp = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, fp);
            cg_emit(g, " = getelementptr ");
            cg_emit(g, pstruct);
            cg_emit(g, ", ptr ");
            cg_emit(g, pp);
            cg_emit(g, ", i32 0, i32 ");
            cg_emit(g, cg_itoa(i));
            cg_emit(g, "\n");
            cg_emit(g, "  store ");
            cg_emit(g, fty);
            cg_emit(g, " ");
            cg_emit(g, aop);
            cg_emit(g, ", ptr ");
            cg_emit(g, fp);
            cg_emit(g, "\n");
            i = i + 1;
        }
    }
    string r = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, r);
    cg_emit(g, " = load ");
    cg_emit(g, llty);
    cg_emit(g, ", ptr ");
    cg_emit(g, slot);
    cg_emit(g, "\n");
    v.op = r;
    v.ty = llty;
    v.ety = var.ename;
    return v;
}

// A call to a declared atomic intrinsic (an ordinary function of the same name is not).
int cg_is_atomic(Codegen* g, string nm) {
    return ast_atomic_op(nm)[0] != 0 && cg_seen_inst(g, cg_cat("intrinsic:", nm)) == 1;
}

// Lower an atomic intrinsic to the matching LLVM atomic instruction (mirrors the C++
// lowerIntrinsicCall): the cell is i32, i64 or ptr by the name's suffix; load acquire,
// store release, the rest acq_rel (a failed cas acquire), fence seq_cst.
CgVal cg_emit_atomic(Codegen* g, string nm, *ExprNode e) {
    let v: CgVal;
    v.ety = "";
    string op = ast_atomic_op(nm);
    if (cg_streq(op, "fence") == 1) {
        cg_emit(g, "  fence seq_cst\n");
        v.op = "";
        v.ty = "void";
        return v;
    }
    int k = ast_atomic_kind(nm);
    // Orderings: acquire / release / acq_rel, or monotonic for a `_relaxed` name.
    string o_ld = " acquire";
    string o_st = " release";
    string o_rmw = " acq_rel";
    string o_fail = " acquire";
    if (ast_atomic_relaxed(nm) == 1) {
        o_ld = " monotonic";
        o_st = " monotonic";
        o_rmw = " monotonic";
        o_fail = " monotonic";
    }
    string ty = "i32";
    string al = "4";
    if (k == 1) {
        ty = "i64";
        al = cg_itoa(g.i64al);
    }
    if (k == 2) {
        ty = "ptr";
        al = cg_itoa(g.ptrsz);
    }
    string cell = cg_expr(g, List_get<*ExprNode>(&e.kids, 0)).op;
    if (cg_streq(op, "load") == 1) {
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = load atomic ");
        cg_emit(g, ty);
        cg_emit(g, ", ptr ");
        cg_emit(g, cell);
        cg_emit(g, o_ld);
        cg_emit(g, ", align ");
        cg_emit(g, al);
        cg_emit(g, "\n");
        v.op = t;
        v.ty = ty;
        return v;
    }
    string a1 = cg_coerce(g, cg_expr(g, List_get<*ExprNode>(&e.kids, 1)), ty);
    if (cg_streq(op, "store") == 1) {
        cg_emit(g, "  store atomic ");
        cg_emit(g, ty);
        cg_emit(g, " ");
        cg_emit(g, a1);
        cg_emit(g, ", ptr ");
        cg_emit(g, cell);
        cg_emit(g, o_st);
        cg_emit(g, ", align ");
        cg_emit(g, al);
        cg_emit(g, "\n");
        v.op = "";
        v.ty = "void";
        return v;
    }
    if (cg_streq(op, "cas") == 1) {
        string des = cg_coerce(g, cg_expr(g, List_get<*ExprNode>(&e.kids, 2)), ty);
        string p = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, p);
        cg_emit(g, " = cmpxchg ptr ");
        cg_emit(g, cell);
        cg_emit(g, ", ");
        cg_emit(g, ty);
        cg_emit(g, " ");
        cg_emit(g, a1);
        cg_emit(g, ", ");
        cg_emit(g, ty);
        cg_emit(g, " ");
        cg_emit(g, des);
        cg_emit(g, o_rmw);
        cg_emit(g, o_fail);
        cg_emit(g, ", align ");
        cg_emit(g, al);
        cg_emit(g, "\n");
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = extractvalue { ");
        cg_emit(g, ty);
        cg_emit(g, ", i1 } ");
        cg_emit(g, p);
        cg_emit(g, ", 1\n");
        v.op = t;
        v.ty = "i1";
        return v;
    }
    string rmw = "xchg";
    if (cg_streq(op, "fetch_add") == 1) {
        rmw = "add";
    }
    if (cg_streq(op, "fetch_sub") == 1) {
        rmw = "sub";
    }
    if (cg_streq(op, "fetch_and") == 1) {
        rmw = "and";
    }
    if (cg_streq(op, "fetch_or") == 1) {
        rmw = "or";
    }
    if (cg_streq(op, "fetch_xor") == 1) {
        rmw = "xor";
    }
    string t = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = atomicrmw ");
    cg_emit(g, rmw);
    cg_emit(g, " ptr ");
    cg_emit(g, cell);
    cg_emit(g, ", ");
    cg_emit(g, ty);
    cg_emit(g, " ");
    cg_emit(g, a1);
    cg_emit(g, o_rmw);
    cg_emit(g, ", align ");
    cg_emit(g, al);
    cg_emit(g, "\n");
    v.op = t;
    v.ty = ty;
    return v;
}

// Call a closure value `cval` (a loaded %closure) of fn-type `fnty`: extract { fn, env }
// and call fn(env, args...). Shared by ident-of-fn-type and closure-typed-field callees.
CgVal cg_indirect_call(Codegen* g, string cval, string fnty, *ExprNode e) {
    let v: CgVal;
    v.ety = "";
    string fp = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, fp);
    cg_emit(g, " = extractvalue %closure ");
    cg_emit(g, cval);
    cg_emit(g, ", 0\n");
    string ep = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, ep);
    cg_emit(g, " = extractvalue %closure ");
    cg_emit(g, cval);
    cg_emit(g, ", 1\n");
    List<string> fpt;
    List_init<string>(&fpt, 4);
    cg_paren_list(fnty, &fpt);
    string rt = cg_lltype(g, cg_fnty_ret(fnty));
    string cargs = cg_cat("ptr ", ep);                  // env is the first argument
    int i = 0;
    int nn = List_len<*ExprNode>(&e.kids);
    while (i < nn) {
        *ExprNode iax = List_get<*ExprNode>(&e.kids, i);
        CgVal a = cg_expr(g, iax);
        string aop = a.op;
        string aty = a.ty;
        if (i < List_len<string>(&fpt)) {
            string pety = List_get<string>(&fpt, i);
            string pty = cg_lltype(g, pety);
            aop = cg_coerce(g, a, pty);
            aty = pty;
            if (cg_is_iface(g, cg_dealias(g, pety)) == 1) {   // box `&s`
                aop = cg_iface_conv(g, pety, a, iax);
            }
        }
        cargs = cg_cat(cargs, cg_cat(", ", cg_cat(aty, cg_cat(" ", aop))));
        i = i + 1;
    }
    int isvoidc = cg_streq(rt, "void");
    string t = cg_emit_callish(g, rt, fp, cargs, isvoidc);
    if (isvoidc == 1) {
        v.op = "";
        v.ty = "void";
        return v;
    }
    v.op = t;
    v.ty = rt;
    v.ety = cg_fnty_ret(fnty);
    return v;
}

// Box a struct pointer `dataop` (of struct `structName`) as interface `ifaceName`: the fat
// pointer value {data, vtable} (an interface value is this struct, by value, like a closure).
// The per-(interface,struct) vtable global is emitted once, holding the struct's
// implementation of each interface method in declaration order.
// The function implementing interface method `mi` of `f` for struct `sname`: `S_m`, or for
// a generic instance (`Box<int>`) its inline method or a generic free `S_m<T..>(S<T..>* self,
// ...)` instantiated for it (type params bound from the receiver, then the interface's
// parameter types). Mirrors the C++ boxAsInterface.
string cg_iface_slot_fn(Codegen* g, CgIface* f, int mi, string sname) {
    string method = List_get<string>(&f.mnames, mi);
    if (cg_has_targs(sname) == 0) {
        return cg_cat(cg_cat(sname, "_"), method);
    }
    string gm = cg_ensure_method_inst(g, sname, method);
    if (gm[0] != 0) {
        return gm;
    }
    string base = cg_gen_base(sname);
    *DeclNode gd = cg_find_gfn(g, cg_cat(cg_cat(base, "_"), method));
    if (gd == null || List_len<Param>(&gd.params) == 0) {
        return cg_cat(cg_cat(cg_mangle(sname), "_"), method);
    }
    string selfty = List_get<Param>(&gd.params, 0).ty;
    List<string> sargs;
    List_init<string>(&sargs, 2);
    cg_gen_args(cg_strip_ptr(selfty), &sargs);
    List<string> rargs;
    List_init<string>(&rargs, 2);
    cg_gen_args(sname, &rargs);
    List<string> ipts = List_get<List<string>>(&f.mparams, mi);
    String sp;
    String_init(&sp, 16);
    String_append(&sp, gd.name);
    String_append(&sp, "<");
    int ti = 0;
    int ntp = List_len<TypeParam>(&gd.type_params);
    while (ti < ntp) {
        string tp = List_get<TypeParam>(&gd.type_params, ti).name;
        string binding = "";
        int k = 0;
        while (binding[0] == 0 && k < List_len<string>(&sargs) && k < List_len<string>(&rargs)) {
            if (cg_streq(List_get<string>(&sargs, k), tp) == 1) {
                binding = List_get<string>(&rargs, k);
            }
            k = k + 1;
        }
        int pi = 1;
        int np = List_len<Param>(&gd.params);
        while (binding[0] == 0 && pi < np && pi - 1 < List_len<string>(&ipts)) {
            binding = cg_infer_bind(List_get<Param>(&gd.params, pi).ty, tp, List_get<string>(&ipts, pi - 1));
            pi = pi + 1;
        }
        if (ti > 0) {
            String_append(&sp, ", ");
        }
        String_append(&sp, binding);
        ti = ti + 1;
    }
    String_append(&sp, ">");
    return cg_ensure_fn_inst(g, (string)String_cstr(&sp));
}

string cg_iface_vtable(Codegen* g, string ifaceName, string structName);   // fwd
string cg_box_iface(Codegen* g, string ifaceName, string structName, string dataop) {
    string vtg = cg_iface_vtable(g, ifaceName, structName);
    string f1 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, f1);
    cg_emit(g, " = insertvalue %iface_fat undef, ptr ");
    cg_emit(g, dataop);
    cg_emit(g, ", 0\n");
    string f2 = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, f2);
    cg_emit(g, " = insertvalue %iface_fat ");
    cg_emit(g, f1);
    cg_emit(g, ", ptr ");
    cg_emit(g, vtg);
    cg_emit(g, ", 1\n");
    return f2;
}

// The vtable global of `structName` as an `ifaceName` (emitted once), e.g. `@Sh_vtable_Sq`.
string cg_iface_vtable(Codegen* g, string ifaceName, string structName) {
    CgIface f = cg_find_iface(g, ifaceName);
    string vtg = cg_cat("@", cg_cat(ifaceName, cg_cat("_vtable_", cg_mangle(structName))));
    string key = cg_cat("vt:", cg_cat(ifaceName, cg_cat("_", structName)));
    if (cg_seen_inst(g, key) == 0) {
        cg_push_inst(g, key);
        // Resolve every slot first: instantiating one may itself append to g.globals.
        List<string> slots;
        List_init<string>(&slots, 4);
        int mi = 0;
        int mn = List_len<string>(&f.mnames);
        while (mi < mn) {
            List_push<string>(&slots, cg_iface_slot_fn(g, &f, mi, structName));
            mi = mi + 1;
        }
        String_append(&g.globals, vtg);
        String_append(&g.globals, " = private constant %");
        String_append(&g.globals, ifaceName);
        String_append(&g.globals, "_vtable { ");
        mi = 0;
        while (mi < mn) {
            if (mi > 0) {
                String_append(&g.globals, ", ");
            }
            String_append(&g.globals, "ptr @");
            String_append(&g.globals, List_get<string>(&slots, mi));
            mi = mi + 1;
        }
        String_append(&g.globals, " }\n");
    }
    return vtg;
}

// Constant initializer text of a global / static of Eskiu type `ety` (cg_global_init on
// its LLVM type). An interface value is `null` (the empty fat value) or a boxed
// `&global`: `{ ptr @g, ptr @I_vtable_S }`.
string cg_global_init_ty(Codegen* g, *ExprNode e, string ety) {
    string t = cg_dealias(g, ety);
    // An array of interface values: each element is boxed like a scalar one.
    string inner = t;
    while (cg_is_array(inner) == 1) {
        inner = cg_dealias(g, cg_array_elem(inner));
    }
    if (e != null && e.kind == EK_ARRAYLIT && cg_is_array(t) == 1 && cg_is_iface(g, inner) == 1) {
        string elemEty = cg_array_elem(t);
        string elemLl = cg_lltype(g, elemEty);
        int cnt = 0;
        string lt = cg_lltype(g, t);
        int ci = 1;
        while ((int)lt[ci] >= 48 && (int)lt[ci] <= 57) {
            cnt = cnt * 10 + ((int)lt[ci] - 48);
            ci = ci + 1;
        }
        let out: String;
        String_init(&out, 64);
        String_push(&out, '[');
        int k = 0;
        while (k < cnt) {
            if (k > 0) {
                String_append(&out, ", ");
            }
            String_append(&out, elemLl);
            String_push(&out, ' ');
            if (k < List_len<*ExprNode>(&e.kids)) {
                String_append(&out, cg_global_init_ty(g, List_get<*ExprNode>(&e.kids, k), elemEty));
            }
            else {
                String_append(&out, "zeroinitializer");
            }
            k = k + 1;
        }
        String_push(&out, ']');
        return (string)String_cstr(&out);
    }
    if (e != null && cg_is_iface(g, t) == 1) {
        if (e.kind == EK_LITERAL && e.lit_kind == LIT_NULL) {
            return "zeroinitializer";
        }
        if (e.kind == EK_UNARY && cg_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
            CgLocal gl = cg_find_global(g, e.a.sval);
            if (gl.slot[0] != 0 && cg_is_struct(g, cg_dealias(g, gl.ety)) == 1) {
                string vtg = cg_iface_vtable(g, t, cg_dealias(g, gl.ety));
                return cg_cat("{ ptr ", cg_cat(gl.slot, cg_cat(", ptr ", cg_cat(vtg, " }"))));
            }
        }
        dprintf(2, "error: an interface global's initializer must be null or the address of a global struct\n");
        exit(1);
    }
    return cg_global_init(g, e, cg_lltype(g, ety));
}

// The operand for value `a` (from expression `ax`) stored into a slot of Eskiu type `tety`:
// when the slot is an interface and `a` is not already that interface, box the struct
// pointer (`null` → the empty fat value). Otherwise `a.op` unchanged. Mirrors evalForType.
string cg_iface_conv(Codegen* g, string tety, CgVal a, *ExprNode ax) {
    string t = cg_dealias(g, tety);
    if (cg_is_iface(g, t) == 0) {
        return a.op;
    }
    if (cg_streq(cg_dealias(g, a.ety), t) == 1) {
        return a.op;
    }
    if (ax != null && ax.kind == EK_LITERAL && ax.lit_kind == LIT_NULL) {
        return "zeroinitializer";
    }
    if (cg_streq(a.ty, "%iface_fat") == 1) {
        return a.op;
    }
    string sety = a.ety;
    if (sety[0] == 0) {
        sety = cg_etype(g, ax);
    }
    return cg_box_iface(g, t, cg_strip_ptr(sety), a.op);
}

// Dynamic dispatch `recv.method(...)` where `recv` is an interface value (a fat pointer
// `fatop`): load the data + vtable from the fat pointer, load the method's fn pointer from
// its vtable slot, and call it with `data` as the implicit first argument.
CgVal cg_dispatch_iface(Codegen* g, string ifaceName, string fatop, string method, *ExprNode e) {
    let v: CgVal;
    v.ety = "";
    CgIface f = cg_find_iface(g, ifaceName);
    int idx = cg_iface_midx(&f, method);
    string data = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, data);
    cg_emit(g, " = extractvalue %iface_fat ");
    cg_emit(g, fatop);
    cg_emit(g, ", 0\n");
    string vt = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, vt);
    cg_emit(g, " = extractvalue %iface_fat ");
    cg_emit(g, fatop);
    cg_emit(g, ", 1\n");
    string fg = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, fg);
    cg_emit(g, " = getelementptr %");
    cg_emit(g, ifaceName);
    cg_emit(g, "_vtable, ptr ");
    cg_emit(g, vt);
    cg_emit(g, ", i32 0, i32 ");
    cg_emit(g, cg_itoa(idx));
    cg_emit(g, "\n");
    string fnp = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, fnp);
    cg_emit(g, " = load ptr, ptr ");
    cg_emit(g, fg);
    cg_emit(g, "\n");
    string rety = List_get<string>(&f.mrets, idx);
    string rt = cg_lltype(g, rety);
    string args = cg_cat("ptr ", data);                 // self/data is the first argument
    List<string> ptys = List_get<List<string>>(&f.mparams, idx);
    int i = 0;
    int nn = List_len<*ExprNode>(&e.kids);
    while (i < nn) {
        *ExprNode dax = List_get<*ExprNode>(&e.kids, i);
        CgVal a = cg_expr(g, dax);
        string aop = a.op;
        string aty = a.ty;
        if (i < List_len<string>(&ptys)) {              // coerce to the method's param type
            string dpety = List_get<string>(&ptys, i);
            string pty = cg_lltype(g, dpety);
            if (cg_is_iface(g, cg_dealias(g, dpety)) == 1) {
                aop = cg_iface_conv(g, dpety, a, dax);
                aty = pty;
            }
            else if (pty[0] != 0) {
                aop = cg_coerce(g, a, pty);
                aty = pty;
            }
        }
        args = cg_cat(args, cg_cat(", ", cg_cat(aty, cg_cat(" ", aop))));
        i = i + 1;
    }
    int isvoid = cg_streq(rt, "void");
    string t = cg_emit_callish(g, rt, fnp, args, isvoid);
    if (isvoid == 1) {
        v.op = "";
        v.ty = "void";
        return v;
    }
    v.op = t;
    v.ty = rt;
    v.ety = rety;
    return v;
}

// Emit a call to an already-monomorphized function `@mangled` with e's args (coerced to
// its declared param types). Shared by explicit template calls and inferred generic calls.
CgVal cg_call_mangled(Codegen* g, string mangled, *ExprNode e) {
    let v: CgVal;
    v.ety = "";
    CgFn f = cg_find_fn(g, mangled);
    string args = "";
    int i = 0;
    int n = List_len<*ExprNode>(&e.kids);
    while (i < n) {
        *ExprNode ax = List_get<*ExprNode>(&e.kids, i);
        CgVal a = cg_expr(g, ax);
        string pty = cg_pty(&f, i);
        string pety = cg_pety(&f, i);
        string aop = a.op;
        string aty = a.ty;
        // An interface parameter (`Sh y`, or `T x` with T = Sh) boxes a struct pointer.
        if (pety[0] != 0 && cg_is_iface(g, cg_dealias(g, pety)) == 1) {
            aop = cg_iface_conv(g, pety, a, ax);
            aty = "%iface_fat";
        }
        else if (pty[0] != 0) {
            aop = cg_coerce(g, a, pty);
            aty = pty;
        }
        else if (f.variadic == 1 && cg_streq(a.ty, "float") == 1) {   // vararg promotion
            aop = cg_coerce(g, a, "double");
            aty = "double";
        }
        else if (f.variadic == 1 && cg_int_w(a.ty) > 0 && cg_int_w(a.ty) < 32) {
            aop = cg_coerce(g, a, "i32");
            aty = "i32";
        }
        if (args[0] != 0) {
            args = cg_cat(args, ", ");
        }
        args = cg_cat(args, cg_cat(aty, cg_cat(" ", aop)));
        i = i + 1;
    }
    int isvoid = cg_streq(f.retty, "void");
    // A variadic callee needs the explicit function type: `call i32 (i32, ...) @f_int`.
    string callty = f.retty;
    if (f.variadic == 1) {
        callty = cg_cat(f.retty, cg_cat(" (", cg_cat(cg_va(f.fixedtypes), ")")));
    }
    string t = cg_emit_callish(g, callty, cg_cat("@", mangled), args, isvoid);
    if (isvoid == 1) {
        v.op = "";
        v.ty = "void";
        return v;
    }
    v.op = t;
    v.ty = f.retty;
    v.ety = f.rety;
    return v;
}

// Whole-token index of `tok` in `s` (delimited by non-identifier chars), or -1.
int cg_tok_index(string s, string tok) {
    int n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    int m = 0;
    while (tok[m] != 0) {
        m = m + 1;
    }
    int i = 0;
    while (i + m <= n) {
        int eq = 1;
        int k = 0;
        while (k < m) {
            if (s[i + k] != tok[k]) {
                eq = 0;
            }
            k = k + 1;
        }
        if (eq == 1) {
            int beforeOk = 1;
            if (i > 0) {
                int b = (int)s[i - 1];
                if ((b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95) {
                    beforeOk = 0;
                }
            }
            int afterOk = 1;
            int af = (int)s[i + m];
            if ((af >= 97 && af <= 122) || (af >= 65 && af <= 90) || (af >= 48 && af <= 57) || af == 95) {
                afterOk = 0;
            }
            if (beforeOk == 1 && afterOk == 1) {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Infer one type-param binding by unifying a param pattern (e.g. "Chan<T>*") against a
// concrete arg type ("Chan<int>*"): the pattern is prefix + Tp + suffix, so the binding is
// the middle of the arg once prefix/suffix are stripped. "" if it doesn't fit.
// Canonical pointer form: trailing '*'/spaces moved to the front ("Box<T>*" → "*Box<T>"),
// so a declared param (trailing-star) and a cg_etype result (leading-star) compare equal.
string cg_norm_ptr(string t) {
    int b = 0;
    while (t[b] != 0) {
        b = b + 1;
    }
    int stars = 0;
    while (b > 0 && ((int)t[b - 1] == 42 || (int)t[b - 1] == 32)) {
        if ((int)t[b - 1] == 42) {
            stars = stars + 1;
        }
        b = b - 1;
    }
    int a = 0;
    while ((int)t[a] == 42) {
        stars = stars + 1;
        a = a + 1;
    }
    string core = cg_sub_str(t, a, b);
    String r;
    String_init(&r, b - a + stars);
    int i = 0;
    while (i < stars) {
        String_push(&r, '*');
        i = i + 1;
    }
    String_append(&r, core);
    return (string)String_cstr(&r);
}

string cg_infer_one(string pat0, string tp, string arg0) {
    string pattern = cg_norm_ptr(pat0);
    string arg = cg_norm_ptr(arg0);
    int pos = cg_tok_index(pattern, tp);
    if (pos < 0) {
        return "";
    }
    int pn = 0;
    while (pattern[pn] != 0) {
        pn = pn + 1;
    }
    int tn = 0;
    while (tp[tn] != 0) {
        tn = tn + 1;
    }
    int an = 0;
    while (arg[an] != 0) {
        an = an + 1;
    }
    string prefix = cg_sub_str(pattern, 0, pos);
    string suffix = cg_sub_str(pattern, pos + tn, pn);
    int pl = pos;
    int sl = pn - (pos + tn);
    if (an < pl + sl) {
        return "";
    }
    int k = 0;   // prefix matches
    while (k < pl) {
        if (arg[k] != prefix[k]) {
            return "";
        }
        k = k + 1;
    }
    k = 0;  // suffix matches
    while (k < sl) {
        if (arg[an - sl + k] != suffix[k]) {
            return "";
        }
        k = k + 1;
    }
    return cg_sub_str(arg, pl, an - sl);
}

// The binding of `tp` from a param pattern against an argument type: structural
// unification over nested type args first (`Pair<A, B>` binds A and B), then the
// prefix/suffix match for other shapes (e.g. a fn type `fn(*K)->uint64`).
string cg_infer_bind(string pat, string tp, string arg) {
    string b = ast_unify_tparam(pat, arg, tp);
    if (b[0] != 0) {
        return b;
    }
    return cg_infer_one(pat, tp, arg);
}

// Build `name<arg0, arg1, …>` for a generic fn called without explicit type args, inferring
// each type param from the first parameter whose pattern mentions it. "" if any is unsolved.
string cg_infer_generic(Codegen* g, *DeclNode gd, *ExprNode e) {
    String sp;
    String_init(&sp, 16);
    String_append(&sp, gd.name);
    String_append(&sp, "<");
    int ti = 0;
    int ntp = List_len<TypeParam>(&gd.type_params);
    while (ti < ntp) {
        string tp = List_get<TypeParam>(&gd.type_params, ti).name;
        // Structural parameters bind first; by-value `T a` deductions meet at their common
        // integer type (as sema decides: `maxof(1, big)` is `maxof<int64>`).
        string binding = "";
        int pi = 0;
        int np = List_len<Param>(&gd.params);
        while (pi < np && binding[0] == 0) {
            if (pi < List_len<*ExprNode>(&e.kids) && cg_streq(ast_unify_canon(List_get<Param>(&gd.params, pi).ty), tp) == 0) {
                string argty = cg_etype(g, List_get<*ExprNode>(&e.kids, pi));
                if (argty[0] != 0) {
                    binding = cg_infer_bind(List_get<Param>(&gd.params, pi).ty, tp, argty);
                }
            }
            pi = pi + 1;
        }
        int bystruct = 0;
        if (binding[0] != 0) {
            bystruct = 1;
        }
        pi = 0;
        while (bystruct == 0 && pi < np && pi < List_len<*ExprNode>(&e.kids)) {
            if (cg_streq(ast_unify_canon(List_get<Param>(&gd.params, pi).ty), tp) == 1) {
                string argty = cg_etype(g, List_get<*ExprNode>(&e.kids, pi));
                if (argty[0] != 0 && cg_streq(argty, "null") == 0) {
                    string b = cg_infer_bind(List_get<Param>(&gd.params, pi).ty, tp, argty);
                    if (b[0] != 0) {
                        if (binding[0] == 0) {
                            binding = b;
                        }
                        else if (cg_streq(binding, b) == 0) {
                            string common = ast_range_var_type(binding, b);
                            if (common[0] != 0) {
                                binding = common;
                            }
                        }
                    }
                }
            }
            pi = pi + 1;
        }
        if (binding[0] == 0) {              // couldn't infer this param
            return "";
        }
        if (ti > 0) {
            String_append(&sp, ", ");
        }
        String_append(&sp, binding);
        ti = ti + 1;
    }
    String_append(&sp, ">");
    return (string)String_cstr(&sp);
}

// The address (a ptr) of the struct that a member expression `ea` denotes, plus its struct
// type name (via out_sname). Mirrors the base resolution in cg_lval's EK_MEMBER.
string cg_member_baseptr(Codegen* g, *ExprNode ea, *string out_sname) {
    string bet = cg_etype(g, ea);
    if (cg_is_ptr_ty(bet) == 1) {
        out_sname[0] = cg_strip_ptr(bet);
        return cg_safe_nonnull(g, cg_expr(g, ea).op);
    }
    CgVal lv = cg_lval(g, ea);
    if (lv.op[0] != 0) {
        out_sname[0] = bet;
        if (lv.ety[0] != 0) {
            out_sname[0] = lv.ety;
        }
        return lv.op;
    }
    CgVal val = cg_expr(g, ea);                       // rvalue → materialize
    if (val.ety[0] != 0) {
        out_sname[0] = val.ety;
    } else {
        out_sname[0] = bet;
    }
    string slot = cg_entry_alloca(g, val.ty);
    cg_emit(g, "  store ");
    cg_emit(g, val.ty);
    cg_emit(g, " ");
    cg_emit(g, val.op);
    cg_emit(g, ", ptr ");
    cg_emit(g, slot);
    cg_emit(g, "\n");
    return slot;
}

// `v` truncated to `w` bits, as the signed decimal LLVM expects for an iw constant.
string cg_iconst(uint64 v, int w) {
    let top: uint64 = 1;
    if (w < 64) {
        let m: uint64 = top << w;
        v = v & (m - 1);
        if (v >= m / 2) {
            return cg_cat("-", cg_u64toa(m - v));
        }
        return cg_u64toa(v);
    }
    let sgn: uint64 = top << 63;
    if (v >= sgn) {
        let z: uint64 = 0;
        return cg_cat("-", cg_u64toa(z - v));
    }
    return cg_u64toa(v);
}

// (1<<bw)-1 as a uint64 (all ones when bw >= 64).
uint64 cg_bf_mask(int bw) {
    let one: uint64 = 1;
    if (bw >= 64) {
        let z: uint64 = 0;
        return z - one;
    }
    return (one << bw) - one;
}

// Address of a bitfield's storage word inside the struct at `baseptr`.
// Also the address of a normal field of a bitfield-layout struct: by byte offset under the
// C layout, else the struct element.
string cg_bf_wordptr(Codegen* g, string baseptr, string sname, CgBF slot) {
    string wa = cg_tmp(g);
    if (slot.boffs >= 0) {
        cg_emit(g, "  ");
        cg_emit(g, wa);
        cg_emit(g, " = getelementptr inbounds i8, ptr ");
        cg_emit(g, baseptr);
        cg_emit(g, ", i64 ");
        cg_emit(g, cg_itoa(slot.boffs));
        cg_emit(g, "\n");
        return wa;
    }
    cg_emit(g, "  ");
    cg_emit(g, wa);
    cg_emit(g, " = getelementptr inbounds %");
    cg_emit(g, sname);
    cg_emit(g, ", ptr ");
    cg_emit(g, baseptr);
    cg_emit(g, ", i32 0, i32 ");
    cg_emit(g, cg_itoa(slot.fidx));
    cg_emit(g, "\n");
    return wa;
}

// Read a bitfield from its word: load, shift down, mask, and sign-extend if signed. The
// value is in the storage type (like the C++ codegen) and carries the field's Eskiu type.
// ` align N` for a word access that needs one ("" = natural).
string cg_bf_al(CgBF slot) {
    if (slot.aal > 0) {
        return cg_cat(", align ", cg_itoa(slot.aal));
    }
    return "";
}

// A mask constant printed for an integer of `w` bits (wider than 64: unsigned decimal).
string cg_bf_const(uint64 v, int w) {
    if (w > 64) {
        return cg_u64toa(v);
    }
    return cg_iconst(v, w);
}

// Convert integer `op` of type `from` to `to` (zext or trunc; no-op when equal).
string cg_bf_resize(Codegen* g, string op, string from, string to) {
    int fw = cg_int_w(from);
    int tw = cg_int_w(to);
    if (fw == tw) {
        return op;
    }
    string t = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = ");
    if (fw > tw) {
        cg_emit(g, "trunc ");
    } else {
        cg_emit(g, "zext ");
    }
    cg_emit(g, from);
    cg_emit(g, " ");
    cg_emit(g, op);
    cg_emit(g, " to ");
    cg_emit(g, to);
    cg_emit(g, "\n");
    return t;
}

// Read a bitfield from its word: load (as the access type), shift down, mask, and
// sign-extend if signed. The value is in the storage type (like the C++ codegen) and
// carries the field's Eskiu type.
CgVal cg_bf_load(Codegen* g, string wa, CgBF slot) {
    let v: CgVal;
    v.ety = slot.fety;
    string st = slot.sty;
    int W = cg_int_w(st);
    string at = slot.aty;
    string w = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, w);
    cg_emit(g, " = load ");
    cg_emit(g, g.bf_vol);
    cg_emit(g, at);
    cg_emit(g, ", ptr ");
    cg_emit(g, wa);
    cg_emit(g, cg_bf_al(slot));
    cg_emit(g, "\n");
    string sh = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, sh);
    cg_emit(g, " = lshr ");
    cg_emit(g, at);
    cg_emit(g, " ");
    cg_emit(g, w);
    cg_emit(g, ", ");
    cg_emit(g, cg_itoa(slot.boff));
    cg_emit(g, "\n");
    string shs = cg_bf_resize(g, sh, at, st);
    string m = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, m);
    cg_emit(g, " = and ");
    cg_emit(g, st);
    cg_emit(g, " ");
    cg_emit(g, shs);
    cg_emit(g, ", ");
    cg_emit(g, cg_iconst(cg_bf_mask(slot.bw), W));
    cg_emit(g, "\n");
    v.ty = st;
    if (slot.sgn == 1 && slot.bw < W) {               // sign-extend from bw bits
        string s1 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, s1);
        cg_emit(g, " = shl ");
        cg_emit(g, st);
        cg_emit(g, " ");
        cg_emit(g, m);
        cg_emit(g, ", ");
        cg_emit(g, cg_itoa(W - slot.bw));
        cg_emit(g, "\n");
        string s2 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, s2);
        cg_emit(g, " = ashr ");
        cg_emit(g, st);
        cg_emit(g, " ");
        cg_emit(g, s1);
        cg_emit(g, ", ");
        cg_emit(g, cg_itoa(W - slot.bw));
        cg_emit(g, "\n");
        v.op = s2;
        return v;
    }
    v.op = m;
    return v;
}

// Write a bitfield into its word: load (as the access type), clear the field's bits, OR
// in the masked/shifted value. `rhsop` is already in the storage type (slot.sty).
void cg_bf_store(Codegen* g, string wa, CgBF slot, string rhsop) {
    string st = slot.sty;
    int W = cg_int_w(st);
    string at = slot.aty;
    int AW = cg_int_w(at);
    uint64 mask = cg_bf_mask(slot.bw);
    string w = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, w);
    cg_emit(g, " = load ");
    cg_emit(g, g.bf_vol);
    cg_emit(g, at);
    cg_emit(g, ", ptr ");
    cg_emit(g, wa);
    cg_emit(g, cg_bf_al(slot));
    cg_emit(g, "\n");
    string fm = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, fm);
    cg_emit(g, " = shl ");
    cg_emit(g, at);
    cg_emit(g, " ");
    cg_emit(g, cg_bf_const(mask, AW));
    cg_emit(g, ", ");
    cg_emit(g, cg_itoa(slot.boff));
    cg_emit(g, "\n");
    string nfm = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, nfm);
    cg_emit(g, " = xor ");
    cg_emit(g, at);
    cg_emit(g, " ");
    cg_emit(g, fm);
    cg_emit(g, ", -1\n");
    string c = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, c);
    cg_emit(g, " = and ");
    cg_emit(g, at);
    cg_emit(g, " ");
    cg_emit(g, w);
    cg_emit(g, ", ");
    cg_emit(g, nfm);
    cg_emit(g, "\n");
    string vm = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, vm);
    cg_emit(g, " = and ");
    cg_emit(g, st);
    cg_emit(g, " ");
    cg_emit(g, rhsop);
    cg_emit(g, ", ");
    cg_emit(g, cg_iconst(mask, W));
    cg_emit(g, "\n");
    string vma = cg_bf_resize(g, vm, st, at);
    string shv = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, shv);
    cg_emit(g, " = shl ");
    cg_emit(g, at);
    cg_emit(g, " ");
    cg_emit(g, vma);
    cg_emit(g, ", ");
    cg_emit(g, cg_itoa(slot.boff));
    cg_emit(g, "\n");
    string nw = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, nw);
    cg_emit(g, " = or ");
    cg_emit(g, at);
    cg_emit(g, " ");
    cg_emit(g, c);
    cg_emit(g, ", ");
    cg_emit(g, shv);
    cg_emit(g, "\n");
    cg_emit(g, "  store ");
    cg_emit(g, g.bf_vol);
    cg_emit(g, at);
    cg_emit(g, " ");
    cg_emit(g, nw);
    cg_emit(g, ", ptr ");
    cg_emit(g, wa);
    cg_emit(g, cg_bf_al(slot));
    cg_emit(g, "\n");
}

// The type a bitfield is read as: `int` when all its values fit an int (C promotion),
// else its declared type (mirrors CodeGen::bitfieldReadEskiu).
string cg_bf_read_ety(Codegen* g, CgBF slot) {
    if (cg_streq(ast_bf_read_type(cg_dealias(g, slot.fety), slot.bw), "int") == 1) {
        return "int";
    }
    return slot.fety;
}

// A bitfield value in its storage type, converted to the type it is read as.
CgVal cg_bf_promote(Codegen* g, CgVal v, CgBF slot) {
    if (cg_streq(cg_bf_read_ety(g, slot), "int") == 0) {
        return v;
    }
    if (cg_streq(v.ty, "i32") == 0) {
        string t = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = trunc ");
        cg_emit(g, v.ty);
        cg_emit(g, " ");
        cg_emit(g, v.op);
        cg_emit(g, " to i32\n");
        v.op = t;
        v.ty = "i32";
    }
    v.ety = "int";
    return v;
}

CgVal cg_bf_read(Codegen* g, string baseptr, string sname, CgBF slot) {
    return cg_bf_promote(g, cg_bf_load(g, cg_bf_wordptr(g, baseptr, sname, slot), slot), slot);
}

void cg_bf_write(Codegen* g, string baseptr, string sname, CgBF slot, string rhsop) {
    cg_bf_store(g, cg_bf_wordptr(g, baseptr, sname, slot), slot, rhsop);
}

// An aggregate larger than this is zeroed by cg_zero_fill rather than by storing its
// zeroinitializer (clang expands that store element by element).
int cg_ll_big(Codegen* g, string llty) {
    return cg_ll_size_of(g, llty) > 4096 ? 1 : 0;
}

// Zero the `llty` storage at `slot` in one operation: llvm.memset, or a byte loop when
// freestanding (no C library to call). The size is the type's, computed by LLVM.
void cg_zero_fill(Codegen* g, string slot, string llty) {
    cg_zero_bytes(g, slot, cg_cat("ptrtoint (ptr getelementptr (", cg_cat(llty, ", ptr null, i32 1) to i64)")));
}

// Zero `sz` (an i64 operand) bytes at `slot`, the same two ways as cg_zero_fill.
void cg_zero_bytes(Codegen* g, string slot, string sz) {
    if (g.freestanding == 0) {
        cg_ensure_extern(g, "llvm.memset.p0.i64", "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n");
        cg_emit(g, "  call void @llvm.memset.p0.i64(ptr ");
        cg_emit(g, slot);
        cg_emit(g, ", i8 0, i64 ");
        cg_emit(g, sz);
        cg_emit(g, ", i1 false)\n");
        return;
    }
    string ctr = cg_entry_alloca(g, "i64");
    string head = cg_lbl(g);
    string body = cg_lbl(g);
    string done = cg_lbl(g);
    cg_emit(g, "  store i64 0, ptr ");
    cg_emit(g, ctr);
    cg_emit(g, "\n");
    cg_br(g, head);
    cg_label(g, head);
    string iv = cg_tmp(g);
    string cmp = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, iv);
    cg_emit(g, " = load i64, ptr ");
    cg_emit(g, ctr);
    cg_emit(g, "\n");
    cg_emit(g, "  ");
    cg_emit(g, cmp);
    cg_emit(g, " = icmp ult i64 ");
    cg_emit(g, iv);
    cg_emit(g, ", ");
    cg_emit(g, sz);
    cg_emit(g, "\n");
    cg_emit(g, "  br i1 ");
    cg_emit(g, cmp);
    cg_emit(g, ", label %");
    cg_emit(g, body);
    cg_emit(g, ", label %");
    cg_emit(g, done);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, body);
    string bp = cg_tmp(g);
    string nx = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, bp);
    cg_emit(g, " = getelementptr i8, ptr ");
    cg_emit(g, slot);
    cg_emit(g, ", i64 ");
    cg_emit(g, iv);
    cg_emit(g, "\n");
    cg_emit(g, "  store i8 0, ptr ");
    cg_emit(g, bp);
    cg_emit(g, "\n");
    cg_emit(g, "  ");
    cg_emit(g, nx);
    cg_emit(g, " = add i64 ");
    cg_emit(g, iv);
    cg_emit(g, ", 1\n");
    cg_emit(g, "  store i64 ");
    cg_emit(g, nx);
    cg_emit(g, ", ptr ");
    cg_emit(g, ctr);
    cg_emit(g, "\n");
    cg_br(g, head);
    cg_label(g, done);
}

void cg_struct_init(Codegen* g, string slot, string sname0, *ExprNode e0) {
    *ExprNode e = cg_with_defaults(g, e0);             // omitted fields take their defaults
    string sname = cg_dealias(g, sname0);                // `Alias{...}` of a struct alias fills the struct
    CgStruct s = cg_find_struct(g, sname);
    // Fields the literal omits are zero (C aggregate-initializer semantics), not whatever
    // the stack slot held: store the zero value first, then the given fields.
    string sty = cg_cat("%", s.name);
    if (cg_ll_big(g, sty) == 1) {
        cg_zero_fill(g, slot, sty);
    }
    else {
        cg_emit(g, "  store ");
        cg_emit(g, sty);
        cg_emit(g, " zeroinitializer, ptr ");
        cg_emit(g, slot);
        cg_emit(g, "\n");
    }
    int n = List_len<*ExprNode>(&e.kids);
    int i = 0;
    while (i < n) {
        string fname = List_get<string>(&e.names, i);
        int idx = i;                                    // positional by default
        if (fname[0] != 0) {
            idx = cg_field_idx(&s, fname);
        }
        string fety = "";
        if (idx >= 0 && idx < List_len<string>(&s.fetys)) {
            fety = List_get<string>(&s.fetys, idx);
        }
        string actual = fname;
        if (actual[0] == 0 && idx >= 0 && idx < List_len<string>(&s.fnames)) {
            actual = List_get<string>(&s.fnames, idx);
        }
        *ExprNode fex = List_get<*ExprNode>(&e.kids, i);
        CgBF bfslot = cg_bf(g, sname, actual);
        if (fex.kind == EK_ARRAYLIT) {                  // an array field's `{...}` fills it in place
            string ap = slot;
            if (bfslot.boffs >= 0) {
                ap = cg_bf_wordptr(g, slot, s.name, bfslot);
            }
            else if (cg_is_union(g, s.name) == 0) {
                int aidx = idx;
                if (bfslot.fidx >= 0) {
                    aidx = bfslot.fidx;
                }
                ap = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, ap);
                cg_emit(g, " = getelementptr inbounds %");
                cg_emit(g, s.name);
                cg_emit(g, ", ptr ");
                cg_emit(g, slot);
                cg_emit(g, ", i32 0, i32 ");
                cg_emit(g, cg_itoa(aidx));
                cg_emit(g, "\n");
            }
            cg_array_init(g, ap, fety, fex, 0);         // the struct is already zero
            i = i + 1;
            continue;
        }
        CgVal val = cg_expr(g, fex);
        if (bfslot.bw > 0) {                            // a bitfield member of this literal
            cg_bf_write(g, slot, s.name, bfslot, cg_coerce(g, val, bfslot.sty));
            i = i + 1;
            continue;
        }
        int gepidx = idx;   // normal field in a bf struct
        if (bfslot.fidx >= 0) {
            gepidx = bfslot.fidx;
        }
        string fp = "";
        if (bfslot.boffs >= 0) {
            fp = cg_bf_wordptr(g, slot, s.name, bfslot);
        }
        else if (cg_is_union(g, s.name) == 1) {   // a union's members start at offset 0
            fp = slot;
        }
        else {
            fp = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, fp);
            cg_emit(g, " = getelementptr inbounds %");
            cg_emit(g, s.name);
            cg_emit(g, ", ptr ");
            cg_emit(g, slot);
            cg_emit(g, ", i32 0, i32 ");
            cg_emit(g, cg_itoa(gepidx));
            cg_emit(g, "\n");
        }
        string flty = cg_lltype(g, fety);
        string fop = cg_coerce(g, val, flty);   // hoist: cg_coerce emits its own instr — must not interleave the store line
        if (cg_is_iface(g, cg_dealias(g, fety)) == 1) {
            fop = cg_iface_conv(g, fety, val, fex);
        }
        cg_emit(g, "  store ");
        cg_emit(g, flty);
        cg_emit(g, " ");
        cg_emit(g, fop);
        cg_emit(g, ", ptr ");
        cg_emit(g, fp);
        cg_emit(g, "\n");
        i = i + 1;
    }
}

// Evaluate a condition to an i1 operand (compare-to-zero if it isn't already i1).
CgVal cg_cond_val(Codegen* g, CgVal c);
CgVal cg_cond(Codegen* g, *ExprNode e) {
    return cg_cond_val(g, cg_expr(g, e));
}

// The truth value (i1) of an already evaluated operand.
CgVal cg_cond_val(Codegen* g, CgVal c0) {
    CgVal c = cg_iface_data(g, c0);
    if (cg_streq(c.ty, "i1") == 1) {
        return c;
    }
    string t = cg_tmp(g);
    if (cg_is_float(c.ty) == 1) {                          // float truthiness: une 0.0 (NaN is true)
        cg_emit(g, "  ");
        cg_emit(g, t);
        cg_emit(g, " = fcmp une ");
        cg_emit(g, c.ty);
        cg_emit(g, " ");
        cg_emit(g, c.op);
        cg_emit(g, ", 0.0\n");
        let rf: CgVal;
        rf.op = t;
        rf.ty = "i1";
        return rf;
    }
    string zero = "0";
    if (cg_streq(c.ty, "ptr") == 1) {   // pointer truthiness vs null
        zero = "null";
    }
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = icmp ne ");
    cg_emit(g, c.ty);
    cg_emit(g, " ");
    cg_emit(g, c.op);
    cg_emit(g, ", ");
    cg_emit(g, zero);
    cg_emit(g, "\n");
    let r: CgVal;
    r.op = t;
    r.ty = "i1";
    return r;
}

// An interface value `{data, vtable}` as its data pointer (null when the value is empty);
// any other value unchanged.
CgVal cg_iface_data(Codegen* g, CgVal c) {
    if (cg_streq(c.ty, "%iface_fat") == 0) {
        return c;
    }
    string t = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = extractvalue %iface_fat ");
    cg_emit(g, c.op);
    cg_emit(g, ", 0\n");
    let r: CgVal;
    r.op = t;
    r.ty = "ptr";
    r.ety = "*void";
    return r;
}

// The static type name of a thrown value, used for catch-clause strcmp matching.
string cg_throw_typename(Codegen* g, *ExprNode e) {
    if (e != null && e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_STRING) {
            return "string";
        }
        if (e.lit_kind == LIT_INT) {
            return "int";
        }
        if (e.lit_kind == LIT_BOOL) {
            return "bool";
        }
        if (e.lit_kind == LIT_CHAR) {
            return "char";
        }
    }
    string t = cg_etype(g, e);
    if (t[0] == 0) {
        return "unknown";
    }
    return t;
}

// The name a thrown value's type is matched by (a catch clause strcmp's it): the
// spelling under the active substitution, dealiased, without the `struct:` tag, a
// template instance mangled (`Box<int>` -> `Box_int`), and `int32` spelled `int`.
string cg_ex_typename(Codegen* g, string t) {
    t = cg_strip_nullable(t);
    t = cg_apply_sub(g, t);
    t = cg_dealias(g, t);
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0;
    int i = 0;
    int angle = 0;
    while (i < n) {
        if (i + 7 <= n && cg_streq(cg_sub_str(t, i, i + 7), "struct:") == 1) {
            i = i + 7;
            continue;
        }
        if ((int)t[i] == 60) {
            angle = 1;
        }
        buf[o] = (uint8)t[i];
        o = o + 1;
        i = i + 1;
    }
    buf[o] = 0;
    string r = (string)buf;
    if (angle == 1) {
        r = cg_mangle(r);
    }
    if (cg_streq(r, "int32") == 1) {
        return "int";
    }
    if (cg_streq(r, "uint32") == 1) {
        return "uint";
    }
    if (r[0] == 0) {
        return "unknown";
    }
    return r;
}

// Map an LLVM scalar type back to its Eskiu type name, for naming a thrown
// value whose Eskiu type could not be resolved structurally (e.g. `throw c + 1`,
// where the binary result carries only its LLVM type). "" if no clean mapping.
string cg_llty_eskiu_name(string llty) {
    if (cg_streq(llty, "i1") == 1) {
        return "bool";
    }
    if (cg_streq(llty, "i8") == 1) {
        return "char";
    }
    if (cg_streq(llty, "i16") == 1) {
        return "int16";
    }
    if (cg_streq(llty, "i32") == 1) {
        return "int";
    }
    if (cg_streq(llty, "i64") == 1) {
        return "int64";
    }
    if (cg_streq(llty, "float") == 1) {
        return "float";
    }
    if (cg_streq(llty, "double") == 1) {
        return "double";
    }
    return "";
}

// The C++ EH personality for the target: mingw's SEH one on Windows, else Itanium's
// (C++ CodeGen::ehPersonalityName).
string cg_eh_pers(Codegen* g) {
    if (g.wintgt == 1) {
        return "__gxx_personality_seh0";
    }
    return "__gxx_personality_v0";
}

// Does a statement subtree contain a `try`? (→ the function needs an EH personality.)
// Kind-aware: only recurses into the nested-statement fields each kind populates (an
// unset field is null, not a real subtree, so reading it would be wrong). Doesn't descend
// into expressions.
int cg_has_try_s(*StmtNode s) {
    if (s == null) {
        return 0;
    }
    if (s.kind == SK_TRY) {
        return 1;
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE
        || s.kind == SK_MATCH) {
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (cg_has_try_s(List_get<*StmtNode>(&s.items, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_DEFER) {
        if (cg_has_try_s(s.s1) == 1) {
            return 1;
        }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR) {
        if (cg_has_try_s(s.s2) == 1) {
            return 1;
        }
    }
    return 0;
}

int cg_has_extext_e(*ExprNode e) {
    if (e == null || e.kind == EK_LAMBDA) {
        return 0;
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_IDENT
        && ((cg_streq(e.a.sval, "exception_text") == 1 && List_len<*ExprNode>(&e.kids) == 0)
            || (cg_streq(e.a.sval, "__exception_text_into") == 1 && List_len<*ExprNode>(&e.kids) == 1))) {
        return 1;
    }
    if (cg_has_extext_e(e.a) == 1 || cg_has_extext_e(e.b) == 1) {
        return 1;
    }
    int i = 0;
    int n = List_len<*ExprNode>(&e.kids);
    while (i < n) {
        if (cg_has_extext_e(List_get<*ExprNode>(&e.kids, i)) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int cg_has_extext_s(*StmtNode s) {
    if (s == null) {
        return 0;
    }
    int k = s.kind;
    if (k == SK_TRY) {
        return cg_has_extext_s(s.s1) == 1 || cg_has_extext_s(s.s2) == 1 ? 1 : 0;
    }
    if (k == SK_VARDECL || k == SK_RETURN || k == SK_THROW || k == SK_EXPR || k == SK_THREADJOIN
        || k == SK_ASMOUTPUT || k == SK_ASMINPUT) {
        return cg_has_extext_e(s.expr);
    }
    if (k == SK_IF) {
        return cg_has_extext_e(s.expr) == 1 || cg_has_extext_s(s.s1) == 1 || cg_has_extext_s(s.s2) == 1 ? 1 : 0;
    }
    if (k == SK_WHILE || k == SK_DOWHILE || k == SK_FORIN) {
        return cg_has_extext_e(s.expr) == 1 || cg_has_extext_s(s.s1) == 1 ? 1 : 0;
    }
    if (k == SK_FOR) {
        return cg_has_extext_s(s.s1) == 1 || cg_has_extext_e(s.expr) == 1 || cg_has_extext_e(s.expr2) == 1 || cg_has_extext_s(s.s2) == 1 ? 1 : 0;
    }
    if (k == SK_BLOCK || k == SK_SWITCH || k == SK_CASE || k == SK_MATCH || k == SK_ASM) {
        if (cg_has_extext_e(s.expr) == 1) {
            return 1;
        }
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (cg_has_extext_s(List_get<*StmtNode>(&s.items, i)) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (k == SK_ARM || k == SK_CATCH || k == SK_DEFER) {
        return cg_has_extext_s(s.s1);
    }
    return 0;
}

// Emit a (possibly nested) array-literal initializer into `slot` of type `arrType`.
// `int[2][3] a = {{1,2,3},{4,5,6}}` recurses one dimension per `{...}` level; a short
// list zero-fills the rest. `do_zero` clears the whole aggregate once at the top level.
void cg_array_init(Codegen* g, string slot, string arrType0, *ExprNode lit, int do_zero) {
    string arrType = cg_dealias(g, arrType0);   // `type A3 = int[3]; A3 a = {...}`
    string ty = cg_lltype(g, arrType);
    string elemStr = cg_array_elem(arrType);
    string elemLl = cg_lltype(g, elemStr);
    int elemIsArr = cg_is_array(elemStr);
    if (do_zero == 1 && cg_ll_big(g, ty) == 1) {
        cg_zero_fill(g, slot, ty);
    }
    else if (do_zero == 1) {
        cg_emit(g, "  store ");
        cg_emit(g, ty);
        cg_emit(g, " zeroinitializer, ptr ");
        cg_emit(g, slot);
        cg_emit(g, "\n");
    }
    int i = 0;
    int n = List_len<*ExprNode>(&lit.kids);
    while (i < n) {
        *ExprNode el = List_get<*ExprNode>(&lit.kids, i);
        string gp = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, gp);
        cg_emit(g, " = getelementptr ");
        cg_emit(g, ty);
        cg_emit(g, ", ptr ");
        cg_emit(g, slot);
        cg_emit(g, ", i32 0, i32 ");
        cg_emit(g, cg_itoa(i));
        cg_emit(g, "\n");
        if (elemIsArr == 1 && el.kind == EK_ARRAYLIT) {
            cg_array_init(g, gp, elemStr, el, 0);       // outer zeroinit already covers this row
        } else {
            CgVal ev = cg_expr(g, el);
            string eop = cg_coerce(g, ev, elemLl);
            if (cg_is_iface(g, cg_dealias(g, elemStr)) == 1) {   // box `&s`
                eop = cg_iface_conv(g, elemStr, ev, el);
            }
            cg_emit(g, "  store ");
            cg_emit(g, elemLl);
            cg_emit(g, " ");
            cg_emit(g, eop);
            cg_emit(g, ", ptr ");
            cg_emit(g, gp);
            cg_emit(g, "\n");
        }
        i = i + 1;
    }
}

// Enter/leave a loop: push (or pop) this loop's continue target, break target, and the
// cleanup-stack depth at entry, keeping the three parallel lists in sync. `break` and
// `continue` read the innermost (last) entry.
void cg_loop_push(Codegen* g, string cont, string end, string label) {
    List_push<string>(&g.loop_cont, cont);
    List_push<string>(&g.loop_end, end);
    List_push<int>(&g.loop_cldepth, List_len<*StmtNode>(&g.cleanups));
    // Mirror onto the loops-only stack for labeled break/continue.
    string lbl = label;
    if (lbl == null) {
        lbl = "";
    }
    List_push<string>(&g.loop_lbls, lbl);
    List_push<string>(&g.loop_lbl_end, end);
    List_push<string>(&g.loop_lbl_cont, cont);
    List_push<int>(&g.loop_lbl_cld, List_len<*StmtNode>(&g.cleanups));
}

void cg_loop_pop(Codegen* g) {
    List_remove<string>(&g.loop_cont, List_len<string>(&g.loop_cont) - 1);
    List_remove<string>(&g.loop_end, List_len<string>(&g.loop_end) - 1);
    List_remove<int>(&g.loop_cldepth, List_len<int>(&g.loop_cldepth) - 1);
    List_remove<string>(&g.loop_lbls, List_len<string>(&g.loop_lbls) - 1);
    List_remove<string>(&g.loop_lbl_end, List_len<string>(&g.loop_lbl_end) - 1);
    List_remove<string>(&g.loop_lbl_cont, List_len<string>(&g.loop_lbl_cont) - 1);
    List_remove<int>(&g.loop_lbl_cld, List_len<int>(&g.loop_lbl_cld) - 1);
}
