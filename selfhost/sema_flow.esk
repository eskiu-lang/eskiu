// Part of sema.esk (definite return and -Wall flow checks), imported from it in order; compile sema.esk, not this file alone.

// ── Definite-return analysis (mirrors sema/typecheck_decl.cpp) ───────────────
// A non-void function must return, throw, or provably diverge on every path;
// falling off the end is an error, not an implicit zero return.

// Is `c` a literal that is always true? (`while(1)`, `while(true)`, `for(;;)`)
int sema_cond_true(*ExprNode c) {
    if (c == null) {                       // for(;;)
        return 1;
    }
    if (c.kind != EK_LITERAL) {
        return 0;
    }
    if (c.lit_kind == LIT_BOOL) {
        return sema_streq(c.sval, "true");
    }
    if (c.lit_kind == LIT_INT) {
        if (sema_streq(c.sval, "0") == 1) {
            return 0;
        }
        return 1;
    }
    return 0;
}

int sema_can_complete(*StmtNode s);

// Label text of a loop/jump node ("" when unlabeled).
string sema_lbl(*StmtNode s) {
    if (s.label == null) {
        return "";
    }
    return s.label;
}

// Does `s` hold a `break` (or, with want_cont, a `continue`) that transfers to the loop or
// switch enclosing it, labeled `label` ("" for none / a switch)? `inner` = inside a nested
// loop/switch, where an unlabeled jump binds there instead; a labeled jump naming `label`
// reaches from any depth. Mirrors the C++ jumpsTo.
int sema_jumps_to(*StmtNode s, string label, int want_cont, int inner) {
    if (s == null) {
        return 0;
    }
    int k = s.kind;
    if (k == SK_BREAK || k == SK_CONTINUE) {
        if ((k == SK_CONTINUE) != (want_cont == 1)) {
            return 0;
        }
        string l = sema_lbl(s);
        if (l[0] == 0) {
            if (inner == 0) {
                return 1;
            }
            return 0;
        }
        if (label[0] != 0 && sema_streq(l, label) == 1) {
            return 1;
        }
        return 0;
    }
    if (k == SK_BLOCK) {
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (sema_jumps_to(List_get<*StmtNode>(&s.items, i), label, want_cont, inner) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (k == SK_IF) {
        if (sema_jumps_to(s.s1, label, want_cont, inner) == 1) {
            return 1;
        }
        return sema_jumps_to(s.s2, label, want_cont, inner);
    }
    if (k == SK_WHILE || k == SK_DOWHILE || k == SK_FORIN) {
        return sema_jumps_to(s.s1, label, want_cont, 1);
    }
    if (k == SK_FOR) {
        return sema_jumps_to(s.s2, label, want_cont, 1);
    }
    if (k == SK_SWITCH) {                               // captures an unlabeled break, not a continue
        int in2 = 1;
        if (want_cont == 1) {
            in2 = inner;
        }
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&s.items, i);
            int j = 0;
            int m = List_len<*StmtNode>(&c.items);
            while (j < m) {
                if (sema_jumps_to(List_get<*StmtNode>(&c.items, j), label, want_cont, in2) == 1) {
                    return 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (k == SK_MATCH) {                                // match is not a jump target
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (sema_jumps_to(List_get<*StmtNode>(&s.items, i).s1, label, want_cont, inner) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (k == SK_TRY) {
        if (sema_jumps_to(s.s1, label, want_cont, inner) == 1) {
            return 1;
        }
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (sema_jumps_to(List_get<*StmtNode>(&s.items, i).s1, label, want_cont, inner) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return sema_jumps_to(s.s2, label, want_cont, inner);
    }
    return 0;
}

// Can executing `s` fall through to the next statement? Conservative: unsure means yes.
// Mirrors the C++ canCompleteNormally.
int sema_can_complete(*StmtNode s) {
    if (s == null) {
        return 1;
    }
    int k = s.kind;
    if (k == SK_RETURN || k == SK_THROW || k == SK_BREAK || k == SK_CONTINUE) {
        return 0;
    }
    if (k == SK_BLOCK) {
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (sema_can_complete(List_get<*StmtNode>(&s.items, i)) == 0) {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }
    if (k == SK_IF) {
        if (s.s2 == null) {
            return 1;
        }
        if (sema_can_complete(s.s1) == 1) {
            return 1;
        }
        return sema_can_complete(s.s2);
    }
    if (k == SK_WHILE) {
        if (sema_cond_true(s.expr) == 0) {
            return 1;
        }
        return sema_jumps_to(s.s1, sema_lbl(s), 0, 0);
    }
    if (k == SK_FOR) {                                  // body is s2 (s1 is init)
        if (sema_cond_true(s.expr) == 0) {
            return 1;
        }
        return sema_jumps_to(s.s2, sema_lbl(s), 0, 0);
    }
    if (k == SK_DOWHILE) {                              // body runs at least once
        if (sema_jumps_to(s.s1, sema_lbl(s), 0, 0) == 1) {
            return 1;
        }
        int reaches = sema_can_complete(s.s1);
        if (reaches == 0) {
            reaches = sema_jumps_to(s.s1, sema_lbl(s), 1, 0);
        }
        if (reaches == 1 && sema_cond_true(s.expr) == 0) {
            return 1;
        }
        return 0;
    }
    if (k == SK_FORIN) {                    // may iterate zero times
        return 1;
    }
    if (k == SK_SWITCH) {                               // cases fall through in order
        int n = List_len<*StmtNode>(&s.items);
        int has_default = 0;
        int i = 0;
        while (i < n) {
            if (List_get<*StmtNode>(&s.items, i).expr == null) {
                has_default = 1;
            }
            i = i + 1;
        }
        if (has_default == 0 || n == 0) {
            return 1;
        }
        i = 0;
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&s.items, i);
            int j = 0;
            int m = List_len<*StmtNode>(&c.items);
            while (j < m) {
                if (sema_jumps_to(List_get<*StmtNode>(&c.items, j), "", 0, 0) == 1) {
                    return 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        *StmtNode last = List_get<*StmtNode>(&s.items, n - 1);
        int j = 0;
        int m = List_len<*StmtNode>(&last.items);
        while (j < m) {
            if (sema_can_complete(List_get<*StmtNode>(&last.items, j)) == 0) {
                return 0;
            }
            j = j + 1;
        }
        return 1;
    }
    if (k == SK_MATCH) {                                // exhaustiveness checked separately
        int n = List_len<*StmtNode>(&s.items);
        if (n == 0) {
            return 1;
        }
        int i = 0;
        while (i < n) {
            if (sema_can_complete(List_get<*StmtNode>(&s.items, i).s1) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (k == SK_TRY) {
        if (s.s2 != null && sema_can_complete(s.s2) == 0) {
            return 0;
        }
        if (sema_can_complete(s.s1) == 1) {
            return 1;
        }
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            if (sema_can_complete(List_get<*StmtNode>(&s.items, i).s1) == 1) {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    return 1;
}

int sema_always_returns(*StmtNode s) {
    if (sema_can_complete(s) == 1) {
        return 0;
    }
    return 1;
}

// Check a function/method body: a fresh scope with the params (and `self` for
// methods) defined, then walk the body.
// Remove the first occurrence of `name` from a string list (used by the uninit scan).
void sema_list_erase(List<string>* l, string name) {
    int i = 0;
    int n = List_len<string>(l);
    while (i < n) {
        if (sema_streq(List_get<string>(l, i), name) == 1) {
            List_remove<string>(l, i);
            return;
        }
        i = i + 1;
    }
}

// Scan an expression for a read of a still-uninitialized scalar. `&x` counts as
// initializing x (its address may be written through), not a read.
void sema_uninit_scan(Sema* s, *ExprNode e, List<string>* uninit) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        sema_list_erase(uninit, e.a.sval);
        return;
    }
    // An assignment (also nested: `x = y = 3`, `let y = (x = 5)`) writes its target after
    // evaluating the value; the target itself is not read.
    if (e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1) {
        sema_uninit_scan(s, e.b, uninit);
        if (e.a != null && e.a.kind == EK_IDENT) {
            sema_list_erase(uninit, e.a.sval);
        }
        else {
            sema_uninit_scan(s, e.a, uninit);
        }
        return;
    }
    if (e.kind == EK_IDENT) {
        if (sema_in_list(uninit, e.sval) == 1) {
            s.had_error = 1;
            int ul = s.line;
            int uc = s.col;
            if (e.line > 0) {   // at the read, not the function header
                ul = e.line;
                uc = e.col;
            }
            dprintf(2, "error: %s:%d:%d: use of uninitialized variable '%s'\n", s.filename, ul, uc, e.sval);
            sema_list_erase(uninit, e.sval);       // report once
        }
        return;
    }
    // Recurse ONLY into the child fields each kind populates. alloc zeroes, so an unset
    // field is null (not garbage), but reading a child a kind never sets is still a wrong
    // answer. Mirrors the proven kind-aware walker `cg_collect_idents_e`; note
    // EK_TEMPLATECALL keeps its callee in `sval`, not `a`, so `a` must NOT be read for it.
    if (e.kind == EK_BINARY || e.kind == EK_INDEX) {
        sema_uninit_scan(s, e.a, uninit);
        sema_uninit_scan(s, e.b, uninit);
    }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
             || e.kind == EK_QUESTION || e.kind == EK_AWAIT || e.kind == EK_CALL
             || e.kind == EK_INCDEC) {
        sema_uninit_scan(s, e.a, uninit);
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX) {
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            sema_uninit_scan(s, List_get<*ExprNode>(&e.kids, i), uninit);
            i = i + 1;
        }
    }
    if (e.kind == EK_TERNARY) {
        sema_uninit_scan(s, e.a, uninit);
        sema_uninit_scan(s, e.b, uninit);
        sema_uninit_scan(s, List_get<*ExprNode>(&e.kids, 0), uninit);
    }
}

// Conservative straight-line scan of a function body for reads of an uninitialized scalar
// local, stopping at the first control-flow statement (mirrors C++ checkUninitPrefix).
// Only genuine scalars are tracked: an array ends in ']' (element writes initialize it
// piecewise), as are structs, unions, slices and interface values (mirrors the C++
// isUninitScalar).
int sema_uninit_scalar(Sema* s, string ty) {
    string t = sema_dealias(s, sema_isub(s, ty));
    *DeclNode ed = sema_find_tdecl(s, sema_strip_const(t));   // a classic enum is an int
    if (ed != null && ed.kind == DK_ENUM && sema_is_plain_enum_decl(ed) == 1) {
        return 1;
    }
    return sema_is_arr_ty(t) == 0 && (sema_is_numeric_ty(t) == 1 || sema_is_ptrish(t) == 1 || sema_is_fn_type(t) == 1);
}

// Returns 1 when it reported a read.
int sema_check_uninit(Sema* s, *StmtNode body) {
    if (body == null || body.kind != SK_BLOCK) {
        return 0;
    }
    int had = s.had_error;
    s.had_error = 0;
    List<string> uninit;
    List_init<string>(&uninit, 4);
    int i = 0;
    int n = List_len<*StmtNode>(&body.items);
    while (i < n) {
        *StmtNode it = List_get<*StmtNode>(&body.items, i);
        i = i + 1;
        if (it.kind == SK_VARDECL) {
            if (it.expr != null) {
                sema_uninit_scan(s, it.expr, &uninit);
                sema_list_erase(&uninit, it.name);
            }
            else if (it.is_static == 1) {   // static storage starts at zero (C)
                sema_list_erase(&uninit, it.name);
            }
            else if (sema_uninit_scalar(s, it.type) == 1) {   // a generic instance's `T x` too
                List_push<string>(&uninit, it.name);
            }
        } else if (it.kind == SK_EXPR) {
            sema_uninit_scan(s, it.expr, &uninit);
        } else if (it.kind == SK_RETURN) {
            if (it.expr != null) {
                sema_uninit_scan(s, it.expr, &uninit);
            }
        } else {
            i = n;                                 // control flow / anything else: stop (conservative)
        }
    }
    int reported = s.had_error;
    if (had == 1) {
        s.had_error = 1;
    }
    return reported;
}

// ── -Wall: maybe-uninitialized reads (mirrors the C++ MaybeUninit, typecheck_decl.cpp) ──
// A forward "possibly unassigned" dataflow over a function body. The state is the set of
// tracked locals (scalar locals declared without an initializer) that some path to this
// point has not assigned; paths meet by union, and a read of one is a warning. `=` to the
// bare name and `&x` assign it. Unreachable code reads nothing. A loop body starts from
// the state before the loop and the loop exits with its condition-false state joined
// with every `break` to it; `switch` cases fall through; a `match` arm, a `catch` and a
// `finally` start from the state before the construct; a `defer` body runs at each exit;
// a lambda reads its captures when it is created. Variables are keyed by declaration.
struct MuSt {     // u[id] == 1: local id is unassigned on some path
    int live;
    List<int> u;
}

struct MuFrame {
    int is_loop;
    string label;
    int defer_depth;
    *MuSt brk;
    *MuSt cont;
}

struct Mu {
    Sema* sm;
    *MuSt s;
    int next_id;
    List<string> env_n;         // bindings in scope, innermost last ...
    List<int> env_id;           // ... and their ids
    List<int> scope_env;        // per open scope: env length at its start
    List<*StmtNode> dfr;        // pending defer bodies, in registration order ...
    List<int> dfr_scope;        // ... and the scope each belongs to
    List<*MuFrame> frames;
    List<int> warned;           // ids already reported
    int in_defer;
}

*MuSt mu_st(int live) {
    *MuSt r = alloc<MuSt>(1);
    r.live = live;
    List_init<int>(&r.u, 8);
    return r;
}

int mu_has(*MuSt st, int id) {
    if (id < 0 || id >= List_len<int>(&st.u)) {
        return 0;
    }
    return List_get<int>(&st.u, id);
}

void mu_put(*MuSt st, int id, int v) {
    while (List_len<int>(&st.u) <= id) {
        List_push<int>(&st.u, 0);
    }
    List_set<int>(&st.u, id, v);
}

// dst = src (a copy).
void mu_assign(*MuSt dst, *MuSt src) {
    dst.live = src.live;
    List_clear<int>(&dst.u);
    int i = 0;
    while (i < List_len<int>(&src.u)) {
        List_push<int>(&dst.u, List_get<int>(&src.u, i));
        i = i + 1;
    }
}

*MuSt mu_copy(*MuSt src) {
    *MuSt r = mu_st(1);
    mu_assign(r, src);
    return r;
}

// into = into joined with other (a dead path adds nothing).
void mu_join(*MuSt into, *MuSt other) {
    if (other.live == 0) {
        return;
    }
    if (into.live == 0) {
        mu_assign(into, other);
        return;
    }
    int i = 0;
    while (i < List_len<int>(&other.u)) {
        if (List_get<int>(&other.u, i) == 1) {
            mu_put(into, i, 1);
        }
        i = i + 1;
    }
}

void mu_push_scope(Mu* m) {
    List_push<int>(&m.scope_env, List_len<string>(&m.env_n));
}

void mu_pop_scope(Mu* m) {
    int top = List_len<int>(&m.scope_env) - 1;
    int start = List_get<int>(&m.scope_env, top);
    while (List_len<string>(&m.env_n) > start) {
        int last = List_len<string>(&m.env_n) - 1;
        mu_put(m.s, List_get<int>(&m.env_id, last), 0);
        List_remove<string>(&m.env_n, last);
        List_remove<int>(&m.env_id, last);
    }
    while (List_len<int>(&m.dfr_scope) > 0 && List_get<int>(&m.dfr_scope, List_len<int>(&m.dfr_scope) - 1) >= top) {
        List_remove<*StmtNode>(&m.dfr, List_len<*StmtNode>(&m.dfr) - 1);
        List_remove<int>(&m.dfr_scope, List_len<int>(&m.dfr_scope) - 1);
    }
    List_remove<int>(&m.scope_env, top);
}

void mu_declare(Mu* m, string name, int tracked) {
    int id = m.next_id;
    m.next_id = m.next_id + 1;
    List_push<string>(&m.env_n, name);
    List_push<int>(&m.env_id, id);
    if (tracked == 1) {
        mu_put(m.s, id, 1);
    }
}

int mu_lookup(Mu* m, string name) {
    int i = List_len<string>(&m.env_n) - 1;
    while (i >= 0) {
        if (sema_streq(List_get<string>(&m.env_n, i), name) == 1) {
            return List_get<int>(&m.env_id, i);
        }
        i = i - 1;
    }
    return -1;
}

void mu_assign_name(Mu* m, string name) {
    int id = mu_lookup(m, name);
    if (id >= 0) {
        mu_put(m.s, id, 0);
    }
}

void mu_read(Mu* m, string name, int line, int col) {
    int v = mu_lookup(m, name);
    if (v < 0 || m.s.live == 0 || mu_has(m.s, v) == 0) {
        return;
    }
    while (List_len<int>(&m.warned) <= v) {
        List_push<int>(&m.warned, 0);
    }
    if (List_get<int>(&m.warned, v) == 1) {
        return;
    }
    List_set<int>(&m.warned, v, 1);
    Sema* s = m.sm;
    string key = sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(s.filename, ":"), sema_i64_text((int64)line)), ":"),
                          sema_i64_text((int64)col)), ":"), name);
    if (StrTab_has(&s.mu_warned, key) == 1) {
        return;
    }
    StrTab_set(&s.mu_warned, key, 1);
    sema_lint(s, line, col, sema_cat(sema_cat("variable '", name), "' may be used uninitialized"));
}

void mu_stmt(Mu* m, *StmtNode st);

// Run the pending defer bodies of scopes [from, end), innermost first, on a copy of the
// state (they run on the way out). A defer body is not re-entered.
void mu_run_defers(Mu* m, int from) {
    if (m.s.live == 0 || m.in_defer == 1) {
        return;
    }
    *MuSt saved = mu_copy(m.s);
    m.in_defer = 1;
    List<*StmtNode> run;
    List_init<*StmtNode>(&run, 4);
    int i = List_len<*StmtNode>(&m.dfr) - 1;
    while (i >= 0) {
        if (List_get<int>(&m.dfr_scope, i) >= from) {
            List_push<*StmtNode>(&run, List_get<*StmtNode>(&m.dfr, i));
        }
        i = i - 1;
    }
    i = 0;
    while (i < List_len<*StmtNode>(&run)) {
        mu_stmt(m, List_get<*StmtNode>(&run, i));
        i = i + 1;
    }
    m.in_defer = 0;
    mu_assign(m.s, saved);
}

// The defers of the innermost scope, at its normal end.
void mu_run_scope_defers(Mu* m) {
    if (m.s.live == 0 || m.in_defer == 1) {
        return;
    }
    m.in_defer = 1;
    int top = List_len<int>(&m.scope_env) - 1;
    List<*StmtNode> run;
    List_init<*StmtNode>(&run, 4);
    int i = List_len<*StmtNode>(&m.dfr) - 1;
    while (i >= 0) {
        if (List_get<int>(&m.dfr_scope, i) == top) {
            List_push<*StmtNode>(&run, List_get<*StmtNode>(&m.dfr, i));
        }
        i = i - 1;
    }
    i = 0;
    while (i < List_len<*StmtNode>(&run)) {
        mu_stmt(m, List_get<*StmtNode>(&run, i));
        i = i + 1;
    }
    m.in_defer = 0;
}

int mu_logical(string op) {
    return sema_streq(op, "&&") == 1 || sema_streq(op, "||") == 1;
}

void mu_expr(Mu* m, *ExprNode e);

// Evaluate condition `e`, leaving in `on_t` / `on_f` the state on the paths where it is
// true / false (`&&`, `||` and `!` split it).
void mu_cond(Mu* m, *ExprNode e, *MuSt on_t, *MuSt on_f) {
    if (e != null && e.kind == EK_UNARY && sema_streq(e.sval, "!") == 1) {
        mu_cond(m, e.a, on_f, on_t);
        return;
    }
    if (e == null || e.kind != EK_BINARY || mu_logical(e.sval) == 0) {
        mu_expr(m, e);
        mu_assign(on_t, m.s);
        mu_assign(on_f, m.s);
        return;
    }
    int is_and = sema_streq(e.sval, "&&");
    List<*ExprNode> spine;
    List_init<*ExprNode>(&spine, 4);
    List_push<*ExprNode>(&spine, e);
    while (1 == 1) {
        *ExprNode l = List_get<*ExprNode>(&spine, List_len<*ExprNode>(&spine) - 1).a;
        if (l == null || l.kind != EK_BINARY || sema_streq(l.sval, e.sval) == 0) {
            break;
        }
        List_push<*ExprNode>(&spine, l);
    }
    *MuSt t = mu_st(1);
    *MuSt f = mu_st(1);
    mu_cond(m, List_get<*ExprNode>(&spine, List_len<*ExprNode>(&spine) - 1).a, t, f);
    int i = List_len<*ExprNode>(&spine) - 1;
    while (i >= 0) {
        if (is_and == 1) {
            mu_assign(m.s, t);
        } else {
            mu_assign(m.s, f);
        }
        *MuSt rt = mu_st(1);
        *MuSt rf = mu_st(1);
        mu_cond(m, List_get<*ExprNode>(&spine, i).b, rt, rf);
        if (is_and == 1) {
            mu_assign(t, rt);
            mu_join(f, rf);
        }
        else {
            mu_join(t, rt);
            mu_assign(f, rf);
        }
        i = i - 1;
    }
    mu_assign(on_t, t);
    mu_assign(on_f, f);
    mu_assign(m.s, on_t);
    mu_join(m.s, on_f);
}

void mu_function(Mu* m, List<string>* params, *StmtNode body);

// A lambda body is a function of its own, analyzed in a fresh context.
void mu_lambda(Mu* m, *ExprNode e) {
    *MuSt saved_s = m.s;
    List<string> saved_n = m.env_n;
    List<int> saved_id = m.env_id;
    List<int> saved_sc = m.scope_env;
    List<*StmtNode> saved_d = m.dfr;
    List<int> saved_ds = m.dfr_scope;
    List<*MuFrame> saved_f = m.frames;
    List_init<string>(&m.env_n, 4);
    List_init<int>(&m.env_id, 4);
    List_init<int>(&m.scope_env, 4);
    List_init<*StmtNode>(&m.dfr, 2);
    List_init<int>(&m.dfr_scope, 2);
    List_init<*MuFrame>(&m.frames, 2);
    m.s = mu_st(1);
    List<string> ptys;
    List_init<string>(&ptys, 4);
    List<string> pnames;
    List_init<string>(&pnames, 4);
    sema_lambda_sig(e.sval, &ptys, &pnames);
    mu_function(m, &pnames, e.stmt);
    m.env_n = saved_n;
    m.env_id = saved_id;
    m.scope_env = saved_sc;
    m.dfr = saved_d;
    m.dfr_scope = saved_ds;
    m.frames = saved_f;
    m.s = saved_s;
}

void mu_kids(Mu* m, *ExprNode e) {
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        mu_expr(m, List_get<*ExprNode>(&e.kids, i));
        i = i + 1;
    }
}

void mu_expr(Mu* m, *ExprNode e) {
    if (e == null) {
        return;
    }
    int k = e.kind;
    if (k == EK_IDENT) {
        mu_read(m, e.sval, e.line, e.col);
        return;
    }
    if (k == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        mu_assign_name(m, e.a.sval);
        return;
    }
    if (k == EK_SIZEOF) {                // not evaluated
        return;
    }
    if (k == EK_BINARY) {
        if (sema_streq(e.sval, "=") == 1) {
            mu_expr(m, e.b);
            if (e.a != null && e.a.kind == EK_IDENT) {
                mu_assign_name(m, e.a.sval);
            } else {
                mu_expr(m, e.a);
            }
            return;
        }
        if (mu_logical(e.sval) == 1) {             // what follows sees the join of both outcomes
            *MuSt t = mu_st(1);
            *MuSt f = mu_st(1);
            mu_cond(m, e, t, f);
            mu_assign(m.s, t);
            mu_join(m.s, f);
            return;
        }
        // A left-leaning operator chain is walked down its left spine by a loop.
        List<*ExprNode> spine;
        List_init<*ExprNode>(&spine, 4);
        List_push<*ExprNode>(&spine, e);
        while (1 == 1) {
            *ExprNode l = List_get<*ExprNode>(&spine, List_len<*ExprNode>(&spine) - 1).a;
            if (l == null || l.kind != EK_BINARY || sema_streq(l.sval, "=") == 1 || mu_logical(l.sval) == 1) {
                break;
            }
            List_push<*ExprNode>(&spine, l);
        }
        mu_expr(m, List_get<*ExprNode>(&spine, List_len<*ExprNode>(&spine) - 1).a);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            mu_expr(m, List_get<*ExprNode>(&spine, i).b);
            i = i - 1;
        }
        return;
    }
    if (k == EK_TERNARY) {
        *MuSt before = mu_st(1);
        *MuSt else_st = mu_st(1);
        mu_cond(m, e.a, before, else_st);
        mu_assign(m.s, before);
        mu_expr(m, e.b);
        *MuSt a = mu_copy(m.s);
        mu_assign(m.s, else_st);
        if (List_len<*ExprNode>(&e.kids) > 0) {
            mu_expr(m, List_get<*ExprNode>(&e.kids, 0));
        }
        mu_join(m.s, a);
        return;
    }
    if (k == EK_QUESTION) {   // `?` may return from here
        mu_expr(m, e.a);
        mu_run_defers(m, 0);
        return;
    }
    if (k == EK_LAMBDA) {
        Sema* s = m.sm;                            // its captures are read when it is created
        List<string> caps;
        List_init<string>(&caps, 4);
        int i = 0;
        while (i < List_len<*ExprNode>(&s.cap_lams)) {
            if (List_get<*ExprNode>(&s.cap_lams, i) == e) {
                List_push<string>(&caps, List_get<string>(&s.cap_names, i));
            }
            i = i + 1;
        }
        int n = List_len<string>(&caps);
        int a = 1;                                 // in name order (the C++ capture map)
        while (a < n) {
            string v = List_get<string>(&caps, a);
            int b = a - 1;
            while (b >= 0 && strcmp(List_get<string>(&caps, b), v) > 0) {
                List_set<string>(&caps, b + 1, List_get<string>(&caps, b));
                b = b - 1;
            }
            List_set<string>(&caps, b + 1, v);
            a = a + 1;
        }
        i = 0;
        while (i < n) {
            mu_read(m, List_get<string>(&caps, i), e.line, e.col);
            i = i + 1;
        }
        mu_lambda(m, e);
        return;
    }
    if (k == EK_INDEX) {
        mu_expr(m, e.a);
        mu_expr(m, e.b);
        if (List_len<*ExprNode>(&e.kids) > 0) {
            mu_expr(m, List_get<*ExprNode>(&e.kids, 0));
        }
        return;
    }
    if (k == EK_CALL) {
        mu_expr(m, e.a);
        mu_kids(m, e);
        return;
    }
    if (k == EK_TEMPLATECALL || k == EK_STRUCTINIT || k == EK_ARRAYLIT) {
        mu_kids(m, e);
        return;
    }
    if (k == EK_ALLOCWITH) {
        mu_expr(m, e.a);
        mu_expr(m, e.b);
        return;
    }
    if (k == EK_UNARY || k == EK_INCDEC || k == EK_MEMBER || k == EK_CAST || k == EK_AWAIT
        || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        mu_expr(m, e.a);
        return;
    }
}

// A statement in its own scope (a block, or an unbraced body).
void mu_block(Mu* m, *StmtNode body) {
    mu_push_scope(m);
    if (body != null && body.kind == SK_BLOCK) {
        int i = 0;
        while (i < List_len<*StmtNode>(&body.items)) {
            mu_stmt(m, List_get<*StmtNode>(&body.items, i));
            i = i + 1;
        }
    } else {
        mu_stmt(m, body);
    }
    mu_run_scope_defers(m);
    mu_pop_scope(m);
}

void mu_jump(Mu* m, string label, int is_cont) {
    int i = List_len<*MuFrame>(&m.frames) - 1;
    while (i >= 0) {
        *MuFrame f = List_get<*MuFrame>(&m.frames, i);
        int skip = 0;
        if (label != null && label[0] != 0) {
            if (f.is_loop == 0 || sema_streq(f.label, label) == 0) {
                skip = 1;
            }
        }
        else if (is_cont == 1 && f.is_loop == 0) {
            skip = 1;
        }
        if (skip == 0) {
            mu_run_defers(m, f.defer_depth);
            if (is_cont == 1) {
                mu_join(f.cont, m.s);
            } else {
                mu_join(f.brk, m.s);
            }
            break;
        }
        i = i - 1;
    }
    m.s.live = 0;
}

void mu_push_frame(Mu* m, int is_loop, string label) {
    *MuFrame f = alloc<MuFrame>(1);
    f.is_loop = is_loop;
    f.label = label;
    if (f.label == null) {
        f.label = "";
    }
    f.defer_depth = List_len<int>(&m.scope_env);
    f.brk = mu_st(0);
    f.cont = mu_st(0);
    List_push<*MuFrame>(&m.frames, f);
}

*MuFrame mu_pop_frame(Mu* m) {
    int n = List_len<*MuFrame>(&m.frames);
    *MuFrame f = List_get<*MuFrame>(&m.frames, n - 1);
    List_remove<*MuFrame>(&m.frames, n - 1);
    return f;
}

*MuFrame mu_top_frame(Mu* m) {
    return List_get<*MuFrame>(&m.frames, List_len<*MuFrame>(&m.frames) - 1);
}

void mu_stmt(Mu* m, *StmtNode st) {
    if (st == null) {
        return;
    }
    int k = st.kind;
    Sema* s = m.sm;
    if (k == SK_BLOCK) {
        mu_block(m, st);
        return;
    }
    if (k == SK_VARDECL) {
        mu_expr(m, st.expr);
        int tracked = 0;
        if (st.expr == null && st.is_static == 0 && sema_uninit_scalar(s, st.type) == 1) {
            tracked = 1;
        }
        mu_declare(m, st.name, tracked);
        return;
    }
    if (k == SK_EXPR) {
        mu_expr(m, st.expr);
        return;
    }
    if (k == SK_RETURN) {
        mu_expr(m, st.expr);
        mu_run_defers(m, 0);
        m.s.live = 0;
        return;
    }
    if (k == SK_THROW) {
        mu_expr(m, st.expr);
        m.s.live = 0;
        return;
    }
    if (k == SK_BREAK) {
        mu_jump(m, st.label, 0);
        return;
    }
    if (k == SK_CONTINUE) {
        mu_jump(m, st.label, 1);
        return;
    }
    if (k == SK_DEFER) {
        if (m.s.live == 1) {
            List_push<*StmtNode>(&m.dfr, st.s1);
            List_push<int>(&m.dfr_scope, List_len<int>(&m.scope_env) - 1);
        }
        return;
    }
    if (k == SK_ASM) {
        int i = 0;
        while (i < List_len<*StmtNode>(&st.items)) {
            *StmtNode op = List_get<*StmtNode>(&st.items, i);
            if (op.kind == SK_ASMINPUT) {
                mu_expr(m, op.expr);
            }
            i = i + 1;
        }
        return;
    }
    if (k == SK_THREADJOIN) {
        mu_expr(m, st.expr);
        return;
    }
    if (k == SK_IF) {                              // an `else if` chain is walked with a loop
        *MuSt out = mu_st(0);
        *StmtNode n = st;
        while (n != null) {
            *MuSt then_st = mu_st(1);
            *MuSt else_st = mu_st(1);
            mu_cond(m, n.expr, then_st, else_st);
            mu_assign(m.s, then_st);
            mu_block(m, n.s1);
            mu_join(out, m.s);
            mu_assign(m.s, else_st);
            *StmtNode next = null;
            if (n.s2 != null && n.s2.kind == SK_IF) {
                next = n.s2;
            }
            if (next == null) {
                if (n.s2 != null) {
                    mu_block(m, n.s2);
                }
                mu_join(out, m.s);
            }
            n = next;
        }
        mu_assign(m.s, out);
        return;
    }
    if (k == SK_WHILE) {
        *MuSt body_st = mu_st(1);
        *MuSt exit_st = mu_st(1);
        mu_cond(m, st.expr, body_st, exit_st);
        mu_assign(m.s, body_st);
        *MuSt ex = exit_st;
        if (sema_cond_true(st.expr) == 1) {
            ex = mu_st(0);
        }
        mu_push_frame(m, 1, st.label);
        mu_block(m, st.s1);
        *MuFrame f = mu_pop_frame(m);
        mu_assign(m.s, ex);
        mu_join(m.s, f.brk);
        return;
    }
    if (k == SK_DOWHILE) {
        mu_push_frame(m, 1, st.label);
        mu_block(m, st.s1);
        mu_join(m.s, mu_top_frame(m).cont);
        mu_expr(m, st.expr);
        *MuFrame f = mu_pop_frame(m);
        if (sema_cond_true(st.expr) == 1) {
            m.s.live = 0;
        }
        mu_join(m.s, f.brk);
        return;
    }
    if (k == SK_FOR) {
        mu_push_scope(m);
        if (st.s1 != null && st.s1.kind == SK_BLOCK) {   // the init's declarations belong to the loop
            int i = 0;
            while (i < List_len<*StmtNode>(&st.s1.items)) {
                mu_stmt(m, List_get<*StmtNode>(&st.s1.items, i));
                i = i + 1;
            }
        } else {
            mu_stmt(m, st.s1);
        }
        *MuSt body_st = mu_st(1);
        *MuSt exit_st = mu_st(1);
        if (st.expr != null) {
            mu_cond(m, st.expr, body_st, exit_st);
        }
        else {
            mu_assign(body_st, m.s);
            mu_assign(exit_st, m.s);
        }
        mu_assign(m.s, body_st);
        *MuSt ex = exit_st;
        if (sema_cond_true(st.expr) == 1) {
            ex = mu_st(0);
        }
        mu_push_frame(m, 1, st.label);
        mu_block(m, st.s2);
        mu_join(m.s, mu_top_frame(m).cont);
        mu_expr(m, st.expr2);
        *MuFrame fr = mu_pop_frame(m);
        mu_assign(m.s, ex);
        mu_join(m.s, fr.brk);
        mu_pop_scope(m);
        return;
    }
    if (k == SK_FORIN) {
        mu_expr(m, st.expr);
        *MuSt ex = mu_copy(m.s);
        mu_push_scope(m);
        mu_declare(m, st.name, 0);
        mu_push_frame(m, 1, st.label);
        mu_block(m, st.s1);
        *MuFrame fr = mu_pop_frame(m);
        mu_pop_scope(m);
        mu_assign(m.s, ex);
        mu_join(m.s, fr.brk);
        return;
    }
    if (k == SK_SWITCH) {
        mu_expr(m, st.expr);
        *MuSt entry = mu_copy(m.s);
        *MuSt cur = mu_st(0);
        int has_default = 0;
        mu_push_scope(m);                          // the switch body is one scope
        mu_push_frame(m, 0, "");
        int ci = 0;
        while (ci < List_len<*StmtNode>(&st.items)) {
            *StmtNode c = List_get<*StmtNode>(&st.items, ci);
            if (c.expr == null) {
                has_default = 1;
            }
            mu_assign(m.s, entry);
            mu_join(m.s, cur);                     // fall-through from the case above
            int i = 0;
            while (i < List_len<*StmtNode>(&c.items)) {
                mu_stmt(m, List_get<*StmtNode>(&c.items, i));
                i = i + 1;
            }
            mu_assign(cur, m.s);
            ci = ci + 1;
        }
        *MuFrame fr = mu_pop_frame(m);
        if (List_len<*StmtNode>(&st.items) == 0) {
            mu_assign(m.s, entry);
        } else {
            mu_assign(m.s, cur);
        }
        if (has_default == 0) {
            mu_join(m.s, entry);
        }
        mu_join(m.s, fr.brk);
        mu_run_scope_defers(m);
        mu_pop_scope(m);
        return;
    }
    if (k == SK_MATCH) {                           // the arms are exhaustive (checked separately)
        mu_expr(m, st.expr);
        if (List_len<*StmtNode>(&st.items) == 0) {
            return;
        }
        *MuSt entry = mu_copy(m.s);
        *MuSt out = mu_st(0);
        int ai = 0;
        while (ai < List_len<*StmtNode>(&st.items)) {
            *StmtNode arm = List_get<*StmtNode>(&st.items, ai);
            mu_assign(m.s, entry);
            mu_push_scope(m);
            List<string> binds;
            List_init<string>(&binds, 2);
            sema_arm_binds(arm.name, &binds);
            int bi = 0;
            while (bi < List_len<string>(&binds)) {
                mu_declare(m, List_get<string>(&binds, bi), 0);
                bi = bi + 1;
            }
            mu_block(m, arm.s1);
            mu_pop_scope(m);
            mu_join(out, m.s);
            ai = ai + 1;
        }
        mu_assign(m.s, out);
        return;
    }
    if (k == SK_TRY) {
        *MuSt before = mu_copy(m.s);
        mu_block(m, st.s1);
        *MuSt out = mu_copy(m.s);
        int ci = 0;
        while (ci < List_len<*StmtNode>(&st.items)) {
            *StmtNode c = List_get<*StmtNode>(&st.items, ci);
            mu_assign(m.s, before);
            mu_push_scope(m);
            int sp = 0;
            int j = 0;
            while (c.name[j] != 0) {
                if ((int)c.name[j] == 32) {
                    sp = j;
                }
                j = j + 1;
            }
            if (sp > 0) {
                mu_declare(m, sema_sub_str(c.name, sp + 1, j), 0);
            }
            mu_block(m, c.s1);
            mu_pop_scope(m);
            mu_join(out, m.s);
            ci = ci + 1;
        }
        if (st.s2 != null) {
            mu_assign(m.s, before);
            mu_block(m, st.s2);
            if (m.s.live == 0) {
                return;
            }
            // What the finally assigns on every path through it is assigned after.
            int v = 0;
            while (v < List_len<int>(&before.u)) {
                if (List_get<int>(&before.u, v) == 1 && mu_has(m.s, v) == 0) {
                    mu_put(out, v, 0);
                }
                v = v + 1;
            }
        }
        mu_assign(m.s, out);
        return;
    }
}

void mu_function(Mu* m, List<string>* params, *StmtNode body) {
    mu_push_scope(m);
    int i = 0;
    while (i < List_len<string>(params)) {
        mu_declare(m, List_get<string>(params, i), 0);
        i = i + 1;
    }
    mu_block(m, body);
    mu_pop_scope(m);
}

void sema_warn_maybe_uninit(Sema* s, *DeclNode f) {
    let m: Mu;
    m.sm = s;
    m.s = mu_st(1);
    List<string> params;
    List_init<string>(&params, 4);
    int i = 0;
    while (i < List_len<Param>(&f.params)) {
        List_push<string>(&params, List_get<Param>(&f.params, i).name);
        i = i + 1;
    }
    mu_function(&m, &params, f.body);
}


// Is `t` a `void` value type (void, or an array of void)? Only a function result may be void.
int sema_is_void_value(string t0) {
    string t = sema_strip_const(t0);
    if (sema_has_star(t) == 1) {
        return 0;
    }
    int n = 0;
    while (t[n] != 0 && (int)t[n] != 91) {
        n = n + 1;
    }
    return sema_streq(sema_sub_str(t, 0, n), "void");
}

// "" when a value of type `t0` is fine, else why not (mirrors TypeChecker::voidTypeError):
// a `void` value (also an array or slice of one), or a generic instance like `Box<void>`
// whose type argument makes a field a `void` value.
string sema_void_type_err(Sema* s, string t0) {
    if (sema_is_void_value(t0) == 1) {
        return "cannot have type 'void'";
    }
    string t = sema_strip_const(t0);
    if (sema_has_star(t) == 1 || sema_is_fn_type(t) == 1) {
        return "";
    }
    int n = 0;
    while (t[n] != 0 && (int)t[n] != 91) {
        n = n + 1;
    }
    string bt = sema_sub_str(t, 0, n);
    if (sema_has_lt(bt) == 0) {
        return "";
    }
    *DeclNode d = sema_find_struct(s, sema_base_name(bt));
    if (d == null || List_len<TypeParam>(&d.type_params) == 0) {
        return "";
    }
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(bt, &targs);
    int i = 0;
    while (i < List_len<Param>(&d.params)) {
        Param f = List_get<Param>(&d.params, i);
        if (sema_is_void_value(sema_subst_params(f.ty, &d.type_params, &targs)) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat("cannot have type '", t0), "': its field '"), f.name), "' would be 'void'");
        }
        i = i + 1;
    }
    return "";
}

// "ret(p1, p2)" signature spelling of a function, for the prototype/definition check.
string sema_sig_of(*DeclNode f) {
    string out = sema_cat(sema_strip_const(f.ret_type), "(");
    int i = 0;
    int n = List_len<Param>(&f.params);
    while (i < n) {
        if (i > 0) {
            out = sema_cat(out, ", ");
        }
        out = sema_cat(out, List_get<Param>(&f.params, i).ty);
        i = i + 1;
    }
    return sema_cat(out, ")");
}

// Do two struct decls have identical fields (a multi-file merge of one declaration)?
int sema_same_struct(*DeclNode a, *DeclNode b) {
    List<Param> af;
    List<int> ab;
    List<int> an;
    ast_layout_fields(a, &af, &ab, &an);
    List<Param> bf;
    List<int> bb;
    List<int> bn;
    ast_layout_fields(b, &bf, &bb, &bn);
    int n = List_len<Param>(&af);
    if (n != List_len<Param>(&bf)) {
        return 0;
    }
    if (List_len<*DeclNode>(&a.methods) != List_len<*DeclNode>(&b.methods)) {
        return 0;
    }
    if (List_len<TypeParam>(&a.type_params) != List_len<TypeParam>(&b.type_params)) {
        return 0;
    }
    int i = 0;
    while (i < n) {
        Param x = List_get<Param>(&af, i);
        Param y = List_get<Param>(&bf, i);
        if (sema_streq(x.ty, y.ty) == 0 || sema_streq(x.name, y.name) == 0) {
            return 0;
        }
        if (List_get<int>(&ab, i) != List_get<int>(&bb, i) || List_get<int>(&an, i) != List_get<int>(&bn, i)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int sema_is_type_kind(string k) {
    if (sema_streq(k, "struct") == 1 || sema_streq(k, "union") == 1 || sema_streq(k, "enum") == 1
        || sema_streq(k, "interface") == 1 || sema_streq(k, "type alias") == 1) {
        return 1;
    }
    return 0;
}

// "a struct", "an enum member", ...
string sema_article(string k) {
    if (k[0] == 101 || k[0] == 105 || k[0] == 117) {   // e i u
        return sema_cat("an ", k);
    }
    return sema_cat("a ", k);
}

// Index of `name` in the top-level name table, or -1.
int sema_name_index(NameIdx* tix, string name) {
    return NameIdx_first(tix, name);
}

// Declare top-level `name` of `kind`; report a duplicate or a conflict (mirrors the C++
// checkTopLevelNames: prototypes, `extern` variables and identical structs are allowed).
void sema_declare_top(Sema* s, List<NameEnt>* tab, NameIdx* tix, string name, string kind, *DeclNode d) {
    int i = sema_name_index(tix, name);
    if (i < 0) {
        let ne: NameEnt;
        ne.name = name;
        ne.kind = kind;
        ne.d = d;
        List_push<NameEnt>(tab, ne);
        NameIdx_push(tix, name);
        return;
    }
    NameEnt prev = List_get<NameEnt>(tab, i);
    if (sema_streq(kind, "function") == 1 && sema_streq(prev.kind, "function") == 1) {
        int pg = List_len<TypeParam>(&prev.d.type_params);
        int dg = List_len<TypeParam>(&d.type_params);
        if (pg > 0 || dg > 0) {
            // Two bodies are reported as a redefinition; a generic and a non-generic
            // function may not share a name (a call would silently pick one).
            if ((pg == 0) != (dg == 0) && (prev.d.body == null || d.body == null)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: conflicting declaration of function '%s' (a generic and a non-generic function cannot share a name)\n",
                       s.filename, s.line, s.col, sema_fn_display(d));
            }
            return;
        }
        if (sema_streq(sema_sig_of(prev.d), sema_sig_of(d)) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: conflicting declaration of function '%s' (%s vs the earlier %s)\n",
                   s.filename, s.line, s.col, sema_fn_display(d), sema_sig_of(d), sema_sig_of(prev.d));
        }
        return;                                      // two bodies: reported as a redefinition
    }
    if (sema_streq(kind, "variable") == 1 && sema_streq(prev.kind, "variable") == 1) {
        if ((prev.d.is_extern == 1 || d.is_extern == 1) && sema_streq(prev.d.ret_type, d.ret_type) == 1) {
            return;
        }
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: redefinition of global variable '%s'\n", s.filename, s.line, s.col, name);
        return;
    }
    if (sema_streq(kind, "struct") == 1 && sema_streq(prev.kind, "struct") == 1) {
        if (sema_same_struct(prev.d, d) == 1) {
            return;
        }
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: redefinition of struct '%s' with different fields\n", s.filename, s.line, s.col, name);
        return;
    }
    if (sema_streq(kind, "type alias") == 1 && sema_streq(prev.kind, "type alias") == 1
        && sema_streq(prev.d.ret_type, d.ret_type) == 1) {
        return;
    }
    // Types and enum members live apart (a struct `G` beside a member `G` is fine).
    if ((sema_is_type_kind(kind) == 1 && sema_streq(prev.kind, "enum member") == 1)
        || (sema_is_type_kind(prev.kind) == 1 && sema_streq(kind, "enum member") == 1)) {
        return;
    }
    s.had_error = 1;
    if (sema_streq(kind, prev.kind) == 1) {
        dprintf(2, "error: %s:%d:%d: redefinition of %s '%s'\n", s.filename, s.line, s.col, kind, name);
    } else {
        dprintf(2, "error: %s:%d:%d: '%s' is declared as both %s and %s\n", s.filename, s.line, s.col, name, sema_article(prev.kind), sema_article(kind));
    }
}

// "ret(p1, p2)" of an extern with type aliases and classic enums resolved (as C++ compares
// normalized signatures).
string sema_extern_sig(Sema* s, *DeclNode f) {
    string out = sema_cat(sema_resolve_scalar(s, f.ret_type), "(");
    int i = 0;
    int n = List_len<Param>(&f.params);
    while (i < n) {
        if (i > 0) {
            out = sema_cat(out, ", ");
        }
        out = sema_cat(out, sema_resolve_scalar(s, List_get<Param>(&f.params, i).ty));
        i = i + 1;
    }
    return sema_cat(out, ")");
}

void sema_check_top_names(Sema* s, *Program prog) {
    List<NameEnt> tab;
    List_init<NameEnt>(&tab, 64);
    let tix: NameIdx;
    let exts: StrTab;    // name -> index of its first extern declaration
    memset((*void)&tix, 0, sizeof(NameIdx));
    memset((*void)&exts, 0, sizeof(StrTab));
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        s.line = d.line;
        s.col = d.col;
        if (d.kind == DK_FUNCTION) {
            sema_declare_top(s, &tab, &tix, d.name, "function", d);
        }
        else if (d.kind == DK_VARDECL) {
            sema_declare_top(s, &tab, &tix, d.name, "variable", d);
        }
        else if (d.kind == DK_STRUCT) {
            sema_declare_top(s, &tab, &tix, d.name, "struct", d);
            int m = 0;
            int mn = List_len<*DeclNode>(&d.methods);
            while (m < mn) {                         // an inline method `S.m` is the function `S_m`
                *DeclNode md = List_get<*DeclNode>(&d.methods, m);
                sema_declare_top(s, &tab, &tix, sema_cat(sema_cat(d.name, "_"), md.name), "method", md);
                m = m + 1;
            }
        }
        else if (d.kind == DK_UNION) {
            sema_declare_top(s, &tab, &tix, d.name, "union", d);
        }
        else if (d.kind == DK_ENUM) {
            sema_declare_top(s, &tab, &tix, d.name, "enum", d);
            // A classic member is an int constant, apart from type names; a sum type's
            // variant is a constructor, so it may not share a name with a type either.
            string mkind = "enum member";
            if (sema_is_aggregate(s, d.name) == 1) {
                mkind = "variant";
            }
            int j = 0;
            int jn = List_len<Param>(&d.params);
            while (j < jn) {
                sema_declare_top(s, &tab, &tix, List_get<Param>(&d.params, j).name, mkind, d);
                j = j + 1;
            }
        }
        else if (d.kind == DK_EXTERN) {
            // An `extern` may be declared again (modules share C functions), but with the
            // same signature: two different ones cannot both describe the C symbol.
            int j = StrTab_get(&exts, d.name, -1);   // the first earlier extern of the name
            if (j < 0) {
                StrTab_set(&exts, d.name, i);
            }
            else {
                *DeclNode pd = List_get<*DeclNode>(&prog.decls, j);
                string a = sema_extern_sig(s, pd);
                string b = sema_extern_sig(s, d);
                if (sema_streq(a, b) == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: conflicting declaration of extern '%s' (%s vs the earlier %s)\n", s.filename, s.line, s.col, d.name, b, a);
                }
            }
        }
        else if (d.kind == DK_INTERFACE) {
            sema_declare_top(s, &tab, &tix, d.name, "interface", d);
        }
        else if (d.kind == DK_TYPEALIAS) {
            sema_declare_top(s, &tab, &tix, d.name, "type alias", d);
        }
        i = i + 1;
    }
    // An extern names a C function, so it cannot share its name with a generic one either
    // (a call would reach the generic, or a mistyped mix of the two).
    i = 0;
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_EXTERN) {
            int k = sema_name_index(&tix, d.name);
            if (k >= 0) {
                NameEnt ne = List_get<NameEnt>(&tab, k);
                if (sema_streq(ne.kind, "function") == 1 && List_len<TypeParam>(&ne.d.type_params) > 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: conflicting declaration of extern '%s' (a generic function has the same name)\n",
                           s.filename, d.line, d.col, d.name);
                }
            }
        }
        i = i + 1;
    }
}

// Source spelling of a function for diagnostics: an operator shows as `operator +(V, V)`
// rather than its mangled name.
string sema_fn_display(*DeclNode d) {
    if (d.operator_sym == null || d.operator_sym[0] == 0) {
        return d.name;
    }
    string op = d.operator_sym;
    if (sema_streq(op, "u-") == 1) {
        op = "-";
    }
    string out = sema_cat(sema_cat("operator ", op), "(");
    int i = 0;
    int n = List_len<Param>(&d.params);
    while (i < n) {
        if (i > 0) {
            out = sema_cat(out, ", ");
        }
        out = sema_cat(out, List_get<Param>(&d.params, i).ty);
        i = i + 1;
    }
    return sema_cat(out, ")");
}

// A function's parameter and return types must name known types; no parameter is void.
void sema_check_sig_types(Sema* s, *DeclNode f) {
    int i = 0;
    int n = List_len<Param>(&f.params);
    List<string> pnames;
    List_init<string>(&pnames, 4);
    while (i < n) {
        Param pm = List_get<Param>(&f.params, i);
        if (pm.name != null && pm.name[0] != 0 && sema_streq(pm.ty, "...") == 0) {
            if (sema_in_list(&pnames, pm.name) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: duplicate parameter '%s' in function '%s'\n", s.filename, s.line, s.col, pm.name, sema_fn_display(f));
            } else {
                List_push<string>(&pnames, pm.name);
            }
        }
        sema_check_decl_type(s, pm.ty);
        string pterr = sema_void_type_err(s, pm.ty);
        if (pterr[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: parameter '%s' %s\n", s.filename, s.line, s.col, pm.name, pterr);
        }
        i = i + 1;
    }
    sema_check_decl_type(s, f.ret_type);
}

// Bit width of an integer type usable for a bitfield, or 0 when it is not one.
int sema_int_bits(string t) {
    if (sema_streq(t, "bool") == 1) {
        return 1;
    }
    if (sema_streq(t, "char") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1) {
        return 8;
    }
    if (sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1) {
        return 16;
    }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1 || sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) {
        return 32;
    }
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) {
        return 64;
    }
    return 0;
}

// A bitfield's declared type with aliases resolved and a classic enum as `int` (a sum type
// stays itself: it is not an integer).
string sema_bitfield_base(Sema* s, string t) {
    string ft = sema_strip_const(t);
    int hops = 0;
    while (hops < 16) {
        *DeclNode ad = sema_find_tdecl(s, ft);
        if (ad != null && ad.kind == DK_TYPEALIAS) {
            ft = sema_strip_const(ad.ret_type);
        }
        else {
            if (sema_is_plain_enum_decl(ad) == 1) {
                ft = "int";
            }
            hops = 16;
        }
        hops = hops + 1;
    }
    return ft;
}

// A field default (`int t = 30;`) is a constant of the field's type (mirrors the C++
// visit(StructDecl)); none on a generic struct's fields or on a bitfield.
void sema_check_field_defaults(Sema* s, *DeclNode d) {
    int i = 0;
    while (i < List_len<Param>(&d.params) && i < List_len<*ExprNode>(&d.field_dflts)) {
        *ExprNode e = List_get<*ExprNode>(&d.field_dflts, i);
        Param f = List_get<Param>(&d.params, i);
        i = i + 1;
        if (e == null) {
            continue;
        }
        int sl = s.line;
        int sc = s.col;
        if (e.line > 0) {
            s.line = e.line;
            s.col = e.col;
        }
        if (List_len<TypeParam>(&d.type_params) > 0) {
            sema_error(s, sema_cat(sema_cat(sema_cat(sema_cat("field '", f.name), "' of generic struct '"), d.name), "' cannot have a default value"));
        } else if ((i - 1) < List_len<int>(&d.field_bits) && List_get<int>(&d.field_bits, i - 1) != 0) {
            sema_error(s, sema_cat(sema_cat("bitfield '", f.name), "' cannot have a default value"));
        } else {
            sema_infer_variant_r(s, e, f.ty, 1);
            sema_expr(s, e);
            if (sema_is_const_init(s, e) == 0) {
                sema_error(s, sema_cat(sema_cat("default value of field '", f.name), "' is not a compile-time constant"));
            } else if (e.kind == EK_ARRAYLIT) {     // checked like an array initializer
                sema_check_arr_init(s, f.ty, e);
            } else {
                string err = sema_assign_err(s, f.ty, e);
                if (err[0] != 0) {
                    sema_error(s, sema_cat(sema_cat(sema_cat(sema_cat("default value of field '", f.name), "': "), ""), err));
                }
            }
        }
        s.line = sl;
        s.col = sc;
    }
}

// Struct/union fields: not void; a bitfield needs an integer type at least as wide.
void sema_check_fields(Sema* s, *DeclNode d) {
    int i = 0;
    int n = List_len<Param>(&d.params);
    let fnames: StrTab;                     // a set: the field names seen
    string what = "struct";
    if (d.kind == DK_UNION) {
        what = "union";
    }
    int k = 0;
    while (k < n) {
        string fname = List_get<Param>(&d.params, k).name;
        if (StrTab_has(&fnames, fname) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: duplicate field '%s' in %s '%s'\n", s.filename, s.line, s.col, fname, what, d.name);
        } else {
            StrTab_set(&fnames, fname, 1);
        }
        k = k + 1;
    }
    let mnames: StrTab;                     // a set: the method names seen
    int m = 0;
    int mn = List_len<*DeclNode>(&d.methods);
    while (m < mn) {
        string mname = List_get<*DeclNode>(&d.methods, m).name;
        *DeclNode md = List_get<*DeclNode>(&d.methods, m);
        int mdl = s.line;             // at the method (as the C++ checker)
        int mdc = s.col;
        if (md.line > 0) {
            mdl = md.line;
            mdc = md.col;
        }
        if (StrTab_has(&fnames, mname) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: method '%s' of struct '%s' has the same name as a field\n", s.filename, mdl, mdc, mname, d.name);
        }
        if (StrTab_has(&mnames, mname) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: duplicate method '%s' in struct '%s'\n", s.filename, mdl, mdc, mname, d.name);
        } else {
            StrTab_set(&mnames, mname, 1);
        }
        int mp = 0;
        while (mp < List_len<Param>(&md.params)) {
            if (sema_streq(List_get<Param>(&md.params, mp).name, "self") == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: method '%s' of struct '%s' cannot have a parameter named 'self': it is the implicit receiver\n",
                        s.filename, md.line, md.col, mname, d.name);
            }
            mp = mp + 1;
        }
        m = m + 1;
    }
    int pi = 0;
    while (pi < List_len<string>(&d.pad_tys)) {               // unnamed bitfields `T : N;`
        string pty = List_get<string>(&d.pad_tys, pi);
        int pw = List_get<int>(&d.pad_bits, pi);
        int ptb = sema_int_bits(sema_bitfield_base(s, pty));
        if (ptb == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: unnamed bitfield of '%s' must have an integer type, got '%s'\n", s.filename, s.line, s.col, d.name, pty);
        } else if (pw > ptb) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: unnamed bitfield of '%s' is %d bits wide, more than its type '%s' holds (%d)\n",
                   s.filename, s.line, s.col, d.name, pw, pty, ptb);
        }
        pi = pi + 1;
    }
    while (i < n) {
        Param f = List_get<Param>(&d.params, i);
        string fterr = sema_void_type_err(s, f.ty);
        if (fterr[0] != 0 && (List_len<TypeParam>(&d.type_params) == 0 || sema_is_void_value(f.ty) == 1)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: field '%s' of '%s' %s\n", s.filename, s.line, s.col, f.name, d.name, fterr);
        }
        int bw = 0;
        if (d.kind == DK_STRUCT && i < List_len<int>(&d.field_bits)) {
            bw = List_get<int>(&d.field_bits, i);
        }
        if (bw < 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' has zero width (only an unnamed bitfield may be zero-width)\n", s.filename, s.line, s.col, f.name, d.name);
        }
        if (bw > 0 && sema_names_tparam(d, f.ty) == 0) {   // a type parameter: checked per instance
            int tb = sema_int_bits(sema_bitfield_base(s, f.ty));
            if (tb == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' must have an integer type, got '%s'\n", s.filename, s.line, s.col, f.name, d.name, f.ty);
            } else if (bw > tb) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' is %d bits wide, more than its type '%s' holds (%d)\n",
                       s.filename, s.line, s.col, f.name, d.name, bw, f.ty, tb);
            }
        }
        i = i + 1;
    }
}

// A type alias that resolves back to itself names no type (`type A = B; type B = A;`).
void sema_check_alias_cycles(Sema* s) {
    int i = 0;
    int n = List_len<*DeclNode>(&s.tdecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.tdecls, i);
        s.line = d.line;
        s.col = d.col;
        if (d.kind == DK_TYPEALIAS) {
            string cur = d.ret_type;
            int steps = 0;
            int cyc = 0;
            while (steps < 64) {
                string b0 = sema_struct_of_type(sema_strip_const(cur));
                int bn = 0;
                while (b0[bn] != 0 && (int)b0[bn] != 91) {
                    bn = bn + 1;
                }
                string b = sema_base_name(sema_sub_str(b0, 0, bn));
                // Also through a type argument (`type L = List<L>;`): its layout needs itself.
                if (sema_streq(b, d.name) == 1 || sema_type_mentions(cur, d.name) == 1) {
                    cyc = 1;
                    steps = 64;
                }
                else {
                    *DeclNode nx = sema_find_tdecl(s, b);
                    if (nx == null || nx.kind != DK_TYPEALIAS) {
                        steps = 64;
                    }
                    else {
                        cur = nx.ret_type;
                    }
                }
                steps = steps + 1;
            }
            if (cyc == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: type alias '%s' refers to itself (a cyclic alias names no type)\n", s.filename, s.line, s.col, d.name);
            }
        }
        i = i + 1;
    }
}

void sema_check_fn(Sema* s, *DeclNode f, string self_type) {
    if (f.body == null) {
        return;
    }
    s.line = f.line;
    s.col = f.col;
    // Template body: full type-checking (escape soundness, `?`, uninitialized reads,
    // undefined-variable) is deferred to instantiation, exactly as the C++ checker does,
    // because the param types are still abstract. Only the definite-return check is
    // structural (control-flow, type-independent), so it still applies here.
    if (List_len<TypeParam>(&f.type_params) > 0 && s.in_inst == 0) {
        if (f.is_async == 0 && sema_streq(f.ret_type, "void") == 0
            && sema_always_returns(f.body) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: missing return in non-void function '%s' (control can reach the end without returning a %s)\n",
                   s.filename, s.line, s.col, f.name, f.ret_type);
        }
        return;
    }
    // `main` is the entry point; its return value is the process exit code, so it must be int.
    if (sema_streq(f.name, "main") == 1 && sema_streq(f.ret_type, "int") == 0
        && sema_streq(f.ret_type, "int32") == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: 'main' must return int (its return value is the process exit code); got '%s'\n",
               s.filename, s.line, s.col, f.ret_type);
    }
    if (sema_streq(f.name, "main") == 1 && f.is_async == 1 && s.in_inst == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: 'main' cannot be async: the program's entry point must return int directly (run an async function from main with an executor)\n",
               s.filename, s.line, s.col);
    }
    s.in_async = f.is_async;
    s.in_variadic = 0;
    int vpn = List_len<Param>(&f.params);
    if (vpn > 0 && sema_streq(List_get<Param>(&f.params, vpn - 1).ty, "...") == 1) {
        s.in_variadic = 1;
    }
    s.await_seen = 0;
    s.cur_ret = sema_isub(s, f.ret_type);
    s.cur_ret_raw = f.ret_type;
    // Escape soundness: watch non-escaping fn-type params for the body walk. (Not in a
    // generic instance: as in the C++ checker, it is enforced on non-generic functions.)
    List_init<string>(&s.watched, 4);
    List_init<string>(&s.escaped, 4);
    List_init<string>(&s.wlocals, 4);
    List_init<string>(&s.wlocals_esc, 4);
    List_init<*ExprNode>(&s.wlam, 4);
    List_init<string>(&s.wlam_name, 4);
    List_init<int>(&s.wlam_async, 4);
    List_init<*ExprNode>(&s.lcap_lam, 4);
    List_init<string>(&s.lcap_name, 4);
    s.lam_arg_stack = 0;
    List_init<string>(&s.cap_param, 4);
    List_init<string>(&s.cap_local, 4);
    List_init<string>(&s.narrowed, 4);
    List_init<string>(&s.loop_lbls, 4);
    s.callee_ctx = "";
    int pe = 0;
    int pn = List_len<Param>(&f.params);
    while (pe < pn) {
        Param pm = List_get<Param>(&f.params, pe);
        int marked = 0;
        if (pe < List_len<int>(&f.param_escaping)) {
            marked = List_get<int>(&f.param_escaping, pe);
        }
        // In an instance the param's type is the instance's (a `T` may be a closure).
        string wty = pm.ty;
        if (s.in_inst == 1) {
            wty = sema_isub(s, pm.ty);
        }
        if (sema_is_fn_type(wty) == 1 && marked == 0) {
            List_push<string>(&s.watched, pm.name);
        }
        pe = pe + 1;
    }
    sema_push(s);
    if (self_type[0] != 0) {   // method: self points at the struct
        sema_define(s, "self", sema_cat("*", self_type), 0);
    }
    int j = 0;
    int m = List_len<Param>(&f.params);
    while (j < m) {
        Param pm = List_get<Param>(&f.params, j);
        // `const int x` (or `T*const p`): the parameter itself may not be reassigned.
        int pconst = 0;
        int pn2 = 0;
        while (pm.ty[pn2] != 0) {
            pn2 = pn2 + 1;
        }
        if (pn2 >= 6 && sema_streq(sema_sub_str(pm.ty, 0, 6), "const ") == 1 && sema_has_star(pm.ty) == 0) {
            pconst = 1;
        }
        if (pn2 >= 6 && sema_streq(sema_sub_str(pm.ty, pn2 - 6, pn2), "*const") == 1) {
            pconst = 1;
        }
        // An inline struct method's parameters carry no position and count as variables
        // (the C++ checks those bodies with plain scope bindings).
        if (self_type[0] != 0) {
            sema_define_at(s, pm.name, sema_isub(s, pm.ty), pconst, 0, 0, 0);
        }
        else {
            sema_define_at(s, pm.name, sema_isub(s, pm.ty), pconst, pm.line, pm.col, 1);
            if (s.tool != 0 && pm.line > 0) {   // its name hovers and resolves like a local's
                sema_tool_hsym(s, pm.line, pm.col, sema_slen(pm.name), sema_display_ty(s, sema_isub(s, pm.ty)));
            }
        }
        if (s.in_inst == 1) {              // `id<void>`: a type argument may make a parameter void
            string iperr = sema_void_type_err(s, sema_isub(s, pm.ty));
            if (iperr[0] != 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: parameter '%s' %s\n", s.filename, s.line, s.col, pm.name, iperr);
            }
        }
        j = j + 1;
    }
    int prev_pd = s.param_depth;
    s.param_depth = s.depth;
    List_clear<string>(&s.addr_keys);
    List_clear<string>(&s.addr_roots);
    sema_stmt(s, f.body);
    s.param_depth = prev_pd;
    // Reads of an uninitialized scalar local; under -Wall, those uninitialized on some
    // path. An async body is skipped (its locals become frame fields), and so is an inline
    // struct method's (the C++ checks those bodies apart from visit(FunctionDecl)).
    if (f.is_async == 0) {
        int urep = sema_check_uninit(s, f.body);
        if (urep == 0 && s.wall == 1 && s.in_inst == 0 && self_type[0] == 0) {
            sema_warn_maybe_uninit(s, f);
        }
    }
    sema_pop(s);
    // A non-void function must return on every path (no implicit zero return);
    // void may fall off, and async completes its future implicitly.
    if (f.is_async == 0 && s.in_inst == 0 && sema_streq(f.ret_type, "void") == 0
        && sema_always_returns(f.body) == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: missing return in non-void function '%s' (control can reach the end without returning a %s)\n",
               s.filename, s.line, s.col, f.name, f.ret_type);
    }
    if (f.is_async == 1 && s.await_seen == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: async function '%s' has no `await`\n", s.filename, s.line, s.col, f.name);
    }
    sema_stack_envs(s);
    int ci = 0;
    while (ci < List_len<string>(&s.cap_param)) {
        if (sema_in_list(&s.wlocals_esc, List_get<string>(&s.cap_local, ci)) == 1
            && sema_in_list(&s.escaped, List_get<string>(&s.cap_param, ci)) == 0) {
            List_push<string>(&s.escaped, List_get<string>(&s.cap_param, ci));
        }
        ci = ci + 1;
    }
    sema_record_generic_params(s, f);
    int wi = 0;
    int wn = List_len<string>(&s.watched);
    while (wi < wn && s.in_inst == 0 && s.stamp_all == 0) {   // enforced on non-generic functions (as the C++), not again on the lowered program
        string wnm = List_get<string>(&s.watched, wi);
        if (sema_in_list(&s.escaped, wnm) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: closure parameter '%s' escapes (used beyond a direct call); mark it `escaping`\n",
                   s.filename, s.line, s.col, wnm);
        }
        wi = wi + 1;
    }
    s.in_async = 0;
}
