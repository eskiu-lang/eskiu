// Driver: `eskiuc run selfhost/eir_main.esk FILE`:
// Preprocess, parse, type-check, async-lower, and build EIR in Eskiu, printing EIR text to stdout.

import <io>;
import <fs>;
import "preprocessor.esk";
import "parser.esk";
import "sema.esk";
import "async_lower.esk";
import "codegen.esk";
import "eir.esk";
import "bigstack.esk";

extern int64 write(int fd, *void buf, int64 n);

void eprint(string s) {
    int64 n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    write(2, (*void)s, n);
}

int eir_main(int argc, string* argv) {
    if (argc < 2) {
        eprint("usage: eir_main <file.esk>\n");
        return 1;
    }
    let n: int64 = 0;
    *uint8 raw = fs_read_all(argv[1], &n);
    if (raw == null) {
        uint8[512] eb;
        sprintf((string)&eb[0], "error: cannot read %s\n", argv[1]);
        eprint((string)&eb[0]);
        return 1;
    }

#ifdef __APPLE__
    g_pp_os = "__APPLE__";
#else
    g_pp_os = "__linux__";
#endif
    g_pp_arch = cg_host_arch_macro();
    parser_session_init();
    register_file(argv[1]);
    let pperr: int = 0;
    string pp = pp_run((string)raw, (int)n, argv[1], &pperr);
    *uint8 src = (*uint8)pp;
    int plen = g_pp_out_len;

    let p: Parser;
    g_lex_file = argv[1];
    p_init(&p, src, plen);
    p.basedir = str_dir(argv[1]);
    *Program prog = parse_program(&p);

    let sm: Sema;
    sema_init(&sm, argv[1]);
    if (sema_check(&sm, prog) == 0) {
        eprint("Type checking failed!\n");
        return 1;
    }

    async_lower(prog);

    let b: EirBuilder;
    eir_init(&b);
    eir_program(&b, prog);

    printf("%s", (string)String_cstr(&b.globals));
    printf("%s", (string)String_cstr(&b.out));
    return 0;
}

void main_body() {
    big_rc = eir_main(big_argc, big_argv);
}

int main(int argc, string* argv) {
    big_argc = argc;
    big_argv = argv;
    run_on_big_stack(main_body);
    return big_rc;
}
