// Part of sema.esk (expressions), imported from it in order; compile sema.esk, not this file alone.

// ── expression walk ──

// `recs` with a record of type `t` in the generic instance being checked appended: its
// type arguments joined by '\t', a '\f', the type, a '\n' (al_generalize reads these).
string sema_inst_rec(Sema* s, string recs, string t) {
    string r = recs;
    if (r == null) {
        r = "";
    }
    int i = 0;
    while (i < List_len<string>(&s.isub_a)) {
        if (i > 0) {
            r = sema_cat(r, "\t");
        }
        r = sema_cat(r, List_get<string>(&s.isub_a, i));
        i = i + 1;
    }
    r = sema_cat(r, "\f");
    if (t != null) {
        r = sema_cat(r, t);
    }
    return sema_cat(r, "\n");
}

// A lambda's captures for the EIR builder, ordered by name (the C++ capture map).
void sema_stamp_captures(Sema* s, *ExprNode e) {
    List<string> ns;
    List<string> ts;
    int i = 0;
    while (i < List_len<*ExprNode>(&s.cap_lams)) {
        if (List_get<*ExprNode>(&s.cap_lams, i) == e) {
            string n = List_get<string>(&s.cap_names, i);
            int at = List_len<string>(&ns);
            int j = 0;
            while (j < List_len<string>(&ns)) {
                if (strcmp(n, List_get<string>(&ns, j)) < 0) {
                    at = j;
                    break;
                }
                j = j + 1;
            }
            List_insert<string>(&ns, at, n);
            List_insert<string>(&ts, at, List_get<string>(&s.cap_tys, i));
        }
        i = i + 1;
    }
    e.caps = ns;
    e.cap_tys = ts;
}

void sema_binary_chain(Sema* s, *ExprNode e);
// Check `e` with its position as the current diagnostic location (restored afterwards so
// the enclosing node's own checks report at the enclosing node).
void sema_expr(Sema* s, *ExprNode e) {
    if (e == null) {
        return;
    }
    int pl = s.line;
    int pc = s.col;
    if (e.line > 0) {
        s.line = e.line;
        s.col = e.col;
    }
    sema_expr_k(s, e);
    if (s.tool == 1) {
        sema_tool_expr(s, e);
    }
    if (s.in_async == 1) {                 // the async lowering's temporaries
        e.aty = sema_infer_type(s, e);
        if (s.in_inst == 1) {
            e.ainst = sema_inst_rec(s, e.ainst, e.aty);
        }
    } else if (s.stamp_all == 1) {         // the EIR builder's types (a generic instance's apart)
        if (s.in_inst == 1) {
            e.ainst = sema_inst_rec(s, e.ainst, sema_infer_type(s, e));
        } else {
            e.aty = sema_infer_type(s, e);
        }
    }
    // The callee may assign any global: a global's narrowing ends after the call.
    // alloc_with calls the allocator's method and thread_create starts code that may run
    // at once, so they end it too.
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_AWAIT || e.kind == EK_ALLOCWITH
        || e.kind == EK_THREADCREATE || sema_is_op_call(s, e) == 1) {
        sema_drop_global_narrowings(s);
    }
    s.line = pl;
    s.col = pc;
}

// The C++ checker's spelling of an arithmetic result type (its promoteType after the
// integer promotions): a mixed int-sized pair is named `int32`/`uint32`/`int64`/`uint64`.
// Only diagnostics show it; the types themselves agree.
string sema_cxx_int_promoted(string t) {
    if (sema_streq(t, "bool") == 1 || sema_streq(t, "char") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1
        || sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1) {
        return "int32";
    }
    return t;
}

int sema_cxx_width(string t) {
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) {
        return 64;
    }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1 || sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) {
        return 32;
    }
    if (sema_is_int_ty(t) == 1) {
        return 16;
    }
    return 0;
}

string sema_cxx_promote(string a, string b) {
    if (sema_streq(a, b) == 1) {
        return a;
    }
    if (sema_streq(a, "double") == 1 || sema_streq(b, "double") == 1) {
        return "double";
    }
    if (sema_streq(a, "float") == 1 || sema_streq(b, "float") == 1) {
        return "float";
    }
    int w1 = sema_cxx_width(a);
    int w2 = sema_cxx_width(b);
    if (w1 > 0 && w2 > 0 && (w1 >= 32 || w2 >= 32)) {
        int u1 = 0;
        if (sema_streq(a, "uint") == 1 || sema_streq(a, "uint32") == 1 || sema_streq(a, "uint64") == 1) {
            u1 = 1;
        }
        int u2 = 0;
        if (sema_streq(b, "uint") == 1 || sema_streq(b, "uint32") == 1 || sema_streq(b, "uint64") == 1) {
            u2 = 1;
        }
        if (w1 < 32) {
            w1 = 32;
        }
        if (w2 < 32) {
            w2 = 32;
        }
        int w = w1;
        int u = u1;
        if (u1 == u2) {
            if (w2 > w1) {
                w = w2;
            }
        }
        else {
            int wu = w2;
            int ws = w1;
            if (u1 == 1) {
                wu = w1;
                ws = w2;
            }
            u = 0;
            w = ws;
            if (wu >= ws) {
                u = 1;
                w = wu;
            }
        }
        if (w == 64) {
            if (u == 1) {
                return "uint64";
            }
            return "int64";
        }
        if (u == 1) {
            return "uint32";
        }
        return "int32";
    }
    if (sema_streq(a, "int64") == 1 || sema_streq(b, "int64") == 1) {
        return "int64";
    }
    if (sema_streq(a, "uint64") == 1 || sema_streq(b, "uint64") == 1) {
        return "uint64";
    }
    if (sema_streq(a, "int32") == 1 || sema_streq(b, "int32") == 1) {
        return "int32";
    }
    if (sema_streq(a, "uint32") == 1 || sema_streq(b, "uint32") == 1) {
        return "uint32";
    }
    if (sema_streq(a, "int16") == 1 || sema_streq(b, "int16") == 1) {
        return "int16";
    }
    if (sema_streq(a, "uint16") == 1 || sema_streq(b, "uint16") == 1) {
        return "uint16";
    }
    return a;
}

// The C++ spelling of the type of operand `e`, whose self-host type is `t`.
string sema_cxx_spelling(Sema* s, *ExprNode e, string t) {
    if (e == null || e.kind != EK_BINARY || e.a == null || e.b == null) {
        return t;
    }
    string op = e.sval;
    int arith = 0;
    if (sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1 || sema_streq(op, "*") == 1 || sema_streq(op, "/") == 1
        || sema_streq(op, "%") == 1 || sema_streq(op, "&") == 1 || sema_streq(op, "|") == 1 || sema_streq(op, "^") == 1) {
        arith = 1;
    }
    int shift = 0;
    if (sema_streq(op, "<<") == 1 || sema_streq(op, ">>") == 1) {
        shift = 1;
    }
    if (arith == 0 && shift == 0) {
        return t;
    }
    string l = sema_strip_const(sema_canon(s, sema_cxx_spelling(s, e.a, sema_infer_type(s, e.a))));
    if (shift == 1) {
        if (sema_is_int_ty(l) == 0) {
            return t;
        }
        return sema_cxx_int_promoted(l);
    }
    string r = sema_strip_const(sema_canon(s, sema_cxx_spelling(s, e.b, sema_infer_type(s, e.b))));
    if (sema_is_numeric_ty(l) == 0 || sema_is_numeric_ty(r) == 0) {
        return t;
    }
    return sema_cxx_promote(sema_cxx_int_promoted(l), sema_cxx_int_promoted(r));
}

int sema_is_uns_name(string t) {
    return sema_streq(t, "uint") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "uint16") == 1
        || sema_streq(t, "uint32") == 1 || sema_streq(t, "uint64") == 1;
}

int sema_is_sgn_name(string t) {
    return sema_streq(t, "int") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "int16") == 1
        || sema_streq(t, "int32") == 1 || sema_streq(t, "int64") == 1;
}

// The checks of one non-assignment binary operator `e` whose operands have the inferred
// types `lt0` and `rt0` (see sema_binary_chain).
// An aggregate (struct, union or payload enum): compared only through a user operator
// (mirrors the C++ isAgg).
int sema_is_agg(Sema* s, string c) {
    if (sema_is_struct(s, sema_base_name(c)) == 1) {
        return 1;
    }
    *DeclNode d = sema_find_tdecl(s, sema_base_name(c));
    if (d != null && d.kind == DK_ENUM && sema_is_plain_enum_decl(d) == 0) {
        return 1;
    }
    return 0;
}

// Do the built-in operators accept binary `op` over operand types `lt0`, `rt0`? 1 yes,
// 0 no (only a user overload can), -1 when a type is not understood well enough to judge.
// Mirrors the C++ inferBinaryExprType.
int sema_binop_verdict(Sema* s, string op, string lt0, string rt0) {
    string l = sema_canon(s, lt0);
    string r = sema_canon(s, rt0);
    if (sema_judgeable(s, l) == 0 || sema_judgeable(s, r) == 0) {
        return -1;
    }
    // A `void` call has no value to compare or test.
    int has_void = 0;
    if (sema_streq(l, "void") == 1 || sema_streq(r, "void") == 1) {
        has_void = 1;
    }
    if (sema_is_cmp_op(op) == 1) {
        if (has_void == 1) {
            return 0;
        }
        int lp = sema_c_ptr(l);
        if (sema_streq(l, "null") == 1) {
            lp = 1;
        }
        int rp = sema_c_ptr(r);
        if (sema_streq(r, "null") == 1) {
            rp = 1;
        }
        if (sema_is_numeric_ty(l) == 1 && sema_is_numeric_ty(r) == 1) {
            return 1;
        }
        if (lp == 1 && rp == 1) {
            return 1;
        }
        // An interface value compares with `null` (its data pointer is null or set).
        if ((sema_streq(op, "==") == 1 || sema_streq(op, "!=") == 1)
            && ((sema_is_iface_val(s, lt0) == 1 && sema_streq(r, "null") == 1)
                || (sema_streq(l, "null") == 1 && sema_is_iface_val(s, rt0) == 1))) {
            return 1;
        }
        if (sema_is_aggregate(s, lt0) == 1 || sema_is_aggregate(s, rt0) == 1) {   // no built-in == on aggregates
            return 0;
        }
        if (sema_streq(l, r) == 1 && sema_is_agg(s, l) == 0) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(op, "&&") == 1 || sema_streq(op, "||") == 1) {
        return 1 - has_void;
    }
    if (sema_streq(op, "&") == 1 || sema_streq(op, "|") == 1 || sema_streq(op, "^") == 1
        || sema_streq(op, "<<") == 1 || sema_streq(op, ">>") == 1) {
        if (sema_is_int_ty(l) == 1 && sema_is_int_ty(r) == 1) {
            return 1;
        }
        return 0;
    }
    if (sema_is_arith_op(op) == 0) {
        return -1;
    }
    if (sema_streq(op, "-") == 1 && sema_c_ptr(l) == 1 && sema_c_ptr(r) == 1) {
        return 1;
    }
    if ((sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1) && sema_c_ptr(l) == 1 && sema_is_int_ty(r) == 1) {
        return 1;
    }
    if (sema_is_numeric_ty(l) == 1 && sema_is_numeric_ty(r) == 1) {
        return 1;
    }
    return 0;
}

void sema_binary_checks(Sema* s, *ExprNode e, string lt0, string rt0) {
    // `p - q` counts elements between two pointers into one array: they must point to
    // the same type (C, mirrors the C++ finishBinary).
    if (e.a != null && e.b != null && sema_streq(e.sval, "-") == 1) {
        string pl = sema_strip_nullable(sema_canon(s, lt0));
        string pr = sema_strip_nullable(sema_canon(s, rt0));
        if ((int)pl[0] == 42 && (int)pr[0] == 42 && sema_judgeable(s, pl) == 1 && sema_judgeable(s, pr) == 1
            && sema_streq(pl, pr) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: pointer subtraction needs pointers to the same type, got '%s' and '%s'\n", s.filename, s.line, s.col, lt0, rt0);
            return;
        }
    }
    int verdict = -1;
    if (e.a != null && e.b != null) {
        verdict = sema_binop_verdict(s, e.sval, lt0, rt0);
    }
    if (verdict == 0 && sema_find_binop(s, e.sval, lt0, rt0) == null) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: invalid operands for operator: %s and %s\n", s.filename, s.line, s.col, lt0, rt0);
    }
    if (e.a != null && e.b != null && verdict == -1) {
        // Operand kinds the built-in operators reject (a user operator overload aside).
        string olt = sema_strip_const(lt0);
        string ort = sema_strip_const(rt0);
        int bitop = 0;
        if (sema_streq(e.sval, "&") == 1 || sema_streq(e.sval, "|") == 1 || sema_streq(e.sval, "^") == 1
            || sema_streq(e.sval, "<<") == 1 || sema_streq(e.sval, ">>") == 1) {
            bitop = 1;
        }
        int arith = 0;
        if (sema_streq(e.sval, "+") == 1 || sema_streq(e.sval, "*") == 1 || sema_streq(e.sval, "/") == 1
            || sema_streq(e.sval, "%") == 1) {
            arith = 1;
        }
        int bad = 0;
        if (bitop == 1 && (sema_is_float_ty(olt) == 1 || sema_is_float_ty(ort) == 1)
            && (sema_is_numeric_ty(olt) == 1 && sema_is_numeric_ty(ort) == 1)) {
            bad = 1;
        }
        if (arith == 1 && sema_is_ptrish(olt) == 1 && sema_is_ptrish(ort) == 1
            && sema_streq(olt, "null") == 0 && sema_streq(ort, "null") == 0) {
            bad = 1;
        }
        // A struct value has no built-in arithmetic/bitwise operator (only a user
        // overload), and a pointer or string has no `*` `/` `%`.
        if ((arith == 1 || bitop == 1 || sema_streq(e.sval, "-") == 1)
            && (sema_is_struct(s, olt) == 1 || sema_is_struct(s, ort) == 1) && sema_find_binop(s, e.sval, olt, ort) == null) {
            bad = 1;
        }
        if ((bitop == 1 || sema_streq(e.sval, "*") == 1 || sema_streq(e.sval, "/") == 1 || sema_streq(e.sval, "%") == 1)
            && olt[0] != 0 && ort[0] != 0 && sema_any_op(s, e.sval) == 0
            && ((sema_is_ptrish(olt) == 1 && sema_is_arr_ty(olt) == 0) || (sema_is_ptrish(ort) == 1 && sema_is_arr_ty(ort) == 0))) {
            bad = 1;
        }
        if (bad == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: invalid operands for operator: %s and %s\n", s.filename, s.line, s.col, olt, ort);
        }
    }
    // A constant shift count must be below the (promoted) left operand's width and not
    // negative (C: undefined). An unknown left type is checked against 64 bits.
    if ((sema_streq(e.sval, "<<") == 1 || sema_streq(e.sval, ">>") == 1) && e.b != null) {
        int64 cnt = (int64)0;
        string slt = sema_resolve_scalar(s, lt0);
        int width = 0;
        if (slt[0] == 0 || sema_streq(slt, "int64") == 1 || sema_streq(slt, "uint64") == 1) {
            width = 64;
        }
        else if (sema_is_int_ty(slt) == 1) {
            width = 32;
        }
        if (width > 0 && sema_fold_int(s, e.b, &cnt) == 1 && (cnt < (int64)0 || cnt >= (int64)width)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: shift count %lld is out of range for a %d-bit operand (it must be 0..%d)\n",
                   s.filename, s.line, s.col, cnt, width, width - 1);
        }
    }
    // `&&` / `||` take truth values (scalars), not aggregates.
    if ((sema_streq(e.sval, "&&") == 1 || sema_streq(e.sval, "||") == 1)
        && ((sema_is_aggregate(s, lt0) == 1 && sema_is_iface_val(s, lt0) == 0)
            || (sema_is_aggregate(s, rt0) == 1 && sema_is_iface_val(s, rt0) == 0))) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: invalid operands for operator: %s and %s\n", s.filename, s.line, s.col, lt0, rt0);
    }
    // -Wextra: a signed operand compared with an unsigned one is converted to unsigned.
    if (s.wextra == 1 && sema_is_cmp_op(e.sval) == 1 && lt0[0] != 0 && rt0[0] != 0
        && sema_streq(lt0, "unknown") == 0 && sema_streq(rt0, "unknown") == 0) {
        string wl = sema_canon(s, lt0);
        string wr = sema_canon(s, rt0);
        if ((sema_is_uns_name(wl) == 1 && sema_is_sgn_name(wr) == 1) || (sema_is_sgn_name(wl) == 1 && sema_is_uns_name(wr) == 1)) {
            sema_lint(s, e.line, e.col, sema_cat(sema_cat(sema_cat(sema_cat("comparison between signed and unsigned integers ('",
                      sema_cxx_spelling(s, e.a, lt0)), "' and '"), sema_cxx_spelling(s, e.b, rt0)), "')"));
        }
    }
    if (s.has_ops == 1 && verdict != 1) {  // -Wall: an operator use references its overload
        *DeclNode uod = sema_find_binop(s, e.sval, lt0, rt0);
        if (uod != null) {
            sema_note_call(s, uod.name);
        }
    }
    // `s == "abc"` compares two addresses (mirrors the C++ -Wstring-compare).
    // Only a pointer comparison: `S == "x"` on a struct S is an overloaded operator.
    if ((sema_streq(e.sval, "==") == 1 || sema_streq(e.sval, "!=") == 1)
        && ((e.a != null && e.a.kind == EK_LITERAL && e.a.lit_kind == LIT_STRING && sema_is_addr_ty(s, e.b) == 1)
            || (e.b != null && e.b.kind == EK_LITERAL && e.b.lit_kind == LIT_STRING && sema_is_addr_ty(s, e.a) == 1))) {
        sema_warn(s, "string-compare", e.line, e.col,
                  sema_cat(sema_cat("comparison with a string literal compares addresses, not text; use strcmp(a, b) ", e.sval), " 0"));
    }
    // Division / remainder by a literal zero is a guaranteed runtime trap.
    if ((sema_streq(e.sval, "/") == 1 || sema_streq(e.sval, "%") == 1)
        && e.b != null && e.b.kind == EK_LITERAL && e.b.lit_kind == LIT_INT
        && sema_lit_is_zero(e.b.sval) == 1) {
        if (sema_streq(e.sval, "/") == 1) {
            sema_error(s, "division by zero");
        }
        else {
            sema_error(s, "remainder by zero");
        }
    }
    // An integer division whose operands are constant expressions (names, `sizeof`,
    // casts) is checked like a literal one: by zero, or the most negative value by -1,
    // is undefined in C (mirrors the C++ finishBinary).
    if ((sema_streq(e.sval, "/") == 1 || sema_streq(e.sval, "%") == 1) && e.a != null && e.b != null) {
        string drt = sema_strip_const(sema_resolve_scalar(s, sema_binary_type(s, e.sval, lt0, rt0)));
        int lit_zero = 0;
        if (e.b.kind == EK_LITERAL && e.b.lit_kind == LIT_INT && sema_lit_is_zero(e.b.sval) == 1) {
            lit_zero = 1;
        }
        int64 dx = (int64)0;
        int64 dy = (int64)0;
        int wide = 0;
        if (sema_streq(drt, "int64") == 1 || sema_streq(drt, "uint64") == 1) {
            wide = 1;
        }
        string what = "remainder";
        if (sema_streq(e.sval, "/") == 1) {
            what = "division";
        }
        if (sema_is_int_ty(drt) == 1 && sema_fold_int(s, e.b, &dy) == 1) {
            if (wide == 0) {
                dy = sema_trunc_const(drt, dy);
            }
            if (dy == (int64)0 && lit_zero == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: %s by zero\n", s.filename, s.line, s.col, what);
            } else if (dy == (int64)-1 && (sema_streq(drt, "int") == 1 || sema_streq(drt, "int32") == 1 || sema_streq(drt, "int64") == 1)
                       && sema_fold_int(s, e.a, &dx) == 1) {
                if (wide == 0) {
                    dx = sema_trunc_const(drt, dx);
                }
                int64 lo = (int64)-2147483647 - (int64)1;
                if (wide == 1) {
                    lo = (int64)-9223372036854775807 - (int64)1;
                }
                if (dx == lo) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: %s overflows: %lld %s -1 does not fit '%s'\n", s.filename, s.line, s.col, what, dx, e.sval, drt);
                }
            }
        }
    }
    // Comparison operands must be mutually comparable: both numeric, both pointer-like
    // (incl. null), or the same non-aggregate type. Conservative: only flag when both
    // operand types are known (unknown → skip, never falsely reject).
    if (sema_is_cmp_op(e.sval) == 1 && verdict == -1) {
        string lt = lt0;
        string rt = rt0;
        if (lt[0] != 0 && rt[0] != 0 && sema_streq(lt, "unknown") == 0 && sema_streq(rt, "unknown") == 0) {
            int ok = 0;
            // Aggregates (struct/union, sum type, interface value, array, slice, closure)
            // have no built-in comparison (only a user `operator ==`).
            if (sema_is_aggregate(s, lt) == 1 || sema_is_aggregate(s, rt) == 1) {
                ok = 0;
            }
            else if (sema_is_numeric_ty(lt) == 1 && sema_is_numeric_ty(rt) == 1) {
                ok = 1;
            }
            else if (sema_is_ptrish(lt) == 1 && sema_is_ptrish(rt) == 1) {
                ok = 1;
            }
            else if (sema_streq(lt, rt) == 1 && sema_is_struct(s, sema_base_name(lt)) == 0) {
                ok = 1;
            }
            if (ok == 0) {                                 // or a user `operator ==(L,R)` exists
                let cty: List<string>;
                List_init<string>(&cty, 2);
                List_push<string>(&cty, lt);
                List_push<string>(&cty, rt);
                string copn = ast_op_name(e.sval, &cty);
                if (copn[0] != 0 && sema_find_fn(s, copn) >= 0) {
                    ok = 1;
                }
            }
            if (ok == 0) {
                sema_error(s, "invalid operands for operator");
            }
        }
    }
}

// A non-assignment binary expression. A left-leaning chain (`a + b + c ...`) is as deep
// as it is long, so its left spine is handled with loops, in the order a recursive walk
// would take: the operand types are inferred bottom-up once, each operator's checks run
// top-down, then the operands are visited in source order (the leftmost first), each
// right operand at its operator's position and, under `&&`/`||`, with the left side's
// narrowing in force.
void sema_binary_chain(Sema* s, *ExprNode e) {
    List<*ExprNode> spine;
    List_init<*ExprNode>(&spine, 8);
    *ExprNode b = e;
    while (b != null && b.kind == EK_BINARY && sema_is_assign(b.sval) == 0) {
        List_push<*ExprNode>(&spine, b);
        b = b.a;
    }
    int n = List_len<*ExprNode>(&spine);
    List<string> lts;
    List_init<string>(&lts, n);
    List<string> rts;
    List_init<string>(&rts, n);
    List<int> pls;
    List_init<int>(&pls, n);
    List<int> pcs;
    List_init<int>(&pcs, n);
    int i = 0;
    while (i < n) {
        List_push<string>(&lts, "");
        List_push<string>(&rts, "");
        *ExprNode pn = List_get<*ExprNode>(&spine, i);
        if (i > 0 && pn.line > 0) {
            List_push<int>(&pls, pn.line);
            List_push<int>(&pcs, pn.col);
        }
        else if (i > 0) {
            List_push<int>(&pls, List_get<int>(&pls, i - 1));
            List_push<int>(&pcs, List_get<int>(&pcs, i - 1));
        }
        else {
            List_push<int>(&pls, s.line);
            List_push<int>(&pcs, s.col);
        }
        i = i + 1;
    }
    string t = sema_infer_type(s, b);
    i = n - 1;
    while (i >= 0) {
        *ExprNode tn = List_get<*ExprNode>(&spine, i);
        string rt = sema_infer_type(s, tn.b);
        List_set<string>(&lts, i, t);
        List_set<string>(&rts, i, rt);
        t = sema_binary_type(s, tn.sval, t, rt);
        i = i - 1;
    }
    i = 0;
    while (i < n) {
        s.line = List_get<int>(&pls, i);
        s.col = List_get<int>(&pcs, i);
        sema_binary_checks(s, List_get<*ExprNode>(&spine, i), List_get<string>(&lts, i), List_get<string>(&rts, i));
        i = i + 1;
    }
    if (s.tool == 1) {                     // the inner operators of the chain
        int ti = 1;
        while (ti < n) {
            sema_tool_expr(s, List_get<*ExprNode>(&spine, ti));
            ti = ti + 1;
        }
    }
    s.line = List_get<int>(&pls, n - 1);
    s.col = List_get<int>(&pcs, n - 1);
    sema_expr(s, b);
    // Narrowing keys of the left operand of the operator just visited: in a run of the
    // same `&&` (or `||`), the next operator's left narrows to those plus the previous
    // right operand's, so each operand is scanned once instead of the whole prefix.
    List<string> keys;
    List_init<string>(&keys, 2);
    i = n - 1;
    while (i >= 0) {
        *ExprNode vn = List_get<*ExprNode>(&spine, i);
        s.line = List_get<int>(&pls, i);
        s.col = List_get<int>(&pcs, i);
        if (sema_streq(vn.sval, "&&") == 1 || sema_streq(vn.sval, "||") == 1) {
            // Short-circuit narrowing: the right operand sees the left's outcome.
            int wt = sema_streq(vn.sval, "&&");
            int same = 0;
            if (i + 1 < n) {
                *ExprNode below = List_get<*ExprNode>(&spine, i + 1);
                same = sema_streq(below.sval, vn.sval);
                if (same == 1) {
                    sema_cond_narrow(s, below.b, wt, &keys);
                }
            }
            if (same == 0) {
                List_free<string>(&keys);
                List_init<string>(&keys, 2);
                sema_cond_narrow(s, vn.a, wt, &keys);
            }
            List<string> ins;
            List_init<string>(&ins, 2);
            sema_narrow_apply(s, &keys, &ins);
            sema_expr(s, vn.b);
            sema_narrow_undo(s, &ins);
        } else {
            sema_expr(s, vn.b);
        }
        i = i - 1;
    }
    s.line = List_get<int>(&pls, 0);
    s.col = List_get<int>(&pcs, 0);
    List_free<*ExprNode>(&spine);
}

// `va_start(ap)` / `va_end(ap)` / `va_arg<T>(ap)`: one `va_list` operand (mirrors
// TypeChecker::checkVaListArg).
void sema_check_va_list_arg(Sema* s, string what, *ExprNode e) {
    int n = List_len<*ExprNode>(&e.kids);
    if (n != 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: '%s' takes one argument (a va_list), got %d\n", s.filename, s.line, s.col, what, n);
        return;
    }
    string t = sema_infer_type(s, List_get<*ExprNode>(&e.kids, 0));
    if (t[0] != 0 && sema_streq(sema_canon(s, t), "va_list") == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: '%s' needs a 'va_list', got '%s'\n", s.filename, s.line, s.col, what, t);
    }
}

// ── "did you mean" hints (mirrors TypeChecker::didYouMean) ──
// The suffix ` (did you mean 'x'?)` for an unknown name: the closest candidate by
// case-insensitive edit distance, at most 1 for a name of up to 3 characters and 2
// beyond; a tie goes to the smallest name. `kind` 0 = a variable or function (what is in
// scope, the functions, the enum members), 1 = a type, 2 = a member of a value of type
// `recv` (fields, dot-callable functions, interface methods); for a type, `recv` is the
// spelling the name came from.
string sema_lower(string a) {
    int n = sema_slen(a);
    *uint8 b = alloc<uint8>(n + 1);
    int i = 0;
    while (i < n) {
        int c = (int)a[i];
        if (c >= 65 && c <= 90) {
            c = c + 32;
        }
        b[i] = (uint8)c;
        i = i + 1;
    }
    b[n] = 0;
    return (string)b;
}

// Edit distance with adjacent transpositions (optimal string alignment): `cuont` is one
// change from `count` (mirrors the C++ didYouMean).
int sema_edit_distance(string a, string b) {
    int la = sema_slen(a);
    int lb = sema_slen(b);
    *int prev2 = alloc<int>(lb + 1);
    *int prev = alloc<int>(lb + 1);
    *int cur = alloc<int>(lb + 1);
    int j = 0;
    while (j <= lb) {
        prev[j] = j;
        j = j + 1;
    }
    int i = 1;
    while (i <= la) {
        cur[0] = i;
        j = 1;
        while (j <= lb) {
            int best = prev[j] + 1;
            if (cur[j - 1] + 1 < best) {
                best = cur[j - 1] + 1;
            }
            int sub = prev[j - 1];
            if (a[i - 1] != b[j - 1]) {
                sub = sub + 1;
            }
            if (sub < best) {
                best = sub;
            }
            if (i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] && prev2[j - 2] + 1 < best) {
                best = prev2[j - 2] + 1;
            }
            cur[j] = best;
            j = j + 1;
        }
        *int t = prev2;
        prev2 = prev;
        prev = cur;
        cur = t;
        i = i + 1;
    }
    int d = prev[lb];
    free((*void)prev2);
    free((*void)prev);
    free((*void)cur);
    return d;
}

int sema_starts_with(string t, string pre) {
    int i = 0;
    while (pre[i] != 0) {
        if (t[i] != pre[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// `t` without its pointer stars, spaces and a leading `const`.
string sema_dym_bare(string t0) {
    string t = sema_strip_const(t0);
    while ((int)t[0] == 42 || (int)t[0] == 32) {
        t = sema_sub_str(t, 1, sema_slen(t));
    }
    while (sema_slen(t) > 0 && ((int)t[sema_slen(t) - 1] == 42 || (int)t[sema_slen(t) - 1] == 32)) {
        t = sema_sub_str(t, 0, sema_slen(t) - 1);
    }
    return sema_strip_const(t);
}

// The member names a value of type `recv` offers (C++ completeMembers): its fields and
// inline methods, the `T_m` functions whose first parameter points to T, on an instance
// of a generic G the generic `G_m` functions, and an interface's methods.
void sema_dym_members(Sema* s, string recv, List<string>* out) {
    string t = sema_dealias(s, sema_strip_nullable(sema_strip_const(recv)));
    if (sema_has_star(t) == 0 && sema_slice_elem(t)[0] != 0) {
        List_push<string>(out, "len");
        return;
    }
    string ibt = sema_dym_bare(t);
    string sn = sema_struct_of_type(ibt);
    int gen = sema_has_lt(ibt);
    string nb = sn;
    if (gen == 1) {
        nb = sema_flat_name(ibt);
    }
    *DeclNode sd = sema_find_tdecl(s, sn);
    if (sd != null && (sd.kind == DK_STRUCT || sd.kind == DK_UNION || sd.kind == DK_INTERFACE)) {
        if (sd.kind != DK_INTERFACE) {
            int fi = 0;
            while (fi < List_len<Param>(&sd.params)) {
                List_push<string>(out, List_get<Param>(&sd.params, fi).name);
                fi = fi + 1;
            }
        }
        int mi = 0;
        while (mi < List_len<*DeclNode>(&sd.methods)) {
            List_push<string>(out, List_get<*DeclNode>(&sd.methods, mi).name);
            mi = mi + 1;
        }
    }
    string pre = sema_cat(nb, "_");
    string gpre = sema_cat(sn, "_");
    int i = 0;
    while (i < List_len<*DeclNode>(&s.fndecls)) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        i = i + 1;
        if (List_len<Param>(&d.params) == 0) {
            continue;
        }
        if (List_len<TypeParam>(&d.type_params) > 0) {
            if (gen == 1 && sema_starts_with(d.name, gpre) == 1 && sema_slen(d.name) > sema_slen(gpre)) {
                List_push<string>(out, sema_sub_str(d.name, sema_slen(gpre), sema_slen(d.name)));
            }
            continue;
        }
        if (sema_starts_with(d.name, pre) == 0 || sema_slen(d.name) == sema_slen(pre)) {
            continue;
        }
        string p0 = sema_dealias(s, List_get<Param>(&d.params, 0).ty);
        if (sema_has_star(p0) == 0) {
            continue;
        }
        string pe = sema_dym_bare(sema_dealias(s, sema_dym_bare(p0)));
        string own = sema_struct_of_type(pe);
        if (sema_has_lt(pe) == 1) {
            own = sema_flat_name(pe);
        }
        if (sema_streq(own, nb) == 1) {
            List_push<string>(out, sema_sub_str(d.name, sema_slen(pre), sema_slen(d.name)));
        }
    }
}

// An enum named as a type or value candidate: a non-generic sum type (the C++ enumDecls;
// a classic enum or a generic one is not among them).
int sema_dym_enum(*DeclNode d) {
    return (int)(List_len<TypeParam>(&d.type_params) == 0 && sema_is_plain_enum_decl(d) == 0);
}

string sema_did_you_mean(Sema* s, string name, int kind, string recv) {
    int n = sema_slen(name);
    if (n < 2) {
        return "";
    }
    List<string> c;
    List_init<string>(&c, 64);
    if (kind == 1) {
        List_push<string>(&c, "int");
        List_push<string>(&c, "int8");
        List_push<string>(&c, "int16");
        List_push<string>(&c, "int32");
        List_push<string>(&c, "int64");
        List_push<string>(&c, "uint");
        List_push<string>(&c, "uint8");
        List_push<string>(&c, "uint16");
        List_push<string>(&c, "uint32");
        List_push<string>(&c, "uint64");
        List_push<string>(&c, "float");
        List_push<string>(&c, "double");
        List_push<string>(&c, "bool");
        List_push<string>(&c, "char");
        List_push<string>(&c, "string");
        List_push<string>(&c, "void");
        int ti = 0;
        while (ti < List_len<*DeclNode>(&s.tdecls)) {
            *DeclNode td = List_get<*DeclNode>(&s.tdecls, ti);
            List_push<string>(&c, td.name);          // every declared type, enums of any kind included
            ti = ti + 1;
        }
    } else if (kind == 0) {
        int si = 0;
        while (si < List_len<Sym>(&s.syms)) {
            Sym y = List_get<Sym>(&s.syms, si);
            si = si + 1;
            if (y.depth == 0 && sema_find_fn(s, y.name) < 0) {
                // a global defined later is not in scope yet
                if (StrTab_has(&s.late_globals, y.name) == 1) {
                    continue;
                }
                // a generic enum's variant is not a value by itself
                *DeclNode ve = sema_variant_enum(s, y.name);
                if (ve != null && List_len<TypeParam>(&ve.type_params) > 0) {
                    continue;
                }
            }
            List_push<string>(&c, y.name);
        }
        int di = 0;
        while (di < List_len<*DeclNode>(&s.tdecls)) {
            *DeclNode td = List_get<*DeclNode>(&s.tdecls, di);
            di = di + 1;
            if (td.kind == DK_INTERFACE || td.kind == DK_TYPEALIAS || (td.kind == DK_ENUM && sema_dym_enum(td) == 1)) {
                List_push<string>(&c, td.name);
            }
            if (td.kind == DK_STRUCT && List_len<TypeParam>(&td.type_params) == 0) {   // inline methods are `S_m`
                int mi = 0;
                while (mi < List_len<*DeclNode>(&td.methods)) {
                    List_push<string>(&c, sema_cat(sema_cat(td.name, "_"), List_get<*DeclNode>(&td.methods, mi).name));
                    mi = mi + 1;
                }
            }
        }
    } else {
        sema_dym_members(s, recv, &c);
    }
    int limit = 2;
    if (n <= 3) {
        limit = 1;
    }
    string ln = sema_lower(name);
    string best = "";
    int bestd = limit + 1;
    int i = 0;
    while (i < List_len<string>(&c)) {
        string cand = List_get<string>(&c, i);
        i = i + 1;
        if (cand == null) {
            continue;
        }
        if (cand[0] == 0 || (int)cand[0] == 95 || sema_streq(cand, name) == 1) {
            continue;
        }
        int m = sema_slen(cand);
        if (m > n + limit || n > m + limit) {
            continue;
        }
        int d = sema_edit_distance(ln, sema_lower(cand));
        int longer = m;
        if (n > longer) {
            longer = n;
        }
        if (d >= 2 && d * 3 > longer) {   // two changes need 6 letters (as C++)
            continue;
        }
        if (d < bestd || (d == bestd && strcmp(cand, best) < 0)) {
            bestd = d;
            best = cand;
        }
    }
    if (bestd > limit) {
        return "";
    }
    return sema_cat(sema_cat(" (did you mean '", best), "'?)");
}

// A use of a function declared `deprecated("msg")` warns at its position, once per
// position, outside imported code and generic instances (TypeChecker::noteDeprecatedUse).
// Is `e` a `string` or pointer value (what `==` compares by address)?
int sema_is_addr_ty(Sema* s, *ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_LITERAL && (e.lit_kind == LIT_STRING || e.lit_kind == LIT_NULL)) {
        return 1;
    }
    string t = sema_canon(s, sema_infer_type(s, e));
    if ((int)t[0] == 63) {
        t = sema_sub_str(t, 1, sema_slen(t));
    }
    if (sema_streq(t, "string") == 1 || sema_c_ptr(t) == 1) {
        return 1;
    }
    return 0;
}

// A warning on by default, unless -Wno-<name>; once per position, never in an imported
// declaration or a generic instance (mirrors the C++ noteWarning).
void sema_warn(Sema* s, string name, int line, int col, string msg) {
    if (line <= 0 || s.in_inst == 1 || s.cur_import == 1) {
        return;
    }
    if (sema_in_list(&s.wno, name) == 1) {
        return;
    }
    string key = sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(s.filename, ":"), sema_i64_text((int64)line)), ":"),
                          sema_i64_text((int64)col)), ":"), name);
    if (sema_in_list(&s.depr_seen, key) == 1) {
        return;
    }
    List_push<string>(&s.depr_seen, key);
    if (s.wnone == 1) {
        return;
    }
    if (s.werror == 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: %s [-W%s]\n", s.filename, line, col, msg, name);
        return;
    }
    dprintf(2, "%s:%d:%d: warning: %s [-W%s]\n", s.filename, line, col, msg, name);
}

// A -Wall/-Wextra lint warning (mirrors the C++ TypeChecker::warning): no option suffix,
// never in an imported declaration or a generic instance.
void sema_lint(Sema* s, int line, int col, string msg) {
    if (s.in_inst == 1 || s.cur_import == 1 || s.wnone == 1) {
        return;
    }
    if (s.werror == 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: %s\n", s.filename, line, col, msg);
        return;
    }
    dprintf(2, "%s:%d:%d: warning: %s\n", s.filename, line, col, msg);
}

string sema_addr_key(Sema* s, string name) {
    return sema_cat(sema_cat(sema_i64_text((int64)sema_sym_index(s, name)), ":"), name);
}

int sema_addr_find(Sema* s, string key) {
    int i = List_len<string>(&s.addr_keys) - 1;
    while (i >= 0) {
        if (sema_streq(List_get<string>(&s.addr_keys, i), key) == 1) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

void sema_addr_set(Sema* s, string key, string root) {
    int i = sema_addr_find(s, key);
    if (i >= 0) {
        List_set<string>(&s.addr_roots, i, root);
        return;
    }
    List_push<string>(&s.addr_keys, key);
    List_push<string>(&s.addr_roots, root);
}

void sema_addr_forget(Sema* s, string key) {
    int i = sema_addr_find(s, key);
    if (i >= 0) {
        List_set<string>(&s.addr_keys, i, "");
    }
}

// What `name = rhs` stores (mirrors the C++ trackLocalAddr): a local's address (or
// `name + k` / `name - k`), else anything, which clears it.
void sema_track_addr(Sema* s, string name, *ExprNode rhs) {
    int si = sema_sym_index(s, name);
    if (si < 0 || List_get<Sym>(&s.syms, si).depth < 1) {
        return;
    }
    string key = sema_addr_key(s, name);
    if (rhs != null && rhs.kind == EK_UNARY && sema_streq(rhs.sval, "&") == 1) {
        string root = sema_local_root(s, rhs.a);
        int i = sema_addr_find(s, key);
        if (root[0] != 0 && (i < 0 || List_get<string>(&s.addr_roots, i)[0] != 0)) {
            sema_addr_set(s, key, root);
            return;
        }
    }
    if (rhs != null && rhs.kind == EK_BINARY && (sema_streq(rhs.sval, "+") == 1 || sema_streq(rhs.sval, "-") == 1)
        && rhs.a != null && rhs.a.kind == EK_IDENT && sema_streq(rhs.a.sval, name) == 1) {
        return;
    }
    sema_addr_set(s, key, "");
}

// A struct type as diagnostics show it: no pointer stars, no `struct:` tag.
string sema_packed_shown(string t) {
    string r = t;
    while ((int)r[0] == 42) {
        r = sema_sub_str(r, 1, sema_slen(r));
    }
    while (sema_slen(r) > 0 && (int)r[sema_slen(r) - 1] == 42) {
        r = sema_sub_str(r, 0, sema_slen(r) - 1);
    }
    if (sema_has_sub(r, "struct:") == 1 && (int)r[0] == 115) {
        r = sema_sub_str(r, 7, sema_slen(r));
    }
    return r;
}

// `&s.f` / `&s.a[i]` where the packing of `s`'s struct aligns `f` below its type
// (mirrors the C++ warnPackedAddress).
void sema_warn_packed_addr(Sema* s, *ExprNode u) {
    *ExprNode e = u.a;
    while (e != null && e.kind == EK_INDEX) {
        if (List_len<*ExprNode>(&e.kids) > 0 || sema_is_fixed_arr_ty(sema_infer_type(s, e.a)) == 0) {
            return;
        }
        e = e.a;
    }
    if (e == null || e.kind != EK_MEMBER) {
        return;
    }
    string sn = sema_struct_of_type(sema_infer_type(s, e.a));
    *DeclNode sd = sema_find_struct(s, sn);
    if (sd == null) {
        return;
    }
    int pk = sd.pack_align;
    if (sd.is_packed == 1) {
        pk = 1;
    }
    if (pk <= 0) {
        return;
    }
    int fi = 0;
    int fn_ = List_len<Param>(&sd.params);
    while (fi < fn_) {
        if (sema_streq(List_get<Param>(&sd.params, fi).name, e.sval) == 1) {
            int64 fal = (int64)0;
            int64 fsz = sema_const_layout(s, sema_infer_type(s, u.a), &fal, 0);
            if (fsz > (int64)0 && fal > (int64)pk) {
                sema_warn(s, "address-of-packed-member", u.line, u.col,
                          sema_cat(sema_cat(sema_cat(sema_cat("taking the address of packed member '", e.sval), "' of '"),
                                   sema_packed_shown(sema_infer_type(s, e.a))), "' may give an unaligned pointer"));
            }
            return;
        }
        fi = fi + 1;
    }
}

// -Wall: function `fname` is referenced (a call, a dot-call, a value, an operator, an
// interface's vtable), so it is not unused.
void sema_note_call(Sema* s, string fname) {
    if (fname != null && fname[0] != 0) {
        StrTab_set(&s.called_fns, fname, 1);
    }
}

void sema_note_depr(Sema* s, string fname, int line, int col) {
    if (s.no_depr == 1 || line <= 0 || s.in_inst == 1 || s.cur_import == 1 || fname == null) {
        return;
    }
    string msg = null;
    int i = NameIdx_first(&s.fndecls_ix, fname);
    while (i >= 0) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.depr_msg != null && d.depr_msg[0] != 0) {
            msg = d.depr_msg;
        }
        i = NameIdx_next(&s.fndecls_ix, i);
    }
    if (msg == null) {
        return;
    }
    string key = sema_cat(sema_cat(sema_cat(sema_cat(s.filename, ":"), sema_i64_text((int64)line)), ":"), sema_i64_text((int64)col));
    if (StrTab_has(&s.depr_seen_set, key) == 1) {
        return;
    }
    List_push<string>(&s.depr_seen, key);
    StrTab_set(&s.depr_seen_set, key, 1);
    string tail = "";
    if (sema_streq(msg, " ") == 0) {
        tail = sema_cat(": ", msg);
    }
    if (s.wnone == 1) {
        return;
    }
    if (s.werror == 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: '%s' is deprecated%s\n", s.filename, line, col, fname, tail);
        return;
    }
    dprintf(2, "%s:%d:%d: warning: '%s' is deprecated%s\n", s.filename, line, col, fname, tail);
}

// The folded default values of a function's parameters (C++ TypeChecker::paramDefaultsOf),
// by key: a top-level function (`sd` null) or the inline method `mname` of struct `sd`
// (then the list starts with the implicit `self`). A default is a literal or an integer
// constant expression, folded in the global scope; each call site gets a fresh literal.
// Errors are reported once. Returns the index of the list in s.pd_lists.
// The names a default reads are uses (definition, hover), recorded for a function of
// the primary file even from a call in a generic instance (the C++ paramDefaultsOf).
void sema_pdef_uses(Sema* s, *ExprNode e) {
    if (e == null) {
        return;
    }
    if (e.kind == EK_IDENT) {
        if (e.line > 0) {
            sema_tool_useloc(s, e.line, e.col, e.sval);
        }
        return;
    }
    sema_pdef_uses(s, e.a);
    sema_pdef_uses(s, e.b);
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        sema_pdef_uses(s, List_get<*ExprNode>(&e.kids, i));
        i = i + 1;
    }
}

int sema_pdefs(Sema* s, string key, *DeclNode sd, string mname) {
    int cached = StrTab_get(&s.pd_ix, key, -1);
    if (cached >= 0) {
        return cached;
    }
    let out: List<*ExprNode>;
    List_init<*ExprNode>(&out, 4);
    let decls: List<*DeclNode>;
    List_init<*DeclNode>(&decls, 2);
    if (sd != null) {
        int j = 0;
        while (j < List_len<*DeclNode>(&sd.methods)) {
            *DeclNode md = List_get<*DeclNode>(&sd.methods, j);
            if (sema_streq(md.name, mname) == 1) {
                List_push<*DeclNode>(&decls, md);
            }
            j = j + 1;
        }
    } else {
        int i = NameIdx_first(&s.fndecls_ix, key);
        while (i >= 0) {
            *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
            if (d.kind == DK_FUNCTION) {
                List_push<*DeclNode>(&decls, d);
            }
            i = NameIdx_next(&s.fndecls_ix, i);
        }
    }
    *DeclNode fd = null;
    int k = 0;
    while (k < List_len<*DeclNode>(&decls)) {
        *DeclNode d = List_get<*DeclNode>(&decls, k);
        k = k + 1;
        if (List_len<*ExprNode>(&d.param_defaults) == 0) {
            continue;
        }
        if (fd != null) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: default values of '%s' are given twice (give them on one declaration)\n",
                    s.filename, d.line, d.col, key);
            continue;
        }
        fd = d;
    }
    int idx = List_len<List<*ExprNode>>(&s.pd_lists);
    StrTab_set(&s.pd_ix, key, idx);
    if (fd != null) {
        int generic_owner = 0;
        if (sd != null && List_len<TypeParam>(&sd.type_params) > 0) {
            generic_owner = 1;
        }
        if (sd != null) {
            List_push<*ExprNode>(&out, null);
        }
        int seen = 0;
        int i = 0;
        int n = List_len<Param>(&fd.params);
        while (i < n) {
            Param pm = List_get<Param>(&fd.params, i);
            *ExprNode def = null;
            if (i < List_len<*ExprNode>(&fd.param_defaults)) {
                def = List_get<*ExprNode>(&fd.param_defaults, i);
            }
            i = i + 1;
            if (sema_streq(pm.ty, "...") == 1) {
                if (seen == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: '%s' is variadic: its parameters cannot have default values\n",
                            s.filename, fd.line, fd.col, key);
                }
                List_push<*ExprNode>(&out, null);
                continue;
            }
            if (def == null) {
                if (seen == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: parameter '%s' needs a default value: it follows a parameter that has one\n",
                            s.filename, fd.line, fd.col, pm.name);
                }
                List_push<*ExprNode>(&out, null);
                continue;
            }
            seen = 1;
            if (fd.from_import == 0) {
                int was_inst = s.in_inst;
                int was_import = s.cur_import;
                s.in_inst = 0;
                s.cur_import = 0;
                sema_pdef_uses(s, def);
                s.in_inst = was_inst;
                s.cur_import = was_import;
            }
            if (generic_owner == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: a method of generic struct '%s' cannot have default values\n",
                        s.filename, def.line, def.col, sd.name);
                List_push<*ExprNode>(&out, null);
                continue;
            }
            *ExprNode lit = sema_fold_pdef(s, def);
            if (lit == null) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: default value of parameter '%s' is not a constant (a literal, an integer constant expression or a struct literal of those)\n",
                        s.filename, def.line, def.col, pm.name);
                List_push<*ExprNode>(&out, null);
                continue;
            }
            if (List_len<TypeParam>(&fd.type_params) == 0) {   // its type is checked where it is declared
                if (lit.kind == EK_STRUCTINIT) {
                    sema_expr(s, lit);             // its fields, as C++ lit->accept(this)
                }
                string derr = sema_assign_err(s, pm.ty, lit);
                if (derr[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: default value of parameter '%s': %s\n",
                            s.filename, def.line, def.col, pm.name, derr);
                }
            }
            List_push<*ExprNode>(&out, lit);
        }
    }
    List_push<List<*ExprNode>>(&s.pd_lists, out);
    return idx;
}

// A parameter default folded to a constant (C++ TypeChecker::foldParamDefault): a
// literal, a negative float literal, an integer constant expression folded in the global
// scope, or a struct literal whose values are all of these. Null when it is none of them.
*ExprNode sema_fold_pdef(Sema* s, *ExprNode def) {
    *ExprNode lit = null;
    if (def.kind == EK_LITERAL) {
        lit = ast_new_expr();
        lit.kind = EK_LITERAL;
        lit.lit_kind = def.lit_kind;
        lit.sval = def.sval;
        lit.slen = def.slen;
        return lit;
    }
    if (def.kind == EK_UNARY && sema_streq(def.sval, "-") == 1 && def.a != null
        && def.a.kind == EK_LITERAL && def.a.lit_kind == LIT_FLOAT) {
        lit = ast_new_expr();
        lit.kind = EK_LITERAL;
        lit.lit_kind = LIT_FLOAT;
        lit.sval = sema_cat("-", def.a.sval);
        return lit;
    }
    if (def.kind == EK_STRUCTINIT) {
        lit = ast_new_expr();
        lit.kind = EK_STRUCTINIT;
        lit.sval = def.sval;
        lit.line = def.line;
        lit.col = def.col;
        List_init<*ExprNode>(&lit.kids, 4);
        List_init<string>(&lit.names, 4);
        int i = 0;
        while (i < List_len<*ExprNode>(&def.kids)) {
            *ExprNode k = List_get<*ExprNode>(&def.kids, i);
            *ExprNode v = null;
            if (k != null) {
                v = sema_fold_pdef(s, k);
            }
            if (v == null) {
                return null;
            }
            v.line = k.line;
            v.col = k.col;
            List_push<*ExprNode>(&lit.kids, v);
            List_push<string>(&lit.names, List_get<string>(&def.names, i));
            i = i + 1;
        }
        return lit;
    }
    int64 v = (int64)0;
    s.global_only = 1;
    int ok = sema_fold_int(s, def, &v);
    s.global_only = 0;
    if (ok == 1) {
        lit = ast_new_expr();
        lit.kind = EK_LITERAL;
        lit.lit_kind = LIT_INT;
        lit.sval = sema_i64_text(v);
    }
    return lit;
}

// A fresh copy of a folded default (a literal, or a struct literal of them) at a call.
*ExprNode sema_clone_pdef(*ExprNode d, int line, int col) {
    *ExprNode out = ast_new_expr();
    out.kind = d.kind;
    out.line = line;
    out.col = col;
    out.sval = d.sval;
    if (d.kind == EK_LITERAL) {
        out.lit_kind = d.lit_kind;
        out.slen = d.slen;
        return out;
    }
    List_init<*ExprNode>(&out.kids, 4);
    List_init<string>(&out.names, 4);
    int i = 0;
    while (i < List_len<*ExprNode>(&d.kids)) {
        List_push<*ExprNode>(&out.kids, sema_clone_pdef(List_get<*ExprNode>(&d.kids, i), line, col));
        List_push<string>(&out.names, List_get<string>(&d.names, i));
        i = i + 1;
    }
    return out;
}

// A call that omits trailing arguments with default values gets a copy of each, at the
// call's position (C++ TypeChecker::fillDefaultArgs): direct calls of a function not
// hidden by a variable, and dot-calls of an inline method.
void sema_fill_defaults(Sema* s, *ExprNode e) {
    string key = "";
    *DeclNode sd = null;
    string mname = "";
    int given = List_len<*ExprNode>(&e.kids);
    if (e.kind == EK_TEMPLATECALL) {   // an explicit generic call `f<int>(x)`
        key = sema_base_name(e.sval);
        if (sema_find_fndecl(s, key) == null) {
            return;
        }
    } else if (e.a == null) {
        return;
    } else if (e.a.kind == EK_IDENT) {
        if (sema_lookup(s, e.a.sval) == 1 && sema_find_fndecl(s, e.a.sval) == null) {
            return;
        }
        if (sema_local_bound(s, e.a.sval) == 1) {
            return;
        }
        key = e.a.sval;
        if (sema_find_fndecl(s, key) == null) {
            return;
        }
    } else if (e.a.kind == EK_MEMBER) {
        string bt = sema_dealias(s, sema_infer_type(s, e.a.a));
        if (sema_is_ptrish(bt) == 1 && sema_streq(bt, "string") == 0) {
            bt = sema_dealias(s, sema_pointee(bt));
        }
        bt = sema_strip_const(sema_strip_nullable(bt));
        sd = sema_find_struct(s, bt);
        if (sd == null) {
            // a generic `S_m<T>(S<T>* self, ...)` on an instance of S (C++ checkGenericMethodCall)
            *DeclNode gsd = sema_find_struct(s, sema_base_name(bt));
            if (gsd == null || List_len<TypeParam>(&gsd.type_params) == 0 || sema_field_index(gsd, e.a.sval) >= 0) {
                return;
            }
            key = sema_cat(sema_cat(sema_base_name(bt), "_"), e.a.sval);
            *DeclNode gfn = sema_find_fndecl(s, key);
            if (gfn == null || List_len<TypeParam>(&gfn.type_params) == 0 || List_len<Param>(&gfn.params) == 0) {
                return;
            }
            mname = e.a.sval;
        } else {
            if (sema_field_index(sd, e.a.sval) >= 0) {
                return;
            }
            mname = e.a.sval;
            key = sema_cat(sema_cat(bt, "_"), mname);
            int has = 0;
            int j = 0;
            while (j < List_len<*DeclNode>(&sd.methods)) {
                if (sema_streq(List_get<*DeclNode>(&sd.methods, j).name, mname) == 1) {
                    has = 1;
                }
                j = j + 1;
            }
            if (has == 0) {
                if (sema_find_fndecl(s, key) == null) {
                    return;
                }
                sd = null;                         // a top-level `T_m(self, ...)` called with dot syntax
            }
        }
        given = given + 1;
    } else {
        return;
    }
    List<*ExprNode> defs = List_get<List<*ExprNode>>(&s.pd_lists, sema_pdefs(s, key, sd, mname));
    int n = List_len<*ExprNode>(&defs);
    if (given >= n) {
        return;
    }
    int i = given;
    while (i < n) {
        if (List_get<*ExprNode>(&defs, i) == null) {
            return;
        }
        i = i + 1;
    }
    i = given;
    while (i < n) {
        List_push<*ExprNode>(&e.kids, sema_clone_pdef(List_get<*ExprNode>(&defs, i), e.line, e.col));
        i = i + 1;
    }
}

// The canonical type of field `fname` of the struct spelled `t` (a generic instance's
// type arguments substituted), or "" when there is no such field.
string sema_q_field(Sema* s, string t, string fname) {
    *DeclNode d = sema_find_struct(s, sema_struct_of_type(t));
    if (d == null || sema_pointee(t)[0] != 0) {
        return "";
    }
    int i = 0;
    while (i < List_len<Param>(&d.params)) {
        Param f = List_get<Param>(&d.params, i);
        if (sema_streq(f.name, fname) == 1) {
            string ft = f.ty;
            if (List_len<TypeParam>(&d.type_params) > 0) {
                List<string> targs;
                List_init<string>(&targs, 2);
                sema_parse_targs(t, &targs);
                ft = sema_subst_params(ft, &d.type_params, &targs);
            }
            return sema_canon(s, ft);
        }
        i = i + 1;
    }
    return "";
}

void sema_expr_k(Sema* s, *ExprNode e) {
    if (e != null && (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL)) {
        sema_fill_defaults(s, e);
    }
    if (e == null) {
        return;
    }
    int k = e.kind;
    if (k == EK_IDENT) {
        if (s.tool != 0) {
            if (sema_streq(e.sval, "__eskiu_complete__") == 1) {
                sema_tool_complete_scope(s);
                return;
            }
            sema_tool_ident(s, e);
        }
        sema_mark_used(s, e.sval);
        if (s.wall == 1) {
            sema_note_capture(s, e.sval);
        }
        if (sema_find_fn(s, e.sval) >= 0) {
            sema_note_call(s, e.sval);
            sema_note_depr(s, e.sval, e.line, e.col);
        }
        // va_start/va_end are variadic-access builtins with no declaration (va_arg<T> is a
        // template call). Treat them as defined, matching the C++ checker.
        if ((sema_lookup(s, e.sval) == 0
             || (sema_local_bound(s, e.sval) == 0 && StrTab_has(&s.late_globals, e.sval) == 1)
             || sema_script_late(s, e.sval, e.line, e.col) == 1)
            && sema_streq(e.sval, "va_start") == 0 && sema_streq(e.sval, "va_end") == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: undefined variable '%s'%s\n", s.filename, s.line, s.col, e.sval, sema_did_you_mean(s, e.sval, 0, ""));
        } else if (sema_sym_depth(s, e.sval) <= 0) {
            // A generic enum's variant does not name its type arguments by itself (they
            // are not inferred from the target type): `None<int>()` (mirrors the C++).
            *DeclNode gve = sema_variant_enum(s, e.sval);
            int gvi = -1;
            int gpl = 0;
            if (gve != null) {
                gvi = sema_variant_index(gve, e.sval);
            }
            if (gvi >= 0 && gvi < List_len<List<string>>(&gve.payloads)) {
                List<string> gpv = List_get<List<string>>(&gve.payloads, gvi);
                gpl = List_len<string>(&gpv);
            }
            if (gve != null && List_len<TypeParam>(&gve.type_params) > 0 && gvi >= 0 && gpl == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: variant '%s' of generic enum '%s' needs explicit type arguments, as in %s<int>()\n",
                        s.filename, s.line, s.col, e.sval, gve.name, e.sval);
            }
            if (gve != null && List_len<TypeParam>(&gve.type_params) == 0 && gpl > 0
                && sema_streq(e.sval, s.callee_ctx) == 0 && sema_find_fndecl(s, e.sval) == null) {
                s.had_error = 1;                   // a payload variant is built by a call: `A(1)`
                dprintf(2, "error: %s:%d:%d: variant '%s' needs %d argument(s)\n", s.filename, s.line, s.col, e.sval, gpl);
            }
        }
        // Escape soundness: a non-escaping closure param used anywhere but as the
        // immediate callee of a call escapes.
        if (sema_in_list(&s.watched, e.sval) == 1
            && (sema_streq(e.sval, s.callee_ctx) == 0 || sema_captured_by_escaping(s, e.sval) == 1)) {
            if (sema_in_list(&s.escaped, e.sval) == 0) {
                List_push<string>(&s.escaped, e.sval);
            }
        }
        if (sema_in_list(&s.wlocals, e.sval) == 1 && sema_streq(e.sval, s.callee_ctx) == 0
            && sema_in_list(&s.wlocals_esc, e.sval) == 0) {
            List_push<string>(&s.wlocals_esc, e.sval);
        }
        if (sema_in_list(&s.wlocals, e.sval) == 1) {
            sema_note_local_capture(s, e.sval);
        }
        return;
    }
    if (k == EK_SIZEOF && e.a != null) {   // sizeof(expr): checked, never evaluated
        sema_expr(s, e.a);
        string zt = sema_infer_type(s, e.a);
        if (sema_is_void_value(sema_resolve_scalar(s, zt)) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: sizeof of 'void': a void value has no size\n", s.filename, s.line, s.col);
        }
        return;
    }
    if (k == EK_SIZEOF) {                  // sizeof(T) or sizeof(variable): T must be a known type
        if (sema_known_type(s, e.sval) == 0) {   // sizeof(variable) reads its name
            sema_mark_used(s, e.sval);
        }
        *DeclNode szd = sema_find_tdecl(s, e.sval);
        if (sema_lookup(s, e.sval) == 0 && szd != null && List_len<TypeParam>(&szd.type_params) > 0
            && sema_in_list(&s.tparams, e.sval) == 0) {
            s.had_error = 1;                // a generic type has no size until instantiated
            dprintf(2, "error: %s:%d:%d: unknown type '%s'%s\n", s.filename, s.line, s.col, e.sval, sema_did_you_mean(s, e.sval, 1, ""));
        }
        // A variable: a typed symbol, not a function, an enum member, or a later global.
        int szvar = 0;
        if (sema_lookup(s, e.sval) == 1 && (sema_local_bound(s, e.sval) == 1
            || (sema_lookup_type(s, e.sval)[0] != 0 && StrTab_has(&s.late_globals, e.sval) == 0))) {
            szvar = 1;
        }
        if (szvar == 0 && sema_known_type(s, e.sval) == 0) {
            s.had_error = 1;
            string utn = sema_base_name(sema_struct_of_type(e.sval));
            dprintf(2, "error: %s:%d:%d: unknown type '%s'%s\n", s.filename, s.line, s.col, utn, sema_did_you_mean(s, utn, 1, e.sval));
        }
        if (sema_lookup(s, e.sval) == 0 && sema_is_void_value(sema_resolve_scalar(s, sema_isub(s, e.sval))) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: sizeof of 'void': a void value has no size\n", s.filename, s.line, s.col);
        }
        return;
    }
    if (k == EK_LITERAL) {
        return;
    }
    if (k == EK_BINARY && sema_is_assign(e.sval) == 0) {
        sema_binary_chain(s, e);
        return;
    }
    if (k == EK_BINARY) {                              // an assignment (`=` or compound)
        // A compound assignment `x op= lit` (desugared to `x = x op lit`, sharing the target
        // node) stores into x's type, so its literal operand must fit it, as for `x = lit`.
        if (sema_streq(e.sval, "=") == 1 && e.b != null && e.b.kind == EK_BINARY && e.b.a == e.a
            && sema_streq(e.b.sval, "<<") == 0 && sema_streq(e.b.sval, ">>") == 0
            && e.b.b != null && e.b.b.kind == EK_LITERAL && e.b.b.lit_kind == LIT_INT) {
            string ct = sema_strip_const(sema_infer_type(s, e.a));
            if (sema_is_int_ty(ct) == 1 && sema_int_lit_fits(ct, e.b.b.sval) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: compound assignment: integer literal %s is out of range for '%s'\n", s.filename, s.line, s.col, e.b.b.sval, ct);
            }
        }
        // A script global's initializer in the implicit main was checked at its declaration.
        if (sema_streq(e.sval, "=") == 1 && e.a != null && e.script_init == 0) {
            string alt = sema_infer_type(s, e.a);
            if (e.a.kind == EK_IDENT) {   // declared type, even if narrowed
                alt = sema_lookup_type(s, e.a.sval);
            }
            sema_infer_variant(s, e.b, alt);
            if (e.b != null && e.b.kind == EK_ARRAYLIT) {
                // A `{...}` literal is only an initializer (mirrors the C++ assignability).
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: assignment: cannot convert 'array-literal' to '%s'\n", s.filename, s.line, s.col, alt);
            } else if (alt[0] != 0) {
                string aerr = sema_assign_err(s, alt, e.b);
                if (aerr[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: assignment: %s\n", s.filename, s.line, s.col, aerr);
                }
            }
        }
        if (sema_is_slice_len(s, e.a) == 1) {
            sema_error(s, "cannot assign to the length of a slice: it is read-only (take a new slice instead)");
        } else if (sema_streq(e.sval, "=") == 1 && sema_is_lvalue(s, e.a) == 0) {
            sema_error(s, "cannot assign to this expression: it is not a variable, field, element, or dereference");
        }
        if (sema_is_assign(e.sval) == 1 && sema_is_readonly_lvalue(s, e.a) == 1) {
            sema_error(s, "cannot assign to read-only location");
        }
        if (sema_is_assign(e.sval) == 1) {
            sema_check_captured_write(s, e.a);
        }
        if (sema_is_assign(e.sval) == 1 && e.a != null && e.a.kind == EK_IDENT) {
            if (sema_streq(e.sval, "=") == 1) {
                sema_track_addr(s, e.a.sval, e.b);
            }
            else if (sema_streq(e.sval, "+=") == 0 && sema_streq(e.sval, "-=") == 0) {
                sema_track_addr(s, e.a.sval, null);
            }
            // -Wall: a local's address stored in a global dangles once the function returns
            // (main's locals outlive every use).
            if (s.wall == 1 && sema_streq(e.sval, "=") == 1 && e.b != null && e.b.kind == EK_UNARY
                && sema_streq(e.b.sval, "&") == 1 && sema_sym_depth(s, e.a.sval) == 0
                && (s.addr_fn == null || sema_streq(s.addr_fn, "main") == 0)) {
                string groot = sema_local_root(s, e.b.a);
                if (groot[0] != 0) {
                    sema_lint(s, e.line, e.col, sema_cat(sema_cat(sema_cat(sema_cat("storing the address of local '", groot), "' in global '"),
                              e.a.sval), "' (it dangles once the function returns)"));
                }
            }
        }
        // `f = <lambda>` rebinds a lambda local: the target is not a use of f's value, and
        // the lambda is bound to f like an initializer (mirrors the C++ visit(BinaryExpr)).
        int lam_rebind = 0;
        if (sema_streq(e.sval, "=") == 1 && e.a != null && e.a.kind == EK_IDENT && e.b != null
            && e.b.kind == EK_LAMBDA && s.in_inst == 0 && sema_in_list(&s.wlocals, e.a.sval) == 1) {
            lam_rebind = 1;
        }
        string saved_callee = s.callee_ctx;
        if (lam_rebind == 1) {
            s.callee_ctx = e.a.sval;
        }
        sema_expr(s, e.a);
        s.callee_ctx = saved_callee;
        if (sema_streq(e.sval, "=") == 1 && e.script_init == 0) {
            sema_hint_iface(s, e.b, sema_infer_type(s, e.a));
        }
        if (lam_rebind == 1) {
            s.lam_local = e.a.sval;
        }
        if (e.script_init == 0) {
            sema_expr(s, e.b);
        }
        if (lam_rebind == 1) {
            s.lam_local = "";
            List_push<*ExprNode>(&s.wlam, e.b);
            List_push<string>(&s.wlam_name, e.a.sval);
            List_push<int>(&s.wlam_async, s.in_async);
        }
        // `p = ...` ends p's narrowing unless it stores an address `&x` or steps the pointer
        // itself (`p = p + k`, `p += k`).
        int keeps = 0;
        if (e.b != null && e.b.kind == EK_UNARY && sema_streq(e.b.sval, "&") == 1) {
            keeps = 1;
        }
        if (e.b != null && e.b.kind == EK_BINARY && (sema_streq(e.b.sval, "+") == 1 || sema_streq(e.b.sval, "-") == 1)
            && e.b.a != null && e.b.a.kind == EK_IDENT && e.a != null && e.a.kind == EK_IDENT
            && sema_streq(e.b.a.sval, e.a.sval) == 1) {
            keeps = 1;
        }
        if (sema_streq(e.sval, "=") == 1 && e.a != null && e.a.kind == EK_IDENT && keeps == 0) {
            string nk = sema_nkey(s, e.a.sval);
            if (nk[0] != 0) {
                sema_narrow_drop(s, nk);
            }
        }
        return;
    }
    if (k == EK_INCDEC) {                              // ++x / x++ etc.
        // The operand must be a modifiable lvalue: an ident, field, element, or deref
        // (not a literal or other rvalue like `5++`).
        if (e.a == null || (e.a.kind != EK_IDENT && e.a.kind != EK_MEMBER && e.a.kind != EK_INDEX
            && (e.a.kind != EK_UNARY || sema_streq(e.a.sval, "*") == 0))) {
            sema_error(s, "'++'/'--' requires a modifiable variable");
        } else if (sema_is_slice_len(s, e.a) == 1) {
            sema_error(s, "cannot assign to the length of a slice: it is read-only (take a new slice instead)");
        } else if (sema_is_readonly_lvalue(s, e.a) == 1) {
            sema_error(s, "cannot modify read-only location");
        } else {
            string it = sema_infer_type(s, e.a);         // integer or pointer only (C++ rule)
            string ic = sema_canon(s, it);
            *DeclNode ied = sema_find_tdecl(s, sema_strip_const(it));   // an enum value is not an integer here
            if ((ied != null && ied.kind == DK_ENUM)
                || (sema_judgeable(s, ic) == 1 && sema_is_int_ty(ic) == 0 && sema_c_ptr(ic) == 0)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: '++'/'--' requires an integer or pointer, got '%s'\n", s.filename, s.line, s.col, it);
            }
        }
        sema_check_captured_write(s, e.a);
        sema_expr(s, e.a);
        return;
    }
    if (k == EK_ARRAYLIT) {                            // { e0, e1, ... }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            sema_expr(s, List_get<*ExprNode>(&e.kids, i));
            i = i + 1;
        }
        return;
    }
    if (k == EK_TERNARY) {                             // cond ? then : else
        sema_expr(s, e.a);
        *ExprNode elseE = List_get<*ExprNode>(&e.kids, 0);
        string ihint = sema_hint_of(s, e);
        if (ihint[0] != 0) {   // nested arms too
            sema_hint_iface(s, e.b, ihint);
            sema_hint_iface(s, elseE, ihint);
        }
        List<string> tkeys;
        List_init<string>(&tkeys, 2);
        List<string> tins;
        List_init<string>(&tins, 2);
        sema_cond_narrow(s, e.a, 1, &tkeys);
        sema_narrow_apply(s, &tkeys, &tins);
        sema_expr(s, e.b);
        sema_narrow_undo(s, &tins);
        List<string> fkeys;
        List_init<string>(&fkeys, 2);
        List<string> fins;
        List_init<string>(&fins, 2);
        sema_cond_narrow(s, e.a, 0, &fkeys);
        sema_narrow_apply(s, &fkeys, &fins);
        sema_expr(s, elseE);
        sema_narrow_undo(s, &fins);
        string cty = sema_infer_type(s, e.a);
        string ccn = sema_canon(s, cty);
        if (sema_judgeable(s, ccn) == 1 && sema_is_numeric_ty(ccn) == 0 && sema_c_ptr(ccn) == 0 && sema_is_iface_val(s, cty) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: ternary condition must be a bool, integer, or pointer, got %s\n", s.filename, s.line, s.col, cty);
        }
        // The two arms need a common type: same, both numeric, or both pointer-like.
        // Conservative: only flag when both arm types are known.
        string tt = sema_infer_type(s, e.b);
        string et = sema_infer_type(s, elseE);
        if (tt[0] != 0 && et[0] != 0 && sema_streq(tt, "unknown") == 0 && sema_streq(et, "unknown") == 0) {
            int ok = 0;
            if (sema_streq(tt, et) == 1) {
                ok = 1;
            }
            else if (sema_is_numeric_ty(tt) == 1 && sema_is_numeric_ty(et) == 1) {
                ok = 1;
            }
            else if (sema_is_ptrish(tt) == 1 && sema_is_ptrish(et) == 1
                     && (sema_streq(tt, "null") == 1 || sema_streq(et, "null") == 1 || sema_ptr_compat(s, tt, et) == 1)) {
                ok = 1;
            }
            // Bound for an interface: each arm that converts to it is boxed there.
            else if (ihint[0] != 0 && sema_assign_strict(s, ihint, tt)[0] == 0 && sema_assign_strict(s, ihint, et)[0] == 0) {
                ok = 1;
            }
            // One arm converts to the other's type (a `*Sq` arm meets an interface arm as
            // the interface, mirrors the C++ ternary).
            else if (sema_assign_strict(s, tt, et)[0] == 0 || sema_assign_strict(s, et, tt)[0] == 0) {
                ok = 1;
            }
            if (ok == 0) {
                sema_error(s, "ternary branches have incompatible types");
            }
        }
        return;
    }
    if (k == EK_AWAIT) {
        if (s.in_async == 0 && s.in_trailing == 1) {
            sema_error(s, "await is not allowed in a trailing block (the block is a closure)");
        } else if (s.in_async == 0) {
            sema_error(s, "await is only allowed inside an async function");
        }
        s.await_seen = 1;
        sema_expr(s, e.a);
        string awt = sema_infer_type(s, e.a);         // the operand is a `*Future<T>`
        string awc = sema_canon(s, awt);
        if (sema_judgeable(s, awc) == 1 && sema_future_inner(s, awt)[0] == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: await expects a *Future<T>, got %s\n", s.filename, s.line, s.col, awt);
        }
        return;
    }
    if (k == EK_MEMBER) {
        // A chain `a.b.c...` is walked once, innermost member first, carrying the type of
        // each base forward: re-walking and re-inferring every base from scratch costs
        // time quadratic in the chain's length.
        List<*ExprNode> chain;
        List_init<*ExprNode>(&chain, 4);
        *ExprNode base = e;
        while (base != null && base.kind == EK_MEMBER) {
            List_push<*ExprNode>(&chain, base);
            base = base.a;
        }
        // Each member reports at its own position, else at its nearest positioned
        // enclosing member's (as the recursive walk would).
        int pl = s.line;
        int pc = s.col;
        List<int> lines;
        List_init<int>(&lines, 4);
        List<int> cols;
        List_init<int>(&cols, 4);
        int ln = pl;
        int cl = pc;
        int cj = 0;
        while (cj < List_len<*ExprNode>(&chain)) {
            *ExprNode mj = List_get<*ExprNode>(&chain, cj);
            if (cj > 0 && mj.line > 0) {
                ln = mj.line;
                cl = mj.col;
            }
            List_push<int>(&lines, ln);
            List_push<int>(&cols, cl);
            cj = cj + 1;
        }
        s.line = ln;
        s.col = cl;
        sema_expr(s, base);                // walk base (catches undefined vars in it)
        string bt = sema_infer_type(s, base);
        int ci = List_len<*ExprNode>(&chain) - 1;
        *ExprNode mbase = base;            // the base of the member being checked
        while (ci >= 0) {
            *ExprNode m = List_get<*ExprNode>(&chain, ci);
            s.line = List_get<int>(&lines, ci);
            s.col = List_get<int>(&cols, ci);
            if (bt[0] == 63) {             // a `?…` nullable pointer base (sema_check_nullable_deref)
                s.had_error = 1;
                int bl = s.line;   // at the base pointer (as the C++ checker)
                int bc = s.col;
                if (mbase != null && mbase.line > 0) {
                    bl = mbase.line;
                    bc = mbase.col;
                }
                dprintf(2, "error: %s:%d:%d: cannot %s a possibly-null pointer of type '%s'; check it first (e.g. `if (x != null)`)\n",
                       s.filename, bl, bc, "access a member of", bt);
            }
            mbase = m;
            if (s.tool != 0) {
                if (s.tool == 3 && sema_streq(m.sval, "__eskiu_complete__") == 1) {
                    sema_tool_complete_members(s, bt);
                }
                sema_tool_field(s, m, bt);
            }
            // Only a struct or union (or a pointer to one) has members; a slice has `len`.
            string mbc = sema_canon(s, bt);
            if ((int)mbc[0] == 42) {
                mbc = sema_sub_str(mbc, 1, sema_slen(mbc));
            }
            if (sema_judgeable(s, mbc) == 1 && sema_is_struct(s, sema_base_name(mbc)) == 0
                && (sema_slice_elem(mbc)[0] == 0 || sema_streq(m.sval, "len") == 0)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot access member '%s' on non-struct type '%s'\n", s.filename, s.line, s.col, m.sval, bt);
            }
            int btn = 0;
            while (bt[btn] != 0) {
                btn = btn + 1;
            }
            // An array/slice base (`Box<int>[]`) is not its element struct (`s.len`).
            if (bt[0] != 0 && (int)bt[btn - 1] != 93) {   // base type known → validate the member
                string sn = sema_struct_of_type(bt);
                if (sema_is_struct(s, sn) == 1 && (sema_has_member(s, sema_cat(sema_cat(sn, "."), m.sval)) == 0
                                                   || sema_field_type(s, sn, m.sval) == null)) {
                    s.had_error = 1;               // (a method is only called, never a value)
                    dprintf(2, "error: %s:%d:%d: struct '%s' has no member '%s'%s\n", s.filename, s.line, s.col, sn, m.sval, sema_did_you_mean(s, m.sval, 2, bt));
                }
            }
            bt = sema_dealias(s, sema_member_type(s, bt, m.sval));
            if (s.tool == 1 && ci > 0) {   // an inner member of the chain
                sema_tool_expr(s, m);
            }
            ci = ci - 1;
        }
        s.line = pl;
        s.col = pc;
        List_free<*ExprNode>(&chain);
        List_free<int>(&lines);
        List_free<int>(&cols);
        return;
    }
    if (k == EK_QUESTION) {            // `expr?` propagates an Err into the enclosing function
        if (s.fin_depth > 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: '?' is not allowed inside a finally block (it would return from the function)\n", s.filename, s.line, s.col);
        }
        sema_expr(s, e.a);
        // The enclosing function must return the SAME Result-like type as the operand
        // (a struct with `ok`/`value` fields; the type name, not a literal "Result"). The
        // self-host tracks struct names but not fields, so it compares the struct names and
        // skips when either is unknown (matching C++'s ret == operand-type check).
        string qt = sema_infer_type(s, e.a);
        string opn = sema_struct_of_type(qt);
        string retn = sema_struct_of_type(s.cur_ret);
        if (qt[0] != 0) {                  // the operand must be Result-like (`ok` + `value` fields)
            *DeclNode qd = sema_find_struct(s, opn);
            int okf = 0;
            int valf = 0;
            string okty = "";
            if (qd != null && sema_pointee(qt)[0] == 0) {   // a Result, not a pointer to one
                int qi = 0;
                int qn = List_len<Param>(&qd.params);
                while (qi < qn) {
                    string fnm = List_get<Param>(&qd.params, qi).name;
                    if (sema_streq(fnm, "ok") == 1) {
                        okf = 1;
                        okty = List_get<Param>(&qd.params, qi).ty;
                    }
                    if (sema_streq(fnm, "value") == 1) {
                        valf = 1;
                    }
                    qi = qi + 1;
                }
            }
            if ((okf == 0 || valf == 0) && (qd != null || sema_is_numeric_ty(qt) == 1 || sema_is_ptrish(qt) == 1)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: `?` operator requires a Result-like value (with `ok` and `value` fields), got %s\n", s.filename, s.line, s.col, qt);
            } else if (okf == 1 && valf == 1) {
                // `?` tests `ok` as a flag (zero is the error): an integer or a bool.
                if (List_len<TypeParam>(&qd.type_params) > 0) {
                    List<string> qtargs;
                    List_init<string>(&qtargs, 2);
                    sema_parse_targs(qt, &qtargs);
                    okty = sema_subst_params(okty, &qd.type_params, &qtargs);
                }
                string okc = sema_canon(s, okty);
                if (sema_judgeable(s, okc) == 1 && sema_is_int_ty(okc) == 0 && sema_streq(okc, "bool") == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: `?` needs an integer or bool `ok` field, got '%s'\n", s.filename, s.line, s.col, okty);
                }
            }
        }
        // Same base name but different type args (`Result<int,string>` in a function
        // returning `Result<int64,string>`) is also a mismatch: compare the full spellings.
        string opt = sema_nospace(sema_infer_type(s, e.a));
        string rett = sema_nospace(s.cur_ret);
        int mismatch = 0;
        if (opn[0] != 0 && retn[0] != 0 && sema_streq(opn, retn) == 0) {
            mismatch = 1;
        }
        if (mismatch == 0 && opn[0] != 0 && retn[0] != 0 && sema_has_lt(opt) == 1 && sema_has_lt(rett) == 1
            && sema_streq(opt, rett) == 0) {
            mismatch = 1;
        }
        // A Result with the same error (and `ok`) type takes the error too: `Result<String, E>?`
        // in a `Result<int, E>` function (mirrors the C++).
        if (mismatch == 1) {
            string oe = sema_q_field(s, sema_infer_type(s, e.a), "error");
            string re = sema_q_field(s, s.cur_ret, "error");
            if (oe[0] != 0 && sema_streq(oe, re) == 1
                && sema_streq(sema_q_field(s, sema_infer_type(s, e.a), "ok"), sema_q_field(s, s.cur_ret, "ok")) == 1
                && sema_q_field(s, s.cur_ret, "value")[0] != 0) {
                mismatch = 0;
            }
        }
        if (mismatch == 1 && s.in_trailing == 1) {
            sema_error(s, "`?` is not allowed in a trailing block (the block is a closure)");
        } else if (mismatch == 1) {
            sema_error(s, "`?` can only be used in a function returning a Result with the same error type");
        }
        return;
    }
    if ((k == EK_FREECLOSURE || k == EK_THREADCREATE) && e.a != null) {
        // free_closure takes a closure; thread_create a `fn()->void` one (mirrors the C++).
        string ct = sema_infer_type(s, e.a);
        if (ct[0] != 0) {
            string cc = sema_canon(s, ct);
            if (k == EK_FREECLOSURE && sema_is_fn_type(cc) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: free_closure expects a closure (fn(...)->R), got %s\n", s.filename, s.line, s.col, ct);
            }
            if (k == EK_THREADCREATE && sema_streq(cc, "fn()->void") == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: thread_create expects a closure 'fn()->void', got '%s'\n", s.filename, s.line, s.col, ct);
            }
        }
    }
    if (k == EK_UNARY || k == EK_CAST
        || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        if (k == EK_UNARY && sema_streq(e.sval, "*") == 1) {
            sema_check_nullable_deref(s, e.a, "dereference");
            // A `*void` points at no type: there is nothing to read or write through it.
            string dt = sema_infer_type(s, e.a);
            if (dt[0] != 0 && sema_streq(sema_strip_nullable(sema_canon(s, dt)), "*void") == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot dereference '%s': it points to 'void' (cast it to a typed pointer first)\n", s.filename, s.line, s.col, dt);
            }
        }
        if (k == EK_UNARY && e.a != null && sema_streq(e.sval, "&") == 0) {
            // The built-in operand rules (mirrors the C++ inferUnaryExprType): `-`/`+` take a
            // number, `~` an integer, `*` a pointer, `!` anything but a struct; `-`, `~` and
            // `!` otherwise go through a user operator overload.
            string ut = sema_strip_nullable(sema_infer_type(s, e.a));
            string uc = sema_canon(s, ut);
            if (sema_judgeable(s, uc) == 1) {
                int ok = 1;
                if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "+") == 1) {
                    ok = sema_is_numeric_ty(uc);
                }
                else if (sema_streq(e.sval, "~") == 1) {
                    ok = sema_is_int_ty(uc);
                }
                else if (sema_streq(e.sval, "*") == 1) {
                    ok = sema_c_ptr(uc);
                }
                else if (sema_streq(e.sval, "!") == 1 && ((sema_is_aggregate(s, ut) == 1 && sema_is_iface_val(s, ut) == 0) || sema_is_void_value(uc) == 1)) {
                    ok = 0;
                }
                if (ok == 0 && sema_streq(e.sval, "*") == 0 && sema_streq(e.sval, "+") == 0) {
                    string uop = e.sval;
                    if (sema_streq(uop, "-") == 1) {
                        uop = "u-";
                    }
                    List<string> utys;
                    List_init<string>(&utys, 1);
                    List_push<string>(&utys, ut);
                    *DeclNode uod = sema_find_op(s, uop, &utys);
                    if (uod != null) {
                        ok = 1;
                        sema_note_call(s, uod.name);
                    }
                }
                if (ok == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: invalid operand for unary operator: %s\n", s.filename, s.line, s.col, ut);
                }
            }
        }
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1 && sema_is_lvalue(s, e.a) == 0) {
            sema_error(s, "cannot take the address of this expression: it is not a variable, field, element, or dereference");
        }
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1) {
            sema_check_captured_address(s, e.a);
            sema_warn_packed_addr(s, e);
        }
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_MEMBER) {
            *DeclNode bsd = sema_find_struct(s, sema_struct_of_type(sema_infer_type(s, e.a.a)));
            if (bsd != null) {
                int bi = 0;
                int bn = List_len<Param>(&bsd.params);
                while (bi < bn) {
                    if (sema_streq(List_get<Param>(&bsd.params, bi).name, e.a.sval) == 1 && bi < List_len<int>(&bsd.field_bits)
                        && List_get<int>(&bsd.field_bits, bi) > 0) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: cannot take the address of bitfield '%s'\n", s.filename, s.line, s.col, e.a.sval);
                    }
                    bi = bi + 1;
                }
            }
        }
        if (k == EK_CAST) {
            // Scalars convert (numbers, pointers, integer<->pointer); an aggregate casts only
            // to its own type; float<->pointer has no meaning. Unknown sides are not judged.
            string cfrom = sema_infer_type(s, e.a);
            string cto = sema_isub(s, e.sval);   // the target in a generic instance (`(T)0`, T = S)
            int fc = sema_cast_class(s, cfrom);
            int tc = sema_cast_class(s, cto);
            int fn_name = 0;
            if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0 && sema_find_fndecl(s, e.a.sval) != null) {
                fn_name = 1;
            }
            int bad = 0;
            if (fc != 0 && tc != 0 && sema_streq(sema_strip_const(cfrom), sema_strip_const(cto)) == 0 && fn_name == 0) {
                if (fc == 3 || tc == 3) {
                    bad = 1;
                }
                if ((fc == 2 && tc == 1 && sema_is_float_ty(cto) == 1) || (fc == 1 && tc == 2 && sema_is_float_ty(cfrom) == 1)) {
                    bad = 1;
                }
            }
            // A top-level function name casts only to a pointer (its raw C address).
            if (fn_name == 1 && tc != 0 && tc != 2 && sema_streq(sema_strip_const(cfrom), sema_strip_const(cto)) == 0) {
                bad = 1;
            }
            // A void value converts to nothing but `void`, and a `{...}` literal is only an
            // initializer (mirrors the C++ visit(CastExpr)).
            if (sema_is_void_value(cto) == 0) {
                if (cfrom[0] != 0 && sema_is_void_value(cfrom) == 1) {
                    bad = 1;
                }
                if (e.a != null && e.a.kind == EK_ARRAYLIT) {
                    bad = 1;
                    cfrom = "array-literal";
                }
            }
            if (bad == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot cast '%s' to '%s'\n", s.filename, s.line, s.col, cfrom, e.sval);
            }
            // A floating constant cast to an integer type must fit it (mirrors the C++).
            *ExprNode fsrc = e.a;
            int fneg = 0;
            if (fsrc != null && fsrc.kind == EK_UNARY && sema_streq(fsrc.sval, "-") == 1) {
                fneg = 1;
                fsrc = fsrc.a;
            }
            string tt = sema_strip_const(sema_resolve_scalar(s, sema_isub(s, e.sval)));
            int f_int = 1;
            int64 fiv = (int64)0;
            double fv = 0.0;
            if (bad == 0 && sema_is_int_ty(tt) == 1 && sema_streq(tt, "bool") == 0
                && sema_fold_num(s, e.a, &f_int, &fiv, &fv) == 1 && f_int == 0 && sema_float_fits_int(fv, tt) == 0) {
                s.had_error = 1;
                if (fsrc != null && fsrc.kind == EK_LITERAL && fsrc.lit_kind == LIT_FLOAT) {
                    string sign = "";
                    if (fneg == 1) {
                        sign = "-";
                    }
                    dprintf(2, "error: %s:%d:%d: floating constant %s%s is out of range for '%s'\n", s.filename, s.line, s.col, sign, fsrc.sval, e.sval);
                } else {
                    dprintf(2, "error: %s:%d:%d: floating constant expression (value %g) is out of range for '%s'\n", s.filename, s.line, s.col, fv, e.sval);
                }
            }
        }
        // `&p` of a narrowed `?*T` may be written through (storing null): narrowing ends.
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
            sema_mark_addr(s, e.a.sval);
            string ak = sema_nkey(s, e.a.sval);
            if (ak[0] != 0) {
                sema_narrow_drop(s, ak);
            }
        }
        sema_expr(s, e.a);
        return;
    }
    if (k == EK_ALLOCWITH && e.a != null && e.b != null) {
        // The count is an integer; the allocator's type names its alloc method,
        // `<Type>_alloc` (mirrors the C++ visit(AllocWithExpr)).
        string awc = sema_infer_type(s, e.b);
        if (awc[0] != 0 && sema_is_int_ty(sema_canon(s, awc)) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: alloc_with count must be integer, got %s\n", s.filename, s.line, s.col, awc);
        }
        // The element type needs a size: a known, non-void type.
        if (sema_known_type(s, e.sval) == 0) {
            s.had_error = 1;
            string utn = sema_base_name(sema_struct_of_type(e.sval));
            dprintf(2, "error: %s:%d:%d: unknown type '%s'%s\n", s.filename, s.line, s.col, utn, sema_did_you_mean(s, utn, 1, e.sval));
        } else if (sema_is_void_value(sema_resolve_scalar(s, sema_isub(s, e.sval))) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: alloc_with of 'void': a void element has no size\n", s.filename, s.line, s.col);
        }
        // The allocator is passed as `self`, so it must be a pointer to the allocator; its type
        // names its alloc method, `*void <Type>_alloc(*<Type> self, int64 size)`.
        string awa = sema_infer_type(s, e.a);
        if (awa[0] != 0) {
            string araw = sema_strip_nullable(sema_canon(s, awa));
            string ab = araw;
            int a0 = 0;
            while ((int)ab[a0] == 42) {
                a0 = a0 + 1;
            }
            int a1 = sema_slen(ab);
            while (a1 > a0 && (int)ab[a1 - 1] == 42) {
                a1 = a1 - 1;
            }
            ab = sema_sub_str(ab, a0, a1);
            // A generic instance (`G<int>`) names its alloc function by the instance's flat
            // name (`G_int_alloc`), as the C++ mangling spells it.
            string afn = sema_cat(sema_flat_name(ab), "_alloc");
            int has = 0;
            *DeclNode afd = null;       // the alloc function (null: an inline method)
            int ashape = 1;
            if (sema_find_fn(s, afn) >= 0) {
                has = 1;
                afd = sema_find_fndecl(s, afn);
                if (afd != null) {
                    if (List_len<Param>(&afd.params) != 2) {
                        ashape = 0;
                    }
                    else {
                        string sp = sema_canon(s, List_get<Param>(&afd.params, 0).ty);
                        if (sema_has_star(sp) == 0 || sema_streq(sema_strip_const(sema_pointee(sp)), ab) == 0) {
                            ashape = 0;
                        }
                        if (sema_is_int_ty(sema_canon(s, List_get<Param>(&afd.params, 1).ty)) == 0) {
                            ashape = 0;
                        }
                    }
                    if (sema_has_star(sema_canon(s, afd.ret_type)) == 0) {
                        ashape = 0;
                    }
                }
            }
            *DeclNode asd = sema_find_struct(s, sema_base_name(ab));   // or an inline `alloc` method
            if (asd != null) {
                int mi = 0;
                while (mi < List_len<*DeclNode>(&asd.methods)) {
                    *DeclNode am = List_get<*DeclNode>(&asd.methods, mi);
                    if (sema_streq(am.name, "alloc") == 1) {
                        has = 1;
                        if (List_len<Param>(&am.params) != 1 || sema_is_int_ty(sema_canon(s, List_get<Param>(&am.params, 0).ty)) == 0
                            || sema_has_star(sema_canon(s, am.ret_type)) == 0) {
                            ashape = 0;
                        }
                    }
                    mi = mi + 1;
                }
            }
            if (sema_has_star(araw) == 0 || sema_has_star(sema_pointee(araw)) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: alloc_with: the allocator must be a pointer to it, got '%s' (pass its address, as in alloc_with(&a, T, n))\n", s.filename, s.line, s.col, sema_strip_const(awa));
            } else if (has == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: alloc_with: allocator type '%s' has no alloc method (%s)\n", s.filename, s.line, s.col, ab, afn);
            } else if (ashape == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: alloc_with: '%s' must have the shape '*void %s(*%s self, int64 size)'\n", s.filename, s.line, s.col, afn, afn, ab);
            }
        }
    }
    if (k == EK_INDEX || k == EK_ALLOCWITH) {
        // Constant slice bounds `a[lo..hi]`: 0 <= lo <= hi on any base, and <= N into a fixed array.
        // Constant indices and bounds (a literal, an enum member, a `const`, or an
        // expression over them) into a fixed array are checked (mirrors the C++ IndexExpr).
        if (k == EK_INDEX && List_len<*ExprNode>(&e.kids) > 0) {
            *ExprNode hiE = List_get<*ExprNode>(&e.kids, 0);
            string abt = sema_infer_type(s, e.a);
            // A slice of a fixed array refers to the array's storage (a string or pointer base does not).
            string sbc = sema_canon(s, sema_strip_nullable(abt));
            int sbr = sema_arr_bracket(sbc);
            int sbn = sema_slen(sbc);
            if (sbr > 0 && (int)sbc[sbr + 1] != 93 && (int)sbc[0] != 42 && (int)sbc[sbn - 1] != 42) {
                sema_check_captured_address(s, e.a);
            }
            int64 lo = (int64)0;
            int64 hi = (int64)0;
            int lo_ok = sema_fold_int(s, e.b, &lo);
            int hi_ok = sema_fold_int(s, hiE, &hi);
            if (sema_is_arr_ty(abt) == 1 && sema_is_readonly_lvalue(s, e.a) == 1) {
                s.had_error = 1;             // a slice lets its elements be written
                dprintf(2, "error: %s:%d:%d: cannot slice read-only array: a slice allows writing its elements\n", s.filename, s.line, s.col);
            } else if (sema_is_arr_ty(abt) == 1 && sbr > 0 && (int)sbc[sbr + 1] != 93 && (int)sbc[0] != 42 && (int)sbc[sbn - 1] != 42
                       && sema_is_lvalue(s, e.a) == 0) {
                sema_error(s, "cannot slice a temporary array: store it in a variable first");
            }
            {
                int64 dv = (int64)-1;   // lo <= hi on any base; the dimension only for a fixed array
                if (sema_is_arr_ty(abt) == 1) {
                    dv = sema_dim_value(s, sema_arr_count(abt));
                }
                if ((lo_ok == 1 && lo < (int64)0) || (hi_ok == 1 && hi < (int64)0)) {
                    sema_error(s, "slice bound is negative");
                } else if (lo_ok == 1 && hi_ok == 1 && lo > hi) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bounds out of order: %lld..%lld\n", s.filename, s.line, s.col, lo, hi);
                } else if (dv >= (int64)0 && hi_ok == 1 && hi > dv) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bound %lld is out of bounds for array of size %lld\n", s.filename, s.line, s.col, hi, dv);
                } else if (dv >= (int64)0 && lo_ok == 1 && lo > dv) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bound %lld is out of bounds for array of size %lld\n", s.filename, s.line, s.col, lo, dv);
                }
            }
            sema_expr(s, hiE);
        }
        // The index (and a slice's upper bound) must be an integer.
        if (k == EK_INDEX && e.b != null) {
            string ixt = sema_infer_type(s, e.b);
            string ixc = sema_canon(s, ixt);
            if (sema_judgeable(s, ixc) == 1 && sema_is_int_ty(ixc) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array index must be integer, got %s\n", s.filename, s.line, s.col, ixt);
            }
            if (List_len<*ExprNode>(&e.kids) > 0) {
                string hxt = sema_infer_type(s, List_get<*ExprNode>(&e.kids, 0));
                string hxc = sema_canon(s, hxt);
                if (sema_judgeable(s, hxc) == 1 && sema_is_int_ty(hxc) == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bound must be integer, got %s\n", s.filename, s.line, s.col, hxt);
                }
            }
        }
        // Constant-index bounds check on a fixed array (the index folds like a case label).
        if (k == EK_INDEX && List_len<*ExprNode>(&e.kids) == 0 && e.b != null) {
            string bt = sema_canon(s, sema_infer_type(s, e.a));
            int64 idx = (int64)0;
            if (sema_is_arr_ty(bt) == 1 && sema_fold_int(s, e.b, &idx) == 1) {
                int64 dim = sema_dim_value(s, sema_arr_count(bt));
                if (idx < (int64)0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: array index %lld is out of bounds\n", s.filename, s.line, s.col, idx);
                } else if (dim >= (int64)0 && idx >= dim) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: array index %lld is out of bounds for array of size %lld\n", s.filename, s.line, s.col, idx, dim);
                }
            }
        }
        sema_check_nullable_deref(s, e.a, "index");
        if (k == EK_INDEX) {                            // only arrays, slices, pointers, strings index
            string ibt = sema_infer_type(s, e.a);
            int icls = sema_cast_class(s, ibt);
            int bad = 0;
            if (icls == 1) {
                bad = 1;
            }
            if (sema_streq(ibt, "null") == 1) {   // `null[0]` points at nothing
                bad = 1;
            }
            if (icls == 3 && sema_is_arr_ty(ibt) == 0 && sema_is_fn_type(ibt) == 0 && s.has_ops == 1
                && List_len<*ExprNode>(&e.kids) == 0) {
                *DeclNode iod = sema_find_binop(s, "[]", ibt, sema_infer_type(s, e.b));
                if (iod != null) {
                    sema_note_call(s, iod.name);
                }
            }
            if (icls == 3 && sema_is_arr_ty(ibt) == 0 && sema_is_fn_type(ibt) == 0) {
                // a struct value: only through a user `operator []`
                List<string> oty;
                List_init<string>(&oty, 2);
                List_push<string>(&oty, ibt);
                List_push<string>(&oty, "int");
                if (sema_find_fn(s, ast_op_name("[]", &oty)) < 0 && sema_any_index_op(s) == 0) {
                    bad = 1;
                }
            }
            if (bad == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot index into a value of type '%s'\n", s.filename, s.line, s.col, ibt);
            }
        }
        sema_expr(s, e.a);
        sema_expr(s, e.b);
        return;
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && List_len<*ExprNode>(&e.kids) == 1
        && sema_streq(e.a.sval, "dbg") == 1 && sema_lookup(s, "dbg") == 0 && sema_find_fndecl(s, "dbg") == null) {
        *ExprNode da = List_get<*ExprNode>(&e.kids, 0);   // the `dbg(e)` builtin: prints e, yields it
        sema_expr(s, da);
        if (sema_streq(sema_dealias(s, sema_infer_type(s, da)), "void") == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: dbg needs a value: its argument is a void call\n", s.filename, e.a.line, e.a.col);
        }
        e.dbg_builtin = 1;
        return;
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT
        && sema_streq(e.a.sval, "exception_text") == 1 && sema_lookup(s, "exception_text") == 0 && sema_find_fndecl(s, "exception_text") == null) {
        int ei = 0;
        int en = List_len<*ExprNode>(&e.kids);
        while (ei < en) {
            sema_expr(s, List_get<*ExprNode>(&e.kids, ei));
            ei = ei + 1;
        }
        if (en != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'exception_text' takes no arguments, got %d\n", s.filename, e.line, e.col, en);
        }
        if (s.catch_depth == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'exception_text' is only allowed inside a 'catch' block\n", s.filename, e.line, e.col);
        }
        return;
    }
    // `__exception_text_into(buf)`: the async lowering's copy of the text into a frame field
    // of 512 chars, in the catch handler it synthesizes.
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_streq(e.a.sval, "__exception_text_into") == 1
        && List_len<*ExprNode>(&e.kids) == 1 && s.catch_depth > 0) {
        sema_expr(s, List_get<*ExprNode>(&e.kids, 0));
        return;
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_MEMBER) {
        // Method-call syntax `x.m(...)`: `m` is an inline method, a field holding a fn
        // pointer, or a free function `Type_m(self, ...)` (mirrors the C++ method path).
        *ExprNode mem = e.a;
        sema_expr(s, mem.a);
        sema_check_nullable_deref(s, mem.a, "access a member of");
        string bt = sema_infer_type(s, mem.a);
        if (s.tool == 3 && sema_streq(mem.sval, "__eskiu_complete__") == 1) {   // --complete-at after `recv.`
            sema_tool_complete_members(s, bt);
            int ci = 0;
            while (ci < List_len<*ExprNode>(&e.kids)) {
                sema_expr(s, List_get<*ExprNode>(&e.kids, ci));
                ci = ci + 1;
            }
            return;
        }
        // A pointer to an alias (`IL*`, `type IL = List<int>`) calls the target's methods.
        if (s.has_alias == 1 && sema_ptr_depth(bt) == 1 && sema_pointee_const(bt) == 0) {
            string bpe = sema_pointee(bt);
            string bpd = sema_dealias(s, bpe);
            if (bpe[0] != 0 && sema_streq(bpd, bpe) == 0) {
                bt = sema_cat("*", bpd);
            }
        }
        string sn = sema_struct_of_type(bt);
        // Dot syntax dereferences at most one pointer level.
        if (sema_is_fn_type(bt) == 0) {
            if (sema_ptr_depth(bt) > 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot call method '%s' through '%s': dot syntax dereferences one pointer level (dereference it first)\n",
                       s.filename, s.line, s.col, mem.sval, bt);
                int ai = 0;
                while (ai < List_len<*ExprNode>(&e.kids)) {
                    sema_expr(s, List_get<*ExprNode>(&e.kids, ai));
                    ai = ai + 1;
                }
                return;
            }
        }
        *DeclNode ifc = null;
        if (bt[0] != 0) {
            ifc = sema_find_iface(s, sn);
        }
        if (ifc != null) {                                    // interface (vtable) dispatch
            *DeclNode im = null;
            int ii = 0;
            int inn = List_len<*DeclNode>(&ifc.methods);
            while (ii < inn) {
                *DeclNode c = List_get<*DeclNode>(&ifc.methods, ii);
                if (sema_streq(c.name, mem.sval) == 1) {
                    im = c;
                }
                ii = ii + 1;
            }
            if (im == null) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: interface '%s' has no method '%s'\n", s.filename, s.line, s.col, sn, mem.sval);
            } else {
                if (s.tool != 0 && mem.mline > 0) {
                    sema_tool_hsym(s, mem.mline, mem.mcol, sema_slen(mem.sval), sym_sig_text(im));
                }
                List<string> ipts;
                List_init<string>(&ipts, 4);
                int pi = 0;
                int pn = List_len<Param>(&im.params);
                while (pi < pn) {
                    List_push<string>(&ipts, List_get<Param>(&im.params, pi).ty);
                    pi = pi + 1;
                }
                sema_check_call_args(s, e, sema_cat(sema_cat("method '", mem.sval), "'"), &ipts);
            }
        }
        if (bt[0] != 0 && sema_is_struct(s, sn) == 1) {
            int inline_m = 0;
            *DeclNode imd = null;
            *DeclNode sd = sema_find_struct(s, sn);
            if (sd != null) {
                int j = 0;
                int mn = List_len<*DeclNode>(&sd.methods);
                while (j < mn) {
                    *DeclNode cm = List_get<*DeclNode>(&sd.methods, j);
                    if (sema_streq(cm.name, mem.sval) == 1) {
                        inline_m = 1;
                        imd = cm;
                    }
                    j = j + 1;
                }
            }
            *DeclNode ffn = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mem.sval));
            if (ffn == null) {
                // On a generic instance a non-generic `G_int_m(G<int>* self, ...)` serves the
                // call too (the instance's flat name, as the C++ method lookup tries).
                string ibt = sema_strip_const(sema_dealias(s, bt));
                while ((int)ibt[0] == 42) {
                    ibt = sema_sub_str(ibt, 1, sema_slen(ibt));
                }
                while (sema_slen(ibt) > 0 && (int)ibt[sema_slen(ibt) - 1] == 42) {
                    ibt = sema_sub_str(ibt, 0, sema_slen(ibt) - 1);
                }
                string iflat = sema_flat_name(ibt);
                if (sema_streq(iflat, sn) == 0) {
                    ffn = sema_find_fndecl(s, sema_cat(sema_cat(iflat, "_"), mem.sval));
                }
            }
            if (inline_m == 1) {   // `x.m()` names `S_m`
                sema_note_call(s, sema_cat(sema_cat(sn, "_"), mem.sval));
            }
            if (s.tool != 0 && mem.mline > 0 && (inline_m == 1 || ffn != null)) {   // the member names a function
                string tfn = sema_cat(sema_cat(sn, "_"), mem.sval);
                if (inline_m == 0) {
                    tfn = ffn.name;
                }
                string tsig = sema_sig_text(s, tfn);
                List<string> itargs;
                List_init<string>(&itargs, 2);
                sema_parse_targs(sema_strip_ptr_sp(sema_strip_const(sema_dealias(s, bt))), &itargs);
                if (inline_m == 1 && sd != null && List_len<TypeParam>(&sd.type_params) > 0
                    && List_len<string>(&itargs) == List_len<TypeParam>(&sd.type_params)) {
                    // An instance's inline method is the function `Box_int_get(*Box<int>)`.
                    string ibase = sema_strip_ptr_sp(sema_strip_const(sema_dealias(s, bt)));
                    tfn = sema_cat(sema_cat(sema_flat_name(ibase), "_"), mem.sval);
                    tsig = sema_tool_inst_sig(s, sd, imd, ibase);
                }
                sema_tool_hsym(s, mem.mline, mem.mcol, sema_slen(mem.sval), tsig);
                sema_tool_memuse(s, mem.mline, mem.mcol, sema_slen(mem.sval), tfn);
            }
            if (ffn != null && inline_m == 0) {
                int dln = mem.mline;
                int dcl = mem.mcol;
                if (dln <= 0) {
                    dln = e.line;
                    dcl = e.col;
                }
                sema_note_call(s, ffn.name);
                sema_note_depr(s, ffn.name, dln, dcl);
            }
            // Arguments against the method's parameters (self excluded), with the same
            // count + assignability rules as a bare call (mirrors the C++ method path).
            string mwhat = sema_cat(sema_cat("method '", mem.sval), "'");
            if (imd != null) {
                List<string> mpts;
                List_init<string>(&mpts, 4);
                List<string> rtargs;
                List_init<string>(&rtargs, 2);
                sema_parse_targs(sema_strip_ptr_sp(bt), &rtargs);
                int mpi = 0;
                int mpn = List_len<Param>(&imd.params);
                while (mpi < mpn) {
                    List_push<string>(&mpts, sema_subst_params(List_get<Param>(&imd.params, mpi).ty, &sd.type_params, &rtargs));
                    mpi = mpi + 1;
                }
                sema_check_call_args(s, e, mwhat, &mpts);
                // A generic struct instance's method body is checked per instance, once called.
                if (List_len<TypeParam>(&sd.type_params) > 0 && List_len<string>(&rtargs) == List_len<TypeParam>(&sd.type_params)) {
                    sema_queue_inst(s, imd, sd, &rtargs, sd.name, sema_cat(".", mem.sval));
                }
            } else if (ffn != null && List_len<TypeParam>(&ffn.type_params) == 0
                       && (List_len<Param>(&ffn.params) == 0 || sema_has_star(sema_dealias(s, List_get<Param>(&ffn.params, 0).ty)) == 0
                           || sema_streq(sema_self_struct(s, List_get<Param>(&ffn.params, 0).ty), sn) == 0)) {
                // Dot syntax passes the receiver's address: the first parameter must be a
                // pointer to the receiver's type (mirrors the C++ method path).
                string fp0 = "none";
                if (List_len<Param>(&ffn.params) > 0) {
                    fp0 = List_get<Param>(&ffn.params, 0).ty;
                }
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: '%s' cannot be called as method '%s' of '%s': its first parameter must be '*%s self' (it is '%s')\n",
                       s.filename, s.line, s.col, ffn.name, mem.sval, sn, sn, fp0);
            } else if (ffn != null && List_len<TypeParam>(&ffn.type_params) == 0 && List_len<Param>(&ffn.params) > 0) {
                List<string> fpts;
                List_init<string>(&fpts, 4);
                int fpi = 1;
                int fpn = List_len<Param>(&ffn.params);
                while (fpi < fpn) {
                    List_push<string>(&fpts, List_get<Param>(&ffn.params, fpi).ty);
                    fpi = fpi + 1;
                }
                sema_check_call_args(s, e, mwhat, &fpts);
                sema_check_format(s, e, ffn.name, 1);
            } else if (ffn != null && List_len<Param>(&ffn.params) > 0) {
                // A generic free function `S_m<T..>(S<T..>* self, ...)` on an instance of S
                // (the `Type_method` convention): the type arguments come from the receiver
                // (then the arguments); check the arguments against the instantiated params.
                List<string> gtargs;
                List_init<string>(&gtargs, 2);
                if (sema_method_targs(s, ffn, bt, e, &gtargs) == 1) {
                    List<string> gpts;
                    List_init<string>(&gpts, 4);
                    int gpi = 1;
                    int gpn = List_len<Param>(&ffn.params);
                    while (gpi < gpn) {
                        List_push<string>(&gpts, sema_subst_params(List_get<Param>(&ffn.params, gpi).ty, &ffn.type_params, &gtargs));
                        gpi = gpi + 1;
                    }
                    sema_check_call_args(s, e, mwhat, &gpts);
                    sema_queue_inst(s, ffn, null, &gtargs, ffn.name, "");
                }
            }
            int is_field = 0;
            if (inline_m == 0 && sema_has_member(s, sema_cat(sema_cat(sn, "."), mem.sval)) == 1) {
                is_field = 1;
            }
            int nonfn_field = 0;                  // `s.v()` on a field that holds no fn pointer
            if (is_field == 1) {
                string fty = sema_field_type(s, sn, mem.sval);
                if (fty != null && sema_is_fn_type(sema_canon(s, fty)) == 0 && sema_judgeable(s, sema_canon(s, fty)) == 1) {
                    nonfn_field = 1;
                }
            }
            if (inline_m == 0 && ffn == null && (is_field == 0 || nonfn_field == 1)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: undefined method '%s' on type '%s'%s\n", s.filename, s.line, s.col, mem.sval, sn, sema_did_you_mean(s, mem.sval, 2, bt));
            }
            if (is_field == 1 && s.tool != 0) {   // the callee is the field
                sema_tool_field(s, mem, bt);
                sema_tool_expr(s, mem);
            }
            if (is_field == 1 && sd != null) {                // a field holding a fn pointer: o.cb(args)
                int fi = 0;
                int nf = List_len<Param>(&sd.params);
                while (fi < nf) {
                    Param fp = List_get<Param>(&sd.params, fi);
                    if (sema_streq(fp.name, mem.sval) == 1 && sema_is_fn_type(fp.ty) == 1) {
                        sema_check_fn_value_call(s, e, sema_cat(sema_cat("'", mem.sval), "'"), fp.ty);
                    }
                    fi = fi + 1;
                }
            }
            // A method with a plain (mutable) `self` may write through it, so it cannot be
            // called on a read-only receiver unless it declares `const T* self`.
            int ro = 0;
            if (sema_has_star(bt) == 1) {
                ro = sema_pointee_const(bt);
            }
            else {
                ro = sema_is_readonly_lvalue(s, mem.a);
            }
            int self_const = 0;
            if (inline_m == 0 && ffn != null && List_len<Param>(&ffn.params) > 0) {
                self_const = sema_pointee_const(List_get<Param>(&ffn.params, 0).ty);
            }
            if (ro == 1 && is_field == 0) {
                if (self_const == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: cannot call method '%s' on a read-only value: its self may modify it (declare it 'const %s* self' if it does not)\n",
                           s.filename, s.line, s.col, mem.sval, sn);
                }
            } else if (is_field == 0 && self_const == 0 && sema_has_star(bt) == 0
                       && (inline_m == 1 || (ffn != null && List_len<Param>(&ffn.params) > 0
                                             && sema_has_star(sema_dealias(s, List_get<Param>(&ffn.params, 0).ty)) == 1))) {
                // A captured value is read-only in the lambda: a non-const self would get
                // the closure's copy (mirrors the C++ checkCapturedMethodCall).
                string cn = sema_captured_root(s, mem.a);
                if (cn[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: cannot call method '%s' on captured variable '%s': a closure captures it by value, and a non-const self may modify the copy (use a 'const T* self' method, or capture a pointer)\n",
                           s.filename, s.line, s.col, mem.sval, cn);
                }
            }
        }
        // A receiver that is not a struct, union or interface: only a free `Type_m`, or
        // inside a generic instance a constrained call on a scalar primitive (lowered to
        // the free function `m(x, ...)`), can serve the call.
        string rbc = sema_canon(s, bt);
        if (ifc == null && sema_judgeable(s, rbc) == 1 && sema_is_struct(s, sn) == 0) {
            int served = 0;
            if (sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mem.sval)) != null) {
                served = 1;
                int dln = mem.mline;
                int dcl = mem.mcol;
                if (dln <= 0) {
                    dln = e.line;
                    dcl = e.col;
                }
                sema_note_call(s, sema_cat(sema_cat(sn, "_"), mem.sval));
                sema_note_depr(s, sema_cat(sema_cat(sn, "_"), mem.sval), dln, dcl);
            }
            if (s.in_inst == 1 && sema_is_scalar_prim(rbc) == 1) {
                *DeclNode pf = sema_find_fndecl(s, mem.sval);
                if (pf != null && List_len<Param>(&pf.params) > 0) {
                    served = 1;
                    sema_note_call(s, pf.name);
                }
            }
            if (served == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: undefined method '%s' on type '%s'%s\n", s.filename, s.line, s.col, mem.sval, bt, sema_did_you_mean(s, mem.sval, 2, bt));
            }
        }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            sema_expr(s, List_get<*ExprNode>(&e.kids, i));
            i = i + 1;
        }
        return;
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
        // A generic variant argument takes the parameter's instance (`get(Some(40))`).
        *DeclNode vfd = sema_find_fndecl(s, e.a.sval);
        if (vfd != null && List_len<TypeParam>(&vfd.type_params) == 0) {
            int vi = 0;
            while (vi < List_len<*ExprNode>(&e.kids) && vi < List_len<Param>(&vfd.params)) {
                sema_infer_variant(s, List_get<*ExprNode>(&e.kids, vi), List_get<Param>(&vfd.params, vi).ty);
                vi = vi + 1;
            }
        }
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0
        && sema_find_fndecl(s, e.a.sval) == null && sema_variant_enum(s, e.a.sval) != null) {
        sema_check_variant_args(s, e, e.a.sval, null);
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_lookup(s, e.a.sval) == 0
        && (sema_streq(e.a.sval, "va_start") == 1 || sema_streq(e.a.sval, "va_end") == 1)) {
        sema_check_va_list_arg(s, e.a.sval, e);
        if (sema_streq(e.a.sval, "va_start") == 1 && s.in_variadic == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'va_start' used in a function with no variadic parameter ('...')\n", s.filename, s.line, s.col);
        }
    }
    if (k == EK_CALL) {
        // arg-count check: only when the callee is a bare global function (not a local
        // fn-pointer var, not an ADT variant, not a generic — those resolve elsewhere).
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
            int fi = sema_find_fn(s, e.a.sval);
            if (fi >= 0) {
                FnSig sig = List_get<FnSig>(&s.fns, fi);
                int argc = List_len<*ExprNode>(&e.kids);
                if (sig.variadic == 1) {
                    if (argc < sig.fixed) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: function '%s' expects at least %d arguments, got %d\n",
                               s.filename, s.line, s.col, e.a.sval, sig.fixed, argc);
                    } else {
                        sema_check_variadic_extras(s, e, sig.fixed);
                        sema_check_format(s, e, e.a.sval, 0);
                    }
                } else if (argc != sig.fixed) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: function '%s' expects %d arguments, got %d\n",
                           s.filename, s.line, s.col, e.a.sval, sig.fixed, argc);
                }
                // Argument types against the declared parameter types (conservative).
                *DeclNode cfd = sema_find_fndecl(s, e.a.sval);
                if (cfd != null) {
                    int cext = sema_is_c_extern(s, e.a.sval);
                    int ai = 0;
                    while (ai < argc && ai < sig.fixed) {
                        // A C function's fn-typed parameter is a C function pointer: C can
                        // only call a named top-level function (or get null), never a
                        // closure's environment.
                        *ExprNode cax = List_get<*ExprNode>(&e.kids, ai);
                        if (cext == 1 && sema_is_fn_type_alias(s, List_get<Param>(&cfd.params, ai).ty) == 1) {
                            if (cax.kind == EK_LITERAL && cax.lit_kind == LIT_NULL) {
                                ai = ai + 1;
                                continue;
                            }
                            if (cax.kind != EK_IDENT || sema_local_bound(s, cax.sval) == 1 || sema_find_fn(s, cax.sval) < 0) {
                                s.had_error = 1;
                                dprintf(2, "error: %s:%d:%d: argument %d of extern '%s' is a C function pointer: pass a top-level function by name, not a closure value\n",
                                       s.filename, s.line, s.col, ai + 1, e.a.sval);
                                ai = ai + 1;
                                continue;
                            }
                        }
                        string perr = sema_assign_err(s, List_get<Param>(&cfd.params, ai).ty, List_get<*ExprNode>(&e.kids, ai));
                        if (perr[0] != 0) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: argument %d type mismatch: expected %s, got %s (%s)\n", s.filename, s.line, s.col, ai + 1,
                                   List_get<Param>(&cfd.params, ai).ty, sema_infer_type(s, List_get<*ExprNode>(&e.kids, ai)), perr);
                        }
                        ai = ai + 1;
                    }
                }
            }
        }
        // An inferred generic call `id(1)`: argument count, and arguments bound to the same
        // bare type parameter must agree (`pick(1, "s")`).
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0 && sema_find_fn(s, e.a.sval) < 0) {
            *DeclNode gfd = sema_find_fndecl(s, e.a.sval);
            if (gfd != null && List_len<TypeParam>(&gfd.type_params) > 0) {
                string unb = sema_uninferable_tparam(gfd);
                if (unb[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: cannot infer type argument(s) %s of generic function '%s' from the call; write them explicitly, e.g. %s<...>(...)\n",
                           s.filename, s.line, s.col, unb, gfd.name, gfd.name);
                } else if (sema_check_generic_arity(s, gfd, e) == 1) {
                    int agree = sema_check_generic_binding(s, gfd, e);
                    List<string> btargs;
                    List_init<string>(&btargs, 4);
                    if (sema_bind_targs(s, gfd, e, &btargs) == 1) {
                        if (agree == 1 && sema_check_constraints(s, &gfd.type_params, &btargs) == 1) {
                            // The inferred instance's parameter types must accept every
                            // argument (`swp(&i64, &i32)` against `*T`), as in C++.
                            List<string> ipts;
                            List_init<string>(&ipts, 4);
                            int pi = 0;
                            while (pi < List_len<Param>(&gfd.params)) {
                                List_push<string>(&ipts, sema_subst_params(List_get<Param>(&gfd.params, pi).ty, &gfd.type_params, &btargs));
                                pi = pi + 1;
                            }
                            int before = s.had_error;
                            s.had_error = 0;
                            sema_check_call_args(s, e, sema_cat(sema_cat("function '", gfd.name), "'"), &ipts);
                            int bad = s.had_error;
                            if (before == 1) {
                                s.had_error = 1;
                            }
                            if (bad == 0) {
                                sema_queue_inst(s, gfd, null, &btargs, gfd.name, "");
                            }
                        }
                    }
                    else if (sema_args_typed(s, e) == 1) {
                        string unbound = "";
                        int ui = 0;
                        while (ui < List_len<string>(&btargs)) {
                            if (List_get<string>(&btargs, ui)[0] == 0) {
                                if (unbound[0] != 0) {
                                    unbound = sema_cat(unbound, ", ");
                                }
                                unbound = sema_cat(unbound, List_get<TypeParam>(&gfd.type_params, ui).name);
                            }
                            ui = ui + 1;
                        }
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: cannot infer type argument(s) %s of generic function '%s' from the call; write them explicitly, e.g. %s<...>(...)\n",
                               s.filename, s.line, s.col, unbound, gfd.name, gfd.name);
                    }
                }
            }
        }
        // A call through a fn-typed value: a fn-pointer variable (local or global, not a
        // declared function), or any other callee expression (`mk()(1)`).
        if (e.a != null && e.a.kind == EK_IDENT && (sema_local_bound(s, e.a.sval) == 1 || sema_find_fn(s, e.a.sval) < 0)) {
            string vt = sema_lookup_type(s, e.a.sval);
            string cvt = sema_canon(s, vt);
            if (sema_is_fn_type(vt) == 1) {
                sema_check_fn_value_call(s, e, sema_cat(sema_cat("'", e.a.sval), "'"), vt);
            }
            else if (vt[0] != 0 && sema_is_fn_type(cvt) == 0
                     && (sema_is_numeric_ty(sema_strip_const(vt)) == 1 || sema_streq(vt, "string") == 1 || sema_judgeable(s, cvt) == 1)) {
                // a local or a global variable that is not callable (a global used to slip
                // through to codegen, which crashed)
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: undefined function '%s' ('%s' is a variable of type '%s')\n", s.filename, e.a.line, e.a.col, e.a.sval, e.a.sval, vt);
            } else if (vt[0] == 0 && sema_local_bound(s, e.a.sval) == 0 && sema_find_fndecl(s, e.a.sval) == null
                       && sema_plain_member(s, e.a.sval) == 1) {
                s.had_error = 1;                   // a classic enum member is a constant
                dprintf(2, "error: %s:%d:%d: undefined function '%s'%s\n", s.filename, e.a.line, e.a.col, e.a.sval, sema_did_you_mean(s, e.a.sval, 0, ""));
            }
        } else if (e.a != null && e.a.kind != EK_IDENT) {
            string ct = sema_infer_type(s, e.a);
            if (sema_is_fn_type(ct) == 1) {
                sema_check_fn_value_call(s, e, "the called function value", ct);
            }
        }
        // A call names its function directly: the callee is no typed expression of its own
        // (a local closure's name is, as in the C++).
        if (s.tool == 1 && e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
            s.tool_callee = e.a;
        }
        if (s.tool != 0 && e.a != null && e.a.kind == EK_IDENT) {
            if (sema_streq(e.a.sval, "__eskiu_complete__") == 1) {   // --complete-at on a callee
                sema_tool_complete_scope(s);
                int ci = 0;
                while (ci < List_len<*ExprNode>(&e.kids)) {
                    sema_expr(s, List_get<*ExprNode>(&e.kids, ci));
                    ci = ci + 1;
                }
                return;
            }
            sema_tool_useloc(s, e.a.line, e.a.col, e.a.sval);
        }
        string prev = s.callee_ctx;        // mark the callee so a watched param here is OK
        if (e.a != null && e.a.kind == EK_IDENT) {
            s.callee_ctx = e.a.sval;
        }
        else {
            s.callee_ctx = "";
        }
        if (e.a != null && e.a.kind == EK_IDENT && sema_streq(e.a.sval, "va_start") == 0 && sema_streq(e.a.sval, "va_end") == 0
            && (sema_lookup(s, e.a.sval) == 0
                || (sema_local_bound(s, e.a.sval) == 0 && StrTab_has(&s.late_globals, e.a.sval) == 1))) {
            s.had_error = 1;               // an unbound callee names no function (mirrors the C++)
            dprintf(2, "error: %s:%d:%d: undefined function '%s'%s\n", s.filename, e.a.line, e.a.col, e.a.sval,
                   sema_did_you_mean(s, e.a.sval, 0, ""));
            s.callee_ctx = prev;
            return;                        // its arguments are not checked (as in the C++)
        } else {
            if (e.a != null && e.a.kind == EK_IDENT) {
                sema_note_call(s, e.a.sval);
                sema_note_depr(s, e.a.sval, e.a.line, e.a.col);
            }
            sema_expr(s, e.a);             // callee (functions live in the global scope)
        }
        s.callee_ctx = prev;
        // A watched (non-escaping) closure param passed straight to a non-escaping param
        // of an Eskiu function does not escape: the callee may only call it (mirrors the
        // C++ visit(CallExpr)). A C function's fn-typed param is a C pointer, not this.
        *DeclNode cfd = null;
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
            cfd = sema_find_fndecl(s, e.a.sval);
        }
        if (cfd != null && cfd.kind != DK_FUNCTION) {
            cfd = null;
        }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        // A `?:` argument to an interface parameter of a named function boxes arm by arm.
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
            *DeclNode hfd = sema_find_fndecl(s, e.a.sval);
            int hi = 0;
            while (hfd != null && hi < n && hi < List_len<Param>(&hfd.params)) {
                sema_hint_iface(s, List_get<*ExprNode>(&e.kids, hi), List_get<Param>(&hfd.params, hi).ty);
                hi = hi + 1;
            }
        }
        int cgen = 0;
        if (cfd != null && List_len<TypeParam>(&cfd.type_params) > 0) {
            cgen = 1;
        }
        while (i < n && cgen == 1) {
            sema_generic_call_arg(s, cfd, i, List_get<*ExprNode>(&e.kids, i));
            i = i + 1;
        }
        while (i < n) {
            *ExprNode ka = List_get<*ExprNode>(&e.kids, i);
            int fwd = 0;
            if (cfd != null && ka != null && ka.kind == EK_IDENT && sema_in_list(&s.watched, ka.sval) == 1
                && i < List_len<Param>(&cfd.params)) {
                int pesc = 0;
                if (i < List_len<int>(&cfd.param_escaping)) {
                    pesc = List_get<int>(&cfd.param_escaping, i);
                }
                if (pesc == 0) {
                    fwd = 1;
                }
            }
            if (ka != null && ka.kind == EK_LAMBDA && cfd != null && i < List_len<Param>(&cfd.params)) {
                int lesc = 0;
                if (i < List_len<int>(&cfd.param_escaping)) {
                    lesc = List_get<int>(&cfd.param_escaping, i);
                }
                if (lesc == 0 && s.in_inst == 0) {
                    s.lam_arg_nonesc = 1;
                }
                if (lesc == 0 && s.in_inst == 0 && cfd.is_async == 0) {
                    s.lam_arg_stack = 1;
                }
                if (s.in_inst == 1) {   // decided after the instances
                    int desc = lesc;
                    if (cfd.is_async == 1) {
                        desc = 1;
                    }
                    sema_defer_lambda(s, ka, desc);
                }
            }
            if (fwd == 1) {
                string pk = s.callee_ctx;
                s.callee_ctx = ka.sval;
                sema_expr(s, ka);
                s.callee_ctx = pk;
            } else {
                sema_expr(s, ka);
            }
            i = i + 1;
        }
        return;
    }
    if (k == EK_STRUCTINIT) {
        // A literal through a type alias (`type LI = Box<int>; LI{v: 3}`) names the aliased
        // struct; the node is rewritten to it so codegen sees the struct itself.
        int ahops = 0;
        while (ahops < 32) {
            *DeclNode ad = sema_find_tdecl(s, e.sval);
            if (ad == null || ad.kind != DK_TYPEALIAS) {
                ahops = 32;
            }
            else {
                e.sval = ad.ret_type;
            }
            ahops = ahops + 1;
        }
        string base = sema_base_name(e.sval);
        *DeclNode sd0 = sema_find_tdecl(s, base);
        List<string> sitargs;
        List_init<string>(&sitargs, 2);
        sema_parse_targs(e.sval, &sitargs);
        if (sema_is_type(s, base) == 0 || (sd0 != null && sd0.kind != DK_STRUCT && sd0.kind != DK_UNION)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: undefined struct '%s'\n", s.filename, s.line, s.col, base);
        } else if (sd0 != null && sd0.kind == DK_STRUCT && List_len<TypeParam>(&sd0.type_params) > 0
                   && List_len<string>(&sitargs) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: generic struct '%s' needs type arguments, as in %s<int>{...}\n", s.filename, s.line, s.col, base, base);
        } else if (sd0 != null && sd0.kind == DK_STRUCT && List_len<TypeParam>(&sd0.type_params) == 0
                   && List_len<string>(&sitargs) > 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: struct '%s' is not generic: write %s{...}\n", s.filename, s.line, s.col, base, base);
        }
        sema_infer_struct_fields(s, e);
        sema_check_struct_init(s, e);
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            sema_expr(s, List_get<*ExprNode>(&e.kids, i));
            i = i + 1;
        }
        return;
    }
    if (k == EK_TEMPLATECALL) {        // Name<args>(...) — check bounded-generic constraints
        sema_note_depr(s, sema_base_name(e.sval), e.line, e.col);
        *DeclNode fd = sema_find_fndecl(s, sema_base_name(e.sval));
        string tbase = sema_base_name(e.sval);
        if (fd == null && sema_streq(tbase, "va_arg") == 1) {
            List<string> vat;
            List_init<string>(&vat, 1);
            sema_parse_targs(e.sval, &vat);
            sema_check_va_list_arg(s, "va_arg", e);
            if (List_len<string>(&vat) == 1) {
                string vt = List_get<string>(&vat, 0);
                string vc = sema_canon(s, sema_isub(s, vt));
                if (sema_is_aggregate(s, vc) == 1 || sema_is_void_value(vc) == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: 'va_arg' cannot read a '%s': a variadic argument is an integer, a floating-point value or a pointer\n", s.filename, s.line, s.col, vt);
                } else {
                    // The default argument promotions: a float arrives as a double and a
                    // narrow integer as an int (mirrors the C++ va_arg check).
                    string vp = "";
                    if (sema_streq(vc, "float") == 1) {
                        vp = "double";
                    }
                    if (sema_streq(vc, "bool") == 1 || sema_streq(vc, "char") == 1 || sema_streq(vc, "int8") == 1
                        || sema_streq(vc, "int16") == 1 || sema_streq(vc, "uint8") == 1 || sema_streq(vc, "uint16") == 1) {
                        vp = "int";
                    }
                    if (vp[0] != 0) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: 'va_arg' cannot read a '%s': a variadic '%s' is promoted to '%s'; read va_arg<%s> and convert it\n",
                                s.filename, s.line, s.col, vt, vc, vp, vp);
                    }
                }
            }
        }
        if (fd == null && sema_is_variant_name(s, tbase) == 1) {
            List<string> vtargs;
            List_init<string>(&vtargs, 2);
            sema_parse_targs(e.sval, &vtargs);
            sema_infer_variant_payload(s, e, tbase, &vtargs);
            sema_check_variant_args(s, e, tbase, &vtargs);
        }
        if (fd == null && sema_streq(tbase, "va_arg") == 0 && sema_is_variant_name(s, tbase) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: undefined template function '%s'\n", s.filename, s.line, s.col, tbase);
        }
        if (fd != null) {
            List<string> targs;
            List_init<string>(&targs, 4);
            sema_parse_targs(e.sval, &targs);
            int tn = List_len<TypeParam>(&fd.type_params);
            int na = List_len<string>(&targs);
            int inst_ok = 1;
            if (tn > 0 && na != tn) {
                s.had_error = 1;
                inst_ok = 0;
                dprintf(2, "error: %s:%d:%d: generic function '%s' expects %d type argument(s), got %d\n", s.filename, s.line, s.col, fd.name, tn, na);
            }
            if (sema_check_generic_arity(s, fd, e) == 0) {
                inst_ok = 0;
            }
            if (na == tn && sema_check_constraints(s, &fd.type_params, &targs) == 0) {
                inst_ok = 0;
            }
            if (inst_ok == 1 && tn > 0) {
                // A generic variant argument takes the parameter's instance
                // (`get<int64>(Some(8))`), from the type arguments as written.
                int vai = 0;
                while (vai < List_len<*ExprNode>(&e.kids) && vai < List_len<Param>(&fd.params)) {
                    sema_infer_variant_r(s, List_get<*ExprNode>(&e.kids, vai),
                                         sema_subst_params(List_get<Param>(&fd.params, vai).ty, &fd.type_params, &targs), 1);
                    vai = vai + 1;
                }
                // The arguments against the instantiated parameter types.
                List<string> ctargs;
                List_init<string>(&ctargs, 4);
                int ci2 = 0;
                while (ci2 < na) {
                    List_push<string>(&ctargs, sema_isub(s, List_get<string>(&targs, ci2)));
                    ci2 = ci2 + 1;
                }
                int ai = 0;
                int an = List_len<*ExprNode>(&e.kids);
                while (ai < an && ai < List_len<Param>(&fd.params)) {
                    string pty = sema_subst_params(List_get<Param>(&fd.params, ai).ty, &fd.type_params, &ctargs);
                    if (sema_streq(pty, "...") == 1) {
                        sema_check_variadic_extras(s, e, ai);
                        ai = an;
                    }
                    else {
                        *ExprNode aexp = List_get<*ExprNode>(&e.kids, ai);
                        string aerr = sema_assign_err(s, pty, aexp);
                        if (aerr[0] != 0) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: argument %d: expected %s, got %s (%s)\n", s.filename, s.line, s.col, ai + 1, pty,
                                   sema_infer_type(s, aexp), aerr);
                        }
                        ai = ai + 1;
                    }
                }
                sema_queue_inst(s, fd, null, &targs, fd.name, "");
            }
        }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            if (fd != null && List_len<TypeParam>(&fd.type_params) > 0) {
                sema_generic_call_arg(s, fd, i, List_get<*ExprNode>(&e.kids, i));
            } else {
                sema_expr(s, List_get<*ExprNode>(&e.kids, i));
            }
            i = i + 1;
        }
        return;
    }
    // A lambda is its own (non-async) function: its body is checked with its parameters
    // in a fresh scope over the enclosing one (captures, with their null-narrowing), its
    // own return type, and no enclosing loop or switch (mirrors the C++ visit(LambdaExpr)).
    if (k == EK_LAMBDA) {
        sema_check_lambda(s, e);
        // A lambda returning a value must return on every path, like a function. Its
        // signature spelling is "R(T a, ...)".
        int lp = 0;
        while (e.sval[lp] != 0 && (int)e.sval[lp] != 40) {
            lp = lp + 1;
        }
        string lret = sema_trim_sub(e.sval, 0, lp);
        if (e.stmt != null && lret[0] != 0 && sema_streq(sema_strip_const(lret), "void") == 0
            && sema_always_returns(e.stmt) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: missing return in lambda returning '%s' (control can reach the end without returning a value)\n",
                   s.filename, s.line, s.col, lret);
        }
    }
}

// A lambda-bound local `name` read inside enclosing lambdas: each lambda it is outer to
// captures it (mirrors the C++ localCaptures).
void sema_note_local_capture(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) {
        return;
    }
    int sd = List_get<Sym>(&s.syms, si).depth;
    int j = 0;
    while (j < List_len<int>(&s.lam_bounds)) {
        if (sd <= List_get<int>(&s.lam_bounds, j)) {
            List_push<*ExprNode>(&s.lcap_lam, List_get<*ExprNode>(&s.lam_nodes, j));
            List_push<string>(&s.lcap_name, name);
        }
        j = j + 1;
    }
}

// Does lambda `l` outlive its creating call? Not when its env is already on the stack, nor
// when it is bound to a local only called outside an async body.
int sema_lam_outlives(Sema* s, *ExprNode l) {
    if (l.stack_env == 1) {
        return 0;
    }
    int i = 0;
    while (i < List_len<*ExprNode>(&s.wlam)) {
        if (List_get<*ExprNode>(&s.wlam, i) == l) {
            if (List_get<int>(&s.wlam_async, i) == 1) {
                return 1;
            }
            return sema_in_list(&s.wlocals_esc, List_get<string>(&s.wlam_name, i));
        }
        i = i + 1;
    }
    return 1;
}

// At the end of a function: a lambda bound to a local that is only called gets its env on
// the stack. The local escapes when it is used beyond a call or captured by a lambda that
// outlives the call. A local of an async body keeps a heap env: it lives in the frame
// across suspensions, and the async lowering frees it with the frame.
void sema_stack_envs(Sema* s) {
    int changed = 1;
    while (changed == 1) {
        changed = 0;
        int i = 0;
        while (i < List_len<string>(&s.lcap_name)) {
            string nm = List_get<string>(&s.lcap_name, i);
            if (sema_in_list(&s.wlocals_esc, nm) == 0 && sema_lam_outlives(s, List_get<*ExprNode>(&s.lcap_lam, i)) == 1) {
                List_push<string>(&s.wlocals_esc, nm);
                changed = 1;
            }
            i = i + 1;
        }
    }
    int k = 0;
    while (k < List_len<*ExprNode>(&s.wlam) && s.in_inst == 0) {   // not per instance (as the C++)
        if (List_get<int>(&s.wlam_async, k) == 0 && sema_in_list(&s.wlocals_esc, List_get<string>(&s.wlam_name, k)) == 0) {
            *ExprNode wl = List_get<*ExprNode>(&s.wlam, k);
            wl.stack_env = 1;
        }
        k = k + 1;
    }
}

// Is `name` (an outer variable) captured by an enclosing lambda that outlives the call?
int sema_captured_by_escaping(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) {
        return 0;
    }
    int sd = List_get<Sym>(&s.syms, si).depth;
    int j = 0;
    while (j < List_len<int>(&s.lam_bounds)) {
        // In an instance no lambda's env is decided yet: each one outlives the call.
        if (sd <= List_get<int>(&s.lam_bounds, j) && (List_get<int>(&s.lam_esc, j) == 1 || s.in_inst == 1)) {
            // A lambda bound to a local escapes only if that local is used beyond a call.
            string lo = List_get<string>(&s.lam_local_of, j);
            if (lo[0] == 0 || s.in_inst == 1) {
                return 1;
            }
            List_push<string>(&s.cap_param, name);
            List_push<string>(&s.cap_local, lo);
        }
        j = j + 1;
    }
    return 0;
}

// Note a lambda whose env is decided after the instances; `esc` = 1 when this use escapes.
void sema_defer_lambda(Sema* s, *ExprNode lam, int esc) {
    int i = 0;
    while (i < List_len<*ExprNode>(&s.dl_lam)) {
        if (List_get<*ExprNode>(&s.dl_lam, i) == lam) {
            if (esc == 1) {
                List_set<int>(&s.dl_esc, i, 1);
            }
            return;
        }
        i = i + 1;
    }
    List_push<*ExprNode>(&s.dl_lam, lam);
    List_push<int>(&s.dl_esc, esc);
}

// Argument `i` of a call to the generic `fd` (mirrors the C++ visitGenericCallArg). A
// closure param of the instance being checked, passed to a non-escaping param of `fd`,
// escapes only if that param does; a lambda passed to one is decided after the instances.
void sema_generic_call_arg(Sema* s, *DeclNode fd, int i, *ExprNode ka) {
    int esc = fd.is_async;
    if (i < List_len<int>(&fd.param_escaping) && List_get<int>(&fd.param_escaping, i) == 1) {
        esc = 1;
    }
    if (i >= List_len<Param>(&fd.params) || sema_streq(List_get<Param>(&fd.params, i).ty, "...") == 1) {
        esc = 1;
    }
    int own = -1;
    if (ka != null && ka.kind == EK_IDENT && esc == 0 && s.in_inst == 1 && s.cur_tmpl != null
        && sema_in_list(&s.watched, ka.sval) == 1) {
        int j = 0;
        while (j < List_len<Param>(&s.cur_tmpl.params)) {
            if (sema_streq(List_get<Param>(&s.cur_tmpl.params, j).name, ka.sval) == 1) {
                own = j;
            }
            j = j + 1;
        }
    }
    if (own >= 0) {
        string prev = s.callee_ctx;
        s.callee_ctx = ka.sval;
        sema_expr(s, ka);
        s.callee_ctx = prev;
        List_push<*DeclNode>(&s.gfw_fn, s.cur_tmpl);
        List_push<int>(&s.gfw_idx, own);
        List_push<*DeclNode>(&s.gfw_to, fd);
        List_push<int>(&s.gfw_to_idx, i);
    } else {
        sema_expr(s, ka);
    }
    if (ka != null && ka.kind == EK_LAMBDA) {
        sema_defer_lambda(s, ka, esc);
        if (esc == 0) {
            List_push<*ExprNode>(&s.dv_lam, ka);
            List_push<*DeclNode>(&s.dv_fn, fd);
            List_push<int>(&s.dv_idx, i);
        }
    }
}

// The index of generic param (fn, idx) in the gpe lists, or -1 if no instance recorded it.
int sema_gpe_find(Sema* s, *DeclNode fd, int idx) {
    int i = 0;
    while (i < List_len<*DeclNode>(&s.gpe_fn)) {
        if (List_get<*DeclNode>(&s.gpe_fn, i) == fd && List_get<int>(&s.gpe_idx, i) == idx) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Does generic param (fn, idx) escape (unrecorded counts as escaping)?
int sema_gpe_escapes(Sema* s, *DeclNode fd, int idx) {
    int at = sema_gpe_find(s, fd, idx);
    if (at < 0) {
        return 1;
    }
    return List_get<int>(&s.gpe_esc, at);
}

// At the end of an instance of a free generic: whether each closure param escaped here.
void sema_record_generic_params(Sema* s, *DeclNode f) {
    if (s.in_inst == 0 || s.cur_tmpl == null) {
        return;
    }
    int i = 0;
    while (i < List_len<Param>(&f.params)) {
        Param pm = List_get<Param>(&f.params, i);
        if (sema_is_fn_type(sema_isub(s, pm.ty)) == 1) {
            int esc = f.is_async;
            if (i < List_len<int>(&f.param_escaping) && List_get<int>(&f.param_escaping, i) == 1) {
                esc = 1;
            }
            if (sema_in_list(&s.escaped, pm.name) == 1) {
                esc = 1;
            }
            int at = sema_gpe_find(s, s.cur_tmpl, i);
            if (at < 0) {
                List_push<*DeclNode>(&s.gpe_fn, s.cur_tmpl);
                List_push<int>(&s.gpe_idx, i);
                List_push<int>(&s.gpe_esc, esc);
            } else if (esc == 1) {
                List_set<int>(&s.gpe_esc, at, 1);
            }
        }
        i = i + 1;
    }
}

// Decide the env of every deferred lambda (mirrors the C++ finalizeGenericEscapes): a
// generic param escapes when an instance let it escape or it is forwarded to one that does.
void sema_finalize_generic_escapes(Sema* s) {
    int changed = 1;
    while (changed == 1) {
        changed = 0;
        int i = 0;
        while (i < List_len<*DeclNode>(&s.gfw_fn)) {
            *DeclNode from = List_get<*DeclNode>(&s.gfw_fn, i);
            int fi = List_get<int>(&s.gfw_idx, i);
            int at = sema_gpe_find(s, from, fi);
            if (at >= 0 && List_get<int>(&s.gpe_esc, at) == 0
                && sema_gpe_escapes(s, List_get<*DeclNode>(&s.gfw_to, i), List_get<int>(&s.gfw_to_idx, i)) == 1) {
                List_set<int>(&s.gpe_esc, at, 1);
                changed = 1;
            }
            i = i + 1;
        }
    }
    int l = 0;
    while (l < List_len<*ExprNode>(&s.dl_lam)) {
        *ExprNode lam = List_get<*ExprNode>(&s.dl_lam, l);
        int esc = List_get<int>(&s.dl_esc, l);
        int v = 0;
        while (v < List_len<*ExprNode>(&s.dv_lam)) {
            if (List_get<*ExprNode>(&s.dv_lam, v) == lam
                && sema_gpe_escapes(s, List_get<*DeclNode>(&s.dv_fn, v), List_get<int>(&s.dv_idx, v)) == 1) {
                esc = 1;
            }
            v = v + 1;
        }
        if (esc == 1) {
            lam.stack_env = 0;
        } else {
            lam.stack_env = 1;
        }
        l = l + 1;
    }
}

void sema_check_lambda(Sema* s, *ExprNode e) {
    List<string> ptys;
    List_init<string>(&ptys, 4);
    List<string> pnames;
    List_init<string>(&pnames, 4);
    sema_lambda_sig(e.sval, &ptys, &pnames);
    string saved_ret = s.cur_ret;
    int saved_async = s.in_async;
    int saved_seen = s.await_seen;
    int saved_trailing = s.in_trailing;
    s.in_trailing = e.trailing;
    int saved_fin = s.fin_depth;
    s.fin_depth = 0;
    int saved_catch = s.catch_depth;
    s.catch_depth = 0;
    int saved_sw = s.sw_depth;
    int saved_pd = s.param_depth;
    int saved_var = s.in_variadic;
    s.in_variadic = 0;
    List<string> saved_lbls = s.loop_lbls;
    List_init<string>(&s.loop_lbls, 4);
    // The body sees the enclosing null-narrowing; its assignments to captured copies do
    // not end it outside the lambda.
    List<string> saved_narrowed = s.narrowed;
    List_init<string>(&s.narrowed, 4);
    int ni = 0;
    while (ni < List_len<string>(&saved_narrowed)) {
        List_push<string>(&s.narrowed, List_get<string>(&saved_narrowed, ni));
        ni = ni + 1;
    }
    // The body runs later, when a global (or `static` local) may have been nulled.
    sema_drop_global_keys(&s.narrowed);
    sema_bump(s);
    string saved_ret_raw = s.cur_ret_raw;
    s.cur_ret = sema_isub(s, sema_lambda_ret(e.sval));
    s.cur_ret_raw = sema_lambda_ret(e.sval);
    if (s.lam_ret != null && s.lam_ret[0] != 0) {
        s.cur_ret = s.lam_ret;
        s.cur_ret_raw = s.lam_ret;
    }
    s.lam_ret = "";
    s.in_async = 0;
    s.sw_depth = 0;
    List_push<int>(&s.lam_bounds, s.depth);
    if (s.lam_arg_nonesc == 1) {
        List_push<int>(&s.lam_esc, 0);
    } else {
        List_push<int>(&s.lam_esc, 1);
    }
    s.lam_arg_nonesc = 0;
    // An argument to a non-escaping param of a (non-async) function does not outlive the
    // call: its env goes on the stack.
    if (s.lam_arg_stack == 1) {
        e.stack_env = 1;
    }
    s.lam_arg_stack = 0;
    List_push<*ExprNode>(&s.lam_nodes, e);
    List_push<string>(&s.lam_local_of, s.lam_local);
    s.lam_local = "";
    sema_push(s);
    List<string> seen;
    List_init<string>(&seen, 4);
    int i = 0;
    while (i < List_len<string>(&ptys)) {
        string pn = List_get<string>(&pnames, i);
        if (pn[0] != 0) {
            if (sema_in_list(&seen, pn) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: duplicate parameter '%s' in lambda\n", s.filename, s.line, s.col, pn);
            } else {
                List_push<string>(&seen, pn);
            }
            sema_define_at(s, pn, sema_isub(s, List_get<string>(&ptys, i)), 0, e.line, e.col, 1);
        }
        i = i + 1;
    }
    s.param_depth = s.depth;
    sema_stmt(s, e.stmt);
    sema_pop(s);
    if (s.stamp_all == 1 && s.in_inst == 0) {
        sema_stamp_captures(s, e);
    }
    List_remove<int>(&s.lam_bounds, List_len<int>(&s.lam_bounds) - 1);
    List_remove<int>(&s.lam_esc, List_len<int>(&s.lam_esc) - 1);
    List_remove<*ExprNode>(&s.lam_nodes, List_len<*ExprNode>(&s.lam_nodes) - 1);
    List_remove<string>(&s.lam_local_of, List_len<string>(&s.lam_local_of) - 1);
    s.cur_ret = saved_ret;
    s.cur_ret_raw = saved_ret_raw;
    s.in_async = saved_async;
    // An `await` in a trailing block is reported there; the function does not also lack one.
    if (e.trailing == 0 || s.await_seen == 0) {
        s.await_seen = saved_seen;
    }
    s.in_trailing = saved_trailing;
    s.fin_depth = saved_fin;
    s.catch_depth = saved_catch;
    s.sw_depth = saved_sw;
    s.param_depth = saved_pd;
    s.in_variadic = saved_var;
    s.loop_lbls = saved_lbls;
    s.narrowed = saved_narrowed;
    sema_bump(s);
}

// The `must_use` function whose result `ex`, evaluated for its side effects only, would
// discard: a call (also through a method or an operator overload) or either arm of a `?:`
// (mirrors the C++ discardedMustUse). "" if none.
// -Wunused-result: a call statement (`f(x);`, `x.m();`, `f<T>(x);`) whose value is a
// `Result<...>` instance (also through an alias) drops the error it may carry (mirrors
// the C++ warnUnusedResult; reported at the statement).
void sema_warn_unused_result(Sema* s, *ExprNode ex) {
    if (ex == null) {
        return;
    }
    string fname = "";
    if (ex.kind == EK_CALL && ex.a != null && ex.dbg_builtin == 0) {
        if (ex.a.kind == EK_IDENT || ex.a.kind == EK_MEMBER) {
            fname = ex.a.sval;
        }
    } else if (ex.kind == EK_TEMPLATECALL) {
        int j = 0;   // up to '<'
        while (ex.sval[j] != 0 && (int)ex.sval[j] != 60) {
            j = j + 1;
        }
        fname = sema_sub_str(ex.sval, 0, j);
    }
    if (fname[0] == 0) {
        return;
    }
    string t = sema_canon(s, sema_infer_type(s, ex));
    if (sema_starts_with(t, "Result<") == 0) {
        return;
    }
    sema_warn(s, "unused-result", s.line, s.col,
              sema_cat(sema_cat("result of '", fname), "' is a Result and is ignored (check it or use '?')"));
}

string sema_discarded_must_use(Sema* s, *ExprNode ex) {
    if (ex == null) {
        return "";
    }
    string fname = "";
    if (ex.kind == EK_CALL && ex.a != null && ex.a.kind == EK_IDENT) {
        fname = ex.a.sval;
    } else if (ex.kind == EK_CALL && ex.a != null && ex.a.kind == EK_MEMBER) {
        // Method-call syntax `x.m()` resolves to the free function `Type_m`.
        string sn = sema_struct_of_type(sema_infer_type(s, ex.a.a));
        if (sn[0] != 0) {
            fname = sema_cat(sema_cat(sn, "_"), ex.a.sval);
        }
    } else if (ex.kind == EK_TEMPLATECALL) {
        int j = 0;   // up to '<'
        while (ex.sval[j] != 0 && (int)ex.sval[j] != 60) {
            j = j + 1;
        }
        fname = sema_sub_str(ex.sval, 0, j);
    } else if (ex.kind == EK_TERNARY) {
        string f1 = sema_discarded_must_use(s, ex.b);
        if (f1[0] != 0) {
            return f1;
        }
        return sema_discarded_must_use(s, List_get<*ExprNode>(&ex.kids, 0));
    } else if (ex.kind == EK_BINARY && sema_is_assign(ex.sval) == 0 && ex.a != null && ex.b != null) {
        List<string> oty;   // an operator overload `a + b`
        List_init<string>(&oty, 2);
        List_push<string>(&oty, sema_infer_type(s, ex.a));
        List_push<string>(&oty, sema_infer_type(s, ex.b));
        *DeclNode od = sema_find_fndecl(s, ast_op_name(ex.sval, &oty));
        if (od != null) {
            fname = od.name;
            if (od.is_mustuse == 1) {
                return sema_fn_display(od);
            }
        }
        return "";
    }
    if (fname[0] != 0 && sema_fn_must_use(s, fname) == 1) {
        return fname;
    }
    return "";
}

// The bindings of a match-arm label "Variant(a, b)" into `out` (none without parentheses).
void sema_arm_bindings(string label, List<string>* out) {
    int i = 0;   // '('
    while (label[i] != 0 && (int)label[i] != 40) {
        i = i + 1;
    }
    if (label[i] == 0) {
        return;
    }
    int st = i + 1;
    int j = st;
    while (label[j] != 0 && (int)label[j] != 41) {
        if ((int)label[j] == 44) {
            string b = sema_trim_sub(label, st, j);
            if (b[0] != 0) {
                List_push<string>(out, b);
            }
            st = j + 1;
        }
        j = j + 1;
    }
    string last = sema_trim_sub(label, st, j);
    if (last[0] != 0) {
        List_push<string>(out, last);
    }
}
