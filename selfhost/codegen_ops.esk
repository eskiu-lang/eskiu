// Part of codegen.esk (operators and conversions), imported from it in order; compile codegen.esk, not this file alone.

// Floating-point arithmetic op → LLVM mnemonic ("" if not arithmetic). No bitwise/shift.
string cg_farith_op(string s) {
    if (cg_streq(s, "+") == 1) {
        return "fadd";
    }
    if (cg_streq(s, "-") == 1) {
        return "fsub";
    }
    if (cg_streq(s, "*") == 1) {
        return "fmul";
    }
    if (cg_streq(s, "/") == 1) {
        return "fdiv";
    }
    if (cg_streq(s, "%") == 1) {
        return "frem";
    }
    return "";
}

// Floating-point comparison predicate (ordered) → LLVM mnemonic ("" if not a comparison).
string cg_fcmp_pred(string s) {
    if (cg_streq(s, "==") == 1) {
        return "oeq";
    }
    if (cg_streq(s, "!=") == 1) {
        return "une";
    }
    if (cg_streq(s, "<") == 1) {
        return "olt";
    }
    if (cg_streq(s, ">") == 1) {
        return "ogt";
    }
    if (cg_streq(s, "<=") == 1) {
        return "ole";
    }
    if (cg_streq(s, ">=") == 1) {
        return "oge";
    }
    return "";
}

// Trap when the i1 `cond` holds (a --safe check, as the C++ emitSafeTrap).
void cg_safe_trap(Codegen* g, string cond) {
    g.uses_trap = 1;
    string fail = cg_lbl(g);
    string fine = cg_lbl(g);
    cg_emit(g, "  br i1 ");
    cg_emit(g, cond);
    cg_emit(g, ", label %");
    cg_emit(g, fail);
    cg_emit(g, ", label %");
    cg_emit(g, fine);
    cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, fail);
    cg_emit(g, "  call void @llvm.trap()\n  unreachable\n");
    g.terminated = 1;
    cg_label(g, fine);
}

// Under --safe, trap when the pointer about to be dereferenced is null (as the C++
// safeNonNull; a local's or global's own address is never null).
string cg_safe_nonnull(Codegen* g, string p) {
    if ((g.safe & 4) == 0 || p[0] != 37) {
        return p;
    }
    string z = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, z);
    cg_emit(g, " = icmp eq ptr ");
    cg_emit(g, p);
    cg_emit(g, ", null\n");
    cg_safe_trap(g, z);
    return p;
}

// A signed `add`/`sub`/`mul` under --safe: the llvm.s*.with.overflow form, trapping on
// overflow (as the C++ safeArith).
string cg_safe_arith(Codegen* g, string op, string ity, string a, string b) {
    string nm = cg_cat(cg_cat("llvm.s", op), cg_cat(".with.overflow.", ity));
    string rt = cg_cat(cg_cat("{ ", ity), ", i1 }");
    cg_ensure_extern(g, nm, cg_cat(cg_cat(cg_cat("declare ", rt), cg_cat(" @", nm)), cg_cat(cg_cat("(", ity), cg_cat(cg_cat(", ", ity), ")\n"))));
    string pr = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, pr);
    cg_emit(g, " = call ");
    cg_emit(g, rt);
    cg_emit(g, " @");
    cg_emit(g, nm);
    cg_emit(g, "(");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, a);
    cg_emit(g, ", ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, b);
    cg_emit(g, ")\n");
    string ov = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, ov);
    cg_emit(g, " = extractvalue ");
    cg_emit(g, rt);
    cg_emit(g, " ");
    cg_emit(g, pr);
    cg_emit(g, ", 1\n");
    cg_safe_trap(g, ov);
    string r = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, r);
    cg_emit(g, " = extractvalue ");
    cg_emit(g, rt);
    cg_emit(g, " ");
    cg_emit(g, pr);
    cg_emit(g, ", 0\n");
    return r;
}

// An integer literal operand ("12", "-1") as a value; `ok` is 0 for anything else.
int64 cg_const_int(string op, *int ok) {
    *ok = 0;
    if (op == null || op[0] == 0) {
        return (int64)0;
    }
    int i = 0;
    int neg = 0;
    if (op[0] == 45) {
        neg = 1;
        i = 1;
    }
    if (op[i] == 0) {
        return (int64)0;
    }
    let v: int64 = 0;
    while (op[i] != 0) {
        if (op[i] < 48 || op[i] > 57) {
            return (int64)0;
        }
        v = v * (int64)10 + (int64)(op[i] - 48);
        i = i + 1;
    }
    *ok = 1;
    if (neg == 1) {
        return -v;
    }
    return v;
}

// A shift count is taken modulo the operand width, as the C++ maskShiftCount: a count
// of the width or more (or a negative one) is never LLVM poison.
string cg_mask_shift(Codegen* g, string ity, string cnt) {
    int w = cg_int_w(ity);
    if (w <= 1) {
        return cnt;
    }
    int ok = 0;
    int64 c = cg_const_int(cnt, &ok);
    if (ok == 1 && c >= (int64)0 && c < (int64)w) {
        return cnt;
    }
    string t = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = and ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, cnt);
    cg_emit(g, ", ");
    cg_emit(g, cg_itoa(w - 1));
    cg_emit(g, "\n");
    return t;
}

// Integer `/` and `%` with defined results, as the C++ emitIntDivRem: a zero divisor
// traps, a signed division of the minimum by -1 wraps (quotient the minimum, remainder
// 0). A constant divisor other than 0 and -1 needs no check.
string cg_int_divrem(Codegen* g, string op, string ity, string a, string b) {
    int uns = 0;
    if (cg_streq(op, "udiv") == 1 || cg_streq(op, "urem") == 1) {
        uns = 1;
    }
    int ok = 0;
    int64 c = cg_const_int(b, &ok);
    int maybe_zero = 1;
    int maybe_neg1 = 1;
    if (ok == 1) {
        if (c != (int64)0) {
            maybe_zero = 0;
        }
        if (c != (int64)-1) {
            maybe_neg1 = 0;
        }
    }
    if (uns == 1) {
        maybe_neg1 = 0;
    }
    if (maybe_zero == 1) {
        g.uses_trap = 1;
        string z = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, z);
        cg_emit(g, " = icmp eq ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, b);
        cg_emit(g, ", 0\n");
        string fail = cg_lbl(g);
        string fine = cg_lbl(g);
        cg_emit(g, "  br i1 ");
        cg_emit(g, z);
        cg_emit(g, ", label %");
        cg_emit(g, fail);
        cg_emit(g, ", label %");
        cg_emit(g, fine);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, fail);
        cg_emit(g, "  call void @llvm.trap()\n");
        cg_emit(g, "  unreachable\n");
        g.terminated = 1;
        cg_label(g, fine);
    }
    string d = b;
    string isn1 = "";
    if (maybe_neg1 == 1) {
        isn1 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, isn1);
        cg_emit(g, " = icmp eq ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, b);
        cg_emit(g, ", -1\n");
        d = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, d);
        cg_emit(g, " = select i1 ");
        cg_emit(g, isn1);
        cg_emit(g, ", ");
        cg_emit(g, ity);
        cg_emit(g, " 1, ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, b);
        cg_emit(g, "\n");
    }
    string q = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, q);
    cg_emit(g, " = ");
    cg_emit(g, op);
    cg_emit(g, " ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, a);
    cg_emit(g, ", ");
    cg_emit(g, d);
    cg_emit(g, "\n");
    if (maybe_neg1 == 0 || cg_streq(op, "srem") == 1) {
        return q;
    }
    string ng = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, ng);
    cg_emit(g, " = sub ");
    cg_emit(g, ity);
    cg_emit(g, " 0, ");
    cg_emit(g, a);
    cg_emit(g, "\n");
    string r = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, r);
    cg_emit(g, " = select i1 ");
    cg_emit(g, isn1);
    cg_emit(g, ", ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, ng);
    cg_emit(g, ", ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, q);
    cg_emit(g, "\n");
    return r;
}

// float -> integer saturates (NaN is 0), as the C++ emitFloatToInt: the text of a
// call to `llvm.fpto[su]i.sat`, after the caller's `%t = `.
void cg_emit_fp_sat(Codegen* g, int uns, string fty, string fop, string ity) {
    string nm = "llvm.fptosi.sat.";
    if (uns == 1) {
        nm = "llvm.fptoui.sat.";
    }
    string sfx = "f64";
    if (cg_streq(fty, "float") == 1) {
        sfx = "f32";
    }
    string full = cg_cat(nm, cg_cat(ity, cg_cat(".", sfx)));
    cg_ensure_extern(g, full, cg_cat("declare ", cg_cat(ity, cg_cat(" @", cg_cat(full, cg_cat("(", cg_cat(fty, ")\n")))))));
    cg_emit(g, "call ");
    cg_emit(g, ity);
    cg_emit(g, " @");
    cg_emit(g, full);
    cg_emit(g, "(");
    cg_emit(g, fty);
    cg_emit(g, " ");
    cg_emit(g, fop);
    cg_emit(g, ")");
}

// Integer arithmetic/bitwise op → LLVM mnemonic ("" if not such an op).
string cg_arith_op(string s) {
    if (cg_streq(s, "+") == 1) {
        return "add";
    }
    if (cg_streq(s, "-") == 1) {
        return "sub";
    }
    if (cg_streq(s, "*") == 1) {
        return "mul";
    }
    if (cg_streq(s, "/") == 1) {
        return "sdiv";
    }
    if (cg_streq(s, "%") == 1) {
        return "srem";
    }
    if (cg_streq(s, "&") == 1) {
        return "and";
    }
    if (cg_streq(s, "|") == 1) {
        return "or";
    }
    if (cg_streq(s, "^") == 1) {
        return "xor";
    }
    if (cg_streq(s, "<<") == 1) {
        return "shl";
    }
    if (cg_streq(s, ">>") == 1) {
        return "ashr";
    }
    return "";
}

// Comparison op → LLVM icmp predicate ("" if not a comparison).
string cg_cmp_pred(string s) {
    if (cg_streq(s, "==") == 1) {
        return "eq";
    }
    if (cg_streq(s, "!=") == 1) {
        return "ne";
    }
    if (cg_streq(s, "<") == 1) {
        return "slt";
    }
    if (cg_streq(s, ">") == 1) {
        return "sgt";
    }
    if (cg_streq(s, "<=") == 1) {
        return "sle";
    }
    if (cg_streq(s, ">=") == 1) {
        return "sge";
    }
    return "";
}

// Arithmetic op honoring signedness: unsigned operands use udiv/urem/lshr (logical) in
// place of the signed sdiv/srem/ashr. Other ops are signedness-agnostic.
string cg_arith_op_s(string s, int uns) {
    if (uns == 1) {
        if (cg_streq(s, "/") == 1) {
            return "udiv";
        }
        if (cg_streq(s, "%") == 1) {
            return "urem";
        }
        if (cg_streq(s, ">>") == 1) {
            return "lshr";
        }
    }
    return cg_arith_op(s);
}

// Comparison predicate honoring signedness: unsigned operands use ult/ugt/ule/uge.
string cg_cmp_pred_s(string s, int uns) {
    if (uns == 1) {
        if (cg_streq(s, "<") == 1) {
            return "ult";
        }
        if (cg_streq(s, ">") == 1) {
            return "ugt";
        }
        if (cg_streq(s, "<=") == 1) {
            return "ule";
        }
        if (cg_streq(s, ">=") == 1) {
            return "uge";
        }
    }
    return cg_cmp_pred(s);
}

int cg_fn_exists(Codegen* g, string name) {
    return NameIdx_first(&g.fns_ix, name) >= 0;
}

// Resolve a binary/index `op` over operand types to its overload fn name (exact mangled-name
// match), or "". Operand numeric coercion is not mirrored (a C++-only nicety): declare the
// operator with the operand's exact type.
int cg_is_num_ty(Codegen* g, string t) {
    string ll = cg_lltype(g, t);
    if (cg_is_float(ll) == 1) {
        return 1;
    }
    if (cg_int_w(ll) > 0) {
        return 1;
    }
    return 0;
}

// Is a binary `op` declared for the exact operand types (a, b)? Returns its fn name or "".
// The overload named by operand types `tys`: declared with those spellings, or (through
// type aliases, `operator +(VV, VV)` for `type VV = V`) with the same dealiased ones.
string cg_op_lookup(Codegen* g, string op, List<string>* tys) {
    string nm = ast_op_name(op, tys);
    if (nm[0] == 0) {
        return "";
    }
    if (cg_fn_exists(g, nm) == 1) {
        return nm;
    }
    if (List_len<CgSub>(&g.opcanon) == 0) {
        return "";
    }
    let dt: List<string>;
    List_init<string>(&dt, 2);
    int i = 0;
    while (i < List_len<string>(tys)) {
        List_push<string>(&dt, cg_dealias(g, List_get<string>(tys, i)));
        i = i + 1;
    }
    string cn = ast_op_name(op, &dt);
    int k = 0;
    while (k < List_len<CgSub>(&g.opcanon)) {
        CgSub sb = List_get<CgSub>(&g.opcanon, k);
        if (cg_streq(sb.param, cn) == 1) {
            return sb.arg;
        }
        k = k + 1;
    }
    return "";
}

string cg_op_try(Codegen* g, string op, string a, string b) {
    let tys: List<string>;
    List_init<string>(&tys, 2);
    List_push<string>(&tys, a);
    List_push<string>(&tys, b);
    return cg_op_lookup(g, op, &tys);
}

string cg_op_resolve(Codegen* g, string op, string ta, string tb) {
    if (ta[0] == 0 || tb[0] == 0) {
        return "";
    }
    string r = cg_op_try(g, op, ta, tb);              // exact operand types
    if (r[0] != 0) {
        return r;
    }
    // Numeric coercion (mirrors the C++ resolver's assignability): a numeric operand may
    // match an operator declared with another numeric param type, so `V3 * 2.0` (double)
    // finds `operator *(V3, float)`. Try the standard numeric param spellings.
    if (cg_is_num_ty(g, tb) == 1) {
        r = cg_op_try(g, op, ta, "double");
        if (r[0] != 0) {
            return r;
        }
        r = cg_op_try(g, op, ta, "float");
        if (r[0] != 0) {
            return r;
        }
        r = cg_op_try(g, op, ta, "int");
        if (r[0] != 0) {
            return r;
        }
        r = cg_op_try(g, op, ta, "int64");
        if (r[0] != 0) {
            return r;
        }
    }
    if (cg_is_num_ty(g, ta) == 1) {
        r = cg_op_try(g, op, "double", tb);
        if (r[0] != 0) {
            return r;
        }
        r = cg_op_try(g, op, "float", tb);
        if (r[0] != 0) {
            return r;
        }
        r = cg_op_try(g, op, "int", tb);
        if (r[0] != 0) {
            return r;
        }
        r = cg_op_try(g, op, "int64", tb);
        if (r[0] != 0) {
            return r;
        }
    }
    return "";
}

string cg_op_resolve1(Codegen* g, string op, string ta) {
    if (ta[0] == 0) {
        return "";
    }
    let tys: List<string>;
    List_init<string>(&tys, 1);
    List_push<string>(&tys, ta);
    return cg_op_lookup(g, op, &tys);
}

// Emit a call to a resolved operator function with 1 or 2 operand exprs (a2 null = unary),
// reusing the normal EK_CALL lowering (arg coercion + struct-by-value ABI).
CgVal cg_op_call(Codegen* g, string fnname, *ExprNode a1, *ExprNode a2) {
    *ExprNode c = alloc<ExprNode>(1);
    c.kind = EK_CALL;
    c.a = cgb_ident(fnname);
    List_init<*ExprNode>(&c.kids, 2);
    List_push<*ExprNode>(&c.kids, a1);
    if (a2 != null) {
        List_push<*ExprNode>(&c.kids, a2);
    }
    return cg_expr(g, c);
}

// Is `t` an integer / numeric Eskiu type (a plain enum counts as int)? Mirrors the C++
// type checker's isIntType / isNumericType.
int cg_is_int_ety(Codegen* g, string t) {
    if (NameIdx_first(&g.enum_ix, t) >= 0) {
        return 1;
    }
    return cg_streq(t, "int") == 1 || cg_streq(t, "int8") == 1 || cg_streq(t, "int16") == 1
        || cg_streq(t, "int32") == 1 || cg_streq(t, "int64") == 1 || cg_streq(t, "uint") == 1
        || cg_streq(t, "uint8") == 1 || cg_streq(t, "uint16") == 1 || cg_streq(t, "uint32") == 1
        || cg_streq(t, "uint64") == 1 || cg_streq(t, "char") == 1 || cg_streq(t, "bool") == 1;
}

int cg_is_num_ety(Codegen* g, string t) {
    if (cg_streq(t, "float") == 1 || cg_streq(t, "double") == 1) {
        return 1;
    }
    return cg_is_int_ety(g, t);
}

int cg_is_ptr_ety(string t) {
    return cg_is_ptr_ty(t) == 1 || cg_streq(t, "string") == 1;
}

// The integer width an Eskiu type ranks at for promotion: 64/32, 16 for any narrower
// integer (it promotes to int), 0 for a non-integer.
int cg_rank_w(Codegen* g, string t) {
    if (cg_streq(t, "int64") == 1 || cg_streq(t, "uint64") == 1) {
        return 64;
    }
    if (cg_streq(t, "int") == 1 || cg_streq(t, "int32") == 1 || cg_streq(t, "uint") == 1
        || cg_streq(t, "uint32") == 1) {
        return 32;
    }
    if (cg_is_int_ety(g, t) == 1) {
        return 16;
    }
    return 0;
}

// The common type of two numeric operands. Mirrors the C++ TypeChecker::promoteType
// exactly (including its rank order), so signedness and width decisions agree.
string cg_promote(Codegen* g, string a, string b) {
    if (NameIdx_first(&g.enum_ix, a) >= 0) {
        a = "int";
    }
    if (NameIdx_first(&g.enum_ix, b) >= 0) {
        b = "int";
    }
    if (cg_streq(a, b) == 1) {
        return a;
    }
    if (cg_streq(a, "double") == 1 || cg_streq(b, "double") == 1) {
        return "double";
    }
    if (cg_streq(a, "float") == 1 || cg_streq(b, "float") == 1) {
        return "float";
    }
    // C's usual arithmetic conversions once an operand is int-sized or wider (a narrow
    // operand counts as int): signed/unsigned is unsigned unless the signed type is wider.
    int wa = cg_rank_w(g, a);
    int wb = cg_rank_w(g, b);
    if (wa > 0 && wb > 0 && (wa >= 32 || wb >= 32)) {
        int ua = 0;
        if (wa >= 32 && cg_is_unsigned(a) == 1) {
            ua = 1;
        }
        int ub = 0;
        if (wb >= 32 && cg_is_unsigned(b) == 1) {
            ub = 1;
        }
        if (wa < 32) {
            wa = 32;
        }
        if (wb < 32) {
            wb = 32;
        }
        int w = wa;
        int u = ua;
        if (ua == ub) {
            if (wb > wa) {
                w = wb;
            }
        }
        else {
            int wu = wa;
            int ws = wb;
            if (ub == 1) {
                wu = wb;
                ws = wa;
            }
            if (wu >= ws) {
                w = wu;
                u = 1;
            } else {
                w = ws;
                u = 0;
            }
        }
        if (w == 64) {
            if (u == 1) {
                return "uint64";
            }
            return "int64";
        }
        if (u == 1) {
            return "uint32";
        }
        return "int32";
    }
    if (cg_streq(a, "int64") == 1 || cg_streq(b, "int64") == 1) {
        return "int64";
    }
    if (cg_streq(a, "uint64") == 1 || cg_streq(b, "uint64") == 1) {
        return "uint64";
    }
    if (cg_streq(a, "int32") == 1 || cg_streq(b, "int32") == 1) {
        return "int32";
    }
    if (cg_streq(a, "uint32") == 1 || cg_streq(b, "uint32") == 1) {
        return "uint32";
    }
    if (cg_streq(a, "int16") == 1 || cg_streq(b, "int16") == 1) {
        return "int16";
    }
    if (cg_streq(a, "uint16") == 1 || cg_streq(b, "uint16") == 1) {
        return "uint16";
    }
    return a;
}

// The type of a built-in binary operator over operand types (l, r), "" if unknown.
// Mirrors the C++ TypeChecker::inferBinaryExprType.
string cg_binary_ety(Codegen* g, string op, string l, string r) {
    string cmp = cg_cmp_pred(op);
    if (cg_streq(op, "&&") == 1 || cg_streq(op, "||") == 1 || cmp[0] != 0) {
        return "bool";
    }
    l = cg_strip_nullable(l);
    r = cg_strip_nullable(r);
    if (l[0] == 0 || r[0] == 0) {
        return "";
    }
    if (cg_streq(op, "-") == 1 && cg_is_ptr_ety(l) == 1 && cg_is_ptr_ety(r) == 1) {
        return "int64";
    }
    if (cg_streq(op, "+") == 1 || cg_streq(op, "-") == 1) {
        if (cg_is_ptr_ety(l) == 1 && cg_is_int_ety(g, r) == 1) {
            return l;
        }
        if (cg_streq(op, "+") == 1 && cg_is_ptr_ety(r) == 1 && cg_is_int_ety(g, l) == 1) {
            return r;
        }
    }
    // C integer promotion: a narrower-than-int operand is an int; a shift has the
    // (promoted) type of its left operand alone.
    if (cg_rank_w(g, l) == 16) {
        l = "int";
    }
    if (cg_rank_w(g, r) == 16) {
        r = "int";
    }
    if ((cg_streq(op, "<<") == 1 || cg_streq(op, ">>") == 1) && cg_is_int_ety(g, l) == 1) {
        return l;
    }
    if (cg_is_num_ety(g, l) == 1 && cg_is_num_ety(g, r) == 1) {
        return cg_promote(g, l, r);
    }
    return "";
}

// The fn-type spelling of a lambda: `int(int x, double y)` → "fn(int,double)->int".
string cg_lambda_ety(*ExprNode e) {
    List<string> pp;
    List_init<string>(&pp, 4);
    cg_paren_list(e.sval, &pp);
    String s;
    String_init(&s, 32);
    String_append(&s, "fn(");
    int i = 0;
    while (i < List_len<string>(&pp)) {
        if (i > 0) {
            String_append(&s, ",");
        }
        String_append(&s, cg_drop_last_word(List_get<string>(&pp, i)));
        i = i + 1;
    }
    String_append(&s, ")->");
    String_append(&s, cg_arm_var(e.sval));
    return (string)String_cstr(&s);
}

// The return type of a generic function called without explicit type args, from the type
// args inferred off its arguments ("" if they can't be inferred). No instantiation.
string cg_infer_generic_ret(Codegen* g, *DeclNode gd, *ExprNode e) {
    string spelling = cg_infer_generic(g, gd, e);
    if (spelling[0] == 0) {
        return "";
    }
    spelling = cg_apply_sub(g, spelling);
    List<string> args;
    List_init<string>(&args, 4);
    cg_gen_args(spelling, &args);
    List<CgSub> oldsub = cg_push_sub(g, gd, &args);
    string rt = cg_apply_sub(g, gd.ret_type);
    g.cursub = oldsub;
    return rt;
}

// A ternary arm's type: an integer literal that does not fit `int` is 64-bit (C: the
// first of int, long, unsigned long that holds it), so `c ? x : 10000000000` is an int64.
string cg_lit_arm_etype(Codegen* g, *ExprNode e) {
    if (e != null && e.kind == EK_LITERAL && e.lit_kind == LIT_INT) {
        uint64 m = cg_int_lit_mag(e.sval);
        if (e.sval[0] != 45 && m > (uint64)9223372036854775807) {   // -2^63 is an int64
            return "uint64";
        }
        if (e.sval[0] == 45) {
            if (m > (uint64)2147483648) {
                return "int64";
            }
        }
        else if (m > (uint64)2147483647) {
            return "int64";
        }
        return "int";
    }
    // A named top-level function as an arm is a function value: its `fn(...)->R` type,
    // so the arm decays to a closure (`k > 0 ? inc : dbl`), as in the C++ type checker.
    if (e != null && e.kind == EK_IDENT && cg_find_local(g, e.sval).slot[0] == 0
        && cg_find_global(g, e.sval).slot[0] == 0 && NameIdx_first(&g.topfns_ix, e.sval) >= 0) {
        CgFn f = cg_find_fn(g, e.sval);
        string ft = "fn(";
        int i = 0;
        while (i < List_len<string>(&f.petys)) {
            if (i > 0) {
                ft = cg_cat(ft, ", ");
            }
            ft = cg_cat(ft, List_get<string>(&f.petys, i));
            i = i + 1;
        }
        return cg_cat(ft, cg_cat(")->", f.rety));
    }
    return cg_etype(g, e);
}

// The common type of a ternary's two arm types (C++ rule).
string cg_arm_common(Codegen* g, string tt, string et) {
    if (cg_streq(tt, et) == 1) {
        return tt;
    }
    if (tt[0] == 0) {
        return et;
    }
    if (et[0] == 0) {
        return tt;
    }
    // A struct-pointer arm meets an interface arm as the interface.
    if (cg_is_iface(g, cg_dealias(g, et)) == 1 && cg_is_iface(g, cg_dealias(g, tt)) == 0) {
        return et;
    }
    if (cg_is_num_ety(g, tt) == 1 && cg_is_num_ety(g, et) == 1) {
        // Two different numeric types: C's usual arithmetic conversions (narrow arms meet as int).
        if (cg_rank_w(g, tt) == 16) {
            tt = "int";
        }
        if (cg_rank_w(g, et) == 16) {
            et = "int";
        }
        return cg_promote(g, tt, et);
    }
    return tt;
}

void cg_ternary_etys(Codegen* g, *ExprNode e, List<*ExprNode>* chain, List<string>* etys);

// Stamp every `?:` reachable from `e` through `?:` operands with its type, bottom-up, so
// a nested ternary is typed once instead of once per enclosing level.
void cg_tern_stamp(Codegen* g, *ExprNode e) {
    *ExprNode n = e;
    while (true) {
        if (n.a != null && n.a.kind == EK_TERNARY) {
            cg_tern_stamp(g, n.a);
        }
        if (n.b != null && n.b.kind == EK_TERNARY) {
            cg_tern_stamp(g, n.b);
        }
        *ExprNode els = List_get<*ExprNode>(&n.kids, 0);
        if (els == null || els.kind != EK_TERNARY) {
            break;
        }
        n = els;
    }
    List<*ExprNode> chain;
    List_init<*ExprNode>(&chain, 4);
    List<string> etys;
    List_init<string>(&etys, 4);
    cg_ternary_etys(g, e, &chain, &etys);
    int i = 0;
    while (i < List_len<*ExprNode>(&chain)) {
        *ExprNode c = List_get<*ExprNode>(&chain, i);
        c.cg_ety = List_get<string>(&etys, i);
        c.cg_stamp = g.tactive;
        i = i + 1;
    }
    List_free<*ExprNode>(&chain);
    List_free<string>(&etys);
}

// Open a stamp for the outermost `?:` being emitted (an expression declares no local and
// function bodies are emitted from queues, so the types hold until it is done). Returns 1
// when this call opened it (the caller closes it with g.tactive = 0).
int cg_tern_begin(Codegen* g, *ExprNode e) {
    if (g.tactive != 0) {
        return 0;
    }
    g.mstamp = g.mstamp + 1;
    g.tactive = g.mstamp;
    cg_tern_stamp(g, e);
    return 1;
}

// A ternary whose else arm is itself a ternary (`c1 ? a : c2 ? b : ...`) nests as deep
// as the chain is long. Fills `chain` with its links (outermost first) and `etys` with
// each link's type, computed once, bottom-up, instead of once per link.
void cg_ternary_etys(Codegen* g, *ExprNode e, List<*ExprNode>* chain, List<string>* etys) {
    List<string> tts;
    List_init<string>(&tts, 4);
    *ExprNode n = e;
    while (true) {
        List_push<*ExprNode>(chain, n);
        List_push<string>(&tts, cg_lit_arm_etype(g, n.b));
        *ExprNode els = List_get<*ExprNode>(&n.kids, 0);
        if (els == null || els.kind != EK_TERNARY) {
            break;
        }
        n = els;
    }
    int k = List_len<*ExprNode>(chain);
    int i = 0;
    while (i < k) {
        List_push<string>(etys, "");
        i = i + 1;
    }
    *ExprNode last = List_get<*ExprNode>(chain, k - 1);
    string et = cg_lit_arm_etype(g, List_get<*ExprNode>(&last.kids, 0));
    i = k - 1;
    while (i >= 0) {
        et = cg_arm_common(g, List_get<string>(&tts, i), et);
        List_set<string>(etys, i, et);
        i = i - 1;
    }
    List_free<string>(&tts);
}

// The type of prefix operator `e` over an operand of type `at`.
string cg_unary_ety(Codegen* g, *ExprNode e, string at) {
    if (cg_streq(e.sval, "*") == 1) {
        return cg_deref_ty(at);
    }
    if (cg_streq(e.sval, "&") == 1) {
        return cg_cat("*", at);
    }
    string uop = e.sval;
    if (cg_streq(uop, "-") == 1) {
        uop = "u-";
    }
    string uopn = cg_op_resolve1(g, uop, at);
    if (uopn[0] != 0) {
        return cg_find_fn(g, uopn).rety;
    }
    if (cg_streq(e.sval, "!") == 1) {
        return "bool";
    }
    if ((cg_streq(e.sval, "-") == 1 || cg_streq(e.sval, "~") == 1) && cg_rank_w(g, at) == 16) {
        return "int";
    }
    return at;
}

// The Eskiu type of an expression ("" if unknown). Mirrors the type the C++ type checker
// assigns, so struct member access, pointer depth, and common/promoted types agree.
// `x.m(args)` where x is an instance `S<A..>` of a generic struct (or enum) with no inline method
// `m` but a generic free function `S_m<T..>` taking it first (the `Type_method`
// convention, e.g. `List_push<T>(List<T>* self, T item)`): the equivalent explicit call
// `S_m<A..>(&x, args)` (`S_m<A..>(x, args)` for a pointer receiver). A type parameter
// named by the self parameter's type arguments takes the receiver's argument at that
// position; any other one is inferred from the arguments. null when `e` is not such a call.
*ExprNode cg_generic_method_call(Codegen* g, *ExprNode e) {
    if (e == null || e.a == null || e.a.kind != EK_MEMBER) {
        return null;
    }
    string recv = cg_apply_sub(g, cg_etype(g, e.a.a));
    int rptr = cg_is_ptr_ty(recv);
    string sname = recv;
    if (rptr == 1) {
        sname = cg_strip_ptr(recv);
    }
    if (cg_has_targs(sname) == 0) {
        return null;
    }
    string base = cg_gen_base(sname);
    *DeclNode sd = cg_find_gstruct(g, base);
    if (sd == null && cg_find_genum(g, base) == null) {
        return null;
    }
    int mi = 0;
    while (sd != null && mi < List_len<*DeclNode>(&sd.methods)) {
        if (cg_streq(List_get<*DeclNode>(&sd.methods, mi).name, e.a.sval) == 1) {
            return null;
        }
        mi = mi + 1;
    }
    *DeclNode gd = cg_find_gfn(g, cg_cat(cg_cat(base, "_"), e.a.sval));
    if (gd == null || List_len<Param>(&gd.params) == 0) {
        return null;
    }
    string selfty = List_get<Param>(&gd.params, 0).ty;
    List<string> sargs;
    List_init<string>(&sargs, 2);
    cg_gen_args(cg_strip_ptr(selfty), &sargs);
    List<string> rargs;
    List_init<string>(&rargs, 2);
    cg_gen_args(sname, &rargs);
    String sp;
    String_init(&sp, 16);
    String_append(&sp, gd.name);
    String_append(&sp, "<");
    int ti = 0;
    int ntp = List_len<TypeParam>(&gd.type_params);
    while (ti < ntp) {
        string tp = List_get<TypeParam>(&gd.type_params, ti).name;
        string binding = "";
        int k = 0;
        while (binding[0] == 0 && k < List_len<string>(&sargs) && k < List_len<string>(&rargs)) {
            if (cg_streq(List_get<string>(&sargs, k), tp) == 1) {
                binding = List_get<string>(&rargs, k);
            }
            k = k + 1;
        }
        int pi = 1;
        int np = List_len<Param>(&gd.params);
        while (binding[0] == 0 && pi < np && pi - 1 < List_len<*ExprNode>(&e.kids)) {
            string argty = cg_etype(g, List_get<*ExprNode>(&e.kids, pi - 1));
            if (argty[0] != 0) {
                binding = cg_infer_bind(List_get<Param>(&gd.params, pi).ty, tp, argty);
            }
            pi = pi + 1;
        }
        if (binding[0] == 0) {
            return null;
        }
        if (ti > 0) {
            String_append(&sp, ", ");
        }
        String_append(&sp, binding);
        ti = ti + 1;
    }
    String_append(&sp, ">");
    int sptr = cg_is_ptr_ty(selfty);
    *ExprNode r = e.a.a;
    if (sptr != rptr) {
        *ExprNode u = alloc<ExprNode>(1);
        u.kind = EK_UNARY;
        u.a = r;
        u.line = e.line;
        u.col = e.col;
        if (sptr == 1) {
            u.sval = "&";
        } else {
            u.sval = "*";
        }
        r = u;
    }
    *ExprNode c = alloc<ExprNode>(1);
    c.kind = EK_TEMPLATECALL;
    c.sval = (string)String_cstr(&sp);
    c.line = e.line;
    c.col = e.col;
    List_init<*ExprNode>(&c.kids, List_len<*ExprNode>(&e.kids) + 1);
    List_push<*ExprNode>(&c.kids, r);
    int ki = 0;
    while (ki < List_len<*ExprNode>(&e.kids)) {
        List_push<*ExprNode>(&c.kids, List_get<*ExprNode>(&e.kids, ki));
        ki = ki + 1;
    }
    return c;
}

// The return type of a generic free-function call spelled `name<args>` (the instance's
// substituted return type; the instance itself need not be emitted yet).
string cg_generic_call_ret(Codegen* g, string spelling) {
    *DeclNode gd = cg_find_gfn(g, cg_gen_base(spelling));
    if (gd == null) {
        return "";
    }
    List<string> args;
    List_init<string>(&args, 4);
    cg_gen_args(spelling, &args);
    List<CgSub> oldsub = cg_push_sub(g, gd, &args);
    string rt = cg_apply_sub(g, gd.ret_type);
    g.cursub = oldsub;
    return rt;
}

// The type of a `for (i in A..B)` bound: a bare integer literal by its value (the
// first of int, int64, uint64 that holds it, as sema types it), else its expression type.
string cg_range_bound_type(Codegen* g, *ExprNode e) {
    if (e != null && e.kind == EK_LITERAL && e.lit_kind == LIT_INT) {
        return ast_range_lit_type(e.sval);
    }
    return cg_dealias(g, cg_strip_lead_const(cg_etype(g, e)));
}

string cg_etype_raw(Codegen* g, *ExprNode e);
string cg_etype(Codegen* g, *ExprNode e);

// The type of member `field` of a value of type `bet` ("" when unknown; a narrow bitfield
// reads as int).
string cg_member_ety(Codegen* g, string bet, string field) {
    string sname = bet;
    if (cg_is_ptr_ty(bet) == 1) {
        sname = cg_strip_ptr(bet);
    }
    CgStruct s = cg_find_struct(g, sname);
    int idx = cg_field_idx(&s, field);
    if (idx >= 0) {
        CgBF bslot = cg_bf(g, sname, field);
        if (bslot.bw > 0) {
            return cg_bf_read_ety(g, bslot);
        }
        return List_get<string>(&s.fetys, idx);
    }
    return "";
}

// Emitting a member chain `a.b.c...` asks for the type of every base at every level,
// which is quadratic in the chain's length. So the outermost member of a chain types the
// whole chain once, innermost first, and stamps each member node with its type; the
// stamps hold while that chain is emitted (no local is declared inside an expression).
// Returns 1 when this call opened the stamp (the caller closes it with g.mactive = 0).
int cg_chain_begin(Codegen* g, *ExprNode e) {
    if (g.mactive != 0 || e == null || e.kind != EK_MEMBER) {
        return 0;
    }
    List<*ExprNode> chain;
    List_init<*ExprNode>(&chain, 4);
    *ExprNode base = e;
    while (base != null && base.kind == EK_MEMBER) {
        List_push<*ExprNode>(&chain, base);
        base = base.a;
    }
    string t = cg_etype(g, base);
    g.mstamp = g.mstamp + 1;
    int i = List_len<*ExprNode>(&chain) - 1;
    while (i >= 0) {
        *ExprNode m = List_get<*ExprNode>(&chain, i);
        string raw = cg_member_ety(g, t, m.sval);
        if (raw[0] != 0) {   // an unknown type is recomputed
            m.cg_ety = raw;
            m.cg_stamp = g.mstamp;
        }
        t = cg_dealias(g, raw);
        i = i - 1;
    }
    List_free<*ExprNode>(&chain);
    g.mactive = g.mstamp;
    return 1;
}

// The Eskiu type of an expression, never spelled as a type alias: every shape check
// (pointer, array, slice, fn value, interface) sees the alias target (mirrors the C++
// getExprEskiuTypeRaw).
string cg_etype(Codegen* g, *ExprNode e) {
    return cg_dealias(g, cg_etype_raw(g, e));
}

string cg_etype_raw(Codegen* g, *ExprNode e) {
    if (e == null) {
        return "";
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {   // int, int64 or uint64 by value
            return cg_lit_arm_etype(g, e);
        }
        if (e.lit_kind == LIT_FLOAT) {
            return "double";
        }
        if (e.lit_kind == LIT_BOOL) {
            return "bool";
        }
        if (e.lit_kind == LIT_CHAR) {
            return "char";
        }
        if (e.lit_kind == LIT_STRING) {
            return "string";
        }
        return "";
    }
    if (e.kind == EK_IDENT) {
        CgLocal l = cg_find_local(g, e.sval);
        if (l.slot[0] != 0) {
            return l.ety;
        }
        CgLocal gl = cg_find_global(g, e.sval);
        if (gl.slot[0] != 0) {
            return gl.ety;
        }
        string ev = cg_enum_val(g, e.sval);                // a plain-enum / folded const-int constant
        if (ev[0] != 0) {
            return "int";
        }
        CgVariant var = cg_find_variant(g, e.sval);        // a payload-less ADT variant (`None`)
        if (var.ename[0] != 0) {
            return var.ename;
        }
        return "";
    }
    if (e.kind == EK_MEMBER) {
        if (g.mactive != 0 && e.cg_stamp == g.mactive) {
            return e.cg_ety;
        }
        return cg_member_ety(g, cg_etype(g, e.a), e.sval);
    }
    if (e.kind == EK_INDEX) {
        string bet = cg_etype(g, e.a);
        string elem = "";
        if (cg_streq(bet, "string") == 1) {
            elem = "char";
        }
        else if (cg_is_slice(bet) == 1) {
            elem = cg_array_elem(bet);
        }
        else if (cg_is_array(bet) == 1) {
            elem = cg_array_elem(bet);
        }
        else if (cg_is_ptr_ty(bet) == 1) {
            elem = cg_deref_ty(bet);
        }
        else {
            if (List_len<*ExprNode>(&e.kids) == 0) {       // overloaded subscript `base[i]`
                string opn = cg_op_resolve(g, "[]", bet, cg_etype(g, e.b));
                if (opn[0] != 0) {
                    return cg_find_fn(g, opn).rety;
                }
            }
            return "";
        }
        // `base[lo..hi]` (kids has the hi bound) is a slice of the element type.
        if (List_len<*ExprNode>(&e.kids) > 0) {
            return cg_cat(elem, "[]");
        }
        return elem;
    }
    if (e.kind == EK_UNARY) {
        // A chain of prefix operators (`- - x`, `!!p`, `**pp`) is typed along its operand
        // spine with a loop, each operand's type computed once.
        List<*ExprNode> spine;
        List_init<*ExprNode>(&spine, 4);
        *ExprNode u = e;
        while (u != null && u.kind == EK_UNARY) {
            List_push<*ExprNode>(&spine, u);
            u = u.a;
        }
        string ut = cg_etype(g, u);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            ut = cg_unary_ety(g, List_get<*ExprNode>(&spine, i), ut);
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        return ut;
    }
    if (e.kind == EK_BINARY) {
        if (cg_streq(e.sval, "=") == 1) {   // assignment yields the target's type
            return cg_etype(g, e.a);
        }
        // A left-leaning chain (`a + b + c ...`) is typed along its left spine with a loop:
        // the leftmost operand, then each operator bottom-up over the running type.
        // While a binary expression is emitted (g.bactive), each node's type is stamped on
        // it once known, so an operand nested on the right (`a + (a + (...))`) is typed
        // once instead of once per enclosing level.
        if (g.bactive != 0 && e.cg_stamp == g.bactive) {
            return e.cg_ety;
        }
        List<*ExprNode> spine;
        List_init<*ExprNode>(&spine, 8);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY && cg_streq(b.sval, "=") == 0) {
            List_push<*ExprNode>(&spine, b);
            b = b.a;
        }
        string lt = cg_etype(g, b);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            string rt = cg_etype(g, n.b);
            string bopn = cg_op_resolve(g, n.sval, lt, rt);   // overloaded binary → its ret type
            if (bopn[0] != 0) {
                lt = cg_find_fn(g, bopn).rety;
            }
            else {
                lt = cg_binary_ety(g, n.sval, lt, rt);
            }
            if (g.bactive != 0 && lt[0] != 0) {   // an unknown type is recomputed
                n.cg_ety = lt;
                n.cg_stamp = g.bactive;
            }
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        return lt;
    }
    if (e.kind == EK_TEMPLATECALL) {
        List<string> ta;
        List_init<string>(&ta, 2);
        cg_gen_args(e.sval, &ta);
        string vb = cg_gen_base(e.sval);
        if (cg_streq(vb, "va_arg") == 1 && List_len<string>(&ta) > 0) {
            return cg_apply_sub(g, List_get<string>(&ta, 0));
        }
        CgVariant gvar = cg_find_gvariant(g, vb);          // generic variant ctor `Some<int>(…)`
        if (gvar.ename[0] != 0) {
            String sp;
            String_init(&sp, 16);
            String_append(&sp, gvar.ename);
            String_append(&sp, "<");
            int ti = 0;
            while (ti < List_len<string>(&ta)) {
                if (ti > 0) {
                    String_append(&sp, ", ");
                }
                String_append(&sp, List_get<string>(&ta, ti));
                ti = ti + 1;
            }
            String_append(&sp, ">");
            return cg_ensure_enum_inst(g, (string)String_cstr(&sp));
        }
        string trt = cg_find_fn(g, cg_mangle(cg_apply_sub(g, e.sval))).rety;
        // Not instantiated yet (an argument typed for inference, `spawn(task<int>(3))`):
        // the template's substituted return type.
        if (trt[0] == 0) {
            trt = cg_generic_call_ret(g, cg_apply_sub(g, e.sval));
        }
        return trt;
    }
    if (e.kind == EK_CALL) {
        if (e.a != null && e.a.kind == EK_MEMBER) {
            string cft = cg_etype(g, e.a);                 // a closure-typed field: `fr.waker()`
            if (cg_is_fnty(cft) == 1) {
                return cg_fnty_ret(cft);
            }
            string recv = cg_etype(g, e.a.a);
            if (cg_is_iface(g, recv) == 1) {               // interface dispatch → the method's ret
                CgIface f = cg_find_iface(g, recv);
                int mi = cg_iface_midx(&f, e.a.sval);
                if (mi >= 0) {
                    return List_get<string>(&f.mrets, mi);
                }
                return "";
            }
            *ExprNode gmc = cg_generic_method_call(g, e);   // `l.push(x)` → `List_push<T>(&l, x)`
            if (gmc != null) {
                return cg_generic_call_ret(g, gmc.sval);
            }
            string sname = cg_strip_ptr(recv);            // method call → Struct_method
            string mname = cg_method_fn(g, sname, e.a.sval);
            if (cg_is_fn(g, mname) == 0 && cg_is_struct(g, sname) == 0 && cg_is_fn(g, e.a.sval) == 1) {
                return cg_find_fn(g, e.a.sval).rety;       // primitive receiver → free fn `m(recv, …)`
            }
            return cg_find_fn(g, mname).rety;
        }
        if (e.a != null && e.a.kind == EK_IDENT) {
            CgLocal lf = cg_find_local(g, e.a.sval);
            if (lf.slot[0] == 0) {
                lf = cg_find_global(g, e.a.sval);
            }
            if (lf.slot[0] != 0 && cg_is_fnty(lf.ety) == 1) {   // closure call
                return cg_fnty_ret(lf.ety);
            }
            if (cg_streq(e.a.sval, "va_start") == 1 || cg_streq(e.a.sval, "va_end") == 1) {
                return "void";
            }
            if (cg_streq(e.a.sval, "exception_text") == 1 && List_len<*ExprNode>(&e.kids) == 0 && lf.slot[0] == 0) {
                return "string";
            }
            if (e.dbg_builtin == 1) {
                return cg_etype(g, List_get<*ExprNode>(&e.kids, 0));
            }
            CgVariant var = cg_find_variant(g, e.a.sval);  // ADT variant constructor `Circle(4)`
            if (var.ename[0] != 0) {
                return var.ename;
            }
            *DeclNode gd = cg_find_gfn(g, e.a.sval);        // generic fn, type args inferred
            if (gd != null) {
                return cg_infer_generic_ret(g, gd, e);
            }
            return cg_find_fn(g, e.a.sval).rety;
        }
        string ct = cg_etype(g, e.a);                      // any other callee yielding a closure
        if (cg_is_fnty(ct) == 1) {
            return cg_fnty_ret(ct);
        }
        return "";
    }
    if (e.kind == EK_CAST) {
        return cg_apply_sub(g, e.sval);
    }
    if (e.kind == EK_TERNARY) {                        // common type of the two arms (C++ rule)
        if (g.tactive != 0 && e.cg_stamp == g.tactive) {
            return e.cg_ety;
        }
        List<*ExprNode> chain;
        List_init<*ExprNode>(&chain, 4);
        List<string> etys;
        List_init<string>(&etys, 4);
        cg_ternary_etys(g, e, &chain, &etys);
        string tty = List_get<string>(&etys, 0);
        List_free<*ExprNode>(&chain);
        List_free<string>(&etys);
        return tty;
    }
    if (e.kind == EK_STRUCTINIT) {
        return cg_apply_sub(g, e.sval);
    }
    if (e.kind == EK_SIZEOF) {
        return "int64";
    }
    if (e.kind == EK_INCDEC) {
        // `b.f++` of a bitfield: the old value in its declared type (as clang).
        if ((int)e.sval[1] != 114 && e.a != null && e.a.kind == EK_MEMBER) {
            string ibt = cg_etype(g, e.a.a);
            string isn = ibt;
            if (cg_is_ptr_ty(ibt) == 1) {
                isn = cg_strip_ptr(ibt);
            }
            CgBF islot = cg_bf(g, isn, e.a.sval);
            if (islot.bw > 0) {
                return islot.fety;
            }
        }
        return cg_etype(g, e.a);
    }
    if (e.kind == EK_LAMBDA) {
        return cg_lambda_ety(e);
    }
    if (e.kind == EK_ALLOCWITH) {
        return cg_cat("*", cg_apply_sub(g, e.sval));
    }
    if (e.kind == EK_THREADCREATE) {
        return "*void";
    }
    if (e.kind == EK_QUESTION) {                       // `r?` → the Result's `.value` type
        string rs = cg_etype(g, e.a);
        CgStruct s = cg_find_struct(g, rs);
        int vi = cg_field_idx(&s, "value");
        if (vi >= 0) {
            return List_get<string>(&s.fetys, vi);
        }
        return "";
    }
    return "";
}
