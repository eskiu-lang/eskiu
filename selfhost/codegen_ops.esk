// Part of codegen.esk (operators and conversions), imported from it in order; compile codegen.esk, not this file alone.

// Floating-point arithmetic op → LLVM mnemonic ("" if not arithmetic). No bitwise/shift.
string cg_farith_op(string s) {
    if (cg_streq(s, "+") == 1) {
        return "fadd";
    }
    if (cg_streq(s, "-") == 1) {
        return "fsub";
    }
    if (cg_streq(s, "*") == 1) {
        return "fmul";
    }
    if (cg_streq(s, "/") == 1) {
        return "fdiv";
    }
    if (cg_streq(s, "%") == 1) {
        return "frem";
    }
    return "";
}

// Floating-point comparison predicate (ordered) → LLVM mnemonic ("" if not a comparison).
string cg_fcmp_pred(string s) {
    if (cg_streq(s, "==") == 1) {
        return "oeq";
    }
    if (cg_streq(s, "!=") == 1) {
        return "une";
    }
    if (cg_streq(s, "<") == 1) {
        return "olt";
    }
    if (cg_streq(s, ">") == 1) {
        return "ogt";
    }
    if (cg_streq(s, "<=") == 1) {
        return "ole";
    }
    if (cg_streq(s, ">=") == 1) {
        return "oge";
    }
    return "";
}

// An integer literal operand ("12", "-1") as a value; `ok` is 0 for anything else.
int64 cg_const_int(string op, *int ok) {
    *ok = 0;
    if (op == null || op[0] == 0) {
        return (int64)0;
    }
    int i = 0;
    int neg = 0;
    if (op[0] == 45) {
        neg = 1;
        i = 1;
    }
    if (op[i] == 0) {
        return (int64)0;
    }
    let v: int64 = 0;
    while (op[i] != 0) {
        if (op[i] < 48 || op[i] > 57) {
            return (int64)0;
        }
        v = v * (int64)10 + (int64)(op[i] - 48);
        i = i + 1;
    }
    *ok = 1;
    if (neg == 1) {
        return -v;
    }
    return v;
}

// A shift count is taken modulo the operand width, as the C++ maskShiftCount: a count
// of the width or more (or a negative one) is never LLVM poison.
string cg_mask_shift(Codegen* g, string ity, string cnt) {
    int w = cg_int_w(ity);
    if (w <= 1) {
        return cnt;
    }
    int ok = 0;
    int64 c = cg_const_int(cnt, &ok);
    if (ok == 1 && c >= (int64)0 && c < (int64)w) {
        return cnt;
    }
    string t = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, t);
    cg_emit(g, " = and ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, cnt);
    cg_emit(g, ", ");
    cg_emit(g, cg_itoa(w - 1));
    cg_emit(g, "\n");
    return t;
}

// Integer `/` and `%` with defined results, as the C++ emitIntDivRem: a zero divisor
// traps, a signed division of the minimum by -1 wraps (quotient the minimum, remainder
// 0). A constant divisor other than 0 and -1 needs no check.
string cg_int_divrem(Codegen* g, string op, string ity, string a, string b) {
    int uns = 0;
    if (cg_streq(op, "udiv") == 1 || cg_streq(op, "urem") == 1) {
        uns = 1;
    }
    int ok = 0;
    int64 c = cg_const_int(b, &ok);
    int maybe_zero = 1;
    int maybe_neg1 = 1;
    if (ok == 1) {
        if (c != (int64)0) {
            maybe_zero = 0;
        }
        if (c != (int64)-1) {
            maybe_neg1 = 0;
        }
    }
    if (uns == 1) {
        maybe_neg1 = 0;
    }
    if (maybe_zero == 1) {
        g.uses_trap = 1;
        string z = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, z);
        cg_emit(g, " = icmp eq ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, b);
        cg_emit(g, ", 0\n");
        string fail = cg_lbl(g);
        string fine = cg_lbl(g);
        cg_emit(g, "  br i1 ");
        cg_emit(g, z);
        cg_emit(g, ", label %");
        cg_emit(g, fail);
        cg_emit(g, ", label %");
        cg_emit(g, fine);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, fail);
        cg_emit(g, "  call void @llvm.trap()\n");
        cg_emit(g, "  unreachable\n");
        g.terminated = 1;
        cg_label(g, fine);
    }
    string d = b;
    string isn1 = "";
    if (maybe_neg1 == 1) {
        isn1 = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, isn1);
        cg_emit(g, " = icmp eq ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, b);
        cg_emit(g, ", -1\n");
        d = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, d);
        cg_emit(g, " = select i1 ");
        cg_emit(g, isn1);
        cg_emit(g, ", ");
        cg_emit(g, ity);
        cg_emit(g, " 1, ");
        cg_emit(g, ity);
        cg_emit(g, " ");
        cg_emit(g, b);
        cg_emit(g, "\n");
    }
    string q = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, q);
    cg_emit(g, " = ");
    cg_emit(g, op);
    cg_emit(g, " ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, a);
    cg_emit(g, ", ");
    cg_emit(g, d);
    cg_emit(g, "\n");
    if (maybe_neg1 == 0 || cg_streq(op, "srem") == 1) {
        return q;
    }
    string ng = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, ng);
    cg_emit(g, " = sub ");
    cg_emit(g, ity);
    cg_emit(g, " 0, ");
    cg_emit(g, a);
    cg_emit(g, "\n");
    string r = cg_tmp(g);
    cg_emit(g, "  ");
    cg_emit(g, r);
    cg_emit(g, " = select i1 ");
    cg_emit(g, isn1);
    cg_emit(g, ", ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, ng);
    cg_emit(g, ", ");
    cg_emit(g, ity);
    cg_emit(g, " ");
    cg_emit(g, q);
    cg_emit(g, "\n");
    return r;
}

// float -> integer saturates (NaN is 0), as the C++ emitFloatToInt: the text of a
// call to `llvm.fpto[su]i.sat`, after the caller's `%t = `.
void cg_emit_fp_sat(Codegen* g, int uns, string fty, string fop, string ity) {
    string nm = "llvm.fptosi.sat.";
    if (uns == 1) {
        nm = "llvm.fptoui.sat.";
    }
    string sfx = "f64";
    if (cg_streq(fty, "float") == 1) {
        sfx = "f32";
    }
    string full = cg_cat(nm, cg_cat(ity, cg_cat(".", sfx)));
    cg_ensure_extern(g, full, cg_cat("declare ", cg_cat(ity, cg_cat(" @", cg_cat(full, cg_cat("(", cg_cat(fty, ")\n")))))));
    cg_emit(g, "call ");
    cg_emit(g, ity);
    cg_emit(g, " @");
    cg_emit(g, full);
    cg_emit(g, "(");
    cg_emit(g, fty);
    cg_emit(g, " ");
    cg_emit(g, fop);
    cg_emit(g, ")");
}

// Integer arithmetic/bitwise op → LLVM mnemonic ("" if not such an op).
string cg_arith_op(string s) {
    if (cg_streq(s, "+") == 1) {
        return "add";
    }
    if (cg_streq(s, "-") == 1) {
        return "sub";
    }
    if (cg_streq(s, "*") == 1) {
        return "mul";
    }
    if (cg_streq(s, "/") == 1) {
        return "sdiv";
    }
    if (cg_streq(s, "%") == 1) {
        return "srem";
    }
    if (cg_streq(s, "&") == 1) {
        return "and";
    }
    if (cg_streq(s, "|") == 1) {
        return "or";
    }
    if (cg_streq(s, "^") == 1) {
        return "xor";
    }
    if (cg_streq(s, "<<") == 1) {
        return "shl";
    }
    if (cg_streq(s, ">>") == 1) {
        return "ashr";
    }
    return "";
}

// Comparison op → LLVM icmp predicate ("" if not a comparison).
string cg_cmp_pred(string s) {
    if (cg_streq(s, "==") == 1) {
        return "eq";
    }
    if (cg_streq(s, "!=") == 1) {
        return "ne";
    }
    if (cg_streq(s, "<") == 1) {
        return "slt";
    }
    if (cg_streq(s, ">") == 1) {
        return "sgt";
    }
    if (cg_streq(s, "<=") == 1) {
        return "sle";
    }
    if (cg_streq(s, ">=") == 1) {
        return "sge";
    }
    return "";
}

// Arithmetic op honoring signedness: unsigned operands use udiv/urem/lshr (logical) in
// place of the signed sdiv/srem/ashr. Other ops are signedness-agnostic.
string cg_arith_op_s(string s, int uns) {
    if (uns == 1) {
        if (cg_streq(s, "/") == 1) {
            return "udiv";
        }
        if (cg_streq(s, "%") == 1) {
            return "urem";
        }
        if (cg_streq(s, ">>") == 1) {
            return "lshr";
        }
    }
    return cg_arith_op(s);
}

// Comparison predicate honoring signedness: unsigned operands use ult/ugt/ule/uge.
string cg_cmp_pred_s(string s, int uns) {
    if (uns == 1) {
        if (cg_streq(s, "<") == 1) {
            return "ult";
        }
        if (cg_streq(s, ">") == 1) {
            return "ugt";
        }
        if (cg_streq(s, "<=") == 1) {
            return "ule";
        }
        if (cg_streq(s, ">=") == 1) {
            return "uge";
        }
    }
    return cg_cmp_pred(s);
}

int cg_fn_exists(Codegen* g, string name) {
    return NameIdx_first(&g.fns_ix, name) >= 0;
}

// Whether `t` is an integer or floating-point type.
int cg_is_num_ty(Codegen* g, string t) {
    string ll = cg_lltype(g, t);
    if (cg_is_float(ll) == 1) {
        return 1;
    }
    if (cg_int_w(ll) > 0) {
        return 1;
    }
    return 0;
}

// Is a binary `op` declared for the exact operand types (a, b)? Returns its fn name or "".
// The overload named by operand types `tys`: declared with those spellings, or (through
// type aliases, `operator +(VV, VV)` for `type VV = V`) with the same dealiased ones.
string cg_op_lookup(Codegen* g, string op, List<string>* tys) {
    string nm = ast_op_name(op, tys);
    if (nm[0] == 0) {
        return "";
    }
    if (cg_fn_exists(g, nm) == 1) {
        return nm;
    }
    if (List_len<CgSub>(&g.opcanon) == 0) {
        return "";
    }
    let dt: List<string>;
    List_init<string>(&dt, 2);
    int i = 0;
    while (i < List_len<string>(tys)) {
        List_push<string>(&dt, cg_dealias(g, List_get<string>(tys, i)));
        i = i + 1;
    }
    string cn = ast_op_name(op, &dt);
    int k = 0;
    while (k < List_len<CgSub>(&g.opcanon)) {
        CgSub sb = List_get<CgSub>(&g.opcanon, k);
        if (cg_streq(sb.param, cn) == 1) {
            return sb.arg;
        }
        k = k + 1;
    }
    return "";
}

// The rest of codegen_ops.esk, in these parts (imported in order):
import "codegen_ops_resolve.esk";
import "codegen_ops_safe.esk";
import "codegen_ops_etype.esk";
