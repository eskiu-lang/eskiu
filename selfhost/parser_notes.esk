// parser_notes.esk: the note after a syntax error at text a macro produced (part of
// parser.esk, imported in order; mirrors parse_notes.cpp).

// The note after a syntax error at a token a macro produced (mirrors macroNote).
void p_macro_note(string file, int xi) {
    uint8[32] nb;
    string name = List_get<string>(&g_ppx_name, xi);
    string text = List_get<string>(&g_ppx_text, xi);
    if (cstr_len(text) > 40) {
        text = str_concat(p_sub(text, 0, 37), "...");
    }
    lx_puts_err("note: ");
    lx_puts_err(file);
    sprintf((string)&nb[0], ":%d:%d: '", List_get<int>(&g_ppx_line, xi), List_get<int>(&g_ppx_src, xi));
    lx_puts_err((string)&nb[0]);
    lx_puts_err(name);
    string def = List_get<string>(&g_ppx_def_file, xi);
    if (def == null || def[0] == 0) {
        lx_puts_err("' is a predefined macro");
    } else {
        lx_puts_err("' is a macro (");
        string from = module_label_of(def);
        if (from[0] != 0) {
            lx_puts_err("from ");
            lx_puts_err(from);
            lx_puts_err(", ");
        }
        lx_puts_err("defined at ");
        lx_puts_err(def);
        sprintf((string)&nb[0], ":%d)", List_get<int>(&g_ppx_def_line, xi));
        lx_puts_err((string)&nb[0]);
    }
    lx_puts_err(" and expands to '");
    lx_puts_err(text);
    lx_puts_err("' here; rename yours or #undef it\n");
}
