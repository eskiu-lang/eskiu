// Part of sema.esk (statements and the entry point), imported from it in order; compile sema.esk, not this file alone.

// ── statement walk ──

// A closure captures an enclosing local by value, so an assignment (or `++`/`--`) to one
// inside the lambda would change only its copy: an error (mirrors the C++
// checkCapturedWrite). A global or a `static` local is not captured.
// A field or element of a captured struct/array value (`p.a = 5`, `arr[0] = 9`) is part
// of the copy too; a write through a pointer (`ptr.a`, `*p`, a slice or string element)
// reaches the shared object and is allowed.
// The captured variable whose own storage `t` names (itself, a field or a fixed array
// element of it, not through a pointer) inside a lambda, or "" (mirrors the C++
// capturedRoot).
string sema_captured_root(Sema* s, *ExprNode t) {
    int nb = List_len<int>(&s.lam_bounds);
    if (nb == 0) {
        return "";
    }
    int walking = 1;
    while (walking == 1 && t != null) {
        if (t.kind == EK_MEMBER) {
            string bc = sema_canon(s, sema_strip_nullable(sema_infer_type(s, t.a)));
            if (sema_is_ptrish(bc) == 1) {
                return "";
            }
            t = t.a;
        } else if (t.kind == EK_INDEX) {
            if (List_len<*ExprNode>(&t.kids) > 0) {        // a slice a[lo..hi]
                return "";
            }
            string bc = sema_canon(s, sema_strip_nullable(sema_infer_type(s, t.a)));
            int br = sema_arr_bracket(bc);
            if (br < 0 || (int)bc[br + 1] == 93) {          // not a fixed array T[N]
                return "";
            }
            t = t.a;
        } else {
            walking = 0;
        }
    }
    if (t == null || t.kind != EK_IDENT) {
        return "";
    }
    int si = sema_sym_index(s, t.sval);
    if (si < 0) {
        return "";
    }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.depth >= 1 && sy.depth <= List_get<int>(&s.lam_bounds, nb - 1) && sy.is_static == 0) {
        return t.sval;
    }
    return "";
}

void sema_check_captured_write(Sema* s, *ExprNode t) {
    string n = sema_captured_root(s, t);
    if (n[0] != 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: cannot assign to captured variable '%s': a closure captures it by value (use a pointer, a global, or a static)\n",
               s.filename, s.line, s.col, n);
    }
}

// `&x` / `x[lo..hi]` of a captured variable's storage: the address is the closure's copy,
// so a write through it is lost (mirrors the C++ checkCapturedAddress).
void sema_check_captured_address(Sema* s, *ExprNode t) {
    string n = sema_captured_root(s, t);
    if (n[0] != 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: cannot take the address of captured variable '%s': a closure captures it by value, so a write through the address is lost (use a pointer, a global, or a static)\n",
               s.filename, s.line, s.col, n);
    }
}

// A loop or `if` condition: a `bool`, a number (`!= 0`) or a pointer, `string` and `?*T`
// included (`!= null`) (mirrors the C++ checkCondition).
void sema_cond(Sema* s, *ExprNode c) {
    sema_expr(s, c);
    if (c == null) {
        return;
    }
    string ct = sema_infer_type(s, c);
    string cc = sema_canon(s, ct);
    if (sema_judgeable(s, cc) == 1 && sema_is_numeric_ty(cc) == 0 && sema_c_ptr(cc) == 0 && sema_is_iface_val(s, ct) == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: condition must be boolean, numeric, or a pointer, got %s\n", s.filename, s.line, s.col, ct);
    }
}

// A `?` in a defer body's expression `e` is an early return too (a lambda in the body is
// its own function, so its `?` is fine).
void sema_defer_expr(Sema* s, *ExprNode e) {
    if (e == null || e.kind == EK_LAMBDA) {
        return;
    }
    if (e.kind == EK_QUESTION) {
        s.had_error = 1;
        int l = s.line;
        int c = s.col;
        if (e.line > 0) {
            l = e.line;
            c = e.col;
        }
        dprintf(2, "error: %s:%d:%d: '?' is not allowed inside a defer body (it would return from the function)\n", s.filename, l, c);
    }
    sema_defer_expr(s, e.a);
    sema_defer_expr(s, e.b);
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        sema_defer_expr(s, List_get<*ExprNode>(&e.kids, i));
        i = i + 1;
    }
}

// The local (or parameter) whose own storage `e` denotes: a variable, or a field / element
// of a value (not reached through a pointer). "" for anything else, a global, or a static
// (mirrors the C++ localStorageRoot).
string sema_local_root(Sema* s, *ExprNode e) {
    while (e != null) {
        if (e.kind == EK_IDENT) {
            int i = sema_sym_index(s, e.sval);
            if (i < 0) {
                return "";
            }
            Sym sy = List_get<Sym>(&s.syms, i);
            if (sy.depth < 1 || sy.is_static == 1) {
                return "";
            }
            return e.sval;
        }
        if (e.kind == EK_MEMBER) {
            if (sema_has_star(sema_infer_type(s, e.a)) == 1) {
                return "";
            }
            e = e.a;
        } else if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) == 0) {
            if (sema_is_fixed_arr_ty(sema_infer_type(s, e.a)) == 0) {
                return "";
            }
            e = e.a;
        } else {
            return "";
        }
    }
    return "";
}

// A defer body runs during scope-exit cleanup, so it may not transfer control out of
// itself: a `return`, or a `break`/`continue` not enclosed by a loop/switch *within* the
// body, would jump to a target that is gone. `depth` counts loops/switches inside the body.
void sema_defer_walk(Sema* s, *StmtNode st, int depth) {
    if (st == null) {
        return;
    }
    int k = st.kind;
    if (k != SK_RETURN) {
        sema_defer_expr(s, st.expr);
        sema_defer_expr(s, st.expr2);
    }
    if (k == SK_RETURN) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: 'return' is not allowed inside a defer body\n", s.filename, st.line, st.col);
        return;
    }
    if (k == SK_BREAK || k == SK_CONTINUE) {
        // Unlabeled break/continue is fine only when a loop is nested inside the defer body
        // (depth > 0). A labeled one always names a loop that could sit outside the defer,
        // so it may never escape, regardless of depth.
        int labeled = 0;
        if (st.label != null && st.label[0] != 0) {
            labeled = 1;
        }
        if (depth == 0 || labeled == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'break'/'continue' inside a defer body may not escape it\n", s.filename, st.line, st.col);
        }
        return;
    }
    if (k == SK_BLOCK) {
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            sema_defer_walk(s, List_get<*StmtNode>(&st.items, i), depth);
            i = i + 1;
        }
        return;
    }
    if (k == SK_IF) {
        sema_defer_walk(s, st.s1, depth);
        sema_defer_walk(s, st.s2, depth);
        return;
    }
    if (k == SK_WHILE || k == SK_DOWHILE || k == SK_FORIN) {
        sema_defer_walk(s, st.s1, depth + 1);
        return;
    }
    if (k == SK_FOR) {   // s1 init, s2 body
        sema_defer_walk(s, st.s1, depth);
        sema_defer_walk(s, st.s2, depth + 1);
        return;
    }
    if (k == SK_TRY) {
        sema_defer_walk(s, st.s1, depth);
        int i = 0;
        while (i < List_len<*StmtNode>(&st.items)) {
            sema_defer_walk(s, List_get<*StmtNode>(&st.items, i), depth);
            i = i + 1;
        }
        sema_defer_walk(s, st.s2, depth);
        return;
    }
    if (k == SK_CATCH || k == SK_ARM) {
        sema_defer_walk(s, st.s1, depth);
        return;
    }
    if (k == SK_MATCH) {
        int i = 0;
        while (i < List_len<*StmtNode>(&st.items)) {
            sema_defer_walk(s, List_get<*StmtNode>(&st.items, i), depth);
            i = i + 1;
        }
        return;
    }
    if (k == SK_SWITCH) {
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&st.items, i);
            int j = 0;
            int m = List_len<*StmtNode>(&c.items);
            while (j < m) {
                sema_defer_walk(s, List_get<*StmtNode>(&c.items, j), depth + 1);
                j = j + 1;
            }
            i = i + 1;
        }
        return;
    }
    if (k == SK_DEFER) {
        sema_defer_walk(s, st.s1, depth);
        return;
    }
}

string sema_void_type_err(Sema* s, string t0);   // fwd
// An extended-asm output (`"=r"(y)`, `"+r"(y)`, `"=m"(y)`): the asm writes it, so it must
// be a writable lvalue of a scalar type, an integer other than bool, a float or a pointer
// (mirrors the C++ visit(AsmStmt)).
void sema_asm_output(Sema* s, string c, *ExprNode e) {
    sema_expr(s, e);
    if ((int)c[0] != 61 && (int)c[0] != 43) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: asm output constraint '%s' must start with '=' or '+'\n", s.filename, s.line, s.col, c);
        return;
    }
    if (sema_is_slice_len(s, e) == 1 || sema_is_lvalue(s, e) == 0) {
        sema_error(s, "asm output operand must be an lvalue (a variable, field, element, or dereference)");
        return;
    }
    if (sema_is_readonly_lvalue(s, e) == 1) {
        sema_error(s, "asm output operand is read-only");
    }
    sema_check_captured_write(s, e);
    if (e.kind == EK_MEMBER) {
        *DeclNode bsd = sema_find_struct(s, sema_struct_of_type(sema_infer_type(s, e.a)));
        if (bsd != null) {
            int bi = 0;
            int bn = List_len<Param>(&bsd.params);
            while (bi < bn) {
                if (sema_streq(List_get<Param>(&bsd.params, bi).name, e.sval) == 1 && bi < List_len<int>(&bsd.field_bits)
                    && List_get<int>(&bsd.field_bits, bi) > 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: asm output operand cannot be a bitfield ('%s')\n", s.filename, s.line, s.col, e.sval);
                }
                bi = bi + 1;
            }
        }
    }
    string t = sema_infer_type(s, e);
    if (t[0] != 0 && sema_streq(t, "unknown") == 0) {
        string c0 = sema_canon(s, sema_strip_nullable(sema_strip_const(t)));
        string cn = sema_strip_const(c0);
        int ok = 0;
        if (sema_is_numeric_ty(cn) == 1 && sema_streq(cn, "bool") == 0) {
            ok = 1;
        }
        if (sema_c_ptr(cn) == 1) {
            ok = 1;
        }
        int ei = 0;
        while (ei < List_len<EVar>(&s.evars)) {
            EVar ev = List_get<EVar>(&s.evars, ei);
            if (ev.plain == 1 && sema_streq(ev.en, cn) == 1) {
                ok = 1;
            }
            ei = ei + 1;
        }
        if (ok == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: asm output operand must have an integer, floating-point or pointer type, got '%s'\n", s.filename, s.line, s.col, t);
        }
    }
    if (e.kind == EK_IDENT) {   // the asm may store null
        sema_narrow_kill(s, e.sval);
    }
}

void sema_stmt(Sema* s, *StmtNode st) {
    if (st == null) {
        return;
    }
    int pl = s.line;
    int pc = s.col;
    if (st.line > 0) {
        s.line = st.line;
        s.col = st.col;
    }
    sema_bump(s);
    sema_stmt_k(s, st);
    sema_bump(s);
    s.line = pl;
    s.col = pc;
}

// -Wall: `if (x = 0)` (mirrors the C++ warnAssignInCondition).
void sema_warn_assign_cond(Sema* s, *ExprNode c) {
    if (s.wall == 0 || c == null || c.kind != EK_BINARY || sema_streq(c.sval, "=") == 0) {
        return;
    }
    sema_lint(s, c.line, c.col, "assignment used as a condition \342\200\224 did you mean '=='?");
}

// The place a lock call names: `m`, `a.b.m` (identifiers and fields only), "" otherwise.
string sema_lock_key(*ExprNode e) {
    if (e == null) {
        return "";
    }
    if (e.kind == EK_IDENT) {
        return e.sval;
    }
    if (e.kind == EK_MEMBER) {
        string base = sema_lock_key(e.a);
        if (base[0] == 0) {
            return "";
        }
        return sema_cat(sema_cat(base, "."), e.sval);
    }
    return "";
}

// The earliest `await` (by line, then column) in a subtree, lambda bodies excluded
// (mirrors the C++ earliestAwait).
*ExprNode sema_earlier_await(*ExprNode a, *ExprNode b) {
    if (a == null) {
        return b;
    }
    if (b == null) {
        return a;
    }
    if (b.line < a.line || (b.line == a.line && b.col < a.col)) {
        return b;
    }
    return a;
}

*ExprNode sema_earliest_await_e(*ExprNode e) {
    if (e == null) {
        return null;
    }
    *ExprNode best = null;
    if (e.kind == EK_AWAIT) {
        best = e;
    }
    int k = e.kind;
    if (k == EK_BINARY || k == EK_INDEX || k == EK_TERNARY || k == EK_ALLOCWITH) {
        best = sema_earlier_await(best, sema_earliest_await_e(e.a));
        best = sema_earlier_await(best, sema_earliest_await_e(e.b));
    } else if (k == EK_UNARY || k == EK_INCDEC || k == EK_MEMBER || k == EK_CAST || k == EK_QUESTION
               || k == EK_AWAIT || k == EK_CALL || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        best = sema_earlier_await(best, sema_earliest_await_e(e.a));
    }
    if (k == EK_CALL || k == EK_TEMPLATECALL || k == EK_STRUCTINIT || k == EK_ARRAYLIT
        || k == EK_INDEX || k == EK_TERNARY) {
        int i = 0;
        while (i < List_len<*ExprNode>(&e.kids)) {
            best = sema_earlier_await(best, sema_earliest_await_e(List_get<*ExprNode>(&e.kids, i)));
            i = i + 1;
        }
    }
    return best;
}

*ExprNode sema_earliest_await_s(*StmtNode st) {
    if (st == null) {
        return null;
    }
    *ExprNode best = sema_earliest_await_e(st.expr);
    best = sema_earlier_await(best, sema_earliest_await_e(st.expr2));
    best = sema_earlier_await(best, sema_earliest_await_s(st.s1));
    best = sema_earlier_await(best, sema_earliest_await_s(st.s2));
    int i = 0;
    while (i < List_len<*StmtNode>(&st.items)) {
        best = sema_earlier_await(best, sema_earliest_await_s(List_get<*StmtNode>(&st.items, i)));
        i = i + 1;
    }
    return best;
}

// The mutex a statement locks (`lock` 1) or unlocks: `Mutex_lock(&m)` / `Mutex_lock(p)`
// by name, or `m.lock()` on a `Mutex` / `*Mutex`. Its place key, or "".
string sema_mutex_call_key(Sema* s, *StmtNode st, int lock) {
    if (st == null || st.kind != SK_EXPR || st.expr == null || st.expr.kind != EK_CALL || st.expr.a == null) {
        return "";
    }
    *ExprNode c = st.expr;
    if (c.a.kind == EK_IDENT) {
        string want = "Mutex_unlock";
        if (lock == 1) {
            want = "Mutex_lock";
        }
        if (sema_streq(c.a.sval, want) == 0 || List_len<*ExprNode>(&c.kids) != 1) {
            return "";
        }
        *ExprNode a = List_get<*ExprNode>(&c.kids, 0);
        if (a != null && a.kind == EK_UNARY && sema_streq(a.sval, "&") == 1) {
            a = a.a;
        }
        return sema_lock_key(a);
    }
    if (c.a.kind == EK_MEMBER) {
        string want = "unlock";
        if (lock == 1) {
            want = "lock";
        }
        if (sema_streq(c.a.sval, want) == 0 || List_len<*ExprNode>(&c.kids) != 0) {
            return "";
        }
        if (sema_streq(sema_struct_of_type(sema_canon(s, sema_infer_type(s, c.a.a))), "Mutex") == 0) {
            return "";
        }
        return sema_lock_key(c.a.a);
    }
    return "";
}

// -Wawait-holding-lock: in an async function, a statement of this block locks a mutex
// and a later statement of the same block awaits before one unlocks the same place (a
// `defer` does not unlock: its body runs at the block's end). Reported at the earliest
// await of the first statement that awaits (mirrors the C++ warnAwaitHoldingLock).
void sema_warn_await_lock(Sema* s, *StmtNode blk) {
    int n = List_len<*StmtNode>(&blk.items);
    int i = 0;
    while (i < n) {
        *StmtNode ls = List_get<*StmtNode>(&blk.items, i);
        string key = sema_mutex_call_key(s, ls, 1);
        if (key[0] != 0) {
            int j = i + 1;
            while (j < n) {
                *StmtNode it = List_get<*StmtNode>(&blk.items, j);
                if (sema_streq(sema_mutex_call_key(s, it, 0), key) == 1) {
                    break;
                }
                if (it != null && it.kind != SK_DEFER) {
                    *ExprNode aw = sema_earliest_await_s(it);
                    if (aw != null) {
                        string msg = sema_cat(sema_cat("await while the mutex '", key), "' is locked (locked at line ");
                        msg = sema_cat(sema_cat(msg, sema_i64_text((int64)ls.line)), "); unlock it before the await");
                        sema_warn(s, "await-holding-lock", aw.line, aw.col, msg);
                        break;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// The rest of sema_stmt.esk, in these parts (imported in order):
import "sema_stmt_walk.esk";
import "sema_stmt_entry.esk";
