// The EIR builder of the self-hosted compiler: a port of eir/eir_builder.cpp whose
// `--test-eir` text is byte-identical to the C++ compiler's. Its parts, each relying on
// the ones before it:
//   eir_ty.esk       type spellings (ty::Type, mangleTemplate, substType, tyq)
//   eir_ir.esk       the EIR model and its text form (eir.h, eir.cpp)
//   eir_b_core.esk   builder state, scopes, types, folding, layout, bitfields
//   eir_b_conv.esk   conversions, interfaces, closures, dbg, generic instances
//   eir_b_stmt.esk   functions, locals, statements
//   eir_b_expr.esk   expressions
//   eir_b_build.esk  EIRBuilder::build

import "eir_b_build.esk";
