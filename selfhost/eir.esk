// EIR (Eskiu Intermediate Representation) generator for the self-hosted compiler.
// Walks the typed AST after sema + async_lower and builds/emits EIR textual representation.

import <io>;
import <string>;
import <list>;
import <mem>;
import "ast.esk";
import "codegen.esk";

enum EirTypeKind {
    EIR_TY_VOID,
    EIR_TY_INT,
    EIR_TY_FLOAT,
    EIR_TY_PTR,
    EIR_TY_STRUCT,
    EIR_TY_ARRAY,
    EIR_TY_FUNCTION,
    EIR_TY_IFACE,
    EIR_TY_CLOSURE,
    EIR_TY_SLICE
}

struct EirType {
    int kind;
    string name;
    int bit_width;
    int is_signed;
    *EirType pointee;
    *EirType elem;
    int64 array_size;
    List<*EirType> members;
    *EirType ret_type;
}

int eir_strlen(string s) {
    if (s == null) return 0;
    int n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    return n;
}

int eir_atoi(string s) {
    int v = 0;
    int i = 0;
    while ((int)s[i] >= 48 && (int)s[i] <= 57) {
        v = v * 10 + ((int)s[i] - 48);
        i = i + 1;
    }
    return v;
}

string eir_substr(string s, int a, int b) {
    if (a >= b || s == null) return "";
    int len = b - a;
    let out: String;
    String_init(&out, len + 1);
    for (i in a..b) {
        String_push(&out, (uint8)s[i]);
    }
    return (string)String_cstr(&out);
}

*EirType eir_type_alloc(int kind) {
    *EirType t = alloc<EirType>(1);
    t.kind = kind;
    t.name = "";
    t.bit_width = 0;
    t.is_signed = 1;
    t.pointee = null;
    t.elem = null;
    t.array_size = 0;
    List_init<*EirType>(&t.members, 0);
    t.ret_type = null;
    return t;
}

*EirType eir_ty_void() {
    return eir_type_alloc(EIR_TY_VOID);
}

*EirType eir_ty_i1() {
    *EirType t = eir_type_alloc(EIR_TY_INT);
    t.bit_width = 1;
    t.is_signed = 0;
    return t;
}

*EirType eir_ty_int(int width, int is_signed) {
    *EirType t = eir_type_alloc(EIR_TY_INT);
    t.bit_width = width;
    t.is_signed = is_signed;
    return t;
}

*EirType eir_ty_float(int width) {
    *EirType t = eir_type_alloc(EIR_TY_FLOAT);
    t.bit_width = width;
    return t;
}

*EirType eir_ty_ptr(*EirType pointee) {
    *EirType t = eir_type_alloc(EIR_TY_PTR);
    t.pointee = pointee;
    return t;
}

*EirType eir_ty_struct(string name) {
    *EirType t = eir_type_alloc(EIR_TY_STRUCT);
    t.name = name;
    return t;
}

*EirType eir_ty_array(*EirType elem, int64 size) {
    *EirType t = eir_type_alloc(EIR_TY_ARRAY);
    t.elem = elem;
    t.array_size = size;
    return t;
}

*EirType eir_ty_iface() {
    return eir_type_alloc(EIR_TY_IFACE);
}

*EirType eir_ty_closure() {
    return eir_type_alloc(EIR_TY_CLOSURE);
}

*EirType eir_ty_slice(*EirType elem) {
    *EirType t = eir_type_alloc(EIR_TY_SLICE);
    t.elem = elem;
    return t;
}

string eir_type_str(*EirType t) {
    if (t == null || t.kind == EIR_TY_VOID) {
        return "void";
    }
    if (t.kind == EIR_TY_INT) {
        if (t.bit_width == 1) {
            return "i1";
        }
        string pfx = "i";
        if (t.is_signed == 0) {
            pfx = "u";
        }
        return cg_cat(pfx, cg_itoa(t.bit_width));
    }
    if (t.kind == EIR_TY_FLOAT) {
        if (t.bit_width == 32) {
            return "f32";
        }
        return "f64";
    }
    if (t.kind == EIR_TY_PTR) {
        return "ptr";
    }
    if (t.kind == EIR_TY_STRUCT) {
        return cg_cat("struct @", t.name);
    }
    if (t.kind == EIR_TY_ARRAY) {
        string s = cg_cat("[", cg_itoa((int)t.array_size));
        s = cg_cat(s, " x ");
        s = cg_cat(s, eir_type_str(t.elem));
        return cg_cat(s, "]");
    }
    if (t.kind == EIR_TY_IFACE || t.kind == EIR_TY_CLOSURE) {
        return "{ ptr, ptr }";
    }
    if (t.kind == EIR_TY_SLICE) {
        return "{ ptr, i64 }";
    }
    return "unknown";
}

int eir_type_size(*EirType t) {
    if (t == null || t.kind == EIR_TY_VOID) {
        return 0;
    }
    if (t.kind == EIR_TY_INT) {
        if (t.bit_width == 1) return 1;
        return (t.bit_width + 7) / 8;
    }
    if (t.kind == EIR_TY_FLOAT) {
        if (t.bit_width == 32) return 4;
        return 8;
    }
    if (t.kind == EIR_TY_PTR) {
        return 8;
    }
    if (t.kind == EIR_TY_ARRAY) {
        return (int)t.array_size * eir_type_size(t.elem);
    }
    if (t.kind == EIR_TY_IFACE || t.kind == EIR_TY_CLOSURE || t.kind == EIR_TY_SLICE) {
        return 16;
    }
    return 8;
}

int eir_type_align(*EirType t) {
    if (t == null || t.kind == EIR_TY_VOID) {
        return 1;
    }
    if (t.kind == EIR_TY_INT) {
        int sz = eir_type_size(t);
        if (sz > 8) return 8;
        if (sz == 0) return 1;
        return sz;
    }
    if (t.kind == EIR_TY_FLOAT) {
        if (t.bit_width == 32) return 4;
        return 8;
    }
    if (t.kind == EIR_TY_PTR) {
        return 8;
    }
    if (t.kind == EIR_TY_ARRAY) {
        return eir_type_align(t.elem);
    }
    if (t.kind == EIR_TY_IFACE || t.kind == EIR_TY_CLOSURE || t.kind == EIR_TY_SLICE) {
        return 8;
    }
    return 8;
}

// ── Value and Local representations ─────────────────────────────────────────

struct EirVal {
    string op;
    *EirType ty;
    string ety;
    int is_lval;
    int is_vol;
}

struct EirLocal {
    string name;
    string slot;
    *EirType ty;
    string ety;
    int is_vol;
}

*EirLocal eir_local_alloc(string name, string slot, *EirType ty, string ety, int is_vol) {
    *EirLocal l = alloc<EirLocal>(1);
    l.name = name;
    l.slot = slot;
    l.ty = ty;
    l.ety = ety;
    l.is_vol = is_vol;
    return l;
}

struct EirField {
    string name;
    *EirType ty;
    int offset;
    int size;
    int is_bitfield;
    int bit_offset;
    int bit_width;
    int is_signed;
    *EirType storage_type;
    int storage_offset;
}

*EirField eir_field_alloc() {
    return alloc<EirField>(1);
}

struct EirStructInfo {
    string name;
    List<*EirField> fields;
    int total_size;
    int alignment;
}

*EirStructInfo eir_struct_alloc(string name) {
    *EirStructInfo si = alloc<EirStructInfo>(1);
    si.name = name;
    List_init<*EirField>(&si.fields, 8);
    si.total_size = 0;
    si.alignment = 1;
    return si;
}

// ── Builder State ───────────────────────────────────────────────────────────

struct EirBuilder {
    String out;
    String globals;
    int next;
    int lbl_next;
    string cur_lbl;
    int terminated;
    string cur_retty;
    List<*EirLocal> locals;
    List<string> loop_end;
    List<string> loop_cont;
    List<*StmtNode> cleanups;
    List<int> loop_cldepth;
    List<*EirStructInfo> structs;
    List<string> plain_enums;
    List<string> adt_enums;
    List<CgVariant> adt_variants;
    List<CgEnumC> enum_consts;
    List<string> volatile_vars;
    List<string> globals_list;
    List<string> extern_fns;
    string target_triple;
    int is_freestanding;
}

void eir_init(EirBuilder* b) {
    String_init(&b.out, 16384);
    String_init(&b.globals, 8192);
    b.next = 0;
    b.lbl_next = 0;
    b.cur_lbl = "";
    b.terminated = 0;
    b.cur_retty = "void";
    List_init<*EirLocal>(&b.locals, 16);
    List_init<string>(&b.loop_end, 8);
    List_init<string>(&b.loop_cont, 8);
    List_init<*StmtNode>(&b.cleanups, 16);
    List_init<int>(&b.loop_cldepth, 8);
    List_init<*EirStructInfo>(&b.structs, 16);
    List_init<string>(&b.plain_enums, 8);
    List_init<string>(&b.adt_enums, 8);
    List_init<CgVariant>(&b.adt_variants, 16);
    List_init<CgEnumC>(&b.enum_consts, 32);
    List_init<string>(&b.volatile_vars, 16);
    List_init<string>(&b.globals_list, 16);
    List_init<string>(&b.extern_fns, 16);
    b.target_triple = "";
    b.is_freestanding = 0;
}

string eir_temp(EirBuilder* b) {
    string r = cg_cat("%", cg_itoa(b.next));
    b.next = b.next + 1;
    return r;
}

string eir_lbl(EirBuilder* b, string pfx) {
    string r = cg_cat(pfx, ".");
    r = cg_cat(r, cg_itoa(b.lbl_next));
    b.lbl_next = b.lbl_next + 1;
    return r;
}

void eir_emit(EirBuilder* b, string text) {
    String_append(&b.out, "    ");
    String_append(&b.out, text);
    String_append(&b.out, "\n");
}

void eir_label(EirBuilder* b, string name) {
    String_append(&b.out, name);
    String_append(&b.out, ":\n");
    b.cur_lbl = name;
    b.terminated = 0;
}

void eir_br(EirBuilder* b, string target) {
    if (b.terminated == 1) {
        return;
    }
    String_append(&b.out, "    br $");
    String_append(&b.out, target);
    String_append(&b.out, "\n");
    b.terminated = 1;
}

void eir_br_cond(EirBuilder* b, string cond, string l_then, string l_else) {
    if (b.terminated == 1) {
        return;
    }
    String_append(&b.out, "    br_cond i1 ");
    String_append(&b.out, cond);
    String_append(&b.out, ", $");
    String_append(&b.out, l_then);
    String_append(&b.out, ", $");
    String_append(&b.out, l_else);
    String_append(&b.out, "\n");
    b.terminated = 1;
}

int eir_is_plain_enum(EirBuilder* b, string name) {
    for (i in 0..List_len<string>(&b.plain_enums)) {
        if (cg_streq(List_get<string>(&b.plain_enums, i), name) == 1) {
            return 1;
        }
    }
    return 0;
}

*EirStructInfo eir_find_struct(EirBuilder* b, string name) {
    for (i in 0..List_len<*EirStructInfo>(&b.structs)) {
        *EirStructInfo si = List_get<*EirStructInfo>(&b.structs, i);
        if (cg_streq(si.name, name) == 1) {
            return si;
        }
    }
    return null;
}

*EirType eir_type_from_str(EirBuilder* b, string s) {
    if (s == null || s[0] == 0 || cg_streq(s, "void") == 1) {
        return eir_ty_void();
    }
    if (cg_streq(s, "bool") == 1) {
        return eir_ty_i1();
    }
    if (cg_streq(s, "char") == 1 || cg_streq(s, "uint8") == 1) {
        return eir_ty_int(8, 0);
    }
    if (cg_streq(s, "int8") == 1) {
        return eir_ty_int(8, 1);
    }
    if (cg_streq(s, "int16") == 1) {
        return eir_ty_int(16, 1);
    }
    if (cg_streq(s, "uint16") == 1) {
        return eir_ty_int(16, 0);
    }
    if (cg_streq(s, "int") == 1 || cg_streq(s, "int32") == 1) {
        return eir_ty_int(32, 1);
    }
    if (cg_streq(s, "uint") == 1 || cg_streq(s, "uint32") == 1) {
        return eir_ty_int(32, 0);
    }
    if (cg_streq(s, "int64") == 1) {
        return eir_ty_int(64, 1);
    }
    if (cg_streq(s, "uint64") == 1) {
        return eir_ty_int(64, 0);
    }
    if (cg_streq(s, "float") == 1) {
        return eir_ty_float(32);
    }
    if (cg_streq(s, "double") == 1) {
        return eir_ty_float(64);
    }
    int slen = eir_strlen(s);
    if (cg_streq(s, "string") == 1 || s[0] == 42 || s[slen - 1] == 42) {
        return eir_ty_ptr(eir_ty_int(8, 0));
    }
    if (s[0] == 91 && s[1] == 93) { // []
        return eir_ty_slice(eir_ty_int(8, 0));
    }
    if (ast_has_prefix(s, "fn(") == 1) {
        return eir_ty_closure();
    }
    // Check array: T[N]
    int brk = -1;
    for (i in 0..slen) {
        if (s[i] == 91) {
            brk = i;
        }
    }
    if (brk > 0 && s[slen - 1] == 93) {
        string elem_s = ast_sub(s, 0, brk);
        string num_s = ast_sub(s, brk + 1, slen - 1);
        int64 sz = (int64)eir_atoi(num_s);
        return eir_ty_array(eir_type_from_str(b, elem_s), sz);
    }
    if (eir_is_plain_enum(b, s) == 1) {
        return eir_ty_int(32, 1);
    }
    // Struct or named type
    return eir_ty_struct(s);
}

// ── Local variables and Scope Cleanups ──────────────────────────────────────

*EirLocal eir_find_local(EirBuilder* b, string name) {
    int i = List_len<*EirLocal>(&b.locals) - 1;
    while (i >= 0) {
        *EirLocal l = List_get<*EirLocal>(&b.locals, i);
        if (cg_streq(l.name, name) == 1) {
            return l;
        }
        i = i - 1;
    }
    return null;
}

int eir_is_volatile(EirBuilder* b, string name) {
    for (i in 0..List_len<string>(&b.volatile_vars)) {
        if (cg_streq(List_get<string>(&b.volatile_vars, i), name) == 1) {
            return 1;
        }
    }
    return 0;
}

void eir_stmt(EirBuilder* b, *StmtNode s);
EirVal eir_expr(EirBuilder* b, *ExprNode e);

void eir_run_cleanups(EirBuilder* b, int target_depth) {
    int i = List_len<*StmtNode>(&b.cleanups) - 1;
    while (i >= target_depth) {
        *StmtNode s = List_get<*StmtNode>(&b.cleanups, i);
        if (s != null) {
            eir_stmt(b, s);
        }
        i = i - 1;
    }
}

// ── Bitfield Lowering Helpers ───────────────────────────────────────────────

void eir_layout_bitfields(EirBuilder* b, *DeclNode s, *EirStructInfo sinfo) {
    uint64 bitpos = (uint64)0;
    int struct_align = 1;
    List_init<*EirField>(&sinfo.fields, List_len<Param>(&s.params));

    for (i in 0..List_len<Param>(&s.params)) {
        Param f = List_get<Param>(&s.params, i);
        *EirType ty = eir_type_from_str(b, f.ty);
        int sz = eir_type_size(ty);
        if (sz < 1) sz = 1;
        int al = eir_type_align(ty);
        if (al < 1) al = 1;
        if (al > struct_align) struct_align = al;

        int w = 0;
        if (i < List_len<int>(&s.field_bits)) {
            w = List_get<int>(&s.field_bits, i);
        }

        *EirField ef = eir_field_alloc();
        ef.name = f.name;
        ef.ty = ty;
        ef.size = sz;

        if (w > 0) {
            uint64 unit_bits = (uint64)(sz * 8);
            if (bitpos / unit_bits != (bitpos + (uint64)w - (uint64)1) / unit_bits) {
                bitpos = (bitpos + unit_bits - (uint64)1) / unit_bits * unit_bits;
            }
            int byte_offset = (int)((bitpos / unit_bits) * (uint64)sz);
            int bit_offset = (int)(bitpos - (uint64)(byte_offset * 8));

            ef.offset = byte_offset;
            ef.is_bitfield = 1;
            ef.bit_offset = bit_offset;
            ef.bit_width = w;
            ef.is_signed = ty.is_signed;
            ef.storage_type = ty;
            ef.storage_offset = byte_offset;
            bitpos = bitpos + (uint64)w;
        } else {
            int off = (int)(((bitpos + (uint64)7) / (uint64)8 + (uint64)al - (uint64)1) / (uint64)al * (uint64)al);
            ef.offset = off;
            ef.is_bitfield = 0;
            ef.bit_offset = 0;
            ef.bit_width = 0;
            ef.is_signed = ty.is_signed;
            ef.storage_type = ty;
            ef.storage_offset = off;
            bitpos = (uint64)((off + sz) * 8);
        }
        List_push<*EirField>(&sinfo.fields, ef);
    }
    sinfo.total_size = (int)(((bitpos + (uint64)7) / (uint64)8 + (uint64)struct_align - (uint64)1) / (uint64)struct_align * (uint64)struct_align);
    sinfo.alignment = struct_align;
}

EirVal eir_load_bitfield(EirBuilder* b, EirVal base_ptr, string sname, string field_name, int is_vol) {
    let res: EirVal;
    res.is_lval = 0;
    res.is_vol = 0;

    *EirStructInfo si = eir_find_struct(b, sname);
    if (si == null) {
        res.op = "0";
        res.ty = eir_ty_int(32, 1);
        return res;
    }
    *EirField fi = null;
    for (i in 0..List_len<*EirField>(&si.fields)) {
        *EirField f = List_get<*EirField>(&si.fields, i);
        if (cg_streq(f.name, field_name) == 1) {
            fi = f;
        }
    }
    if (fi == null || fi.is_bitfield == 0) {
        res.op = "0";
        res.ty = eir_ty_int(32, 1);
        return res;
    }

    string unit_ptr = eir_temp(b);
    string line = cg_cat(unit_ptr, " = offset_ptr ptr ");
    line = cg_cat(line, base_ptr.op);
    line = cg_cat(line, ", i64 ");
    line = cg_cat(line, cg_itoa(fi.storage_offset));
    eir_emit(b, line);

    string raw_val = eir_temp(b);
    string ld = cg_cat(raw_val, " = load ");
    if (is_vol == 1) ld = cg_cat(ld, "volatile ");
    ld = cg_cat(ld, eir_type_str(fi.storage_type));
    ld = cg_cat(ld, ", ptr ");
    ld = cg_cat(ld, unit_ptr);
    eir_emit(b, ld);

    string cur_val = raw_val;
    if (fi.bit_offset > 0) {
        string shifted = eir_temp(b);
        string sh = cg_cat(shifted, " = lshr ");
        sh = cg_cat(sh, eir_type_str(fi.storage_type));
        sh = cg_cat(sh, " ");
        sh = cg_cat(sh, cur_val);
        sh = cg_cat(sh, ", ");
        sh = cg_cat(sh, cg_itoa(fi.bit_offset));
        eir_emit(b, sh);
        cur_val = shifted;
    }

    uint64 mask = ((uint64)1 << (uint64)fi.bit_width) - (uint64)1;
    string masked = eir_temp(b);
    string an = cg_cat(masked, " = and ");
    an = cg_cat(an, eir_type_str(fi.storage_type));
    an = cg_cat(an, " ");
    an = cg_cat(an, cur_val);
    an = cg_cat(an, ", ");
    an = cg_cat(an, cg_itoa((int)mask));
    eir_emit(b, an);
    cur_val = masked;

    if (fi.is_signed == 1 && fi.bit_width < fi.storage_type.bit_width) {
        int sh = fi.storage_type.bit_width - fi.bit_width;
        string shl_tmp = eir_temp(b);
        string sl = cg_cat(shl_tmp, " = shl ");
        sl = cg_cat(sl, eir_type_str(fi.storage_type));
        sl = cg_cat(sl, " ");
        sl = cg_cat(sl, cur_val);
        sl = cg_cat(sl, ", ");
        sl = cg_cat(sl, cg_itoa(sh));
        eir_emit(b, sl);

        string ashr_tmp = eir_temp(b);
        string asr = cg_cat(ashr_tmp, " = ashr ");
        asr = cg_cat(asr, eir_type_str(fi.storage_type));
        asr = cg_cat(asr, " ");
        asr = cg_cat(asr, shl_tmp);
        asr = cg_cat(asr, ", ");
        asr = cg_cat(asr, cg_itoa(sh));
        eir_emit(b, asr);
        cur_val = ashr_tmp;
    }

    res.op = cur_val;
    res.ty = fi.storage_type;
    res.ety = fi.name;
    return res;
}

void eir_store_bitfield(EirBuilder* b, EirVal base_ptr, string sname, string field_name, EirVal val, int is_vol) {
    *EirStructInfo si = eir_find_struct(b, sname);
    if (si == null) return;
    *EirField fi = null;
    for (i in 0..List_len<*EirField>(&si.fields)) {
        *EirField f = List_get<*EirField>(&si.fields, i);
        if (cg_streq(f.name, field_name) == 1) {
            fi = f;
        }
    }
    if (fi == null || fi.is_bitfield == 0) return;

    string unit_ptr = eir_temp(b);
    string line = cg_cat(unit_ptr, " = offset_ptr ptr ");
    line = cg_cat(line, base_ptr.op);
    line = cg_cat(line, ", i64 ");
    line = cg_cat(line, cg_itoa(fi.storage_offset));
    eir_emit(b, line);

    string orig_val = eir_temp(b);
    string ld = cg_cat(orig_val, " = load ");
    if (is_vol == 1) ld = cg_cat(ld, "volatile ");
    ld = cg_cat(ld, eir_type_str(fi.storage_type));
    ld = cg_cat(ld, ", ptr ");
    ld = cg_cat(ld, unit_ptr);
    eir_emit(b, ld);

    uint64 mask = ((uint64)1 << (uint64)fi.bit_width) - (uint64)1;
    uint64 clear_mask = ~(mask << (uint64)fi.bit_offset);

    string cleared = eir_temp(b);
    string an = cg_cat(cleared, " = and ");
    an = cg_cat(an, eir_type_str(fi.storage_type));
    an = cg_cat(an, " ");
    an = cg_cat(an, orig_val);
    an = cg_cat(an, ", ");
    an = cg_cat(an, cg_itoa((int)clear_mask));
    eir_emit(b, an);

    string val_to_shift = val.op;
    if (fi.storage_type.bit_width != val.ty.bit_width) {
        string tr = eir_temp(b);
        string tr_op = "trunc ";
        if (fi.storage_type.bit_width > val.ty.bit_width) tr_op = "zext ";
        string tr_line = cg_cat(tr, " = ");
        tr_line = cg_cat(tr_line, tr_op);
        tr_line = cg_cat(tr_line, eir_type_str(val.ty));
        tr_line = cg_cat(tr_line, " ");
        tr_line = cg_cat(tr_line, val.op);
        tr_line = cg_cat(tr_line, " to ");
        tr_line = cg_cat(tr_line, eir_type_str(fi.storage_type));
        eir_emit(b, tr_line);
        val_to_shift = tr;
    }

    string masked_val = eir_temp(b);
    string man = cg_cat(masked_val, " = and ");
    man = cg_cat(man, eir_type_str(fi.storage_type));
    man = cg_cat(man, " ");
    man = cg_cat(man, val_to_shift);
    man = cg_cat(man, ", ");
    man = cg_cat(man, cg_itoa((int)mask));
    eir_emit(b, man);

    string shifted_val = masked_val;
    if (fi.bit_offset > 0) {
        string sh_tmp = eir_temp(b);
        string sh = cg_cat(sh_tmp, " = shl ");
        sh = cg_cat(sh, eir_type_str(fi.storage_type));
        sh = cg_cat(sh, " ");
        sh = cg_cat(sh, masked_val);
        sh = cg_cat(sh, ", ");
        sh = cg_cat(sh, cg_itoa(fi.bit_offset));
        eir_emit(b, sh);
        shifted_val = sh_tmp;
    }

    string merged = eir_temp(b);
    string or_line = cg_cat(merged, " = or ");
    or_line = cg_cat(or_line, eir_type_str(fi.storage_type));
    or_line = cg_cat(or_line, " ");
    or_line = cg_cat(or_line, cleared);
    or_line = cg_cat(or_line, ", ");
    or_line = cg_cat(or_line, shifted_val);
    eir_emit(b, or_line);

    string st = "store ";
    if (is_vol == 1) st = "store volatile ";
    st = cg_cat(st, eir_type_str(fi.storage_type));
    st = cg_cat(st, " ");
    st = cg_cat(st, merged);
    st = cg_cat(st, ", ptr ");
    st = cg_cat(st, unit_ptr);
    eir_emit(b, st);
}

// ── Expression Lowering ─────────────────────────────────────────────────────

EirVal eir_lval(EirBuilder* b, *ExprNode e) {
    let res: EirVal;
    res.is_lval = 1;
    res.is_vol = 0;

    if (e.kind == EK_IDENT) {
        *EirLocal loc = eir_find_local(b, e.sval);
        if (loc != null) {
            res.op = loc.slot;
            res.ty = loc.ty;
            res.ety = loc.ety;
            res.is_vol = loc.is_vol;
            return res;
        }
        res.op = cg_cat("@", e.sval);
        res.ty = eir_ty_int(32, 1);
        res.ety = e.sval;
        res.is_vol = eir_is_volatile(b, e.sval);
        return res;
    }
    if (e.kind == EK_UNARY && cg_streq(e.sval, "*") == 1) {
        EirVal p = eir_expr(b, e.a);
        res.op = p.op;
        res.ty = eir_ty_int(32, 1);
        if (p.ty != null && p.ty.pointee != null) {
            res.ty = p.ty.pointee;
        }
        res.ety = p.ety;
        res.is_vol = p.is_vol;
        return res;
    }
    if (e.kind == EK_INDEX) {
        int is_arr = 0;
        if (e.a.kind == EK_IDENT) {
            *EirLocal loc = eir_find_local(b, e.a.sval);
            if (loc != null && loc.ty != null && loc.ty.kind == EIR_TY_ARRAY) {
                is_arr = 1;
            }
        }
        let base: EirVal;
        if (is_arr == 1) {
            base = eir_lval(b, e.a);
        } else {
            base = eir_expr(b, e.a);
        }
        EirVal idx = eir_expr(b, e.b);
        string ptr_val = eir_temp(b);
        *EirType elem_ty = eir_ty_int(32, 1);
        if (base.ty != null && base.ty.pointee != null) {
            elem_ty = base.ty.pointee;
        } else if (base.ty != null && base.ty.elem != null) {
            elem_ty = base.ty.elem;
        }
        string line = cg_cat(ptr_val, " = gep ptr, ptr ");
        line = cg_cat(line, base.op);
        line = cg_cat(line, ", ");
        line = cg_cat(line, eir_type_str(idx.ty));
        line = cg_cat(line, " ");
        line = cg_cat(line, idx.op);
        eir_emit(b, line);
        res.op = ptr_val;
        res.ty = elem_ty;
        res.ety = "";
        res.is_vol = base.is_vol;
        return res;
    }
    if (e.kind == EK_MEMBER) {
        EirVal base = eir_lval(b, e.a);
        string sname = base.ety;
        string base_ptr = base.op;
        if (sname != null && sname[0] == 42) {
            sname = eir_substr(sname, 1, eir_strlen(sname));
            string tmp = eir_temp(b);
            string ld = cg_cat(tmp, " = load ");
            if (base.is_vol == 1) ld = cg_cat(ld, "volatile ");
            ld = cg_cat(ld, "ptr, ptr ");
            ld = cg_cat(ld, base.op);
            eir_emit(b, ld);
            base_ptr = tmp;
        }
        string ptr_val = eir_temp(b);
        string line = cg_cat(ptr_val, " = field_ptr @");
        line = cg_cat(line, sname);
        line = cg_cat(line, ", ptr ");
        line = cg_cat(line, base_ptr);
        line = cg_cat(line, ", \"");
        line = cg_cat(line, e.sval);
        line = cg_cat(line, "\"");
        eir_emit(b, line);
        res.op = ptr_val;
        res.ty = eir_ty_int(32, 1);
        res.ety = sname;
        res.is_vol = base.is_vol;
        return res;
    }
    return res;
}

string eir_escape_string(string s) {
    let out: String;
    String_init(&out, eir_strlen(s) + 16);
    int i = 0;
    while (s[i] != 0) {
        int c = (int)s[i];
        if (c == 10) {
            String_append(&out, "\\n");
        } else if (c == 13) {
            String_append(&out, "\\r");
        } else if (c == 9) {
            String_append(&out, "\\t");
        } else if (c == 34) {
            String_append(&out, "\\\"");
        } else if (c == 92) {
            String_append(&out, "\\\\");
        } else {
            String_push(&out, (uint8)c);
        }
        i = i + 1;
    }
    return (string)String_cstr(&out);
}

EirVal eir_expr(EirBuilder* b, *ExprNode e) {
    let res: EirVal;
    res.is_lval = 0;
    res.is_vol = 0;
    if (e == null) {
        res.op = "0";
        res.ty = eir_ty_int(32, 1);
        return res;
    }

    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {
            res.op = e.sval;
            res.ty = eir_ty_int(32, 1);
            res.ety = "int";
            return res;
        }
        if (e.lit_kind == LIT_FLOAT) {
            res.op = e.sval;
            res.ty = eir_ty_float(64);
            res.ety = "double";
            return res;
        }
        if (e.lit_kind == LIT_BOOL) {
            res.op = e.sval;
            res.ty = eir_ty_i1();
            res.ety = "bool";
            return res;
        }
        if (e.lit_kind == LIT_NULL) {
            res.op = "null";
            res.ty = eir_ty_ptr(null);
            res.ety = "*void";
            return res;
        }
        if (e.lit_kind == LIT_STRING) {
            string s = "\"";
            s = cg_cat(s, eir_escape_string(e.sval));
            s = cg_cat(s, "\"");
            res.op = s;
            res.ty = eir_ty_ptr(eir_ty_int(8, 0));
            res.ety = "string";
            return res;
        }
    }

    if (e.kind == EK_IDENT) {
        *EirLocal loc = eir_find_local(b, e.sval);
        if (loc != null) {
            string tmp = eir_temp(b);
            string line = cg_cat(tmp, " = load ");
            if (loc.is_vol == 1) line = cg_cat(line, "volatile ");
            line = cg_cat(line, eir_type_str(loc.ty));
            line = cg_cat(line, ", ptr ");
            line = cg_cat(line, loc.slot);
            eir_emit(b, line);
            res.op = tmp;
            res.ty = loc.ty;
            res.ety = loc.ety;
            res.is_vol = loc.is_vol;
            return res;
        }
        for (i in 0..List_len<CgEnumC>(&b.enum_consts)) {
            if (cg_streq(List_get<CgEnumC>(&b.enum_consts, i).name, e.sval) == 1) {
                res.op = List_get<CgEnumC>(&b.enum_consts, i).val;
                res.ty = eir_ty_int(32, 1);
                res.ety = "int";
                return res;
            }
        }
        // Global
        string tmp = eir_temp(b);
        int vol = eir_is_volatile(b, e.sval);
        string line = cg_cat(tmp, " = load ");
        if (vol == 1) line = cg_cat(line, "volatile ");
        line = cg_cat(line, "i32, ptr @");
        line = cg_cat(line, e.sval);
        eir_emit(b, line);
        res.op = tmp;
        res.ty = eir_ty_int(32, 1);
        res.ety = "int";
        res.is_vol = vol;
        return res;
    }

    if (e.kind == EK_UNARY) {
        if (cg_streq(e.sval, "&") == 1) {
            EirVal l = eir_lval(b, e.a);
            res.op = l.op;
            res.ty = eir_ty_ptr(l.ty);
            res.ety = cg_cat("*", l.ety);
            res.is_vol = l.is_vol;
            return res;
        }
        if (cg_streq(e.sval, "*") == 1) {
            EirVal p = eir_expr(b, e.a);
            string tmp = eir_temp(b);
            string line = cg_cat(tmp, " = load ");
            if (p.is_vol == 1) line = cg_cat(line, "volatile ");
            line = cg_cat(line, "i32, ptr ");
            line = cg_cat(line, p.op);
            eir_emit(b, line);
            res.op = tmp;
            res.ty = eir_ty_int(32, 1);
            res.ety = "int";
            res.is_vol = p.is_vol;
            return res;
        }
        if (cg_streq(e.sval, "-") == 1) {
            EirVal v = eir_expr(b, e.a);
            string tmp = eir_temp(b);
            string line = cg_cat(tmp, " = sub ");
            line = cg_cat(line, eir_type_str(v.ty));
            line = cg_cat(line, " 0, ");
            line = cg_cat(line, v.op);
            eir_emit(b, line);
            res.op = tmp;
            res.ty = v.ty;
            res.ety = v.ety;
            return res;
        }
        if (cg_streq(e.sval, "!") == 1) {
            EirVal v = eir_expr(b, e.a);
            string tmp = eir_temp(b);
            string line = cg_cat(tmp, " = not ");
            line = cg_cat(line, eir_type_str(v.ty));
            line = cg_cat(line, " ");
            line = cg_cat(line, v.op);
            eir_emit(b, line);
            res.op = tmp;
            res.ty = v.ty;
            res.ety = v.ety;
            return res;
        }
    }

    if (e.kind == EK_MEMBER) {
        EirVal base = eir_lval(b, e.a);
        string sname = base.ety;
        string base_ptr = base.op;
        if (sname != null && sname[0] == 42) {
            sname = eir_substr(sname, 1, eir_strlen(sname));
            string tmp = eir_temp(b);
            string ld = cg_cat(tmp, " = load ");
            if (base.is_vol == 1) ld = cg_cat(ld, "volatile ");
            ld = cg_cat(ld, "ptr, ptr ");
            ld = cg_cat(ld, base.op);
            eir_emit(b, ld);
            base_ptr = tmp;
        }
        *EirStructInfo si = eir_find_struct(b, sname);
        if (si != null) {
            for (i in 0..List_len<*EirField>(&si.fields)) {
                *EirField f = List_get<*EirField>(&si.fields, i);
                if (cg_streq(f.name, e.sval) == 1) {
                    if (f.is_bitfield == 1) {
                        let bval: EirVal;
                        bval.op = base_ptr;
                        bval.is_vol = base.is_vol;
                        return eir_load_bitfield(b, bval, sname, e.sval, base.is_vol);
                    }
                    string ptr_val = eir_temp(b);
                    string line = cg_cat(ptr_val, " = field_ptr @");
                    line = cg_cat(line, sname);
                    line = cg_cat(line, ", ptr ");
                    line = cg_cat(line, base_ptr);
                    line = cg_cat(line, ", \"");
                    line = cg_cat(line, e.sval);
                    line = cg_cat(line, "\"");
                    eir_emit(b, line);

                    string tmp = eir_temp(b);
                    string ld = cg_cat(tmp, " = load ");
                    if (base.is_vol == 1) ld = cg_cat(ld, "volatile ");
                    ld = cg_cat(ld, eir_type_str(f.ty));
                    ld = cg_cat(ld, ", ptr ");
                    ld = cg_cat(ld, ptr_val);
                    eir_emit(b, ld);
                    res.op = tmp;
                    res.ty = f.ty;
                    res.ety = "";
                    res.is_vol = base.is_vol;
                    return res;
                }
            }
        }
    }

    if (e.kind == EK_INCDEC) {
        int is_dec = 0;
        int is_pre = 0;
        if (cg_streq(e.sval, "post--") == 1) { is_dec = 1; }
        else if (cg_streq(e.sval, "pre++") == 1) { is_pre = 1; }
        else if (cg_streq(e.sval, "pre--") == 1) { is_dec = 1; is_pre = 1; }

        if (e.a != null && e.a.kind == EK_MEMBER) {
            EirVal base = eir_lval(b, e.a.a);
            string sname = base.ety;
            string base_ptr = base.op;
            if (sname != null && sname[0] == 42) {
                sname = eir_substr(sname, 1, eir_strlen(sname));
                string tmp = eir_temp(b);
                string ld = cg_cat(tmp, " = load ");
                if (base.is_vol == 1) ld = cg_cat(ld, "volatile ");
                ld = cg_cat(ld, "ptr, ptr ");
                ld = cg_cat(ld, base.op);
                eir_emit(b, ld);
                base_ptr = tmp;
            }
            *EirStructInfo si = eir_find_struct(b, sname);
            if (si != null) {
                for (i in 0..List_len<*EirField>(&si.fields)) {
                    *EirField f = List_get<*EirField>(&si.fields, i);
                    if (cg_streq(f.name, e.a.sval) == 1 && f.is_bitfield == 1) {
                        let bval: EirVal;
                        bval.op = base_ptr;
                        bval.is_vol = base.is_vol;
                        EirVal cur = eir_load_bitfield(b, bval, sname, e.a.sval, base.is_vol);
                        string next = eir_temp(b);
                        string line = cg_cat(next, is_dec == 1 ? " = sub " : " = add ");
                        line = cg_cat(line, eir_type_str(cur.ty));
                        line = cg_cat(line, " ");
                        line = cg_cat(line, cur.op);
                        line = cg_cat(line, ", 1");
                        eir_emit(b, line);
                        let nval: EirVal;
                        nval.op = next;
                        nval.ty = cur.ty;
                        nval.ety = cur.ety;
                        eir_store_bitfield(b, bval, sname, e.a.sval, nval, base.is_vol);
                        return is_pre == 1 ? nval : cur;
                    }
                }
            }
        }

        EirVal addr = eir_lval(b, e.a);
        string cur = eir_temp(b);
        string ld = cg_cat(cur, " = load ");
        if (addr.is_vol == 1) ld = cg_cat(ld, "volatile ");
        ld = cg_cat(ld, eir_type_str(addr.ty));
        ld = cg_cat(ld, ", ptr ");
        ld = cg_cat(ld, addr.op);
        eir_emit(b, ld);

        string next = eir_temp(b);
        string line = cg_cat(next, is_dec == 1 ? " = sub " : " = add ");
        line = cg_cat(line, eir_type_str(addr.ty));
        line = cg_cat(line, " ");
        line = cg_cat(line, cur);
        line = cg_cat(line, ", 1");
        eir_emit(b, line);

        string st = "store ";
        if (addr.is_vol == 1) st = "store volatile ";
        st = cg_cat(st, eir_type_str(addr.ty));
        st = cg_cat(st, " ");
        st = cg_cat(st, next);
        st = cg_cat(st, ", ptr ");
        st = cg_cat(st, addr.op);
        eir_emit(b, st);

        let cval: EirVal;
        cval.op = cur;
        cval.ty = addr.ty;
        cval.ety = addr.ety;
        cval.is_vol = addr.is_vol;

        let nval: EirVal;
        nval.op = next;
        nval.ty = addr.ty;
        nval.ety = addr.ety;
        nval.is_vol = addr.is_vol;

        return is_pre == 1 ? nval : cval;
    }

    if (e.kind == EK_INDEX) {
        EirVal l = eir_lval(b, e);
        string tmp = eir_temp(b);
        string line = cg_cat(tmp, " = load ");
        if (l.is_vol == 1) line = cg_cat(line, "volatile ");
        line = cg_cat(line, eir_type_str(l.ty));
        line = cg_cat(line, ", ptr ");
        line = cg_cat(line, l.op);
        eir_emit(b, line);
        res.op = tmp;
        res.ty = l.ty;
        res.ety = l.ety;
        res.is_vol = l.is_vol;
        return res;
    }

    if (e.kind == EK_BINARY) {
        if (cg_streq(e.sval, "=") == 1) {
            EirVal rhs = eir_expr(b, e.b);
            if (e.a != null && e.a.kind == EK_MEMBER) {
                EirVal base = eir_lval(b, e.a.a);
                string sname = base.ety;
                string base_ptr = base.op;
                if (sname != null && sname[0] == 42) {
                    sname = eir_substr(sname, 1, eir_strlen(sname));
                    string tmp = eir_temp(b);
                    string ld = cg_cat(tmp, " = load ");
                    if (base.is_vol == 1) ld = cg_cat(ld, "volatile ");
                    ld = cg_cat(ld, "ptr, ptr ");
                    ld = cg_cat(ld, base.op);
                    eir_emit(b, ld);
                    base_ptr = tmp;
                }
                *EirStructInfo si = eir_find_struct(b, sname);
                if (si != null) {
                    for (i in 0..List_len<*EirField>(&si.fields)) {
                        *EirField f = List_get<*EirField>(&si.fields, i);
                        if (cg_streq(f.name, e.a.sval) == 1 && f.is_bitfield == 1) {
                            let bval: EirVal;
                            bval.op = base_ptr;
                            bval.is_vol = base.is_vol;
                            eir_store_bitfield(b, bval, sname, e.a.sval, rhs, base.is_vol);
                            return rhs;
                        }
                    }
                }
            }
            EirVal lhs = eir_lval(b, e.a);
            string st = "store ";
            if (lhs.is_vol == 1) st = "store volatile ";
            st = cg_cat(st, eir_type_str(rhs.ty));
            st = cg_cat(st, " ");
            st = cg_cat(st, rhs.op);
            st = cg_cat(st, ", ptr ");
            st = cg_cat(st, lhs.op);
            eir_emit(b, st);
            return rhs;
        }

        int is_compound = 0;
        string base_bin_op = "";
        if (cg_streq(e.sval, "+=") == 1) { is_compound = 1; base_bin_op = "add"; }
        else if (cg_streq(e.sval, "-=") == 1) { is_compound = 1; base_bin_op = "sub"; }
        else if (cg_streq(e.sval, "*=") == 1) { is_compound = 1; base_bin_op = "mul"; }
        else if (cg_streq(e.sval, "/=") == 1) { is_compound = 1; base_bin_op = "sdiv"; }
        else if (cg_streq(e.sval, "%=") == 1) { is_compound = 1; base_bin_op = "srem"; }
        else if (cg_streq(e.sval, "&=") == 1) { is_compound = 1; base_bin_op = "and"; }
        else if (cg_streq(e.sval, "|=") == 1) { is_compound = 1; base_bin_op = "or"; }
        else if (cg_streq(e.sval, "^=") == 1) { is_compound = 1; base_bin_op = "xor"; }
        else if (cg_streq(e.sval, "<<=") == 1) { is_compound = 1; base_bin_op = "shl"; }
        else if (cg_streq(e.sval, ">>=") == 1) { is_compound = 1; base_bin_op = "ashr"; }

        if (is_compound == 1) {
            EirVal rhs = eir_expr(b, e.b);
            if (e.a != null && e.a.kind == EK_MEMBER) {
                EirVal base = eir_lval(b, e.a.a);
                string sname = base.ety;
                string base_ptr = base.op;
                if (sname != null && sname[0] == 42) {
                    sname = eir_substr(sname, 1, eir_strlen(sname));
                    string tmp = eir_temp(b);
                    string ld = cg_cat(tmp, " = load ");
                    if (base.is_vol == 1) ld = cg_cat(ld, "volatile ");
                    ld = cg_cat(ld, "ptr, ptr ");
                    ld = cg_cat(ld, base.op);
                    eir_emit(b, ld);
                    base_ptr = tmp;
                }
                *EirStructInfo si = eir_find_struct(b, sname);
                if (si != null) {
                    for (i in 0..List_len<*EirField>(&si.fields)) {
                        *EirField f = List_get<*EirField>(&si.fields, i);
                        if (cg_streq(f.name, e.a.sval) == 1 && f.is_bitfield == 1) {
                            let bval: EirVal;
                            bval.op = base_ptr;
                            bval.is_vol = base.is_vol;
                            EirVal cur = eir_load_bitfield(b, bval, sname, e.a.sval, base.is_vol);
                            string next = eir_temp(b);
                            string line = cg_cat(next, " = ");
                            line = cg_cat(line, base_bin_op);
                            line = cg_cat(line, " ");
                            line = cg_cat(line, eir_type_str(cur.ty));
                            line = cg_cat(line, " ");
                            line = cg_cat(line, cur.op);
                            line = cg_cat(line, ", ");
                            line = cg_cat(line, rhs.op);
                            eir_emit(b, line);
                            let nval: EirVal;
                            nval.op = next;
                            nval.ty = cur.ty;
                            nval.ety = cur.ety;
                            eir_store_bitfield(b, bval, sname, e.a.sval, nval, base.is_vol);
                            return nval;
                        }
                    }
                }
            }
            EirVal lhsAddr = eir_lval(b, e.a);
            string cur = eir_temp(b);
            string ld = cg_cat(cur, " = load ");
            if (lhsAddr.is_vol == 1) ld = cg_cat(ld, "volatile ");
            ld = cg_cat(ld, eir_type_str(lhsAddr.ty));
            ld = cg_cat(ld, ", ptr ");
            ld = cg_cat(ld, lhsAddr.op);
            eir_emit(b, ld);

            string next = eir_temp(b);
            string line = cg_cat(next, " = ");
            line = cg_cat(line, base_bin_op);
            line = cg_cat(line, " ");
            line = cg_cat(line, eir_type_str(lhsAddr.ty));
            line = cg_cat(line, " ");
            line = cg_cat(line, cur);
            line = cg_cat(line, ", ");
            line = cg_cat(line, rhs.op);
            eir_emit(b, line);

            string st = "store ";
            if (lhsAddr.is_vol == 1) st = "store volatile ";
            st = cg_cat(st, eir_type_str(lhsAddr.ty));
            st = cg_cat(st, " ");
            st = cg_cat(st, next);
            st = cg_cat(st, ", ptr ");
            st = cg_cat(st, lhsAddr.op);
            eir_emit(b, st);

            let nval: EirVal;
            nval.op = next;
            nval.ty = lhsAddr.ty;
            nval.ety = lhsAddr.ety;
            nval.is_vol = lhsAddr.is_vol;
            return nval;
        }

        if (cg_streq(e.sval, "&&") == 1 || cg_streq(e.sval, "||") == 1) {
            int is_or = cg_streq(e.sval, "||");
            EirVal l = eir_expr(b, e.a);
            string l_cond = l.op;
            if (l.ty == null || l.ty.kind != EIR_TY_INT || l.ty.bit_width != 1) {
                l_cond = eir_temp(b);
                string cmp_line = cg_cat(l_cond, " = icmp ne ");
                if (l.ty != null && l.ty.kind == EIR_TY_PTR) {
                    cmp_line = cg_cat(cmp_line, "ptr ");
                    cmp_line = cg_cat(cmp_line, l.op);
                    cmp_line = cg_cat(cmp_line, ", null");
                } else {
                    *EirType cty = l.ty != null ? l.ty : eir_ty_int(32, 1);
                    cmp_line = cg_cat(cmp_line, eir_type_str(cty));
                    cmp_line = cg_cat(cmp_line, " ");
                    cmp_line = cg_cat(cmp_line, l.op);
                    cmp_line = cg_cat(cmp_line, ", 0");
                }
                eir_emit(b, cmp_line);
            }

            string res_slot = eir_temp(b);
            eir_emit(b, cg_cat(res_slot, " = alloca ptr"));
            string init_st = cg_cat("store i1 ", is_or == 1 ? "true" : "false");
            init_st = cg_cat(init_st, ", ptr ");
            init_st = cg_cat(init_st, res_slot);
            eir_emit(b, init_st);

            string l_rhs = eir_lbl(b, "sc.rhs");
            string l_cont = eir_lbl(b, "sc.cont");

            if (is_or == 1) {
                eir_br_cond(b, l_cond, l_cont, l_rhs);
            } else {
                eir_br_cond(b, l_cond, l_rhs, l_cont);
            }

            eir_label(b, l_rhs);
            EirVal r = eir_expr(b, e.b);
            string r_cond = r.op;
            if (r.ty == null || r.ty.kind != EIR_TY_INT || r.ty.bit_width != 1) {
                r_cond = eir_temp(b);
                string cmp_line = cg_cat(r_cond, " = icmp ne ");
                if (r.ty != null && r.ty.kind == EIR_TY_PTR) {
                    cmp_line = cg_cat(cmp_line, "ptr ");
                    cmp_line = cg_cat(cmp_line, r.op);
                    cmp_line = cg_cat(cmp_line, ", null");
                } else {
                    *EirType cty = r.ty != null ? r.ty : eir_ty_int(32, 1);
                    cmp_line = cg_cat(cmp_line, eir_type_str(cty));
                    cmp_line = cg_cat(cmp_line, " ");
                    cmp_line = cg_cat(cmp_line, r.op);
                    cmp_line = cg_cat(cmp_line, ", 0");
                }
                eir_emit(b, cmp_line);
            }
            string r_st = cg_cat("store i1 ", r_cond);
            r_st = cg_cat(r_st, ", ptr ");
            r_st = cg_cat(r_st, res_slot);
            eir_emit(b, r_st);
            eir_br(b, l_cont);

            eir_label(b, l_cont);
            string fin = eir_temp(b);
            string ld = cg_cat(fin, " = load i1, ptr ");
            ld = cg_cat(ld, res_slot);
            eir_emit(b, ld);

            res.op = fin;
            res.ty = eir_ty_i1();
            res.ety = "bool";
            return res;
        }

        EirVal lhs = eir_expr(b, e.a);
        EirVal rhs = eir_expr(b, e.b);
        string op_name = "add";
        int is_cmp = 0;
        string cmp_cond = "eq";

        if (cg_streq(e.sval, "+") == 1) {
            if (lhs.ty != null && lhs.ty.kind == EIR_TY_PTR) {
                string tmp = eir_temp(b);
                string line = cg_cat(tmp, " = gep ptr, ptr ");
                line = cg_cat(line, lhs.op);
                line = cg_cat(line, ", ");
                line = cg_cat(line, eir_type_str(rhs.ty));
                line = cg_cat(line, " ");
                line = cg_cat(line, rhs.op);
                eir_emit(b, line);
                res.op = tmp;
                res.ty = lhs.ty;
                res.ety = lhs.ety;
                return res;
            } else if (rhs.ty != null && rhs.ty.kind == EIR_TY_PTR) {
                string tmp = eir_temp(b);
                string line = cg_cat(tmp, " = gep ptr, ptr ");
                line = cg_cat(line, rhs.op);
                line = cg_cat(line, ", ");
                line = cg_cat(line, eir_type_str(lhs.ty));
                line = cg_cat(line, " ");
                line = cg_cat(line, lhs.op);
                eir_emit(b, line);
                res.op = tmp;
                res.ty = rhs.ty;
                res.ety = rhs.ety;
                return res;
            }
            op_name = "add";
        }
        else if (cg_streq(e.sval, "-") == 1) {
            if (lhs.ty != null && lhs.ty.kind == EIR_TY_PTR && (rhs.ty == null || rhs.ty.kind != EIR_TY_PTR)) {
                string neg = eir_temp(b);
                string nline = cg_cat(neg, " = sub ");
                nline = cg_cat(nline, eir_type_str(rhs.ty));
                nline = cg_cat(nline, " 0, ");
                nline = cg_cat(nline, rhs.op);
                eir_emit(b, nline);

                string tmp = eir_temp(b);
                string line = cg_cat(tmp, " = gep ptr, ptr ");
                line = cg_cat(line, lhs.op);
                line = cg_cat(line, ", ");
                line = cg_cat(line, eir_type_str(rhs.ty));
                line = cg_cat(line, " ");
                line = cg_cat(line, neg);
                eir_emit(b, line);
                res.op = tmp;
                res.ty = lhs.ty;
                res.ety = lhs.ety;
                return res;
            }
            op_name = "sub";
        }
        else if (cg_streq(e.sval, "*") == 1) op_name = "mul";
        else if (cg_streq(e.sval, "/") == 1) op_name = "sdiv";
        else if (cg_streq(e.sval, "%") == 1) op_name = "srem";
        else if (cg_streq(e.sval, "&") == 1) op_name = "and";
        else if (cg_streq(e.sval, "|") == 1) op_name = "or";
        else if (cg_streq(e.sval, "^") == 1) op_name = "xor";
        else if (cg_streq(e.sval, "<<") == 1) op_name = "shl";
        else if (cg_streq(e.sval, ">>") == 1) op_name = "ashr";
        else if (cg_streq(e.sval, "==") == 1) { is_cmp = 1; cmp_cond = "eq"; }
        else if (cg_streq(e.sval, "!=") == 1) { is_cmp = 1; cmp_cond = "ne"; }
        else if (cg_streq(e.sval, "<") == 1) { is_cmp = 1; cmp_cond = "slt"; }
        else if (cg_streq(e.sval, "<=") == 1) { is_cmp = 1; cmp_cond = "sle"; }
        else if (cg_streq(e.sval, ">") == 1) { is_cmp = 1; cmp_cond = "sgt"; }
        else if (cg_streq(e.sval, ">=") == 1) { is_cmp = 1; cmp_cond = "sge"; }

        string tmp = eir_temp(b);
        if (is_cmp == 1) {
            string line = cg_cat(tmp, " = icmp ");
            line = cg_cat(line, cmp_cond);
            line = cg_cat(line, " ");
            line = cg_cat(line, eir_type_str(lhs.ty));
            line = cg_cat(line, " ");
            line = cg_cat(line, lhs.op);
            line = cg_cat(line, ", ");
            line = cg_cat(line, rhs.op);
            eir_emit(b, line);
            res.op = tmp;
            res.ty = eir_ty_i1();
            res.ety = "bool";
            return res;
        }

        string line = cg_cat(tmp, " = ");
        line = cg_cat(line, op_name);
        line = cg_cat(line, " ");
        line = cg_cat(line, eir_type_str(lhs.ty));
        line = cg_cat(line, " ");
        line = cg_cat(line, lhs.op);
        line = cg_cat(line, ", ");
        line = cg_cat(line, rhs.op);
        eir_emit(b, line);
        res.op = tmp;
        res.ty = lhs.ty;
        res.ety = lhs.ety;
        return res;
    }

    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL) {
        string fn_name = "";
        if (e.a != null && e.a.kind == EK_IDENT) {
            fn_name = e.a.sval;
        } else if (e.sval != null) {
            fn_name = e.sval;
        }
        List<EirVal> args;
        List_init<EirVal>(&args, List_len<*ExprNode>(&e.kids));
        for (i in 0..List_len<*ExprNode>(&e.kids)) {
            List_push<EirVal>(&args, eir_expr(b, List_get<*ExprNode>(&e.kids, i)));
        }

        string tmp = eir_temp(b);
        string line = cg_cat(tmp, " = call i32 @");
        line = cg_cat(line, fn_name);
        line = cg_cat(line, "(");
        for (i in 0..List_len<EirVal>(&args)) {
            if (i > 0) line = cg_cat(line, ", ");
            EirVal a = List_get<EirVal>(&args, i);
            line = cg_cat(line, eir_type_str(a.ty));
            line = cg_cat(line, " ");
            line = cg_cat(line, a.op);
        }
        line = cg_cat(line, ")");
        eir_emit(b, line);
        res.op = tmp;
        res.ty = eir_ty_int(32, 1);
        res.ety = "int";
        return res;
    }

    res.op = "0";
    res.ty = eir_ty_int(32, 1);
    return res;
}

// ── Statement Lowering ──────────────────────────────────────────────────────

void eir_stmt(EirBuilder* b, *StmtNode s) {
    if (s == null || b.terminated == 1) {
        return;
    }

    if (s.kind == SK_BLOCK) {
        int mark = List_len<*StmtNode>(&b.cleanups);
        int lmark = List_len<*EirLocal>(&b.locals);
        for (i in 0..List_len<*StmtNode>(&s.items)) {
            if (b.terminated == 0) {
                eir_stmt(b, List_get<*StmtNode>(&s.items, i));
            }
        }
        if (b.terminated == 0) {
            eir_run_cleanups(b, mark);
        }
        eir_cleanups_trunc(b, mark);
        eir_locals_trunc(b, lmark);
        return;
    }

    if (s.kind == SK_DEFER) {
        List_push<*StmtNode>(&b.cleanups, s.s1);
        return;
    }

    if (s.kind == SK_VARDECL) {
        *EirType ty = eir_type_from_str(b, s.type);
        string slot = cg_cat("%", s.name);
        slot = cg_cat(slot, ".addr");

        string al = cg_cat(slot, " = alloca ");
        al = cg_cat(al, eir_type_str(ty));
        al = cg_cat(al, ", align ");
        al = cg_cat(al, cg_itoa(eir_type_align(ty)));
        eir_emit(b, al);

        int is_vol = s.is_vol;
        if (is_vol == 1) {
            List_push<string>(&b.volatile_vars, s.name);
        }

        *EirLocal loc = eir_local_alloc(s.name, slot, ty, s.type, is_vol);
        List_push<*EirLocal>(&b.locals, loc);

        if (s.expr != null) {
            EirVal init_v = eir_expr(b, s.expr);
            string st = "store ";
            if (is_vol == 1) st = "store volatile ";
            st = cg_cat(st, eir_type_str(init_v.ty));
            st = cg_cat(st, " ");
            st = cg_cat(st, init_v.op);
            st = cg_cat(st, ", ptr ");
            st = cg_cat(st, slot);
            eir_emit(b, st);
        }
        return;
    }

    if (s.kind == SK_EXPR) {
        eir_expr(b, s.expr);
        return;
    }

    if (s.kind == SK_RETURN) {
        if (s.expr != null) {
            EirVal v = eir_expr(b, s.expr);
            eir_run_cleanups(b, 0);
            string ret_line = cg_cat("ret ", eir_type_str(v.ty));
            ret_line = cg_cat(ret_line, " ");
            ret_line = cg_cat(ret_line, v.op);
            eir_emit(b, ret_line);
        } else {
            eir_run_cleanups(b, 0);
            eir_emit(b, "ret void");
        }
        b.terminated = 1;
        return;
    }

    if (s.kind == SK_BREAK) {
        if (List_len<string>(&b.loop_end) > 0) {
            int depth = List_get<int>(&b.loop_cldepth, List_len<int>(&b.loop_cldepth) - 1);
            eir_run_cleanups(b, depth);
            eir_br(b, List_get<string>(&b.loop_end, List_len<string>(&b.loop_end) - 1));
        }
        b.terminated = 1;
        return;
    }

    if (s.kind == SK_CONTINUE) {
        if (List_len<string>(&b.loop_cont) > 0) {
            int depth = List_get<int>(&b.loop_cldepth, List_len<int>(&b.loop_cldepth) - 1);
            eir_run_cleanups(b, depth);
            eir_br(b, List_get<string>(&b.loop_cont, List_len<string>(&b.loop_cont) - 1));
        }
        b.terminated = 1;
        return;
    }

    if (s.kind == SK_IF) {
        EirVal c = eir_expr(b, s.expr);
        string l_then = eir_lbl(b, "then");
        string l_end = eir_lbl(b, "merge");
        string l_else = l_end;
        if (s.s2 != null) {
            l_else = eir_lbl(b, "else");
        }
        eir_br_cond(b, c.op, l_then, l_else);

        eir_label(b, l_then);
        eir_stmt(b, s.s1);
        eir_br(b, l_end);

        if (s.s2 != null) {
            eir_label(b, l_else);
            eir_stmt(b, s.s2);
            eir_br(b, l_end);
        }
        eir_label(b, l_end);
        return;
    }

    if (s.kind == SK_WHILE) {
        string l_cond = eir_lbl(b, "while.cond");
        string l_body = eir_lbl(b, "while.body");
        string l_end = eir_lbl(b, "while.end");

        eir_br(b, l_cond);
        eir_label(b, l_cond);
        EirVal c = eir_expr(b, s.expr);
        eir_br_cond(b, c.op, l_body, l_end);

        List_push<string>(&b.loop_end, l_end);
        List_push<string>(&b.loop_cont, l_cond);
        List_push<int>(&b.loop_cldepth, List_len<*StmtNode>(&b.cleanups));

        eir_label(b, l_body);
        eir_stmt(b, s.s1);
        eir_br(b, l_cond);

        List_remove<string>(&b.loop_end, List_len<string>(&b.loop_end) - 1);
        List_remove<string>(&b.loop_cont, List_len<string>(&b.loop_cont) - 1);
        List_remove<int>(&b.loop_cldepth, List_len<int>(&b.loop_cldepth) - 1);

        eir_label(b, l_end);
        return;
    }

    if (s.kind == SK_ASM) {
        string asm_str = s.name;
        if (asm_str == null) asm_str = "";
        string clobbers = s.type;
        let operands: List<EirVal>;
        List_init<EirVal>(&operands, List_len<*StmtNode>(&s.items));

        string constraints = "";
        for (i in 0..List_len<*StmtNode>(&s.items)) {
            *StmtNode item = List_get<*StmtNode>(&s.items, i);
            if (i > 0) constraints = cg_cat(constraints, ",");
            if (item.type != null) constraints = cg_cat(constraints, item.type);
            List_push<EirVal>(&operands, eir_expr(b, item.expr));
        }

        string line = "inline_asm \"";
        line = cg_cat(line, asm_str);
        line = cg_cat(line, "\", \"");
        line = cg_cat(line, constraints);
        line = cg_cat(line, "\"");
        for (i in 0..List_len<EirVal>(&operands)) {
            line = cg_cat(line, ", ");
            EirVal op = List_get<EirVal>(&operands, i);
            line = cg_cat(line, eir_type_str(op.ty));
            line = cg_cat(line, " ");
            line = cg_cat(line, op.op);
        }
        if (clobbers != null && clobbers[0] != 0) {
            line = cg_cat(line, " ~[");
            line = cg_cat(line, "\"");
            line = cg_cat(line, clobbers);
            line = cg_cat(line, "\"]");
        }
        eir_emit(b, line);
        return;
    }
}

void eir_cleanups_trunc(EirBuilder* b, int depth) {
    while (List_len<*StmtNode>(&b.cleanups) > depth) {
        List_remove<*StmtNode>(&b.cleanups, List_len<*StmtNode>(&b.cleanups) - 1);
    }
}

void eir_locals_trunc(EirBuilder* b, int depth) {
    while (List_len<*EirLocal>(&b.locals) > depth) {
        List_remove<*EirLocal>(&b.locals, List_len<*EirLocal>(&b.locals) - 1);
    }
}

// ── Top-Level Program Walk ──────────────────────────────────────────────────

void eir_decl(EirBuilder* b, *DeclNode d) {
    if (d == null) return;

    if (d.kind == DK_EXTERN || (d.kind == DK_FUNCTION && d.body == null)) {
        String_append(&b.globals, "extern fn @");
        String_append(&b.globals, d.name);
        String_append(&b.globals, "(");
        int has_var = 0;
        int count = 0;
        for (i in 0..List_len<Param>(&d.params)) {
            Param p = List_get<Param>(&d.params, i);
            if (cg_streq(p.ty, "...") == 1 || cg_streq(p.name, "...") == 1) {
                has_var = 1;
                continue;
            }
            if (count > 0) String_append(&b.globals, ", ");
            *EirType pt = eir_type_from_str(b, p.ty);
            String_append(&b.globals, eir_type_str(pt));
            count = count + 1;
        }
        if (has_var == 1) {
            if (count > 0) String_append(&b.globals, ", ");
            String_append(&b.globals, "...");
        }
        String_append(&b.globals, ") -> ");
        *EirType rt = eir_type_from_str(b, d.ret_type);
        String_append(&b.globals, eir_type_str(rt));
        String_append(&b.globals, "\n\n");
        return;
    }

    if (d.kind == DK_FUNCTION) {
        b.cur_retty = d.ret_type;
        b.next = 0;
        b.lbl_next = 0;
        List_init<*EirLocal>(&b.locals, 16);
        List_init<*StmtNode>(&b.cleanups, 16);

        String_append(&b.out, "fn @");
        String_append(&b.out, d.name);
        String_append(&b.out, "(");
        for (i in 0..List_len<Param>(&d.params)) {
            if (i > 0) String_append(&b.out, ", ");
            Param p = List_get<Param>(&d.params, i);
            *EirType pt = eir_type_from_str(b, p.ty);
            String_append(&b.out, eir_type_str(pt));
            String_append(&b.out, " %");
            String_append(&b.out, p.name);
        }
        String_append(&b.out, ") -> ");
        *EirType rt = eir_type_from_str(b, d.ret_type);
        String_append(&b.out, eir_type_str(rt));
        String_append(&b.out, " {\n");

        eir_label(b, "entry");

        for (i in 0..List_len<Param>(&d.params)) {
            Param p = List_get<Param>(&d.params, i);
            *EirType pt = eir_type_from_str(b, p.ty);
            string slot = cg_cat("%", p.name);
            slot = cg_cat(slot, ".addr");
            string al = cg_cat(slot, " = alloca ");
            al = cg_cat(al, eir_type_str(pt));
            al = cg_cat(al, ", align ");
            al = cg_cat(al, cg_itoa(eir_type_align(pt)));
            eir_emit(b, al);

            string st = "store ";
            st = cg_cat(st, eir_type_str(pt));
            st = cg_cat(st, " %");
            st = cg_cat(st, p.name);
            st = cg_cat(st, ", ptr ");
            st = cg_cat(st, slot);
            eir_emit(b, st);

            *EirLocal loc = eir_local_alloc(p.name, slot, pt, p.ty, 0);
            List_push<*EirLocal>(&b.locals, loc);
        }

        eir_stmt(b, d.body);

        if (b.terminated == 0) {
            eir_run_cleanups(b, 0);
            if (cg_streq(d.ret_type, "void") == 1) {
                eir_emit(b, "ret void");
            } else {
                string ret_line = "ret ";
                ret_line = cg_cat(ret_line, eir_type_str(rt));
                ret_line = cg_cat(ret_line, " 0");
                eir_emit(b, ret_line);
            }
        }
        String_append(&b.out, "}\n\n");
    }
}

void eir_program(EirBuilder* b, *Program prog) {
    String_append(&b.globals, ";; EIR Module: main\n");
    if (b.target_triple != null && b.target_triple[0] != 0) {
        String_append(&b.globals, ";; Target: ");
        String_append(&b.globals, b.target_triple);
        String_append(&b.globals, "\n");
    }
    String_append(&b.globals, "\n");

    // Phase 1: Structs & Enums
    let struct_decls: List<*DeclNode>;
    List_init<*DeclNode>(&struct_decls, 8);

    for (i in 0..List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_ENUM) {
            if (ast_enum_has_payload(d) == 0) {
                List_push<string>(&b.plain_enums, d.name);
                int next_val = 0;
                for (j in 0..List_len<Param>(&d.params)) {
                    Param m = List_get<Param>(&d.params, j);
                    let ec: CgEnumC;
                    ec.name = m.name;
                    ec.val = cg_itoa(next_val);
                    List_push<CgEnumC>(&b.enum_consts, ec);
                    next_val = next_val + 1;
                }
            }
        }
        if (d.kind == DK_STRUCT) {
            List_push<*DeclNode>(&struct_decls, d);
            *EirStructInfo sinfo = eir_struct_alloc(d.name);
            eir_layout_bitfields(b, d, sinfo);
            List_push<*EirStructInfo>(&b.structs, sinfo);
        }
    }

    if (List_len<*DeclNode>(&struct_decls) > 0) {
        String_append(&b.globals, ";; Type definitions\n");
        for (i in 0..List_len<*DeclNode>(&struct_decls)) {
            *DeclNode s = List_get<*DeclNode>(&struct_decls, i);
            String_append(&b.globals, "type @");
            String_append(&b.globals, s.name);
            String_append(&b.globals, " = { ");
            for (j in 0..List_len<Param>(&s.params)) {
                if (j > 0) String_append(&b.globals, ", ");
                *EirType ft = eir_type_from_str(b, List_get<Param>(&s.params, j).ty);
                String_append(&b.globals, eir_type_str(ft));
            }
            String_append(&b.globals, " }\n");
        }
        String_append(&b.globals, "\n");
    }

    // Globals
    let global_decls: List<*DeclNode>;
    List_init<*DeclNode>(&global_decls, 8);
    for (i in 0..List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_VARDECL) {
            List_push<*DeclNode>(&global_decls, d);
            if (d.is_vol == 1) {
                List_push<string>(&b.volatile_vars, d.name);
            }
        }
    }

    if (List_len<*DeclNode>(&global_decls) > 0) {
        String_append(&b.globals, ";; Globals\n");
        for (i in 0..List_len<*DeclNode>(&global_decls)) {
            *DeclNode d = List_get<*DeclNode>(&global_decls, i);
            *EirType gt = eir_type_from_str(b, d.ret_type);
            String_append(&b.globals, "global @");
            String_append(&b.globals, d.name);
            String_append(&b.globals, " : ");
            String_append(&b.globals, eir_type_str(gt));
            String_append(&b.globals, " = ");
            if (d.init != null && d.init.kind == EK_LITERAL) {
                String_append(&b.globals, d.init.sval);
            } else {
                String_append(&b.globals, "0");
            }
            String_append(&b.globals, "\n");
        }
        String_append(&b.globals, "\n");
    }

    // Phase 2: Function declarations and bodies
    for (i in 0..List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION || d.kind == DK_EXTERN) {
            eir_decl(b, d);
        }
    }
}
