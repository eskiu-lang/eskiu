// Source formatter for `esk_main fmt`, a byte-for-byte mirror of the C++
// `formatSource` (main_support.cpp), whose comment lists the rules: one statement per
// line (a line is split after each statement's `;` and around block braces), spacing
// between tokens normalized, 4-space indentation per `{` level with continuation lines
// kept relative to their statement, trailing whitespace stripped, blank lines kept.
// Only blanks between tokens and line breaks change; comments, string and char
// literals, continuation lines (after a `\`) and preprocessor lines (`#…`, at column 0)
// keep their bytes, so the transform is idempotent and safe.

import <io>;
import <string>;
import <list>;

// Update the `{` nesting from tb[from, tlen) (code state), skipping strings, chars and
// comments; a `/*` without its `*/` leaves *in_block set (mirrors the C++ scanNesting).
// A string still open at the end of the line leaves *in_str set (and one open at
// the start is continued).
void fmt_scan(*uint8 tb, int tlen, int from, *int depth, *int in_block, *int in_str) {
    int j = from;
    while (j < tlen) {
        int c = (int)tb[j];
        if (in_str[0] == 1 || c == 34 || c == 39) {           // string / char literal
            int q = c;
            if (in_str[0] == 1) {
                q = 34;
            } else {
                j = j + 1;
            }
            in_str[0] = 0;
            while (j < tlen && (int)tb[j] != q) {
                if (tb[j] == 92 && j + 1 < tlen) {  // skip the escaped char
                    j = j + 1;
                }
                j = j + 1;
            }
            if (j >= tlen && q == 34) {
                in_str[0] = 1;
            }
            j = j + 1;                      // move past the closing quote
            continue;
        }
        if (c == 47 && j + 1 < tlen && tb[j + 1] == 47) {  // '//' line comment
            j = tlen;
            continue;
        }
        if (c == 47 && j + 1 < tlen && tb[j + 1] == 42) {   // '/*' block comment
            in_block[0] = 1;
            int m = j + 2;
            while (m + 1 < tlen) {
                if (tb[m] == 42 && tb[m + 1] == 47) {
                    in_block[0] = 0;
                    j = m + 1;
                    m = tlen;
                }
                else {
                    m = m + 1;
                }
            }
            if (in_block[0] == 1) {   // runs onto the next line
                j = tlen;
                continue;
            }
            j = j + 1;
            continue;
        }
        if (c == 123) {
            depth[0] = depth[0] + 1;
        }
        else {
            if (c == 125) {
                depth[0] = depth[0] - 1;
            }
        }
        j = j + 1;
    }
    if (depth[0] < 0) {
        depth[0] = 0;
    }
}

// The end of b[s, e) with trailing spaces and tabs dropped, unless that exposes a
// trailing `\` (trimming there would create a continuation).
int fmt_rtrim(*uint8 b, int s, int e) {
    int te = e;
    while (te > s && (b[te - 1] == 32 || b[te - 1] == 9)) {
        te = te - 1;
    }
    if (te > s && b[te - 1] == 92) {
        te = e;
    }
    return te;
}

// 1 when the directive line b[0, n) leaves a `/*` comment open (literals and `//`
// skipped, as the preprocessor strips a directive's comments; mirrors the C++).
int fmt_dir_opens(*uint8 b, int n) {
    int i = 0;
    while (i < n) {
        int c = (int)b[i];
        if (c == 34 || c == 39) {
            i = i + 1;
            while (i < n && (int)b[i] != c) {
                if (b[i] == 92 && i + 1 < n) {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if (c == 47 && i + 1 < n && b[i + 1] == 47) {
            return 0;
        }
        if (c == 47 && i + 1 < n && b[i + 1] == 42) {
            int e = i + 2;
            while (e + 1 < n && !(b[e] == 42 && b[e + 1] == 47)) {
                e = e + 1;
            }
            if (e + 1 >= n) {
                return 1;
            }
            i = e + 2;
            continue;
        }
        i = i + 1;
    }
    return 0;
}

// 1 when the C strings `a` and `b` are equal.
int fmt_eq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i = i + 1;
    }
    if (a[i] == b[i]) {
        return 1;
    }
    return 0;
}

// Append the line ending: CRLF when `crlf` is set, else LF.
void fmt_eol(String* out, int crlf) {
    if (crlf == 1) {
        String_push(out, (char)13);
    }
    String_push(out, (char)10);
}

// ── Statement layout (mirrors the C++ FmtLayout / fmtLayoutLine) ────────────
// The braces and parentheses open across lines: each `{` is a block (66 'B': a
// function or control-flow body, a struct or interface body, a match arm) or an
// initializer (73 'I': an array or struct literal, an enum body), and each brace level
// counts its own open `(` and `[`.
struct FmtLay {
    List<int> kinds;
    List<int> parens;
    int paren;
}

int fmt_ident(int c) {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
        return 1;
    }
    return 0;
}

// 1 for a character of an overloadable operator's spelling: + - * / % = ! < > & | ^ ~ [ ]
int fmt_op_char(int c) {
    if (c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 61 || c == 33 || c == 60 || c == 62
        || c == 38 || c == 124 || c == 94 || c == 126 || c == 91 || c == 93) {
        return 1;
    }
    return 0;
}

// 1 when t[i, n) starts with `o`.
int fmt_at(*uint8 t, int n, int i, string o) {
    int k = 0;
    while (o[k] != 0) {
        if (i + k >= n || (int)t[i + k] != (int)o[k]) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

int fmt_skip_blanks(*uint8 t, int n, int j) {
    while (j < n && (t[j] == 32 || t[j] == 9)) {
        j = j + 1;
    }
    return j;
}

int fmt_rest_is_code(*uint8 t, int n, int j) {
    j = fmt_skip_blanks(t, n, j);
    if (j >= n) {
        return 0;
    }
    if (t[j] == 47 && j + 1 < n && (t[j + 1] == 47 || t[j + 1] == 42)) {
        return 0;
    }
    return 1;
}

void fmt_rtrim_str(String* s) {
    while (s.len > 0 && s.data[s.len - 1] == 32) {
        s.len = s.len - 1;
        s.data[s.len] = 0;
    }
}

int fmt_back(String* s) {
    if (s.len == 0) {
        return 0;
    }
    return (int)s.data[s.len - 1];
}

// A copy of String `s` as a C string.
string fmt_copy(String* s) {
    let c: String;
    String_init(&c, s.len + 1);
    String_append(&c, (string)String_cstr(s));
    return (string)String_cstr(&c);
}

// The word t[j, ..) of identifier characters.
string fmt_word_at(*uint8 t, int n, int j) {
    let w: String;
    String_init(&w, 16);
    while (j < n && fmt_ident((int)t[j]) == 1) {
        String_push(&w, (char)t[j]);
        j = j + 1;
    }
    return (string)String_cstr(&w);
}

void fmt_open(FmtLay* st, int kind) {
    List_push<int>(&st.kinds, kind);
    List_push<int>(&st.parens, st.paren);
    st.paren = 0;
}

// `src`'s braces and parentheses copied into `dst` (fresh lists): the nesting saved at
// an `#if` (mirrors the C++ condLayout).
void fmt_lay_copy(FmtLay* dst, FmtLay* src) {
    int k = List_len<int>(&src.kinds);
    List_init<int>(&dst.kinds, k + 4);
    List_init<int>(&dst.parens, k + 4);
    int i = 0;
    while (i < k) {
        List_push<int>(&dst.kinds, List_get<int>(&src.kinds, i));
        List_push<int>(&dst.parens, List_get<int>(&src.parens, i));
        i = i + 1;
    }
    dst.paren = src.paren;
}

int fmt_top_block(FmtLay* st) {
    int k = List_len<int>(&st.kinds);
    if (k == 0 || List_get<int>(&st.kinds, k - 1) == 66) {
        return 1;
    }
    return 0;
}

// Pop the innermost brace: its kind (73 when none is open).
int fmt_close(FmtLay* st) {
    int k = List_len<int>(&st.kinds);
    if (k == 0) {
        return 73;
    }
    int kind = List_get<int>(&st.kinds, k - 1);
    List_remove<int>(&st.kinds, k - 1);
    st.paren = List_get<int>(&st.parens, k - 1);
    List_remove<int>(&st.parens, k - 1);
    return kind;
}

// Count the brackets of t[from, n) (strings and chars skipped, up to a comment) into the
// layout state: a line that is left as it is, or the code after a multi-line string.
void fmt_count_brackets(FmtLay* st, *uint8 t, int n, int from) {
    int i = from;
    while (i < n) {
        int c = (int)t[i];
        if (c == 34 || c == 39) {
            int j = i + 1;
            while (j < n && (int)t[j] != c) {
                if (t[j] == 92 && j + 1 < n) {
                    j = j + 1;
                }
                j = j + 1;
            }
            i = j + 1;
            continue;
        }
        if (c == 47 && i + 1 < n && (t[i + 1] == 47 || t[i + 1] == 42)) {
            i = n;
            continue;
        }
        if (c == 40 || c == 91) {
            st.paren = st.paren + 1;
        }
        else if (c == 41 || c == 93) {
            st.paren = st.paren - 1;
        }
        else if (c == 123) {
            fmt_open(st, 73);
        }
        else if (c == 125 && List_len<int>(&st.kinds) > 0) {
            fmt_close(st);
        }
        i = i + 1;
    }
}

// The line state of fmt_layout_line, shared with its helpers.
struct FmtLine {
    String cur;
    int need_space;
    string last_word;
    int i;
    int last;
    List<string> pieces;
}

void fmt_emit(FmtLine* ln, string s) {
    if (ln.need_space == 1 && ln.cur.len > 0 && fmt_back(&ln.cur) != 32) {
        String_push(&ln.cur, (char)32);
    }
    ln.need_space = 0;
    String_append(&ln.cur, s);
    int k = 0;
    while (s[k] != 0) {
        k = k + 1;
    }
    ln.last = (int)s[k - 1];
}

void fmt_flush(FmtLine* ln) {
    fmt_rtrim_str(&ln.cur);
    if (ln.cur.len > 0) {
        List_push<string>(&ln.pieces, fmt_copy(&ln.cur));
    }
    String_clear(&ln.cur);
    ln.need_space = 0;
    ln.last_word = "";
}

// After a block's `}`: `else`, `while`, `catch`, `finally` and `;` `)` `,` `]` stay on
// its line; anything else starts a new one.
void fmt_after_close(FmtLine* ln, *uint8 t, int n) {
    int j = fmt_skip_blanks(t, n, ln.i);
    if (j >= n) {
        return;
    }
    string w = fmt_word_at(t, n, j);
    if (fmt_eq(w, "else") == 1 || fmt_eq(w, "while") == 1 || fmt_eq(w, "catch") == 1 || fmt_eq(w, "finally") == 1) {
        String_push(&ln.cur, (char)32);
        ln.i = j;
        return;
    }
    if (t[j] == 59 || t[j] == 41 || t[j] == 44 || t[j] == 93) {
        ln.i = j;
        return;
    }
    if (fmt_rest_is_code(t, n, j) == 1) {
        fmt_flush(ln);
    }
}

// 1 for a letter or `_`: the start of an identifier.
int fmt_alpha(int c) {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95) {
        return 1;
    }
    return 0;
}

// 1 for a keyword, which never names a generic type or function (`return a < b > c`).
int fmt_keyword(string w) {
    string kws = " let int float double bool char string void struct packed union interface enum fn operator asm volatile static escaping must_use async await const sizeof free_closure thread_create thread_join for in while do if else switch match case default break return import extern intrinsic alloc_with null true false try catch finally throw defer errdefer continue uint ";
    int p = 0;
    while (kws[p] != 0) {
        if (kws[p] == 32) {
            int k = 0;
            while (w[k] != 0 && kws[p + 1 + k] == w[k]) {
                k = k + 1;
            }
            if (k > 0 && w[k] == 0 && kws[p + 1 + k] == 32) {
                return 1;
            }
        }
        p = p + 1;
    }
    return 0;
}

// 1 when `v` is in `l`.
int fmt_has_int(List<int>* l, int v) {
    int k = 0;
    while (k < List_len<int>(l)) {
        if (List_get<int>(l, k) == v) {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

// A type argument list `<...>` starting at t[p] == '<': the index of its closing `>`, or
// -1 when t[p, n) is not one (the C++ fmtTypeArgEnd). Its tokens may only be
// identifiers, `*`, `?`, `,`, an array suffix `[N]`, `fn(...)` parameter lists with a
// `->` after the `)`, and nested lists after an identifier. The positions of the `<` and
// `>` of this list and of the nested ones are added to `marks`.
int fmt_type_arg_end(*uint8 t, int n, int p, List<int>* marks) {
    int i = p + 1;
    if (i < n && (t[i] == 60 || t[i] == 61)) {
        return -1;
    }
    int paren = 0;
    int brack = 0;
    int any = 0;
    int prev = 60;          // the previous token: 119 'w' a word, 97 'a' `->`, else itself
    int is_fn = 0;
    while (i < n) {
        int c = (int)t[i];
        if (c == 32 || c == 9) {
            i = i + 1;
            continue;
        }
        if (fmt_alpha(c) == 1 || (brack == 1 && c >= 48 && c <= 57)) {
            int j = i;
            while (j < n && fmt_ident((int)t[j]) == 1) {
                j = j + 1;
            }
            is_fn = 0;
            if (j - i == 2 && t[i] == 102 && t[i + 1] == 110) {
                is_fn = 1;
            }
            prev = 119;
            any = 1;
            i = j;
            continue;
        }
        if (c == 60) {
            if (prev != 119 || brack == 1) {
                return -1;
            }
            int e = fmt_type_arg_end(t, n, i, marks);
            if (e < 0) {
                return -1;
            }
            prev = 62;
            i = e + 1;
            continue;
        }
        if (c == 62) {
            if (paren > 0 || brack == 1 || any == 0
                || !(prev == 119 || prev == 42 || prev == 93 || prev == 41 || prev == 62)) {
                return -1;
            }
            List_push<int>(marks, p);
            List_push<int>(marks, i);
            return i;
        }
        if (c == 45) {
            if (prev != 41 || i + 1 >= n || t[i + 1] != 62) {
                return -1;
            }
            prev = 97;
            i = i + 2;
            continue;
        }
        if (c == 40) {
            if (brack == 1 || !(prev == 119 && is_fn == 1)) {
                return -1;
            }
            paren = paren + 1;
        } else if (c == 41) {
            if (brack == 1 || paren == 0) {
                return -1;
            }
            paren = paren - 1;
        } else if (c == 91) {
            if (brack == 1 || !(prev == 119 || prev == 93 || prev == 62 || prev == 42)) {
                return -1;
            }
            brack = 1;
        } else if (c == 93) {
            if (brack == 0) {
                return -1;
            }
            brack = 0;
        } else if (c == 42) {
            int j = fmt_skip_blanks(t, n, i + 1);
            int operand_after = 0;
            if (j < n && (fmt_ident((int)t[j]) == 1 || t[j] == 40)) {
                operand_after = 1;
            }
            if (brack == 1 || ((prev == 119 || prev == 93 || prev == 62 || prev == 41) && operand_after == 1)) {
                return -1;
            }
        } else if (c == 63 || c == 44) {
            if (brack == 1) {
                return -1;
            }
        } else {
            return -1;
        }
        prev = c;
        i = i + 1;
    }
    return -1;
}

// 1 when the `<` at t[i] opens a type argument list beyond doubt (the C++ fmtTypeArgs):
// after an identifier that is not a keyword, directly or, for a capitalized name, after
// blanks; type tokens only; and an identifier, `(`, `{`, `)`, `,`, `;`, `[` or `*` after
// its `>`. The `<` and `>` positions of it and of its nested lists go into `marks`.
int fmt_type_args(*uint8 t, int n, int i, string head, List<int>* marks) {
    if (head[0] == 0 || (head[0] >= 48 && head[0] <= 57) || fmt_keyword(head) == 1) {
        return 0;
    }
    int k = i;
    while (k > 0 && (t[k - 1] == 32 || t[k - 1] == 9)) {
        k = k - 1;
    }
    if (k == 0 || fmt_ident((int)t[k - 1]) == 0) {
        return 0;
    }
    if (k < i && !(head[0] >= 65 && head[0] <= 90)) {
        return 0;
    }
    let found: List<int>;
    List_init<int>(&found, 8);
    int e = fmt_type_arg_end(t, n, i, &found);
    if (e < 0) {
        return 0;
    }
    int j = fmt_skip_blanks(t, n, e + 1);
    if (j >= n) {
        return 0;
    }
    int f = (int)t[j];
    if (!(fmt_alpha(f) == 1 || f == 40 || f == 123 || f == 41 || f == 44 || f == 59 || f == 91 || f == 42)) {
        return 0;
    }
    int q = 0;
    while (q < List_len<int>(&found)) {
        List_push<int>(marks, List_get<int>(&found, q));
        q = q + 1;
    }
    return 1;
}

// The substring t[a, b) as a C string.
string fmt_sub(*uint8 t, int a, int b) {
    let s: String;
    String_init(&s, b - a + 1);
    int k = a;
    while (k < b) {
        String_push(&s, (char)t[k]);
        k = k + 1;
    }
    return (string)String_cstr(&s);
}

// Lay out one code line t[0, n) (no leading blanks): the C++ fmtLayoutLine. Fills
// `out` with the pieces, one per output line; `last` is the last code character.
void fmt_layout_line(FmtLay* st, *uint8 t, int n, *int last, List<string>* out) {
    let ln: FmtLine;
    String_init(&ln.cur, n + 16);
    ln.need_space = 0;
    ln.last_word = "";
    ln.i = 0;
    ln.last = last[0];
    List_init<string>(&ln.pieces, 4);
    string comment = "";
    let tmarks: List<int>;   // the `<` and `>` of the type argument lists found so far
    List_init<int>(&tmarks, 8);
    int ok = 1;
    if (n > 0 && t[n - 1] == 92) {
        ok = 0;
    }
    while (ok == 1 && ln.i < n) {
        int i = ln.i;
        int c = (int)t[i];
        if (c == 34 || c == 39) {
            int j = i + 1;
            while (j < n && (int)t[j] != c) {
                if (t[j] == 92 && j + 1 < n) {
                    j = j + 1;
                }
                j = j + 1;
            }
            if (j >= n) {
                ok = 0;
                continue;
            }
            fmt_emit(&ln, fmt_sub(t, i, j + 1));
            ln.last_word = "";
            ln.i = j + 1;
            continue;
        }
        if (c == 47 && i + 1 < n && t[i + 1] == 47) {
            int g = i;
            while (g > 0 && (t[g - 1] == 32 || t[g - 1] == 9)) {
                g = g - 1;
            }
            comment = fmt_sub(t, g, n);
            ln.i = n;
            continue;
        }
        if (c == 47 && i + 1 < n && t[i + 1] == 42) {
            int e = i + 2;
            while (e + 1 < n && !(t[e] == 42 && t[e + 1] == 47)) {
                e = e + 1;
            }
            if (e + 1 >= n) {
                ok = 0;
                continue;
            }
            int keep = ln.last;
            fmt_emit(&ln, fmt_sub(t, i, e + 2));
            ln.last = keep;
            ln.i = e + 2;
            continue;
        }
        if (c == 32 || c == 9 || c == 13) {   // a lone CR is a blank to the lexer
            int b = fmt_back(&ln.cur);
            if (ln.cur.len > 0 && b != 32 && b != 40 && b != 91) {
                String_push(&ln.cur, (char)32);
            }
            ln.i = i + 1;
            continue;
        }
        if (fmt_ident(c) == 1) {
            string w = fmt_word_at(t, n, i);
            int j = i;
            while (w[j - i] != 0) {
                j = j + 1;
            }
            fmt_emit(&ln, w);
            ln.i = j;
            if ((fmt_eq(w, "if") == 1 || fmt_eq(w, "while") == 1 || fmt_eq(w, "for") == 1 || fmt_eq(w, "switch") == 1
                 || fmt_eq(w, "catch") == 1 || fmt_eq(w, "match") == 1)
                && j < n && t[j] == 40 && fmt_eq(ln.last_word, "operator") == 0) {
                String_push(&ln.cur, (char)32);
            }
            ln.last_word = w;
            continue;
        }
        // A type argument list: no blank around its `<` or before its `>` (`List<int>`),
        // except between two `>` written apart, which would otherwise become `>>`.
        if (c == 60 || c == 62) {
            int marked = fmt_has_int(&tmarks, i);
            if (marked == 0 && c == 60 && fmt_eq(ln.last_word, "operator") == 0) {
                marked = fmt_type_args(t, n, i, ln.last_word, &tmarks);
            }
            if (marked == 1) {
                int apart = 0;
                if (ln.cur.len > 0 && fmt_back(&ln.cur) == 32) {
                    apart = 1;
                }
                fmt_rtrim_str(&ln.cur);
                if (c == 62 && apart == 1 && ln.cur.len > 0 && fmt_back(&ln.cur) == 62) {
                    String_push(&ln.cur, (char)32);
                }
                String_push(&ln.cur, (char)c);
                ln.last = c;
                ln.need_space = 0;
                ln.last_word = "";
                if (c == 60) {
                    ln.i = fmt_skip_blanks(t, n, i + 1);
                } else {
                    ln.i = i + 1;
                }
                continue;
            }
        }
        if (fmt_eq(ln.last_word, "operator") == 1 && fmt_op_char(c) == 1) {   // `operator ==` as written
            int j = i;
            while (j < n && fmt_op_char((int)t[j]) == 1) {
                j = j + 1;
            }
            fmt_emit(&ln, fmt_sub(t, i, j));
            ln.last_word = "";
            ln.i = j;
            continue;
        }
        string op = "";
        if (fmt_eq(ln.last_word, "operator") == 0) {
            if (fmt_at(t, n, i, "<<=") == 1) {
                op = "<<=";
            }
            else if (fmt_at(t, n, i, ">>=") == 1) {
                op = ">>=";
            }
            else if (fmt_at(t, n, i, "==") == 1) {
                op = "==";
            }
            else if (fmt_at(t, n, i, "!=") == 1) {
                op = "!=";
            }
            else if (fmt_at(t, n, i, "<=") == 1) {
                op = "<=";
            }
            else if (fmt_at(t, n, i, ">=") == 1) {
                op = ">=";
            }
            else if (fmt_at(t, n, i, "&&") == 1) {
                op = "&&";
            }
            else if (fmt_at(t, n, i, "||") == 1) {
                op = "||";
            }
            else if (fmt_at(t, n, i, "+=") == 1) {
                op = "+=";
            }
            else if (fmt_at(t, n, i, "-=") == 1) {
                op = "-=";
            }
            else if (fmt_at(t, n, i, "*=") == 1) {
                op = "*=";
            }
            else if (fmt_at(t, n, i, "/=") == 1) {
                op = "/=";
            }
            else if (fmt_at(t, n, i, "%=") == 1) {
                op = "%=";
            }
            else if (fmt_at(t, n, i, "&=") == 1) {
                op = "&=";
            }
            else if (fmt_at(t, n, i, "|=") == 1) {
                op = "|=";
            }
            else if (fmt_at(t, n, i, "^=") == 1) {
                op = "^=";
            }
            else if (c == 61) {
                op = "=";
            }
        }
        if (op[0] != 0) {
            fmt_rtrim_str(&ln.cur);
            if (ln.cur.len > 0) {
                String_push(&ln.cur, (char)32);
            }
            String_append(&ln.cur, op);
            ln.last = 61;
            ln.need_space = 1;
            ln.last_word = "";
            int ol = 0;
            while (op[ol] != 0) {
                ol = ol + 1;
            }
            ln.i = i + ol;
            continue;
        }
        if (c == 44) {
            fmt_rtrim_str(&ln.cur);
            String_push(&ln.cur, (char)44);
            ln.last = 44;
            ln.need_space = 1;
            ln.last_word = "";
            ln.i = i + 1;
            continue;
        }
        if (c == 59) {
            fmt_rtrim_str(&ln.cur);
            String_push(&ln.cur, (char)59);
            ln.last = 59;
            ln.last_word = "";
            ln.i = i + 1;
            if (st.paren == 0 && fmt_top_block(st) == 1 && fmt_rest_is_code(t, n, ln.i) == 1) {
                fmt_flush(&ln);
            }
            else {
                ln.need_space = 1;
            }
            continue;
        }
        if (c == 40 || c == 91) {
            fmt_emit(&ln, fmt_sub(t, i, i + 1));
            st.paren = st.paren + 1;
            ln.last_word = "";
            ln.i = i + 1;
            continue;
        }
        if (c == 41 || c == 93) {
            fmt_rtrim_str(&ln.cur);
            String_push(&ln.cur, (char)c);
            ln.last = c;
            ln.need_space = 0;
            st.paren = st.paren - 1;
            ln.last_word = "";
            ln.i = i + 1;
            continue;
        }
        if (c == 123) {
            let head: String;
            String_init(&head, ln.cur.len + 1);
            String_append(&head, (string)String_cstr(&ln.cur));
            fmt_rtrim_str(&head);
            *uint8 hb = (*uint8)String_cstr(&head);
            int hn = (int)head.len;
            int fs = 0;
            while (fs < hn && hb[fs] == 32) {
                fs = fs + 1;
            }
            string fw = fmt_word_at(hb, hn, fs);
            int block = 0;
            if (hn == 0) {
                if (fmt_top_block(st) == 1 && st.paren == 0 && ln.last != 61 && ln.last != 44 && ln.last != 40 && ln.last != 91) {
                    block = 1;
                }
            } else if (fmt_eq(fw, "enum") == 1) {
                block = 0;
            } else {
                int hl = (int)hb[hn - 1];
                if (hl == 41 || (hn >= 2 && hb[hn - 2] == 45 && hb[hn - 1] == 62)
                    || fmt_eq(ln.last_word, "else") == 1 || fmt_eq(ln.last_word, "do") == 1 || fmt_eq(ln.last_word, "try") == 1
                    || fmt_eq(ln.last_word, "finally") == 1 || fmt_eq(ln.last_word, "defer") == 1 || fmt_eq(ln.last_word, "errdefer") == 1
                    || fmt_eq(fw, "struct") == 1 || fmt_eq(fw, "union") == 1 || fmt_eq(fw, "interface") == 1
                    || fmt_eq(fw, "packed") == 1 || fmt_eq(fw, "match") == 1
                    || (hl == 58 && (fmt_eq(fw, "case") == 1 || fmt_eq(fw, "default") == 1))) {
                    block = 1;
                }
            }
            ln.last_word = "";
            if (block == 0) {
                fmt_emit(&ln, "{");
                fmt_open(st, 73);
                ln.i = i + 1;
                continue;
            }
            fmt_rtrim_str(&ln.cur);
            if (ln.cur.len > 0) {
                String_push(&ln.cur, (char)32);
            }
            int j = fmt_skip_blanks(t, n, i + 1);
            if (j < n && t[j] == 125) {            // an empty block stays `{}`
                String_append(&ln.cur, "{}");
                ln.last = 125;
                ln.need_space = 0;
                ln.i = j + 1;
                fmt_after_close(&ln, t, n);
                continue;
            }
            String_push(&ln.cur, (char)123);
            ln.last = 123;
            ln.need_space = 0;
            fmt_open(st, 66);
            ln.i = i + 1;
            if (fmt_rest_is_code(t, n, ln.i) == 1) {
                fmt_flush(&ln);
            }
            continue;
        }
        if (c == 125) {
            int kind = fmt_close(st);
            ln.i = i + 1;
            ln.last_word = "";
            ln.need_space = 0;
            if (kind == 66) {
                fmt_flush(&ln);
                String_push(&ln.cur, (char)125);
                ln.last = 125;
                fmt_after_close(&ln, t, n);
            } else {
                String_push(&ln.cur, (char)125);
                ln.last = 125;
            }
            continue;
        }
        fmt_emit(&ln, fmt_sub(t, i, i + 1));
        ln.last_word = "";
        ln.i = i + 1;
    }
    last[0] = ln.last;
    if (ok == 0) {
        fmt_count_brackets(st, t, n, ln.i);   // the rest still counts; the text is kept
        List_push<string>(out, fmt_sub(t, 0, n));
        return;
    }
    fmt_rtrim_str(&ln.cur);
    if (ln.cur.len > 0) {
        List_push<string>(&ln.pieces, fmt_copy(&ln.cur));
    }
    // A trailing comment stays with the statement's first line (`while (x) {  // why`).
    if (comment[0] != 0) {
        int a = 0;
        while (comment[a] == 32 || comment[a] == 9) {
            a = a + 1;
        }
        if (List_len<string>(&ln.pieces) == 0) {
            List_push<string>(&ln.pieces, (string)((*uint8)comment + a));
        }
        else {
            let joined: String;
            String_init(&joined, 64);
            String_append(&joined, List_get<string>(&ln.pieces, 0));
            String_append(&joined, comment);
            List_set<string>(&ln.pieces, 0, (string)String_cstr(&joined));
        }
    }
    if (List_len<string>(&ln.pieces) == 0) {
        List_push<string>(&ln.pieces, fmt_sub(t, 0, n));
    }
    int k = 0;
    while (k < List_len<string>(&ln.pieces)) {
        List_push<string>(out, List_get<string>(&ln.pieces, k));
        k = k + 1;
    }
}

// Reindent `src` (n bytes) and return the formatted text. Mirrors the C++ line split
// (break on `\n`, drop the one `\r` before it, with the remainder after the last `\n`
// as a final line)
// and keeps the file's line ending (CRLF if its first line break is `\r\n`).
String format_source(*uint8 src, int n) {
    let out: String;
    String_init(&out, n + 64);
    let depth: int = 0;    // current `{` nesting
    let inBlock: int = 0;  // inside a /* … */ block comment
    let inStr: int = 0;    // a string literal continues onto the next line
    int prevCont = 0;      // the previous line ends with `\`: this one continues it
    int ppCont = 0;        // the continued line is a preprocessor line (no nesting)
    int pendingBlank = 0;  // blank lines buffered (dropped only at the end of the file)
    // The preprocessor's view (mirrors the C++): a `#` line inside a multi-line string is
    // string text, each branch of a conditional and the code after `#endif` start from
    // the string state at the `#if`, and a directive that leaves a `/*` open opens a
    // comment for the following lines. In a string opened inside a conditional (maybe a
    // branch that is not compiled) a `#` line keeps its bytes but counts as a directive.
    List<int> condStr;
    List_init<int>(&condStr, 4);
    int strSeen = 0;       // inStr was already set at the start of the previous line
    int strInCond = 0;     // the open string began inside a conditional
    let ppLine: String;    // the directive's logical line (continuations joined)
    String_init(&ppLine, 64);
    int firstLine = 1;
    let layout: FmtLay;    // the open braces' kinds and parentheses (fmt_layout_line)
    List_init<int>(&layout.kinds, 16);
    List_init<int>(&layout.parens, 16);
    layout.paren = 0;
    int last = 0;          // the last code character so far
    List<int> condLast;    // `last` at each open #if
    List_init<int>(&condLast, 4);
    // The nesting at each open #if: each branch starts from it (only one reaches the
    // lexer), and the code after `#endif` continues from the last branch.
    List<int> condDepth;
    List_init<int>(&condDepth, 4);
    List<FmtLay> condLay;
    List_init<FmtLay>(&condLay, 4);
    int stmtOrig = 0;      // the current statement's first line: indent before and after
    int stmtNew = 0;
    int sepNext = 0;       // the last line closed a top-level block
    int crlf = 0;
    int fnl = 0;
    while (fnl < n && src[fnl] != 10) {
        fnl = fnl + 1;
    }
    if (fnl < n && fnl > 0 && src[fnl - 1] == 13) {
        crlf = 1;
    }

    let raw: String;       // one source line, `\r` stripped, not yet trimmed
    String_init(&raw, 128);
    let t: String;         // the trimmed line content
    String_init(&t, 128);

    int i = 0;
    int done = 0;
    while (done == 0) {
        String_clear(&raw);
        while (i < n && src[i] != 10) {
            String_push(&raw, (char)src[i]);
            i = i + 1;
        }
        if (i < n) {                // consume the '\n', and a CRLF ending's '\r'
            i = i + 1;
            int rl = (int)String_len(&raw);
            if (rl > 0 && (int)String_char_at(&raw, rl - 1) == 13) {
                raw.len = raw.len - 1;
                raw.data[raw.len] = 0;
            }
        }
        else {          // final remainder line: process it, then stop
            done = 1;
        }

        int rlen = (int)String_len(&raw);
        // The text after the final newline is a line only when it is not empty (C++).
        if (done == 1 && rlen == 0 && n > 0 && src[n - 1] == 10) {
            continue;
        }
        *uint8 rb = (*uint8)String_cstr(&raw);
        int cont = prevCont;
        int shebang = 0;
        if (firstLine == 1 && rlen >= 2 && rb[0] == 35 && rb[1] == 33) {
            shebang = 1;
        }
        firstLine = 0;
        prevCont = 0;
        if (rlen > 0 && rb[rlen - 1] == 92) {
            prevCont = 1;
        }
        if (inStr == 1 && strSeen == 0) {
            strInCond = 0;
            if (List_len<int>(&condStr) > 0) {
                strInCond = 1;
            }
        }
        strSeen = inStr;
        int h0 = 0;
        while (h0 < rlen && (rb[h0] == 32 || rb[h0] == 9)) {
            h0 = h0 + 1;
        }
        int directive = 0;
        if (inBlock == 0 && cont == 0 && (inStr == 0 || strInCond == 1) && h0 < rlen && rb[h0] == 35) {
            directive = 1;
        }

        if (inBlock == 1) {         // verbatim until the comment closes
            int a = 0;
            while (a < rlen) {
                String_push(&out, (char)rb[a]);
                a = a + 1;
            }
            fmt_eol(&out, crlf);
            int b = 0;
            while (b + 1 < rlen) {
                if (rb[b] == 42 && rb[b + 1] == 47) {
                    inBlock = 0;
                    fmt_scan(rb, rlen, b + 2, &depth, &inBlock, &inStr);   // code after the `*/` still nests
                    b = rlen;
                }
                else {
                    b = b + 1;
                }
            }
            continue;
        }

        if (inStr == 1 && directive == 0) {   // inside a multi-line string: bytes verbatim
            fmt_scan(rb, rlen, 0, &depth, &inBlock, &inStr);
            int ve = rlen;
            if (inStr == 0) {
                ve = fmt_rtrim(rb, 0, rlen);
                if (ve > 0) {
                    last = (int)rb[ve - 1];
                }
                int q = 0;                         // the string's closing quote
                while (q < ve && rb[q] != 34) {
                    if (rb[q] == 92 && q + 1 < ve) {
                        q = q + 1;
                    }
                    q = q + 1;
                }
                fmt_count_brackets(&layout, rb, ve, q + 1);
            }
            int a = 0;
            while (a < ve) {
                String_push(&out, (char)rb[a]);
                a = a + 1;
            }
            fmt_eol(&out, crlf);
            continue;
        }

        if (cont == 1) {            // a continuation line: bytes verbatim
            int a = 0;
            while (a < rlen) {
                String_push(&out, (char)rb[a]);
                a = a + 1;
            }
            fmt_eol(&out, crlf);
            if (ppCont == 0) {
                fmt_scan(rb, rlen, 0, &depth, &inBlock, &inStr);
            }
            else {
                int a2 = 0;
                int ae = rlen;
                if (prevCont == 1) {
                    ae = rlen - 1;
                }
                while (a2 < ae) {
                    String_push(&ppLine, (char)rb[a2]);
                    a2 = a2 + 1;
                }
                if (prevCont == 0) {
                    inBlock = fmt_dir_opens((*uint8)String_cstr(&ppLine), (int)String_len(&ppLine));
                }
            }
            continue;
        }

        // drop leading spaces and tabs into `t` (trailing ones go after the scan)
        int ts = 0;
        while (ts < rlen && (rb[ts] == 32 || rb[ts] == 9)) {
            ts = ts + 1;
        }
        if (ts == rlen) {
            pendingBlank = pendingBlank + 1;
            continue;
        }
        String_clear(&t);
        int cp = ts;
        while (cp < rlen) {
            String_push(&t, (char)rb[cp]);
            cp = cp + 1;
        }
        int tlen = (int)String_len(&t);
        *uint8 tb = (*uint8)String_cstr(&t);

        // A top-level definition is set apart from what follows it.
        if (sepNext == 1 && pendingBlank == 0 && tb[0] != 125 && tb[0] != 35) {
            fmt_eol(&out, crlf);
        }
        sepNext = 0;
        while (pendingBlank > 0) {   // keep every blank line
            fmt_eol(&out, crlf);
            pendingBlank = pendingBlank - 1;
        }

        ppCont = 0;
        if (tb[0] == 35) {
            ppCont = 1;
        }
        if (tb[0] == 35) {          // '#' preprocessor line: column 0, no nesting change
            int full = tlen;
            tlen = fmt_rtrim(tb, 0, tlen);
            int a = 0;
            if (inStr == 1) {
                while (a < rlen) {
                    String_push(&out, (char)rb[a]);
                    a = a + 1;
                }
            }
            else {
                while (a < tlen) {
                    String_push(&out, (char)tb[a]);
                    a = a + 1;
                }
            }
            fmt_eol(&out, crlf);
            int k2 = 1;
            while (k2 < full && (tb[k2] == 32 || tb[k2] == 9)) {
                k2 = k2 + 1;
            }
            int ks = k2;
            while (k2 < full && ((tb[k2] >= 97 && tb[k2] <= 122) || (tb[k2] >= 65 && tb[k2] <= 90)
                                 || (tb[k2] >= 48 && tb[k2] <= 57) || tb[k2] == 95)) {
                k2 = k2 + 1;
            }
            String kws;
            String_init(&kws, 8);
            int q = ks;
            while (q < k2) {
                String_push(&kws, (char)tb[q]);
                q = q + 1;
            }
            string kw = (string)String_cstr(&kws);
            int nc = List_len<int>(&condStr);
            // Each branch, and the code after `#endif`, starts from the state at the `#if`.
            if (fmt_eq(kw, "if") == 1 || fmt_eq(kw, "ifdef") == 1 || fmt_eq(kw, "ifndef") == 1) {
                List_push<int>(&condStr, inStr);
                List_push<int>(&condLast, last);
                List_push<int>(&condDepth, depth);
                let saved: FmtLay;
                fmt_lay_copy(&saved, &layout);
                List_push<FmtLay>(&condLay, saved);
            }
            else if ((fmt_eq(kw, "elif") == 1 || fmt_eq(kw, "else") == 1) && nc > 0) {
                inStr = List_get<int>(&condStr, nc - 1);
                last = List_get<int>(&condLast, nc - 1);
                depth = List_get<int>(&condDepth, nc - 1);
                FmtLay at_if = List_get<FmtLay>(&condLay, nc - 1);
                fmt_lay_copy(&layout, &at_if);
            }
            else if (fmt_eq(kw, "endif") == 1 && nc > 0) {
                inStr = List_get<int>(&condStr, nc - 1);
                last = List_get<int>(&condLast, nc - 1);
                List_remove<int>(&condStr, nc - 1);
                List_remove<int>(&condLast, nc - 1);
                List_remove<int>(&condDepth, nc - 1);
                List_remove<FmtLay>(&condLay, nc - 1);
            }
            if (prevCont == 1) {
                String_clear(&ppLine);
                int a3 = 0;
                while (a3 < full - 1) {
                    String_push(&ppLine, (char)tb[a3]);
                    a3 = a3 + 1;
                }
            } else if (shebang == 0) {
                inBlock = fmt_dir_opens(tb, full);
            }
            continue;
        }

        // A line inside open parentheses, or after one that did not end a statement
        // (with `;`, `{`, `}` or a label's `:`), continues that statement: it keeps its
        // indentation relative to the statement's first line, at least 4 more (an item
        // of a multi-line list after a `,` keeps its own). Mirrors the C++.
        // A block's `{` on its own line (`int f()` then `{`) starts at its block's level.
        int blockOpen = 0;
        if (tb[0] == 123 && fmt_top_block(&layout) == 1 && layout.paren == 0 && last != 61 && last != 44
            && last != 40 && last != 91) {
            blockOpen = 1;
        }
        int contLine = 0;
        if (tb[0] != 125 && blockOpen == 0
            && (layout.paren > 0 || (last != 0 && last != 59 && last != 123 && last != 125 && last != 58))) {
            contLine = 1;
        }
        int listItem = 0;
        if (last == 44 && layout.paren == 0) {
            listItem = 1;
        }
        let pieces: List<string>;
        List_init<string>(&pieces, 4);
        int has_nul = 0;
        int z = 0;
        while (z < tlen) {
            if (tb[z] == 0) {
                has_nul = 1;
            }
            z = z + 1;
        }
        if (has_nul == 0) {
            fmt_layout_line(&layout, tb, tlen, &last, &pieces);
        }
        else {     // a NUL byte: the line is left alone
            List_push<string>(&pieces, "");
        }
        int pi = 0;
        int sepPiece = 0;   // the previous piece of this line closed a top-level block
        while (pi < List_len<string>(&pieces)) {
            *uint8 pb = (*uint8)List_get<string>(&pieces, pi);
            int plen = 0;
            while (pb[plen] != 0) {
                plen = plen + 1;
            }
            if (has_nul == 1) {
                pb = tb;
                plen = tlen;
            }
            if (sepPiece == 1 && pb[0] != 125) {   // as for a definition ending a line
                fmt_eol(&out, crlf);
            }
            int ind = 0;
            if (pi == 0 && contLine == 1) {
                int diff = ts - stmtOrig;
                if (listItem == 1) {
                    if (diff < 0) {
                        diff = 0;
                    }
                }
                else {
                    if (diff < 4) {
                        diff = 4;
                    }
                }
                ind = stmtNew + diff;
            } else {
                int lead = depth;          // a statement's indent dedents for each leading '}'
                int k = 0;
                while (k < plen) {
                    if (pb[k] == 125) {
                        lead = lead - 1;
                        k = k + 1;
                    }
                    else {
                        k = plen;
                    }
                }
                if (lead < 0) {
                    lead = 0;
                }
                ind = lead * 4;
                stmtOrig = ts;
                stmtNew = ind;
            }
            fmt_scan(pb, plen, 0, &depth, &inBlock, &inStr);   // update nesting from this piece's code
            if (inStr == 0) {  // blanks inside an open string are its bytes
                plen = fmt_rtrim(pb, 0, plen);
            }
            int sp = 0;
            while (sp < ind) {
                String_push(&out, (char)32);
                sp = sp + 1;
            }
            int a = 0;
            while (a < plen) {
                String_push(&out, (char)pb[a]);
                a = a + 1;
            }
            fmt_eol(&out, crlf);
            sepPiece = 0;
            if (depth == 0 && pb[0] == 125) {
                sepPiece = 1;
            }
            pi = pi + 1;
        }
        int np = List_len<string>(&pieces);
        if (depth == 0 && List_get<string>(&pieces, np - 1)[0] == 125) {
            sepNext = 1;
        }
    }
    return out;
}

// ── `fmt --width N`: the wrap pass, a byte-for-byte mirror of the C++ wrapLongLines ──
// A code line longer than `width` bytes is broken after the commas of its outermost
// bracketed list (the commas at the smallest depth of `(`, `[` or `{` inside the line,
// at least 1): the pieces fill each line up to the width, and the lines after the
// first are indented 8 more than it. A resulting line that is still too long is broken
// the same way. A line with a comment, a directive, or one that starts or ends inside a
// string or a block comment is left as written.

// Append the bytes [a, b) of `s` to `out`.
void fmt_put(String* out, *uint8 s, int a, int b) {
    int i = a;
    while (i < b) {
        String_push(out, (char)s[i]);
        i = i + 1;
    }
}

// Break the line s[0, n) as wrapLine does, appending the resulting lines to `out`.
void fmt_wrap_line(*uint8 s, int n, int width, List<String>* out) {
    if (n <= width) {
        let keep: String;
        String_init(&keep, n + 1);
        fmt_put(&keep, s, 0, n);
        List_push<String>(out, keep);
        return;
    }
    int indent = 0;
    while (indent < n && (int)s[indent] == 32) {
        indent = indent + 1;
    }
    List<int> cpos;
    List_init<int>(&cpos, 8);
    List<int> cdep;
    List_init<int>(&cdep, 8);
    int depth = 0;
    int quote = 0;
    int i = indent;
    while (i < n) {
        int c = (int)s[i];
        if (quote != 0) {
            if (c == 92) {
                i = i + 1;
            } else if (c == quote) {
                quote = 0;
            }
        } else if (c == 34 || c == 39) {
            quote = c;
        } else if (c == 40 || c == 91 || c == 123) {
            depth = depth + 1;
        } else if (c == 41 || c == 93 || c == 125) {
            depth = depth - 1;
        } else if (c == 44 && depth >= 1) {
            List_push<int>(&cpos, i);
            List_push<int>(&cdep, depth);
        }
        i = i + 1;
    }
    int least = 0;
    for (k in 0..List_len<int>(&cdep)) {
        int d = List_get<int>(&cdep, k);
        if (least == 0 || d < least) {
            least = d;
        }
    }
    List<int> starts;
    List_init<int>(&starts, 8);
    List<int> ends;
    List_init<int>(&ends, 8);
    int start = 0;
    for (k in 0..List_len<int>(&cpos)) {
        if (List_get<int>(&cdep, k) != least) {
            continue;
        }
        List_push<int>(&starts, start);
        List_push<int>(&ends, List_get<int>(&cpos, k) + 1);
        start = List_get<int>(&cpos, k) + 1;
    }
    if (List_len<int>(&starts) == 0) {
        let keep: String;
        String_init(&keep, n + 1);
        fmt_put(&keep, s, 0, n);
        List_push<String>(out, keep);
        return;
    }
    List_push<int>(&starts, start);
    List_push<int>(&ends, n);
    List<String> lines;
    List_init<String>(&lines, 4);
    let cur: String;
    String_init(&cur, n + 1);
    fmt_put(&cur, s, List_get<int>(&starts, 0), List_get<int>(&ends, 0));
    for (k in 1..List_len<int>(&starts)) {
        int a = List_get<int>(&starts, k);
        int b = List_get<int>(&ends, k);
        while (a < b && (int)s[a] == 32) {
            a = a + 1;
        }
        if (a == b) {
            continue;
        }
        if ((int)cur.len + 1 + (b - a) <= width) {
            String_push(&cur, ' ');
            fmt_put(&cur, s, a, b);
        } else {
            List_push<String>(&lines, cur);
            let next: String;
            String_init(&next, n + 1);
            for (sp in 0..indent + 8) {
                String_push(&next, ' ');
            }
            fmt_put(&next, s, a, b);
            cur = next;
        }
    }
    List_push<String>(&lines, cur);
    if (List_len<String>(&lines) == 1) {
        let keep: String;
        String_init(&keep, n + 1);
        fmt_put(&keep, s, 0, n);
        List_push<String>(out, keep);
        return;
    }
    for (k in 0..List_len<String>(&lines)) {
        String l = List_get<String>(&lines, k);
        fmt_wrap_line((*uint8)String_cstr(&l), (int)l.len, width, out);
    }
}

String fmt_wrap(String* text, int width) {
    let out: String;
    String_init(&out, (int)text.len + 64);
    *uint8 t = (*uint8)String_cstr(text);
    int tn = (int)text.len;
    int in_block = 0;
    int quote = 0;
    int pos = 0;
    while (pos < tn) {
        int e = pos;
        while (e < tn && (int)t[e] != 10) {
            e = e + 1;
        }
        int has_nl = e < tn ? 1 : 0;
        int plain = in_block == 0 && quote == 0 ? 1 : 0;
        int comment = 0;
        int i = pos;
        while (i < e) {
            int c = (int)t[i];
            int nx = i + 1 < e ? (int)t[i + 1] : 0;
            if (in_block == 1) {
                if (c == 42 && nx == 47) {
                    in_block = 0;
                    i = i + 1;
                }
            } else if (quote != 0) {
                if (c == 92) {
                    i = i + 1;
                } else if (c == quote) {
                    quote = 0;
                }
            } else if (c == 47 && nx == 47) {
                comment = 1;
                break;
            } else if (c == 47 && nx == 42) {
                in_block = 1;
                comment = 1;
                i = i + 1;
            } else if (c == 34 || c == 39) {
                quote = c;
            }
            i = i + 1;
        }
        if (quote == 39) {
            quote = 0;
        }
        int first = pos;
        while (first < e && (int)t[first] == 32) {
            first = first + 1;
        }
        int directive = first < e && (int)t[first] == 35 ? 1 : 0;
        if (plain == 1 && comment == 0 && directive == 0 && in_block == 0 && quote == 0 && e - pos > width) {
            List<String> parts;
            List_init<String>(&parts, 4);
            fmt_wrap_line((*uint8)((*uint8)t + pos), e - pos, width, &parts);
            for (k in 0..List_len<String>(&parts)) {
                String p = List_get<String>(&parts, k);
                String_append(&out, String_cstr(&p));
                if (k + 1 < List_len<String>(&parts)) {
                    String_push(&out, '\n');
                }
            }
        } else {
            fmt_put(&out, t, pos, e);
        }
        if (has_nl == 1) {
            String_push(&out, '\n');
            pos = e + 1;
        } else {
            pos = e;
        }
    }
    return out;
}
