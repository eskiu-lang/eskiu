// Self-hosted text preprocessor — a port of lexer/preprocessor.cpp. Runs before the
// lexer: object- and function-like #define/#undef, #ifdef/#ifndef/#else/#endif
// conditionals, #pragma passthrough, #error, backslash line splicing, and the
// predefined __FILE__/__LINE__ macros. Directive and inactive lines become blank
// lines so source line numbers are preserved. Substitution is identifier-aware
// (skips string/char literals and // comments) and recursive (a macro is not
// re-expanded within its own expansion).
//
// Parity target: the C++ `--test-lexer`, which preprocesses like a real build: the
// predefined host OS macro (`__APPLE__`/`__linux__`, value 1) and `__FILE__` = the path.

import <string>;
import <list>;
import <mem>;

// Host OS macro to predefine for real compilation (set by the compiler driver per host;
// null/"" for the lexer-parity driver). See pp_run.
string g_pp_os;
string g_pp_arch;   // host architecture macro (__aarch64__ / __x86_64__), set like g_pp_os

// Further predefined macros (value 1) for real compilation, e.g. _WIN64 or
// __ESKIU_FREESTANDING__ (the C++ seedPredefinedMacros). Set by the driver.
List<string> g_pp_predef;

struct PPMacro {
    string name;
    int is_function;
    List<string> params;
    string body;
    string file;    // where it was #defined ("": predefined)
    int line;
}

struct PPCond {
    int parent;     // was the enclosing scope active when this #if was opened?
    int branch;     // is the current branch (then/elif/else) taken?
    int taken;      // has some branch of this #if chain already been selected?
    int saw_else;   // has the #else been seen?
    int line;       // where the opening #if/#ifdef/#ifndef is (for "missing #endif")
    int col;
}

extern int64 write(int fd, *void buf, int64 n);

// Report a located preprocessor error on stderr (mirrors the C++ ppError).
void pp_error(string file, int line, int col, string msg, *int had_err) {
    String m;
    String_init(&m, 64);
    String_append(&m, "error: ");
    if (file[0] == 0) {
        String_append(&m, "<input>");
    } else {
        String_append(&m, file);
    }
    String num;
    String_init(&num, 12);
    String_from_int(&num, line);
    String_append(&m, ":");
    String_append(&m, (string)String_cstr(&num));
    String_from_int(&num, col);
    String_append(&m, ":");
    String_append(&m, (string)String_cstr(&num));
    String_append(&m, ": ");
    String_append(&m, msg);
    String_append(&m, "\n");
    write(2, (*void)String_cstr(&m), (int64)String_len(&m));
    had_err[0] = 1;
}

// ── small char / string helpers (pp_-prefixed to avoid clashing with the lexer) ──

int pp_is_alpha(int c) {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95) {
        return 1;
    }
    return 0;
}

int pp_is_alnum(int c) {
    if (pp_is_alpha(c) == 1) {
        return 1;
    }
    if (c >= 48 && c <= 57) {
        return 1;
    }
    return 0;
}

int pp_is_sp(int c) {
    if (c == 32 || c == 9) {
        return 1;
    }
    return 0;
}

int pp_clen(string s) {
    int i = 0;
    while (s[i] != 0) {
        i = i + 1;
    }
    return i;
}

int pp_eq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    if (a[i] == b[i]) {
        return 1;
    }
    return 0;
}

// Owned NUL-terminated substring s[start, start+count).
string pp_sub(string s, int start, int count) {
    *uint8 buf = alloc<uint8>(count + 1);
    int i = 0;
    while (i < count) {
        buf[i] = (uint8)s[start + i];
        i = i + 1;
    }
    buf[count] = 0;
    return (string)buf;
}

// Trim leading/trailing spaces and tabs (mirrors ppTrim).
string pp_trim(string s) {
    int n = pp_clen(s);
    int a = 0;
    while (a < n && pp_is_sp((int)s[a]) == 1) {
        a = a + 1;
    }
    if (a >= n) {
        return "";
    }
    int b = n - 1;
    while (b > a && pp_is_sp((int)s[b]) == 1) {
        b = b - 1;
    }
    return pp_sub(s, a, b - a + 1);
}

// Drop the last character of a String (no String_pop in the stdlib).
void pp_pop(String* s) {
    if (s.len > 0) {
        s.len = s.len - 1;
        s.data[s.len] = 0;
    }
}

// ── macro table (push-only List; redefine via set, #undef via remove) ──

int pp_find(List<PPMacro>* tbl, string name) {
    int i = 0;
    int n = List_len<PPMacro>(tbl);
    while (i < n) {
        if (pp_eq(List_get<PPMacro>(tbl, i).name, name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

void pp_define(List<PPMacro>* tbl, PPMacro m) {
    int idx = pp_find(tbl, m.name);
    if (idx >= 0) {
        List_set<PPMacro>(tbl, idx, m);
    }
    else {
        List_push<PPMacro>(tbl, m);
    }
}

void pp_undef(List<PPMacro>* tbl, string name) {
    int idx = pp_find(tbl, name);
    if (idx >= 0) {
        List_remove<PPMacro>(tbl, idx);
    }
}

int pp_defined(List<PPMacro>* tbl, string name) {
    if (pp_find(tbl, name) >= 0) {
        return 1;
    }
    return 0;
}

int pp_in_set(List<string>* set, string id) {
    int i = 0;
    int n = List_len<string>(set);
    while (i < n) {
        if (pp_eq(List_get<string>(set, i), id) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ── expansion ──

// Replace each parameter name in a function-like macro body with its argument
// (mirrors ppSubstParams; literal-aware, no expansion). Stops once the result is
// longer than `cap` bytes.
string pp_subst_params(string body, List<string>* params, List<string>* args, int64 cap) {
    String out;
    String_init(&out, pp_clen(body) + 16);
    int n = pp_clen(body);
    int i = 0;
    while (i < n) {
        int c = (int)body[i];
        if (c == 34 || c == 39) {                 // " or ' — copy literal verbatim
            int q = c;
            String_push(&out, (char)c);
            i = i + 1;
            while (i < n) {
                if ((int)body[i] == 92 && i + 1 < n) {
                    String_push(&out, (char)body[i]);
                    String_push(&out, (char)body[i + 1]);
                    i = i + 2;
                    continue;
                }
                String_push(&out, (char)body[i]);
                if ((int)body[i] == q) {
                    i = i + 1;
                    break;
                }
                i = i + 1;
            }
            continue;
        }
        if (pp_is_alpha(c) == 1) {
            int j = i;
            while (j < n && pp_is_alnum((int)body[j]) == 1) {
                j = j + 1;
            }
            string id = pp_sub(body, i, j - i);
            int pi = 0;
            int pn = List_len<string>(params);
            int found = 0 - 1;
            while (pi < pn) {
                if (pp_eq(List_get<string>(params, pi), id) == 1) {
                    found = pi;
                }
                pi = pi + 1;
            }
            if (found >= 0 && found < List_len<string>(args)) {
                String_append(&out, List_get<string>(args, found));
            } else {
                String_append(&out, id);
            }
            i = j;
            if ((int64)String_len(&out) > cap) {
                break;
            }
            continue;
        }
        String_push(&out, (char)c);
        i = i + 1;
    }
    return (string)String_cstr(&out);
}

// Copy the string/char literal starting at text[i] (the opening quote) onto `out`;
// returns the index just past the closing quote (mirrors ppCopyLiteral).
int pp_copy_lit(string text, int i, int n, String* out) {
    int q = (int)text[i];
    String_push(out, (char)q);
    i = i + 1;
    while (i < n) {
        if ((int)text[i] == 92 && i + 1 < n) {
            String_push(out, (char)text[i]);
            String_push(out, (char)text[i + 1]);
            i = i + 2;
            continue;
        }
        String_push(out, (char)text[i]);
        if ((int)text[i] == q) {
            i = i + 1;
            break;
        }
        i = i + 1;
    }
    return i;
}

// The macro replacement text one file may produce in all (mirrors
// kMaxMacroExpansion): each object-like body and each substituted function-like
// body counts its bytes.
const int64 PP_MAX_MACRO_EXPANSION = 16777216;

// The budget of one preprocessed file (mirrors PPBudget). Once spent, no macro
// expands any more and the first expansion over it is reported.
struct PPBudget {
    int64 used;
    int hit;
    int reported;
    int col;
}

string pp_budget_message() {
    return pp_cat(pp_cat("macro expansion exceeds ", pp_itoa((int)PP_MAX_MACRO_EXPANSION)),
                  " bytes of replacement text in this file");
}

// Error state shared by one top-level pp_expand call and its nested expansions
// (mirrors PPExpandCtx): the first malformed macro invocation and the column of the
// top-level token whose expansion produced it.
struct PPCtx {
    string err;      // "" = none
    int err_col;
    int top_col;
    int depth;
    int open_call;   // an unterminated call at the top level (its args continue on the next line)
    int trailing_fn; // a function-like macro name ends the top-level text: its `(` may start a later line
    PPBudget* budget; // the file's macro budget, or null
    // The top-level macro uses replaced in this text (PPExpandCtx::uses): output offset
    // and length, source offset, name, replacement, and where the macro was defined.
    List<int> u_out;
    List<int> u_len;
    List<int> u_src;
    List<string> u_name;
    List<string> u_text;
    List<string> u_file;
    List<int> u_line;
}

void pp_ctx_uses_init(PPCtx* c) {
    List_init<int>(&c.u_out, 2);
    List_init<int>(&c.u_len, 2);
    List_init<int>(&c.u_src, 2);
    List_init<string>(&c.u_name, 2);
    List_init<string>(&c.u_text, 2);
    List_init<string>(&c.u_file, 2);
    List_init<int>(&c.u_line, 2);
}

void pp_ctx_init(PPCtx* c) {
    c.err = "";
    c.err_col = 0;
    c.top_col = 0;
    c.depth = 0;
    c.open_call = 0;
    c.trailing_fn = 0;
    c.budget = null;
    pp_ctx_uses_init(c);
}

// Count `k` more bytes of replacement text (mirrors the C++ `charge`): 0, and the
// budget is spent, when they do not fit.
int pp_charge(PPCtx* ctx, int64 k) {
    PPBudget* b = ctx.budget;
    if (b == null) {
        return 1;
    }
    if (b.hit == 1) {
        return 0;
    }
    if (k > PP_MAX_MACRO_EXPANSION - b.used) {
        b.hit = 1;
        b.col = ctx.top_col;
        return 0;
    }
    b.used = b.used + k;
    return 1;
}

void pp_ctx_fail(PPCtx* c, string msg) {
    if (c.err[0] == 0) {
        c.err = msg;
        c.err_col = c.top_col;
    }
}

// Skip spaces, tabs and closed `/* */` comments on one line from p (mirrors ppSkipBlank).
int pp_skip_blank(string s, int p, int n) {
    while (p < n) {
        int c = (int)s[p];
        if (c == 32 || c == 9) {
            p = p + 1;
            continue;
        }
        if (c == 47 && p + 1 < n && (int)s[p + 1] == 42) {
            int e = p + 2;
            while (e + 1 < n && ((int)s[e] != 42 || (int)s[e + 1] != 47)) {
                e = e + 1;
            }
            if (e + 1 >= n) {
                return p;
            }
            p = e + 2;
            continue;
        }
        return p;
    }
    return p;
}

// Like pp_skip_blank, but also across newlines and `//` comments (mirrors ppSkipBlankNL).
int pp_skip_blank_nl(string s, int p, int n) {
    while (p < n) {
        p = pp_skip_blank(s, p, n);
        if (p < n && (int)s[p] == 10) {
            p = p + 1;
            continue;
        }
        if (p + 1 < n && (int)s[p] == 47 && (int)s[p + 1] == 47) {
            while (p < n && (int)s[p] != 10) {
                p = p + 1;
            }
            if (p >= n) {
                return n;
            }
            p = p + 1;
            continue;
        }
        return p;
    }
    return p;
}

// Does the next source line with code, from src[i] (past blank and comment-only lines),
// begin with `(`? Reads ahead without consuming (mirrors ppNextCodeIsParen).
int pp_next_code_is_paren(string src, int i, int len) {
    int lines = 0;
    while (i < len && lines < 1000) {
        int e = i;
        while (e < len && (int)src[e] != 10) {
            e = e + 1;
        }
        int le = e;
        if (le > i && (int)src[le - 1] == 13) {
            le = le - 1;
        }
        int p = pp_skip_blank(src, i, le);
        int cmt = 0;
        if (p + 1 < le && (int)src[p] == 47 && (int)src[p + 1] == 47) {
            cmt = 1;
        }
        if (p < le && cmt == 0) {
            if ((int)src[p] == 40) {
                return 1;
            }
            return 0;
        }
        i = e + 1;
        lines = lines + 1;
    }
    return 0;
}

string pp_itoa(int v) {
    String s;
    String_init(&s, 12);
    String_from_int(&s, v);
    return (string)String_cstr(&s);
}

// The macro uses replaced in each file (mirrors PPExpansion / ppExpansionAt): where the
// replacement sits in the expanded text, the use's source column, the macro and where it
// was defined, so a parse error at a token a macro produced can name the macro.
List<string> g_ppx_file;
List<int> g_ppx_line;
List<int> g_ppx_col;
List<int> g_ppx_len;
List<int> g_ppx_src;
List<string> g_ppx_name;
List<string> g_ppx_text;
List<string> g_ppx_def_file;
List<int> g_ppx_def_line;
int g_ppx_ready;

// Forget the uses recorded for `file` (it is preprocessed again).
void ppx_clear(string file) {
    if (g_ppx_ready == 0) {
        g_ppx_ready = 1;
        List_init<string>(&g_ppx_file, 16);
        List_init<int>(&g_ppx_line, 16);
        List_init<int>(&g_ppx_col, 16);
        List_init<int>(&g_ppx_len, 16);
        List_init<int>(&g_ppx_src, 16);
        List_init<string>(&g_ppx_name, 16);
        List_init<string>(&g_ppx_text, 16);
        List_init<string>(&g_ppx_def_file, 16);
        List_init<int>(&g_ppx_def_line, 16);
    }
    for (k in 0..List_len<string>(&g_ppx_file)) {
        if (pp_eq(List_get<string>(&g_ppx_file, k), file) == 1) {
            List_set<string>(&g_ppx_file, k, "");
        }
    }
}

// The recorded use of `file` that produced the text at line:col, or -1.
int ppx_at(string file, int line, int col) {
    if (g_ppx_ready == 0) {
        return 0 - 1;
    }
    for (k in 0..List_len<string>(&g_ppx_file)) {
        int c0 = List_get<int>(&g_ppx_col, k);
        if (List_get<int>(&g_ppx_line, k) == line && col >= c0 && col < c0 + List_get<int>(&g_ppx_len, k)
            && pp_eq(List_get<string>(&g_ppx_file, k), file) == 1) {
            return k;
        }
    }
    return 0 - 1;
}

// Line and column of offset `pos` in `text`, which starts at line0:col0 (ppLineCol).
void ppx_line_col(string text, int pos, int line0, int col0, *int line, *int col) {
    line[0] = line0;
    col[0] = col0 + pos;
    int k = 0;
    while (k < pos && text[k] != 0) {
        if ((int)text[k] == 10) {
            line[0] = line[0] + 1;
            col[0] = pos - k;
        }
        k = k + 1;
    }
}

// Record the uses `ctx` collected for a line of `file` whose expansion is `expanded`
// (at line_no, after `lead` bytes) and whose source text is `src`, then clear them.
void ppx_record(PPCtx* ctx, string file, int line_no, int lead, string expanded, int out0, string src, int src0) {
    for (k in 0..List_len<int>(&ctx.u_out)) {
        int ol = 0;
        int oc = 0;
        int sl = 0;
        int sc = 0;
        ppx_line_col(expanded, out0 + List_get<int>(&ctx.u_out, k), line_no, lead + 1, &ol, &oc);
        ppx_line_col(src, src0 + List_get<int>(&ctx.u_src, k), line_no, lead + 1, &sl, &sc);
        if (sl == ol) {   // a call spanning lines has no single place
            List_push<string>(&g_ppx_file, file);
            List_push<int>(&g_ppx_line, ol);
            List_push<int>(&g_ppx_col, oc);
            List_push<int>(&g_ppx_len, List_get<int>(&ctx.u_len, k));
            List_push<int>(&g_ppx_src, sc);
            List_push<string>(&g_ppx_name, List_get<string>(&ctx.u_name, k));
            List_push<string>(&g_ppx_text, pp_trim(List_get<string>(&ctx.u_text, k)));
            List_push<string>(&g_ppx_def_file, List_get<string>(&ctx.u_file, k));
            List_push<int>(&g_ppx_def_line, List_get<int>(&ctx.u_line, k));
        }
    }
    pp_ctx_uses_init(ctx);
}

// The rest of preprocessor.esk, in these parts (imported in order):
import "preprocessor_expand.esk";
import "preprocessor_if.esk";
import "preprocessor_cond.esk";
import "preprocessor_run.esk";
