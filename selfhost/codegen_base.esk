// Part of codegen.esk (state, target and emission helpers), imported from it in order; compile codegen.esk, not this file alone.

import <io>;
import <string>;
import <list>;
import <mem>;
import "ast.esk";

// libc: parse a decimal string to double, for f32 constant-folding in global inits.
extern double atof(string s);
extern void exit(int code);

// An evaluated expression: LLVM operand text, LLVM type, and the Eskiu type spelling
// (needed to resolve struct layouts / pointer depth, which the LLVM type loses).
struct CgVal {
    string op;
    string ty;
    string ety;
}

// A local binding: source name → its alloca slot + LLVM type + Eskiu type.
struct CgLocal {
    string name;
    string slot;
    string ty;
    string ety;
}

// A function's LLVM return type + (for variadic externs) its call-type prefix.
struct CgFn {
    string name;
    string retty;
    string rety;
    int variadic;
    string fixedtypes;
    List<string> ptys;
    List<string> petys;
    string cret;   // a C result narrower than int64: "z" (zero-extend) or "s"
}

// An interface: method order (names) + each method's Eskiu return type, parallel by index.
// An interface value is a fat pointer {data, vtable}; dispatch loads the method ptr from
// the vtable slot at the method's index.
struct CgIface {
    string name;
    List<string> mnames;
    List<string> mrets;
    List<List<string>> mparams;
}

// A struct's field layout: parallel field names + Eskiu types (index = GEP index).
struct CgStruct {
    string name;
    List<string> fnames;
    List<string> fetys;
}

// A plain (integer) enum constant: name → its integer value as a string.
struct CgEnumC {
    string name;
    string val;
}

// A folded compile-time constant scalar (a global initializer): ok = foldable; isf =
// floating (value in dv, w = 32 or 64) vs integer (value in iv, sign- or zero-extended
// from its w bits by uns, so it is always the value its C type holds).
struct CgK {
    int ok;
    int isf;
    int64 iv;
    double dv;
    int w;
    int uns;
}

// A folded top-level `const` that is not a signed int (uint32, int64, float, ...), by name,
// in its declared type, so a later constant initializer can use it (int consts live in
// econsts).
struct CgFK {
    string name;
    CgK k;
}

// An ADT enum variant: its name, owning enum, integer tag, and payload field types.
struct CgVariant {
    string vname;
    string ename;
    int tag;
    List<string> ptys;
}

// A bitfield slot: which struct/field, the LLVM word it lives in (field index), its bit
// offset + width within that word, whether the field is signed (→ sign-extend on read),
// the storage word's LLVM integer type (the field's declared type, e.g. "i8"), and the
// field's Eskiu type (so a read carries its signedness). Under the C (non-MS) layout a
// field is addressed by byte offset `boffs` (-1 = struct element `fidx`) and a bitfield's
// word is read as `aty` (its declared type, or the byte span in a packed struct) with
// alignment `aal` (0 = natural).
struct CgBF {
    string sname;
    string fname;
    int fidx;
    int boff;
    int bw;
    int sgn;
    string sty;
    string fety;
    int boffs;
    string aty;
    int aal;
}

// C ABI lowering (see cg_abi_classify). A scalar leaf of a flattened aggregate: byte
// offset + LLVM type. A classified param/return: kind 0 direct, 1 coerce (one value of
// `ty`), 2 expand (two args `ty`, `ty2`), 3 indirect (pointer to a caller copy), 4 byval,
// 5 sret, 6 expand into the scalars listed in `ty` (`i32, double`, 32-bit x86); `ty` is the aggregate's LLVM type for 3-5, `align` their alignment, `salign`
// an `alignstack` for a coerced arg (0 = none), `off` the byte offset of a coerced value in
// the aggregate (x86-64: an all-padding low eightbyte). A lowered extern: its
// classification plus the lowered return / fixed-param types (the declared C signature).
struct CgLeaf {
    int off;
    string ty;
}

struct CgAbi {
    int kind;
    string ty;
    string ty2;
    int align;
    int salign;
    int off;
}

// A byte range [off, end) an unnamed bitfield of struct/union `sname` counts as data for
// the x86-64 register widths (C++ CodeGen::unnamedBitData; off == end: none in the type).
struct CgUData {
    string sname;
    int off;
    int end;
}

struct CgCabi {
    string name;
    CgAbi ret;
    List<CgAbi> params;
    string lowret;
    string lowfixed;
}

// A queued lambda: its unique name, the AST node (signature in .sval, body in .stmt),
// and its captured outer variables (parallel name/Eskiu-type lists).
// One active type-parameter substitution (T → concrete) during instantiation.
struct CgSub {
    string param;
    string arg;
}

struct CgLambda {
    string name;
    *ExprNode node;
    string rety;
    List<string> capn;
    List<string> capt;
    List<CgSub> sub;
    List<CgLocal> statics;
}

// A pending monomorphization: the generic decl + concrete type args + mangled name.
// is_struct 2 = an inline method of a generic struct instance: `owner` is the generic
// struct (its type params bind `args`), `self_sp` the instance spelling ("Box<int>").
struct CgInst {
    *DeclNode decl;
    string mangled;
    int is_struct;
    List<string> args;
    *DeclNode owner;
    string self_sp;
}

struct Codegen {
    String out;
    String globals;      // module-top: extern declares + string-literal constants
    int next;            // SSA temp / slot / label counter
    int strcount;        // string-literal global counter
    string cur_ret;      // current function's LLVM return type
    string cur_rety;     // current function's Eskiu return type (interface boxing on return)
    List<CgLocal> locals;
    int terminated;      // is the current basic block already terminated?
    List<string> loop_cont;  // continue targets (innermost last)
    List<string> loop_end;   // break targets
    List<*StmtNode> cleanups; // scope-exit cleanup bodies (defer + a try's finally), LIFO
    List<int> cl_err;        // parallel to cleanups: 1 = errdefer (error-path only), 0 = defer/finally
    List<int> cl_nloc;       // parallel to cleanups: how many locals were visible when it was registered
    List<int> loop_cldepth;  // cleanups-stack length at each loop entry (parallel to loop_end)
    // Loops-only frame stack for labeled break/continue (a `switch` never pushes here, unlike
    // loop_end above). The four lists are parallel: label / break block / continue block /
    // cleanup depth. `break label` / `continue label` scan loop_lbls top-down for the name.
    List<string> loop_lbls;    // label for each real loop ("" = unlabeled)
    List<string> loop_lbl_end;
    List<string> loop_lbl_cont;
    List<int> loop_lbl_cld;
    List<CgFn> fns;          // function → return type / variadic signature
    List<CgStruct> structs;  // struct name → field layout
    List<CgEnumC> econsts;   // plain-enum constants → value
    List<CgFK> fconsts;      // top-level non-i32 `const` values (for constant folding)
    List<string> enum_names; // enum type names (lower to i32)
    List<string> enum_uns;   // plain enums with no negative member (an unsigned bitfield, as in C)
    List<CgVariant> variants; // ADT enum variants (by name)
    List<string> adt_names;  // ADT enum type names (lower to %Name, a tagged union)
    List<string> union_names; // union type names (all members overlap at offset 0)
    List<CgIface> ifaces;    // interfaces (name → method order + return types)
    int uses_iface;          // any interface declared → emit the shared %iface_fat type once
    List<CgSub> aliases;     // type aliases (name → underlying type spelling)
    List<string> fnthunks;   // top-level fns used as closure values → emit a __fnptr_<name> thunk
    List<string> topfns;     // non-generic top-level function names (a global initializer may name one)
    List<CgSub> opcanon;     // operator overloads declared over an alias: dealiased mangled name → fn name
    List<CgBF> bitfields;    // bitfield slots (struct.field → word/offset/width/signed) + pack(N≥2) phys-index slots
    List<CgLambda> lambdas;  // queued lambda bodies, emitted after the main decls
    int lam_seq;             // counter for unique lambda names
    string lam_expret;       // return type expected from a lambda's assignment context ("" = none)
    *ExprNode tern_node;     // a `?:` bound for an interface: each arm boxes into tern_iface
    string tern_iface;
    int uses_eh;             // program uses try/throw → declare the Itanium EH runtime
    int uses_throw;          // program throws → install the uncaught-exception reporter
    int uses_ex_text;        // program calls exception_text() → emit @__eskiu_exception_text
    List<string> catch_text; // per enclosing catch handler: entry alloca holding exception_text()
    int uses_threads;        // program calls thread_create → the driver links pthread
    int uses_heap_env;       // a closure heap-allocated its env → ensure malloc is declared
    int safe;                // --safe[=LIST]: run-time checks, 1 bounds | 2 overflow | 4 null
    int freestanding;        // --freestanding: closure envs use esk_alloc/esk_free, not malloc/free
    int fp_contract;         // -ffp-contract=fast: fadd/fsub/fmul carry `contract` (C++ fpContract)
    int no_split;            // folding a byte image: arrays keep their `[N x T]` constant form
    string split_union_top;  // the LLVM type of the global being folded (C++ splitUnionTop)
    int uses_trap;           // a bounds check was emitted → declare @llvm.trap once
    string cur_unwind;       // active landingpad label inside a try body ("" = plain calls)
    string cur_lbl;          // label of the basic block being emitted (for phi incoming edges)
    // Defers on the exceptional path (mirrors CodeGen::emitDeferPad). In a program that
    // throws (prog_eh), each defer gets a landingpad for the calls after it. cl_unw is
    // parallel to cleanups: the landingpad active before that cleanup was registered. The
    // try_* lists are parallel, one entry per try body being emitted: its cleanup depth,
    // its catch-dispatch label, and the extra phi incoming edges from body defer pads.
    int prog_eh;
    List<string> cl_unw;
    List<int> try_cld;
    List<string> try_disp;
    List<string> try_phi;
    List<CgLocal> gvars;     // global variables (slot = "@name", a pointer to storage)
    List<*DeclNode> gstructs; // generic struct decls (by name, type_params non-empty)
    List<*DeclNode> genums;  // generic ADT enum decls (monomorphized on demand)
    List<CgVariant> gvariants; // generic variant patterns (ename = generic enum name; ptys carry type params)
    List<*DeclNode> gfns;     // generic function decls
    List<CgSub> cursub;      // active T→concrete substitution during instantiation
    List<string> inst_seen;  // mangled names already queued/emitted (dedup)
    List<CgInst> worklist;   // pending monomorphizations
    int wl_i;                // persistent drain cursors: worklist / lambdas / thunks
    int lam_i;
    int thk_i;
    String entry_buf;        // local allocas for the fn/lambda being emitted, hoisted to entry
    string bf_vol;           // "volatile " while a bitfield access goes through a volatile root
    List<CgSub> tydefs;      // emitted named LLVM types: name (no '%') → body text ("{ i32, ptr }")
    List<CgSub> caligns;     // C alignment (decimal) of a named type LLVM sees as less aligned
    List<CgUData> udata;     // unnamed bitfields' data ranges per struct/union (C ABI)
    List<string> unnamed_tys;   // structs/unions with an unnamed bitfield
    List<string> nonhomog;   // structs/unions holding a nonzero unnamed bitfield: no HFA (C ABI)
    List<*DeclNode> tydecls; // non-generic struct/union/ADT decls whose type line is emitted on demand
    int abi;                 // target C ABI: 0 none, 1 AArch64 Darwin, 2 AArch64 AAPCS64, 3 x86-64 SysV,
    // 4 Windows x64, 5 32-bit ARM AAPCS (soft-float), 6 ARM AAPCS-VFP (hard-float)
    int ptrsz;               // pointer size in bytes (4 on 32-bit ARM and x86)
    int i64al;               // ABI alignment of i64 and double (4 on 32-bit x86 SysV, else 8)
    int msbf;                // 1: MS bitfield layout (Windows targets), else SysV/AAPCS
    int bfal;                // 1: an unnamed bitfield raises its struct's alignment (AAPCS)
    int msvc;                // 1: MSVC (not mingw): a `: 0` under pack(N) is aligned to at most N
    int wintgt;              // 1: a Windows target (mingw SEH exception personality)
    int darwin;              // 1: a Darwin target (stderr is `__stderrp`)
    int emscripten;          // 1: emscripten (its runtime hands the thrown object to a landingpad)
    int bigend;              // 1: a big-endian AArch64 target (aarch64_be)
    int x86ri;               // 32-bit x86: a small aggregate result comes back in registers
    int x86ws;               // 32-bit x86: MSVC's struct rules (no float/double-in-ST0 result)
    List<CgCabi> cabis;      // externs declared with a C-ABI-lowered signature
    int mstamp;              // member-chain type stamps handed out so far (see cg_chain_begin)
    int mactive;             // the stamp of the member chain being emitted (0 = none)
    int tactive;             // the stamp of the `?:` tree being emitted (0 = none, see cg_tern_begin)
    int bactive;             // the stamp of the binary expression being emitted (0 = none)
    List<string> vols;       // names of `volatile` variables (C++ volatileVars)
    // Name indexes over the lists above (NameIdx, ast.esk), kept in step with every push
    // (the cg_push_* helpers), so a lookup by name does not scan the list.
    NameIdx fns_ix;
    NameIdx structs_ix;
    NameIdx inst_ix;
    NameIdx tydefs_ix;
    NameIdx tydecls_ix;
    NameIdx gstructs_ix;
    NameIdx gfns_ix;
    NameIdx genums_ix;
    NameIdx locals_ix;
    NameIdx gvars_ix;
    NameIdx econsts_ix;
    NameIdx fconsts_ix;
    NameIdx adt_ix;
    NameIdx union_ix;
    NameIdx enum_ix;
    NameIdx variants_ix;
    NameIdx gvariants_ix;
    NameIdx ifaces_ix;
    NameIdx topfns_ix;
}

void cg_push_fn(Codegen* g, CgFn f) {
    List_push<CgFn>(&g.fns, f);
    NameIdx_push(&g.fns_ix, f.name);
}

void cg_push_struct(Codegen* g, CgStruct st) {
    List_push<CgStruct>(&g.structs, st);
    NameIdx_push(&g.structs_ix, st.name);
}

void cg_push_inst(Codegen* g, string k) {
    List_push<string>(&g.inst_seen, k);
    NameIdx_push(&g.inst_ix, k);
}

void cg_push_tydecl(Codegen* g, *DeclNode d) {
    List_push<*DeclNode>(&g.tydecls, d);
    NameIdx_push(&g.tydecls_ix, d.name);
}

void cg_push_gstruct(Codegen* g, *DeclNode d) {
    List_push<*DeclNode>(&g.gstructs, d);
    NameIdx_push(&g.gstructs_ix, d.name);
}

void cg_push_gfn(Codegen* g, *DeclNode d) {
    List_push<*DeclNode>(&g.gfns, d);
    NameIdx_push(&g.gfns_ix, d.name);
}

void cg_push_local(Codegen* g, CgLocal l) {
    List_push<CgLocal>(&g.locals, l);
    NameIdx_push(&g.locals_ix, l.name);
}

void cg_push_genum(Codegen* g, *DeclNode d) {
    List_push<*DeclNode>(&g.genums, d);
    NameIdx_push(&g.genums_ix, d.name);
}

int cg_streq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    if (a[i] == b[i]) {
        return 1;
    }
    return 0;
}

string cg_cat(string a, string b) {
    int la = 0;
    while (a[la] != 0) {
        la = la + 1;
    }
    int lb = 0;
    while (b[lb] != 0) {
        lb = lb + 1;
    }
    *uint8 buf = alloc<uint8>(la + lb + 1);
    int i = 0;
    while (i < la) {
        buf[i] = (uint8)a[i];
        i = i + 1;
    }
    int j = 0;
    while (j < lb) {
        buf[la + j] = (uint8)b[j];
        j = j + 1;
    }
    buf[la + lb] = 0;
    return (string)buf;
}

string cg_sub_str(string s, int a, int b) {
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0;
    while (k < len) {
        buf[k] = (uint8)s[a + k];
        k = k + 1;
    }
    buf[len] = 0;
    return (string)buf;
}

string cg_itoa(int n) {
    if (n == 0) {
        return "0";
    }
    int neg = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    *uint8 tmp = alloc<uint8>(16);
    int len = 0;
    while (n > 0) {
        tmp[len] = (uint8)(48 + (n % 10));
        n = n / 10;
        len = len + 1;
    }
    int total = len;
    if (neg == 1) {
        total = total + 1;
    }
    *uint8 buf = alloc<uint8>(total + 1);
    int off = 0;
    if (neg == 1) {
        buf[0] = 45;
        off = 1;
    }
    int i = 0;
    while (i < len) {
        buf[off + i] = tmp[len - 1 - i];
        i = i + 1;
    }
    buf[total] = 0;
    return (string)buf;
}

// Is `s` a non-empty run of decimal digits?
int cg_all_digits(string s) {
    if (s[0] == 0) {
        return 0;
    }
    int i = 0;
    while (s[i] != 0) {
        if ((int)s[i] < 48 || (int)s[i] > 57) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// Format a uint64 as a decimal string (cg_itoa is i32-only).
string cg_u64toa(uint64 n) {
    if (n == 0) {
        return "0";
    }
    *uint8 tmp = alloc<uint8>(24);
    int len = 0;
    while (n > 0) {
        tmp[len] = (uint8)(48 + (int)(n % 10));
        n = n / 10;
        len = len + 1;
    }
    *uint8 buf = alloc<uint8>(len + 1);
    int i = 0;
    while (i < len) {
        buf[i] = tmp[len - 1 - i];
        i = i + 1;
    }
    buf[len] = 0;
    return (string)buf;
}

// Parse an integer literal (decimal, 0x/0X hex, or leading-0 octal) to its
// uint64 magnitude, ignoring any leading '-'. LLVM textual IR only accepts
// decimal integer constants, so callers re-render this via cg_u64toa.
uint64 cg_int_lit_mag(string s) {
    int k = 0;
    if (s[k] == 45) {                          // skip '-'
        k = 1;
    }
    let mag: uint64 = 0;
    if (s[k] == 48 && (s[k + 1] == 120 || s[k + 1] == 88)) {   // 0x / 0X hex
        k = k + 2;
        while (s[k] != 0) {
            int c = (int)s[k];
            int d = 0;
            if (c >= 48 && c <= 57) {
                d = c - 48;
            }
            else if (c >= 97 && c <= 102) {
                d = c - 97 + 10;
            }
            else if (c >= 65 && c <= 70) {
                d = c - 65 + 10;
            }
            mag = mag * 16 + (uint64)d;
            k = k + 1;
        }
        return mag;
    }
    if (s[k] == 48 && s[k + 1] != 0) {                  // leading 0 -> octal
        k = k + 1;
        while (s[k] != 0) {
            mag = mag * 8 + (uint64)((int)s[k] - 48);
            k = k + 1;
        }
        return mag;
    }
    while (s[k] != 0) {   // decimal
        mag = mag * 10 + (uint64)((int)s[k] - 48);
        k = k + 1;
    }
    return mag;
}

void cg_init(Codegen* g) {
    // Start from all zeros: every field (a List a later change forgets to init
    // included) is then a valid empty value on every platform, not stack garbage.
    memset((*void)g, 0, sizeof(Codegen));
    List_init<string>(&g.topfns, 16);
    List_init<CgSub>(&g.opcanon, 4);
    g.bf_vol = "";
    g.mstamp = 0;
    g.mactive = 0;
    g.tactive = 0;
    g.bactive = 0;
    String_init(&g.out, 1024);
    String_init(&g.globals, 256);
    g.next = 0;
    g.strcount = 0;
    g.cur_ret = "void";
    g.cur_rety = "void";
    List_init<CgLocal>(&g.locals, 8);
    g.terminated = 0;
    List_init<string>(&g.loop_cont, 4);
    List_init<string>(&g.loop_end, 4);
    List_init<*StmtNode>(&g.cleanups, 4);
    List_init<int>(&g.cl_err, 4);
    List_init<int>(&g.cl_nloc, 4);
    List_init<int>(&g.loop_cldepth, 4);
    List_init<string>(&g.loop_lbls, 4);
    List_init<string>(&g.loop_lbl_end, 4);
    List_init<string>(&g.loop_lbl_cont, 4);
    List_init<int>(&g.loop_lbl_cld, 4);
    List_init<CgFn>(&g.fns, 32);
    List_init<CgStruct>(&g.structs, 16);
    List_init<CgEnumC>(&g.econsts, 32);
    List_init<CgFK>(&g.fconsts, 4);
    List_init<string>(&g.enum_names, 16);
    List_init<string>(&g.enum_uns, 8);
    List_init<CgVariant>(&g.variants, 16);
    List_init<string>(&g.adt_names, 8);
    List_init<string>(&g.union_names, 4);
    List_init<CgIface>(&g.ifaces, 4);
    g.uses_iface = 0;
    List_init<CgSub>(&g.aliases, 4);
    List_init<string>(&g.fnthunks, 4);
    List_init<CgBF>(&g.bitfields, 8);
    List_init<CgLambda>(&g.lambdas, 8);
    g.lam_seq = 0;
    g.lam_expret = "";
    g.tern_node = null;
    g.tern_iface = "";
    g.uses_eh = 0;
    g.uses_throw = 0;
    g.uses_ex_text = 0;
    List_init<string>(&g.catch_text, 4);
    g.uses_threads = 0;
    g.uses_heap_env = 0;
    g.safe = 0;
    g.uses_trap = 0;
    g.cur_unwind = "";
    g.cur_lbl = "entry";
    g.prog_eh = 0;
    List_init<string>(&g.cl_unw, 4);
    List_init<int>(&g.try_cld, 4);
    List_init<string>(&g.try_disp, 4);
    List_init<string>(&g.try_phi, 4);
    List_init<CgLocal>(&g.gvars, 8);
    List_init<*DeclNode>(&g.gstructs, 8);
    List_init<*DeclNode>(&g.genums, 4);
    List_init<CgSub>(&g.tydefs, 16);
    List_init<CgSub>(&g.caligns, 4);
    List_init<CgUData>(&g.udata, 4);
    List_init<string>(&g.unnamed_tys, 4);
    List_init<string>(&g.nonhomog, 4);
    List_init<*DeclNode>(&g.tydecls, 16);
    List_init<CgCabi>(&g.cabis, 4);
    List_init<string>(&g.vols, 4);
    // The host C ABI, fixed when this compiler was built (the build compiler predefines
    // the architecture macro); cg_set_target switches it for a --target triple.
    g.abi = 0;
#ifdef __aarch64__
    g.abi = 2;
#ifdef __APPLE__
    g.abi = 1;
#endif
#endif
#ifdef __x86_64__
    g.abi = 3;
#ifdef _WIN32
    g.abi = 4;
#endif
#endif
#ifdef __arm__
    g.abi = 5;
#endif
    g.ptrsz = 8;
#ifdef __arm__
    g.ptrsz = 4;
#endif
    g.i64al = 8;
    g.msbf = 0;
    g.wintgt = 0;
    g.bigend = 0;
    ast_target_bf("", &g.bfal, &g.msvc);
    g.darwin = 0;
#ifdef __APPLE__
    g.darwin = 1;
#endif
#ifdef _WIN32
    g.msbf = 1;
    g.wintgt = 1;
#endif
    List_init<CgVariant>(&g.gvariants, 8);
    List_init<*DeclNode>(&g.gfns, 16);
    List_init<CgSub>(&g.cursub, 4);
    List_init<string>(&g.inst_seen, 16);
    List_init<CgInst>(&g.worklist, 16);
    g.wl_i = 0;
    g.lam_i = 0;
    g.thk_i = 0;
    String_init(&g.entry_buf, 128);
}

int cg_has_sub(string s, string sub) {
    int i = 0;
    while (s[i] != 0) {
        int j = 0;
        while (sub[j] != 0 && s[i + j] == sub[j]) {
            j = j + 1;
        }
        if (sub[j] == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int cg_has_prefix(string s, string pre) {
    int i = 0;
    while (pre[i] != 0) {
        if (s[i] != pre[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// The C ABI of a --target `triple` (C++ CodeGen::cabiTarget): the architecture picks the
// convention, the OS picks Darwin vs AAPCS64 and Windows x64 vs SysV, and a 32-bit ARM
// triple ending in `hf` is hard-float. A Windows triple also selects the MS bitfield
// layout. "" keeps the build host's.
void cg_set_target(Codegen* g, string triple) {
    if (triple[0] == 0) {
        return;
    }
    g.abi = 0;
    g.ptrsz = 8;
    g.i64al = 8;
    g.msbf = 0;
    g.x86ri = 0;
    g.x86ws = 0;
    int apple = cg_has_sub(triple, "apple") | cg_has_sub(triple, "darwin") | cg_has_sub(triple, "macos") | cg_has_sub(triple, "ios");
    int win = cg_has_sub(triple, "windows") | cg_has_sub(triple, "win32") | cg_has_sub(triple, "mingw");
    g.msbf = win;
    g.wintgt = win;
    g.darwin = apple;
    g.emscripten = cg_has_sub(triple, "emscripten");
    ast_target_bf(triple, &g.bfal, &g.msvc);
    g.bigend = cg_has_prefix(triple, "aarch64_be");
    if (cg_has_prefix(triple, "aarch64") == 1 || cg_has_prefix(triple, "arm64") == 1) {
        g.abi = 2;
        if (apple == 1) {
            g.abi = 1;
        }
    } else if (cg_has_prefix(triple, "x86_64") == 1 || cg_has_prefix(triple, "amd64") == 1) {
        g.abi = 3;
        if (win == 1) {
            g.abi = 4;
        }
    } else if (cg_has_prefix(triple, "i386") == 1 || cg_has_prefix(triple, "i486") == 1
               || cg_has_prefix(triple, "i586") == 1 || cg_has_prefix(triple, "i686") == 1) {
        // 32-bit x86: 4-byte pointers; the SysV i386 ABI aligns i64 and double to 4
        // (LLVM's `f64:32:64`, no `i64:64`), Windows to 8. cdecl C-ABI lowering (abi 7):
        // Darwin, Windows and the BSDs return small aggregates in registers, Linux via
        // sret; MSVC (not mingw) returns a lone float/double as an integer.
        g.ptrsz = 4;
        g.abi = 7;
        if (win == 0) {
            g.i64al = 4;
        }
        g.x86ri = apple | win | cg_has_sub(triple, "freebsd") | cg_has_sub(triple, "openbsd") | cg_has_sub(triple, "dragonfly");
        g.x86ws = 0;
        if (win == 1 && cg_has_sub(triple, "mingw") == 0 && cg_has_sub(triple, "gnu") == 0 && cg_has_sub(triple, "cygwin") == 0) {
            g.x86ws = 1;
        }
    } else if (cg_has_prefix(triple, "wasm32") == 1) {
        g.ptrsz = 4;
        g.abi = 8;
    } else if (cg_has_prefix(triple, "arm") == 1 || cg_has_prefix(triple, "thumb") == 1) {
        g.abi = 5;
        g.ptrsz = 4;
        int n = 0;
        while (triple[n] != 0) {
            n = n + 1;
        }
        if (n >= 2 && (int)triple[n - 2] == 104 && (int)triple[n - 1] == 102) {   // "hf"
            g.abi = 6;
        }
    }
}

// An inline asm constraint as LLVM reads it (mirrors x86AsmConstraint): on x86 a GCC
// single-register letter is spelled out like clang does (`a` is `{ax}`, `Nd` is
// `N{dx}`); modifiers, other letters, digits and `{...}` stay. Other targets: as written.
string cg_asm_cons(Codegen* g, string c) {
    if (g.abi != 3 && g.abi != 4 && g.abi != 7) {
        return c;
    }
    String out;
    String_init(&out, 16);
    int i = 0;
    int inbr = 0;
    while (c[i] != 0) {
        int ch = (int)c[i];
        i = i + 1;
        if (inbr == 1) {
            if (ch == 125) {
                inbr = 0;
            }
            String_push(&out, (char)ch);
            continue;
        }
        if (ch == 123) {
            inbr = 1;
            String_push(&out, (char)ch);
            continue;
        }
        if (ch == 97) {
            String_append(&out, "{ax}");
        }
        else if (ch == 98) {
            String_append(&out, "{bx}");
        }
        else if (ch == 99) {
            String_append(&out, "{cx}");
        }
        else if (ch == 100) {
            String_append(&out, "{dx}");
        }
        else if (ch == 83) {
            String_append(&out, "{si}");
        }
        else if (ch == 68) {
            String_append(&out, "{di}");
        }
        else {
            String_push(&out, (char)ch);
        }
    }
    return (string)String_cstr(&out);
}

// Reserve a local `alloca <ty>` in the entry block (not inline), so a variable declared in
// a loop body allocates ONCE, not every iteration (a long loop would otherwise overflow the
// stack). Returns the slot name. Mirrors the C++ back-end's entryAlloca.
string cg_entry_alloca(Codegen* g, string ty) {
    string slot = cg_tmp(g);
    String_append(&g.entry_buf, "  ");
    String_append(&g.entry_buf, slot);
    String_append(&g.entry_buf, " = alloca ");
    String_append(&g.entry_buf, ty);
    String_append(&g.entry_buf, "\n");
    return slot;
}

// Snapshot the active type-parameter substitution, so a deferred emission (a queued
// lambda body) can restore the exact substitution that was live where it was written.
List<CgSub> cg_copy_sub(List<CgSub>* src) {
    List<CgSub> r;
    List_init<CgSub>(&r, List_len<CgSub>(src) + 1);
    int i = 0;
    int n = List_len<CgSub>(src);
    while (i < n) {
        List_push<CgSub>(&r, List_get<CgSub>(src, i));
        i = i + 1;
    }
    return r;
}

// Minimal AST constructors, used to desugar `for-in` into a counted for. Local copies of
// the parser/async_lower builders so codegen.esk stays self-contained (it compiles as a
// standalone module in cg_selfhost.sh, without those modules merged in).
// alloc zero-initializes, so the fields these builders leave unset read as zero: a null
// child, an empty `kids`/`names` list (`{null,0,0}`, which cg_etype's `List_len` reads as
// empty). Only the kind + the fields each node actually uses need setting.
*ExprNode cgb_ident(string nm) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_IDENT;
    e.sval = nm;
    return e;
}

*ExprNode cgb_lit(int lk, string v) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_LITERAL;
    e.lit_kind = lk;
    e.sval = v;
    return e;
}

*ExprNode cgb_bin(string op, *ExprNode l, *ExprNode r) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_BINARY;
    e.sval = op;
    e.a = l;
    e.b = r;
    return e;
}

*ExprNode cgb_member(*ExprNode base, string field) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_MEMBER;
    e.a = base;
    e.sval = field;
    return e;
}

*ExprNode cgb_index(*ExprNode base, *ExprNode idx) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_INDEX;
    e.a = base;
    e.b = idx;
    return e;
}

*StmtNode cgb_vardecl(string nm, string ty, *ExprNode init) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_VARDECL;
    s.name = nm;
    s.type = ty;
    s.expr = init;
    s.is_const = 0;
    s.is_static = 0;
    return s;
}

// Does `e` have an address (a list-like iterable is then held by a pointer to it)?
int cg_addressable(Codegen* g, *ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_IDENT) {
        return 1;
    }
    int builtin = 1;
    if (e.op_fn != null && e.op_fn[0] != 0) {
        builtin = 0;
    }
    if (e.kind == EK_UNARY) {
        if (builtin == 1 && cg_streq(e.sval, "*") == 1) {
            return 1;
        }
        return 0;
    }
    if (e.kind == EK_INDEX) {
        if (builtin == 1 && List_len<*ExprNode>(&e.kids) == 0) {
            return 1;
        }
        return 0;
    }
    if (e.kind == EK_MEMBER) {
        string bt = cg_etype(g, e.a);
        if ((int)bt[0] == 42) {
            return 1;
        }
        return cg_addressable(g, e.a);
    }
    return 0;
}

*StmtNode cgb_for(*StmtNode init, *ExprNode cond, *ExprNode step, *StmtNode body) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_FOR;
    s.s1 = init;
    s.expr = cond;
    s.expr2 = step;
    s.s2 = body;
    return s;
}

*StmtNode cgb_block2(*StmtNode a, *StmtNode b) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_BLOCK;
    List_init<*StmtNode>(&s.items, 2);
    List_push<*StmtNode>(&s.items, a);
    if (b != null) {
        List_push<*StmtNode>(&s.items, b);
    }
    return s;
}

// Mangle a generic type/call spelling into an LLVM-safe name: "Box<int>" -> "Box_int",
// "Map<string, int>" -> "Map_string__int", "List<*int>" -> "List_pint". Internally
// consistent (defs and refs agree), which is all clang needs.
string cg_mangle(string s) {
    int n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0;
    int i = 0;
    while (i < n) {
        int c = (int)s[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            buf[o] = (uint8)c;
            o = o + 1;
        } else if (c == 42) {   // '*' -> 'p'
            buf[o] = 112;
            o = o + 1;
        }
        else if (c == 62 || c == 32) {}                   // '>' / ' ' dropped
        else {                   // '<' ',' etc. -> '_'
            buf[o] = 95;
            o = o + 1;
        }
        i = i + 1;
    }
    buf[o] = 0;
    return (string)buf;
}

// Replace each identifier run of `t` named in `subs` by its spelling (*changed = 1 when
// one was), keeping the grouping of a pointer to, or an array of, an array or slice
// spelling: a star before one goes after it (`*T`, T = int[3], is `int[3]*`) and extra
// dimensions go in front of its own (`T[2]`, T = int[], is `int[2][]`). Shared by the
// generic substitution (cg_apply_sub) and alias expansion (cg_dealias_d).
string cg_subst_ids(string t, List<CgSub>* subs, int* changed) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    String out;
    String_init(&out, n + 8);
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            int s = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) {
                    i = i + 1;
                }
                else {
                    break;
                }
            }
            string id = cg_sub_str(t, s, i);
            string rep = id;
            int k = 0;
            int m = List_len<CgSub>(subs);
            while (k < m) {
                CgSub sb = List_get<CgSub>(subs, k);
                if (cg_streq(sb.param, id) == 1) {
                    rep = sb.arg;
                    changed[0] = 1;
                }
                k = k + 1;
            }
            // A pointer to an alias of an array (`*AI`, `type AI = int[3]`) is `int[3]*`: a
            // leading star would bind looser than the array suffix (an array of pointers).
            int rn = 0;
            while (rep[rn] != 0) {
                rn = rn + 1;
            }
            // An alias of an array or slice given more dimensions (`IS[2]`, `type IS = int[]`):
            // the new ones are outer, so they go in front of the alias's own brackets (C
            // order), `int[2][]`.
            int dimsed = 0;
            int lead = 0;
            while (s - lead > 0 && (int)t[s - lead - 1] == 42) {
                lead = lead + 1;
            }
            if (rep != id && rn > 0 && (int)rep[rn - 1] == 93 && i < n && (int)t[i] == 91 && lead > 0) {
                // `*T[2]`, T = int[3]: 2 pointers to int[3], `int[3]*[2]`
                out.len = out.len - (int64)lead;
                out.data[out.len] = (char)0;
                while (lead > 0) {
                    rep = cg_cat(rep, "*");
                    lead = lead - 1;
                }
                rn = 0;
                while (rep[rn] != 0) {
                    rn = rn + 1;
                }
                dimsed = 1;
            } else if (rep != id && rn > 0 && (int)rep[rn - 1] == 93 && i < n && (int)t[i] == 91) {
                int ds = i;
                while (i < n && (int)t[i] == 91) {
                    while (i < n && (int)t[i] != 93) {
                        i = i + 1;
                    }
                    if (i < n) {
                        i = i + 1;
                    }
                }
                int rb = 0;
                int rdep = 0;
                while (rb < rn && !((int)rep[rb] == 91 && rdep == 0)) {
                    int rc = (int)rep[rb];
                    if (rc == 60 || rc == 40) {
                        rdep = rdep + 1;
                    }
                    else if ((rc == 62 && (rb == 0 || (int)rep[rb - 1] != 45)) || rc == 41) {
                        rdep = rdep - 1;
                    }
                    rb = rb + 1;
                }
                rep = cg_cat(cg_cat(cg_sub_str(rep, 0, rb), cg_sub_str(t, ds, i)), cg_sub_str(rep, rb, rn));
                rn = 0;
                while (rep[rn] != 0) {
                    rn = rn + 1;
                }
                dimsed = 1;
            }
            int stars = 0;
            // (a pointer to an array, `int[3]*`, is grouped the same way: `*T` is `int[3]**`)
            int rt = rn;
            while (rt > 0 && (int)rep[rt - 1] == 42) {
                rt = rt - 1;
            }
            if (dimsed == 0 && rep != id && rt < rn && rt > 0 && (int)rep[rt - 1] == 93) {
                while (s - stars > 0 && (int)t[s - stars - 1] == 42) {
                    stars = stars + 1;
                }
                out.len = out.len - (int64)stars;
                out.data[out.len] = (char)0;
            } else if (dimsed == 0 && rep != id && rn > 0 && (int)rep[rn - 1] == 93) {
                while (s - stars > 0 && (int)t[s - stars - 1] == 42) {
                    stars = stars + 1;
                }
                out.len = out.len - (int64)stars;
                out.data[out.len] = (char)0;
                // An array of an array alias (`type Arr = int[3]; Arr[2]`) is 2 arrays of 3:
                // the outer dimensions go in front of the alias's (leftmost is outermost).
                if (stars == 0 && i < n && (int)t[i] == 91) {
                    int e = i;
                    while (e < n && (int)t[e] == 91) {
                        int dd = 0;
                        while (e < n) {
                            if ((int)t[e] == 91) {
                                dd = dd + 1;
                            }
                            else if ((int)t[e] == 93) {
                                dd = dd - 1;
                                if (dd == 0) {
                                    e = e + 1;
                                    break;
                                }
                            }
                            e = e + 1;
                        }
                    }
                    int rb = cg_arr_open(rep);
                    if (rb > 0) {
                        rep = cg_cat(cg_cat(cg_sub_str(rep, 0, rb), cg_sub_str(t, i, e)), cg_sub_str(rep, rb, rn));
                        i = e;
                    }
                }
            }
            String_append(&out, rep);
            while (stars > 0) {
                String_push(&out, '*');
                stars = stars - 1;
            }
        } else {
            String_push(&out, (char)c);
            i = i + 1;
        }
    }
    return (string)String_cstr(&out);
}

// Apply the active substitution to a type spelling: identifier runs equal to a type
// parameter are replaced by its concrete type. "*T" -> "*int", "List<T>" -> "List<int>",
// "*T" with T = int[] -> "int[]*" (a pointer to the slice).
string cg_apply_sub(Codegen* g, string t) {
    if (List_len<CgSub>(&g.cursub) == 0) {
        return t;
    }
    int changed = 0;
    return cg_subst_ids(t, &g.cursub, &changed);
}

// Resolve type aliases in a type spelling, token-wise (each identifier that names an
// alias is replaced by its underlying type, recursively up to `depth` for chained
// aliases). Always-on (unlike cg_apply_sub's generic substitution); a no-op when no
// aliases are registered. `type u8 = uint8` → "u8" becomes "uint8"; "*u8" → "*uint8".
string cg_dealias_d(Codegen* g, string t, int depth) {
    if (depth > 8) {
        return t;
    }
    if (List_len<CgSub>(&g.aliases) == 0) {
        return t;
    }
    int changed = 0;
    string r = cg_subst_ids(t, &g.aliases, &changed);
    if (changed == 1) {
        return cg_dealias_d(g, r, depth + 1);
    }
    return r;
}

string cg_dealias(Codegen* g, string t) {
    return cg_dealias_d(g, t, 0);
}

// Does a type/call spelling carry generic args ("Name<...>")?
int cg_has_targs(string s) {
    int i = 0;
    while (s[i] != 0) {   // '<'
        if ((int)s[i] == 60) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Base name of a generic spelling: "Box<int>" -> "Box", "List_init<int>" -> "List_init".
string cg_gen_base(string s) {
    int n = 0;
    while (s[n] != 0 && (int)s[n] != 60) {   // up to '<'
        n = n + 1;
    }
    *uint8 buf = alloc<uint8>(n + 1);
    int k = 0;
    while (k < n) {
        buf[k] = (uint8)s[k];
        k = k + 1;
    }
    buf[n] = 0;
    return (string)buf;
}

// Parse the comma-separated args inside the outermost <...> of a generic spelling,
// honoring nesting ("Map<List<int>, int>" -> ["List<int>", "int"]).
void cg_gen_args(string s, List<string>* out) {
    int i = 0;
    while (s[i] != 0 && (int)s[i] != 60) {   // to '<'
        i = i + 1;
    }
    if (s[i] == 0) {
        return;
    }
    i = i + 1;                                            // past '<'
    int depth = 1;
    int start = i;
    while (s[i] != 0 && depth > 0) {
        int c = (int)s[i];
        if (c == 60 || c == 40) {             // '<' or '(' (nested generic / fn params)
            depth = depth + 1;
        }
        else if (c == 41) {   // ')'
            if (depth > 0) {
                depth = depth - 1;
            }
        }
        else if (c == 62 && (i == 0 || (int)s[i - 1] != 45)) {      // '>' closing a generic, NOT the "->" arrow
            depth = depth - 1;
            if (depth == 0) {
                break;
            }
        }
        else if (c == 44 && depth == 1) {                          // top-level ','
            string a = cg_sub_str(s, start, i);
            List_push<string>(out, cg_trim(a));
            i = i + 1;
            start = i;
            continue;
        }
        i = i + 1;
    }
    if (i > start) {
        List_push<string>(out, cg_trim(cg_sub_str(s, start, i)));
    }
}

// Trim leading/trailing spaces.
string cg_trim(string s) {
    int a = 0;
    while ((int)s[a] == 32) {
        a = a + 1;
    }
    int b = 0;
    while (s[b] != 0) {
        b = b + 1;
    }
    while (b > a && (int)s[b - 1] == 32) {
        b = b - 1;
    }
    return cg_sub_str(s, a, b);
}

int cg_in_strlist(List<string>* l, string s) {
    int i = 0;
    int n = List_len<string>(l);
    while (i < n) {
        if (cg_streq(List_get<string>(l, i), s) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int cg_seen_inst(Codegen* g, string mangled) {
    return NameIdx_first(&g.inst_ix, mangled) >= 0;
}

*DeclNode cg_find_gstruct(Codegen* g, string name) {
    int i = NameIdx_first(&g.gstructs_ix, name);
    if (i < 0) {
        return null;
    }
    return List_get<*DeclNode>(&g.gstructs, i);
}

// Monomorphize a generic struct spelling ("Box<int>") into a concrete named type
// `%Box_int = type {…}` with the type params substituted in its field types. Returns
// the mangled name. Idempotent (deduped via inst_seen).
void cg_emit_tydecl(Codegen* g, *DeclNode d);
int cg_struct_has_bf(*DeclNode d);
int cg_c_align(Codegen* g, string t);            // fwd: the C alignment of an LLVM type
int cg_ll_align_of(Codegen* g, string t);        // fwd
string cg_ensure_struct_inst(Codegen* g, string spelling) {
    spelling = cg_apply_sub(g, spelling);                 // resolve T→concrete before mangling
    string mangled = cg_mangle(cg_dealias(g, spelling));  // an alias arg is its target (one instance)
    if (cg_seen_inst(g, mangled) == 1) {
        return mangled;
    }
    string base = cg_gen_base(spelling);
    *DeclNode gd = cg_find_gstruct(g, base);
    if (gd == null) {                   // unknown generic — leave as-is
        return mangled;
    }
    cg_push_inst(g, mangled);             // mark before building (recursion)

    List<string> args;
    List_init<string>(&args, 4);
    cg_gen_args(spelling, &args);

    List<CgSub> oldsub = g.cursub;                        // save/restore the active sub
    List_init<CgSub>(&g.cursub, 4);
    int tp = 0;
    int ntp = List_len<TypeParam>(&gd.type_params);
    while (tp < ntp && tp < List_len<string>(&args)) {
        let sb: CgSub;
        sb.param = List_get<TypeParam>(&gd.type_params, tp).name;
        sb.arg = List_get<string>(&args, tp);
        List_push<CgSub>(&g.cursub, sb);
        tp = tp + 1;
    }

    let s: CgStruct;
    s.name = mangled;
    List_init<string>(&s.fnames, 4);
    List_init<string>(&s.fetys, 4);
    // Assemble the field-type list into a local buffer first: a field whose type is
    // itself generic triggers a nested instantiation that appends to g.globals, so the
    // nested type must land BEFORE this one's line (not interleaved mid-line).
    String body;
    String_init(&body, 32);
    int fi = 0;
    int nf = List_len<Param>(&gd.params);
    while (fi < nf) {
        Param fp = List_get<Param>(&gd.params, fi);
        string fety = cg_apply_sub(g, fp.ty);             // T -> concrete spelling
        List_push<string>(&s.fnames, fp.name);
        List_push<string>(&s.fetys, fety);
        if (fi > 0) {
            String_append(&body, ", ");
        }
        String_append(&body, cg_lltype(g, fety));
        fi = fi + 1;
    }
    cg_push_struct(g, s);                   // register before emitting the line
    int manual = 0;
    if (gd.is_packed == 0) {
        int mi = 0;
        while (mi < nf) {
            string mlt = cg_lltype(g, List_get<string>(&s.fetys, mi));
            if (cg_c_align(g, mlt) != cg_ll_align_of(g, mlt)) {
                manual = 1;
            }
            mi = mi + 1;
        }
    }
    if (cg_struct_has_bf(gd) == 1 || gd.is_packed == 1 || gd.pack_align >= 2 || manual == 1) {
        // Bitfields / packing (or a field holding a pack(N) struct): lay the instance out
        // like a plain struct of the concrete field types (same widths and packing as the
        // generic decl).
        *DeclNode cd = alloc<DeclNode>(1);
        cd.kind = DK_STRUCT;
        cd.name = mangled;
        cd.is_packed = gd.is_packed;
        cd.pack_align = gd.pack_align;
        cd.field_bits = gd.field_bits;
        cd.pad_tys = gd.pad_tys;
        cd.pad_bits = gd.pad_bits;
        cd.pad_at = gd.pad_at;
        List_init<Param>(&cd.params, nf);
        int ci = 0;
        while (ci < nf) {
            let cp: Param;
            cp.name = List_get<string>(&s.fnames, ci);
            cp.ty = List_get<string>(&s.fetys, ci);
            List_push<Param>(&cd.params, cp);
            ci = ci + 1;
        }
        cg_push_tydecl(g, cd);
        cg_emit_tydecl(g, cd);
    } else {
        cg_deftype(g, mangled, cg_cat("{ ", cg_cat((string)String_cstr(&body), " }")));
        cg_note_nonhomog(g, mangled, gd, &s.fetys);
    }

    g.cursub = oldsub;                                    // restore
    return mangled;
}

// A generic function by name: its definition, not a body-less prototype (`T f<T>(T x);`)
// that may precede it.
*DeclNode cg_find_gfn(Codegen* g, string name) {
    *DeclNode proto = null;
    int i = NameIdx_first(&g.gfns_ix, name);
    while (i >= 0) {
        *DeclNode d = List_get<*DeclNode>(&g.gfns, i);
        if (d.body != null) {
            return d;
        }
        if (proto == null) {
            proto = d;
        }
        i = NameIdx_next(&g.gfns_ix, i);
    }
    return proto;
}

// Build the active T→concrete substitution for a generic decl + its type args, saving
// and returning the previous one (restore by assigning it back to g.cursub).
List<CgSub> cg_push_sub(Codegen* g, *DeclNode gd, List<string>* args) {
    List<CgSub> old = g.cursub;
    List_init<CgSub>(&g.cursub, 4);
    int tp = 0;
    int ntp = List_len<TypeParam>(&gd.type_params);
    while (tp < ntp && tp < List_len<string>(args)) {
        let sb: CgSub;
        sb.param = List_get<TypeParam>(&gd.type_params, tp).name;
        sb.arg = List_get<string>(args, tp);
        List_push<CgSub>(&g.cursub, sb);
        tp = tp + 1;
    }
    return old;
}

// Monomorphize a generic function call spelling ("id<int>") — register its concrete
// signature now (so the call site is typed) and queue its body for emission. Returns
// the mangled name. Idempotent.
string cg_ensure_fn_inst(Codegen* g, string spelling) {
    // Resolve type args through the active substitution FIRST: a call like `alloc<T>`
    // inside a `List_push<T>` body has the literal param `T`, which must become the
    // concrete type (`alloc<Param>`) before mangling — else we'd emit a bogus `alloc_T`.
    spelling = cg_apply_sub(g, spelling);
    // A type alias among the args is its target (`unbox<F>` with `type F = int` is
    // `unbox<int>`), so both spellings share one instance: the name is mangled from the
    // dealiased spelling. The args keep their spelling for substitution (an alias of an
    // array keeps its grouping there: `*T` with `T = IS` is a pointer to the slice).
    string mangled = cg_mangle(cg_dealias(g, spelling));
    if (cg_seen_inst(g, mangled) == 1) {
        return mangled;
    }
    string base = cg_gen_base(spelling);
    *DeclNode gd = cg_find_gfn(g, base);
    if (gd == null) {                   // unknown generic — leave as-is
        return mangled;
    }
    cg_push_inst(g, mangled);

    List<string> args;
    List_init<string>(&args, 4);
    cg_gen_args(spelling, &args);

    let inst: CgInst;
    inst.decl = gd;
    inst.mangled = mangled;
    inst.is_struct = 0;
    List_init<string>(&inst.args, 4);
    int ai = 0;
    while (ai < List_len<string>(&args)) {
        List_push<string>(&inst.args, List_get<string>(&args, ai));
        ai = ai + 1;
    }
    List_push<CgInst>(&g.worklist, inst);

    List<CgSub> oldsub = cg_push_sub(g, gd, &args);       // signature types under sub
    let f: CgFn;
    f.name = mangled;
    f.retty = cg_lltype(g, gd.ret_type);
    f.rety = cg_apply_sub(g, gd.ret_type);
    f.variadic = 0;
    string fixed = "";
    int np = List_len<Param>(&gd.params);
    int pi = 0;
    int first = 1;
    List_init<string>(&f.ptys, np);
    List_init<string>(&f.petys, np);
    while (pi < np) {
        Param pm = List_get<Param>(&gd.params, pi);
        if (cg_streq(pm.ty, "...") == 1) {   // generic variadic
            f.variadic = 1;
            pi = pi + 1;
            continue;
        }
        string plt = cg_lltype(g, pm.ty);
        List_push<string>(&f.ptys, plt);
        List_push<string>(&f.petys, cg_apply_sub(g, pm.ty));
        if (first == 0) {
            fixed = cg_cat(fixed, ", ");
        }
        fixed = cg_cat(fixed, plt);
        first = 0;
        pi = pi + 1;
    }
    f.fixedtypes = fixed;
    cg_push_fn(g, f);
    g.cursub = oldsub;
    return mangled;
}

// An inline method of a generic struct instance (`Box<int>` + `get` → `Box_int_get`):
// register its concrete signature (self first) and queue its body, like a generic
// function instance. Returns the LLVM name, or "" when `sname` is not such an instance.
string cg_ensure_method_inst(Codegen* g, string sname, string method) {
    string sp = cg_apply_sub(g, sname);
    if (cg_has_targs(sp) == 0) {
        return "";
    }
    *DeclNode gd = cg_find_gstruct(g, cg_gen_base(sp));
    if (gd == null) {
        return "";
    }
    *DeclNode m = null;
    int mi = 0;
    int mn = List_len<*DeclNode>(&gd.methods);
    while (mi < mn) {
        *DeclNode c = List_get<*DeclNode>(&gd.methods, mi);
        if (cg_streq(c.name, method) == 1) {
            m = c;
        }
        mi = mi + 1;
    }
    if (m == null) {
        return "";
    }
    string smangled = cg_ensure_struct_inst(g, sp);
    string llname = cg_cat(cg_cat(smangled, "_"), method);
    if (cg_seen_inst(g, llname) == 1) {
        return llname;
    }
    cg_push_inst(g, llname);

    List<string> args;
    List_init<string>(&args, 4);
    cg_gen_args(sp, &args);
    let inst: CgInst;
    inst.decl = m;
    inst.mangled = llname;
    inst.is_struct = 2;
    inst.owner = gd;
    inst.self_sp = sp;
    List_init<string>(&inst.args, 4);
    int ai = 0;
    while (ai < List_len<string>(&args)) {
        List_push<string>(&inst.args, List_get<string>(&args, ai));
        ai = ai + 1;
    }
    List_push<CgInst>(&g.worklist, inst);

    List<CgSub> oldsub = cg_push_sub(g, gd, &args);
    let f: CgFn;
    f.name = llname;
    f.retty = cg_lltype(g, m.ret_type);
    f.rety = cg_apply_sub(g, m.ret_type);
    f.variadic = 0;
    f.fixedtypes = "";
    int np = List_len<Param>(&m.params);
    List_init<string>(&f.ptys, np + 1);
    List_init<string>(&f.petys, np + 1);
    List_push<string>(&f.ptys, "ptr");                    // implicit self
    List_push<string>(&f.petys, cg_cat("*", sp));
    int pi = 0;
    while (pi < np) {
        Param pm = List_get<Param>(&m.params, pi);
        List_push<string>(&f.ptys, cg_lltype(g, pm.ty));
        List_push<string>(&f.petys, cg_apply_sub(g, pm.ty));
        pi = pi + 1;
    }
    cg_push_fn(g, f);
    g.cursub = oldsub;
    return llname;
}

// The function a method call `recv.m(...)` targets, for a receiver of struct `sname`:
// a generic struct instance's method (instantiated on demand), else `Struct_m`.
// The flat name of a generic instance spelling as the user writes it in a function name
// (`List<string>` -> `List_string`, `M<string, int>` -> `M_string_int`), the C++ mangleTemplate
// rule (cg_mangle differs: it is only for the emitted IR names).
string cg_flat_name(string t) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0;
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            buf[o] = (uint8)c;
            o = o + 1;
        }
        else if (c == 42) {            // '*' -> 'p'
            buf[o] = 112;
            o = o + 1;
        }
        else if (c == 60 || c == 44) {   // '<' ',' -> '_'
            buf[o] = 95;
            o = o + 1;
        }
        i = i + 1;
    }
    buf[o] = 0;
    return (string)buf;
}

string cg_method_fn(Codegen* g, string sname, string method) {
    string gm = cg_ensure_method_inst(g, sname, method);
    if (gm[0] != 0) {
        return gm;
    }
    // On a generic instance, a non-generic `G_int_m(G<int>* self, ...)` serves the call.
    if (cg_has_targs(sname) == 1) {
        string flat = cg_cat(cg_cat(cg_flat_name(sname), "_"), method);
        if (cg_is_fn(g, flat) == 1) {
            return flat;
        }
    }
    return cg_cat(cg_cat(sname, "_"), method);
}

// Emit every queued generic-function instantiation. Bodies may queue further
// instantiations (transitive generics), so iterate until the worklist is exhausted.
void cg_drain_worklist(Codegen* g) {
    while (g.wl_i < List_len<CgInst>(&g.worklist)) {
        int wi = g.wl_i;
        CgInst inst = List_get<CgInst>(&g.worklist, wi);
        if (inst.is_struct == 0) {
            List<CgSub> oldsub = cg_push_sub(g, inst.decl, &inst.args);
            cg_emit_fn(g, inst.decl, inst.mangled, "");
            g.cursub = oldsub;
        } else if (inst.is_struct == 2) {
            List<CgSub> oldsub = cg_push_sub(g, inst.owner, &inst.args);
            cg_emit_fn(g, inst.decl, inst.mangled, inst.self_sp);
            g.cursub = oldsub;
        }
        g.wl_i = g.wl_i + 1;
    }
}

// Value of a plain-enum constant, or "" if `name` isn't one.
string cg_enum_val(Codegen* g, string name) {
    int i = NameIdx_last(&g.econsts_ix, name);           // the LAST definition wins, matching the
    if (i < 0) {                              // C++ back-end (a later `const int X`
        return "";
    }
    return List_get<CgEnumC>(&g.econsts, i).val;           // shadows an earlier one)
}

// How many top-level globals with base name `name` have already been registered — used to
// give a duplicate a unique emitted name (@X, @X.1, …) so clang does not reject a redefinition.
int cg_count_global(Codegen* g, string name) {
    int c = 0;
    int i = NameIdx_first(&g.gvars_ix, name);
    while (i >= 0) {
        c = c + 1;
        i = NameIdx_next(&g.gvars_ix, i);
    }
    return c;
}

// Variant name of a match-arm label "Circle(r)" -> "Circle" (or the whole label if no '(').
string cg_arm_var(string label) {
    int n = 0;
    while (label[n] != 0 && (int)label[n] != 40) {   // up to '('
        n = n + 1;
    }
    return cg_sub_str(label, 0, n);
}

// Binding names inside a match-arm label: "Rect(w, h)" -> ["w","h"]; "Empty" -> [].
void cg_arm_binds(string label, List<string>* out) {
    int i = 0;
    while (label[i] != 0 && (int)label[i] != 40) {   // to '('
        i = i + 1;
    }
    if (label[i] == 0) {
        return;
    }
    i = i + 1;
    int start = i;
    while (label[i] != 0) {
        int c = (int)label[i];
        if (c == 41) {   // ')'
            if (i > start) {
                List_push<string>(out, cg_trim(cg_sub_str(label, start, i)));
            }
            break;
        }
        if (c == 44) {
            List_push<string>(out, cg_trim(cg_sub_str(label, start, i)));
            i = i + 1;
            start = i;
            continue;
        }
        i = i + 1;
    }
}

// Comma-separated items between the first '(' and its matching ')' (paren- and
// '<>'-depth aware, the '>' of a `->` not closing an angle, so a fn-type param
// `fn(int)->int f` and a template arg `Pair<int,double>` stay one item). Each trimmed.
void cg_paren_list(string s, List<string>* out) {
    int i = 0;
    while (s[i] != 0 && (int)s[i] != 40) {   // to '('
        i = i + 1;
    }
    if (s[i] == 0) {
        return;
    }
    i = i + 1;
    int depth = 1;
    int start = i;
    int angle = 0;
    while (s[i] != 0 && depth > 0) {
        int c = (int)s[i];
        if (c == 40) {
            depth = depth + 1;
        }
        else if (c == 41) {
            depth = depth - 1;
            if (depth == 0) {
                if (i > start) {
                    List_push<string>(out, cg_trim(cg_sub_str(s, start, i)));
                }
                break;
            }
        }
        else if (c == 60) {
            angle = angle + 1;
        }
        else if (c == 62 && (int)s[i - 1] != 45) {
            if (angle > 0) {
                angle = angle - 1;
            }
        }
        else if (c == 44 && depth == 1 && angle == 0) {
            List_push<string>(out, cg_trim(cg_sub_str(s, start, i)));
            i = i + 1;
            start = i;
            continue;
        }
        i = i + 1;
    }
}

// Last whitespace-separated word of "int x" -> "x"; the rest -> "int" (the declared type).
string cg_last_word(string s) {
    int n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    int i = n;
    while (i > 0 && (int)s[i - 1] != 32) {
        i = i - 1;
    }
    return cg_sub_str(s, i, n);
}

string cg_drop_last_word(string s) {
    int n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    int i = n;
    while (i > 0 && (int)s[i - 1] != 32) {
        i = i - 1;
    }
    while (i > 0 && (int)s[i - 1] == 32) {
        i = i - 1;
    }
    return cg_sub_str(s, 0, i);
}

// Return type of a fn-type spelling: the text after the `->` that follows the
// parameter list's matching ')' ("fn(fn(int)->int)->int64" -> "int64").
string cg_fnty_ret(string t) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    int i = 0;
    while (i < n && (int)t[i] != 40) {
        i = i + 1;
    }
    int depth = 0;
    while (i < n) {
        int c = (int)t[i];
        if (c == 40) {
            depth = depth + 1;
        }
        else if (c == 41) {
            depth = depth - 1;
            if (depth == 0) {
                if (i + 2 < n && (int)t[i + 1] == 45 && (int)t[i + 2] == 62) {
                    return cg_trim(cg_sub_str(t, i + 3, n));
                }
                return "void";
            }
        }
        i = i + 1;
    }
    return "void";
}

int cg_is_adt(Codegen* g, string name) {
    return NameIdx_first(&g.adt_ix, name) >= 0;
}

int cg_is_union(Codegen* g, string name) {
    return NameIdx_first(&g.union_ix, name) >= 0;
}
