// Part of sema.esk (editor modes), imported from it in order; compile sema.esk, not this file alone.

// ── Editor tooling: --hover-at / --definition-at / --complete-at (mirrors the C++
// TypeChecker's getTypeAtPosition, getDefinitionAt, completeScope and completeMembers).
// The checker records, while it walks the program, what the query needs: the narrowest
// expression typed at the cursor, the declared names and member names on the cursor's
// line (hoverSyms), the uses there of locals (useDefs), of other names (useLocations) and
// of member functions (memberUses), and where each name is declared (definitionLocations).
// Only the primary input's positions count, never a generic instance's.

int sema_tool_primary(Sema* s) {
    if (s.tool == 0 || s.in_inst == 1 || s.cur_import == 1 || s.primary == null) {
        return 0;
    }
    return sema_streq(s.filename, s.primary);
}

// A position-keyed record on the query line replaces an earlier one at the same column
// (the C++ std::map entry).
int sema_tool_at(List<int>* cols, int col) {
    int i = 0;
    while (i < List_len<int>(cols)) {
        if (List_get<int>(cols, i) == col) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

void sema_tool_hsym(Sema* s, int line, int col, int width, string ty) {
    if (s.tool == 0 || s.tool == 3 || line != s.tq_line || sema_tool_primary(s) == 0) {
        return;
    }
    List_push<int>(&s.th_col, col);
    List_push<int>(&s.th_w, width);
    if (ty == null) {
        ty = "";
    }
    List_push<string>(&s.th_ty, ty);
}

void sema_tool_useloc(Sema* s, int line, int col, string name) {
    if (s.tool == 0 || s.tool == 3 || line != s.tq_line || sema_tool_primary(s) == 0) {
        return;
    }
    int i = sema_tool_at(&s.tu_col, col);
    if (i >= 0) {
        List_set<string>(&s.tu_name, i, name);
        return;
    }
    List_push<int>(&s.tu_col, col);
    List_push<string>(&s.tu_name, name);
}

void sema_tool_usedef(Sema* s, int line, int col, int width, string file, int dline, int dcol) {
    if (s.tool == 0 || s.tool == 3 || line != s.tq_line || sema_tool_primary(s) == 0) {
        return;
    }
    int i = sema_tool_at(&s.tdu_col, col);
    if (i < 0) {
        List_push<int>(&s.tdu_col, col);
        List_push<int>(&s.tdu_w, width);
        List_push<string>(&s.tdu_file, file);
        List_push<int>(&s.tdu_line, dline);
        List_push<int>(&s.tdu_dcol, dcol);
        return;
    }
    List_set<int>(&s.tdu_w, i, width);
    List_set<string>(&s.tdu_file, i, file);
    List_set<int>(&s.tdu_line, i, dline);
    List_set<int>(&s.tdu_dcol, i, dcol);
}

void sema_tool_memuse(Sema* s, int line, int col, int width, string fname) {
    if (s.tool == 0 || s.tool == 3 || line != s.tq_line || sema_tool_primary(s) == 0) {
        return;
    }
    int i = sema_tool_at(&s.tm_col, col);
    if (i >= 0) {
        List_set<int>(&s.tm_w, i, width);
        List_set<string>(&s.tm_fn, i, fname);
        return;
    }
    List_push<int>(&s.tm_col, col);
    List_push<int>(&s.tm_w, width);
    List_push<string>(&s.tm_fn, fname);
}

// Where `name` is declared (the last declaration checked wins, as the C++ map entry).
void sema_tool_defloc(Sema* s, string name, string file, int line, int col) {
    if (s.tool == 0 || s.tool == 3 || s.in_inst == 1 || name == null) {
        return;
    }
    if (file == null || file[0] == 0) {
        file = s.primary;
    }
    int i = 0;
    while (i < List_len<string>(&s.tl_name)) {
        if (sema_streq(List_get<string>(&s.tl_name, i), name) == 1) {
            List_set<string>(&s.tl_file, i, file);
            List_set<int>(&s.tl_line, i, line);
            List_set<int>(&s.tl_col, i, col);
            return;
        }
        i = i + 1;
    }
    List_push<string>(&s.tl_name, name);
    List_push<string>(&s.tl_file, file);
    List_push<int>(&s.tl_line, line);
    List_push<int>(&s.tl_col, col);
}

// `t` through aliases at its top and under its pointer stars (`*VV` is `*V`), no
// nullable or const.
string sema_tool_deep_dealias(Sema* s, string t0) {
    string t = sema_strip_nullable(sema_strip_const(sema_dealias(s, t0)));
    int n = sema_slen(t);
    if (n > 0 && (int)t[0] == 42) {
        return sema_cat("*", sema_tool_deep_dealias(s, sema_sub_str(t, 1, n)));
    }
    if (n > 0 && (int)t[n - 1] == 42) {
        return sema_cat(sema_tool_deep_dealias(s, sema_sub_str(t, 0, n - 1)), "*");
    }
    return t;
}

string sema_tool_ret_type(Sema* s, *ExprNode e);

// The type the C++ checker records for `e` (see sema_tool_expr): a field access has the
// field's declared type, a call its function's declared return type, an arithmetic
// operator the C++ spelling of its result.
string sema_tool_type(Sema* s, *ExprNode e) {
    if (e == null) {
        return "";
    }
    if (e.kind == EK_MEMBER && e.a != null) {
        return sema_member_type(s, sema_tool_deep_dealias(s, sema_tool_type(s, e.a)), e.sval);
    }
    string rt = sema_tool_ret_type(s, e);
    if (rt != null && rt[0] != 0) {
        return rt;
    }
    if (e.kind == EK_BINARY && e.a != null && e.b != null && sema_is_assign(e.sval) == 0) {
        string t = sema_infer_type(s, e);
        if (t == null || t[0] == 0) {
            t = sema_binary_type(s, e.sval, sema_tool_type(s, e.a), sema_tool_type(s, e.b));
        }
        if (t == null || t[0] == 0) {
            return "";
        }
        return sema_cxx_spelling(s, e, t);
    }
    return sema_infer_type(s, e);
}

// The declared return type of the function a call (or a user operator) calls, when the
// C++ checker records that spelling: a named non-generic function, a dot-call to a
// non-generic method, an operator overload. "" otherwise.
string sema_tool_ret_type(Sema* s, *ExprNode e) {
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
        *DeclNode fd = sema_find_fndecl(s, e.a.sval);
        if (fd != null && List_len<TypeParam>(&fd.type_params) == 0 && fd.is_async == 0) {
            return fd.ret_type;
        }
        return "";
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_MEMBER) {
        string bt = sema_tool_deep_dealias(s, sema_infer_type(s, e.a.a));
        string sn = sema_struct_of_type(bt);
        *DeclNode sd = sema_find_struct(s, sn);
        if (sd != null && List_len<TypeParam>(&sd.type_params) == 0) {
            int j = 0;
            while (j < List_len<*DeclNode>(&sd.methods)) {
                *DeclNode m = List_get<*DeclNode>(&sd.methods, j);
                if (sema_streq(m.name, e.a.sval) == 1) {
                    return m.ret_type;
                }
                j = j + 1;
            }
        }
        *DeclNode ffn = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), e.a.sval));
        if (ffn != null && List_len<TypeParam>(&ffn.type_params) == 0 && ffn.is_async == 0) {
            return ffn.ret_type;
        }
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind != EK_IDENT) {   // through a fn value
        string ct = sema_tool_deep_dealias(s, sema_tool_type(s, e.a));
        if (sema_is_fn_type(ct) == 1) {
            return sema_fn_ret(ct);
        }
        return "";
    }
    if (s.has_ops == 1 && e.kind == EK_BINARY && e.a != null && e.b != null && sema_is_assign(e.sval) == 0) {
        *DeclNode od = sema_find_binop(s, e.sval, sema_infer_type(s, e.a), sema_infer_type(s, e.b));
        if (od != null && sema_binop_verdict(s, e.sval, sema_infer_type(s, e.a), sema_infer_type(s, e.b)) != 1) {
            return od.ret_type;
        }
        return "";
    }
    if (s.has_ops == 1 && e.kind == EK_UNARY && e.a != null
        && (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "!") == 1 || sema_streq(e.sval, "~") == 1)) {
        string uop = e.sval;
        if (sema_streq(uop, "-") == 1) {
            uop = "u-";
        }
        List<string> utys;
        List_init<string>(&utys, 1);
        List_push<string>(&utys, sema_infer_type(s, e.a));
        *DeclNode ud = sema_find_op(s, uop, &utys);
        if (ud != null && sema_is_aggregate(s, sema_infer_type(s, e.a)) == 1) {
            return ud.ret_type;
        }
    }
    return "";
}

// The signature the C++ checker gives inline method `m` of generic struct `sd` on the
// instance spelled `base` (`Box<int>`): `int Box_int_get(*Box<int>, T2)`, its types
// substituted, the parameters unnamed.
string sema_tool_inst_sig(Sema* s, *DeclNode sd, *DeclNode m, string base) {
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(base, &targs);
    string shown = sema_cat(sd.name, "<");
    int i = 0;
    while (i < List_len<string>(&targs)) {
        if (i > 0) {
            shown = sema_cat(shown, ", ");
        }
        shown = sema_cat(shown, List_get<string>(&targs, i));
        i = i + 1;
    }
    shown = sema_cat(shown, ">");
    string r = sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_subst_params(m.ret_type, &sd.type_params, &targs), " "),
                        sema_flat_name(base)), "_"), m.name), "(*"), shown);
    int k = 0;
    while (k < List_len<Param>(&m.params)) {
        r = sema_cat(sema_cat(r, ", "), sema_subst_params(List_get<Param>(&m.params, k).ty, &sd.type_params, &targs));
        k = k + 1;
    }
    return sema_cat(r, ")");
}

// --complete-at: a generic struct's instance whose type the checker has resolved; its
// inline methods are then functions of their own (`Box_int_get`), as in the C++.
void sema_tool_note_inst(Sema* s, string t0) {
    if (t0 == null || t0[0] == 0) {
        return;
    }
    string base = sema_strip_ptr_sp(sema_strip_nullable(sema_strip_const(sema_dealias(s, t0))));
    if (sema_has_lt(base) == 0) {
        return;
    }
    *DeclNode sd = sema_find_struct(s, sema_base_name(base));
    if (sd == null || sd.kind != DK_STRUCT || List_len<TypeParam>(&sd.type_params) == 0 || List_len<*DeclNode>(&sd.methods) == 0) {
        return;
    }
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(base, &targs);
    if (List_len<string>(&targs) != List_len<TypeParam>(&sd.type_params)) {
        return;
    }
    if (sema_in_list(&s.ti_base, base) == 1) {
        return;
    }
    List_push<string>(&s.ti_base, base);
}

// A field access `x.f` (on a value of type `bt`): its declared type, and its declaration.
void sema_tool_field(Sema* s, *ExprNode m, string bt) {
    if (m.mline <= 0) {
        return;
    }
    string t = sema_strip_nullable(sema_strip_const(sema_dealias(s, bt)));
    string base = sema_strip_ptr_sp(sema_strip_const(t));
    *DeclNode sd = sema_find_struct(s, sema_base_name(sema_dealias(s, base)));
    if (sd == null) {
        return;
    }
    int fi = sema_field_index(sd, m.sval);
    if (fi < 0) {
        return;
    }
    Param f = List_get<Param>(&sd.params, fi);
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(base, &targs);
    sema_tool_hsym(s, m.mline, m.mcol, sema_slen(m.sval), sema_subst_params(f.ty, &sd.type_params, &targs));
    if (f.line > 0) {
        string sf = sd.file;
        if (sf == null || sf[0] == 0) {
            sf = s.primary;
        }
        sema_tool_usedef(s, m.mline, m.mcol, sema_slen(m.sval), sf, f.line, f.col);
    }
}

// The narrowest typed expression whose leading token spans the cursor (an identifier or
// a literal is its text; any other expression only its first column).
void sema_tool_expr(Sema* s, *ExprNode e) {
    if (s.tool != 1 || e == null || e.line != s.tq_line || e.col <= 0 || sema_tool_primary(s) == 0 || e == s.tool_callee) {
        return;
    }
    int w = 1;
    if (e.kind == EK_IDENT) {
        w = sema_slen(e.sval);
    }
    else if (e.kind == EK_LITERAL) {
        w = sema_slen(e.sval);
        if (e.lit_kind == LIT_STRING || e.lit_kind == LIT_CHAR) {
            w = w + 2;
        }
    }
    if (w < 1) {
        w = 1;
    }
    if (s.tq_col < e.col || s.tq_col >= e.col + w) {
        return;
    }
    if (s.th_best_w > 0 && w >= s.th_best_w) {
        return;
    }
    string t = "";
    if (e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1) {   // an assignment has its target's type
        t = sema_tool_type(s, e.a);
    }
    else {
        t = sema_tool_type(s, e);
    }
    if (t == null || t[0] == 0 || sema_streq(t, "unknown") == 1) {
        return;
    }
    // A field's or a function's declared type keeps its spelling (an alias stays named);
    // the others are the checker's normalized types.
    if (e.kind == EK_MEMBER || sema_tool_ret_type(s, e)[0] != 0) {
        s.th_best = t;
    }
    else {
        s.th_best = sema_display_ty(s, t);
    }
    s.th_best_w = w;
}

// A use of identifier `e`: a local or parameter maps to its declaration, any other name
// is resolved by name.
void sema_tool_ident(Sema* s, *ExprNode e) {
    if (s.tool == 0 || s.tool == 3 || e.line != s.tq_line) {
        return;
    }
    int i = NameIdx_last(&s.syms_ix, e.sval);
    if (i >= 0) {
        Sym y = List_get<Sym>(&s.syms, i);
        if (y.depth > 0 && y.line > 0) {
            sema_tool_usedef(s, e.line, e.col, sema_slen(e.sval), s.filename, y.line, y.col);
            return;
        }
    }
    sema_tool_useloc(s, e.line, e.col, e.sval);
}

// A variable's or an expression's type as the C++ shows it (its normalized type through
// displayType): through a top-level alias, and an instance's own argument list is
// `<A, B>` (its arguments keep their spelling).
string sema_display_ty(Sema* s, string t0) {
    if (t0 == null) {
        return "";
    }
    string t = sema_dealias(s, t0);
    int n = sema_slen(t);
    String out;
    String_init(&out, n + 8);
    int angle = 0;
    int paren = 0;
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if (c == 60) {
            angle = angle + 1;
        }
        else if (c == 62 && angle > 0) {
            angle = angle - 1;
        }
        else if (c == 40) {
            paren = paren + 1;
        }
        else if (c == 41 && paren > 0) {
            paren = paren - 1;
        }
        String_push(&out, (char)c);
        if (c == 44 && angle == 1 && paren == 0) {
            String_push(&out, (char)32);
            while (i + 1 < n && (int)t[i + 1] == 32) {
                i = i + 1;
            }
        }
        i = i + 1;
    }
    return (string)String_cstr(&out);
}

// The declaration a signature describes: a top-level function (the definition when there
// is one), or an inline struct method spelled `S_m` (its struct in `owner`).
*DeclNode sema_tool_fn(Sema* s, string name, *DeclNode* owner) {
    owner[0] = null;
    *DeclNode best = null;
    int i = NameIdx_first(&s.fndecls_ix, name);
    while (i >= 0) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.kind == DK_FUNCTION && (best == null || d.body != null)) {
            best = d;
        }
        i = NameIdx_next(&s.fndecls_ix, i);
    }
    if (best != null) {
        return best;
    }
    int k = 0;
    while (k < List_len<*DeclNode>(&s.sdecls)) {
        *DeclNode sd = List_get<*DeclNode>(&s.sdecls, k);
        int pl = sema_slen(sd.name);
        if (sd.kind == DK_STRUCT && sema_slen(name) > pl + 1 && (int)name[pl] == 95
            && sema_streq(sema_sub_str(name, 0, pl), sd.name) == 1) {
            string mn = sema_sub_str(name, pl + 1, sema_slen(name));
            int j = 0;
            while (j < List_len<*DeclNode>(&sd.methods)) {
                *DeclNode m = List_get<*DeclNode>(&sd.methods, j);
                if (sema_streq(m.name, mn) == 1) {
                    owner[0] = sd;
                    return m;
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    return null;
}

// Is `name` a function (declared, an extern or intrinsic, or an inline method `S_m`)?
int sema_tool_is_fn(Sema* s, string name) {
    if (NameIdx_first(&s.fndecls_ix, name) >= 0) {
        return 1;
    }
    *DeclNode ow = null;
    return sema_tool_fn(s, name, &ow) != null;
}

// The C++ signatureText: `[async ]R name[<T, U>](T a, U b)` for a function the program
// defines (an inline method takes `*S self` first), `R name(T, U)` for an extern.
string sema_sig_text(Sema* s, string name) {
    *DeclNode ow = null;
    *DeclNode d = sema_tool_fn(s, name, &ow);
    if (d != null) {
        string r = "";
        if (d.is_async == 1) {
            r = "async ";
        }
        r = sema_cat(sema_cat(sema_cat(r, d.ret_type), " "), name);
        int tn = List_len<TypeParam>(&d.type_params);
        if (tn > 0) {
            r = sema_cat(r, "<");
            int ti = 0;
            while (ti < tn) {
                if (ti > 0) {
                    r = sema_cat(r, ", ");
                }
                r = sema_cat(r, List_get<TypeParam>(&d.type_params, ti).name);
                ti = ti + 1;
            }
            r = sema_cat(r, ">");
        }
        r = sema_cat(r, "(");
        int first = 1;
        if (ow != null) {
            r = sema_cat(sema_cat(sema_cat(r, "*"), ow.name), " self");
            first = 0;
        }
        int i = 0;
        while (i < List_len<Param>(&d.params)) {
            Param pm = List_get<Param>(&d.params, i);
            if (first == 0) {
                r = sema_cat(r, ", ");
            }
            first = 0;
            if (sema_streq(pm.ty, "...") == 1 || pm.name == null || pm.name[0] == 0) {
                r = sema_cat(r, pm.ty);
            }
            else {
                r = sema_cat(sema_cat(sema_cat(r, pm.ty), " "), pm.name);
            }
            i = i + 1;
        }
        return sema_cat(r, ")");
    }
    int i2 = NameIdx_first(&s.fndecls_ix, name);
    if (i2 < 0) {
        return "";
    }
    *DeclNode x = List_get<*DeclNode>(&s.fndecls, i2);
    string r2 = sema_cat(sema_cat(sema_cat(x.ret_type, " "), name), "(");
    int j = 0;
    while (j < List_len<Param>(&x.params)) {
        if (j > 0) {
            r2 = sema_cat(r2, ", ");
        }
        r2 = sema_cat(r2, List_get<Param>(&x.params, j).ty);
        j = j + 1;
    }
    return sema_cat(r2, ")");
}

// Sort the parallel (name, kind, detail) candidate lists of one group by name.
void sema_tool_sort(List<string>* names, List<string>* details) {
    int n = List_len<string>(names);
    int a = 1;
    while (a < n) {
        string vn = List_get<string>(names, a);
        string vd = List_get<string>(details, a);
        int b = a - 1;
        while (b >= 0 && strcmp(List_get<string>(names, b), vn) > 0) {
            List_set<string>(names, b + 1, List_get<string>(names, b));
            List_set<string>(details, b + 1, List_get<string>(details, b));
            b = b - 1;
        }
        List_set<string>(names, b + 1, vn);
        List_set<string>(details, b + 1, vd);
        a = a + 1;
    }
}

string sym_sig_text(*DeclNode f);

void sema_tool_add(Sema* s, StrTab* seen, string kind, string name, string detail) {
    if (name == null || name[0] == 0 || (int)name[0] == 95 || StrTab_has(seen, name) == 1) {
        return;
    }
    StrTab_set(seen, name, 1);
    if (detail == null) {
        detail = "";
    }
    List_push<string>(&s.tc_kind, kind);
    List_push<string>(&s.tc_name, name);
    List_push<string>(&s.tc_detail, detail);
}

void sema_tool_add_group(Sema* s, StrTab* seen, string kind, List<string>* names, List<string>* details) {
    sema_tool_sort(names, details);
    int i = 0;
    while (i < List_len<string>(names)) {
        sema_tool_add(s, seen, kind, List_get<string>(names, i), List_get<string>(details, i));
        i = i + 1;
    }
}

// The names visible at an identifier: the variables in scope (innermost scope first, each
// by name), then the program's functions, types, enum members and constants.
void sema_complete_scope(Sema* s) {
    let seen: StrTab;
    memset((*void)&seen, 0, sizeof(StrTab));
    StrTab_set(&seen, "__eskiu_complete__", 1);
    int d = s.depth;
    while (d >= 0) {
        List<string> ns;
        List_init<string>(&ns, 8);
        List<string> ts;
        List_init<string>(&ts, 8);
        let local: StrTab;
        memset((*void)&local, 0, sizeof(StrTab));
        int i = List_len<Sym>(&s.syms) - 1;
        while (i >= 0) {
            Sym y = List_get<Sym>(&s.syms, i);
            if (y.depth == d && StrTab_has(&local, y.name) == 0
                && (d > 0 || (StrTab_has(&s.gvar_set, y.name) == 1 && StrTab_has(&s.late_globals, y.name) == 0))) {
                StrTab_set(&local, y.name, 1);
                List_push<string>(&ns, y.name);
                List_push<string>(&ts, sema_display_ty(s, y.type));
            }
            i = i - 1;
        }
        string kind = "variable";
        if (d == 0) {
            kind = "global";
        }
        sema_tool_add_group(s, &seen, kind, &ns, &ts);
        d = d - 1;
    }
    // Functions: the non-generic ones (with each non-generic struct's inline methods,
    // `S_m`), then the generic ones.
    List<string> fns;
    List_init<string>(&fns, 64);
    List<string> fds;
    List_init<string>(&fds, 64);
    List<string> gns;
    List_init<string>(&gns, 16);
    List<string> gds;
    List_init<string>(&gds, 16);
    let fseen: StrTab;
    memset((*void)&fseen, 0, sizeof(StrTab));
    int fi = 0;
    while (fi < List_len<*DeclNode>(&s.fndecls)) {
        *DeclNode fd = List_get<*DeclNode>(&s.fndecls, fi);
        fi = fi + 1;
        if (StrTab_has(&fseen, fd.name) == 1) {
            continue;
        }
        StrTab_set(&fseen, fd.name, 1);
        if (fd.kind == DK_FUNCTION && List_len<TypeParam>(&fd.type_params) > 0) {
            List_push<string>(&gns, fd.name);
            List_push<string>(&gds, sema_sig_text(s, fd.name));
        } else {
            List_push<string>(&fns, fd.name);
            List_push<string>(&fds, sema_sig_text(s, fd.name));
        }
    }
    int si = 0;
    while (si < List_len<*DeclNode>(&s.sdecls)) {
        *DeclNode sd = List_get<*DeclNode>(&s.sdecls, si);
        si = si + 1;
        if (sd.kind != DK_STRUCT || List_len<TypeParam>(&sd.type_params) > 0) {
            continue;
        }
        int mi = 0;
        while (mi < List_len<*DeclNode>(&sd.methods)) {
            string mn = sema_cat(sema_cat(sd.name, "_"), List_get<*DeclNode>(&sd.methods, mi).name);
            if (StrTab_has(&fseen, mn) == 0) {
                StrTab_set(&fseen, mn, 1);
                List_push<string>(&fns, mn);
                List_push<string>(&fds, sema_sig_text(s, mn));
            }
            mi = mi + 1;
        }
    }
    int ib = 0;
    while (ib < List_len<string>(&s.ti_base)) {
        string base = List_get<string>(&s.ti_base, ib);
        *DeclNode isd = sema_find_struct(s, sema_base_name(base));
        int mi = 0;
        while (mi < List_len<*DeclNode>(&isd.methods)) {
            *DeclNode im = List_get<*DeclNode>(&isd.methods, mi);
            string mn = sema_cat(sema_cat(sema_flat_name(base), "_"), im.name);
            if (StrTab_has(&fseen, mn) == 0) {
                StrTab_set(&fseen, mn, 1);
                List_push<string>(&fns, mn);
                List_push<string>(&fds, sema_tool_inst_sig(s, isd, im, base));
            }
            mi = mi + 1;
        }
        ib = ib + 1;
    }
    sema_tool_add_group(s, &seen, "function", &fns, &fds);
    sema_tool_add_group(s, &seen, "function", &gns, &gds);
    // Types: structs and unions, generic structs, interfaces, sum types, aliases.
    List<string> sn;
    List_init<string>(&sn, 16);
    List<string> sdt;
    List_init<string>(&sdt, 16);
    List<string> gsn;
    List_init<string>(&gsn, 8);
    List<string> gsd;
    List_init<string>(&gsd, 8);
    List<string> isn;
    List_init<string>(&isn, 8);
    List<string> isd;
    List_init<string>(&isd, 8);
    List<string> esn;
    List_init<string>(&esn, 8);
    List<string> esd;
    List_init<string>(&esd, 8);
    List<string> asn;
    List_init<string>(&asn, 8);
    List<string> asd;
    List_init<string>(&asd, 8);
    List<string> cn;
    List_init<string>(&cn, 8);
    List<string> cd;
    List_init<string>(&cd, 8);
    List<string> vn;
    List_init<string>(&vn, 8);
    List<string> vd;
    List_init<string>(&vd, 8);
    let tseen: StrTab;
    memset((*void)&tseen, 0, sizeof(StrTab));
    int ti = 0;
    while (ti < List_len<*DeclNode>(&s.tdecls)) {
        *DeclNode td = List_get<*DeclNode>(&s.tdecls, ti);
        ti = ti + 1;
        if (StrTab_has(&tseen, td.name) == 1) {
            continue;
        }
        StrTab_set(&tseen, td.name, 1);
        int generic = 0;
        if (List_len<TypeParam>(&td.type_params) > 0) {
            generic = 1;
        }
        if (td.kind == DK_STRUCT && generic == 0) {
            List_push<string>(&sn, td.name);
            List_push<string>(&sdt, sema_cat("struct ", td.name));
        }
        else if (td.kind == DK_UNION) {
            List_push<string>(&sn, td.name);
            List_push<string>(&sdt, sema_cat("union ", td.name));
        }
        else if (td.kind == DK_STRUCT) {
            List_push<string>(&gsn, td.name);
            List_push<string>(&gsd, sema_cat("struct ", td.name));
        }
        else if (td.kind == DK_INTERFACE) {
            List_push<string>(&isn, td.name);
            List_push<string>(&isd, sema_cat("interface ", td.name));
        }
        else if (td.kind == DK_TYPEALIAS) {
            List_push<string>(&asn, td.name);
            List_push<string>(&asd, sema_cat(sema_cat(sema_cat("type ", td.name), " = "), td.ret_type));
        }
        else if (td.kind == DK_ENUM && sema_is_plain_enum_decl(td) == 0 && generic == 0) {
            List_push<string>(&esn, td.name);
            List_push<string>(&esd, sema_cat("enum ", td.name));
        }
        if (td.kind == DK_ENUM && generic == 0) {
            int plain = sema_is_plain_enum_decl(td);
            int k = 0;
            while (k < List_len<Param>(&td.params)) {
                Param em = List_get<Param>(&td.params, k);
                if (plain == 1) {
                    List_push<string>(&cn, em.name);
                    List_push<string>(&cd, em.ty);
                }
                else {
                    List_push<string>(&vn, em.name);
                    List_push<string>(&vd, td.name);
                }
                k = k + 1;
            }
        }
    }
    sema_tool_add_group(s, &seen, "struct", &sn, &sdt);
    sema_tool_add_group(s, &seen, "struct", &gsn, &gsd);
    sema_tool_add_group(s, &seen, "interface", &isn, &isd);
    sema_tool_add_group(s, &seen, "enum", &esn, &esd);
    sema_tool_add_group(s, &seen, "type", &asn, &asd);
    sema_tool_add_group(s, &seen, "enummember", &cn, &cd);
    sema_tool_add_group(s, &seen, "enummember", &vn, &vd);
}

// The members `recv.` can be followed by: its struct's fields, the functions dot syntax
// reaches (`T_m` whose first parameter points to T, a generic `G_m` on an instance of G)
// and an interface's methods.
void sema_complete_members(Sema* s, string recv) {
    let seen: StrTab;
    memset((*void)&seen, 0, sizeof(StrTab));
    string t = sema_strip_nullable(sema_strip_const(recv));
    t = sema_strip_nullable(sema_dealias(s, t));
    if (sema_slice_elem(t)[0] != 0 && sema_has_star(t) == 0) {
        sema_tool_add(s, &seen, "field", "len", "int64");
        return;
    }
    string base = sema_strip_ptr_sp(sema_strip_const(t));
    string bn = sema_base_name(sema_dealias(s, base));
    *DeclNode sd = sema_find_struct(s, bn);
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(base, &targs);
    int inst = 0;
    if (sd != null && List_len<TypeParam>(&sd.type_params) > 0 && List_len<string>(&targs) == List_len<TypeParam>(&sd.type_params)) {
        inst = 1;
    }
    string nb = bn;
    if (inst == 1) {
        nb = sema_flat_name(base);
    }
    if (sd != null && (List_len<TypeParam>(&sd.type_params) == 0 || inst == 1)) {
        int i = 0;
        while (i < List_len<Param>(&sd.params)) {
            Param f = List_get<Param>(&sd.params, i);
            sema_tool_add(s, &seen, "field", f.name, sema_subst_params(f.ty, &sd.type_params, &targs));
            i = i + 1;
        }
    }
    // `nb_m(*nb self, ...)`: the program's functions and a non-generic struct's inline methods.
    string prefix = sema_cat(nb, "_");
    int pl = sema_slen(prefix);
    List<string> mns;
    List_init<string>(&mns, 16);
    List<string> mds;
    List_init<string>(&mds, 16);
    let fseen: StrTab;
    memset((*void)&fseen, 0, sizeof(StrTab));
    int fi = 0;
    while (fi < List_len<*DeclNode>(&s.fndecls)) {
        *DeclNode fd = List_get<*DeclNode>(&s.fndecls, fi);
        fi = fi + 1;
        if (List_len<TypeParam>(&fd.type_params) > 0 || StrTab_has(&fseen, fd.name) == 1) {
            continue;
        }
        if (sema_slen(fd.name) <= pl || sema_streq(sema_sub_str(fd.name, 0, pl), prefix) == 0) {
            continue;
        }
        if (List_len<Param>(&fd.params) == 0) {
            continue;
        }
        string p0 = sema_strip_const(List_get<Param>(&fd.params, 0).ty);
        if (sema_has_star(p0) == 0) {
            continue;
        }
        string pe = sema_strip_ptr_sp(p0);
        if (sema_streq(pe, bn) == 0 && sema_streq(sema_flat_name(sema_dealias(s, pe)), nb) == 0) {
            continue;
        }
        StrTab_set(&fseen, fd.name, 1);
        List_push<string>(&mns, sema_sub_str(fd.name, pl, sema_slen(fd.name)));
        List_push<string>(&mds, sema_sig_text(s, fd.name));
    }
    if (inst == 1) {                       // the instance's inline methods (`Box_int_get`)
        sema_tool_note_inst(s, base);
        int im2 = 0;
        while (im2 < List_len<*DeclNode>(&sd.methods)) {
            *DeclNode imd = List_get<*DeclNode>(&sd.methods, im2);
            string full2 = sema_cat(prefix, imd.name);
            if (StrTab_has(&fseen, full2) == 0) {
                StrTab_set(&fseen, full2, 1);
                List_push<string>(&mns, imd.name);
                List_push<string>(&mds, sema_tool_inst_sig(s, sd, imd, base));
            }
            im2 = im2 + 1;
        }
    }
    if (sd != null && sd.kind == DK_STRUCT && List_len<TypeParam>(&sd.type_params) == 0) {
        int mi = 0;
        while (mi < List_len<*DeclNode>(&sd.methods)) {
            string mn = List_get<*DeclNode>(&sd.methods, mi).name;
            string full = sema_cat(prefix, mn);
            if (StrTab_has(&fseen, full) == 0) {
                StrTab_set(&fseen, full, 1);
                List_push<string>(&mns, mn);
                List_push<string>(&mds, sema_sig_text(s, full));
            }
            mi = mi + 1;
        }
    }
    sema_tool_sort(&mns, &mds);
    int k = 0;
    while (k < List_len<string>(&mns)) {
        sema_tool_add(s, &seen, "method", List_get<string>(&mns, k), List_get<string>(&mds, k));
        k = k + 1;
    }
    if (inst == 1) {
        // A generic `G_m` with parameters, then G's own fields and inline methods.
        string gp = sema_cat(sd.name, "_");
        int gl = sema_slen(gp);
        List<string> gns;
        List_init<string>(&gns, 16);
        List<string> gds;
        List_init<string>(&gds, 16);
        let gseen: StrTab;
        memset((*void)&gseen, 0, sizeof(StrTab));
        int gi = 0;
        while (gi < List_len<*DeclNode>(&s.fndecls)) {
            *DeclNode fd = List_get<*DeclNode>(&s.fndecls, gi);
            gi = gi + 1;
            if (fd.kind != DK_FUNCTION || List_len<TypeParam>(&fd.type_params) == 0 || StrTab_has(&gseen, fd.name) == 1) {
                continue;
            }
            if (sema_slen(fd.name) <= gl || sema_streq(sema_sub_str(fd.name, 0, gl), gp) == 0 || List_len<Param>(&fd.params) == 0) {
                continue;
            }
            StrTab_set(&gseen, fd.name, 1);
            List_push<string>(&gns, sema_sub_str(fd.name, gl, sema_slen(fd.name)));
            List_push<string>(&gds, sema_sig_text(s, fd.name));
        }
        sema_tool_sort(&gns, &gds);
        int g = 0;
        while (g < List_len<string>(&gns)) {
            sema_tool_add(s, &seen, "method", List_get<string>(&gns, g), List_get<string>(&gds, g));
            g = g + 1;
        }
        int fi2 = 0;
        while (fi2 < List_len<Param>(&sd.params)) {
            Param f2 = List_get<Param>(&sd.params, fi2);
            sema_tool_add(s, &seen, "field", f2.name, f2.ty);
            fi2 = fi2 + 1;
        }
        int mi2 = 0;
        while (mi2 < List_len<*DeclNode>(&sd.methods)) {
            string mn2 = List_get<*DeclNode>(&sd.methods, mi2).name;
            sema_tool_add(s, &seen, "method", mn2, sema_sig_text(s, sema_cat(gp, mn2)));
            mi2 = mi2 + 1;
        }
    }
    *DeclNode ifd = sema_find_iface(s, bn);
    if (ifd != null) {
        int ii = 0;
        while (ii < List_len<*DeclNode>(&ifd.methods)) {
            *DeclNode im = List_get<*DeclNode>(&ifd.methods, ii);
            sema_tool_add(s, &seen, "method", im.name, sym_sig_text(im));
            ii = ii + 1;
        }
    }
}

// `R name(T a, U b)` of a declaration as written (an interface method's detail).
string sym_sig_text(*DeclNode f) {
    string r = sema_cat(sema_cat(sema_cat(f.ret_type, " "), f.name), "(");
    int i = 0;
    while (i < List_len<Param>(&f.params)) {
        Param pm = List_get<Param>(&f.params, i);
        if (i > 0) {
            r = sema_cat(r, ", ");
        }
        r = sema_cat(r, pm.ty);
        if (pm.name != null && pm.name[0] != 0) {
            r = sema_cat(sema_cat(r, " "), pm.name);
        }
        i = i + 1;
    }
    return sema_cat(r, ")");
}

// Completion at the sentinel the driver spliced in (once: the first one reached).
void sema_tool_complete_scope(Sema* s) {
    if (s.tool != 3 || s.tc_done == 1) {
        return;
    }
    s.tc_done = 1;
    sema_complete_scope(s);
}

void sema_tool_complete_members(Sema* s, string recv) {
    if (s.tool != 3 || s.tc_done == 1) {
        return;
    }
    s.tc_done = 1;
    sema_complete_members(s, recv);
}

// --hover-at: a declared or member name there, else a function's signature where it is
// used or declared, else the narrowest expression's type.
string sema_tool_hover(Sema* s) {
    int c = s.tq_col;
    int i = 0;
    while (i < List_len<int>(&s.th_col)) {
        int hc = List_get<int>(&s.th_col, i);
        int hw = List_get<int>(&s.th_w, i);
        if (hw < 1) {
            hw = 1;
        }
        string ht = List_get<string>(&s.th_ty, i);
        if (ht[0] != 0 && c >= hc && c < hc + hw) {
            return ht;
        }
        i = i + 1;
    }
    int best = -1;                         // useLocations in column order
    i = 0;
    while (i < List_len<int>(&s.tu_col)) {
        int uc = List_get<int>(&s.tu_col, i);
        string un = List_get<string>(&s.tu_name, i);
        if (c >= uc && c < uc + sema_slen(un) && sema_tool_is_fn(s, un) == 1
            && (best < 0 || uc < List_get<int>(&s.tu_col, best))) {
            best = i;
        }
        i = i + 1;
    }
    if (best >= 0) {
        return sema_sig_text(s, List_get<string>(&s.tu_name, best));
    }
    if (s.th_best_w == 0) {
        string bn = null;                  // definitionLocations in name order
        i = 0;
        while (i < List_len<string>(&s.tl_name)) {
            string dn = List_get<string>(&s.tl_name, i);
            int dc = List_get<int>(&s.tl_col, i);
            if (sema_streq(List_get<string>(&s.tl_file, i), s.primary) == 1 && List_get<int>(&s.tl_line, i) == s.tq_line
                && c >= dc && c < dc + sema_slen(dn) && sema_tool_is_fn(s, dn) == 1 && (bn == null || strcmp(dn, bn) < 0)) {
                bn = dn;
            }
            i = i + 1;
        }
        if (bn != null) {
            return sema_sig_text(s, bn);
        }
        return "";
    }
    return s.th_best;
}

string sema_tool_loc(string file, int line, int col) {
    uint8[32] nb;
    sprintf((string)&nb[0], ":%d:%d", line, col);
    return sema_cat(file, (string)&nb[0]);
}

// The declaration of a definitionLocations entry, or null.
string sema_tool_defof(Sema* s, string name) {
    int i = 0;
    while (i < List_len<string>(&s.tl_name)) {
        if (sema_streq(List_get<string>(&s.tl_name, i), name) == 1) {
            return sema_tool_loc(List_get<string>(&s.tl_file, i), List_get<int>(&s.tl_line, i), List_get<int>(&s.tl_col, i));
        }
        i = i + 1;
    }
    return null;
}

// --definition-at: a local's declaration, a member function's, a global's by name, the
// declaration under the cursor, or a declared name there.
string sema_tool_definition(Sema* s) {
    int c = s.tq_col;
    int best = -1;
    int i = 0;
    while (i < List_len<int>(&s.tdu_col)) {
        int uc = List_get<int>(&s.tdu_col, i);
        if (c >= uc && c < uc + List_get<int>(&s.tdu_w, i) && (best < 0 || uc < List_get<int>(&s.tdu_col, best))) {
            best = i;
        }
        i = i + 1;
    }
    if (best >= 0) {
        return sema_tool_loc(List_get<string>(&s.tdu_file, best), List_get<int>(&s.tdu_line, best), List_get<int>(&s.tdu_dcol, best));
    }
    // memberUses, in column order: an inline method's position, else the function's.
    List<int> order;
    List_init<int>(&order, 4);
    i = 0;
    while (i < List_len<int>(&s.tm_col)) {
        int a = 0;
        while (a < List_len<int>(&order) && List_get<int>(&s.tm_col, List_get<int>(&order, a)) < List_get<int>(&s.tm_col, i)) {
            a = a + 1;
        }
        List_push<int>(&order, i);
        int b = List_len<int>(&order) - 1;
        while (b > a) {
            List_set<int>(&order, b, List_get<int>(&order, b - 1));
            b = b - 1;
        }
        List_set<int>(&order, a, i);
        i = i + 1;
    }
    i = 0;
    while (i < List_len<int>(&order)) {
        int k = List_get<int>(&order, i);
        int mc = List_get<int>(&s.tm_col, k);
        if (c >= mc && c < mc + List_get<int>(&s.tm_w, k)) {
            string fname = List_get<string>(&s.tm_fn, k);
            *DeclNode ow = null;
            *DeclNode md = sema_tool_fn(s, fname, &ow);
            if (md != null && ow != null) {
                string of = ow.file;
                if (of == null || of[0] == 0) {
                    of = s.primary;
                }
                return sema_tool_loc(of, md.line, md.col);
            }
            string dl = sema_tool_defof(s, fname);
            if (dl != null) {
                return dl;
            }
        }
        i = i + 1;
    }
    // useLocations, in column order.
    best = -1;
    i = 0;
    while (i < List_len<int>(&s.tu_col)) {
        int uc = List_get<int>(&s.tu_col, i);
        string un = List_get<string>(&s.tu_name, i);
        if (c >= uc && c < uc + sema_slen(un) && sema_tool_defof(s, un) != null
            && (best < 0 || uc < List_get<int>(&s.tu_col, best))) {
            best = i;
        }
        i = i + 1;
    }
    if (best >= 0) {
        return sema_tool_defof(s, List_get<string>(&s.tu_name, best));
    }
    string bn = null;
    string bl = null;
    i = 0;
    while (i < List_len<string>(&s.tl_name)) {
        string dn = List_get<string>(&s.tl_name, i);
        int dc = List_get<int>(&s.tl_col, i);
        if (sema_streq(List_get<string>(&s.tl_file, i), s.primary) == 1 && List_get<int>(&s.tl_line, i) == s.tq_line
            && c >= dc && c < dc + sema_slen(dn) && (bn == null || strcmp(dn, bn) < 0)) {
            bn = dn;
            bl = sema_tool_loc(List_get<string>(&s.tl_file, i), List_get<int>(&s.tl_line, i), dc);
        }
        i = i + 1;
    }
    if (bl != null) {
        return bl;
    }
    i = 0;
    while (i < List_len<int>(&s.th_col)) {
        int hc = List_get<int>(&s.th_col, i);
        int hw = List_get<int>(&s.th_w, i);
        if (hw < 1) {
            hw = 1;
        }
        if (c >= hc && c < hc + hw) {
            return sema_tool_loc(s.primary, s.tq_line, hc);
        }
        i = i + 1;
    }
    return "";
}

// -Wall: a top-level function defined here (its last declaration's position wins, as the
// C++ map entry).
void sema_def_fn(Sema* s, *DeclNode d) {
    int i = 0;
    while (i < List_len<string>(&s.def_fns)) {
        if (sema_streq(List_get<string>(&s.def_fns, i), d.name) == 1) {
            List_set<int>(&s.def_lines, i, d.line);
            List_set<int>(&s.def_cols, i, d.col);
            return;
        }
        i = i + 1;
    }
    List_push<string>(&s.def_fns, d.name);
    List_push<int>(&s.def_lines, d.line);
    List_push<int>(&s.def_cols, d.col);
    List_push<string>(&s.def_disp, sema_fn_display(d));
}

// -Wall: the functions nothing references, in name order, after every body is checked.
void sema_warn_unused_fns(Sema* s) {
    if (s.wall == 0) {
        return;
    }
    int n = List_len<string>(&s.def_fns);
    List<int> idx;
    List_init<int>(&idx, n + 1);
    int i = 0;
    while (i < n) {
        if (StrTab_has(&s.called_fns, List_get<string>(&s.def_fns, i)) == 0) {
            List_push<int>(&idx, i);
        }
        i = i + 1;
    }
    int m = List_len<int>(&idx);
    int a = 1;
    while (a < m) {
        int v = List_get<int>(&idx, a);
        int b = a - 1;
        while (b >= 0 && strcmp(List_get<string>(&s.def_fns, List_get<int>(&idx, b)), List_get<string>(&s.def_fns, v)) > 0) {
            List_set<int>(&idx, b + 1, List_get<int>(&idx, b));
            b = b - 1;
        }
        List_set<int>(&idx, b + 1, v);
        a = a + 1;
    }
    s.cur_import = 0;
    s.in_inst = 0;
    int k = 0;
    while (k < m) {
        int j = List_get<int>(&idx, k);
        sema_lint(s, List_get<int>(&s.def_lines, j), List_get<int>(&s.def_cols, j),
                  sema_cat(sema_cat("unused function '", List_get<string>(&s.def_disp, j)), "'"));
        k = k + 1;
    }
}

// Check each queued generic instance: the template body with its type parameters bound
// to the instance's arguments. Checking one may queue more, so this runs until the
// queue drains. A failing instance is followed by a note naming it.
void sema_check_insts(Sema* s, string primary) {
    int i = 0;
    while (i < List_len<SInst>(&s.insts)) {
        SInst p = List_get<SInst>(&s.insts, i);
        *DeclNode top = p.func;
        if (p.owner != null) {
            top = p.owner;
        }
        sema_enter_decl(s, top, primary);
        s.line = p.func.line;
        s.col = p.func.col;
        if (p.depth > 64) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: generic instantiation of '%s' is nested more than 64 levels deep (infinitely recursive generic?)\n",
                   s.filename, s.line, s.col, p.display);
            return;
        }
        List<TypeParam>* tps = &p.func.type_params;
        if (p.owner != null) {
            tps = &p.owner.type_params;
        }
        List_init<string>(&s.isub_p, 4);
        List_init<string>(&s.isub_a, 4);
        List_init<string>(&s.tparams, 4);
        int k = 0;
        while (k < List_len<TypeParam>(tps) && k < List_len<string>(&p.targs)) {
            List_push<string>(&s.isub_p, List_get<TypeParam>(tps, k).name);
            List_push<string>(&s.tparams, List_get<TypeParam>(tps, k).name);
            List_push<string>(&s.isub_a, List_get<string>(&p.targs, k));
            k = k + 1;
        }
        string self_t = "";
        if (p.owner != null) {
            self_t = sema_cat(p.owner.name, "<");
            int a = 0;
            while (a < List_len<string>(&p.targs)) {
                if (a > 0) {
                    self_t = sema_cat(self_t, ",");
                }
                self_t = sema_cat(self_t, List_get<string>(&p.targs, a));
                a = a + 1;
            }
            self_t = sema_cat(self_t, ">");
        }
        int saved = s.had_error;
        s.had_error = 0;
        s.in_inst = 1;
        s.inst_depth = p.depth;
        if (p.owner == null) {
            s.cur_tmpl = p.func;
        }
        sema_check_fn(s, p.func, self_t);
        s.cur_tmpl = null;
        s.in_inst = 0;
        s.inst_depth = 0;
        if (s.had_error == 1) {
            dprintf(2, "note: %s:%d:%d: (in instantiation of %s)\n", s.filename, p.func.line, p.func.col, p.display);
        }
        if (saved == 1) {
            s.had_error = 1;
        }
        List_init<string>(&s.isub_p, 4);
        List_init<string>(&s.isub_a, 4);
        List_init<string>(&s.tparams, 4);
        i = i + 1;
    }
}

// Returns 1 if the program type-checks (no errors), 0 otherwise.
int sema_check(Sema* s, *Program prog) {
    // Every `&name` in the program: a global whose address is taken is never narrowed.
    List_init<string>(&s.gaddr, 8);
    int gi = 0;
    while (gi < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode gd = List_get<*DeclNode>(&prog.decls, gi);
        if (gd.kind == DK_FUNCTION) {
            sema_addr_names(gd.body, &s.gaddr);
        }
        else if (gd.kind == DK_VARDECL) {
            sema_addr_names_e(gd.init, &s.gaddr);
        }
        else if (gd.kind == DK_STRUCT) {
            int gm = 0;
            while (gm < List_len<*DeclNode>(&gd.methods)) {
                sema_addr_names(List_get<*DeclNode>(&gd.methods, gm).body, &s.gaddr);
                gm = gm + 1;
            }
        }
        gi = gi + 1;
    }
    memset((*void)&s.gaddr_set, 0, sizeof(StrTab));
    gi = 0;
    while (gi < List_len<string>(&s.gaddr)) {
        StrTab_set(&s.gaddr_set, List_get<string>(&s.gaddr, gi), 1);
        gi = gi + 1;
    }
    sema_register_globals(s, prog);
    sema_check_top_names(s, prog);
    int top_err = s.had_error;
    s.had_error = 0;
    sema_check_alias_cycles(s);
    if (s.had_error == 1) {   // a cyclic alias makes every later type check meaningless
        return 0;
    }
    if (top_err == 1) {   // a duplicate name: the rest is still checked (as the C++)
        s.had_error = 1;
    }
    let defined_fns: StrTab;    // top-level functions WITH a body, to catch a redefinition (a set)
    memset((*void)&defined_fns, 0, sizeof(StrTab));
    string primary = s.filename;
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    int gi0 = 0;
    while (gi0 < n) {
        *DeclNode gd = List_get<*DeclNode>(&prog.decls, gi0);
        if (gd.kind == DK_VARDECL) {
            StrTab_set(&s.late_globals, gd.name, 1);
        }
        gi0 = gi0 + 1;
    }
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        sema_enter_decl(s, d, primary);
        s.line = d.line;
        s.col = d.col;
        if (d.kind == DK_FUNCTION && d.body != null) {
            if (StrTab_has(&defined_fns, d.name) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: redefinition of function '%s'\n", s.filename, s.line, s.col, sema_fn_display(d));
            } else {
                StrTab_set(&defined_fns, d.name, 1);
            }
        }
        if (d.kind == DK_INTRINSIC) {
            if (ast_atomic_op(d.name)[0] == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: unknown intrinsic '%s'\n", s.filename, s.line, s.col, d.name);
            }
        }
        if ((d.kind == DK_FUNCTION && List_len<TypeParam>(&d.type_params) == 0) || d.kind == DK_EXTERN) {
            sema_check_sig_types(s, d);
        }
        // A type parameter is named once (`<T, T>`).
        if (d.kind == DK_FUNCTION || d.kind == DK_STRUCT || d.kind == DK_ENUM) {
            List<string> tpn;
            List_init<string>(&tpn, 2);
            int ti2 = 0;
            while (ti2 < List_len<TypeParam>(&d.type_params)) {
                string tpname = List_get<TypeParam>(&d.type_params, ti2).name;
                if (sema_in_list(&tpn, tpname) == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: duplicate type parameter '%s' in '%s'\n", s.filename, s.line, s.col, tpname, sema_fn_display(d));
                } else {
                    List_push<string>(&tpn, tpname);
                }
                ti2 = ti2 + 1;
            }
        }
        // An interface requires each method once.
        if (d.kind == DK_INTERFACE) {
            List<string> imn;
            List_init<string>(&imn, 4);
            int ii2 = 0;
            while (ii2 < List_len<*DeclNode>(&d.methods)) {
                string imname = List_get<*DeclNode>(&d.methods, ii2).name;
                if (sema_in_list(&imn, imname) == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: duplicate method '%s' in interface '%s'\n", s.filename, s.line, s.col, imname, d.name);
                } else {
                    List_push<string>(&imn, imname);
                }
                ii2 = ii2 + 1;
            }
        }
        // `must_use` asks the caller to use a result; a void function has none.
        if (d.kind == DK_FUNCTION && d.is_mustuse == 1 && sema_streq(sema_strip_const(d.ret_type), "void") == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'must_use' on '%s', which returns void (there is no result to use)\n", s.filename, s.line, s.col, sema_fn_display(d));
        }
        // `main` is called by the C runtime as `main()` or `main(argc, argv[, envp])`.
        if (d.kind == DK_FUNCTION && sema_streq(d.name, "main") == 1 && List_len<Param>(&d.params) > 0) {
            int mok = 0;
            int mnp = List_len<Param>(&d.params);
            string a0 = sema_resolve_scalar(s, List_get<Param>(&d.params, 0).ty);
            if ((mnp == 2 || mnp == 3) && (sema_streq(a0, "int") == 1 || sema_streq(a0, "int32") == 1)) {
                mok = 1;
            }
            int mi2 = 1;
            while (mok == 1 && mi2 < mnp) {
                string at = sema_strip_const(List_get<Param>(&d.params, mi2).ty);
                string abase = sema_strip_ptr_sp(at);
                int ad = sema_ptr_depth(at);
                if (!((ad == 1 && sema_streq(abase, "string") == 1)
                      || (ad == 2 && (sema_streq(abase, "char") == 1 || sema_streq(abase, "uint8") == 1 || sema_streq(abase, "int8") == 1)))) {
                    mok = 0;
                }
                mi2 = mi2 + 1;
            }
            if (mok == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: 'main' must take no parameters or (int argc, string* argv): the C runtime calls it that way\n", s.filename, s.line, s.col);
            }
        }
        // An operator overload extends an operator to a user type: one operand must be a
        // struct/union, a sum type or an interface value (mirrors the C++ check).
        if (d.kind == DK_FUNCTION && d.operator_sym != null && d.operator_sym[0] != 0) {
            int user = 0;
            int oi = 0;
            while (oi < List_len<Param>(&d.params)) {
                string ot = sema_dealias(s, List_get<Param>(&d.params, oi).ty);
                if (sema_has_star(ot) == 0 && sema_is_fn_type(ot) == 0 && sema_is_arr_ty(ot) == 0
                    && sema_is_aggregate(s, ot) == 1) {
                    user = 1;
                }
                oi = oi + 1;
            }
            if (user == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: '%s' does not overload an operator for a user type: an operand must be a struct, union, sum type or interface (built-in operands keep their built-in meaning)\n",
                       s.filename, s.line, s.col, sema_fn_display(d));
            }
            // Operand count: `!`, `~` and unary `-` take one, every other operator two.
            string op = d.operator_sym;
            int want = 2;
            if (sema_streq(op, "u-") == 1 || sema_streq(op, "!") == 1 || sema_streq(op, "~") == 1) {
                want = 1;
            }
            int got = List_len<Param>(&d.params);
            if (got != want) {
                string shown = op;
                if (sema_streq(op, "u-") == 1) {
                    shown = "-";
                }
                string cnt = "2 parameters";
                if (sema_streq(shown, "-") == 1) {
                    cnt = "1 or 2 parameters";
                }
                else if (want == 1) {
                    cnt = "1 parameter";
                }
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: operator '%s' takes %s, got %d\n", s.filename, s.line, s.col, shown, cnt, got);
            }
        }
        if (s.tool != 0 && ((d.kind == DK_FUNCTION && List_len<TypeParam>(&d.type_params) == 0) || d.kind == DK_ENUM)) {
            sema_tool_defloc(s, d.name, d.file, d.line, d.col);
        }
        if (s.tool != 0 && d.kind == DK_VARDECL && d.line > 0) {
            sema_tool_defloc(s, d.name, d.file, d.line, d.col);
            sema_tool_hsym(s, d.line, d.col, sema_slen(d.name), sema_display_ty(s, d.ret_type));
        }
        if (d.kind == DK_FUNCTION) {
            s.addr_fn = d.name;
            if (List_len<TypeParam>(&d.type_params) == 0 && d.from_import == 0 && sema_streq(d.name, "main") == 0) {
                sema_def_fn(s, d);
            }
            if (sema_streq(d.name, "main") == 1 && List_len<Param>(&d.params) > 0
                && sema_streq(List_get<Param>(&d.params, 0).name, "__argc") == 1) {
                s.in_script = 1;
                int gk = 0;
                while (gk < n) {
                    *DeclNode gv = List_get<*DeclNode>(&prog.decls, gk);
                    gk = gk + 1;
                    if (gv.kind == DK_VARDECL && gv.from_import == 0 && gv.file != null && d.file != null && sema_streq(gv.file, d.file) == 1
                        && sema_streq(gv.name, "argc") == 0 && sema_streq(gv.name, "argv") == 0
                        && StrTab_has(&s.script_lines, gv.name) == 0) {
                        StrTab_set(&s.script_lines, gv.name, gv.line);
                        StrTab_set(&s.script_cols, gv.name, gv.col);
                    }
                }
            }
            sema_check_fn(s, d, "");
            s.in_script = 0;
        }
        // A global's initializer runs at compile time (no code runs before `main`), so it
        // must be a constant expression, as in C.
        if (d.kind == DK_VARDECL) {   // a global's type must exist
            sema_check_decl_type(s, d.ret_type);
        }
        if (d.kind == DK_VARDECL && d.is_static == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'static' is only allowed on a local variable\n", s.filename, d.line, d.col);
        }
        if (d.kind == DK_TYPEALIAS) {  // so must an alias's
            sema_check_decl_type(s, d.ret_type);
        }
        if (d.kind == DK_ENUM && sema_is_plain_enum_decl(d) == 1) {
            sema_fold_enum(s, d, 1);
        }
        if (d.kind == DK_ENUM) {           // a classic enum is an int: each member value must fit it
            int adt = 0;
            int pj = 0;
            while (pj < List_len<List<string>>(&d.payloads)) {
                List<string> epl = List_get<List<string>>(&d.payloads, pj);
                if (List_len<string>(&epl) > 0) {
                    adt = 1;
                }
                pj = pj + 1;
            }
            int ej = 0;
            while (adt == 0 && List_len<TypeParam>(&d.type_params) == 0 && ej < List_len<Param>(&d.params)) {
                Param em = List_get<Param>(&d.params, ej);
                if (sema_int_lit_fits("int", em.ty) == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: enum member '%s' of '%s' has value %s, out of range for 'int'\n",
                           s.filename, s.line, s.col, em.name, d.name, em.ty);
                }
                ej = ej + 1;
            }
        }
        if (d.kind == DK_VARDECL && d.is_extern == 0 && d.init != null) {
            // The initializer is an expression like any other (names, operators, shift
            // counts), checked before the global itself is declared.
            if (d.init.kind == EK_LAMBDA && sema_is_fn_type(d.ret_type) == 1) {
                s.lam_ret = sema_fn_ret(d.ret_type);
            }
            sema_expr(s, d.init);
            s.lam_ret = "";
        }
        if (d.kind == DK_VARDECL && d.is_extern == 0 && d.init != null && d.script_init == 0
            && sema_is_const_init(s, d.init) == 0) {
            sema_error(s, sema_cat(sema_cat("initializer of global '", d.name), "' is not a compile-time constant"));
        }
        // A global's initializer converts to its type like a local's (mirrors the C++ VarDecl
        // check, which runs for globals too).
        if (d.kind == DK_VARDECL && d.is_extern == 0 && d.init != null && d.init.kind != EK_LAMBDA
            && d.ret_type != null && d.ret_type[0] != 0) {
            string gerr = sema_assign_err(s, d.ret_type, d.init);
            if (gerr[0] != 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: initializing '%s': %s\n", s.filename, s.line, s.col, d.name, gerr);
            }
        }
        if (d.kind == DK_VARDECL) {
            // every entry of the name (an `extern` declaration and the definition)
            StrTab_remove(&s.late_globals, d.name);
        }
        if (d.kind == DK_STRUCT || d.kind == DK_UNION) {
            List_init<string>(&s.tparams, 4);
            int ti = 0;
            int tn = List_len<TypeParam>(&d.type_params);
            while (ti < tn) {
                List_push<string>(&s.tparams, List_get<TypeParam>(&d.type_params, ti).name);
                ti = ti + 1;
            }
            int fi = 0;
            int fn2 = List_len<Param>(&d.params);
            while (fi < fn2) {
                sema_check_decl_type(s, List_get<Param>(&d.params, fi).ty);
                fi = fi + 1;
            }
            sema_check_fields(s, d);
            sema_check_field_defaults(s, d);
            int k = 0;
            int mm = List_len<*DeclNode>(&d.methods);
            while (k < mm) {
                sema_check_sig_types(s, List_get<*DeclNode>(&d.methods, k));
                // A generic struct's method bodies are checked per instance (sema_check_insts).
                if (tn == 0) {
                    sema_check_fn(s, List_get<*DeclNode>(&d.methods, k), d.name);
                }
                k = k + 1;
            }
            List_init<string>(&s.tparams, 4);
        }
        i = i + 1;
    }
    i = 0;                                 // defaults of a function no call reached
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && List_len<*ExprNode>(&d.param_defaults) > 0) {
            sema_pdefs(s, d.name, null, "");
        }
        if (d.kind == DK_STRUCT) {
            int m = 0;
            while (m < List_len<*DeclNode>(&d.methods)) {
                *DeclNode md = List_get<*DeclNode>(&d.methods, m);
                if (List_len<*ExprNode>(&md.param_defaults) > 0) {
                    sema_pdefs(s, sema_cat(sema_cat(d.name, "_"), md.name), d, md.name);
                }
                m = m + 1;
            }
        }
        i = i + 1;
    }
    sema_check_insts(s, primary);
    sema_finalize_generic_escapes(s);
    s.filename = primary;
    sema_check_value_cycles(s);
    sema_warn_unused_fns(s);
    if (s.had_error == 1) {
        return 0;
    }
    return 1;
}
