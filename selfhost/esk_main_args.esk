// esk_main_args.esk: the driver's options (EskOpts), the commands and the command line
// (part of esk_main.esk, imported in order)

// A phase of esk_main that does not end the run returns ESK_GO_ON; any other value is
// the driver's exit status.
const int ESK_GO_ON = -1000000;

// What the command line asks for and what the phases of esk_main pass on to each other.
struct EskOpts {
    List<string> infiles;
    string outfile;
    string mode;   // "" = compile; else --version / --test-{lexer,parser,typechecker,codegen}
    int san;   // 0 = none, 1 = address, 2 = undefined
    int no_depr;   // -Wno-deprecated: no warning at a use of a deprecated function
    int werror;   // -Werror
    int wnone;   // -w
    int wall;   // -Wall: lint warnings
    int wextra;   // -Wextra: signed/unsigned comparisons
    string tool;   // editor mode: "hover" / "definition" / "complete" / "symbols"
    string tool_at;   // its LINE:COL
    List<string> wno;   // -Wno-<name> of the other default-on warnings
    int safe;   // --safe[=LIST]: run-time checks, bits of safe_checks
    int safe_set;   // --safe was given (it wins over --dev's checks)
    int dev;   // --dev: the development profile, every --safe check and -Wall
    int compile_only;   // -c: emit an object file, do not link
    int freestanding;   // --freestanding: no libc; object only (link it yourself)
    int fp_contract;   // -ffp-contract=fast: fused multiply-add allowed (C++ FpContract)
    int strict_alias;   // -fstrict-aliasing: type-based alias information (C++ StrictAliasing)
    string triple;   // --target TRIPLE (passed to clang; picks the OS macro)
    string mcpu;   // --mcpu CPU
    string mattr;   // --mattr +f,-g: target features, passed to clang
    string reloc;   // --reloc MODEL: relocation model, passed to clang
    string subsystem;   // --subsystem console|windows: a Windows program's subsystem
    string optflag;   // -O0..-O3 (clang optimizes the emitted IR)
    int backend_eir;   // --backend=eir: build through EIR (ARM64 assembly or C99), no LLVM IR
    string emit_header;   // --emit-header FILE: the C header of the `export` functions
    List<string> linkx;   // -l / -L / --link-arg, forwarded to the link
    List<string> linked;   // library names given with -l (the implied ones skip these)
    int default_libs;   // --no-default-libs clears it: link only what -l names
    int runmode;
    List<string> runargs;
    string infile;   // primary file: test modes + diagnostics
    int emit_asm;
    *Program prog;
    string eir_csrc;
    int eir_asm;
    int eir_rt;
    int eir_threads;
    Codegen g;
    string tmp;
    string cc;   // clang emits from .ll; cc/gcc can't, so no findCDriver ladder
    List<string> cargs;
    int want_obj;
    string final_out;
    int want_lib;
    List<string> xdrv;
    int cross;
    int joined_obj;
    List<string> tail;
    List<string> native_dirs;
    int win_target;
}

const string ESK_FMT_USAGE = "usage: eskiuc fmt [--check] [--width N] FILE.esk...\n\nReindent the files in place.\n  --check     change nothing; print the files that need formatting (exit 1 if any)\n  --width N   also wrap lines longer than N columns (N >= 20)\n";

// `--help`, `-help` or `-h` (cli.cpp isHelpFlag).
int esk_is_help(string a) {
    if (cg_streq(a, "--help") == 1 || cg_streq(a, "-help") == 1 || cg_streq(a, "-h") == 1) {
        return 1;
    }
    return 0;
}

// A wrong command line of a subcommand: exit code 2 (cli.cpp cliUsageError).
int esk_usage_error(string cmd, string msg) {
    eprint("error: ");
    eprint(cmd);
    eprint(": ");
    eprint(msg);
    eprint(" (see 'eskiuc ");
    eprint(cmd);
    eprint(" --help')\n");
    return 2;
}

// The package, fmt and repl commands, before any option.
int esk_commands(int argc, string* argv) {
    if (argc >= 2 && (cg_streq(argv[1], "new") == 1 || cg_streq(argv[1], "add") == 1
                      || cg_streq(argv[1], "build") == 1 || cg_streq(argv[1], "fetch") == 1
                      || cg_streq(argv[1], "test") == 1)) {
        eprint("error: '");
        eprint(argv[1]);
        eprint("' is a package command of the C++ eskiuc only\n");
        return 1;
    }
    if (argc >= 2 && cg_streq(argv[1], "fmt") == 1) {
        int check = 0;
        int width = 0;
        List<string> ffiles;
        List_init<string>(&ffiles, 2);
        int fj = 2;
        while (fj < argc) {
            if (esk_is_help(argv[fj]) == 1) {
                printf("%s", ESK_FMT_USAGE);
                return 0;
            }
            fj = fj + 1;
        }
        fj = 2;
        while (fj < argc) {
            string wv = null;
            if (cg_streq(argv[fj], "--width") == 1) {
                if (fj + 1 >= argc) {
                    return esk_usage_error("fmt", "--width needs a value");
                }
                fj = fj + 1;
                wv = argv[fj];
            }
            else if (str_starts(argv[fj], "--width=") == 1) {
                wv = str_after(argv[fj], 8);
            }
            if (wv != null) {
                int wl = (int)strlen(wv);
                width = wl == 0 || wl > 5 ? -1 : 0;
                for (wi in 0..wl) {
                    if (width >= 0) {
                        width = (int)wv[wi] >= 48 && (int)wv[wi] <= 57 ? width * 10 + ((int)wv[wi] - 48) : -1;
                    }
                }
                if (width < 20) {
                    return esk_usage_error("fmt", cg_cat(cg_cat("--width needs a number of at least 20, not '", wv), "'"));
                }
            }
            else if (cg_streq(argv[fj], "--check") == 1) {
                check = 1;
            }
            else if ((int)argv[fj][0] == 45 && argv[fj][1] != 0) {
                return esk_usage_error("fmt", cg_cat(cg_cat("unknown option '", argv[fj]), "'"));
            }
            else {
                List_push<string>(&ffiles, argv[fj]);
            }
            fj = fj + 1;
        }
        return run_fmt(&ffiles, check, width);
    }
    if (argc >= 2 && cg_streq(argv[1], "repl") == 1) {
        eprint("error: the REPL needs the C++ eskiuc\n");
        return 1;
    }
    return ESK_GO_ON;
}

// The options' defaults.
void esk_opts_init(EskOpts* o) {
    List_init<string>(&o.infiles, 2);
    o.outfile = null;
    o.mode = "";
    o.san = 0;
    o.no_depr = 0;
    o.werror = 0;
    o.wnone = 0;
    o.wall = 0;
    o.wextra = 0;
    o.tool = "";
    o.tool_at = "";
    List_init<string>(&o.wno, 4);
    o.safe = 0;
    o.safe_set = 0;
    o.dev = 0;
    o.compile_only = 0;
    o.freestanding = 0;
    o.fp_contract = 0;
    o.strict_alias = 0;
    o.triple = "";
    o.mcpu = "";
    o.mattr = "";
    o.reloc = "";
    o.subsystem = "";
    o.optflag = "";
    o.backend_eir = 0;
    o.emit_header = null;
    List_init<string>(&o.linkx, 4);
    List_init<string>(&o.linked, 4);
    o.default_libs = 1;
}

// The command line into `o` (an error is reported and returns 1).
int esk_parse_args(EskOpts* o, int argc, string* argv) {
    o.runmode = 0;
    List_init<string>(&o.runargs, 2);
    int start = 1;
    if (argc >= 2 && cg_streq(argv[1], "run") == 1) {
        o.runmode = 1;
        start = 2;
    }
    int gotscript = 0;
    int sawsep = 0;
    int ai = start;
    while (ai < argc) {
        string a = argv[ai];
        if (o.runmode == 1 && gotscript == 1) {
            // Everything after the script is program argv; a `--` right after it only
            // separates, so it is dropped (like the C++ `run`).
            if (sawsep == 0 && List_len<string>(&o.runargs) == 0 && cg_streq(a, "--") == 1) {
                sawsep = 1;
            }
            else {
                List_push<string>(&o.runargs, a);
            }
            ai = ai + 1;
            continue;
        }
        // `run -- script.esk`: a `--` before the script ends the compiler flags, and the
        // next argument is the script even if it starts with '-' (like the C++ `run`).
        if (o.runmode == 1 && cg_streq(a, "--") == 1) {
            if (ai + 1 < argc) {
                List_push<string>(&o.infiles, argv[ai + 1]);
                gotscript = 1;
            }
            ai = ai + 2;
            continue;
        }
        // Options with a value take it as the next argument or after `=`.
        string val = null;
        string opt = a;
        int eqi = 0;
        while (a[eqi] != 0 && (int)a[eqi] != 61) {
            eqi = eqi + 1;
        }
        if ((int)a[0] == 45 && a[eqi] == 61) {
            opt = str_prefix(a, eqi);
            val = str_after(a, eqi + 1);
        }
        if (is_value_opt(opt) == 1 && val == null) {
            if (ai + 1 >= argc) {
                eprint("error: option '");
                eprint(opt);
                eprint("' needs a value\n");
                return 2;
            }
            ai = ai + 1;
            val = argv[ai];
        }
        if (cg_streq(opt, "-o") == 1) {
            o.outfile = val;
        }
        else if (cg_streq(opt, "--hover-at") == 1 || cg_streq(opt, "-hover-at") == 1) {
            o.tool = "hover";
            o.tool_at = val;
        }
        else if (cg_streq(opt, "--definition-at") == 1 || cg_streq(opt, "-definition-at") == 1) {
            o.tool = "definition";
            o.tool_at = val;
        }
        else if (cg_streq(opt, "--complete-at") == 1 || cg_streq(opt, "-complete-at") == 1) {
            o.tool = "complete";
            o.tool_at = val;
        }
        else if (cg_streq(a, "--symbols") == 1 || cg_streq(a, "-symbols") == 1) {
            o.tool = "symbols";
        }
        else if (cg_streq(opt, "--target") == 1 || cg_streq(opt, "-target") == 1) {
            o.triple = val;
        }
        else if (cg_streq(opt, "--mcpu") == 1 || cg_streq(opt, "-mcpu") == 1) {
            o.mcpu = val;
        }
        else if (cg_streq(opt, "--mattr") == 1 || cg_streq(opt, "-mattr") == 1) {
            o.mattr = val;
        }
        else if (cg_streq(opt, "--reloc") == 1 || cg_streq(opt, "-reloc") == 1) {
            if (cg_streq(val, "static") == 0 && cg_streq(val, "pic") == 0 && cg_streq(val, "dynamic-no-pic") == 0
                && cg_streq(val, "ropi") == 0 && cg_streq(val, "rwpi") == 0 && cg_streq(val, "ropi-rwpi") == 0) {
                eprint("error: invalid --reloc '");
                eprint(val);
                eprint("' (use static, pic, dynamic-no-pic, ropi, rwpi or ropi-rwpi)\n");
                return 2;
            }
            o.reloc = val;
        }
        else if (cg_streq(opt, "--subsystem") == 1 || cg_streq(opt, "-subsystem") == 1) {
            if (cg_streq(val, "console") == 0 && cg_streq(val, "windows") == 0) {
                eprint("error: invalid --subsystem '");
                eprint(val);
                eprint("' (use console or windows)\n");
                return 2;
            }
            o.subsystem = val;
        }
        else if (cg_streq(opt, "--link-arg") == 1 || cg_streq(opt, "-link-arg") == 1) {
            List_push<string>(&o.linkx, val);
        }
        else if (cg_streq(opt, "-l") == 1) {
            List_push<string>(&o.linkx, cg_cat("-l", val));
            List_push<string>(&o.linked, val);
        }
        else if (cg_streq(opt, "-L") == 1) {
            List_push<string>(&o.linkx, cg_cat("-L", val));
        }
        else if ((int)a[0] == 45 && (int)a[1] == 108 && a[2] != 0) {                                   // -lfoo
            List_push<string>(&o.linkx, a);
            List_push<string>(&o.linked, str_after(a, 2));
        }
        else if ((int)a[0] == 45 && (int)a[1] == 76 && a[2] != 0) {    // -Lpath
            List_push<string>(&o.linkx, a);
        }
        else if ((int)a[0] == 45 && (int)a[1] == 79) {                                                 // -O<n>
            if (cg_streq(opt, "-O") == 1) {
                a = cg_cat("-O", val);
            }
            if (a[2] == 0 || a[3] != 0 || (int)a[2] < 48 || (int)a[2] > 51) {
                eprint("error: invalid optimization level '");
                eprint(a);
                eprint("' (use -O0, -O1, -O2 or -O3)\n");
                return 2;
            }
            o.optflag = a;
        }
        else if (cg_streq(a, "-c") == 1) {
            o.compile_only = 1;
        }
        else if (cg_streq(a, "--no-default-libs") == 1 || cg_streq(a, "-no-default-libs") == 1) {
            o.default_libs = 0;
        }
        else if (cg_streq(a, "--freestanding") == 1 || cg_streq(a, "-freestanding") == 1) {
            o.freestanding = 1;
        }
        else if (cg_streq(a, "--asan") == 1) {
            o.san = 1;
        }
        else if (cg_streq(a, "--ubsan") == 1) {
            o.san = 2;
        }
        else if (cg_streq(opt, "--emit-header") == 1 || cg_streq(opt, "-emit-header") == 1) {
            o.emit_header = val;
        }
        else if (cg_streq(opt, "--backend") == 1 || cg_streq(opt, "-backend") == 1) {
            if (cg_streq(val, "eir") == 1) {
                o.backend_eir = 1;
            }
            else if (cg_streq(val, "llvm") == 1) {
                o.backend_eir = 0;
            }
            else {
                eprint("error: invalid --backend '");
                eprint(val);
                eprint("' (use llvm or eir)\n");
                return 2;
            }
        }
        else if (cg_streq(opt, "-ffp-contract") == 1 || cg_streq(opt, "--ffp-contract") == 1) {
            if (cg_streq(val, "fast") == 1) {
                o.fp_contract = 1;
            }
            else if (cg_streq(val, "off") == 1) {
                o.fp_contract = 0;
            }
            else {
                eprint("error: invalid -ffp-contract value '");
                eprint(val);
                eprint("' (use off or fast)\n");
                return 2;
            }
        }
        else if (cg_streq(a, "-fstrict-aliasing") == 1 || cg_streq(a, "--fstrict-aliasing") == 1) {
            o.strict_alias = 1;
        }
        else if (cg_streq(a, "-fno-strict-aliasing") == 1 || cg_streq(a, "--fno-strict-aliasing") == 1) {
            o.strict_alias = 0;
        }
        else if (cg_streq(opt, "--diagnostics") == 1 || cg_streq(opt, "-diagnostics") == 1) {
            if (cg_streq(val, "text") == 0 && cg_streq(val, "json") == 0) {   // json: diag_json_fork in main
                eprint("error: invalid --diagnostics value '");
                eprint(val);
                eprint("' (use text or json)\n");
                return 2;
            }
        }
        else if (cg_streq(opt, "--safe") == 1 || cg_streq(opt, "-safe") == 1) {
            o.safe = safe_checks(val);
            o.safe_set = 1;
            if (o.safe < 0) {
                return 2;
            }
        }
        else if (cg_streq(a, "--dev") == 1 || cg_streq(a, "-dev") == 1) {
            o.dev = 1;
        }
        else if (cg_streq(a, "-Wno-deprecated") == 1 || cg_streq(a, "--Wno-deprecated") == 1) {
            o.no_depr = 1;
        }
        else if (cg_streq(a, "-Werror") == 1 || cg_streq(a, "--Werror") == 1) {
            o.werror = 1;
        }
        else if (cg_streq(a, "-w") == 1) {
            o.wnone = 1;
        }
        else if (cg_streq(a, "-Wno-string-compare") == 1 || cg_streq(a, "-Wno-address-of-packed-member") == 1
              || cg_streq(a, "-Wno-dangling-pointer") == 1 || cg_streq(a, "-Wno-frame-larger-than") == 1
              || cg_streq(a, "-Wno-format") == 1 || cg_streq(a, "-Wno-unused-result") == 1
              || cg_streq(a, "-Wno-await-holding-lock") == 1) {
            List_push<string>(&o.wno, (string)((*uint8)a + 5));
        }
        else if (cg_streq(a, "-Wall") == 1 || cg_streq(a, "--Wall") == 1) {
            o.wall = 1;
        }
        else if (cg_streq(a, "-Wextra") == 1 || cg_streq(a, "--Wextra") == 1) {
            o.wextra = 1;
        }
        else if (cg_streq(a, "--version") == 1
                || cg_streq(a, "--test-lexer") == 1
                || cg_streq(a, "--test-parser") == 1
                || cg_streq(a, "--test-typechecker") == 1
                || cg_streq(a, "--test-codegen") == 1
                || cg_streq(a, "--test-eir") == 1
                || cg_streq(a, "--emit-c") == 1
                || cg_streq(a, "--emit-asm") == 1) {
            o.mode = a;
        }
        else if (is_value_opt(opt) == 1) {
            eprint("error: option '");
            eprint(opt);
            eprint("' is not supported by the self-hosted driver\n");
            return 2;
        }
        else if ((int)a[0] == 45 && a[1] != 0) {
            eprint("error: unknown option '");
            eprint(a);
            eprint("'\n");
            return 2;
        }
        else {
            List_push<string>(&o.infiles, a);
            gotscript = 1;
        }
        ai = ai + 1;
    }
    if (o.dev == 1) {   // --dev (C++ Dev): every check unless --safe=LIST, and -Wall
        if (o.safe_set == 0) {
            o.safe = 7;
        }
        o.wall = 1;
    }
    return ESK_GO_ON;
}

// The inputs and the output, and the options the EIR backend refuses.
int esk_check_args(EskOpts* o) {
    if (o.runmode == 1) {
        o.outfile = null;
    }
    if (cg_streq(o.mode, "--version") == 1) {
        printf("Eskiu 0.16.3\n");
        return 0;
    }
    if (List_len<string>(&o.infiles) == 0) {
        eprint("usage: esk_main [-o <out>] [-c] [-O<n>] [--target T] [--asan|--ubsan] [--safe[=LIST]] [--dev] [--freestanding] [-l<lib>] [-L<dir>] [--link-arg A] [--no-default-libs] [--test-*] <file.esk> [more.esk ...]\n");
        return 2;
    }
    o.infile = List_get<string>(&o.infiles, 0);
    if (o.outfile != null && o.runmode == 0) {
        string oc = canonical_path(o.outfile);
        int ii = 0;
        while (ii < List_len<string>(&o.infiles)) {
            if (cg_streq(canonical_path(List_get<string>(&o.infiles, ii)), oc) == 1) {
                eprint("error: output file '");
                eprint(o.outfile);
                eprint("' would overwrite the input '");
                eprint(List_get<string>(&o.infiles, ii));
                eprint("'\n");
                return 1;
            }
            ii = ii + 1;
        }
    }
    if (o.runmode == 0) {
        make_parent_dir(o.outfile);
        make_parent_dir(o.emit_header);
    }
    o.emit_asm = cg_streq(o.mode, "--emit-asm");
    if (o.emit_asm == 1 || (o.backend_eir == 1 && o.mode[0] == 0)) {
        List<string> bad;
        List_init<string>(&bad, 4);
        if (o.optflag[0] != 0 && o.optflag[2] != '0' && o.emit_asm == 1) {
            List_push<string>(&bad, o.optflag);
        }
        if (o.safe != 0) {
            List_push<string>(&bad, "--safe");
        }
        if (o.freestanding == 1) {
            List_push<string>(&bad, "--freestanding");
        }
        if (o.san == 1) {
            List_push<string>(&bad, "--asan");
        }
        if (o.san == 2) {
            List_push<string>(&bad, "--ubsan");
        }
        if (o.mcpu[0] != 0) {
            List_push<string>(&bad, "--mcpu");
        }
        if (o.mattr[0] != 0) {
            List_push<string>(&bad, "--mattr");
        }
        if (o.reloc[0] != 0) {
            List_push<string>(&bad, "--reloc");
        }
        for (bi in 0..List_len<string>(&bad)) {
            eprint("error: ");
            eprint(List_get<string>(&bad, bi));
            eprint(" is not supported by the EIR backend\n");
        }
        if (List_len<string>(&bad) > 0) {
            return 1;
        }
    }
    return ESK_GO_ON;
}
