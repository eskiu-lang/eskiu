// sema_stmt_walk.esk: the statement walk (sema_stmt_k), which dispatches on the kind to
// sema_stmt_walk_*.esk (part of sema_stmt.esk, imported in order)

// The cases of sema_stmt_k, defined in later parts.
void sema_stmt_block(Sema* s, *StmtNode st, int k);
void sema_stmt_vardecl(Sema* s, *StmtNode st, int k);
void sema_stmt_return(Sema* s, *StmtNode st, int k);
void sema_stmt_if(Sema* s, *StmtNode st, int k);
void sema_stmt_while(Sema* s, *StmtNode st, int k);
void sema_stmt_for(Sema* s, *StmtNode st, int k);
void sema_stmt_forin(Sema* s, *StmtNode st, int k);
void sema_stmt_break_continue(Sema* s, *StmtNode st, int k);
void sema_stmt_switch_match(Sema* s, *StmtNode st, int k);
void sema_stmt_try(Sema* s, *StmtNode st, int k);
void sema_stmt_asm(Sema* s, *StmtNode st, int k);
void sema_stmt_arm(Sema* s, *StmtNode st, int k);
void sema_stmt_catch(Sema* s, *StmtNode st, int k);

void sema_stmt_k(Sema* s, *StmtNode st) {
    if (st == null) {
        return;
    }
    int k = st.kind;
    if (k == SK_BLOCK) {
        sema_stmt_block(s, st, k);
        return;
    }
    if (k == SK_VARDECL) {
        sema_stmt_vardecl(s, st, k);
        return;
    }
    if (k == SK_RETURN) {
        sema_stmt_return(s, st, k);
        return;
    }
    if (k == SK_THROW) {
        if (s.wasm == 1) {
            sema_error(s, "exceptions are not supported on WebAssembly targets");
        }
        sema_expr(s, st.expr);
        if (st.expr != null && sema_is_void_value(sema_infer_type(s, st.expr)) == 1) {
            sema_error(s, "cannot throw a 'void' value");
        }
        return;
    }
    if (k == SK_THREADJOIN) {
        sema_expr(s, st.expr);
        sema_drop_global_narrowings(s);   // the joined thread may have assigned any global
        string jt = sema_infer_type(s, st.expr);
        if (jt[0] != 0 && sema_streq(sema_strip_nullable(sema_canon(s, jt)), "*void") == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: thread_join expects a thread handle ('*void' from thread_create), got '%s'\n", s.filename, s.line, s.col, jt);
        }
        return;
    }
    if (k == SK_EXPR) {
        sema_expr(s, st.expr);
        // A bare call to a must_use function discards its result — reject it.
        string fname = sema_discarded_must_use(s, st.expr);
        if (fname[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: result of '%s' must be used (it is marked must_use)\n", s.filename, s.line, s.col, fname);
        }
        sema_warn_unused_result(s, st.expr);
        return;
    }
    if (k == SK_IF) {
        sema_stmt_if(s, st, k);
        return;
    }
    if (k == SK_WHILE) {
        sema_stmt_while(s, st, k);
        return;
    }
    if (k == SK_DOWHILE) {
        sema_drop_assigned(s, st);
        sema_mark_addr_in(s, st.s1);
        sema_lbl_push(s, st.label);
        sema_stmt(s, st.s1);
        sema_lbl_pop(s);
        sema_warn_assign_cond(s, st.expr);
        sema_cond(s, st.expr);
        return;
    }
    if (k == SK_FOR) {
        sema_stmt_for(s, st, k);
        return;
    }
    if (k == SK_FORIN) {
        sema_stmt_forin(s, st, k);
        return;
    }
    if (k == SK_BREAK || k == SK_CONTINUE) {
        sema_stmt_break_continue(s, st, k);
        return;
    }
    if (k == SK_SWITCH || k == SK_MATCH) {
        sema_stmt_switch_match(s, st, k);
        return;
    }
    if (k == SK_CASE) {
        sema_expr(s, st.expr);             // case value (null for default)
        int i = 0;                         // in the switch's scope: a declaration here is
        int n = List_len<*StmtNode>(&st.items);   // visible in the cases after it
        while (i < n) {
            sema_stmt(s, List_get<*StmtNode>(&st.items, i));
            i = i + 1;
        }
        return;
    }
    if (k == SK_TRY) {
        sema_stmt_try(s, st, k);
        return;
    }
    if (k == SK_DEFER) {
        sema_defer_walk(s, st.s1, 0);      // no return / escaping break|continue in a defer body
        sema_stmt(s, st.s1);               // deferred body
        return;
    }
    if (k == SK_ASM) {
        sema_stmt_asm(s, st, k);
        return;
    }
    if (k == SK_ARM) {
        sema_stmt_arm(s, st, k);
        return;
    }
    if (k == SK_CATCH) {
        sema_stmt_catch(s, st, k);
        return;
    }
}
