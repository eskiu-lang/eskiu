        cg_emit(g, "  store ptr ");
        cg_emit(g, env);
        cg_emit(g, ", ptr ");
        cg_emit(g, c1);
        cg_emit(g, "\n");
        string r = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, r);
        cg_emit(g, " = load %closure, ptr ");
        cg_emit(g, c);
        cg_emit(g, "\n");
        v.op = r;
        v.ty = "%closure";
        v.ety = "";
        return v;
    }

    v.op = "0";
    v.ty = "i32";
    return v;
}
