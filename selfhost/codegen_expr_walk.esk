// codegen_expr_walk.esk: the expression walk (cg_expr_i), which dispatches on the kind to
// codegen_expr_walk_*.esk (part of codegen_expr.esk, imported in order)

// The cases of cg_expr_i, defined in later parts.
CgVal cg_expr_literal(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_ident(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_incdec(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_slice(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_slice_len(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_field_read(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_unary(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_binary(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_call(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_templatecall(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_sizeof(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_cast(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_ternary(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_question(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_allocwith(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_threadcreate(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_freeclosure(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_structinit(Codegen* g, *ExprNode e, CgVal v);
CgVal cg_expr_lambda(Codegen* g, *ExprNode e, CgVal v);

CgVal cg_expr_i(Codegen* g, *ExprNode e) {
    let v: CgVal;
    v.ety = "";
    if (e == null) {
        v.op = "0";
        v.ty = "i32";
        return v;
    }

    if (e.kind == EK_LITERAL) {
        return cg_expr_literal(g, e, v);
    }

    if (e.kind == EK_IDENT) {
        return cg_expr_ident(g, e, v);
    }

    if (e.kind == EK_INCDEC) {
        return cg_expr_incdec(g, e, v);
    }

    if (e.kind == EK_MEMBER) {                          // a bitfield member read masks/shifts
        string bet = cg_etype(g, e.a);
        string sn = bet;
        if (cg_is_ptr_ty(bet) == 1) {
            sn = cg_strip_ptr(bet);
        }
        CgBF slot = cg_bf(g, sn, e.sval);
        if (slot.bw > 0) {
            string sn2 = "";
            string baseptr = cg_member_baseptr(g, e.a, &sn2);
            g.bf_vol = cg_vol(g, e);
            CgVal bv = cg_bf_read(g, baseptr, sn2, slot);
            g.bf_vol = "";
            return bv;
        }
    }
    // Slice construction: base[lo..hi] → a fat pointer { &base[lo], hi - lo }.
    if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) > 0) {
        return cg_expr_slice(g, e, v);
    }
    // Slice `.len` → the fat pointer's length field (i64).
    if (e.kind == EK_MEMBER && cg_streq(e.sval, "len") == 1 && cg_is_slice(cg_etype(g, e.a)) == 1) {
        return cg_expr_slice_len(g, e, v);
    }
    if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) == 0) {   // overloaded subscript `base[i]`
        string iopn = cg_op_resolve(g, "[]", cg_etype(g, e.a), cg_etype(g, e.b));
        if (iopn[0] != 0) {
            return cg_op_call(g, iopn, e.a, e.b);
        }
    }
    if (e.kind == EK_MEMBER || e.kind == EK_INDEX) {
        return cg_expr_field_read(g, e, v);
    }

    if (e.kind == EK_UNARY) {
        return cg_expr_unary(g, e, v);
    }

    if (e.kind == EK_BINARY) {
        return cg_expr_binary(g, e, v);
    }

    if (e.kind == EK_CALL) {
        return cg_expr_call(g, e, v);
    }

    if (e.kind == EK_TEMPLATECALL) {
        return cg_expr_templatecall(g, e, v);
    }

    if (e.kind == EK_SIZEOF) {
        return cg_expr_sizeof(g, e, v);
    }

    if (e.kind == EK_CAST) {
        return cg_expr_cast(g, e, v);
    }

    if (e.kind == EK_TERNARY) {
        return cg_expr_ternary(g, e, v);
    }

    if (e.kind == EK_QUESTION) {
        return cg_expr_question(g, e, v);
    }

    if (e.kind == EK_ALLOCWITH) {
        return cg_expr_allocwith(g, e, v);
    }

    if (e.kind == EK_THREADCREATE) {
        return cg_expr_threadcreate(g, e, v);
    }

    if (e.kind == EK_FREECLOSURE) {
        return cg_expr_freeclosure(g, e, v);
    }

    if (e.kind == EK_ARRAYLIT) {
        // Only a variable initializer takes `{...}` (cg_array_init / cg_global_init); as a
        // value anywhere else (a struct-literal field, an argument) it is an error, as in C++.
        dprintf(2, "error: an array literal '{...}' is only valid as a variable initializer\n");
        exit(1);
    }
    if (e.kind == EK_STRUCTINIT) {
        return cg_expr_structinit(g, e, v);
    }

    if (e.kind == EK_LAMBDA) {
        return cg_expr_lambda(g, e, v);
    }

    v.op = "0";
    v.ty = "i32";
    return v;
}
