// Part of codegen.esk (statements), imported from it in order; compile codegen.esk, not this file alone.

void cg_stmt(Codegen* g, *StmtNode st) {
    if (st == null) {
        return;
    }
    if (st.kind == SK_BLOCK) {
        int mark = List_len<*StmtNode>(&g.cleanups);   // this block's cleanup frame
        int lmark = List_len<CgLocal>(&g.locals);      // and its variable scope
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            if (g.terminated == 1) {          // rest of the block is unreachable
                i = n;
            }
            else {
                cg_stmt(g, List_get<*StmtNode>(&st.items, i));
                i = i + 1;
            }
        }
        if (g.terminated == 0) {   // fall-through: defers only
            cg_run_cleanups(g, mark, 0);
        }
        cg_cleanups_trunc(g, mark);
        cg_locals_trunc(g, lmark);
        return;
    }
    if (st.kind == SK_DEFER) {
        cg_push_cleanup(g, st.s1, st.is_err);          // emitted at scope exit; errdefer only on the error path
        if (g.prog_eh == 1 && st.is_err == 0) {   // and on the exceptional path
            cg_defer_pad(g);
        }
        return;
    }
    if (st.kind == SK_IF) {
        // An `else if` chain is emitted with a loop (mirrors CodeGen::visit(IfStmt)). Each
        // link's else body is a scope of its own (as cg_scoped_stmt makes it); those scopes
        // and the branches to each link's end label are closed innermost first.
        List<string> ends;
        List_init<string>(&ends, 2);
        List<int> marks;
        List_init<int>(&marks, 2);
        List<int> lmarks;
        List_init<int>(&lmarks, 2);
        *StmtNode n = st;
        while (n != null) {
            CgVal c = cg_cond(g, n.expr);
            string l_then = cg_lbl(g);
            string l_end = cg_lbl(g);
            string l_else = l_end;
            if (n.s2 != null) {
                l_else = cg_lbl(g);
            }
            cg_emit(g, "  br i1 ");
            cg_emit(g, c.op);
            cg_emit(g, ", label %");
            cg_emit(g, l_then);
            cg_emit(g, ", label %");
            cg_emit(g, l_else);
            cg_emit(g, "\n");
            g.terminated = 1;
            cg_label(g, l_then);
            cg_scoped_stmt(g, n.s1);
            cg_br(g, l_end);
            if (n.s2 != null && n.s2.kind == SK_IF) {
                cg_label(g, l_else);
                List_push<string>(&ends, l_end);
                List_push<int>(&marks, List_len<*StmtNode>(&g.cleanups));
                List_push<int>(&lmarks, List_len<CgLocal>(&g.locals));
                n = n.s2;
            } else {
                if (n.s2 != null) {
                    cg_label(g, l_else);
                    cg_scoped_stmt(g, n.s2);
                    cg_br(g, l_end);
                }
                cg_label(g, l_end);
                n = null;
            }
        }
        int i = List_len<string>(&ends) - 1;
        while (i >= 0) {
            int mark = List_get<int>(&marks, i);
            if (g.terminated == 0) {
                cg_run_cleanups(g, mark, 0);
            }
            cg_cleanups_trunc(g, mark);
            cg_locals_trunc(g, List_get<int>(&lmarks, i));
            string l_end = List_get<string>(&ends, i);
            cg_br(g, l_end);
            cg_label(g, l_end);
            i = i - 1;
        }
        List_free<string>(&ends);
        List_free<int>(&marks);
        List_free<int>(&lmarks);
        return;
    }
    if (st.kind == SK_WHILE) {
        string l_cond = cg_lbl(g);
        string l_body = cg_lbl(g);
        string l_end = cg_lbl(g);
        cg_br(g, l_cond);
        cg_label(g, l_cond);
        CgVal c = cg_cond(g, st.expr);
        cg_emit(g, "  br i1 ");
        cg_emit(g, c.op);
        cg_emit(g, ", label %");
        cg_emit(g, l_body);
        cg_emit(g, ", label %");
        cg_emit(g, l_end);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, l_body);
        cg_loop_push(g, l_cond, l_end, st.label);
        cg_scoped_stmt(g, st.s1);
        cg_loop_pop(g);
        cg_br(g, l_cond);
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_DOWHILE) {
        string l_body = cg_lbl(g);
        string l_cond = cg_lbl(g);
        string l_end = cg_lbl(g);
        cg_br(g, l_body);
        cg_label(g, l_body);
        cg_loop_push(g, l_cond, l_end, st.label);       // `continue` re-tests the condition
        cg_scoped_stmt(g, st.s1);
        cg_loop_pop(g);
        cg_br(g, l_cond);
        cg_label(g, l_cond);
        CgVal c = cg_cond(g, st.expr);
        cg_emit(g, "  br i1 ");
        cg_emit(g, c.op);
        cg_emit(g, ", label %");
        cg_emit(g, l_body);
        cg_emit(g, ", label %");
        cg_emit(g, l_end);
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_FOR) {
        string l_cond = cg_lbl(g);
        string l_body = cg_lbl(g);
        string l_step = cg_lbl(g);
        string l_end = cg_lbl(g);
        // The init is scoped to the loop; its wrapping block's items are emitted in the
        // loop scope itself so the loop variable stays visible to cond/step/body.
        int lmark = List_len<CgLocal>(&g.locals);
        // `for (i in A..B)`: derive the bounds' common integer type here too. A generic
        // instance's shared AST carries the type sema stamped for SOME instance, and the
        // no-sema driver (cg_main) stamps none. An unknown bound keeps the sema stamp.
        if (st.s1 != null && st.s1.kind == SK_BLOCK && List_len<*StmtNode>(&st.s1.items) == 2) {
            *StmtNode rlo = List_get<*StmtNode>(&st.s1.items, 0);
            *StmtNode rhi = List_get<*StmtNode>(&st.s1.items, 1);
            if (rlo.is_range == 1 && rhi.is_range == 1) {
                string ct = ast_range_var_type(cg_range_bound_type(g, rlo.expr), cg_range_bound_type(g, rhi.expr));
                if (ct[0] != 0) {
                    rlo.type = ct;
                    rhi.type = ct;
                }
            }
        }
        if (st.s1 != null) {
            if (st.s1.kind == SK_BLOCK) {
                int ii = 0;
                while (ii < List_len<*StmtNode>(&st.s1.items)) {
                    cg_stmt(g, List_get<*StmtNode>(&st.s1.items, ii));
                    ii = ii + 1;
                }
            } else {
                cg_stmt(g, st.s1);
            }
        }
        cg_br(g, l_cond);
        cg_label(g, l_cond);
        if (st.expr != null) {
            CgVal c = cg_cond(g, st.expr);
            cg_emit(g, "  br i1 ");
            cg_emit(g, c.op);
            cg_emit(g, ", label %");
            cg_emit(g, l_body);
            cg_emit(g, ", label %");
            cg_emit(g, l_end);
            cg_emit(g, "\n");
            g.terminated = 1;
        } else {
            cg_br(g, l_body);
        }
        cg_label(g, l_body);
        cg_loop_push(g, l_step, l_end, st.label);
        cg_scoped_stmt(g, st.s2);
        cg_loop_pop(g);
        cg_br(g, l_step);
        cg_label(g, l_step);
        if (st.expr2 != null) {
            cg_expr(g, st.expr2);
        }
        cg_br(g, l_cond);
        cg_label(g, l_end);
        cg_locals_trunc(g, lmark);
        return;
    }
    if (st.kind == SK_FORIN) {
        // `for (v in it)` has no direct IR form: desugar to a counted for over the
        // iterable's elements, then reuse the SK_FOR path (break/continue, defers). Array
        // `T[N]` → it[i], length N; slice `T[]` → it[i], length it.len; list-like struct →
        // it.data[i], length it.size. `it` is the real iterable expression, so a field
        // (`b.vals`) works, not just a bare identifier. (Async fns get this via async_lower;
        // this is the synchronous path.)
        string itty = cg_etype(g, st.expr);
        string fi = cg_cat("__fi", cg_itoa(g.lam_seq));
        g.lam_seq = g.lam_seq + 1;
        *ExprNode lengthE = cgb_lit(LIT_INT, "0");
        *ExprNode elemE = cgb_lit(LIT_INT, "0");
        // The iterable is evaluated once. Anything but a stable place (a call, a variable
        // index) is held in a local: a list-like value that has an address by a pointer to
        // it, anything else (an array, a slice, a pointer, a returned value) by value.
        *ExprNode itE = st.expr;
        if (ast_stable_place(st.expr) == 0) {
            string itv = cg_cat(fi, "_v");
            if (cg_is_slice(itty) == 0 && cg_is_array(itty) == 0 && (int)itty[0] != 42 && cg_addressable(g, st.expr) == 1) {
                *ExprNode addr = alloc<ExprNode>(1);
                addr.kind = EK_UNARY;
                addr.sval = "&";
                addr.a = st.expr;
                cg_stmt(g, cgb_vardecl(itv, cg_cat("*", itty), addr));
            } else {
                cg_stmt(g, cgb_vardecl(itv, itty, st.expr));
            }
            itE = cgb_ident(itv);
        }
        // A slice `T[]` also matches cg_is_array (both spell "T[...]"), so test slice first.
        if (cg_is_slice(itty) == 1) {
            lengthE = cgb_member(itE, "len");
            elemE = cgb_index(itE, cgb_ident(fi));
        } else if (cg_is_array(itty) == 1) {
            string cnt = cg_dim_val(g, cg_array_count(itty));
            lengthE = cgb_lit(LIT_INT, cnt);
            elemE = cgb_index(itE, cgb_ident(fi));
        } else {
            lengthE = cgb_member(itE, "size");
            elemE = cgb_index(cgb_member(itE, "data"), cgb_ident(fi));
        }
        string elemTy = st.resolved_elem;                 // sema-stamped element type (R1)
        if (elemTy[0] == 0) {   // fall back structurally (e.g. the no-sema path)
            elemTy = cg_etype(g, elemE);
        }
        *StmtNode initS = cgb_vardecl(fi, "int", cgb_lit(LIT_INT, "0"));
        *ExprNode cond = cgb_bin("<", cgb_ident(fi), lengthE);
        *ExprNode step = cgb_bin("=", cgb_ident(fi), cgb_bin("+", cgb_ident(fi), cgb_lit(LIT_INT, "1")));
        *StmtNode bodyS = cgb_block2(cgb_vardecl(st.name, elemTy, elemE), st.s1);
        *StmtNode forS = cgb_for(initS, cond, step, bodyS);
        forS.label = st.label;                            // carry the for-in's label onto the desugared loop
        cg_stmt(g, forS);
        return;
    }
    if (st.kind == SK_BREAK) {
        if (st.label != null && st.label[0] != 0) {
            // `break label`: scan the loops-only stack from innermost out for the named loop.
            int i = List_len<string>(&g.loop_lbls);
            while (i > 0) {
                i = i - 1;
                if (cg_streq(List_get<string>(&g.loop_lbls, i), st.label) == 1) {
                    cg_run_cleanups(g, List_get<int>(&g.loop_lbl_cld, i), 0);
                    cg_br(g, List_get<string>(&g.loop_lbl_end, i));
                    return;
                }
            }
            return;
        }
        int n = List_len<string>(&g.loop_end);
        if (n > 0) {
            cg_run_cleanups(g, List_get<int>(&g.loop_cldepth, n - 1), 0);   // run loop-body defers
            cg_br(g, List_get<string>(&g.loop_end, n - 1));
        }
        return;
    }
    if (st.kind == SK_CONTINUE) {
        if (st.label != null && st.label[0] != 0) {
            int i = List_len<string>(&g.loop_lbls);
            while (i > 0) {
                i = i - 1;
                if (cg_streq(List_get<string>(&g.loop_lbls, i), st.label) == 1) {
                    cg_run_cleanups(g, List_get<int>(&g.loop_lbl_cld, i), 0);
                    cg_br(g, List_get<string>(&g.loop_lbl_cont, i));
                    return;
                }
            }
            return;
        }
        // The innermost loop's depth comes from the loops-only stack: loop_cldepth also
        // holds an entry per enclosing `switch` (for break), so indexing it by the loop
        // count ran a switch case's defers on a `continue` of a loop inside that case.
        int n = List_len<string>(&g.loop_lbl_cont);
        if (n > 0) {
            cg_run_cleanups(g, List_get<int>(&g.loop_lbl_cld, n - 1), 0);
            cg_br(g, List_get<string>(&g.loop_lbl_cont, n - 1));
        }
        return;
    }
    if (st.kind == SK_VARDECL) {
        // A variable of a type with field defaults that nothing initializes starts as the
        // default value (as the C++ visit(VarDecl)).
        if (st.expr == null) {
            st.expr = cg_default_expr(g, st.type);
        }
        string ty = cg_lltype(g, st.type);
        if (st.is_static == 1) {
            // A `static` local: one instance at module scope, persists across calls.
            // Its storage is a private global; the slot is that global's pointer, so
            // ordinary load/store on the local read/write the persistent cell.
            string gname = cg_cat("@.static.", cg_itoa(g.strcount));
            g.strcount = g.strcount + 1;
            g.lam_expret = cg_lam_ret_of(st.type);  // thread fn-type return into a lambda init
            // Compute the initializer first (a string literal appends its constant to
            // g.globals; that must not land mid-line — see the module-global path).
            string sinit = cg_global_init_ty(g, st.expr, st.type);
            g.lam_expret = "";
            String_append(&g.globals, gname);
            String_append(&g.globals, " = internal global ");
            String_append(&g.globals, cg_tyval(ty, sinit));
            String_append(&g.globals, "\n");
            cg_add_local(g, st.name, gname, ty, cg_apply_sub(g, st.type));
            if (st.is_vol == 1) {
                List_push<string>(&g.vols, st.name);
            }
            return;
        }
        string slot = cg_entry_alloca(g, ty);   // hoisted to the entry block, not re-run per loop iteration
        // The name is bound after its initializer: `{ int64 x = x + 1; }` reads the outer x.
        if (st.expr != null) {
            if (st.expr.kind == EK_ARRAYLIT) {          // { ... } (nested for T[N][M]) → zero-fill + store
                cg_array_init(g, slot, st.type, st.expr, 1);
            } else if (st.expr.kind == EK_STRUCTINIT) { // P { f: v, ... } → store fields via GEP
                cg_struct_init(g, slot, st.type, st.expr);
            } else {
                g.lam_expret = cg_lam_ret_of(st.type);   // thread fn-type return into a lambda init
                cg_hint_iface(g, st.expr, st.type);
                CgVal init = cg_expr(g, st.expr);
                g.lam_expret = "";
                string iop = cg_coerce(g, init, ty);    // widen/truncate/null-coerce to the declared type
                if (cg_is_iface(g, cg_dealias(g, st.type)) == 1) {
                    iop = cg_iface_conv(g, st.type, init, st.expr);
                }
                cg_emit(g, "  store ");
                if (st.is_vol == 1) {   // an MMIO init is a volatile store
                    cg_emit(g, "volatile ");
                }
                cg_emit(g, ty);
                cg_emit(g, " ");
                cg_emit(g, iop);
                cg_emit(g, ", ptr ");
                cg_emit(g, slot);
                cg_emit(g, "\n");
            }
        } else {
            // A local declared without a value starts at zero (mirrors the C++ codegen):
            // every declaration, so each loop iteration, gets a fresh zero.
            if (cg_ll_big(g, ty) == 1) {
                cg_zero_fill(g, slot, ty);
            }
            else {
                cg_emit(g, "  store ");
                if (st.is_vol == 1) {
                    cg_emit(g, "volatile ");
                }
                cg_emit(g, ty);
                cg_emit(g, " zeroinitializer, ptr ");
                cg_emit(g, slot);
                cg_emit(g, "\n");
            }
        }
        cg_add_local(g, st.name, slot, ty, cg_apply_sub(g, st.type));
        if (st.is_vol == 1) {
            List_push<string>(&g.vols, st.name);
        }
        return;
    }
    if (st.kind == SK_SWITCH) {
        // C-style fall-through: a `switch` instruction jumps to each case's block; a
        // block flows into the next unless its body terminates (break/return). `break`
        // targets the end (pushed onto loop_end). Case values must be constants.
        CgVal subj = cg_expr(g, st.expr);
        int nc = List_len<*StmtNode>(&st.items);
        List<string> labels;
        List_init<string>(&labels, nc);
        int di = 0 - 1;                                   // default case index, -1 if none
        int i = 0;
        while (i < nc) {
            List_push<string>(&labels, cg_lbl(g));
            if (List_get<*StmtNode>(&st.items, i).expr == null) {
                di = i;
            }
            i = i + 1;
        }
        string l_end = cg_lbl(g);
        string deflbl = l_end;
        if (di >= 0) {
            deflbl = List_get<string>(&labels, di);
        }
        cg_emit(g, "  switch ");
        cg_emit(g, subj.ty);
        cg_emit(g, " ");
        cg_emit(g, subj.op);
        cg_emit(g, ", label %");
        cg_emit(g, deflbl);
        cg_emit(g, " [ ");
        i = 0;
        while (i < nc) {
            *StmtNode c = List_get<*StmtNode>(&st.items, i);
            if (c.expr != null) {
                // A constant label: fold it (`K`, `K + 10`, a top-level `const`), matching
                // the C++ back-end's constant folder.
                CgK ck = cg_cfold(g, c.expr);
                if (ck.ok == 0 || ck.isf == 1) {
                    dprintf(2, "error: switch case value must be a constant integer\n");
                    exit(1);
                }
                cg_emit(g, subj.ty);
                cg_emit(g, " ");
                cg_emit(g, cg_k_text(ck, subj.ty));
                cg_emit(g, ", label %");
                cg_emit(g, List_get<string>(&labels, i));
                cg_emit(g, " ");
            }
            i = i + 1;
        }
        cg_emit(g, "]\n");
        g.terminated = 1;
        List_push<string>(&g.loop_end, l_end);
        List_push<int>(&g.loop_cldepth, List_len<*StmtNode>(&g.cleanups));            // break → end
        int clmark = List_len<CgLocal>(&g.locals);        // the switch body is one scope (C)
        i = 0;
        while (i < nc) {
            cg_label(g, List_get<string>(&labels, i));
            *StmtNode c = List_get<*StmtNode>(&st.items, i);
            // Each case's statements are a scope: a `defer` there runs when the case body
            // is left (by `break`, or by falling through into the next case).
            int cmark = List_len<*StmtNode>(&g.cleanups);
            int bi = 0;
            int bn = List_len<*StmtNode>(&c.items);
            while (bi < bn) {
                if (g.terminated == 1) {
                    bi = bn;
                }
                else {
                    cg_stmt(g, List_get<*StmtNode>(&c.items, bi));
                    bi = bi + 1;
                }
            }
            if (g.terminated == 0) {
                cg_run_cleanups(g, cmark, 0);
            }
            cg_cleanups_trunc(g, cmark);
            if (i + 1 < nc) {   // fall through
                cg_br(g, List_get<string>(&labels, i + 1));
            }
            else {
                cg_br(g, l_end);
            }
            i = i + 1;
        }
        cg_locals_trunc(g, clmark);
        List_remove<string>(&g.loop_end, List_len<string>(&g.loop_end) - 1);
        List_remove<int>(&g.loop_cldepth, List_len<int>(&g.loop_cldepth) - 1);
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_MATCH) {
        // Classic (payload-less) enum: the subject is the enum's i32 value directly (not a
        // tagged struct). Switch on that value, one case per arm's variant CONSTANT (which
        // respects explicit `= N`). No tag read, no payload binding. `_` is the default.
        string m_sety = cg_etype(g, st.expr);
        string m_llty = cg_lltype(g, m_sety);
        string m_enm = m_llty;
        if ((int)m_llty[0] == 37) {
            int ml = 0;
            while (m_llty[ml] != 0) {
                ml = ml + 1;
            }
            m_enm = cg_sub_str(m_llty, 1, ml);
        }
        if (cg_is_adt(g, m_enm) == 0) {
            CgVal msubj = cg_expr(g, st.expr);
            int mn = List_len<*StmtNode>(&st.items);
            List<string> mlabels;
            List_init<string>(&mlabels, mn);
            int mdi = 0 - 1;
            int mi = 0;
            while (mi < mn) {
                List_push<string>(&mlabels, cg_lbl(g));
                if (cg_streq(cg_arm_var(List_get<*StmtNode>(&st.items, mi).name), "_") == 1) {
                    mdi = mi;
                }
                mi = mi + 1;
            }
            string m_end = cg_lbl(g);
            string m_def = m_end;
            if (mdi >= 0) {
                m_def = List_get<string>(&mlabels, mdi);
            }
            cg_emit(g, "  switch i32 ");
            cg_emit(g, msubj.op);
            cg_emit(g, ", label %");
            cg_emit(g, m_def);
            cg_emit(g, " [ ");
            mi = 0;
            while (mi < mn) {
                string mvn = cg_arm_var(List_get<*StmtNode>(&st.items, mi).name);
                if (cg_streq(mvn, "_") == 0) {
                    cg_emit(g, "i32 ");
                    cg_emit(g, cg_enum_val(g, mvn));
                    cg_emit(g, ", label %");
                    cg_emit(g, List_get<string>(&mlabels, mi));
                    cg_emit(g, " ");
                }
                mi = mi + 1;
            }
            cg_emit(g, "]\n");
            g.terminated = 1;
            mi = 0;
            while (mi < mn) {
                cg_label(g, List_get<string>(&mlabels, mi));
                cg_scoped_stmt(g, List_get<*StmtNode>(&st.items, mi).s1);
                cg_br(g, m_end);
                mi = mi + 1;
            }
            cg_label(g, m_end);
            return;
        }
        // Read the tag of the ADT subject, switch on it to per-arm blocks; each arm binds
        // its payload fields as locals, runs its body, then jumps to the end. A `_` arm is
        // the default. Arms don't fall through.
        CgVal lv = cg_lval(g, st.expr);
        string sptr = lv.op;
        string sety = lv.ety;
        if (sptr[0] == 0) {                               // rvalue subject — materialize
            CgVal val = cg_expr(g, st.expr);
            sety = val.ety;
            sptr = cg_entry_alloca(g, val.ty);
            cg_emit(g, "  store ");
            cg_emit(g, val.ty);
            cg_emit(g, " ");
            cg_emit(g, val.op);
            cg_emit(g, ", ptr ");
            cg_emit(g, sptr);
            cg_emit(g, "\n");
        }
        string llty = cg_lltype(g, sety);
        // The subject's (possibly mangled) enum name — disambiguates generic instances.
        string enm = llty;
        if ((int)llty[0] == 37) {
            int ll = 0;
            while (llty[ll] != 0) {
                ll = ll + 1;
            }
            enm = cg_sub_str(llty, 1, ll);
        }
        string tp = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, tp);
        cg_emit(g, " = getelementptr ");
        cg_emit(g, llty);
        cg_emit(g, ", ptr ");
        cg_emit(g, sptr);
        cg_emit(g, ", i32 0, i32 0\n");
        string tag = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, tag);
        cg_emit(g, " = load i32, ptr ");
        cg_emit(g, tp);
        cg_emit(g, "\n");

        int na = List_len<*StmtNode>(&st.items);
        List<string> alabels;
        List_init<string>(&alabels, na);
        int di = 0 - 1;
        int i = 0;
        while (i < na) {
            List_push<string>(&alabels, cg_lbl(g));
            if (cg_streq(cg_arm_var(List_get<*StmtNode>(&st.items, i).name), "_") == 1) {
                di = i;
            }
            i = i + 1;
        }
        string l_end = cg_lbl(g);
        string deflbl = l_end;
        if (di >= 0) {
            deflbl = List_get<string>(&alabels, di);
        }
        cg_emit(g, "  switch i32 ");
        cg_emit(g, tag);
        cg_emit(g, ", label %");
        cg_emit(g, deflbl);
        cg_emit(g, " [ ");
        i = 0;
        while (i < na) {
            *StmtNode arm = List_get<*StmtNode>(&st.items, i);
            string vn = cg_arm_var(arm.name);
            if (cg_streq(vn, "_") == 0) {
                CgVariant var = cg_find_variant_in(g, vn, enm);
                cg_emit(g, "i32 ");
                cg_emit(g, cg_itoa(var.tag));
                cg_emit(g, ", label %");
                cg_emit(g, List_get<string>(&alabels, i));
                cg_emit(g, " ");
            }
            i = i + 1;
        }
        cg_emit(g, "]\n");
        g.terminated = 1;
        i = 0;
        while (i < na) {
            cg_label(g, List_get<string>(&alabels, i));
            *StmtNode arm = List_get<*StmtNode>(&st.items, i);
            string vn = cg_arm_var(arm.name);
            int lbase = List_len<CgLocal>(&g.locals);     // arm-scoped bindings
            CgVariant var = cg_find_variant_in(g, vn, enm);
            List<string> binds;
            List_init<string>(&binds, 2);
            cg_arm_binds(arm.name, &binds);
            int nb = List_len<string>(&binds);
            if (nb > 0 && var.ename[0] != 0) {
                string pstruct = cg_payload_lltype(g, &var);
                string pp = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, pp);
                cg_emit(g, " = getelementptr ");
                cg_emit(g, llty);
                cg_emit(g, ", ptr ");
                cg_emit(g, sptr);
                cg_emit(g, ", i32 0, i32 1\n");
                int j = 0;
                while (j < nb && j < List_len<string>(&var.ptys)) {
                    string fety = List_get<string>(&var.ptys, j);
                    string fty = cg_lltype(g, fety);
                    string fp = cg_tmp(g);
                    cg_emit(g, "  ");
                    cg_emit(g, fp);
                    cg_emit(g, " = getelementptr ");
                    cg_emit(g, pstruct);
                    cg_emit(g, ", ptr ");
                    cg_emit(g, pp);
                    cg_emit(g, ", i32 0, i32 ");
                    cg_emit(g, cg_itoa(j));
                    cg_emit(g, "\n");
                    string ld = cg_tmp(g);
                    cg_emit(g, "  ");
                    cg_emit(g, ld);
                    cg_emit(g, " = load ");
                    cg_emit(g, fty);
                    cg_emit(g, ", ptr ");
                    cg_emit(g, fp);
                    cg_emit(g, "\n");
                    string slot = cg_entry_alloca(g, fty);
                    cg_emit(g, "  store ");
                    cg_emit(g, fty);
                    cg_emit(g, " ");
                    cg_emit(g, ld);
                    cg_emit(g, ", ptr ");
                    cg_emit(g, slot);
                    cg_emit(g, "\n");
                    cg_add_local(g, List_get<string>(&binds, j), slot, fty, fety);
                    j = j + 1;
                }
            }
            cg_scoped_stmt(g, arm.s1);
            cg_br(g, l_end);
            cg_locals_trunc(g, lbase);
            i = i + 1;
        }
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_THROW) {
        // Itanium ABI: allocate an EskiuEx { int64 size, ptr type_name, payload } with
        // the thrown value stored by its own type at offset 16 (a double, an int64 or a
        // whole struct keep their bits) and the object's byte size at offset 0 (a
        // capturing catch copies that many bytes), fill it, and __cxa_throw it (an invoke
        // inside a try so the landingpad catches it). is_err = 1 (async lowering only):
        // the value is an exception object a capturing catch copied, thrown again as is.
        g.uses_eh = 1;
        g.uses_throw = 1;
        CgVal val = cg_expr(g, st.expr);
        if (st.is_err == 1) {
            cg_emit_callish(g, "void", "@__cxa_throw", cg_cat("ptr ", cg_cat(val.op, ", ptr @_ZTIPv, ptr null")), 1);
            cg_emit(g, "  unreachable\n");
            g.terminated = 1;
            return;
        }
        string ex = cg_tmp(g);
        int psz = cg_ll_size_of(g, val.ty);
        cg_emit(g, "  ");
        cg_emit(g, ex);
        cg_emit(g, cg_cat(" = call ptr @__cxa_allocate_exception(", cg_cat(cg_size_ty(g), " ")));
        cg_emit(g, cg_itoa(16 + psz));
        cg_emit(g, ")\n");
        cg_emit(g, "  store i64 ");
        cg_emit(g, cg_itoa(16 + psz));
        cg_emit(g, ", ptr ");
        cg_emit(g, ex);
        cg_emit(g, "\n");
        string pslot = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, pslot);
        cg_emit(g, " = getelementptr i8, ptr ");
        cg_emit(g, ex);
        cg_emit(g, ", i64 16\n");
        cg_emit(g, "  store ");
        cg_emit(g, val.ty);
        cg_emit(g, " ");
        cg_emit(g, val.op);
        cg_emit(g, ", ptr ");
        cg_emit(g, pslot);
        cg_emit(g, "\n");
        string tname = cg_throw_typename(g, st.expr);
        if (cg_streq(tname, "unknown") == 1) {            // fall back to the value's LLVM type
            string mapped = cg_llty_eskiu_name(val.ty);
            if (cg_streq(mapped, "") == 0) {
                tname = mapped;
            }
        }
        tname = cg_ex_typename(g, tname);
        string tnameg = cg_string_global(g, tname);
        string tslot = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, tslot);
        cg_emit(g, " = getelementptr i8, ptr ");
        cg_emit(g, ex);
        cg_emit(g, ", i64 8\n");
        cg_emit(g, "  store ptr ");
        cg_emit(g, tnameg);
        cg_emit(g, ", ptr ");
        cg_emit(g, tslot);
        cg_emit(g, "\n");
        cg_emit_callish(g, "void", "@__cxa_throw", cg_cat("ptr ", cg_cat(ex, ", ptr @_ZTIPv, ptr null")), 1);
        cg_emit(g, "  unreachable\n");
        g.terminated = 1;
        return;
    }
    if (st.kind == SK_TRY) {
        // try body runs with calls turned into invokes (unwind → landingpad). The landingpad
        // catches everything, reads the exception's type name, and strcmp-matches each catch.
        g.uses_eh = 1;
        string lpad = cg_lbl(g);
        string ldone = cg_lbl(g);
        string ldisp = cg_lbl(g);
        string saved = g.cur_unwind;
        g.cur_unwind = lpad;
        // Register finally as a cleanup for the body's duration, so an early exit
        // (return/break/continue/`?`) inside the body runs it. Fall-through and the
        // exceptional path still emit it below, so truncate WITHOUT running here.
        int trymark = List_len<*StmtNode>(&g.cleanups);
        // (An async lowering wrapper, is_err = 1, runs its finally only on the exceptional path.)
        int fin_all = 0;
        if (st.s2 != null && st.is_err == 0) {
            fin_all = 1;
        }
        if (fin_all == 1) {
            cg_push_cleanup(g, st.s2, 0);
        }
        List_push<int>(&g.try_cld, List_len<*StmtNode>(&g.cleanups));   // body defers join ldisp
        List_push<string>(&g.try_disp, ldisp);
        List_push<string>(&g.try_phi, "");
        cg_stmt(g, st.s1);                                // try body
        int ntry = List_len<int>(&g.try_cld) - 1;
        string phi_extra = List_get<string>(&g.try_phi, ntry);
        List_remove<int>(&g.try_cld, ntry);
        List_remove<string>(&g.try_disp, ntry);
        List_remove<string>(&g.try_phi, ntry);
        cg_cleanups_trunc(g, trymark);
        g.cur_unwind = saved;
        cg_br(g, ldone);
        cg_label(g, lpad);
        string lp = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, lp);
        cg_emit(g, " = landingpad { ptr, i32 } catch ptr null\n");
        string exptr = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, exptr);
        cg_emit(g, " = extractvalue { ptr, i32 } ");
        cg_emit(g, lp);
        cg_emit(g, ", 0\n");
        cg_emit(g, "  br label %");
        cg_emit(g, ldisp);
        cg_emit(g, "\n");
        cg_label(g, ldisp);                               // catch dispatch (landingpad or a body defer's pad)
        if (phi_extra[0] != 0) {
            string exphi = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, exphi);
            cg_emit(g, " = phi ptr [ ");
            cg_emit(g, exptr);
            cg_emit(g, ", %");
            cg_emit(g, lpad);
            cg_emit(g, " ]");
            cg_emit(g, phi_extra);
            cg_emit(g, "\n");
            exptr = exphi;
        }
        string exdata = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, exdata);
        cg_emit(g, " = call ptr @__cxa_begin_catch(ptr ");
        cg_emit(g, exptr);
        cg_emit(g, ")\n");
        // emscripten hands the thrown object itself to the landingpad; its begin_catch
        // returns it adjusted for the `void*` typeinfo (C++ visit(TryStmt)).
        if (g.emscripten == 1) {
            exdata = exptr;
        }
        string ets = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, ets);
        cg_emit(g, " = getelementptr i8, ptr ");
        cg_emit(g, exdata);
        cg_emit(g, ", i64 8\n");
        string extype = cg_tmp(g);
        cg_emit(g, "  ");
        cg_emit(g, extype);
        cg_emit(g, " = load ptr, ptr ");
        cg_emit(g, ets);
        cg_emit(g, "\n");
        int ci = 0;
        int cn = List_len<*StmtNode>(&st.items);
        while (ci < cn) {
            *StmtNode c = List_get<*StmtNode>(&st.items, ci);
            string ctype = cg_drop_last_word(c.name);
            string cname = cg_last_word(c.name);
            if (c.is_err == 1) {
                // A capturing catch (async lowering only): any exception; copy the object
                // into a fresh, unthrown exception (its size is at offset 0) for a later
                // rethrow, and release the caught one.
                int cbase = List_len<CgLocal>(&g.locals);
                string esz = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, esz);
                cg_emit(g, " = load i64, ptr ");
                cg_emit(g, exdata);
                cg_emit(g, "\n");
                string ecsz = esz;
                if (cg_streq(cg_size_ty(g), "i32") == 1) {   // size_t on a 32-bit target
                    ecsz = cg_tmp(g);
                    cg_emit(g, cg_cat("  ", cg_cat(ecsz, cg_cat(" = trunc i64 ", cg_cat(esz, " to i32\n")))));
                }
                string ecp = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, ecp);
                cg_emit(g, cg_cat(" = call ptr @__cxa_allocate_exception(", cg_cat(cg_size_ty(g), " ")));
                cg_emit(g, ecsz);
                cg_emit(g, ")\n");
                cg_emit(g, "  call void @llvm.memcpy.p0.p0.i64(ptr ");
                cg_emit(g, ecp);
                cg_emit(g, ", ptr ");
                cg_emit(g, exdata);
                cg_emit(g, ", i64 ");
                cg_emit(g, esz);
                cg_emit(g, ", i1 false)\n");
                string eslot = cg_entry_alloca(g, "ptr");
                cg_emit(g, "  store ptr ");
                cg_emit(g, ecp);
                cg_emit(g, ", ptr ");
                cg_emit(g, eslot);
                cg_emit(g, "\n");
                cg_add_local(g, cname, eslot, "ptr", ctype);
                cg_emit(g, "  call void @__cxa_end_catch()\n");
                cg_stmt(g, c.s1);
                cg_br(g, ldone);
                cg_locals_trunc(g, cbase);
                cg_label(g, cg_lbl(g));
                ci = ci + 1;
                continue;
            }
            string nbl = cg_lbl(g);
            if (ctype[0] != 0) {
                string ctg = cg_string_global(g, cg_ex_typename(g, ctype));
                string cmp = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, cmp);
                cg_emit(g, " = call i32 @strcmp(ptr ");
                cg_emit(g, extype);
                cg_emit(g, ", ptr ");
                cg_emit(g, ctg);
                cg_emit(g, ")\n");
                string m = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, m);
                cg_emit(g, " = icmp eq i32 ");
                cg_emit(g, cmp);
                cg_emit(g, ", 0\n");
                string hbl = cg_lbl(g);
                cg_emit(g, "  br i1 ");
                cg_emit(g, m);
                cg_emit(g, ", label %");
                cg_emit(g, hbl);
                cg_emit(g, ", label %");
                cg_emit(g, nbl);
                cg_emit(g, "\n");
                g.terminated = 1;
                cg_label(g, hbl);
            }
            int lbase = List_len<CgLocal>(&g.locals);
            if (ctype[0] != 0) {
                string cty = cg_lltype(g, ctype);
                string cps = cg_tmp(g);                        // the payload, by the catch type
                cg_emit(g, "  ");
                cg_emit(g, cps);
                cg_emit(g, " = getelementptr i8, ptr ");
                cg_emit(g, exdata);
                cg_emit(g, ", i64 16\n");
                string cv = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, cv);
                cg_emit(g, " = load ");
                cg_emit(g, cty);
                cg_emit(g, ", ptr ");
                cg_emit(g, cps);
                cg_emit(g, "\n");
                string cslot = cg_entry_alloca(g, cty);
                cg_emit(g, "  store ");
                cg_emit(g, cty);
                cg_emit(g, " ");
                cg_emit(g, cv);
                cg_emit(g, ", ptr ");
                cg_emit(g, cslot);
                cg_emit(g, "\n");
                cg_add_local(g, cname, cslot, cty, ctype);
            }
            int has_txt = cg_has_extext_s(c.s1);
            if (has_txt == 1) {
                g.uses_ex_text = 1;
                string etx = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, etx);
                cg_emit(g, " = call ptr @__eskiu_exception_text(ptr ");
                cg_emit(g, exdata);
                cg_emit(g, ")\n");
                string tslot = cg_entry_alloca(g, "ptr");
                cg_emit(g, "  store ptr ");
                cg_emit(g, etx);
                cg_emit(g, ", ptr ");
                cg_emit(g, tslot);
                cg_emit(g, "\n");
                List_push<string>(&g.catch_text, tslot);
            }
            cg_emit(g, "  call void @__cxa_end_catch()\n");
            // `finally` also runs when the handler leaves early (return/break/continue).
            int cmark = List_len<*StmtNode>(&g.cleanups);
            // A throw out of the handler runs it too (then the new exception propagates).
            if (fin_all == 1) {
                cg_push_cleanup(g, st.s2, 0);
                cg_defer_pad(g);
            }
            cg_stmt(g, c.s1);                             // handler body
            if (has_txt == 1) {
                List_remove<string>(&g.catch_text, List_len<string>(&g.catch_text) - 1);
            }
            cg_cleanups_trunc(g, cmark);
            cg_br(g, ldone);
            cg_locals_trunc(g, lbase);
            cg_label(g, nbl);
            ci = ci + 1;
        }
        // No catch clause matched: run finally on the exceptional path, then
        // re-raise the in-flight exception (do NOT swallow it). __cxa_rethrow is
        // an invoke to the enclosing landingpad when inside another try, else a call.
        if (st.s2 != null) {          // finally (exceptional path)
            cg_stmt(g, st.s2);
        }
        if (saved[0] != 0) {
            string ru = cg_lbl(g);
            cg_emit(g, "  invoke void @__cxa_rethrow() to label %");
            cg_emit(g, ru);
            cg_emit(g, " unwind label %");
            cg_emit(g, saved);
            cg_emit(g, "\n");
            cg_label(g, ru);
            cg_emit(g, "  unreachable\n");
        } else {
            cg_emit(g, "  call void @__cxa_rethrow()\n");
            cg_emit(g, "  unreachable\n");
        }
        g.terminated = 1;
        cg_label(g, ldone);
        if (fin_all == 1) {           // finally (normal / handled path)
            cg_stmt(g, st.s2);
        }
        return;
    }
    if (st.kind == SK_RETURN) {
        if (st.expr != null) {
            cg_hint_iface(g, st.expr, g.cur_rety);
            CgVal r = cg_expr(g, st.expr);
            string rop = cg_coerce(g, r, g.cur_ret);     // widen/convert to the return type (bool→int, etc.)
            if (cg_is_iface(g, cg_dealias(g, g.cur_rety)) == 1) {
                rop = cg_iface_conv(g, g.cur_rety, r, st.expr);
            }
            cg_run_cleanups(g, 0, 0);                     // normal exit: defers/finally, not errdefer
            cg_emit(g, "  ret ");
            cg_emit(g, g.cur_ret);
            cg_emit(g, " ");
            cg_emit(g, rop);
            cg_emit(g, "\n");
        } else {
            cg_run_cleanups(g, 0, 0);
            cg_emit(g, "  ret void\n");
        }
        g.terminated = 1;
        return;
    }
    if (st.kind == SK_ASM) {
        // Inline assembly (mirrors CodeGen::visit(AsmStmt)): a side-effecting `asm` call
        // numbered like clang, the outputs first. A register output is a result of the
        // call (several make a struct) stored into its lvalue; a memory output `=m` is an
        // indirect `=*m` operand (`ptr elementtype(T)`); `+r` feeds the old value through
        // an input tied to the output, `+m` the address again as `*m`, after the inputs.
        String cons;
        String_init(&cons, 32);
        String args;
        String_init(&args, 32);
        String tcons;   // tied inputs (constraints, then args)
        String_init(&tcons, 16);
        String targs;
        String_init(&targs, 16);
        List<string> raddr;   // register outputs: address,
        List_init<string>(&raddr, 2);
        List<string> rty;       // LLVM type
        List_init<string>(&rty, 2);
        List<string> rvol;     // and "volatile " or ""
        List_init<string>(&rvol, 2);
        int nargs = 0;
        int ntied = 0;
        int n = List_len<*StmtNode>(&st.items);
        int i = 0;
        int oi = 0;
        while (i < n) {
            *StmtNode op = List_get<*StmtNode>(&st.items, i);
            i = i + 1;
            if (op.kind != SK_ASMOUTPUT) {
                continue;
            }
            int rw = 0;
            if ((int)op.name[0] == 43) {
                rw = 1;
            }
            string body = cg_sub_str(op.name, 1, cg_strlen(op.name));
            string lty = cg_lltype(g, cg_etype(g, op.expr));
            string addr = cg_lval(g, op.expr).op;
            string vol = cg_vol(g, op.expr);
            if (String_len(&cons) > 0) {
                String_append(&cons, ",");
            }
            if (cg_streq(body, "m") == 1) {
                String_append(&cons, "=*m");
                if (nargs > 0) {
                    String_append(&args, ", ");
                }
                String_append(&args, "ptr elementtype(");
                String_append(&args, lty);
                String_append(&args, ") ");
                String_append(&args, addr);
                nargs = nargs + 1;
                if (rw == 1) {
                    if (ntied > 0) {
                        String_append(&tcons, ",");
                        String_append(&targs, ", ");
                    }
                    String_append(&tcons, "*m");
                    String_append(&targs, "ptr elementtype(");
                    String_append(&targs, lty);
                    String_append(&targs, ") ");
                    String_append(&targs, addr);
                    ntied = ntied + 1;
                }
            } else {
                String_append(&cons, "=");
                String_append(&cons, cg_asm_cons(g, body));
                List_push<string>(&raddr, addr);
                List_push<string>(&rty, lty);
                List_push<string>(&rvol, vol);
                if (rw == 1) {
                    string cur = cg_tmp(g);
                    cg_emit(g, "  ");
                    cg_emit(g, cur);
                    cg_emit(g, " = load ");
                    cg_emit(g, vol);
                    cg_emit(g, lty);
                    cg_emit(g, ", ptr ");
                    cg_emit(g, addr);
                    cg_emit(g, "\n");
                    if (ntied > 0) {
                        String_append(&tcons, ",");
                        String_append(&targs, ", ");
                    }
                    String_append(&tcons, cg_itoa(oi));
                    String_append(&targs, lty);
                    String_append(&targs, " ");
                    String_append(&targs, cur);
                    ntied = ntied + 1;
                }
            }
            oi = oi + 1;
        }
        i = 0;
        while (i < n) {
            *StmtNode inp = List_get<*StmtNode>(&st.items, i);
            i = i + 1;
            if (inp.kind == SK_ASMOUTPUT) {
                continue;
            }
            CgVal a = cg_expr(g, inp.expr);
            if (String_len(&cons) > 0) {
                String_append(&cons, ",");
            }
            if (nargs > 0) {
                String_append(&args, ", ");
            }
            String_append(&cons, cg_asm_cons(g, inp.name));
            String_append(&args, a.ty);
            String_append(&args, " ");
            String_append(&args, a.op);
            nargs = nargs + 1;
        }
        if (ntied > 0) {
            if (String_len(&cons) > 0) {
                String_append(&cons, ",");
            }
            if (nargs > 0) {
                String_append(&args, ", ");
            }
            String_append(&cons, (string)String_cstr(&tcons));
            String_append(&args, (string)String_cstr(&targs));
        }
        if (st.type != null && st.type[0] != 0) {
            if (String_len(&cons) > 0) {
                String_append(&cons, ",");
            }
            String_append(&cons, st.type);
        }
        if (String_len(&cons) > 0) {
            String_append(&cons, ",~{dirflag},~{fpsr},~{flags}");
        }
        int nr = List_len<string>(&rty);
        string ret = "void";
        if (nr == 1) {
            ret = List_get<string>(&rty, 0);
        }
        if (nr > 1) {
            ret = "{ ";
            int ri = 0;
            while (ri < nr) {
                if (ri > 0) {
                    ret = cg_cat(ret, ", ");
                }
                ret = cg_cat(ret, List_get<string>(&rty, ri));
                ri = ri + 1;
            }
            ret = cg_cat(ret, " }");
        }
        string res = "";
        if (nr > 0) {
            res = cg_tmp(g);
            cg_emit(g, "  ");
            cg_emit(g, res);
            cg_emit(g, " = call ");
        }
        else {
            cg_emit(g, "  call ");
        }
        cg_emit(g, ret);
        cg_emit(g, " asm sideeffect \"");
        cg_emit(g, cg_ll_escape(st.name));
        cg_emit(g, "\", \"");
        cg_emit(g, cg_ll_escape((string)String_cstr(&cons)));
        cg_emit(g, "\"(");
        cg_emit(g, (string)String_cstr(&args));
        cg_emit(g, ")\n");
        int ri = 0;
        while (ri < nr) {
            string v = res;
            if (nr > 1) {
                v = cg_tmp(g);
                cg_emit(g, "  ");
                cg_emit(g, v);
                cg_emit(g, " = extractvalue ");
                cg_emit(g, ret);
                cg_emit(g, " ");
                cg_emit(g, res);
                cg_emit(g, ", ");
                cg_emit(g, cg_itoa(ri));
                cg_emit(g, "\n");
            }
            cg_emit(g, "  store ");
            cg_emit(g, List_get<string>(&rvol, ri));
            cg_emit(g, List_get<string>(&rty, ri));
            cg_emit(g, " ");
            cg_emit(g, v);
            cg_emit(g, ", ptr ");
            cg_emit(g, List_get<string>(&raddr, ri));
            cg_emit(g, "\n");
            ri = ri + 1;
        }
        return;
    }
    if (st.kind == SK_THREADJOIN) {
        // thread_join(t) → pthread_join(t, null)
        string tid = cg_expr(g, st.expr).op;
        cg_ensure_extern(g, "pthread_join", "declare i32 @pthread_join(ptr, ptr)\n");
        cg_emit(g, "  call i32 @pthread_join(ptr ");
        cg_emit(g, tid);
        cg_emit(g, ", ptr null)\n");
        return;
    }
    if (st.kind == SK_EXPR) {
        cg_expr(g, st.expr);
        return;
    }
}
