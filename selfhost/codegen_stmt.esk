// Part of codegen.esk (statements: cg_stmt dispatches on the kind to its parts codegen_stmt_*.esk), imported from it in order; compile codegen.esk, not this file alone.

// The cases of cg_stmt, defined in later parts.
void cg_stmt_block(Codegen* g, *StmtNode st);
void cg_stmt_if(Codegen* g, *StmtNode st);
void cg_stmt_while(Codegen* g, *StmtNode st);
void cg_stmt_dowhile(Codegen* g, *StmtNode st);
void cg_stmt_for(Codegen* g, *StmtNode st);
void cg_stmt_forin(Codegen* g, *StmtNode st);
void cg_stmt_break(Codegen* g, *StmtNode st);
void cg_stmt_continue(Codegen* g, *StmtNode st);
void cg_stmt_vardecl(Codegen* g, *StmtNode st);
void cg_stmt_switch(Codegen* g, *StmtNode st);
void cg_stmt_match(Codegen* g, *StmtNode st);
void cg_stmt_throw(Codegen* g, *StmtNode st);
void cg_stmt_try(Codegen* g, *StmtNode st);
void cg_stmt_return(Codegen* g, *StmtNode st);
void cg_stmt_asm(Codegen* g, *StmtNode st);

void cg_stmt(Codegen* g, *StmtNode st) {
    if (st == null) {
        return;
    }
    if (st.kind == SK_BLOCK) {
        cg_stmt_block(g, st);
        return;
    }
    if (st.kind == SK_DEFER) {
        cg_push_cleanup(g, st.s1, st.is_err);          // emitted at scope exit; errdefer only on the error path
        if (g.prog_eh == 1 && st.is_err == 0) {   // and on the exceptional path
            cg_defer_pad(g);
        }
        return;
    }
    if (st.kind == SK_IF) {
        cg_stmt_if(g, st);
        return;
    }
    if (st.kind == SK_WHILE) {
        cg_stmt_while(g, st);
        return;
    }
    if (st.kind == SK_DOWHILE) {
        cg_stmt_dowhile(g, st);
        return;
    }
    if (st.kind == SK_FOR) {
        cg_stmt_for(g, st);
        return;
    }
    if (st.kind == SK_FORIN) {
        cg_stmt_forin(g, st);
        return;
    }
    if (st.kind == SK_BREAK) {
        cg_stmt_break(g, st);
        return;
    }
    if (st.kind == SK_CONTINUE) {
        cg_stmt_continue(g, st);
        return;
    }
    if (st.kind == SK_VARDECL) {
        cg_stmt_vardecl(g, st);
        return;
    }
    if (st.kind == SK_SWITCH) {
        cg_stmt_switch(g, st);
        return;
    }
    if (st.kind == SK_MATCH) {
        cg_stmt_match(g, st);
        return;
    }
    if (st.kind == SK_THROW) {
        cg_stmt_throw(g, st);
        return;
    }
    if (st.kind == SK_TRY) {
        cg_stmt_try(g, st);
        return;
    }
    if (st.kind == SK_RETURN) {
        cg_stmt_return(g, st);
        return;
    }
    if (st.kind == SK_ASM) {
        cg_stmt_asm(g, st);
        return;
    }
    if (st.kind == SK_THREADJOIN) {
        // thread_join(t) → pthread_join(t, null)
        string tid = cg_expr(g, st.expr).op;
        cg_ensure_extern(g, "pthread_join", "declare i32 @pthread_join(ptr, ptr)\n");
        cg_emit(g, "  call i32 @pthread_join(ptr ");
        cg_emit(g, tid);
        cg_emit(g, ", ptr null)\n");
        return;
    }
    if (st.kind == SK_EXPR) {
        cg_expr(g, st.expr);
        return;
    }
}

import "codegen_stmt_control.esk";
import "codegen_stmt_match_try.esk";
import "codegen_stmt_asm.esk";
