// Part of sema.esk (state, scopes, symbols and type helpers), imported from it in order; compile sema.esk, not this file alone.

import <io>;
import <list>;
import <string>;
import <mem>;
import "ast.esk";

struct Sym {
    string name;
    string type;
    int depth;
    int is_const;
    *ExprNode init;
    int is_static;
    int addr_taken;
    int used;   // -Wall: referenced, its position, a parameter   // init: a const's initializer (case-label folding)
    int line;
    int col;
    int is_param;
}

// Signature of a non-generic top-level function/extern/intrinsic, for arg-count
// checking. `variadic` = trailing `...`; `fixed` = required arg count.
struct FnSig {
    string name;
    int fixed;
    int variadic;
}

// A top-level name and what declared it (for the one-namespace duplicate check).
struct NameEnt {
    string name;
    string kind;
    *DeclNode d;
}

// A generic instance queued for checking: the template function (or a generic struct's
// inline method, with `owner` the struct), its concrete type arguments, and its display
// name ("pick<Box>") for diagnostics. Mirrors the C++ PendingInstance.
struct SInst {
    *DeclNode func;
    *DeclNode owner;
    List<string> targs;
    string display;
    int depth;
}

// One enum variant, for match exhaustiveness.
struct EVar {   // val = member value (classic enums)
    string en;
    string variant;
    string val;
    int plain;
}

struct Sema {
    int fold_depth;          // recursion guard for sema_fold_int through const initializers
    int too_large;           // sema_const_layout met an array larger than the largest object
    int ptrsz;               // the target's pointer size and int64/double alignment, so
    int i64al;               // sizeof folds to its layout (sema_set_target)
    int msbf;                // 1: bitfields follow the MS (Windows) layout rules
    int bfal;                // 1: an unnamed bitfield raises its struct's alignment (AAPCS)
    int msvc;                // 1: MSVC (not mingw): a `: 0` under pack(N) is aligned to at most N
    int wasm;                // 1: a WebAssembly target (no exceptions)
    List<Sym> syms;
    List<string> gaddr;      // names whose address is taken anywhere (a global among them is never narrowed)
    List<FnSig> fns;
    List<string> types;     // declared type names (struct/union/interface/enum/alias)
    List<string> structs;   // struct names (subset of types; have fields/methods)
    List<string> members;   // "Struct.member" keys for each struct field AND method
    List<string> enums;     // enum names (for match exhaustiveness)
    List<EVar> evars;       // every enum's variants
    List<*DeclNode> fndecls; // all top-level fn/extern/intrinsic decls (params, type-params)
    List<*DeclNode> ifaces;  // interface decls (their required methods)
    List<*DeclNode> sdecls;  // struct decls (field names + types, for struct literals)
    List<string> tparams;    // type parameters in scope (a generic struct's methods)
    List<*DeclNode> tdecls;  // every type decl (struct/union/enum/interface/alias)
    int depth;
    int param_depth;         // depth of the current function's parameters (-1 outside one)
    int had_error;
    int in_async;           // currently inside an `async` function body?
    int fin_depth;          // `finally` blocks enclosing the current point (no `return` inside one)
    int in_variadic;        // the function being checked has a variadic parameter (`...`)?
    int await_seen;         // has an `await` appeared in the current function?
    string cur_ret;         // current function's return type (for `?` propagation)
    string cur_ret_raw;     // the same as written (a generic body: in terms of its type params)
    string match_ty;        // subject type of the `match` whose arms are being checked
    string lam_ret;         // return type a lambda initializer is reconciled to ("" = its own)
    List<string> watched;   // non-escaping fn-type params of the current function
    List<string> escaped;   // watched params seen used beyond a direct call
    string callee_ctx;      // name being called right now (a watched param here is OK)
    List<int> lam_bounds;   // scope depth just outside each enclosing lambda (innermost last)
    List<int> lam_esc;      // per enclosing lambda: 1 if it outlives the call (not passed to a non-escaping param)
    int call_epoch;         // bumped by every call (sema_drop_global_narrowings)
    int has_ops;            // any `operator` overload declared (an operator use may be a call)
    int has_alias;          // any `type X = ...` declared (an expression type may name one)
    List<*ExprNode> tern_ifn;    // `?:` expressions bound for an interface (each arm boxes) ...
    List<string> tern_ift;       // ... and that interface type
    int last_if_then_called;   // the last SK_IF's then-branch made a call
    int last_if_else_called;   // ... its else path did
    int lam_arg_nonesc;     // the lambda about to be checked is an argument to a non-escaping param
    string lam_local;       // the local the lambda about to be checked initializes ("" if none)
    List<string> lam_local_of;   // per enclosing lambda: the local it initializes
    List<string> wlocals;        // locals initialized by a lambda
    List<string> wlocals_esc;    // those used beyond a direct call
    List<string> cap_param;      // a watched param captured by a lambda bound to a local ...
    List<string> cap_local;      // ... and that local: the param escapes if the local does
    int lam_arg_stack;           // the lambda about to be checked is an argument to a non-escaping param of a non-async fn
    List<*ExprNode> lam_nodes;   // per enclosing lambda: its node
    List<*ExprNode> wlam;        // lambdas bound to a local (parallel: the local, 1 if in an async body)
    List<string> wlam_name;
    List<int> wlam_async;
    List<*ExprNode> lcap_lam;    // a lambda capturing a lambda-bound local ...
    List<string> lcap_name;      // ... and that local: the local escapes if the lambda outlives the call
    List<string> narrowed;  // `?*T` vars proven non-null in the current branch (`if (x != null)`)
    List<string> loop_lbls; // enclosing loop labels ("" for unlabeled), for labeled break/continue
    int sw_depth;           // enclosing switches (a bare `break` may exit one)
    string filename;
    int line;               // position of the node being checked (0 = unknown), for diagnostics
    int col;
    // Per-instantiation checking of generic bodies (after the main pass): the queue, the
    // display keys already queued, and while one is checked its substitution (parallel
    // type-param names / concrete arguments).
    List<SInst> insts;
    List<string> inst_seen;
    List<string> isub_p;
    List<string> isub_a;
    int in_inst;
    int inst_depth;
    // Globals declared after the top-level declaration being checked: C declares a global
    // at its definition, so an earlier initializer or function body cannot name it.
    StrTab late_globals;   // a set: name -> 1
    StrTab script_lines;   // while a script's implicit main is checked: its file's globals ->
    StrTab script_cols;    // their declaration's line and column (mirrors the C++ scriptGlobalPos)
    int in_script;
    int global_only;       // sema_sym_index sees only global bindings (folding a parameter default)
    StrTab pd_ix;          // sema_pdefs: function key -> index in pd_lists
    List<List<*ExprNode>> pd_lists;
    int no_depr;            // -Wno-deprecated: no warning at a use of a `deprecated` function
    int cur_import;         // the top-level declaration being checked comes from an import
    List<string> depr_seen; // "file:line:col" of each deprecation warning already printed
    List<string> wno;       // -Wno-<name>: the default-on warnings turned off
    int werror;             // -Werror: every warning is reported as an error
    int wnone;              // -w: no warning is printed
    int wall;               // -Wall: lint warnings (unused names, assignment in a condition, maybe-uninitialized)
    int wextra;             // -Wextra: signed/unsigned comparisons
    List<string> def_fns;   // -Wall: top-level functions defined (name), with position and display name
    List<int> def_lines;
    List<int> def_cols;
    List<string> def_disp;
    StrTab called_fns;      // -Wall: functions referenced anywhere (a set)
    StrTab mu_warned;       // "file:line:col:name" of each maybe-uninitialized warning printed
    string addr_fn;         // the function whose locals' addresses are tracked (C++ localAddrFn)
    List<*ExprNode> cap_lams;   // per lambda, the enclosing locals it captures (first use first)
    List<string> cap_names;
    int match_line;         // position of the `match` whose arms are being checked (its
    int match_col;          // bindings are reported there, as in the C++)
    StrTab gvar_set;        // the global variables' names
    List<string> ti_base;   // --complete-at: the generic struct instances resolved so far (sema_tool_note_inst)
    // Editor tooling (--hover-at 1, --definition-at 2, --complete-at 3) at tq_line:tq_col
    // of the primary input (see sema_tool_*).
    int tool;
    int tq_line;
    int tq_col;
    string primary;
    string th_best;         // the narrowest typed expression at the cursor, and its width
    int th_best_w;
    List<int> th_col;       // hoverSyms on the query line: column, width, type
    List<int> th_w;
    List<string> th_ty;
    List<int> tu_col;       // useLocations on the query line: column, name
    List<string> tu_name;
    List<int> tdu_col;      // useDefs on the query line: column, width, the declaration
    List<int> tdu_w;
    List<string> tdu_file;
    List<int> tdu_line;
    List<int> tdu_dcol;
    List<int> tm_col;       // memberUses on the query line: column, width, function
    List<int> tm_w;
    List<string> tm_fn;
    List<string> tl_name;   // definitionLocations: name, file, line, column
    List<string> tl_file;
    List<int> tl_line;
    List<int> tl_col;
    List<string> tc_kind;   // the completions: kind, name, detail
    List<string> tc_name;
    List<string> tc_detail;
    int tc_done;
    *ExprNode tool_callee;  // --hover-at: the callee name of the call being checked
    List<string> addr_keys; // -Wdangling-pointer: "sym index:name" of a local pointer ...
    List<string> addr_roots;// ... and the local whose address it holds ("" = something else)
    // Name indexes over the lists above (NameIdx, ast.esk), kept in step with every push
    // and pop, so a lookup by name does not scan the list.
    NameIdx syms_ix;
    NameIdx fns_ix;
    NameIdx tdecls_ix;       // also indexes `types` (pushed together)
    NameIdx sdecls_ix;       // also indexes `structs`
    NameIdx members_ix;
    NameIdx enums_ix;
    NameIdx fndecls_ix;
    NameIdx evars_ix;        // by variant name
    StrTab gaddr_set;        // the names in gaddr
    StrTab inst_seen_set;    // the keys in inst_seen
    StrTab depr_seen_set;    // the keys in depr_seen
}

// Mutually-recursive walk.
void sema_expr(Sema* s, *ExprNode e);
void sema_stmt(Sema* s, *StmtNode st);
*DeclNode sema_find_fndecl(Sema* s, string name);   // used by sema_infer_type before its definition
string sema_did_you_mean(Sema* s, string name, int kind, string recv);
void sema_note_depr(Sema* s, string fname, int line, int col);
void sema_note_call(Sema* s, string fname);
void sema_tool_hsym(Sema* s, int line, int col, int width, string ty);
void sema_tool_useloc(Sema* s, int line, int col, string name);
void sema_tool_memuse(Sema* s, int line, int col, int width, string fname);
void sema_tool_defloc(Sema* s, string name, string file, int line, int col);
void sema_tool_ident(Sema* s, *ExprNode e);
void sema_tool_expr(Sema* s, *ExprNode e);
void sema_tool_complete_scope(Sema* s);
void sema_tool_complete_members(Sema* s, string recv);
string sema_sig_text(Sema* s, string name);
string sym_sig_text(*DeclNode f);
void sema_lint(Sema* s, int line, int col, string msg);

// Substring [a, b) of s (b exclusive), heap-allocated and NUL-terminated.
string sema_sub_str(string s, int a, int b) {
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0;
    while (k < len) {
        buf[k] = (uint8)s[a + k];
        k = k + 1;
    }
    buf[len] = 0;
    return (string)buf;
}

int sema_streq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    if (a[i] == b[i]) {
        return 1;
    }
    return 0;
}

int sema_is_fn_type(string t) {     // "fn(...)->R"
    if (t[0] == 102 && t[1] == 110 && t[2] == 40) {   // 'f','n','('
        return 1;
    }
    return 0;
}

// Strip a leading "const " so a type predicate sees the bare spelling.
string sema_strip_const(string t) {
    if (t[0] == 99 && t[1] == 111 && t[2] == 110 && t[3] == 115 && t[4] == 116 && t[5] == 32) {
        int n = 0;
        while (t[n] != 0) {
            n = n + 1;
        }
        return sema_sub_str(t, 6, n);
    }
    return t;
}

int sema_is_int_ty(string t0) {
    string t = sema_strip_const(t0);
    return sema_streq(t, "int") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "int16") == 1
        || sema_streq(t, "int32") == 1 || sema_streq(t, "int64") == 1
        || sema_streq(t, "uint") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "uint16") == 1
        || sema_streq(t, "uint32") == 1 || sema_streq(t, "uint64") == 1
        || sema_streq(t, "char") == 1 || sema_streq(t, "bool") == 1;
}

int sema_is_float_ty(string t0) {
    string t = sema_strip_const(t0);
    return sema_streq(t, "float") == 1 || sema_streq(t, "double") == 1;
}

int sema_is_numeric_ty(string t) {
    return sema_is_int_ty(t) == 1 || sema_is_float_ty(t) == 1;
}

extern double strtod(string s, *string end);

// Does the floating value v, truncated toward zero, fit the integer type t (mirrors
// floatConstFitsInt)? Powers of two are exact doubles; at 64 bits `>=` is exact.
int sema_float_fits_int(double v, string t) {
    int bits = 32;
    int uns = 0;
    if (t[0] == 117) {                                   // 'u'
        uns = 1;
    }
    if (sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "char") == 1) {
        bits = 8;
    }
    else if (sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1) {
        bits = 16;
    }
    else if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) {
        bits = 64;
    }
    double lim = 1.0;
    int k = 0;
    int top = bits - 1;
    if (uns == 1) {
        top = bits;
    }
    while (k < top) {
        lim = lim * 2.0;
        k = k + 1;
    }
    if (uns == 1) {
        if (v > 0.0 - 1.0 && v < lim) {
            return 1;
        }
        return 0;
    }
    if (bits == 64) {
        if (v >= 0.0 - lim && v < lim) {
            return 1;
        }
        return 0;
    }
    if (v > 0.0 - lim - 1.0 && v < lim) {
        return 1;
    }
    return 0;
}

// Array-type helpers (mirror the codegen versions; sema does not import codegen).
int sema_is_arr_ty(string t) {
    int i = 0;   // '['
    while (t[i] != 0) {
        if ((int)t[i] == 91) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// A fixed array `T[N]` (its outer dimension, the first bracket, is not a slice `[]`):
// its elements are in the value's own storage, unlike a slice's.
int sema_is_fixed_arr_ty(string t) {
    int i = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 91) {
            return (int)t[i + 1] != 93;
        }
        i = i + 1;
    }
    return 0;
}

int sema_all_digits(string v) {
    if (v[0] == 0) {
        return 0;
    }
    int i = 0;
    while (v[i] != 0) {
        int c = (int)v[i];
        if (c < 48 || c > 57) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int sema_atoi(string v) {
    int i = 0;
    int r = 0;
    while (v[i] != 0) {
        int c = (int)v[i];
        if (c < 48 || c > 57) {
            return r;
        }
        r = r * 10 + (c - 48);
        i = i + 1;
    }
    return r;
}

// The first `[N]` dimension of an array type ("int[2][3]" → "2"), or "0" if none.
string sema_arr_count(string t) {
    int i = 0;
    while (t[i] != 0 && (int)t[i] != 91) {
        i = i + 1;
    }
    if (t[i] == 0) {
        return "0";
    }
    i = i + 1;
    int st = i;
    while (t[i] != 0 && (int)t[i] != 93) {
        i = i + 1;
    }
    return sema_sub_str(t, st, i);
}

// The element type of an array ("int[2][3]" → "int[3]"): prefix before '[' + suffix after ']'.
int sema_arr_bracket(string t);
string sema_arr_elem(string t) {
    int open = sema_arr_bracket(t);
    if (open < 0) {
        open = 0;
        while (t[open] != 0 && (int)t[open] != 91) {
            open = open + 1;
        }
    }
    if (t[open] == 0) {
        return t;
    }
    int close = open;
    while (t[close] != 0 && (int)t[close] != 93) {
        close = close + 1;
    }
    int tn = 0;
    while (t[tn] != 0) {
        tn = tn + 1;
    }
    string pre = sema_sub_str(t, 0, open);
    string suf = sema_sub_str(t, close + 1, tn);
    return sema_cat(pre, suf);
}

// Drop a leading `?` (the checked-nullable marker on `?*T`). A `?*T` operates like `*T`
// everywhere except the deref/index/member safety check, which inspects the `?` directly.
string sema_strip_nullable(string t) {
    if (t[0] == 63) {                                 // '?'
        int n = 0;
        while (t[n] != 0) {
            n = n + 1;
        }
        return sema_sub_str(t, 1, n);
    }
    return t;
}

// Pointer-like for comparison: leading/trailing `*`, `string`, or `null` (mirrors C++).
int sema_is_ptrish(string t0) {
    string t = sema_strip_nullable(sema_strip_const(t0));
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    if (n == 0) {
        return 0;
    }
    if (t[n - 1] == 93) {                  // `*T[N]` is an array of pointers
        return 0;
    }
    if (t[0] == 42 || t[n - 1] == 42) {   // '*'
        return 1;
    }
    return sema_streq(t, "string") == 1 || sema_streq(t, "null") == 1;
}

// A comparison operator (==, !=, <, >, <=, >=)?
int sema_is_cmp_op(string op) {
    return sema_streq(op, "==") == 1 || sema_streq(op, "!=") == 1
        || sema_streq(op, "<") == 1 || sema_streq(op, ">") == 1
        || sema_streq(op, "<=") == 1 || sema_streq(op, ">=") == 1;
}

// Does integer literal `v` (decimal, 0x hex or 0-octal) fit target int type `t0`?
// Mirrors the C++ intLiteralFits: a literal too large for 64 bits fits nothing. A binary
// or suffixed spelling is treated as fitting (skip).
int sema_int_lit_fits(string t0, string v) {
    string t = sema_strip_const(t0);
    int i = 0;
    int neg = 0;
    if (v[0] == 45) {               // leading '-'
        neg = 1;
        i = 1;
    }
    if (v[i] == 48 && (v[i + 1] == 98 || v[i + 1] == 66)) {  // 0b: skip
        return 1;
    }
    uint64 base = (uint64)10;
    if (v[i] == 48 && (v[i + 1] == 120 || v[i + 1] == 88)) {
        base = (uint64)16;
        i = i + 2;
    }
    else if (v[i] == 48 && v[i + 1] != 0) {
        base = (uint64)8;
        i = i + 1;
    }
    uint64 mag = (uint64)0;
    while (v[i] != 0) {
        int c = (int)v[i];
        int dv = -1;
        if (c >= 48 && c <= 57) {
            dv = c - 48;
        }
        else if (base == (uint64)16 && c >= 97 && c <= 102) {
            dv = c - 87;
        }
        else if (base == (uint64)16 && c >= 65 && c <= 70) {
            dv = c - 55;
        }
        if (dv < 0 || (uint64)dv >= base) {   // non-digit (suffix etc.): skip
            return 1;
        }
        if (mag > ((uint64)18446744073709551615 - (uint64)dv) / base) {   // wider than 64 bits
            return 0;
        }
        mag = mag * base + (uint64)dv;
        i = i + 1;
    }
    if (sema_streq(t, "uint64") == 1) {
        if (neg == 1) {
            return 0;
        }
        return 1;
    }
    if (sema_streq(t, "int64") == 1) {
        if (neg == 1) {
            if (mag <= (uint64)9223372036854775808) {
                return 1;
            }
            return 0;
        }
        if (mag <= (uint64)9223372036854775807) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(t, "bool") == 1) {
        if (neg == 1) {
            return 0;
        }
        if (mag <= (uint64)1) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(t, "uint8") == 1 || sema_streq(t, "char") == 1) {
        if (neg == 1) {
            return 0;
        }
        if (mag <= (uint64)255) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(t, "uint16") == 1) {
        if (neg == 1) {
            return 0;
        }
        if (mag <= (uint64)65535) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) {
        if (neg == 1) {
            return 0;
        }
        if (mag <= (uint64)4294967295) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(t, "int8") == 1) {
        if (neg == 1) {
            if (mag <= (uint64)128) {
                return 1;
            }
            return 0;
        }
        if (mag <= (uint64)127) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(t, "int16") == 1) {
        if (neg == 1) {
            if (mag <= (uint64)32768) {
                return 1;
            }
            return 0;
        }
        if (mag <= (uint64)32767) {
            return 1;
        }
        return 0;
    }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1) {
        if (neg == 1) {
            if (mag <= (uint64)2147483648) {
                return 1;
            }
            return 0;
        }
        if (mag <= (uint64)2147483647) {
            return 1;
        }
        return 0;
    }
    return 1;
}

// Does the folded case value `v` lie in the range of integer type `t0`? (Mirrors the C++
// caseValueFits; a 64-bit or unknown subject holds every folded value.)
int sema_case_fits(string t0, int64 v) {
    string t = sema_strip_const(t0);
    int64 lo = (int64)0;
    int64 hi = (int64)-1;
    if (sema_streq(t, "bool") == 1) {
        hi = (int64)1;
    }
    else if (sema_streq(t, "char") == 1 || sema_streq(t, "uint8") == 1) {
        hi = (int64)255;
    }
    else if (sema_streq(t, "int8") == 1) {
        lo = (int64)-128;
        hi = (int64)127;
    }
    else if (sema_streq(t, "uint16") == 1) {
        hi = (int64)65535;
    }
    else if (sema_streq(t, "int16") == 1) {
        lo = (int64)-32768;
        hi = (int64)32767;
    }
    else if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) {
        hi = (int64)4294967295;
    }
    else if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1) {
        lo = (int64)-2147483648;
        hi = (int64)2147483647;
    }
    else {
        return 1;
    }
    if (v < lo || v > hi) {
        return 0;
    }
    return 1;
}

int64 sema_parse_int(string t);
// The value of an array dimension spelling: a number or a classic enum member (-1 when
// unknown, e.g. a `const` name).
int64 sema_dim_value(Sema* s, string dim) {
    if (sema_all_digits(dim) == 1) {
        return sema_parse_int(dim);
    }
    int i = NameIdx_first(&s.evars_ix, dim);
    while (i >= 0) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (ev.plain == 1) {
            return sema_parse_int(ev.val);
        }
        i = NameIdx_next(&s.evars_ix, i);
    }
    return (int64)-1;
}

// Index of the `]` closing the array dimension that opens at `t[i]` (a `[`), or of the
// terminating NUL. A dimension is an expression (`int[K << 1]`, `int[K < 4 ? 2 : 1]`),
// so the type-spelling scanners skip over it rather than read its `<`, `>`, `*`, `(`.
int sema_dim_close(string t, int i) {
    int depth = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 91) {
            depth = depth + 1;
        }
        else if ((int)t[i] == 93) {
            depth = depth - 1;
            if (depth == 0) {
                return i;
            }
        }
        i = i + 1;
    }
    return i;
}

// Pointer levels of a type spelling, outside any `<...>` type arguments ("*Box<*int>" is 1).
int sema_ptr_depth(string t) {
    int stars = 0;
    int i = 0;
    int nest = 0;
    while (t[i] != 0) {
        int ch = (int)t[i];
        if (ch == 91) {
            i = sema_dim_close(t, i);
            if (t[i] == 0) {
                return stars;
            }
        }
        else if (ch == 60 || ch == 40) {
            nest = nest + 1;
        }
        else if ((ch == 62 || ch == 41) && nest > 0) {
            nest = nest - 1;
        }
        else if (ch == 42 && nest == 0) {
            stars = stars + 1;
        }
        i = i + 1;
    }
    return stars;
}

int sema_in_list(List<string>* l, string name) {
    int i = 0;
    int n = List_len<string>(l);
    while (i < n) {
        if (sema_streq(List_get<string>(l, i), name) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Emit a semantic error with a fixed message at the position of the node being checked
// (`s.line:s.col`, 0:0 when unknown) and mark the check failed.
void sema_error(Sema* s, string msg) {
    s.had_error = 1;
    dprintf(2, "error: %s:%d:%d: %s\n", s.filename, s.line, s.col, msg);
}

int sema_has_sub(string t, string sub) {
    int i = 0;
    while (t[i] != 0) {
        if (ast_has_prefix((string)((*uint8)t + i), sub) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// The layout facts of the --target triple (mirrors cg_set_target): 4-byte pointers on
// 32-bit x86 and ARM, and int64/double aligned to 4 by the SysV i386 ABI.
void sema_set_target(Sema* s, string triple) {
    if (triple == null || triple[0] == 0) {
        return;
    }
    s.ptrsz = 8;
    s.i64al = 8;
    s.wasm = ast_has_prefix(triple, "wasm32") | ast_has_prefix(triple, "wasm64");
    int win = sema_has_sub(triple, "windows") | sema_has_sub(triple, "win32") | sema_has_sub(triple, "mingw");
    s.msbf = win;
    ast_target_bf(triple, &s.bfal, &s.msvc);
    if (ast_has_prefix(triple, "aarch64") == 1 || ast_has_prefix(triple, "arm64") == 1
        || ast_has_prefix(triple, "x86_64") == 1 || ast_has_prefix(triple, "amd64") == 1) {
        return;
    }
    if (ast_has_prefix(triple, "i386") == 1 || ast_has_prefix(triple, "i486") == 1
        || ast_has_prefix(triple, "i586") == 1 || ast_has_prefix(triple, "i686") == 1) {
        s.ptrsz = 4;
        if (win == 0) {
            s.i64al = 4;
        }
        return;
    }
    if (ast_has_prefix(triple, "arm") == 1 || ast_has_prefix(triple, "thumb") == 1
        || ast_has_prefix(triple, "wasm32") == 1) {
        s.ptrsz = 4;
    }
}

int sema_fold_int(Sema* s, *ExprNode e, int64* out);
void sema_expr(Sema* s, *ExprNode e);
string sema_i64_text(int64 v) {
    *uint8 b = alloc<uint8>(24);
    sprintf((string)b, "%lld", v);
    return (string)b;
}

// Fold a classic enum's member value expressions (`B = A << 2`) into its members' values
// (the params' ty and the registered EVars), in order: a member's value may use the
// members before it. `report` checks each expression and diagnoses one that is not an
// integer constant expression (the declaration-order pass), then consumes the
// expressions. Mirrors the C++ TypeChecker::foldEnumValues.
void sema_fold_enum(Sema* s, *DeclNode d, int report) {
    int any = 0;
    int i = 0;
    while (i < List_len<*ExprNode>(&d.enum_vals)) {
        if (List_get<*ExprNode>(&d.enum_vals, i) != null) {
            any = 1;
        }
        i = i + 1;
    }
    if (any == 0) {
        return;
    }
    int sline = s.line;
    int scol = s.col;
    int known = 1;
    int seen = 0;
    int64 prev = (int64)0;
    i = 0;
    while (i < List_len<Param>(&d.params)) {
        Param pm = List_get<Param>(&d.params, i);
        *ExprNode ve = null;
        if (i < List_len<*ExprNode>(&d.enum_vals)) {
            ve = List_get<*ExprNode>(&d.enum_vals, i);
        }
        int64 v = sema_parse_int(pm.ty);
        if (ve != null) {
            seen = 1;
            int e0 = s.had_error;
            s.had_error = 0;
            if (report == 1) {
                s.line = ve.line;
                s.col = ve.col;
                sema_expr(s, ve);
            }
            int fresh = s.had_error;
            int64 r = (int64)0;
            known = 0;
            if (fresh == 0 && sema_fold_int(s, ve, &r) == 1) {
                known = 1;
                v = r;
            }
            if (known == 0 && fresh == 0 && report == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: value of enum member '%s' of '%s' is not an integer constant expression\n",
                        s.filename, ve.line, ve.col, pm.name, d.name);
            }
            if (e0 == 1) {
                s.had_error = 1;
            }
        } else if (seen == 1) {
            v = prev + (int64)1;
        }
        if (known == 1 || seen == 0) {
            pm.ty = sema_i64_text(v);
            List_set<Param>(&d.params, i, pm);
            int k = NameIdx_first(&s.evars_ix, pm.name);
            while (k >= 0) {
                EVar ev = List_get<EVar>(&s.evars, k);
                if (sema_streq(ev.en, d.name) == 1) {
                    ev.val = pm.ty;
                    List_set<EVar>(&s.evars, k, ev);
                }
                k = NameIdx_next(&s.evars_ix, k);
            }
        }
        prev = sema_parse_int(pm.ty);
        i = i + 1;
    }
    s.line = sline;
    s.col = scol;
    if (report == 1 && s.had_error == 0) {
        i = 0;
        while (i < List_len<*ExprNode>(&d.enum_vals)) {
            List_set<*ExprNode>(&d.enum_vals, i, null);
            i = i + 1;
        }
    }
}

void sema_init(Sema* s, string filename) {
    memset((*void)s, 0, sizeof(Sema));   // every field starts as a valid empty value
    s.ptrsz = 8;
    s.i64al = 8;
    s.msbf = 0;
    ast_target_bf("", &s.bfal, &s.msvc);
#ifdef _WIN32
    s.msbf = 1;
#endif
    List_init<Sym>(&s.syms, 64);
    List_init<FnSig>(&s.fns, 32);
    List_init<string>(&s.types, 32);
    List_init<string>(&s.structs, 16);
    List_init<string>(&s.members, 64);
    List_init<string>(&s.enums, 16);
    List_init<EVar>(&s.evars, 32);
    List_init<*DeclNode>(&s.fndecls, 64);
    List_init<List<*ExprNode>>(&s.pd_lists, 4);
    List_init<*DeclNode>(&s.ifaces, 16);
    List_init<*DeclNode>(&s.sdecls, 16);
    List_init<string>(&s.tparams, 4);
    List_init<*DeclNode>(&s.tdecls, 16);
    s.depth = 0;                           // global scope
    s.fold_depth = 0;
    s.had_error = 0;
    s.in_async = 0;
    s.await_seen = 0;
    s.cur_ret = "";
    s.cur_ret_raw = "";
    s.match_ty = "";
    s.lam_ret = "";
    List_init<string>(&s.watched, 4);
    List_init<string>(&s.escaped, 4);
    List_init<string>(&s.narrowed, 4);
    s.has_ops = 0;
    List_init<*ExprNode>(&s.tern_ifn, 4);
    List_init<string>(&s.tern_ift, 4);
    List_init<string>(&s.loop_lbls, 4);
    List_init<int>(&s.lam_bounds, 4);
    List_init<int>(&s.lam_esc, 4);
    List_init<*ExprNode>(&s.lam_nodes, 4);
    List_init<string>(&s.lam_local_of, 4);
    s.lam_local = "";
    s.callee_ctx = "";
    s.sw_depth = 0;
    s.param_depth = 0 - 1;
    s.line = 0;
    s.col = 0;
    s.filename = filename;
    List_init<SInst>(&s.insts, 8);
    List_init<string>(&s.inst_seen, 8);
    List_init<string>(&s.isub_p, 4);
    List_init<string>(&s.isub_a, 4);
    s.in_inst = 0;
    s.inst_depth = 0;
}

// Bumped whenever an expression's type may change (a binding, a scope, a narrowing, a
// statement): a `?:` node's memoized type is valid within one epoch. Global, never reset,
// so a node typed by an earlier Sema (before the async lowering) is never stale.
int g_sema_epoch;
void sema_bump(Sema* s) {
    g_sema_epoch = g_sema_epoch + 1;
}

void sema_push(Sema* s) {
    s.depth = s.depth + 1;
    sema_bump(s);
}

// -Wall: the names of the scope being left that nothing referenced, in name order (the
// C++ scope is a std::map); a global scope is not linted.
void sema_warn_unused(Sema* s, int d) {
    if (s.wall == 0 || d < 1) {
        return;
    }
    List<int> idx;
    List_init<int>(&idx, 4);
    List<string> seen;
    List_init<string>(&seen, 4);
    int i = List_len<Sym>(&s.syms) - 1;
    while (i >= 0 && List_get<Sym>(&s.syms, i).depth >= d) {
        Sym y = List_get<Sym>(&s.syms, i);
        // A name bound twice in one scope is one map entry: its last binding.
        if (sema_in_list(&seen, y.name) == 0) {
            List_push<string>(&seen, y.name);
            if (y.used == 0 && sema_streq(y.name, "self") == 0 && sema_streq(y.name, "_") == 0) {
                List_push<int>(&idx, i);
            }
        }
        i = i - 1;
    }
    int n = List_len<int>(&idx);
    int a = 1;                             // insertion sort by name (byte order, as std::map)
    while (a < n) {
        int v = List_get<int>(&idx, a);
        int b = a - 1;
        while (b >= 0 && strcmp(List_get<Sym>(&s.syms, List_get<int>(&idx, b)).name, List_get<Sym>(&s.syms, v).name) > 0) {
            List_set<int>(&idx, b + 1, List_get<int>(&idx, b));
            b = b - 1;
        }
        List_set<int>(&idx, b + 1, v);
        a = a + 1;
    }
    int k = 0;
    while (k < n) {
        Sym y = List_get<Sym>(&s.syms, List_get<int>(&idx, k));
        string what = "unused variable '";
        if (y.is_param == 1) {
            what = "unused parameter '";
        }
        sema_lint(s, y.line, y.col, sema_cat(sema_cat(what, y.name), "'"));
        k = k + 1;
    }
}

void sema_pop(Sema* s) {
    sema_bump(s);
    int d = s.depth;
    sema_warn_unused(s, d);
    while (List_len<Sym>(&s.syms) > 0) {
        Sym last = List_get<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
        if (last.depth < d) {
            break;
        }
        NameIdx_pop(&s.syms_ix, last.name);
        List_remove<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
    }
    s.depth = d - 1;
}

*DeclNode sema_find_tdecl(Sema* s, string name);

// `type NP = ?*N;`: a use of NP is the nullable pointer itself, so the `?` the
// null-safety checks read off the front of a type must be visible (mirrors the C++
// nullableAliasTarget).
string sema_nullable_alias(Sema* s, string t) {
    string cur = t;
    int hops = 0;
    while (hops < 64) {
        *DeclNode ad = sema_find_tdecl(s, cur);
        if (ad == null || ad.kind != DK_TYPEALIAS) {
            return t;
        }
        cur = ad.ret_type;
        if ((int)cur[0] == 63) {
            return cur;
        }
        hops = hops + 1;
    }
    return t;
}

void sema_define(Sema* s, string name, string type, int is_const) {
    let sym: Sym;
    sym.name = name;
    sym.type = sema_nullable_alias(s, type);
    sym.depth = s.depth;
    sym.is_const = is_const;
    sym.init = null;
    sym.is_static = 0;
    sym.addr_taken = 0;
    sym.used = 0;
    sym.line = 0;
    sym.col = 0;
    sym.is_param = 0;
    List_push<Sym>(&s.syms, sym);
    NameIdx_push(&s.syms_ix, name);
    sema_bump(s);
    if (s.tool == 3) {
        sema_tool_note_inst(s, sym.type);
    }
}

// sema_define, recording the binding's position (for -Wall) and whether it is a parameter.
void sema_define_at(Sema* s, string name, string type, int is_const, int line, int col, int is_param) {
    sema_define(s, name, type, is_const);
    int n = List_len<Sym>(&s.syms);
    Sym sym = List_get<Sym>(&s.syms, n - 1);
    sym.line = line;
    sym.col = col;
    sym.is_param = is_param;
    List_set<Sym>(&s.syms, n - 1, sym);
    if (s.tool != 0 && line > 0 && is_param == 0) {
        sema_tool_hsym(s, line, col, sema_slen(name), sema_display_ty(s, type));
    }
}

// -Wall: `name`, read inside lambdas, is captured by every enclosing lambda it is outer
// to (a local, not a global or `static`), as the C++ capture map records it.
void sema_note_capture(Sema* s, string name) {
    int nb = List_len<int>(&s.lam_bounds);
    if (nb == 0 || s.in_inst == 1) {
        return;
    }
    int i = NameIdx_last(&s.syms_ix, name);
    if (i < 0) {
        return;
    }
    Sym sym = List_get<Sym>(&s.syms, i);
    if (sym.depth < 1 || sym.is_static == 1 || sym.type == null || sym.type[0] == 0) {
        return;
    }
    int j = 0;
    while (j < nb) {
        if (sym.depth <= List_get<int>(&s.lam_bounds, j)) {
            *ExprNode lam = List_get<*ExprNode>(&s.lam_nodes, j);
            int seen = 0;
            int c = 0;
            while (c < List_len<*ExprNode>(&s.cap_lams) && seen == 0) {
                if (List_get<*ExprNode>(&s.cap_lams, c) == lam && sema_streq(List_get<string>(&s.cap_names, c), name) == 1) {
                    seen = 1;
                }
                c = c + 1;
            }
            if (seen == 0) {
                List_push<*ExprNode>(&s.cap_lams, lam);
                List_push<string>(&s.cap_names, name);
            }
        }
        j = j + 1;
    }
}

// -Wall: the innermost binding of `name` is referenced (the C++ lookupSymbol).
void sema_mark_used(Sema* s, string name) {
    int i = NameIdx_last(&s.syms_ix, name);
    if (i < 0) {
        return;
    }
    Sym sym = List_get<Sym>(&s.syms, i);
    if (sym.used == 1) {
        return;
    }
    sym.used = 1;
    List_set<Sym>(&s.syms, i, sym);
}

// Every binding of the scopes from depth `d` in counts as used (a prototype's parameter names).
void sema_mark_all_used(Sema* s, int d) {
    int i = List_len<Sym>(&s.syms) - 1;
    while (i >= 0 && List_get<Sym>(&s.syms, i).depth >= d) {
        Sym sym = List_get<Sym>(&s.syms, i);
        sym.used = 1;
        List_set<Sym>(&s.syms, i, sym);
        i = i - 1;
    }
}

// Record the initializer of the binding just defined, when it is a `const`.
void sema_set_const_init(Sema* s, *ExprNode init) {
    int n = List_len<Sym>(&s.syms);
    if (n == 0) {
        return;
    }
    Sym sym = List_get<Sym>(&s.syms, n - 1);
    if (sym.is_const == 0) {
        return;
    }
    sym.init = init;
    List_set<Sym>(&s.syms, n - 1, sym);
}

// Index of the innermost binding of `name` in the symbol stack, or -1 if unbound.
// The one reverse scan the symbol-table queries below share.
int sema_sym_index(Sema* s, string name) {
    if (s.global_only == 1) {
        int i = NameIdx_last(&s.syms_ix, name);
        while (i >= 0 && List_get<Sym>(&s.syms, i).depth != 0) {
            i = NameIdx_prev(&s.syms_ix, i);
        }
        return i;
    }
    return NameIdx_last(&s.syms_ix, name);
}

// Retype the innermost binding of `name` (a `for (i in A..B)` decl widened to the
// bounds' common type after both were declared).
void sema_set_sym_type(Sema* s, string name, string type) {
    int i = sema_sym_index(s, name);
    if (i < 0) {
        return;
    }
    Sym sym = List_get<Sym>(&s.syms, i);
    sym.type = type;
    List_set<Sym>(&s.syms, i, sym);
    sema_bump(s);
}

// Is `name` a read-only (const) binding?
int sema_sym_const(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) {
        return 0;
    }
    return List_get<Sym>(&s.syms, i).is_const;
}

// Scope depth of the innermost binding of `name`, or -1. Depth 0 = a global; a
// function-scope local or parameter is at depth >= 1.
int sema_sym_depth(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) {
        return -1;
    }
    return List_get<Sym>(&s.syms, i).depth;
}

int sema_lookup(Sema* s, string name) {
    if (sema_sym_index(s, name) >= 0) {
        return 1;
    }
    return 0;
}

// Declared type of `name` (innermost binding), or "" if unbound / untyped.
string sema_lookup_type(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) {
        return "";
    }
    return List_get<Sym>(&s.syms, i).type;
}

// Is `name` bound in a local (non-global) scope? The innermost binding wins, so a
// local shadow of a global function means a call should NOT be arg-count-checked
// against the function signature (it could be a fn-pointer variable).
// A script's statement before the declaration of one of its globals (mirrors the C++
// check in visit(IdentExpr)).
int sema_script_late(Sema* s, string name, int line, int col) {
    if (s.in_script == 0 || sema_local_bound(s, name) == 1 || StrTab_has(&s.script_lines, name) == 0) {
        return 0;
    }
    int dl = StrTab_get(&s.script_lines, name, 0);
    int dc = StrTab_get(&s.script_cols, name, 0);
    if (dl > line || (dl == line && dc > col)) {
        return 1;
    }
    return 0;
}

int sema_local_bound(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) {
        return 0;
    }
    if (List_get<Sym>(&s.syms, i).depth > 0) {
        return 1;
    }
    return 0;
}

// Is `name` a member of a classic (payload-free, non-generic) enum?
int sema_plain_member(Sema* s, string name) {
    int i = NameIdx_first(&s.evars_ix, name);
    while (i >= 0) {
        if (List_get<EVar>(&s.evars, i).plain == 1) {
            return 1;
        }
        i = NameIdx_next(&s.evars_ix, i);
    }
    return 0;
}

// The declared type of field `name` of struct/union `sn`, or null when it has no such
// field (a method is not a field).
// The index of the first field named `name` in declaration `d` (a struct or union), or
// -1: a hash index (ast_fx_*) for a wide one, else a scan.
int sema_field_index(*DeclNode d, string name) {
    int i = 0;
    int n = List_len<Param>(&d.params);
    if (n > 8) {
        string owner = sema_cat("s:", sema_i64_text((int64)d));
        if (ast_fx_ready(owner, n) == 0) {
            while (i < n) {
                ast_fx_put(owner, List_get<Param>(&d.params, i).name, i);
                i = i + 1;
            }
            ast_fx_done(owner, n);
            i = 0;
        }
        int k = ast_fx_get(owner, name);
        if (k >= 0 && k < n && sema_streq(List_get<Param>(&d.params, k).name, name) == 1) {
            return k;
        }
        if (k < 0) {
            return -1;
        }
    }
    while (i < n) {
        if (sema_streq(List_get<Param>(&d.params, i).name, name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

string sema_field_type(Sema* s, string sn, string name) {
    *DeclNode d = sema_find_tdecl(s, sn);
    if (d == null || (d.kind != DK_STRUCT && d.kind != DK_UNION)) {
        return null;
    }
    int i = sema_field_index(d, name);
    if (i < 0) {
        return null;
    }
    return List_get<Param>(&d.params, i).ty;
}

// Is `name` a function declared `must_use`? (Discarding its result is an error.)
int sema_fn_must_use(Sema* s, string name) {
    int i = 0;
    int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.is_mustuse == 1 && sema_streq(d.name, name) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Register a non-generic function/extern/intrinsic signature. Generic functions are
// instantiated/inferred, so they get no fixed arg-count check (mirrors the C++
// funcTemplateDecls vs functionSignatures split).
void sema_register_fn(Sema* s, *DeclNode d) {
    if (List_len<TypeParam>(&d.type_params) > 0) {
        return;
    }
    let sig: FnSig;
    sig.name = d.name;
    int np = List_len<Param>(&d.params);
    sig.variadic = 0;
    sig.fixed = np;
    if (np > 0) {                          // guard List_get against a -1 index
        string lastty = List_get<Param>(&d.params, np - 1).ty;
        if (sema_streq(lastty, "...") == 1) {
            sig.variadic = 1;
            sig.fixed = np - 1;
        }
    }
    List_push<FnSig>(&s.fns, sig);
    NameIdx_push(&s.fns_ix, sig.name);
}

*DeclNode sema_find_tdecl(Sema* s, string name);
int sema_is_arr_ty(string t);
// A value type with no scalar meaning: a struct/union, a sum type, an interface value, a
// fixed array, a slice, or a closure (mirrors the C++ isAggregateValue). Such a value is
// not a truth value and has no built-in comparison.
int sema_is_aggregate(Sema* s, string t0) {
    string t = sema_strip_nullable(sema_strip_const(t0));
    if (t[0] == 0) {
        return 0;
    }
    if (sema_is_arr_ty(t) == 1 || sema_is_fn_type(t) == 1) {
        return 1;
    }
    if (sema_has_star(t) == 1) {
        return 0;
    }
    *DeclNode d = sema_find_tdecl(s, sema_base_name(t));
    if (d == null) {
        return 0;
    }
    if (d.kind == DK_STRUCT || d.kind == DK_UNION || d.kind == DK_INTERFACE) {
        return 1;
    }
    if (d.kind == DK_ENUM) {
        if (List_len<TypeParam>(&d.type_params) > 0) {
            return 1;
        }
        if (ast_enum_has_payload(d) == 1) {
            return 1;
        }
    }
    return 0;
}

*DeclNode sema_find_iface(Sema* s, string name);
string sema_canon(Sema* s, string t0);
// An interface value (not a pointer to one)? It is a truth value (true when not null) and
// compares with `null` (mirrors the C++ isTruthValue).
int sema_is_iface_val(Sema* s, string t0) {
    if (t0 == null || t0[0] == 0) {
        return 0;
    }
    string c = sema_canon(s, sema_strip_nullable(sema_strip_const(t0)));
    if (sema_has_star(c) == 1) {
        return 0;
    }
    if (sema_find_iface(s, c) != null) {
        return 1;
    }
    return 0;
}

// A struct value (not a pointer to one, not an array of them)?
int sema_is_struct_value(Sema* s, string t) {
    if (t[0] == 0 || sema_has_star(t) == 1 || sema_is_arr_ty(t) == 1) {
        return 0;
    }
    return sema_is_struct(s, sema_base_name(t));
}

int sema_find_fn(Sema* s, string name) {
    return NameIdx_first(&s.fns_ix, name);
}

int sema_is_type(Sema* s, string name) {
    return NameIdx_first(&s.tdecls_ix, name) >= 0;
}

// Leading name of a spelling, up to a generic '<' or payload '(':
// "Box<int>" -> "Box", "A(x)" -> "A", "W" -> "W".
string sema_base_name(string sp) {
    int n = 0;
    while (sp[n] != 0 && (int)sp[n] != 60 && (int)sp[n] != 40) {   // '<' or '('
        if ((int)sp[n] == 91) {
            n = sema_dim_close(sp, n);
            if (sp[n] == 0) {
                return sp;
            }
        }
        n = n + 1;
    }
    if ((int)sp[n] == 0) {
        return sp;
    }
    *uint8 buf = alloc<uint8>(n + 1);
    int i = 0;
    while (i < n) {
        buf[i] = (uint8)sp[i];
        i = i + 1;
    }
    buf[n] = 0;
    return (string)buf;
}

string sema_cat(string a, string b) {
    int la = 0;
    while (a[la] != 0) {
        la = la + 1;
    }
    int lb = 0;
    while (b[lb] != 0) {
        lb = lb + 1;
    }
    *uint8 buf = alloc<uint8>(la + lb + 1);
    int i = 0;
    while (i < la) {
        buf[i] = (uint8)a[i];
        i = i + 1;
    }
    int j = 0;
    while (j < lb) {
        buf[la + j] = (uint8)b[j];
        j = j + 1;
    }
    buf[la + lb] = 0;
    return (string)buf;
}

// Reduce a type spelling to its base struct name: strip leading '*'/spaces and any
// generic '<...>' or pointer suffix, and a `const` qualifier (`const P*` names P).
// "*Point" -> "Point", "List<int>" -> "List".
string sema_struct_of_type(string t0) {
    string t = sema_strip_const(t0);
    int i = 0;
    while ((int)t[i] == 42 || (int)t[i] == 32 || (int)t[i] == 63) {   // skip '*' / ' ' / '?'
        i = i + 1;
    }
    int j = i;
    while (t[j] != 0 && (int)t[j] != 60 && (int)t[j] != 42 && (int)t[j] != 32) {
        if ((int)t[j] == 91) {
            j = sema_dim_close(t, j);
            if (t[j] == 0) {
                break;
            }
        }
        j = j + 1;
    }
    int len = j - i;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0;
    while (k < len) {
        buf[k] = (uint8)t[i + k];
        k = k + 1;
    }
    buf[len] = 0;
    return (string)buf;
}

// `t` with every space removed ("Result<int, string>" -> "Result<int,string>").
string sema_nospace(string t) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0;
    int i = 0;
    while (i < n) {
        if ((int)t[i] != 32) {
            buf[o] = (uint8)t[i];
            o = o + 1;
        }
        i = i + 1;
    }
    buf[o] = 0;
    return (string)buf;
}

int sema_has_lt(string t) {
    int i = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 60) {
            return 1;
        }
        if ((int)t[i] == 91) {
            i = sema_dim_close(t, i);
            if (t[i] == 0) {
                return 0;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Is `t` a spelling of a known type? Its base name (pointer stars, generic args and array
// dims stripped) must be a primitive or a declared type. fn types are accepted as-is.
int sema_known_type(Sema* s, string t) {
    if (sema_is_fn_type(t) == 1) {
        return 1;
    }
    string b0 = sema_struct_of_type(sema_strip_nullable(sema_strip_const(t)));
    if (sema_is_fn_type(b0) == 1) {                          // a pointer to a fn value
        return 1;
    }
    int n = 0;   // cut at '['
    while (b0[n] != 0 && (int)b0[n] != 91) {
        n = n + 1;
    }
    string b = sema_sub_str(b0, 0, n);
    if (sema_is_fn_type(b) == 1) {         // a pointer to / array of fn(...)->R
        return 1;
    }
    if (sema_is_numeric_ty(b) == 1 || sema_streq(b, "void") == 1 || sema_streq(b, "string") == 1
        || sema_streq(b, "va_list") == 1) {
        return 1;
    }
    if (sema_in_list(&s.tparams, b) == 1) {
        return 1;
    }
    return NameIdx_first(&s.tdecls_ix, b) >= 0;
}

// The declaration of type `name` (struct/union/enum/interface/alias), or null.
*DeclNode sema_find_tdecl(Sema* s, string name) {
    int i = NameIdx_first(&s.tdecls_ix, name);
    if (i < 0) {
        return null;
    }
    return List_get<*DeclNode>(&s.tdecls, i);
}

// A declared type spelling (field / parameter / return / variable) must name known types,
// and a generic instance must supply exactly the template's type-parameter count
// (mirrors the C++ validateStructType).
int sema_fold_int(Sema* s, *ExprNode e, int64* out);
int sema_fold_num(Sema* s, *ExprNode e, int* is_int, int64* iv, double* dv);
string sema_trim_sub(string s, int a, int b);
void sema_check_decl_type(Sema* s, string t);
string sema_resolve_scalar(Sema* s, string t0);
string sema_isub(Sema* s, string t);
// `sizeof(t)` for a scalar whose size is the same on every target (0 otherwise).
int64 sema_fixed_scalar_size(string t) {
    if (sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "char") == 1
        || sema_streq(t, "bool") == 1) {
        return (int64)1;
    }
    if (sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1) {
        return (int64)2;
    }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1 || sema_streq(t, "uint") == 1
        || sema_streq(t, "uint32") == 1 || sema_streq(t, "float") == 1) {
        return (int64)4;
    }
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1 || sema_streq(t, "double") == 1) {
        return (int64)8;
    }
    return (int64)0;
}

string sema_dealias(Sema* s, string t0);
int sema_is_plain_enum_decl(*DeclNode d);
int64 sema_const_layout(Sema* s, string t0, int64* al, int depth);
// A name in a dimension that sema_const_layout folds: a classic enum member, a `const`
// int, or `sizeof(T)` of a type whose layout is known.
int sema_layout_dim_name(Sema* s, string nm, int64* out) {
    if (ast_has_prefix(nm, "sizeof(") == 1) {
        int64 zal = (int64)1;
        *out = sema_const_layout(s, sema_sub_str(nm, 7, sema_slen(nm) - 1), &zal, 1);
        return (int)(*out > (int64)0);
    }
    int64 ev = sema_dim_value(s, nm);
    if (ev >= (int64)0) {
        *out = ev;
        return 1;
    }
    int si = sema_sym_index(s, nm);
    if (si < 0) {
        return 0;
    }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.is_const == 1 && sy.init != null && sema_fold_int(s, sy.init, out) == 1) {
        return 1;
    }
    return 0;
}

// Size (and ABI alignment in *al) of a concrete type as the target lays it out, mirroring
// the C++ TypeChecker::constLayout and the codegen layout (cg_size): scalars, pointers,
// closures, interfaces, slices, fixed arrays, and structs and unions of those (C layout,
// `packed`). 0 for a layout only codegen knows here: a generic instance, a sum type, a
// bitfield struct, `#pragma pack(N)` with N >= 2, `va_list`, a type parameter.
int64 sema_const_layout(Sema* s, string t0, int64* al, int depth) {
    al[0] = (int64)1;
    if (depth > 64 || t0 == null) {
        return (int64)0;
    }
    string t = sema_strip_const(sema_dealias(s, sema_strip_const(t0)));
    if ((int)t[0] == 63) {                 // '?'
        t = sema_sub_str(t, 1, sema_slen(t));
    }
    int n = sema_slen(t);
    if (n == 0) {
        return (int64)0;
    }
    int64 ps = (int64)s.ptrsz;
    // The outermost array or slice is the first `[...]` outside any `<...>` or `(...)`.
    int k = 0;
    int dep = 0;
    int ob = 0 - 1;
    while (k < n && ob < 0) {
        int c = (int)t[k];
        if (c == 60 || c == 40) {
            dep = dep + 1;
        }
        else if ((c == 62 && k > 0 && (int)t[k - 1] != 45) || c == 41) {
            dep = dep - 1;
        }
        else if (c == 91 && dep == 0) {
            ob = k;
        }
        k = k + 1;
    }
    if (ob > 0 && (int)t[n - 1] == 93) {
        int cb = sema_dim_close(t, ob);
        string rest = sema_cat(sema_sub_str(t, 0, ob), sema_sub_str(t, cb + 1, n));
        if (cb == ob + 1) {                                                       // `T[]`: {ptr, i64}
            int64 sal = (int64)s.i64al;
            if (ps > sal) {
                sal = ps;
            }
            al[0] = sal;
            int64 off = ((ps + (int64)s.i64al - (int64)1) / (int64)s.i64al) * (int64)s.i64al + (int64)8;
            return ((off + sal - (int64)1) / sal) * sal;
        }
        string dim = sema_trim_sub(t, ob + 1, cb);
        int64 dv = (int64)0;
        int known = 0;
        if (sema_all_digits(dim) == 1) {
            dv = sema_parse_int(dim);
            known = 1;
        }
        else {
            known = ast_fold_dim(dim, int(string nm, *int64 out) {
                return sema_layout_dim_name(s, nm, out);
            }, &dv);
        }
        if (known == 0 || dv <= (int64)0) {
            return (int64)0;
        }
        int64 eal = (int64)1;
        int64 esz = sema_const_layout(s, rest, &eal, depth + 1);
        al[0] = eal;
        // The target's largest object: 2^61-1 bytes with 64-bit pointers, 2^32-1 with
        // 32-bit ones, as clang (mirrors the C++ layoutTooLarge).
        int64 limit = (int64)4294967295;
        if (s.ptrsz >= 8) {
            limit = (int64)2305843009213693951;
        }
        if (esz > (int64)0 && dv > limit / esz) {
            s.too_large = 1;
            return (int64)0;
        }
        return esz * dv;
    }
    if ((int)t[0] == 42 || (int)t[n - 1] == 42 || sema_streq(t, "string") == 1) {
        al[0] = ps;
        return ps;
    }
    if (sema_is_fn_type(t) == 1) {
        al[0] = ps;
        return ps * (int64)2;
    }
    int64 fx = sema_fixed_scalar_size(t);
    if (fx > (int64)0) {
        al[0] = fx;
        if (fx == (int64)8) {
            al[0] = (int64)s.i64al;
        }
        return fx;
    }
    List<string> targs;
    List_init<string>(&targs, 2);
    string base = t;
    int i = 0;
    while (i < n && (int)t[i] != 60) {
        i = i + 1;
    }
    if (i < n) {   // a generic instance
        base = sema_base_name(t);
        sema_parse_targs(t, &targs);
    }
    if (sema_in_list(&s.tparams, base) == 1) {
        return (int64)0;
    }
    *DeclNode d = sema_find_tdecl(s, base);
    if (d == null) {
        return (int64)0;
    }
    if (List_len<TypeParam>(&d.type_params) != List_len<string>(&targs)) {
        return (int64)0;
    }
    return sema_decl_layout(s, d, &targs, al, depth);
}

int64 sema_up(int64 x, int64 a) {
    if (a <= (int64)0) {
        return x;
    }
    return ((x + a - (int64)1) / a) * a;
}

// Size (and alignment in al[0]) of a declared type with its type arguments `targs`, as
// codegen lays it out; 0 when only codegen knows it (a `pack(N>=2)` struct, a `: 0`
// bitfield). Mirrors C++ TypeChecker::constLayout / bitfieldLayout.
int64 sema_decl_layout(Sema* s, *DeclNode d, List<string>* targs, int64* al, int depth) {
    int64 ps = (int64)s.ptrsz;
    if (d.kind == DK_INTERFACE) {
        al[0] = ps;
        return ps * (int64)2;
    }
    if (d.kind == DK_ENUM) {
        if (sema_is_plain_enum_decl(d) == 1) {
            al[0] = (int64)4;
            return (int64)4;
        }
        // { i32 tag, [N x i64] payload }, N the largest variant's bytes in i64s.
        int64 maxb = (int64)0;
        int vi = 0;
        while (vi < List_len<List<string>>(&d.payloads)) {
            List<string> pl = List_get<List<string>>(&d.payloads, vi);
            int64 b = (int64)0;
            int pi = 0;
            while (pi < List_len<string>(&pl)) {
                int64 pal = (int64)1;
                int64 psz = sema_const_layout(s, sema_subst_params(List_get<string>(&pl, pi), &d.type_params, targs), &pal, depth + 1);
                if (psz == (int64)0) {
                    return (int64)0;
                }
                b = sema_up(b, pal) + psz;
                pi = pi + 1;
            }
            if (b > maxb) {
                maxb = b;
            }
            vi = vi + 1;
        }
        int64 nw = (maxb + (int64)7) / (int64)8;
        if (nw == (int64)0) {
            nw = (int64)1;
        }
        int64 ea = (int64)s.i64al;
        if (ea < (int64)4) {
            ea = (int64)4;
        }
        al[0] = ea;
        return sema_up(sema_up((int64)4, (int64)s.i64al) + (int64)8 * nw, ea);
    }
    if (d.kind != DK_STRUCT && d.kind != DK_UNION) {
        return (int64)0;
    }
    // `#pragma pack(N>=2)`: each alignment capped at N and bitfields packed back to back;
    // the struct (or union) is as aligned as its most aligned (capped) field, as C
    // (mirrors the C++ constLayout).
    int64 packn = (int64)0;
    if (d.is_packed == 0 && d.pack_align >= 2) {
        packn = (int64)d.pack_align;
    }
    List<Param> lfs;
    List<int> lbits;
    List<int> lnamed;
    ast_layout_fields(d, &lfs, &lbits, &lnamed);
    int nf = List_len<Param>(&lfs);
    int hasbits = 0;
    if (List_len<string>(&d.pad_tys) > 0) {
        hasbits = 1;
    }
    int fi = 0;
    while (fi < nf) {
        if (List_get<int>(&lbits, fi) != 0) {
            hasbits = 1;
        }
        fi = fi + 1;
    }
    if (hasbits == 1 && d.kind == DK_UNION) {
        return (int64)0;
    }
    int64 off = (int64)0;
    int64 maxal = (int64)1;
    int64 bitpos = (int64)0;                         // SysV bitfield cursor
    int open = 0;   // MS open storage word
    int64 curbits = (int64)0;
    int64 curoff = (int64)0;
    int after = 0;                                   // MS: the previous field is a bitfield
    fi = 0;
    while (fi < nf) {
        int bw = List_get<int>(&lbits, fi);
        int unnamed = 1 - List_get<int>(&lnamed, fi);
        if (bw < 0) {
            return (int64)0;
        }
        int64 fal = (int64)1;
        int64 fsz = sema_const_layout(s, sema_subst_params(List_get<Param>(&lfs, fi).ty, &d.type_params, targs), &fal, depth + 1);
        if (fsz == (int64)0) {
            return (int64)0;
        }
        int64 nat = fal;
        if (d.is_packed == 1) {
            fal = (int64)1;
        }
        if (packn > (int64)0 && fal > packn) {
            fal = packn;
        }
        if (hasbits == 0) {
            if (fal > maxal) {
                maxal = fal;
            }
            if (d.kind == DK_UNION) {
                if (fsz > off) {
                    off = fsz;
                }
            }
            else {
                off = sema_up(off, fal) + fsz;
            }
        } else if (s.msbf == 1) {                    // MS: each storage word is an element
            if (unnamed == 1 && bw == 0) {
                // A `: 0` right after a bitfield closes the word and aligns the next field
                // to its type (capped by the packing on MSVC only); elsewhere it is ignored.
                if (after == 1) {
                    int64 za = nat;
                    if (s.msvc == 1) {
                        za = fal;
                    }
                    off = sema_up(off, za);
                    if (za > maxal) {
                        maxal = za;
                    }
                }
                open = 0;
                after = 0;
            } else if (bw > 0) {
                int64 stb = fsz * (int64)8;
                if (open == 0 || curbits != stb || curoff + (int64)bw > stb) {
                    off = sema_up(off, fal) + fsz;
                    if (fal > maxal) {
                        maxal = fal;
                    }
                    open = 1;
                    curbits = stb;
                    curoff = (int64)0;
                }
                curoff = curoff + (int64)bw;
                after = 1;
            } else {
                open = 0;
                after = 0;
                off = sema_up(off, fal) + fsz;
                if (fal > maxal) {
                    maxal = fal;
                }
            }
        } else if (unnamed == 1 && bw == 0) {        // SysV / AAPCS `: 0`: next boundary of its type
            bitpos = sema_up(bitpos, nat * (int64)8);
            if (s.bfal == 1 && nat > maxal) {
                maxal = nat;
            }
        } else {                                     // SysV / AAPCS (an unnamed one aligns only on AAPCS)
            if ((unnamed == 0 || s.bfal == 1) && fal > maxal) {
                maxal = fal;
            }
            if (bw > 0) {
                int64 ub = fsz * (int64)8;
                if (d.is_packed == 0 && packn == (int64)0 && fal < fsz) {
                    // Aligned below its size (int64 on 32-bit x86 SysV): may not cross its
                    // size from an alignment boundary.
                    if (bitpos % (fal * (int64)8) + (int64)bw > ub) {
                        bitpos = sema_up(bitpos, fal * (int64)8);
                    }
                } else if (d.is_packed == 0 && packn == (int64)0 && bitpos / ub != (bitpos + (int64)bw - (int64)1) / ub) {
                    bitpos = sema_up(bitpos, ub);
                }
                bitpos = bitpos + (int64)bw;
            } else {
                int64 fo = sema_up((bitpos + (int64)7) / (int64)8, fal);
                bitpos = (fo + fsz) * (int64)8;
            }
        }
        fi = fi + 1;
    }
    if (hasbits == 1 && s.msbf == 0) {
        off = (bitpos + (int64)7) / (int64)8;
    }
    al[0] = maxal;
    return sema_up(off, maxal);
}

int64 sema_const_sizeof(Sema* s, string t) {
    int64 al = (int64)1;
    return sema_const_layout(s, t, &al, 0);
}

// Does dimension text `dim` have a `sizeof(T)` whose size is target layout? Its value is
// then left to codegen.
int sema_dim_sized_later(Sema* s, string dim) {
    int n = 0;
    while (dim[n] != 0) {
        n = n + 1;
    }
    int i = 0;
    while (i + 7 <= n) {
        if (sema_streq(sema_sub_str(dim, i, i + 7), "sizeof(") == 1) {
            int j = i + 7;
            int depth = 1;
            while (j < n && depth > 0) {
                if (dim[j] == '(') {
                    depth = depth + 1;
                } else if (dim[j] == ')') {
                    depth = depth - 1;
                }
                j = j + 1;
            }
            if (sema_const_sizeof(s, sema_trim_sub(dim, i + 7, j - 1)) == (int64)0) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// A name in a dimension expression: a classic enum member or an in-scope `const` int.
// `sizeof(T)`: T must be a sized type; codegen, which knows the layout, folds the size
// (mirrors the C++ checkArrayDim).
int sema_dim_name(Sema* s, string nm, int64* out) {
    if (ast_has_prefix(nm, "sizeof(") == 1) {
        int nl = 0;
        while (nm[nl] != 0) {
            nl = nl + 1;
        }
        string t = sema_sub_str(nm, 7, nl - 1);
        int e0 = s.had_error;
        s.had_error = 0;
        sema_check_decl_type(s, t);
        if (s.had_error == 0 && sema_is_void_value(sema_resolve_scalar(s, sema_isub(s, t))) == 1) {
            sema_error(s, "sizeof of 'void': a void value has no size");
        }
        int fine = 1 - s.had_error;
        if (e0 == 1) {
            s.had_error = 1;
        }
        *out = (int64)0;
        if (fine == 1) {
            *out = sema_const_sizeof(s, t);
        }
        if (*out == (int64)0) {
            *out = (int64)8;
        }
        return 1;
    }
    int64 ev = sema_dim_value(s, nm);
    if (ev >= (int64)0) {
        *out = ev;
        return 1;
    }
    int si = sema_sym_index(s, nm);
    if (si < 0) {
        return 0;
    }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.depth == 0 && StrTab_has(&s.late_globals, nm) == 1) {
        return 0;
    }
    if (sy.is_const == 1 && sy.init != null && sema_fold_int(s, sy.init, out) == 1) {
        return 1;
    }
    return 0;
}

// Each fixed-array dimension `[N]` of `t` (a number, an enum member, or a `const` int)
// must be positive (mirrors the C++ checkArrayDim).
void sema_check_dims(Sema* s, string t) {
    int i = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 91 && (int)t[i + 1] != 93) {          // '[' not followed by ']'
            int st = i + 1;
            int j = st;
            while (t[j] != 0 && (int)t[j] != 93) {
                j = j + 1;
            }
            string dim = sema_trim_sub(t, st, j);
            int64 v = (int64)0;
            int known = 0;
            if ((int)dim[0] == 45 || sema_all_digits(dim) == 1) {
                v = sema_parse_int(dim);
                known = 1;
            }
            else {
                int64 ev = sema_dim_value(s, dim);
                if (ev >= (int64)0) {
                    v = ev;
                    known = 1;
                }
                int si = sema_sym_index(s, dim);
                if (known == 0 && si >= 0) {
                    Sym sy = List_get<Sym>(&s.syms, si);
                    int later = 0;                    // a global declared further down is not in scope yet
                    if (sy.depth == 0 && StrTab_has(&s.late_globals, dim) == 1) {
                        later = 1;
                    }
                    if (later == 0 && sy.is_const == 1 && sy.init != null && sema_fold_int(s, sy.init, &v) == 1) {
                        known = 1;
                    }
                }
                // An integer constant expression (`(uint8)258`, `N*2`), folded like a `const`
                // (mirrors the C++ checkArrayDim).
                if (known == 0 && si < 0) {
                    known = ast_fold_dim(dim, int(string nm, *int64 out) {
                        return sema_dim_name(s, nm, out);
                    }, &v);
                }
            }
            if (known == 1 && v <= (int64)0 && sema_dim_sized_later(s, dim) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array size must be positive, got %lld\n", s.filename, s.line, s.col, v);
            }
            if (known == 0 && dim[0] != 0) {             // no variable-length arrays
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array size must be a compile-time constant, got '%s'\n", s.filename, s.line, s.col, dim);
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
}

// Whether `t` is one of `d`'s type parameters.
int sema_names_tparam(*DeclNode d, string t) {
    int k = 0;
    while (k < List_len<TypeParam>(&d.type_params)) {
        if (sema_streq(List_get<TypeParam>(&d.type_params, k).name, t) == 1) {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

// A generic struct's bitfield typed by a type parameter is checked with the instance's
// type argument (mirrors the C++ per-instance checkBitfield).
void sema_check_inst_bitfields(Sema* s, *DeclNode d, List<string>* targs) {
    if (d.kind != DK_STRUCT) {
        return;
    }
    int i = 0;
    while (i < List_len<Param>(&d.params) && i < List_len<int>(&d.field_bits)) {
        Param f = List_get<Param>(&d.params, i);
        int bw = List_get<int>(&d.field_bits, i);
        int k = 0;
        while (bw > 0 && k < List_len<TypeParam>(&d.type_params) && k < List_len<string>(targs)) {
            if (sema_streq(List_get<TypeParam>(&d.type_params, k).name, f.ty) == 1) {
                string at = List_get<string>(targs, k);
                int tb = sema_int_bits(sema_bitfield_base(s, at));
                if (tb == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' must have an integer type, got '%s'\n", s.filename, s.line, s.col, f.name, d.name, at);
                } else if (bw > tb) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' is %d bits wide, more than its type '%s' holds (%d)\n",
                           s.filename, s.line, s.col, f.name, d.name, bw, at, tb);
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

// The spelling of an unknown type as the C++ checker names it: without pointer stars,
// array suffixes, `?` and `const`, but with its type arguments (`Opy<int>`).
string sema_unknown_spelling(string t0) {
    string t = sema_strip_nullable(sema_strip_const(t0));
    int b = 0;
    int e = sema_slen(t);
    while (b < e && (int)t[b] == 42) {                        // '*'
        b = b + 1;
    }
    int changed = 1;
    while (changed == 1) {
        changed = 0;
        while (e > b && (int)t[e - 1] == 42) {    // trailing '*'
            e = e - 1;
            changed = 1;
        }
        if (e > b && (int)t[e - 1] == 93) {                                   // ']'
            int k = e - 1;
            while (k > b && (int)t[k] != 91) {
                k = k - 1;
            }
            e = k;
            changed = 1;
        }
    }
    string r = sema_sub_str(t, b, e);
    if (sema_starts_with(r, "struct:") == 1) {
        r = sema_sub_str(r, 7, sema_slen(r));
    }
    return r;
}

void sema_check_decl_type(Sema* s, string t) {
    if (s.tool == 3) {
        sema_tool_note_inst(s, t);
    }
    if (t == null || t[0] == 0 || sema_streq(t, "...") == 1 || sema_is_fn_type(t) == 1) {
        return;
    }
    if ((int)t[0] == 63 && sema_known_type(s, t) == 1 && sema_c_ptr(sema_canon(s, t)) == 0) {   // `?` marks a pointer only
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: a nullable type must be a pointer ('?*T'), got '%s'\n", s.filename, s.line, s.col, t);
        return;
    }
    sema_check_dims(s, t);
    if (sema_is_arr_ty(t) == 1) {
        int64 zal = (int64)1;
        s.too_large = 0;
        sema_const_layout(s, t, &zal, 0);
        if (s.too_large == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: array is too large: '%s' exceeds the largest object size\n", s.filename, s.line, s.col, t);
        }
        s.too_large = 0;
    }
    if (sema_known_type(s, t) == 0) {
        s.had_error = 1;
        string utn = sema_base_name(sema_struct_of_type(t));
        dprintf(2, "error: %s:%d:%d: unknown type '%s'%s\n", s.filename, s.line, s.col, sema_unknown_spelling(t),
                sema_did_you_mean(s, utn, 1, t));
        return;
    }
    string b = sema_base_name(sema_struct_of_type(sema_strip_nullable(sema_strip_const(t))));
    *DeclNode d = sema_find_tdecl(s, b);
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(t, &targs);
    int want = 0;
    if (d != null) {
        want = List_len<TypeParam>(&d.type_params);
    }
    int got = List_len<string>(&targs);
    if (d != null && (want > 0 || got > 0) && want != got) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: '%s' expects %d type argument(s), got %d\n", s.filename, s.line, s.col, b, want, got);
        return;
    }
    int k = 0;
    while (k < got) {
        sema_check_decl_type(s, List_get<string>(&targs, k));
        k = k + 1;
    }
    if (d != null && want > 0 && want == got) {
        sema_check_constraints(s, &d.type_params, &targs);
        sema_check_inst_bitfields(s, d, &targs);
    }
}

// Name of the struct/union a field of type `ft` holds BY VALUE ("" for a pointer, slice,
// fn, or non-struct): a fixed-size array of a struct still holds it by value.
string sema_value_struct(Sema* s, string ft) {
    if (sema_has_star(ft) == 1 || sema_is_fn_type(ft) == 1) {
        return "";
    }
    int i = 0;   // "[]" slice
    while (ft[i] != 0) {
        if ((int)ft[i] == 91 && (int)ft[i + 1] == 93) {
            return "";
        }
        i = i + 1;
    }
    string b0 = sema_strip_const(ft);
    int n = 0;
    while (b0[n] != 0 && (int)b0[n] != 91) {
        n = n + 1;
    }
    string b = sema_base_name(sema_sub_str(b0, 0, n));
    *DeclNode d = sema_find_tdecl(s, b);
    int hops = 0;                          // through type aliases (`type SS = S;`)
    while (d != null && d.kind == DK_TYPEALIAS && hops < 32) {
        string at = d.ret_type;
        if (sema_has_star(at) == 1 || sema_is_fn_type(at) == 1) {
            return "";
        }
        int k = 0;
        while (at[k] != 0) {
            if ((int)at[k] == 91 && (int)at[k + 1] == 93) {
                return "";
            }
            k = k + 1;
        }
        string a0 = sema_strip_const(at);
        int an = 0;
        while (a0[an] != 0 && (int)a0[an] != 91) {
            an = an + 1;
        }
        b = sema_base_name(sema_sub_str(a0, 0, an));
        d = sema_find_tdecl(s, b);
        hops = hops + 1;
    }
    if (d == null || (d.kind != DK_STRUCT && d.kind != DK_UNION && d.kind != DK_ENUM)) {
        return "";
    }
    if (List_len<TypeParam>(&d.type_params) > 0) {
        return "";
    }
    return b;
}

// The by-value members of an aggregate (mirrors the C++ VNode): a struct/union's field
// types, or an enum's variant payload types; `descs` gets "field 'x'" / "variant 'V'".
void sema_value_members(*DeclNode d, List<string>* types, List<string>* descs) {
    int i = 0;
    int n = List_len<Param>(&d.params);
    while (i < n) {
        Param f = List_get<Param>(&d.params, i);
        if (d.kind == DK_ENUM) {
            if (i < List_len<List<string>>(&d.payloads)) {
                List<string> pl = List_get<List<string>>(&d.payloads, i);
                int j = 0;
                while (j < List_len<string>(&pl)) {
                    List_push<string>(types, List_get<string>(&pl, j));
                    List_push<string>(descs, sema_cat(sema_cat("variant '", f.name), "'"));
                    j = j + 1;
                }
            }
        } else {
            List_push<string>(types, f.ty);
            List_push<string>(descs, sema_cat(sema_cat("field '", f.name), "'"));
        }
        i = i + 1;
    }
}

string sema_value_kind(*DeclNode d) {
    if (d != null && d.kind == DK_ENUM) {
        return "enum";
    }
    return "struct";
}

// An aggregate with by-value members: a struct, a union, or a sum type (an enum with a
// payload).
int sema_is_value_aggr(*DeclNode d) {
    if (d == null) {
        return 0;
    }
    if (d.kind == DK_STRUCT || d.kind == DK_UNION) {
        return 1;
    }
    if (d.kind != DK_ENUM) {
        return 0;
    }
    int i = 0;
    while (i < List_len<List<string>>(&d.payloads)) {
        List<string> pl = List_get<List<string>>(&d.payloads, i);
        if (List_len<string>(&pl) > 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// DFS for a struct/union that contains itself by value (no finite layout). `onstack` holds
// the current path, `done` the finished nodes, `reported` the already-diagnosed structs.
void sema_cycle_dfs(Sema* s, *DeclNode d, List<string>* onstack, StrTab* done, List<string>* reported) {
    List_push<string>(onstack, d.name);
    s.line = d.line;
    s.col = d.col;
    List<string> ftys;
    List_init<string>(&ftys, 4);
    List<string> fdescs;
    List_init<string>(&fdescs, 4);
    sema_value_members(d, &ftys, &fdescs);
    int i = 0;
    int n = List_len<string>(&ftys);
    while (i < n) {
        string m = sema_value_struct(s, List_get<string>(&ftys, i));
        if (m[0] != 0) {
            if (sema_in_list(onstack, m) == 1) {
                if (sema_in_list(reported, m) == 0) {
                    List_push<string>(reported, m);
                    s.had_error = 1;
                    *DeclNode md = sema_find_tdecl(s, m);
                    dprintf(2, "error: %s:%d:%d: %s '%s' contains itself by value (through %s of '%s'); use a pointer\n",
                           s.filename, md.line, md.col, sema_value_kind(md), m, List_get<string>(&fdescs, i), d.name);
                }
            } else if (StrTab_has(done, m) == 0) {
                sema_cycle_dfs(s, sema_find_tdecl(s, m), onstack, done, reported);
            }
        }
        i = i + 1;
    }
    sema_list_erase(onstack, d.name);
    StrTab_set(done, d.name, 1);
}

// The struct spelling a field of type `ft` holds by value, through generic instances too
// ("" for a pointer, slice, fn, or non-struct); array suffixes are peeled. Spaces dropped.
string sema_value_core_n(Sema* s, string ft, int hops);
string sema_value_core(Sema* s, string ft) {
    return sema_value_core_n(s, ft, 0);
}

// An alias is resolved (`type RA = W<RB>` holds a `W<RB>`), then arrays peeled again.
string sema_value_core_n(Sema* s, string ft, int hops) {
    string t = sema_nospace(sema_strip_nullable(sema_strip_const(ft)));
    if ((int)t[0] == 42 || (int)t[0] == 63 || sema_is_fn_type(t) == 1) {
        return "";
    }
    int depth = 0;
    int n = 0;
    while (t[n] != 0) {
        int c = (int)t[n];
        if (c == 60) {
            depth = depth + 1;
        }
        else if (c == 62) {
            depth = depth - 1;
        }
        else if (c == 91 && depth == 0) {
            break;
        }
        n = n + 1;
    }
    if (t[n] != 0 && (int)t[n + 1] == 93) {        // "T[]" slice
        return "";
    }
    string core = sema_sub_str(t, 0, n);
    int m = 0;
    while (core[m] != 0) {
        m = m + 1;
    }
    if (m == 0 || (int)core[m - 1] == 42) {         // trailing-star pointer
        return "";
    }
    *DeclNode d = sema_find_tdecl(s, sema_base_name(core));
    if (d != null && d.kind == DK_TYPEALIAS && hops < 32) {
        return sema_value_core_n(s, d.ret_type, hops + 1);
    }
    if (sema_is_value_aggr(d) == 0) {
        return "";
    }
    return core;
}

// Walk the by-value field spellings of struct spelling `sp` (a generic instance's type
// arguments substituted), with `stack` the current path. A spelling that recurs on it is
// a cycle through a generic instance; a path of ever-growing instances (`N<N<T>> next`)
// has no finite layout either. Reports once per struct (`reported`); 1 = stop the walk.
// Mirrors the generic part of the C++ TypeChecker::checkValueCycles.
int sema_gen_cycle_walk(Sema* s, string sp, List<string>* stack, *DeclNode root, List<string>* reported) {
    *DeclNode d = sema_find_tdecl(s, sema_base_name(sp));
    if (d == null) {
        return 0;
    }
    List<string> args;
    List_init<string>(&args, 2);
    ast_targs(sp, &args);
    if (List_len<TypeParam>(&d.type_params) != List_len<string>(&args)) {
        return 0;
    }
    List_push<string>(stack, sp);
    List<string> ftys;
    List_init<string>(&ftys, 4);
    List<string> fdescs;
    List_init<string>(&fdescs, 4);
    sema_value_members(d, &ftys, &fdescs);
    int i = 0;
    int n = List_len<string>(&ftys);
    while (i < n) {
        string fdesc = List_get<string>(&fdescs, i);
        string core = sema_value_core(s, sema_subst_params(List_get<string>(&ftys, i), &d.type_params, &args));
        if (core[0] != 0) {
            int hit = 0 - 1;
            int k = 0;
            while (k < List_len<string>(stack)) {
                if (sema_streq(List_get<string>(stack, k), core) == 1) {
                    hit = k;
                }
                k = k + 1;
            }
            string msg = "";
            string key = "";
            if (hit >= 0) {
                int gen = 0;
                k = hit;
                while (k < List_len<string>(stack)) {
                    if (sema_has_lt(List_get<string>(stack, k)) == 1) {
                        gen = 1;
                    }
                    k = k + 1;
                }
                if (gen == 1) {
                    key = sema_base_name(core);
                    msg = "cycle";
                }
            } else if (List_len<string>(stack) >= 64) {
                key = sema_base_name(List_get<string>(stack, 0));
                msg = "deep";
            } else if (sema_gen_cycle_walk(s, core, stack, root, reported) == 1) {
                List_remove<string>(stack, List_len<string>(stack) - 1);
                return 1;
            }
            if (msg[0] != 0) {
                if (sema_in_list(reported, key) == 0) {
                    List_push<string>(reported, key);
                    s.had_error = 1;
                    string kw = sema_value_kind(sema_find_tdecl(s, key));
                    if (sema_streq(msg, "cycle") == 1) {
                        dprintf(2, "error: %s:%d:%d: %s '%s' contains itself by value (through %s of '%s'); use a pointer\n",
                               s.filename, root.line, root.col, kw, core, fdesc, sp);
                    } else {
                        dprintf(2, "error: %s:%d:%d: %s '%s' contains itself by value through ever-deeper generic instances (%s of '%s'); use a pointer\n",
                               s.filename, root.line, root.col, kw, key, fdesc, sema_base_name(sp));
                    }
                }
                List_remove<string>(stack, List_len<string>(stack) - 1);
                return 1;
            }
        }
        i = i + 1;
    }
    List_remove<string>(stack, List_len<string>(stack) - 1);
    return 0;
}

void sema_check_value_cycles(Sema* s) {
    List<string> onstack;
    List_init<string>(&onstack, 4);
    let done: StrTab;
    memset((*void)&done, 0, sizeof(StrTab));
    List<string> reported;
    List_init<string>(&reported, 2);
    int i = 0;
    int n = List_len<*DeclNode>(&s.tdecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.tdecls, i);
        if (sema_is_value_aggr(d) == 1 && List_len<TypeParam>(&d.type_params) == 0
            && StrTab_has(&done, d.name) == 0) {
            sema_cycle_dfs(s, d, &onstack, &done, &reported);
        }
        i = i + 1;
    }
    // Through generic instances: from every struct (a generic one with its own type
    // parameters, `N<T>`).
    List<string> greported;
    List_init<string>(&greported, 2);
    i = 0;
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.tdecls, i);
        if (sema_is_value_aggr(d) == 1) {
            string sp = d.name;
            int tp = 0;
            while (tp < List_len<TypeParam>(&d.type_params)) {
                if (tp == 0) {
                    sp = sema_cat(sp, "<");
                } else {
                    sp = sema_cat(sp, ",");
                }
                sp = sema_cat(sp, List_get<TypeParam>(&d.type_params, tp).name);
                tp = tp + 1;
            }
            if (tp > 0) {
                sp = sema_cat(sp, ">");
            }
            List<string> stack;
            List_init<string>(&stack, 8);
            sema_gen_cycle_walk(s, sp, &stack, d, &greported);
        }
        i = i + 1;
    }
}

int sema_is_struct(Sema* s, string name) {
    return NameIdx_first(&s.sdecls_ix, name) >= 0;
}

int sema_has_member(Sema* s, string key) {   // key = "Struct.member"
    return NameIdx_first(&s.members_ix, key) >= 0;
}

// Is `name` a variant of any enum (e.g. a generic `Some` constructed as `Some<int>(5)`)?
int sema_is_variant_name(Sema* s, string name) {
    return NameIdx_first(&s.evars_ix, name) >= 0;
}

// The variant `v` of enum `en` (plain = 0 and val = null when absent).
EVar sema_find_evar(Sema* s, string en, string v) {
    int i = NameIdx_first(&s.evars_ix, v);
    while (i >= 0) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (sema_streq(ev.en, en) == 1) {
            return ev;
        }
        i = NameIdx_next(&s.evars_ix, i);
    }
    let none: EVar;
    none.en = en;
    none.variant = v;
    none.val = null;
    none.plain = 0;
    return none;
}

// A variant of `en` other than `self_v`, already in `seen`, whose value is `val` ("" if none).
string sema_evar_with_val(Sema* s, string en, string val, List<string>* seen, string self_v) {
    int i = 0;
    int n = List_len<EVar>(&s.evars);
    while (i < n) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (sema_streq(ev.en, en) == 1 && sema_streq(ev.variant, self_v) == 0 && sema_streq(ev.val, val) == 1
            && sema_in_list(seen, ev.variant) == 1) {
            return ev.variant;
        }
        i = i + 1;
    }
    return "";
}

int sema_is_enum(Sema* s, string name) {
    return NameIdx_first(&s.enums_ix, name) >= 0;
}

// `+ - * / %`: the operators whose result type sema_infer_type derives from its operands.
int sema_is_arith_op(string op) {
    return sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1 || sema_streq(op, "*") == 1
        || sema_streq(op, "/") == 1 || sema_streq(op, "%") == 1;
}

// A value-producing binary operator (arithmetic, bitwise or shift): its result type
// follows its operands' types.
int sema_is_valop(string op) {
    return sema_is_arith_op(op) == 1 || sema_streq(op, "&") == 1 || sema_streq(op, "|") == 1
        || sema_streq(op, "^") == 1 || sema_streq(op, "<<") == 1 || sema_streq(op, ">>") == 1;
}

// The integer promotion of a canonical integer type (C: narrow types become `int`).
string sema_int_promote(string t) {
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) {
        return t;
    }
    if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) {
        return "uint";
    }
    return "int";
}

// The user operator overload of `op` whose parameters take operand types `tys` (exactly,
// or through a numeric conversion, as the C++ resolveOperator's assignability does), or
// null. `op` is the overload spelling ("+", "u-", "[]").
*DeclNode sema_find_op(Sema* s, string op, List<string>* tys) {
    int n = List_len<string>(tys);
    int pass = 0;
    while (pass < 2) {
        int i = 0;
        int nd = List_len<*DeclNode>(&s.fndecls);
        while (i < nd) {
            *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
            if (d.operator_sym != null && sema_streq(d.operator_sym, op) == 1 && List_len<Param>(&d.params) == n) {
                int ok = 1;
                int k = 0;
                while (k < n && ok == 1) {
                    string pc = sema_canon(s, List_get<Param>(&d.params, k).ty);
                    string ac = sema_canon(s, List_get<string>(tys, k));
                    if (sema_streq(pc, ac) == 0) {
                        if (pass == 0) {
                            ok = 0;
                        }
                        else if (sema_is_numeric_ty(pc) == 0 || sema_is_numeric_ty(ac) == 0
                                 || (sema_is_int_ty(pc) == 1 && sema_is_float_ty(ac) == 1)) {
                            if (sema_c_ptr(pc) == 0 || (sema_c_ptr(ac) == 0 && sema_streq(ac, "null") == 0)) {
                                ok = 0;
                            }
                            // pointers convert only through `*void` (or from null), as in C++
                            else if (sema_streq(ac, "null") == 0 && sema_streq(pc, "*void") == 0 && sema_streq(ac, "*void") == 0
                                     && sema_streq(pc, "string") == 0 && sema_streq(ac, "string") == 0) {
                                ok = 0;
                            }
                        }
                    }
                    k = k + 1;
                }
                if (ok == 1) {
                    return d;
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return null;
}

// The user overload of binary `op` for operand types `lt`, `rt` (null if none).
*DeclNode sema_find_binop(Sema* s, string op, string lt, string rt) {
    List<string> tys;
    List_init<string>(&tys, 2);
    List_push<string>(&tys, lt);
    List_push<string>(&tys, rt);
    return sema_find_op(s, op, &tys);
}

// The inferred type of binary `op` over operand types `lt` and `rt` (as sema_infer_type
// gives them; "" = unknown): comparisons and `&&`/`||` are bool; numbers follow C's usual
// arithmetic conversions (a shift takes its promoted left operand's type); pointer
// arithmetic keeps the pointer (`ptr - ptr` counts elements, int64); a struct operand
// goes through its user operator overload.
string sema_binary_type(Sema* s, string op, string lt, string rt) {
    if (sema_is_cmp_op(op) == 1 || sema_streq(op, "&&") == 1 || sema_streq(op, "||") == 1) {
        return "bool";
    }
    if (sema_is_valop(op) == 0) {
        return "";
    }
    if (lt[0] == 0 || rt[0] == 0) {
        return "";
    }
    // Stepping a `?*T` does not prove it non-null: `p + n` is still a `?*T`.
    if ((sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1) && (int)lt[0] == 63 && sema_is_int_ty(sema_canon(s, rt)) == 1) {
        return lt;
    }
    string l = sema_canon(s, lt);
    string r = sema_canon(s, rt);
    if (sema_is_numeric_ty(l) == 1 && sema_is_numeric_ty(r) == 1) {
        if (sema_is_float_ty(l) == 1 || sema_is_float_ty(r) == 1) {
            if (sema_streq(op, "+") == 0 && sema_streq(op, "-") == 0 && sema_streq(op, "*") == 0
                && sema_streq(op, "/") == 0 && sema_streq(op, "%") == 0) {
                return "";
            }
            if (sema_streq(l, "double") == 1 || sema_streq(r, "double") == 1) {
                return "double";
            }
            return "float";
        }
        if (sema_streq(op, "<<") == 1 || sema_streq(op, ">>") == 1) {
            return sema_int_promote(l);
        }
        return ast_range_var_type(sema_int_promote(l), sema_int_promote(r));
    }
    int lp = sema_c_ptr(l);
    int rp = sema_c_ptr(r);
    if (lp == 1 && sema_is_int_ty(r) == 1 && (sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1)) {
        return sema_strip_nullable(lt);
    }
    if (lp == 1 && rp == 1 && sema_streq(op, "-") == 1) {
        return "int64";
    }
    *DeclNode od = sema_find_binop(s, op, lt, rt);
    if (od != null) {
        return od.ret_type;
    }
    return "";
}

// The pointee of pointer type `t` ("" when not a pointer): `*T` / `T*` give T, and a
// `const T*` gives `const T`.
string sema_pointee(string t0) {
    string t = sema_strip_nullable(t0);
    int cst = 0;
    if (sema_pointee_const(t) == 1) {
        cst = 1;
        t = sema_strip_const(t);
    }
    int n = sema_slen(t);
    string r = "";
    if (n > 0 && (int)t[n - 1] == 93) {   // `*T[N]`: an array, not a pointer
        return "";
    }
    if (n >= 6 && sema_streq(sema_sub_str(t, n - 6, n), "*const") == 1) {
        r = sema_sub_str(t, 0, n - 6);
    }
    else if (n > 0 && (int)t[n - 1] == 42) {
        r = sema_sub_str(t, 0, n - 1);
    }
    else if (n > 0 && (int)t[0] == 42) {
        r = sema_sub_str(t, 1, n);
    }
    else {
        return "";
    }
    if (cst == 1) {
        return sema_cat("const ", r);
    }
    return r;
}

// Element type of slice type `t` ("int[]" -> "int"), "" when not a slice.
string sema_slice_elem(string t0) {
    string t = sema_strip_const(sema_strip_nullable(t0));
    int n = sema_slen(t);
    if (n > 2 && (int)t[n - 2] == 91 && (int)t[n - 1] == 93) {
        return sema_sub_str(t, 0, n - 2);
    }
    return "";
}

// "fn(T1,T2)->R" of a lambda signature spelling "R(T1 a, T2 b)".
string sema_lambda_fn_type(string sig) {
    string ret = sema_lambda_ret(sig);
    if (ret[0] == 0) {
        return "";
    }
    List<string> ps;
    List_init<string>(&ps, 4);
    sema_lambda_params(sig, &ps);
    string out = "fn(";
    int k = 0;
    while (k < List_len<string>(&ps)) {
        if (k > 0) {
            out = sema_cat(out, ",");
        }
        out = sema_cat(out, List_get<string>(&ps, k));
        k = k + 1;
    }
    return sema_cat(sema_cat(out, ")->"), ret);
}

// The value type `T` of a `*Future<T>` ("" if `t` is not one).
string sema_future_inner(Sema* s, string t) {
    string c = sema_canon(s, t);
    if ((int)c[0] != 42) {
        return "";
    }
    string inr = sema_sub_str(c, 1, sema_slen(c));
    if (sema_streq(sema_base_name(inr), "Future") == 0) {
        return "";
    }
    List<string> targs;
    List_init<string>(&targs, 1);
    sema_parse_targs(inr, &targs);
    if (List_len<string>(&targs) != 1) {
        return "";
    }
    return List_get<string>(&targs, 0);
}

// The type an `async` function's call yields: `*Future<T>`.
// An `async void` function's future carries a 1-byte unit (uint8), as in the C++.
string sema_async_type(string ret) {
    string r = ret;
    if (sema_streq(sema_strip_const(ret), "void") == 1) {
        r = "uint8";
    }
    return sema_cat(sema_cat("*Future<", r), ">");
}

// The return type of the method call `x.m(args)` `e` ("" when unknown).
string sema_method_ret(Sema* s, *ExprNode e) {
    *ExprNode mem = e.a;
    string bt = sema_infer_type(s, mem.a);
    if (bt[0] == 0 || sema_is_fn_type(bt) == 1) {
        return "";
    }
    string sn = sema_struct_of_type(bt);
    *DeclNode ifc = sema_find_iface(s, sn);
    if (ifc != null) {
        int ii = 0;
        while (ii < List_len<*DeclNode>(&ifc.methods)) {
            *DeclNode c = List_get<*DeclNode>(&ifc.methods, ii);
            if (sema_streq(c.name, mem.sval) == 1) {
                return c.ret_type;
            }
            ii = ii + 1;
        }
        return "";
    }
    *DeclNode sd = sema_find_struct(s, sn);
    if (sd == null) {
        return "";
    }
    List<string> rtargs;
    List_init<string>(&rtargs, 2);
    sema_parse_targs(sema_strip_ptr_sp(sema_strip_const(bt)), &rtargs);
    int j = 0;
    while (j < List_len<*DeclNode>(&sd.methods)) {
        *DeclNode cm = List_get<*DeclNode>(&sd.methods, j);
        if (sema_streq(cm.name, mem.sval) == 1) {
            if (List_len<TypeParam>(&sd.type_params) > 0 && List_len<string>(&rtargs) != List_len<TypeParam>(&sd.type_params)) {
                return "";
            }
            if (cm.is_async == 1) {
                return "";
            }
            return sema_subst_params(cm.ret_type, &sd.type_params, &rtargs);
        }
        j = j + 1;
    }
    int fi = 0;
    while (fi < List_len<Param>(&sd.params)) {
        Param fp = List_get<Param>(&sd.params, fi);
        if (sema_streq(fp.name, mem.sval) == 1) {
            string fty = sema_subst_params(fp.ty, &sd.type_params, &rtargs);
            if (sema_is_fn_type(fty) == 1) {
                return sema_fn_ret(fty);
            }
            return "";
        }
        fi = fi + 1;
    }
    *DeclNode ffn = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mem.sval));
    if (ffn == null || ffn.is_async == 1 || List_len<Param>(&ffn.params) == 0) {
        return "";
    }
    if (List_len<TypeParam>(&ffn.type_params) == 0) {
        return ffn.ret_type;
    }
    List<string> gtargs;
    List_init<string>(&gtargs, 2);
    if (sema_method_targs(s, ffn, bt, e, &gtargs) == 0) {
        return "";
    }
    return sema_subst_params(ffn.ret_type, &ffn.type_params, &gtargs);
}

// The enum a variant constructor `name` builds, or null.
*DeclNode sema_variant_enum(Sema* s, string name) {
    int i = NameIdx_first(&s.evars_ix, name);
    if (i < 0) {
        return null;
    }
    return sema_find_tdecl(s, List_get<EVar>(&s.evars, i).en);
}

string sema_infer_type(Sema* s, *ExprNode e);
int sema_variant_index(*DeclNode d, string v);

// The type of a generic variant constructor `Some(x)` without type arguments: each type
// parameter that is a payload field's whole type takes that argument's type (mirrors the
// C++ inference, which does not look at the target type). "" when one stays unbound.
string sema_variant_ctor_type(Sema* s, *DeclNode ed, *ExprNode e) {
    int vi = sema_variant_index(ed, e.a.sval);
    if (vi < 0 || vi >= List_len<List<string>>(&ed.payloads)) {
        return "";
    }
    List<string> pl = List_get<List<string>>(&ed.payloads, vi);
    int tn = List_len<TypeParam>(&ed.type_params);
    List<string> bound;
    List_init<string>(&bound, 2);
    int t = 0;
    while (t < tn) {
        List_push<string>(&bound, "");
        t = t + 1;
    }
    int i = 0;
    while (i < List_len<string>(&pl) && i < List_len<*ExprNode>(&e.kids)) {
        string pt = sema_nospace(List_get<string>(&pl, i));
        t = 0;
        while (t < tn) {
            if (sema_streq(pt, List_get<TypeParam>(&ed.type_params, t).name) == 1 && List_get<string>(&bound, t)[0] == 0) {
                string at = sema_infer_type(s, List_get<*ExprNode>(&e.kids, i));
                if (at[0] == 0) {
                    return "";
                }
                List_set<string>(&bound, t, at);
            }
            t = t + 1;
        }
        i = i + 1;
    }
    string r = sema_cat(ed.name, "<");
    t = 0;
    while (t < tn) {
        if (List_get<string>(&bound, t)[0] == 0) {
            return "";
        }
        if (t > 0) {
            r = sema_cat(r, ",");
        }
        r = sema_cat(r, List_get<string>(&bound, t));
        t = t + 1;
    }
    return sema_cat(r, ">");
}

// Best-effort string type of an expression ("" = unknown), mirroring the C++
// getExpressionType for the forms whose type is certain here.
// A type spelled as a type alias (`PSq` for `type PSq = *Sq`), through every alias hop,
// const dropped; any other spelling unchanged (mirrors the C++ dealiasOperand). A classic
// enum keeps its name (a `match` recovers the variant set from it).
string sema_dealias(Sema* s, string t0) {
    if (s.has_alias == 0 || t0 == null || t0[0] == 0) {
        return t0;
    }
    string t = sema_strip_const(t0);
    int hops = 0;
    while (hops < 32) {
        int i = 0;
        while (t[i] != 0 && sema_is_idc((int)t[i]) == 1) {
            i = i + 1;
        }
        if (i == 0 || t[i] != 0 || sema_in_list(&s.tparams, t) == 1) {
            hops = 32;
        }
        else {
            *DeclNode ad = sema_find_tdecl(s, t);
            if (ad == null || ad.kind != DK_TYPEALIAS) {
                hops = 32;
            }
            else {
                t = sema_strip_const(ad.ret_type);
            }
        }
        hops = hops + 1;
    }
    if (sema_streq(t, sema_strip_const(t0)) == 1) {
        return t0;
    }
    return t;
}

string sema_infer_type_raw(Sema* s, *ExprNode e);

// The struct a `self` parameter points to, through aliases (`*VV self`, `type VV = V`).
string sema_self_struct(Sema* s, string t) {
    string d = sema_dealias(s, t);
    int n = sema_slen(d);
    int a = 0;
    while (a < n && ((int)d[a] == 42 || (int)d[a] == 32)) {
        a = a + 1;
    }
    int b = n;
    while (b > a && ((int)d[b - 1] == 42 || (int)d[b - 1] == 32)) {
        b = b - 1;
    }
    return sema_struct_of_type(sema_dealias(s, sema_sub_str(d, a, b)));
}

// The type of an expression, never spelled as an alias: every shape check (pointer,
// array, slice, fn value, interface, struct) sees the alias's target.
string sema_infer_type(Sema* s, *ExprNode e) {
    return sema_dealias(s, sema_infer_type_raw(s, e));
}

// The type of member `field` of a value of type `mbt` (`s.f` → the field's declared
// type, `sl.len` → int64), or "" when unknown.
string sema_member_type(Sema* s, string mbt, string field) {
    if (mbt[0] != 0 && sema_is_fn_type(mbt) == 0) {
        if (sema_slice_elem(mbt)[0] != 0 && sema_has_star(mbt) == 0 && sema_streq(field, "len") == 1) {
            return "int64";
        }
        *DeclNode msd = sema_find_struct(s, sema_struct_of_type(mbt));
        List<string> mtargs;
        List_init<string>(&mtargs, 2);
        if (msd != null) {
            sema_parse_targs(sema_strip_ptr_sp(sema_strip_const(mbt)), &mtargs);
        }
        // A generic struct's field resolves only through an instance (`Box<int>`).
        if (msd != null && (List_len<TypeParam>(&msd.type_params) == 0
            || List_len<string>(&mtargs) == List_len<TypeParam>(&msd.type_params))) {
            int mi = sema_field_index(msd, field);
            if (mi >= 0) {
                Param mf = List_get<Param>(&msd.params, mi);
                // A bitfield whose values all fit an int reads as `int` (C promotion).
                if (mi < List_len<int>(&msd.field_bits) && List_get<int>(&msd.field_bits, mi) > 0
                    && sema_streq(ast_bf_read_type(sema_canon(s, sema_strip_const(mf.ty)), List_get<int>(&msd.field_bits, mi)), "int") == 1) {
                    return "int";
                }
                return sema_subst_params(mf.ty, &msd.type_params, &mtargs);
            }
        }
    }
    return "";
}

// The common type of a `?:`'s arms ("" when unknown), for sema_infer_type_raw.
string sema_ternary_type(Sema* s, *ExprNode e) {
    string tt = sema_infer_type(s, e.b);
    string et = sema_infer_type(s, List_get<*ExprNode>(&e.kids, 0));
    if (tt[0] == 0 || et[0] == 0) {
        return "";
    }
    string tc = sema_canon(s, tt);
    string ec = sema_canon(s, et);
    if (sema_is_numeric_ty(tc) == 1 && sema_is_numeric_ty(ec) == 1 && sema_streq(tc, ec) == 0) {
        if (sema_is_float_ty(tc) == 1 || sema_is_float_ty(ec) == 1) {
            if (sema_streq(tc, "double") == 1 || sema_streq(ec, "double") == 1) {
                return "double";
            }
            return "float";
        }
        return ast_range_var_type(sema_int_promote(tc), sema_int_promote(ec));
    }
    if (sema_streq(tc, "null") == 1) {
        return et;
    }
    if (sema_streq(ec, "null") == 1) {
        return tt;
    }
    if (sema_pointee_const(et) == 1 && sema_pointee_const(tt) == 0) {
        return et;
    }
    if (sema_streq(tc, ec) == 1 || sema_c_ptr(tc) == 1) {
        return tt;
    }
    return "";
}

string sema_infer_type_raw(Sema* s, *ExprNode e) {
    if (e == null) {
        return "";
    }
    if (e.kind == EK_IDENT) {
        string vt = sema_lookup_type(s, e.sval);
        if (vt[0] == 63 && sema_is_narrowed(s, e.sval) == 1) {   // proven non-null here
            return sema_strip_nullable(vt);
        }
        if (vt[0] != 0) {                      // a variable / param with a known type
            return vt;
        }
        int si = sema_sym_index(s, e.sval);
        if (si >= 0 && List_get<Sym>(&s.syms, si).depth > 0) {   // a local of unknown type
            return "";
        }
        *DeclNode ff = sema_find_fndecl(s, e.sval);         // else maybe a bare function used as a value
        if (ff != null && ff.is_async == 0) {               // build its "fn(params)->ret" spelling (parser form)
            string ft = "fn(";
            int i = 0;
            int np = List_len<Param>(&ff.params);
            while (i < np) {
                if (i > 0) {
                    ft = sema_cat(ft, ",");
                }
                ft = sema_cat(ft, List_get<Param>(&ff.params, i).ty);
                i = i + 1;
            }
            return sema_cat(sema_cat(ft, ")->"), ff.ret_type);
        }
        if (ff == null && si >= 0) {                        // an enum member: a classic one is an int
            *DeclNode ed = sema_variant_enum(s, e.sval);
            if (ed != null && List_len<TypeParam>(&ed.type_params) == 0) {
                if (sema_is_plain_enum_decl(ed) == 1) {
                    return "int";
                }
                return ed.name;
            }
        }
        return "";
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {                       // int, or int64 when it does not fit
            if (sema_int_lit_fits("int", e.sval) == 0) {
                return "int64";
            }
            return "int";
        }
        if (e.lit_kind == LIT_FLOAT) {
            return "double";
        }
        if (e.lit_kind == LIT_STRING) {
            return "string";
        }
        if (e.lit_kind == LIT_CHAR) {
            return "char";
        }
        if (e.lit_kind == LIT_BOOL) {
            return "bool";
        }
        if (e.lit_kind == LIT_NULL) {
            return "null";
        }
        return "";
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_IDENT && List_len<*ExprNode>(&e.kids) == 1
        && sema_streq(e.a.sval, "dbg") == 1 && sema_lookup(s, "dbg") == 0 && sema_find_fndecl(s, "dbg") == null) {
        return sema_infer_type(s, List_get<*ExprNode>(&e.kids, 0));
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_IDENT) {   // direct call → callee's return type
        string cvt = sema_lookup_type(s, e.a.sval);
        if (sema_local_bound(s, e.a.sval) == 1 || (cvt[0] != 0 && sema_find_fndecl(s, e.a.sval) == null)) {
            if (sema_is_fn_type(cvt) == 1) {
                return sema_fn_ret(cvt);
            }
            return "";
        }
        *DeclNode fd = sema_find_fndecl(s, e.a.sval);
        if (fd != null) {
            if (List_len<TypeParam>(&fd.type_params) > 0) {
                List<string> btargs;
                List_init<string>(&btargs, 2);
                string unb = sema_uninferable_tparam(fd);
                if (unb[0] != 0 || sema_bind_targs(s, fd, e, &btargs) == 0) {
                    return "";
                }
                string gr = sema_subst_params(fd.ret_type, &fd.type_params, &btargs);
                if (fd.is_async == 1) {
                    return sema_async_type(gr);
                }
                return gr;
            }
            if (fd.is_async == 1) {
                return sema_async_type(fd.ret_type);
            }
            return fd.ret_type;
        }
        *DeclNode ved = sema_variant_enum(s, e.a.sval);     // a payload variant constructor `A(1)`
        if (ved != null && List_len<TypeParam>(&ved.type_params) == 0) {
            return ved.name;
        }
        if (ved != null) {
            return sema_variant_ctor_type(s, ved, e);
        }
        return "";
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_MEMBER) {
        return sema_method_ret(s, e);
    }
    if (e.kind == EK_CALL && e.a != null) {                 // a call through a fn value: `mk()(1)`
        string ct = sema_infer_type(s, e.a);
        if (sema_is_fn_type(ct) == 1) {
            return sema_fn_ret(ct);
        }
        return "";
    }
    if (e.kind == EK_TEMPLATECALL) {
        string tb = sema_base_name(e.sval);
        List<string> targs;
        List_init<string>(&targs, 2);
        sema_parse_targs(e.sval, &targs);
        int ti = 0;
        while (ti < List_len<string>(&targs)) {
            List_set<string>(&targs, ti, sema_isub(s, List_get<string>(&targs, ti)));
            ti = ti + 1;
        }
        *DeclNode tfd = sema_find_fndecl(s, tb);
        if (tfd != null) {
            if (List_len<TypeParam>(&tfd.type_params) != List_len<string>(&targs)) {
                return "";
            }
            string tr = sema_subst_params(tfd.ret_type, &tfd.type_params, &targs);
            if (tfd.is_async == 1) {
                return sema_async_type(tr);
            }
            return tr;
        }
        *DeclNode ted = sema_variant_enum(s, tb);           // `Some<int>(5)`
        if (ted != null && List_len<TypeParam>(&ted.type_params) == List_len<string>(&targs) && List_len<string>(&targs) > 0) {
            string out = sema_cat(ted.name, "<");
            int k = 0;
            while (k < List_len<string>(&targs)) {
                if (k > 0) {
                    out = sema_cat(out, ",");
                }
                out = sema_cat(out, List_get<string>(&targs, k));
                k = k + 1;
            }
            return sema_cat(out, ">");
        }
        return "";
    }
    if (e.kind == EK_UNARY) {
        if (sema_streq(e.sval, "&") == 1) {                 // address-of → pointer, const-tracking
            string bt = sema_infer_type(s, e.a);
            if (bt[0] == 0) {
                return "";
            }
            // A pointer to a closure is `*fn(...)->R`: a trailing `*` would read as part of R.
            if (sema_is_fn_type(sema_strip_const(bt)) == 1) {
                return sema_cat("*", sema_strip_const(bt));
            }
            // A pointer to a nullable pointer is `*?*T`: a trailing `*` would make `?*T*`,
            // a nullable pointer to `*T`.
            if ((int)bt[0] == 63) {
                return sema_cat("*", bt);
            }
            if (sema_is_readonly_lvalue(s, e.a) == 1) {
                return sema_cat("const ", sema_cat(sema_strip_const(bt), "*"));
            }
            return sema_cat(bt, "*");
        }
        if (sema_streq(e.sval, "!") == 1) {
            return "bool";
        }
        string ot = sema_infer_type(s, e.a);
        if (ot[0] == 0) {
            return "";
        }
        if (sema_streq(e.sval, "*") == 1) {
            string pt = sema_pointee(ot);
            if (sema_streq(sema_canon(s, ot), "string") == 1) {
                return "";
            }
            return pt;
        }
        string oc = sema_canon(s, ot);
        if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "+") == 1 || sema_streq(e.sval, "~") == 1) {
            if (sema_is_int_ty(oc) == 1) {
                return sema_int_promote(oc);
            }
            if (sema_is_float_ty(oc) == 1 && sema_streq(e.sval, "~") == 0) {
                return oc;
            }
            string uop = e.sval;
            if (sema_streq(uop, "-") == 1) {
                uop = "u-";
            }
            List<string> tys;
            List_init<string>(&tys, 1);
            List_push<string>(&tys, ot);
            *DeclNode od = sema_find_op(s, uop, &tys);
            if (od != null) {
                return od.ret_type;
            }
        }
        return "";
    }
    if (e.kind == EK_BINARY) {
        if (sema_is_valop(e.sval) == 0) {
            return sema_binary_type(s, e.sval, "", "");
        }
        // Memoized per node like `?:`: each level of `a + (a + (...))` asks for the type of
        // its right operand, itself a binary expression (linear, not quadratic).
        if (e.sm_epoch == g_sema_epoch && g_sema_epoch != 0) {
            return e.sm_ety;
        }
        // An operator chain (`a + b + c ...`) is typed along its left spine with a loop:
        // the leftmost operand, then each operator bottom-up over the running type.
        List<*ExprNode> spine;
        List_init<*ExprNode>(&spine, 8);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY && sema_is_valop(b.sval) == 1) {
            List_push<*ExprNode>(&spine, b);
            b = b.a;
        }
        string t = sema_infer_type(s, b);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            t = sema_binary_type(s, n.sval, t, sema_infer_type(s, n.b));
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        e.sm_ety = t;
        e.sm_epoch = g_sema_epoch;
        return t;
    }
    if (e.kind == EK_MEMBER) {
        return sema_member_type(s, sema_infer_type(s, e.a), e.sval);
    }
    if (e.kind == EK_INDEX) {
        string bt = sema_infer_type(s, e.a);
        if (bt[0] == 0) {
            return "";
        }
        string bc = sema_canon(s, bt);
        if (List_len<*ExprNode>(&e.kids) > 0) {           // a[lo..hi] → a slice of the elements
            if (sema_arr_bracket(bc) > 0 && sema_slice_elem(bc)[0] == 0) {
                return sema_cat(sema_arr_elem(bc), "[]");
            }
            if (sema_slice_elem(bc)[0] != 0) {
                return bc;
            }
            if (sema_streq(bc, "string") == 1) {   // a string slices to its chars
                return "char[]";
            }
            return "";
        }
        if (sema_slice_elem(bc)[0] != 0 && sema_arr_bracket(bc) == sema_slen(bc) - 2) {
            return sema_slice_elem(bc);
        }
        // A pointer to an array or slice (`int[]*`, from `*IS`) indexes its pointee.
        if (sema_slen(bc) > 0 && (int)bc[sema_slen(bc) - 1] == 42) {
            return sema_sub_str(bc, 0, sema_slen(bc) - 1);
        }
        if (sema_arr_bracket(bc) > 0) {
            return sema_arr_elem(bc);
        }
        if (sema_streq(bc, "string") == 1) {
            return "char";
        }
        if ((int)bc[0] == 42) {
            return sema_pointee(bt);
        }
        List<string> tys;
        List_init<string>(&tys, 2);
        List_push<string>(&tys, bt);
        List_push<string>(&tys, sema_infer_type(s, e.b));
        *DeclNode od = sema_find_op(s, "[]", &tys);
        if (od != null) {
            return od.ret_type;
        }
        return "";
    }
    if (e.kind == EK_CAST) {
        return sema_isub(s, e.sval);
    }
    if (e.kind == EK_SIZEOF) {
        return "int64";
    }
    if (e.kind == EK_STRUCTINIT) {
        if (sema_known_type(s, e.sval) == 1) {
            return e.sval;
        }
        return "";
    }
    if (e.kind == EK_TERNARY) {
        // Memoized per node while no binding, scope or narrowing changes: each level of a
        // nested `?:` asks for its arm's type, which is itself a `?:` (linear, not quadratic).
        if (e.sm_epoch == g_sema_epoch && g_sema_epoch != 0) {
            return e.sm_ety;
        }
        string r = sema_ternary_type(s, e);
        e.sm_ety = r;
        e.sm_epoch = g_sema_epoch;
        return r;
    }
    if (e.kind == EK_AWAIT) {
        return sema_future_inner(s, sema_infer_type(s, e.a));
    }
    if (e.kind == EK_LAMBDA) {
        return sema_isub(s, sema_lambda_fn_type(e.sval));
    }
    if (e.kind == EK_INCDEC) {
        // `b.f++` of a bitfield: the old value in its declared type (as clang).
        if ((int)e.sval[1] != 114 && e.a != null && e.a.kind == EK_MEMBER) {
            *DeclNode isd = sema_find_struct(s, sema_struct_of_type(sema_infer_type(s, e.a.a)));
            if (isd != null) {
                int ii = 0;
                while (ii < List_len<Param>(&isd.params)) {
                    if (sema_streq(List_get<Param>(&isd.params, ii).name, e.a.sval) == 1 && ii < List_len<int>(&isd.field_bits)
                        && List_get<int>(&isd.field_bits, ii) > 0) {
                        return List_get<Param>(&isd.params, ii).ty;
                    }
                    ii = ii + 1;
                }
            }
        }
        return sema_infer_type(s, e.a);
    }
    if (e.kind == EK_ALLOCWITH) {
        return sema_cat("*", e.sval);
    }
    if (e.kind == EK_THREADCREATE) {    // the thread handle
        return "*void";
    }
    return "";
}

// A type spelling with type aliases resolved and a classic enum collapsed to `int`.
string sema_resolve_scalar(Sema* s, string t0) {
    string t = sema_strip_const(t0);
    int hops = 0;
    while (hops < 16) {
        *DeclNode ad = sema_find_tdecl(s, t);
        if (ad != null && ad.kind == DK_TYPEALIAS) {
            t = sema_strip_const(ad.ret_type);
        }
        else {
            if (ad != null && ad.kind == DK_ENUM) {
                t = "int";
            }
            hops = 16;
        }
        hops = hops + 1;
    }
    return t;
}

// The (resolved) type of a `for (i in A..B)` bound, "" when unknown. Beyond
// sema_infer_type it types a bare integer literal by its value, a cast by its target,
// and integer `+ - * / %` / unary `-` by the usual arithmetic conversions.
string sema_range_bound_type(Sema* s, *ExprNode e) {
    if (e == null) {
        return "";
    }
    if (e.kind == EK_LITERAL && e.lit_kind == LIT_INT) {
        return ast_range_lit_type(e.sval);
    }
    if (e.kind == EK_CAST) {
        return sema_resolve_scalar(s, sema_isub(s, e.sval));
    }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "-") == 1) {
        string ut = sema_range_bound_type(s, e.a);
        string pt = ast_range_var_type(ut, "int");
        if (pt[0] != 0) {
            return pt;
        }
        return ut;
    }
    if (e.kind == EK_BINARY && (e.op_fn == null || e.op_fn[0] == 0) && sema_is_arith_op(e.sval) == 1) {
        string ct = ast_range_var_type(sema_range_bound_type(s, e.a), sema_range_bound_type(s, e.b));
        if (ct[0] != 0) {
            return ct;
        }
    }
    string t = sema_infer_type(s, e);
    if (t[0] == 0) {
        return "";
    }
    return sema_resolve_scalar(s, t);
}

// An interface value refers to a struct through a pointer; converting a struct VALUE to
// an interface-typed slot (param, variable, return) is an error, as in the C++ checker.
void sema_check_iface_value(Sema* s, string tety, *ExprNode e) {
    if (e == null || tety[0] == 0) {
        return;
    }
    int isif = 0;
    int i = 0;
    while (i < List_len<*DeclNode>(&s.ifaces)) {
        if (sema_streq(List_get<*DeclNode>(&s.ifaces, i).name, tety) == 1) {
            isif = 1;
        }
        i = i + 1;
    }
    if (isif == 0) {
        return;
    }
    string src = sema_infer_type(s, e);
    if (src[0] == 0) {
        return;
    }
    // An interface value refers to its target through a non-null pointer: a `?*T` needs a
    // null-check first (mirrors the C++ nullable assignability rule).
    if (src[0] == 63) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: assigning a nullable pointer '%s' to non-null '%s' requires a null-check (e.g. `if (x != null)`)\n",
               s.filename, s.line, s.col, src, tety);
        return;
    }
    string bare = sema_strip_const(src);
    string sn = sema_struct_of_type(bare);
    if (sema_has_star(bare) == 1 && NameIdx_first(&s.sdecls_ix, sn) >= 0) {
        if (sema_ptr_depth(bare) != 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: cannot convert '%s' to interface '%s': only a pointer to a struct (a single '*') converts to an interface\n",
                   s.filename, s.line, s.col, src, tety);
            return;
        }
        // Boxing a pointer to const: every implementing method must take a const self.
        if (sema_pointee_const(src) == 1) {
            *DeclNode ifd = sema_find_iface(s, tety);
            *DeclNode sd = sema_find_struct(s, sn);
            int mi = 0;
            while (ifd != null && mi < List_len<*DeclNode>(&ifd.methods)) {
                string mname = List_get<*DeclNode>(&ifd.methods, mi).name;
                int mutable_self = 0;
                if (sd != null) {
                    int j = 0;
                    while (j < List_len<*DeclNode>(&sd.methods)) {
                        if (sema_streq(List_get<*DeclNode>(&sd.methods, j).name, mname) == 1) {
                            mutable_self = 1;
                        }
                        j = j + 1;
                    }
                }
                *DeclNode ff = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mname));
                if (mutable_self == 0 && ff != null && List_len<Param>(&ff.params) > 0
                    && sema_pointee_const(List_get<Param>(&ff.params, 0).ty) == 0) {
                    mutable_self = 1;
                }
                if (mutable_self == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: conversion discards a const qualifier ('%s' to '%s'): method '%s' of '%s' takes a mutable self\n",
                           s.filename, s.line, s.col, src, tety, mname, sn);
                    return;
                }
                mi = mi + 1;
            }
        }
        return;
    }
    if (NameIdx_first(&s.sdecls_ix, src) < 0) {
        return;
    }
    s.had_error = 1;
    dprintf(2, "error: %s:%d:%d: cannot convert struct '%s' to interface '%s' by value; pass a pointer (&x)\n",
           s.filename, s.line, s.col, src, tety);
}
