// Unified self-hosted compiler driver: the full pipeline in Eskiu.
//
//   preprocess (pp_run) → parse (parse_program) → type-check (sema_check) → codegen
//
// Like the C++ eskiuc: `-o prog` links an executable (through clang), a `.o` output, -c or
// --freestanding stops at the object, and no -o writes FILE.o. `--test-codegen` emits the
// LLVM IR text to stdout instead (pipe it to clang), exactly like cg_main but with the
// semantic-analysis pass wired in: if type checking fails the driver reports the failure
// and exits non-zero WITHOUT emitting IR (a real compiler rejects ill-typed input rather
// than miscompiling it). On success only the `.ll` reaches stdout, so it stays pipe-clean.
//
// This is the front of the self-hosting bootstrap: `esk_main` compiled by itself compiles
// the whole compiler. See tests/selfhost/cg_bootstrap.sh.

import <io>;
import <fs>;
import "preprocessor.esk";
import "parser.esk";
import "sema.esk";
import "async_lower.esk";
import "codegen.esk";
import "eir.esk";
import "fmt.esk";
import "pkg_native.esk";
import "bigstack.esk";

extern int64 write(int fd, *void buf, int64 n);
extern int remove(string path);  // delete the temp .ll after linking
extern int fork();               // spawn clang / the `run` program without a shell
extern int execvp(string file, *string argv);
extern int waitpid(int pid, *int status, int options);
extern void _exit(int code);
extern string getenv(string name);  // $CLANG selects the clang binary (default "clang")
extern int getpid();             // unique temp names on Windows (temp_file)
extern int mkstemps(string tmpl, int suffixlen);   // unique temp files (temp_file)
extern int close(int fd);
extern int pipe(*int fds);       // the editor modes probe a parse in a child process
extern int dup2(int from, int to);
extern int64 read(int fd, *void buf, int64 n);
#ifdef __APPLE__
extern int _NSGetExecutablePath(*uint8 buf, *uint32 size);   // locate stdlib next to us
#else
extern int64 readlink(string path, string buf, int64 n);
#endif

// Diagnostics go to stderr (fd 2), never stdout — stdout carries only the emitted .ll.
void eprint(string s) {
    int64 n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    write(2, (*void)s, n);
}

// Run args[0] with `args` as its argv (execvp: no shell, so spaces, quotes and `$`
// in an argument reach the program verbatim). Returns its exit code, 128+N when it
// was killed by signal N (the shell convention), or 127 if it could not be started.
int spawn_wait(List<string>* args) {
    int n = List_len<string>(args);
    *string av = alloc<string>((int64)(n + 1));    // zeroed, so av[n] is the NULL terminator
    int i = 0;
    while (i < n) {
        av[i] = List_get<string>(args, i);
        i = i + 1;
    }
    int pid = fork();
    if (pid < 0) {
        eprint("error: fork failed\n");
        return 127;
    }
    if (pid == 0) {
        execvp(av[0], av);
        eprint("error: cannot run '");
        eprint(av[0]);
        eprint("'\n");
        _exit(127);
    }
    let st: int = 0;
    if (waitpid(pid, &st, 0) < 0) {
        return 127;
    }
    int sig = st & 127;
    if (sig == 0) {       // WIFEXITED → WEXITSTATUS
        return (st >> 8) & 255;
    }
    return 128 + sig;                               // WIFSIGNALED → 128 + WTERMSIG
}

// Append the words of a command such as $CLANG ("clang -m64") to `args`.
void push_words(List<string>* args, string cmd) {
    int n = 0;
    while (cmd[n] != 0) {
        n = n + 1;
    }
    int i = 0;
    while (i < n) {
        while (i < n && ((int)cmd[i] == 32 || (int)cmd[i] == 9)) {
            i = i + 1;
        }
        int st = i;
        while (i < n && (int)cmd[i] != 32 && (int)cmd[i] != 9) {
            i = i + 1;
        }
        if (i > st) {
            *uint8 w = alloc<uint8>((int64)(i - st + 1));
            int k = 0;
            while (k < i - st) {
                w[k] = (uint8)cmd[st + k];
                k = k + 1;
            }
            List_push<string>(args, (string)w);
        }
    }
}

// Options that take a value (`-o out`, `--target T`, or `--target=T`). The self-host
// driver implements -o/--target/--mcpu/--mattr/--reloc/--link-arg/-l/-L; the rest are C++-only.
int is_value_opt(string o) {
    if (cg_streq(o, "-o") == 1 || cg_streq(o, "-l") == 1 || cg_streq(o, "-L") == 1) {
        return 1;
    }
    if (cg_streq(o, "-O") == 1) {                          // `-O 2`, like `-O2`
        return 1;
    }
    if (cg_streq(o, "--target") == 1 || cg_streq(o, "-target") == 1) {
        return 1;
    }
    if (cg_streq(o, "--mcpu") == 1 || cg_streq(o, "-mcpu") == 1) {
        return 1;
    }
    if (cg_streq(o, "--link-arg") == 1 || cg_streq(o, "-link-arg") == 1) {
        return 1;
    }
    if (cg_streq(o, "--mattr") == 1 || cg_streq(o, "-mattr") == 1) {
        return 1;
    }
    if (cg_streq(o, "--reloc") == 1 || cg_streq(o, "-reloc") == 1) {
        return 1;
    }
    if (cg_streq(o, "--subsystem") == 1 || cg_streq(o, "-subsystem") == 1) {
        return 1;
    }
    if (cg_streq(o, "--hover-at") == 1 || cg_streq(o, "-hover-at") == 1) {
        return 1;
    }
    if (cg_streq(o, "--definition-at") == 1 || cg_streq(o, "-definition-at") == 1) {
        return 1;
    }
    if (cg_streq(o, "--references-at") == 1 || cg_streq(o, "-references-at") == 1) {
        return 1;
    }
    if (cg_streq(o, "--complete-at") == 1 || cg_streq(o, "-complete-at") == 1) {
        return 1;
    }
    return 0;
}

// s[0, n) and s[n, end) as fresh strings.
string str_prefix(string s, int n) {
    *uint8 b = alloc<uint8>((int64)(n + 1));
    int i = 0;
    while (i < n) {
        b[i] = (uint8)s[i];
        i = i + 1;
    }
    return (string)b;
}

string str_after(string s, int n) {
    int len = n;
    while (s[len] != 0) {
        len = len + 1;
    }
    *uint8 b = alloc<uint8>((int64)(len - n + 1));
    int i = n;
    while (i < len) {
        b[i - n] = (uint8)s[i];
        i = i + 1;
    }
    return (string)b;
}

int str_starts(string s, string pre) {
    int i = 0;
    while (pre[i] != 0) {
        if (s[i] != pre[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int str_ends(string s, string suf) {
    int n = (int)strlen(s);
    int m = (int)strlen(suf);
    if (m > n) {
        return 0;
    }
    return cg_streq(str_after(s, n - m), suf);
}

// Compare two dotted version strings ("27.1.12297006"): <0, 0 or >0.
int version_cmp(string a, string b) {
    int i = 0;
    int j = 0;
    while (a[i] != 0 || b[j] != 0) {
        int64 x = 0;
        int64 y = 0;
        while (a[i] != 0 && a[i] != '.') {
            x = x * 10 + (int64)((int)a[i] - 48);
            i = i + 1;
        }
        while (b[j] != 0 && b[j] != '.') {
            y = y * 10 + (int64)((int)b[j] - 48);
            j = j + 1;
        }
        if (x != y) {
            return x < y ? -1 : 1;
        }
        if (a[i] == '.') {
            i = i + 1;
        }
        if (b[j] == '.') {
            j = j + 1;
        }
    }
    return 0;
}

// The Android NDK (C++ androidNdk): $ANDROID_NDK_HOME, $ANDROID_NDK_ROOT, else the newest
// version under the SDK's ndk/ directory.
string android_ndk() {
    string e = getenv("ANDROID_NDK_HOME");
    if (e != null && e[0] != 0) {
        return e;
    }
    e = getenv("ANDROID_NDK_ROOT");
    if (e != null && e[0] != 0) {
        return e;
    }
    List<string> sdks;
    List_init<string>(&sdks, 4);
    string h = getenv("ANDROID_HOME");
    if (h != null && h[0] != 0) {
        List_push<string>(&sdks, h);
    }
    h = getenv("ANDROID_SDK_ROOT");
    if (h != null && h[0] != 0) {
        List_push<string>(&sdks, h);
    }
    h = getenv("HOME");
    if (h != null && h[0] != 0) {
        List_push<string>(&sdks, cg_cat(h, "/Library/Android/sdk"));
        List_push<string>(&sdks, cg_cat(h, "/Android/Sdk"));
    }
    int si = 0;
    while (si < List_len<string>(&sdks)) {
        string dir = cg_cat(List_get<string>(&sdks, si), "/ndk");
        List<String> names;
        List_init<String>(&names, 8);
        string best = "";
        if (fs_list_dir(dir, &names) == 0) {
            int ni = 0;
            while (ni < names.size) {
                string nm = names.data[ni].cstr();
                if (best[0] == 0 || version_cmp(nm, best) > 0) {
                    best = cg_cat(nm, "");
                }
                ni = ni + 1;
            }
        }
        if (best[0] != 0) {
            return cg_cat(dir, cg_cat("/", best));
        }
        si = si + 1;
    }
    return null;
}

// The driver that links a WebAssembly (emscripten), Android or iOS build (C++
// crossDriver): $CC when set, else emcc, the NDK's clang or `xcrun -sdk ... clang`.
// 0 when the build links with clang itself (every other triple, wasm32-wasi too).
int cross_driver(string triple, List<string>* out) {
    if (triple == null || triple[0] == 0) {
        return 0;
    }
    int wasm = str_starts(triple, "wasm32");
    int android = str_contains(triple, "android");
    int ios = str_contains(triple, "-ios");
    if ((wasm == 0 || str_contains(triple, "emscripten") == 0) && android == 0 && ios == 0) {
        return 0;
    }
    string cc = getenv("CC");
    if (cc != null && cc[0] != 0) {
        push_words(out, cc);
        return 1;
    }
    if (wasm == 1) {
        List_push<string>(out, "emcc");
        return 1;
    }
    if (android == 1) {
        string ndk = android_ndk();
        if (ndk == null) {
            return 0;
        }
        List<string> hosts;
        List_init<string>(&hosts, 3);
        List_push<string>(&hosts, "darwin-x86_64");
        List_push<string>(&hosts, "linux-x86_64");
        List_push<string>(&hosts, "windows-x86_64");
        int hi = 0;
        while (hi < List_len<string>(&hosts)) {
            string c = cg_cat(ndk, cg_cat("/toolchains/llvm/prebuilt/", cg_cat(List_get<string>(&hosts, hi), "/bin/clang")));
            if (fs_exists(c) == 1) {
                List_push<string>(out, c);
                List_push<string>(out, cg_cat("--target=", triple));
                return 1;
            }
            hi = hi + 1;
        }
        return 0;
    }
    List_push<string>(out, "xcrun");
    List_push<string>(out, "-sdk");
    if (str_contains(triple, "simulator") == 1) {
        List_push<string>(out, "iphonesimulator");
    }
    else {
        List_push<string>(out, "iphoneos");
    }
    List_push<string>(out, "clang");
    List_push<string>(out, "-target");
    List_push<string>(out, triple);
    return 1;
}

// The archiver for a static library: llvm-ar next to $CLANG when there is one, else ar.
string archiver() {
    string cl = getenv("CLANG");
    if (cl != null && str_contains(cl, "/") == 1) {
        int n = (int)strlen(cl);
        while (n > 0 && cl[n - 1] != '/') {
            n = n - 1;
        }
        string ar = cg_cat(str_prefix(cl, n), "llvm-ar");
        if (fs_exists(ar) == 1) {
            return ar;
        }
    }
    return "ar";
}

// The run-time checks --safe[=LIST] names, as the C++ CodeGen::Safe* bits: 1 bounds,
// 2 overflow, 4 null. No list (a bare --safe) is all three; an unknown name is an
// error (-1).
int safe_checks(string list) {
    if (list == null || list[0] == 0) {
        return 7;
    }
    int mask = 0;
    int start = 0;
    while (1 == 1) {
        int end = start;
        while (list[end] != 0 && (int)list[end] != 44) {
            end = end + 1;
        }
        string name = str_prefix((string)((*uint8)list + start), end - start);
        if (cg_streq(name, "bounds") == 1) {
            mask = mask | 1;
        }
        else if (cg_streq(name, "overflow") == 1) {
            mask = mask | 2;
        }
        else if (cg_streq(name, "null") == 1) {
            mask = mask | 4;
        }
        else {
            eprint("error: unknown --safe check '");
            eprint(name);
            eprint("' (valid: bounds, overflow, null)\n");
            return -1;
        }
        if (list[end] == 0) {
            return mask;
        }
        start = end + 1;
    }
    return mask;
}

int str_contains(string s, string sub) {
    int i = 0;
    while (s[i] != 0) {
        int j = 0;
        while (sub[j] != 0 && s[i + j] == sub[j]) {
            j = j + 1;
        }
        if (sub[j] == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

int file_exists(string path) {
    let n: int64 = 0;
    *uint8 b = fs_read_all(path, &n);
    if (b == null) {
        return 0;
    }
    return 1;
}

// Where stdlib/ lives, like the C++ resolveStdlibPath: $ESKIU_ROOT, else the install
// layout next to this binary (<prefix>/bin/eskiuc-esk → <prefix>/lib/eskiu, or the
// dev tree build/eskiuc-esk → build/..). null when none is found (imports then
// resolve against the current directory).
string find_stdlib_root() {
    string env = getenv("ESKIU_ROOT");
    if (env != null) {
        if (env[0] != 0) {
            return env;
        }
    }
    uint8[4096] buf;
    int got = 0;
#ifdef __APPLE__
    let sz: uint32 = 4096;
    if (_NSGetExecutablePath(&buf[0], &sz) == 0) {
        got = 1;
    }
#else
    int64 rn = readlink("/proc/self/exe", (string)&buf[0], 4095);
    if (rn > 0) {
        buf[rn] = 0;
        got = 1;
    }
#endif
    if (got == 0) {
        return null;
    }
    string exe = realpath((string)&buf[0], null);
    if (exe == null) {
        return null;
    }
    string bindir = str_dir(exe);
    string prefix = str_dir(bindir);
    string inst = cg_cat(prefix, "/lib/eskiu");
    if (file_exists(cg_cat(inst, "/stdlib/result.esk")) == 1) {
        return inst;
    }
    string dev = cg_cat(bindir, "/..");
    if (file_exists(cg_cat(dev, "/stdlib/result.esk")) == 1) {
        return dev;
    }
    return null;
}

// The platform temp dir, ending in a separator: $TMPDIR (else /tmp), or GetTempPathA on
// Windows (it honors TMP and TEMP), like the C++ driver's createTemporaryFile.
#ifdef _WIN32
extern uint32 GetTempPathA(uint32 n, *uint8 buf);
string temp_dir() {
    *uint8 buf = alloc<uint8>(1024);
    uint32 n = GetTempPathA(1024, buf);
    if (n == 0 || n >= 1024) {
        return ".\\";
    }
    return (string)buf;
}
#else
string temp_dir() {
    string dir = getenv("TMPDIR");
    if (dir == null) {
        dir = "/tmp";
    }
    else if (dir[0] == 0) {
        dir = "/tmp";
    }
    int dn = 0;
    while (dir[dn] != 0) {
        dn = dn + 1;
    }
    if ((int)dir[dn - 1] == 47) {
        return dir;
    }
    return cg_cat(dir, "/");
}
#endif

// A fresh, uniquely named file `eskiu-<stem>-XXXXXX<suffix>` in the temp dir, created
// with mkstemps so it never names (or replaces) an existing file, such as a user's
// `<out>.ll`. Returns its path, or null when it cannot be created. Windows has no
// mkstemps: the name is unique by process id there.
#ifdef _WIN32
string temp_file(string stem, string suffix) {
    uint8[64] nm;
    sprintf((string)&nm[0], "eskiu-%s-%d", stem, getpid());
    return cg_cat(temp_dir(), cg_cat((string)&nm[0], suffix));
}
#else
string temp_file(string stem, string suffix) {
    string path = cg_cat(temp_dir(), cg_cat("eskiu-", cg_cat(stem, cg_cat("-XXXXXX", suffix))));
    int sn = 0;
    while (suffix[sn] != 0) {
        sn = sn + 1;
    }
    int fd = mkstemps(path, sn);
    if (fd < 0) {
        return null;
    }
    close(fd);
    return path;
}
#endif

// The executable `run` builds: a temp file, named `.exe` on Windows as the linker
// driver would name it anyway.
string temp_exe_path() {
#ifdef _WIN32
    return temp_file("run", ".exe");
#else
    return temp_file("run", "");
#endif
}

int bytes_eq(*uint8 a, int an, *uint8 b, int bn) {
    if (an != bn) {
        return 0;
    }
    int i = 0;
    while (i < an) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// `eskiuc fmt [--check] file.esk …` — reformat each file in place. With --check, don't
// write; exit non-zero if any file is not already formatted. Mirrors the C++ runFmt.
int run_fmt(List<string>* files, int check) {
    if (List_len<string>(files) == 0) {
        eprint("error: fmt: no input files\n");
        return 1;
    }
    int changed = 0;
    int failed = 0;
    int i = 0;
    while (i < List_len<string>(files)) {
        string f = List_get<string>(files, i);
        i = i + 1;
        let flen: int64 = 0;
        *uint8 raw = fs_read_all(f, &flen);
        if (raw == null) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: fmt: cannot open '%s'\n", f);
            eprint((string)&eb[0]);
            failed = failed + 1;
            continue;
        }
        let formatted: String = format_source(raw, (int)flen);
        *uint8 fb = (*uint8)String_cstr(&formatted);
        int fl = (int)String_len(&formatted);
        if (bytes_eq(fb, fl, raw, (int)flen) == 1) {
            continue;
        }
        changed = changed + 1;
        if (check == 1) {
            printf("%s\n", f);
            continue;
        }
        if (fs_write_all(f, fb, (int64)fl) == 0) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: fmt: cannot write '%s'\n", f);
            eprint((string)&eb[0]);
            failed = failed + 1;
            continue;
        }
    }
    if (failed > 0) {
        return 1;
    }
    if (check == 1 && changed > 0) {   // CI signal: files need formatting
        return 1;
    }
    return 0;
}

// --freestanding: mark every function "no-builtins", as clang -ffreestanding does, so the
// optimizer never turns a loop into a call to memset/memcpy that no libc provides. clang
// ignores -fno-builtin for a .ll input, so the attribute goes on each `define` line,
// before its personality clause or the opening brace.
string ir_no_builtins(string ir) {
    let out: String;
    String_init(&out, 8192);
    int i = 0;
    while (ir[i] != 0) {
        int e = i;
        while (ir[e] != 0 && ir[e] != 10) {
            e = e + 1;
        }
        int at = -1;
        if (e - i > 7 && ir[i] == 100 && ir[i+1] == 101 && ir[i+2] == 102 && ir[i+3] == 105
            && ir[i+4] == 110 && ir[i+5] == 101 && ir[i+6] == 32 && ir[e-1] == 123) {      // "define " ... "{"
            int k = i;
            while (k + 13 <= e && at < 0) {                                              // " personality "
                if (ir[k] == 32 && ir[k+1] == 112 && ir[k+2] == 101 && ir[k+3] == 114 && ir[k+4] == 115
                    && ir[k+5] == 111 && ir[k+6] == 110 && ir[k+7] == 97 && ir[k+8] == 108
                    && ir[k+9] == 105 && ir[k+10] == 116 && ir[k+11] == 121 && ir[k+12] == 32) {
                    at = k;
                }
                k = k + 1;
            }
            if (at < 0) {                                                   // " {"
                at = e - 2;
            }
        }
        int j = i;
        while (j < e) {
            if (j == at) {
                String_append(&out, " \"no-builtins\"");
            }
            String_push(&out, ir[j]);
            j = j + 1;
        }
        if (ir[e] == 10) {
            String_push(&out, (char)10);
            e = e + 1;
        }
        i = e;
    }
    return (string)String_cstr(&out);
}

// Parse every input into the one shared program (multi-file merge; the shared
// import/type-name session dedups across files, like the C++ driver). The primary
// input's text is `primary_src` when that is not null (the completion splice). 0 when an
// input cannot be read or has a preprocessor error (reported); a syntax error is
// reported and exits.
int load_inputs(List<string>* infiles, string primary_src, *Program prog) {
    int fi = 0;
    while (fi < List_len<string>(infiles)) {
        string f = List_get<string>(infiles, fi);
        // Register the root input, so an import cycle back to it (or an input an
        // earlier input already imported) is not parsed twice.
        if (register_file(f) == 0) {
            fi = fi + 1;
            continue;
        }
        let flen: int64 = 0;
        *uint8 raw = null;
        if (fi == 0 && primary_src != null) {
            raw = (*uint8)primary_src;
            while (primary_src[flen] != 0) {
                flen = flen + (int64)1;
            }
        } else {
            raw = fs_read_all(f, &flen);
        }
        if (raw == null) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: cannot read %s\n", f);
            eprint((string)&eb[0]);
            return 0;
        }
        let pperr: int = 0;
        string pp = pp_run((string)raw, (int)flen, f, &pperr);
        if (pperr != 0) {       // a directive error (reported by pp_run) aborts the build
            return 0;
        }
        *uint8 src = (*uint8)pp;
        int plen = g_pp_out_len;
        let p: Parser;
        g_lex_file = f;
        p_init(&p, src, plen);
        p.basedir = str_dir(f);
        parse_into(&p, prog);
        fi = fi + 1;
    }
    // A program has one main: a script's statements are its main, so no other input may
    // define one or have top-level statements too (mirrors the C++ loadProgram).
    *DeclNode script_main = null;
    *DeclNode named_main = null;
    int di = 0;
    while (di < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, di);
        di = di + 1;
        if (d.kind != DK_FUNCTION || cg_streq(d.name, "main") == 0 || d.from_import == 1) {
            continue;
        }
        int script = 0;
        if (List_len<Param>(&d.params) == 2 && cg_streq(List_get<Param>(&d.params, 0).name, "__argc") == 1
            && d.body != null) {
            script = 1;
        }
        if (script == 0) {
            if (named_main == null) {
                named_main = d;
            }
            continue;
        }
        if (script_main != null) {
            uint8[1024] mb;
            sprintf((string)&mb[0], "error: %s:%d:%d: only one input file may have top-level statements (they are its main)\n",
                    d.file, d.body.line, d.body.col);
            eprint((string)&mb[0]);
            return 0;
        }
        script_main = d;
    }
    if (script_main != null && named_main != null) {
        uint8[1024] sb;
        sprintf((string)&sb[0], "error: %s:%d:%d: a file with top-level statements has no 'main': the statements are its main\n",
                script_main.file, script_main.body.line, script_main.body.col);
        eprint((string)&sb[0]);
        return 0;
    }
    return 1;
}

// Do the inputs parse? The parser exits at a syntax error, so the editor modes try the
// parse in a child process first, its diagnostics captured (and echoed to stderr when
// `echo`). On failure, the first diagnostic's line and column (0 when none).
int probe_parse(List<string>* infiles, string primary_src, int echo, *int eline, *int ecol) {
    eline[0] = 0;
    ecol[0] = 0;
    *int fds = alloc<int>(2);
    if (pipe(fds) != 0) {
        return 1;
    }
    int pid = fork();
    if (pid < 0) {
        return 1;
    }
    if (pid == 0) {
        close(fds[0]);
        dup2(fds[1], 2);
        close(fds[1]);
        parser_session_init();
        if (List_len<string>(infiles) > 0) {
            pkg_load_roots(List_get<string>(infiles, 0));
        }
        *Program pr = alloc<Program>(1);
        List_init<*DeclNode>(&pr.decls, 4);
        if (load_inputs(infiles, primary_src, pr) == 0) {
            _exit(1);
        }
        _exit(0);
    }
    close(fds[1]);
    String out;
    String_init(&out, 256);
    uint8[4096] buf;
    int64 got = read(fds[0], (*void)&buf[0], (int64)4096);
    while (got > (int64)0) {
        int64 k = (int64)0;
        while (k < got) {
            String_push(&out, (char)buf[k]);
            k = k + (int64)1;
        }
        got = read(fds[0], (*void)&buf[0], (int64)4096);
    }
    close(fds[0]);
    let st: int = 0;
    waitpid(pid, &st, 0);
    string text = (string)String_cstr(&out);
    if (echo == 1) {
        eprint(text);
    }
    if ((st & 127) == 0 && ((st >> 8) & 255) == 0) {
        return 1;
    }
    // "error: FILE:LINE:COL: message": the first `:digits:digits:` after the prefix.
    int i = 0;
    if (str_starts(text, "error: ") == 1) {
        i = 7;
    }
    while (text[i] != 0 && (int)text[i] != 10) {
        if ((int)text[i] == 58) {
            int j = i + 1;
            int ln = 0;
            int nd = 0;
            while ((int)text[j] >= 48 && (int)text[j] <= 57) {
                ln = ln * 10 + ((int)text[j] - 48);
                j = j + 1;
                nd = nd + 1;
            }
            if (nd > 0 && (int)text[j] == 58) {
                int k2 = j + 1;
                int cl = 0;
                int nc = 0;
                while ((int)text[k2] >= 48 && (int)text[k2] <= 57) {
                    cl = cl * 10 + ((int)text[k2] - 48);
                    k2 = k2 + 1;
                    nc = nc + 1;
                }
                if (nc > 0 && (int)text[k2] == 58) {
                    eline[0] = ln;
                    ecol[0] = cl;
                    return 0;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

// `--symbols`: the declarations of the input file, one per line as
// kind<TAB>name<TAB>LINE:COL<TAB>container<TAB>detail (an editor's outline; the C++ driver's).
string sym_sig(*DeclNode f, string name) {
    string sg = cg_cat(cg_cat(cg_cat(f.ret_type, " "), name), "(");
    int i = 0;
    while (i < List_len<Param>(&f.params)) {
        Param pm = List_get<Param>(&f.params, i);
        if (i > 0) {
            sg = cg_cat(sg, ", ");
        }
        sg = cg_cat(sg, pm.ty);
        if (pm.name != null && pm.name[0] != 0) {
            sg = cg_cat(cg_cat(sg, " "), pm.name);
        }
        i = i + 1;
    }
    return cg_cat(sg, ")");
}

void sym_emit(string kind, string name, int line, int col, string container, string detail) {
    printf("%s\t%s\t%d:%d\t%s\t%s\n", kind, name, line, col, container, detail);
}

void print_symbols(*Program prog, string infile) {
    string self = canonical_path(infile);
    int i = 0;
    while (i < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        i = i + 1;
        if (d.from_import == 1 || d.line <= 0) {   // not an implicit one (a script's argc)
            continue;
        }
        if (d.file != null && d.file[0] != 0 && cg_streq(canonical_path(d.file), self) == 0) {
            continue;
        }
        if (d.kind == DK_FUNCTION) {
            sym_emit("function", d.name, d.line, d.col, "", sym_sig(d, d.name));
        }
        else if (d.kind == DK_STRUCT || d.kind == DK_UNION) {
            if (d.kind == DK_STRUCT) {
                sym_emit("struct", d.name, d.line, d.col, "", cg_cat("struct ", d.name));
            }
            else {
                sym_emit("struct", d.name, d.line, d.col, "", cg_cat("union ", d.name));
            }
            int k = 0;
            while (k < List_len<Param>(&d.params)) {
                Param fl = List_get<Param>(&d.params, k);
                sym_emit("field", fl.name, fl.line, fl.col, d.name, fl.ty);
                k = k + 1;
            }
            k = 0;
            while (d.kind == DK_STRUCT && k < List_len<*DeclNode>(&d.methods)) {
                *DeclNode m = List_get<*DeclNode>(&d.methods, k);
                sym_emit("method", m.name, m.line, m.col, d.name, sym_sig(m, m.name));
                k = k + 1;
            }
        }
        else if (d.kind == DK_ENUM) {
            sym_emit("enum", d.name, d.line, d.col, "", cg_cat("enum ", d.name));
        }
        else if (d.kind == DK_INTERFACE) {
            sym_emit("interface", d.name, d.line, d.col, "", cg_cat("interface ", d.name));
        }
        else if (d.kind == DK_TYPEALIAS) {
            sym_emit("type", d.name, d.line, d.col, "", cg_cat(cg_cat(cg_cat("type ", d.name), " = "), d.ret_type));
        }
        else if (d.kind == DK_VARDECL) {
            if (d.is_const == 1) {
                sym_emit("constant", d.name, d.line, d.col, "", d.ret_type);
            }
            else {
                sym_emit("variable", d.name, d.line, d.col, "", d.ret_type);
            }
        }
    }
}

// "LINE:COL" (the C++ sscanf("%d:%d")): 1 when both are read.
int parse_line_col(string at, *int line, *int col) {
    int i = 0;
    int l = 0;
    int nd = 0;
    while ((int)at[i] >= 48 && (int)at[i] <= 57) {
        l = l * 10 + ((int)at[i] - 48);
        i = i + 1;
        nd = nd + 1;
    }
    if (nd == 0 || (int)at[i] != 58) {
        return 0;
    }
    i = i + 1;
    int c = 0;
    int nc = 0;
    int neg = 0;
    if ((int)at[i] == 45) {
        neg = 1;
        i = i + 1;
    }
    while ((int)at[i] >= 48 && (int)at[i] <= 57) {
        c = c * 10 + ((int)at[i] - 48);
        i = i + 1;
        nc = nc + 1;
    }
    if (nc == 0) {
        return 0;
    }
    if (neg == 1) {
        c = 0 - c;
    }
    line[0] = l;
    col[0] = c;
    return 1;
}

// The text of `src` with line `ln` (1-based) as [b, e) (e at its newline). 0 past the end.
int line_span(string src, int ln, *int b, *int e) {
    int n = 0;
    while (src[n] != 0) {
        n = n + 1;
    }
    int at = 0;
    int l = 1;
    while (l < ln) {
        while (at < n && (int)src[at] != 10) {
            at = at + 1;
        }
        if (at >= n) {
            return 0;
        }
        at = at + 1;
        l = l + 1;
    }
    int en = at;
    while (en < n && (int)src[en] != 10) {
        en = en + 1;
    }
    b[0] = at;
    e[0] = en;
    return 1;
}

int is_id_char(int c) {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
}

// The editor modes (the C++ main.cpp): --symbols, --hover-at, --definition-at and
// --complete-at, all over the program as a build would see it.
int run_tool(string tool, string at, List<string>* infiles, string triple) {
    int line = 0;
    int col = 0;
    if (cg_streq(tool, "symbols") == 0 && parse_line_col(at, &line, &col) == 0) {
        eprint("error: --");
        eprint(tool);
        eprint("-at expects LINE:COL format\n");
        return 1;
    }
    string infile = List_get<string>(infiles, 0);
    string src = null;
    if (cg_streq(tool, "complete") == 1) {
        // The identifier at the cursor (or the member after `recv.`) becomes the sentinel
        // the checker completes at; a cursor at the end of its line ends the statement.
        let fl: int64 = 0;
        *uint8 raw = fs_read_all(infile, &fl);
        if (raw == null) {
            raw = (*uint8)"";
        }
        string text = (string)raw;
        int ls = 0;
        int le = 0;
        int tn = 0;
        while (text[tn] != 0) {
            tn = tn + 1;
        }
        if (line_span(text, line, &ls, &le) == 0) {
            ls = tn;
            le = tn;
        }
        int c0 = col - 1;
        if (c0 < 0) {
            c0 = 0;
        }
        int cur = ls + c0;
        if (cur > le) {
            cur = le;
        }
        int p0 = cur;
        int q0 = cur;
        while (p0 > ls && is_id_char((int)text[p0 - 1]) == 1) {
            p0 = p0 - 1;
        }
        while (q0 < le && is_id_char((int)text[q0]) == 1) {
            q0 = q0 + 1;
        }
        int blank = 1;
        int r = q0;
        while (r < le) {
            int ch = (int)text[r];
            if (ch != 32 && ch != 9 && ch != 13) {
                blank = 0;
            }
            r = r + 1;
        }
        String sp;
        String_init(&sp, tn + 32);
        int k = 0;
        while (k < p0) {
            String_push(&sp, (char)text[k]);
            k = k + 1;
        }
        String_append(&sp, "__eskiu_complete__");
        if (blank == 1) {
            String_append(&sp, ";");
        }
        k = q0;
        while (k < tn) {
            String_push(&sp, (char)text[k]);
            k = k + 1;
        }
        src = (string)String_cstr(&sp);
        // A syntax error elsewhere (the user is mid-edit): blank the broken line and try
        // again. An error at a line's first token blames the line before it; a line that
        // opens or closes a block is kept, and so is the cursor's line.
        int ok = 0;
        int attempt = 0;
        while (attempt < 8 && ok == 0) {
            int el = 0;
            int ec = 0;
            if (probe_parse(infiles, src, 0, &el, &ec) == 1) {
                ok = 1;
            }
            else {
                int bad = el;
                if (bad <= 0) {
                    attempt = 8;
                }
                else {
                    int b = 0;
                    int e = 0;
                    if (line_span(src, bad, &b, &e) == 0) {
                        attempt = 8;
                    }
                    else {
                        int first = b;
                        while (first < e && ((int)src[first] == 32 || (int)src[first] == 9)) {
                            first = first + 1;
                        }
                        if (first >= e || first - b + 1 >= ec) {
                            bad = bad - 1;
                            while (bad > 0 && line_span(src, bad, &b, &e) == 1) {
                                int f2 = b;
                                while (f2 < e && ((int)src[f2] == 32 || (int)src[f2] == 9 || (int)src[f2] == 13)) {
                                    f2 = f2 + 1;
                                }
                                if (f2 < e) {
                                    break;
                                }
                                bad = bad - 1;
                            }
                        }
                        if (bad <= 0 || bad == line || line_span(src, bad, &b, &e) == 0) {
                            attempt = 8;
                        }
                        else {
                            int brace = 0;
                            int x = b;
                            while (x < e) {
                                if ((int)src[x] == 123 || (int)src[x] == 125) {
                                    brace = 1;
                                }
                                x = x + 1;
                            }
                            if (brace == 1) {
                                attempt = 8;
                            }
                            else {
                                *uint8 w = (*uint8)src;
                                x = b;
                                while (x < e) {
                                    w[x] = (uint8)32;
                                    x = x + 1;
                                }
                            }
                        }
                    }
                }
            }
            attempt = attempt + 1;
        }
        if (ok == 0) {
            printf("(parse error)\n");
            return 0;
        }
    } else {
        int el = 0;
        int ec = 0;
        if (probe_parse(infiles, null, 1, &el, &ec) == 0) {
            printf("(parse error)\n");
            return 0;
        }
    }
    parser_session_init();
    pkg_load_roots(infile);
    *Program prog = alloc<Program>(1);
    List_init<*DeclNode>(&prog.decls, 4);
    if (load_inputs(infiles, src, prog) == 0) {
        printf("(parse error)\n");
        return 0;
    }
    if (cg_streq(tool, "symbols") == 1) {
        print_symbols(prog, infile);
        return 0;
    }
    let sm: Sema;
    sema_init(&sm, infile);
    sm.no_depr = 1;
    sm.wnone = 1;                      // no warning in an editor query (the C++ turns them off)
    sema_set_target(&sm, triple);
    sm.primary = infile;
    sm.tq_line = line;
    sm.tq_col = col;
    if (cg_streq(tool, "hover") == 1) {
        sm.tool = 1;
    }
    else if (cg_streq(tool, "definition") == 1) {
        sm.tool = 2;
    }
    else {
        sm.tool = 3;
    }
    int ok2 = sema_check(&sm, prog);
    if (sm.tool == 3) {
        int i = 0;
        while (i < List_len<string>(&sm.tc_name)) {
            printf("%s\t%s\t%s\n", List_get<string>(&sm.tc_kind, i), List_get<string>(&sm.tc_name, i), List_get<string>(&sm.tc_detail, i));
            i = i + 1;
        }
        return 0;
    }
    string r = "";
    if (sm.tool == 1) {
        r = sema_tool_hover(&sm);
    } else {
        r = sema_tool_definition(&sm);
    }
    if (r[0] != 0) {
        printf("%s\n", r);
        return 0;
    }
    if (ok2 == 0) {
        printf("(semantic error)\n");
        return 0;
    }
    if (sm.tool == 1) {
        printf("(no type at %d:%d)\n", line, col);
    }
    else {
        printf("(no definition at %d:%d)\n", line, col);
    }
    return 0;
}

int esk_main(int argc, string* argv) {
    // CLI: esk_main [-o <out>] <file.esk>. With -o, produce a native binary (write
    // the IR to a temp .ll and invoke clang); without it, emit the .ll to stdout —
    // the form the bootstrap harness pipes to clang.
    // The package commands live in the C++ eskiuc (pkg.cpp); this driver only reads
    // eskiu.lock to resolve package imports (pkg_load_roots).
    if (argc >= 2 && (cg_streq(argv[1], "new") == 1 || cg_streq(argv[1], "add") == 1
                      || cg_streq(argv[1], "build") == 1 || cg_streq(argv[1], "fetch") == 1
                      || cg_streq(argv[1], "test") == 1)) {
        eprint("error: '");
        eprint(argv[1]);
        eprint("' is a package command of the C++ eskiuc only\n");
        return 1;
    }
    // `eskiuc fmt [--check] file.esk …` — reindent files in place, no compile pipeline.
    if (argc >= 2 && cg_streq(argv[1], "fmt") == 1) {
        int check = 0;
        List<string> ffiles;
        List_init<string>(&ffiles, 2);
        int fj = 2;
        while (fj < argc) {
            if (cg_streq(argv[fj], "--check") == 1) {
                check = 1;
            }
            else {
                List_push<string>(&ffiles, argv[fj]);
            }
            fj = fj + 1;
        }
        return run_fmt(&ffiles, check);
    }
    // `eskiuc repl` runs code through the LLVM JIT, which only the C++ compiler links.
    if (argc >= 2 && cg_streq(argv[1], "repl") == 1) {
        eprint("error: the REPL needs the C++ eskiuc\n");
        return 1;
    }

    List<string> infiles;
    List_init<string>(&infiles, 2);
    string outfile = null;
    string mode = "";        // "" = compile; else --version / --test-{lexer,parser,typechecker,codegen}
    int san = 0;             // 0 = none, 1 = address, 2 = undefined
    int no_depr = 0;         // -Wno-deprecated: no warning at a use of a deprecated function
    int werror = 0;          // -Werror
    int wnone = 0;           // -w
    int wall = 0;            // -Wall: lint warnings
    int wextra = 0;          // -Wextra: signed/unsigned comparisons
    string tool = "";        // editor mode: "hover" / "definition" / "complete" / "symbols"
    string tool_at = "";     // its LINE:COL
    let wno: List<string>;   // -Wno-<name> of the other default-on warnings
    List_init<string>(&wno, 4);
    int safe = 0;            // --safe[=LIST]: run-time checks, bits of safe_checks
    int compile_only = 0;    // -c: emit an object file, do not link
    int freestanding = 0;    // --freestanding: no libc; object only (link it yourself)
    string triple = "";      // --target TRIPLE (passed to clang; picks the OS macro)
    string mcpu = "";        // --mcpu CPU
    string mattr = "";       // --mattr +f,-g: target features, passed to clang
    string reloc = "";       // --reloc MODEL: relocation model, passed to clang
    string subsystem = "";   // --subsystem console|windows: a Windows program's subsystem
    string optflag = "";     // -O0..-O3 (clang optimizes the emitted IR)
    List<string> linkx;      // -l / -L / --link-arg, forwarded to the link
    List_init<string>(&linkx, 4);
    List<string> linked;     // library names given with -l (the implied ones skip these)
    List_init<string>(&linked, 4);
    int default_libs = 1;    // --no-default-libs clears it: link only what -l names
    // `esk_main run script.esk [args...]`: compile to a temp exe, run it forwarding
    // [args...], propagate its exit code, then delete it (matches the C++ `run`). Any
    // flags before the script go to the compiler; the first non-flag is the script and
    // everything after it becomes the program's argv.
    int runmode = 0;
    List<string> runargs;
    List_init<string>(&runargs, 2);
    int start = 1;
    if (argc >= 2 && cg_streq(argv[1], "run") == 1) {
        runmode = 1;
        start = 2;
    }
    int gotscript = 0;
    int sawsep = 0;
    int ai = start;
    while (ai < argc) {
        string a = argv[ai];
        if (runmode == 1 && gotscript == 1) {
            // Everything after the script is program argv; a `--` right after it only
            // separates, so it is dropped (like the C++ `run`).
            if (sawsep == 0 && List_len<string>(&runargs) == 0 && cg_streq(a, "--") == 1) {
                sawsep = 1;
            }
            else {
                List_push<string>(&runargs, a);
            }
            ai = ai + 1;
            continue;
        }
        // `run -- script.esk`: a `--` before the script ends the compiler flags, and the
        // next argument is the script even if it starts with '-' (like the C++ `run`).
        if (runmode == 1 && cg_streq(a, "--") == 1) {
            if (ai + 1 < argc) {
                List_push<string>(&infiles, argv[ai + 1]);
                gotscript = 1;
            }
            ai = ai + 2;
            continue;
        }
        // Options with a value take it as the next argument or after `=`.
        string val = null;
        string opt = a;
        int eqi = 0;
        while (a[eqi] != 0 && (int)a[eqi] != 61) {
            eqi = eqi + 1;
        }
        if ((int)a[0] == 45 && a[eqi] == 61) {
            opt = str_prefix(a, eqi);
            val = str_after(a, eqi + 1);
        }
        if (is_value_opt(opt) == 1 && val == null) {
            if (ai + 1 >= argc) {
                eprint("error: option '");
                eprint(opt);
                eprint("' needs a value\n");
                return 1;
            }
            ai = ai + 1;
            val = argv[ai];
        }
        if (cg_streq(opt, "-o") == 1) {
            outfile = val;
        }
        else if (cg_streq(opt, "--hover-at") == 1 || cg_streq(opt, "-hover-at") == 1) {
            tool = "hover";
            tool_at = val;
        }
        else if (cg_streq(opt, "--definition-at") == 1 || cg_streq(opt, "-definition-at") == 1) {
            tool = "definition";
            tool_at = val;
        }
        else if (cg_streq(opt, "--complete-at") == 1 || cg_streq(opt, "-complete-at") == 1) {
            tool = "complete";
            tool_at = val;
        }
        else if (cg_streq(a, "--symbols") == 1 || cg_streq(a, "-symbols") == 1) {
            tool = "symbols";
        }
        else if (cg_streq(opt, "--target") == 1 || cg_streq(opt, "-target") == 1) {
            triple = val;
        }
        else if (cg_streq(opt, "--mcpu") == 1 || cg_streq(opt, "-mcpu") == 1) {
            mcpu = val;
        }
        else if (cg_streq(opt, "--mattr") == 1 || cg_streq(opt, "-mattr") == 1) {
            mattr = val;
        }
        else if (cg_streq(opt, "--reloc") == 1 || cg_streq(opt, "-reloc") == 1) {
            if (cg_streq(val, "static") == 0 && cg_streq(val, "pic") == 0 && cg_streq(val, "dynamic-no-pic") == 0
                && cg_streq(val, "ropi") == 0 && cg_streq(val, "rwpi") == 0 && cg_streq(val, "ropi-rwpi") == 0) {
                eprint("error: invalid --reloc '");
                eprint(val);
                eprint("' (use static, pic, dynamic-no-pic, ropi, rwpi or ropi-rwpi)\n");
                return 1;
            }
            reloc = val;
        }
        else if (cg_streq(opt, "--subsystem") == 1 || cg_streq(opt, "-subsystem") == 1) {
            if (cg_streq(val, "console") == 0 && cg_streq(val, "windows") == 0) {
                eprint("error: invalid --subsystem '");
                eprint(val);
                eprint("' (use console or windows)\n");
                return 1;
            }
            subsystem = val;
        }
        else if (cg_streq(opt, "--link-arg") == 1 || cg_streq(opt, "-link-arg") == 1) {
            List_push<string>(&linkx, val);
        }
        else if (cg_streq(opt, "-l") == 1) {
            List_push<string>(&linkx, cg_cat("-l", val));
            List_push<string>(&linked, val);
        }
        else if (cg_streq(opt, "-L") == 1) {
            List_push<string>(&linkx, cg_cat("-L", val));
        }
        else if ((int)a[0] == 45 && (int)a[1] == 108 && a[2] != 0) {                                   // -lfoo
            List_push<string>(&linkx, a);
            List_push<string>(&linked, str_after(a, 2));
        }
        else if ((int)a[0] == 45 && (int)a[1] == 76 && a[2] != 0) {    // -Lpath
            List_push<string>(&linkx, a);
        }
        else if ((int)a[0] == 45 && (int)a[1] == 79) {                                                 // -O<n>
            if (cg_streq(opt, "-O") == 1) {
                a = cg_cat("-O", val);
            }
            if (a[2] == 0 || a[3] != 0 || (int)a[2] < 48 || (int)a[2] > 51) {
                eprint("error: invalid optimization level '");
                eprint(a);
                eprint("' (use -O0, -O1, -O2 or -O3)\n");
                return 1;
            }
            optflag = a;
        }
        else if (cg_streq(a, "-c") == 1) {
            compile_only = 1;
        }
        else if (cg_streq(a, "--no-default-libs") == 1 || cg_streq(a, "-no-default-libs") == 1) {
            default_libs = 0;
        }
        else if (cg_streq(a, "--freestanding") == 1 || cg_streq(a, "-freestanding") == 1) {
            freestanding = 1;
        }
        else if (cg_streq(a, "--asan") == 1) {
            san = 1;
        }
        else if (cg_streq(a, "--ubsan") == 1) {
            san = 2;
        }
        else if (cg_streq(opt, "--safe") == 1 || cg_streq(opt, "-safe") == 1) {
            safe = safe_checks(val);
            if (safe < 0) {
                return 1;
            }
        }
        else if (cg_streq(a, "-Wno-deprecated") == 1 || cg_streq(a, "--Wno-deprecated") == 1) {
            no_depr = 1;
        }
        else if (cg_streq(a, "-Werror") == 1 || cg_streq(a, "--Werror") == 1) {
            werror = 1;
        }
        else if (cg_streq(a, "-w") == 1) {
            wnone = 1;
        }
        else if (cg_streq(a, "-Wno-string-compare") == 1 || cg_streq(a, "-Wno-address-of-packed-member") == 1
              || cg_streq(a, "-Wno-dangling-pointer") == 1 || cg_streq(a, "-Wno-frame-larger-than") == 1
              || cg_streq(a, "-Wno-format") == 1 || cg_streq(a, "-Wno-unused-result") == 1
              || cg_streq(a, "-Wno-await-holding-lock") == 1) {
            List_push<string>(&wno, (string)((*uint8)a + 5));
        }
        else if (cg_streq(a, "-Wall") == 1 || cg_streq(a, "--Wall") == 1) {
            wall = 1;
        }
        else if (cg_streq(a, "-Wextra") == 1 || cg_streq(a, "--Wextra") == 1) {
            wextra = 1;
        }
        else if (cg_streq(a, "--version") == 1
                || cg_streq(a, "--test-lexer") == 1
                || cg_streq(a, "--test-parser") == 1
                || cg_streq(a, "--test-typechecker") == 1
                || cg_streq(a, "--test-codegen") == 1
                || cg_streq(a, "--test-eir") == 1) {
            mode = a;
        }
        else if (is_value_opt(opt) == 1) {
            eprint("error: option '");
            eprint(opt);
            eprint("' is not supported by the self-hosted driver\n");
            return 1;
        }
        else if ((int)a[0] == 45 && a[1] != 0) {
            eprint("error: unknown option '");
            eprint(a);
            eprint("'\n");
            return 1;
        }
        else {
            List_push<string>(&infiles, a);
            gotscript = 1;
        }
        ai = ai + 1;
    }
    // `run` links to a unique temp exe in the temp dir (temp_exe_path, made once the IR
    // is written), then executes it below.
    if (runmode == 1) {
        outfile = null;
    }
    if (cg_streq(mode, "--version") == 1) {
        printf("Eskiu 0.14.1\n");
        return 0;
    }
    if (List_len<string>(&infiles) == 0) {
        eprint("usage: esk_main [-o <out>] [-c] [-O<n>] [--target T] [--asan|--ubsan] [--safe[=LIST]] [--freestanding] [-l<lib>] [-L<dir>] [--link-arg A] [--no-default-libs] [--test-*] <file.esk> [more.esk ...]\n");
        return 1;
    }
    string infile = List_get<string>(&infiles, 0);   // primary file: test modes + diagnostics
    // Refuse an output path that names an input (`-o prog.esk` would replace the source).
    if (outfile != null && runmode == 0) {
        string oc = canonical_path(outfile);
        int ii = 0;
        while (ii < List_len<string>(&infiles)) {
            if (cg_streq(canonical_path(List_get<string>(&infiles, ii)), oc) == 1) {
                eprint("error: output file '");
                eprint(outfile);
                eprint("' would overwrite the input '");
                eprint(List_get<string>(&infiles, ii));
                eprint("'\n");
                return 1;
            }
            ii = ii + 1;
        }
    }

    // Every mode preprocesses exactly like a real compile (the C++ test modes share the
    // build's predefined macros): the host OS macro picks the stdlib platform branch
    // (kqueue vs epoll, sockaddr layout) and __FILE__ is the real path.
    // The platform macro follows --target, else the build host (C++ seedPredefinedMacros);
    // a bare-metal triple defines none.
    if (triple[0] == 0) {
#ifdef __APPLE__
        g_pp_os = "__APPLE__";
#else
        g_pp_os = "__linux__";
#endif
    } else if (str_contains(triple, "linux") == 1) {
        g_pp_os = "__linux__";
    }
    else if (str_contains(triple, "apple") == 1 || str_contains(triple, "darwin") == 1
             || str_contains(triple, "macos") == 1) {
        g_pp_os = "__APPLE__";
    }
    else if (str_contains(triple, "windows") == 1 || str_contains(triple, "win32") == 1
             || str_contains(triple, "mingw") == 1) {
        g_pp_os = "_WIN32";
        if (str_contains(triple, "x86_64") == 1 || str_contains(triple, "amd64") == 1
            || str_contains(triple, "aarch64") == 1 || str_contains(triple, "arm64") == 1) {
            List_push<string>(&g_pp_predef, "_WIN64");
        }
    } else {
        g_pp_os = "";
    }
    if (freestanding == 1) {
        List_push<string>(&g_pp_predef, "__ESKIU_FREESTANDING__");
    }
    // The architecture macro (__aarch64__ / __x86_64__ / __arm__) follows the triple's
    // prefix, else the host's (C++ seedPredefinedMacros).
    if (triple[0] == 0) {
        g_pp_arch = cg_host_arch_macro();
    }
    else if (str_starts(triple, "aarch64") == 1 || str_starts(triple, "arm64") == 1) {
        g_pp_arch = "__aarch64__";
    }
    else if (str_starts(triple, "x86_64") == 1 || str_starts(triple, "amd64") == 1) {
        g_pp_arch = "__x86_64__";
    }
    else if (str_starts(triple, "arm") == 1 || str_starts(triple, "thumb") == 1) {
        g_pp_arch = "__arm__";
    }
    else {
        g_pp_arch = "";
    }
    // WebAssembly, Android and iOS, spelled as clang predefines them (C++
    // seedPredefinedMacros).
    if (str_starts(triple, "wasm32") == 1) {
        List_push<string>(&g_pp_predef, "__wasm__");
        List_push<string>(&g_pp_predef, "__wasm32__");
        if (str_contains(triple, "emscripten") == 1) {
            List_push<string>(&g_pp_predef, "__EMSCRIPTEN__");
        }
        if (str_contains(triple, "wasi") == 1) {
            List_push<string>(&g_pp_predef, "__wasi__");
        }
    }
    if (str_contains(triple, "android") == 1) {
        List_push<string>(&g_pp_predef, "__ANDROID__");
    }
    if (str_contains(triple, "-ios") == 1) {
        List_push<string>(&g_pp_predef, "TARGET_OS_IPHONE");
        List_push<string>(&g_pp_predef, "TARGET_OS_IOS");
        if (str_contains(triple, "simulator") == 1) {
            List_push<string>(&g_pp_predef, "TARGET_IPHONE_SIMULATOR");
        }
    }
    g_stdlib_root = find_stdlib_root();

    // --test-lexer: preprocess, then print the token stream (C++ testLexer).
    if (cg_streq(mode, "--test-lexer") == 1) {
        let ln: int64 = 0;
        *uint8 lraw = fs_read_all(infile, &ln);
        if (lraw == null) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: cannot read %s\n", infile);
            eprint((string)&eb[0]);
            return 1;
        }
        let lperr: int = 0;
        string lpp = pp_run((string)lraw, (int)ln, infile, &lperr);
        *uint8 lsrc = (*uint8)lpp;
        int llen = g_pp_out_len;
        g_lex_file = infile;
        lex_dump(lsrc, llen);
        if (lperr != 0 || g_lex_errs > 0) {
            return 1;
        }
        return 0;
    }

    // --test-typechecker prints its banner before parsing (matches tc_main).
    if (cg_streq(mode, "--test-typechecker") == 1) {
        printf("Type checking: %s\n", infile);
        printf("========================================================\n");
    }

    // The editor modes (C++ main.cpp): a test mode wins when both are given.
    if (tool[0] != 0 && mode[0] == 0) {
        return run_tool(tool, tool_at, &infiles, triple);
    }

    parser_session_init();
    if (List_len<string>(&infiles) > 0) {
        pkg_load_roots(List_get<string>(&infiles, 0));
    }
    *Program prog = alloc<Program>(1);
    List_init<*DeclNode>(&prog.decls, 4);
    if (load_inputs(&infiles, null, prog) == 0) {
        return 1;
    }

    if (cg_streq(mode, "--test-parser") == 1) {
        print_program(prog);
        return 0;
    }

    // Semantic analysis runs in every mode that goes past parsing (a real compile,
    // --test-typechecker and --test-codegen, like the C++). A failed check must NOT
    // emit IR.
    {
        let sm: Sema;
        sema_init(&sm, infile);
        sm.no_depr = no_depr;
        sm.werror = werror;
        sm.wnone = wnone;
        if (cg_streq(mode, "--test-codegen") == 0 && cg_streq(mode, "--test-eir") == 0) {   // as the C++ driver
            sm.wall = wall;
            sm.wextra = wextra;
        }
        for (wi in 0..List_len<string>(&wno)) {
            List_push<string>(&sm.wno, List_get<string>(&wno, wi));
        }
        sema_set_target(&sm, triple);  // sizeof folds to the target's layout
        int ok = sema_check(&sm, prog);
        if (cg_streq(mode, "--test-typechecker") == 1) {
            printf("========================================================\n");
            if (ok == 1) {
                printf("Type checking succeeded!\n");
                return 0;
            }
            printf("Type checking failed!\n");
            return 1;
        }
        if (ok == 0 && (cg_streq(mode, "--test-codegen") == 1 || cg_streq(mode, "--test-eir") == 1)) {
            eprint("Type checking failed!\n");
            return 1;
        }
        if (ok == 0) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: %s: type checking failed\n", infile);
            eprint((string)&eb[0]);
            return 1;
        }
    }

    async_lower(prog);                 // lower async fns → frame + resume + ctor (after sema)

    if (cg_streq(mode, "--test-eir") == 1) {
        // The checker again over the lowered program, stamping each expression's type,
        // as the C++ driver's post-lowering check feeds its EIR builder.
        let pt: Sema;
        sema_init(&pt, infile);
        pt.wnone = 1;
        pt.stamp_all = 1;
        sema_set_target(&pt, triple);
        if (sema_check(&pt, prog) == 0) {
            eprint("error: internal: the checker rejected the lowered program\n");
            return 1;
        }
        let eb: EB;
        eb_init(&eb, triple);
        eb_build(&eb, prog);
        string text = eb_module_text(&eb);
        write(1, (*void)text, (int64)et_len(text));
        return 0;
    }

    let g: Codegen;
    cg_init(&g);
    cg_set_target(&g, triple);         // the C ABI (and pointer size) follow --target
    g.safe = safe;                     // --safe[=LIST]: the run-time checks to emit
    g.freestanding = freestanding;     // closure envs on esk_alloc/esk_free
    cg_program(&g, prog);
    // No -o writes the object <input>.o, like the C++ driver (it links only with -o).
    if (outfile == null && runmode == 0 && cg_streq(mode, "--test-codegen") == 0) {
        outfile = cg_cat(infile, ".o");
    }
    if (cg_streq(mode, "--test-codegen") == 1) {
        // --test-codegen: emit the .ll to stdout (the bootstrap harness pipes it to clang).
        if (freestanding == 1) {
            printf("%s\n%s", ir_no_builtins((string)String_cstr(&g.globals)), ir_no_builtins((string)String_cstr(&g.out)));
            return 0;
        }
        printf("%s", (string)String_cstr(&g.globals));   // declares + string constants
        printf("\n");
        printf("%s", (string)String_cstr(&g.out));        // function definitions
        return 0;
    }

    // -o: assemble the full IR, write it to a fresh temp .ll (see temp_file), and invoke
    // clang to link a native binary end to end.
    let ir: String;
    String_init(&ir, 8192);
    String_append(&ir, (string)String_cstr(&g.globals));
    String_append(&ir, "\n");
    String_append(&ir, (string)String_cstr(&g.out));
    string irtext = (string)String_cstr(&ir);
    if (freestanding == 1) {
        irtext = ir_no_builtins(irtext);
    }
    string tmp = temp_file("ir", ".ll");
    int64 irlen = 0;
    while (irtext[irlen] != 0) {
        irlen = irlen + 1;
    }
    if (tmp == null || fs_write_all(tmp, (*uint8)irtext, irlen) == 0) {
        eprint("error: cannot write temporary IR\n");
        return 1;
    }
    if (runmode == 1) {
        outfile = temp_exe_path();
        if (outfile == null) {
            remove(tmp);
            eprint("error: could not create a temporary executable\n");
            return 1;
        }
    }
    string cc = getenv("CLANG");        // clang emits from .ll; cc/gcc can't, so no findCDriver ladder
    if (cc == null) {
        cc = "clang";
    }
    List<string> cargs;
    List_init<string>(&cargs, 8);
    push_words(&cargs, cc);
    if (san == 1) {
        List_push<string>(&cargs, "-fsanitize=address");
    }
    else if (san == 2) {
        List_push<string>(&cargs, "-fsanitize=undefined");
    }
    // Object only when asked (-c, a .o or .obj output, --freestanding), else link. The IR
    // carries no target triple, so clang's -Woverride-module note is expected noise.
    int olen = 0;
    while (outfile[olen] != 0) {
        olen = olen + 1;
    }
    int want_obj = compile_only;
    if (freestanding == 1) {
        want_obj = 1;
    }
    if (olen >= 2 && (int)outfile[olen - 2] == 46 && (int)outfile[olen - 1] == 111) {
        want_obj = 1;
    }
    if (olen >= 4 && (int)outfile[olen - 4] == 46 && (int)outfile[olen - 3] == 111
        && (int)outfile[olen - 2] == 98 && (int)outfile[olen - 1] == 106) {
        want_obj = 1;
    }
    if (runmode == 1) {
        want_obj = 0;
    }
    // A static library (.a, .lib) is the object in an archive, and a WebAssembly
    // (emscripten), Android or iOS build links with that platform's driver: both
    // compile to a temporary object first.
    string final_out = outfile;
    int want_lib = 0;
    if (runmode == 0 && compile_only == 0 && freestanding == 0
        && (str_ends(outfile, ".a") == 1 || str_ends(outfile, ".lib") == 1)) {
        want_lib = 1;
    }
    List<string> xdrv;
    List_init<string>(&xdrv, 6);
    int cross = 0;
    if (want_obj == 0 && want_lib == 0) {
        cross = cross_driver(triple, &xdrv);
    }
    if (want_lib == 1 || cross == 1) {
        want_obj = 1;
        outfile = temp_file("obj", ".o");
    }
    List_push<string>(&cargs, "-Wno-override-module");
    if (triple[0] != 0) {
        List_push<string>(&cargs, "-target");
        List_push<string>(&cargs, triple);
    }
    // emscripten's JavaScript-based exceptions (C++ enableEmscriptenEH).
    if (str_contains(triple, "emscripten") == 1) {
        List_push<string>(&cargs, "-mllvm");
        List_push<string>(&cargs, "-enable-emscripten-cxx-exceptions");
    }
    if (mcpu[0] != 0) {
        List_push<string>(&cargs, cg_cat("-mcpu=", mcpu));
    }
    // --mattr: each comma-separated feature goes to clang's backend (clang ignores -m
    // flags for a .ll input, but -target-feature reaches it).
    int mi = 0;
    while (mattr[mi] != 0) {
        int me = mi;
        while (mattr[me] != 0 && (int)mattr[me] != 44) {
            me = me + 1;
        }
        if (me > mi) {
            List_push<string>(&cargs, "-Xclang");
            List_push<string>(&cargs, "-target-feature");
            List_push<string>(&cargs, "-Xclang");
            List_push<string>(&cargs, str_after(str_prefix(mattr, me), mi));
        }
        mi = me;
        if (mattr[mi] != 0) {
            mi = mi + 1;
        }
    }
    if (cg_streq(reloc, "static") == 1) {
        List_push<string>(&cargs, "-fno-pic");
    }
    else if (cg_streq(reloc, "pic") == 1) {
        List_push<string>(&cargs, "-fPIC");
    }
    else if (cg_streq(reloc, "dynamic-no-pic") == 1) {
        List_push<string>(&cargs, "-mdynamic-no-pic");
    }
    else if (cg_streq(reloc, "ropi") == 1) {
        List_push<string>(&cargs, "-fropi");
    }
    else if (cg_streq(reloc, "rwpi") == 1) {
        List_push<string>(&cargs, "-frwpi");
    }
    else if (cg_streq(reloc, "ropi-rwpi") == 1) {
        List_push<string>(&cargs, "-fropi");
        List_push<string>(&cargs, "-frwpi");
    }
    if (optflag[0] != 0) {
        List_push<string>(&cargs, optflag);
    }
    if (want_obj == 1) {
        List_push<string>(&cargs, "-c");
    }
    List_push<string>(&cargs, tmp);
    List_push<string>(&cargs, "-o");
    List_push<string>(&cargs, outfile);
    // What follows the object on the link line: a shared library's -shared, the
    // Windows subsystem, the -l/-L/--link-arg flags and the implied libraries.
    List<string> tail;
    List_init<string>(&tail, 8);
    if (str_ends(final_out, ".so") == 1 || str_ends(final_out, ".dylib") == 1 || str_ends(final_out, ".dll") == 1) {
        List_push<string>(&tail, "-shared");
    }
    if (cg_streq(subsystem, "windows") == 1 && cg_streq(g_pp_os, "_WIN32") == 1) {
        if (str_contains(triple, "msvc") == 1) {
            List_push<string>(&tail, "-Wl,/subsystem:windows");
            List_push<string>(&tail, "-Wl,/entry:mainCRTStartup");
        }
        else {
            List_push<string>(&tail, "-mwindows");
        }
    }
    if (want_obj == 0 || cross == 1) {
        int li = 0;
        while (li < List_len<string>(&linkx)) {
            List_push<string>(&tail, List_get<string>(&linkx, li));
            li = li + 1;
        }
        // The libraries the program implies (C++ implicitLinkLibs): its `#pragma link`s,
        // then the C++ exception runtime when it throws or catches and pthread when it
        // spawns threads, for the platform g_pp_os names. After every object, once each.
        if (default_libs == 1) {
            List<string> implied;
            List_init<string>(&implied, 4);
            int pi = 0;
            while (pi < List_len<string>(&g_link_libs)) {
                List_push<string>(&implied, List_get<string>(&g_link_libs, pi));
                pi = pi + 1;
            }
            int gnu = 0;
            int android = str_contains(triple, "android");
            if (android == 0 && (cg_streq(g_pp_os, "__linux__") == 1 || cg_streq(g_pp_os, "_WIN32") == 1)) {
                gnu = 1;
            }
            // Android: the NDK's static libc++ and its ABI library; pthread is in libc.
            if (g.uses_eh == 1) {
                if (cg_streq(g_pp_os, "__APPLE__") == 1) {
                    List_push<string>(&implied, "c++");
                }
                else if (android == 1) {
                    List_push<string>(&implied, "c++_static");
                    List_push<string>(&implied, "c++abi");
                }
                else if (gnu == 1) {
                    List_push<string>(&implied, "stdc++");
                }
            }
            if (g.uses_threads == 1 && gnu == 1) {
                List_push<string>(&implied, "pthread");
            }
            // emscripten catches exceptions only when linked to.
            if (g.uses_eh == 1 && str_contains(triple, "emscripten") == 1) {
                List_push<string>(&tail, "-sDISABLE_EXCEPTION_CATCHING=0");
            }
            int ii2 = 0;
            while (ii2 < List_len<string>(&implied)) {
                string lib = List_get<string>(&implied, ii2);
                int dup = 0;
                int di = 0;
                while (di < List_len<string>(&linked)) {
                    if (cg_streq(List_get<string>(&linked, di), lib) == 1) {
                        dup = 1;
                    }
                    di = di + 1;
                }
                if (dup == 0) {
                    List_push<string>(&tail, cg_cat("-l", lib));
                    List_push<string>(&linked, lib);
                }
                ii2 = ii2 + 1;
            }
        }
    }
    // A build inside a package finds the native libraries it links in the archives its
    // packages declare for the target (or host) platform (pkg_native.esk): -L, and an
    // rpath for run time where the program runs from this machine's cache.
    List<string> native_dirs;
    List_init<string>(&native_dirs, 2);
    int win_target = cg_streq(g_pp_os, "_WIN32");
    if (want_obj == 0 || cross == 1) {
        ntv_load(triple);
        List<string> want_libs;
        List_init<string>(&want_libs, 4);
        for (wi in 0..List_len<string>(&linked)) {
            List_push<string>(&want_libs, List_get<string>(&linked, wi));
        }
        if (default_libs == 1) {
            for (wi in 0..List_len<string>(&g_link_libs)) {
                List_push<string>(&want_libs, List_get<string>(&g_link_libs, wi));
            }
        }
        if (ntv_lib_dirs(&want_libs, &native_dirs) != 0) {
            remove(tmp);
            return 1;
        }
        for (ni in 0..List_len<string>(&native_dirs)) {
            string nd = List_get<string>(&native_dirs, ni);
            List_push<string>(&tail, cg_cat("-L", nd));
            if (win_target == 0 && str_contains(triple, "wasm") == 0 && str_contains(triple, "android") == 0 &&
                str_contains(triple, "-ios") == 0) {
                List_push<string>(&tail, cg_cat("-Wl,-rpath,", nd));
            }
        }
    }
    if (want_obj == 0) {
        int ti = 0;
        while (ti < List_len<string>(&tail)) {
            List_push<string>(&cargs, List_get<string>(&tail, ti));
            ti = ti + 1;
        }
    }
    int rc = spawn_wait(&cargs);
    remove(tmp);
    if (rc == 0 && want_lib == 1) {
        List<string> aargs;
        List_init<string>(&aargs, 4);
        List_push<string>(&aargs, archiver());
        List_push<string>(&aargs, "rcs");
        List_push<string>(&aargs, final_out);
        List_push<string>(&aargs, outfile);
        remove(final_out);
        rc = spawn_wait(&aargs);
        remove(outfile);
        outfile = final_out;
    }
    else if (rc == 0 && cross == 1) {
        List_push<string>(&xdrv, outfile);
        List_push<string>(&xdrv, "-o");
        List_push<string>(&xdrv, final_out);
        int xi = 0;
        while (xi < List_len<string>(&tail)) {
            List_push<string>(&xdrv, List_get<string>(&tail, xi));
            xi = xi + 1;
        }
        rc = spawn_wait(&xdrv);
        remove(outfile);
        outfile = final_out;
    }
    if (rc != 0) {
        if (runmode == 1) {
            remove(outfile);
        }
        eprint("error: clang failed to link the output\n");
        return 1;
    }
    if (win_target == 1) {
        ntv_copy_dlls(&native_dirs, outfile);
    }
    if (runmode == 0) {
        return 0;
    }

    // run: exec the temp binary with the program's argv (no shell), then delete it and
    // return its exit status (128+N if a signal killed it, like the C++ `run`).
    List<string> pargs;
    List_init<string>(&pargs, 4);
    List_push<string>(&pargs, outfile);
    int k = 0;
    while (k < List_len<string>(&runargs)) {
        List_push<string>(&pargs, List_get<string>(&runargs, k));
        k = k + 1;
    }
    int st = spawn_wait(&pargs);
    remove(outfile);
    return st;
}

// Run the driver on a thread with a large stack, so deeply nested input reaches the
// parser's nesting limit instead of overflowing the stack (see bigstack.esk).
void main_body() {
    big_rc = esk_main(big_argc, big_argv);
}

int main(int argc, string* argv) {
    big_argc = argc;
    big_argv = argv;
    run_on_big_stack(main_body);
    return big_rc;
}
