// Self-hosted recursive-descent parser. Tokenizes the whole file up front (via the
// self-hosted lexer, selfhost/lexer.esk) into a buffer and indexes into it, like the
// C++ parser, for arbitrary lookahead and backtracking. Builds the AST
// (selfhost/ast.esk), printed in the C++ `--test-parser` format, and resolves imports.

import <fs>;
import <io>;
import "lexer.esk";
import "ast.esk";
import "preprocessor.esk";

// Abort the parse on an unrecoverable syntax error (see check_name_not_keyword).
extern void exit(int code);
extern string realpath(string path, string resolved);   // canonical import keys

struct Parser {
    List<Token> toks;
    int pos;
    *uint8 src;
    int pending_gt;        // a `>>` being consumed as two `>` (template close)
    int no_struct_lit;     // suppress `Name { ... }` struct literals (match subject)
    string basedir;        // directory of this file (relative imports resolve here)
    string file;           // this file's path, for diagnostics ("" → "<input>")
    int spec;              // > 0 while parsing speculatively (errors backtrack, not abort)
    int failed;            // a speculative parse hit a syntax error (see p_fail)
    int nest;              // current expression/statement nesting (see p_nest_enter)
    int tdepth;            // current type nesting (see p_type_level)
    List<int> tca;         // ternary_colon_ahead's answer per start index (built once)
    int tca_done;
    int is_import;         // an imported file: a top-level statement is an error
    List<*StmtNode> so_stmts;   // scripts: the top-level statements and variables, in
    List<*DeclNode> so_vars;    //   order (one of each pair is null; p_build_script_main)
    int last_call_close;   // 1 + the index of the ')' that closed the last call (0: none)
    int trailing_start;    // 1 + the first token of a statement that may end in a block
}

// Session state shared across every file parsed in one run (mirrors the C++ parser's
// shared `importedFiles` + `sharedTypeNames`). Globals — `parser_session_init` sets
// them up once before parsing; a fresh process per parity test resets them.
List<string> g_imported;       // resolved import paths already parsed (dedup)
List<string> g_typenames;      // declared type names → enables `(Foo)x` casts
List<string> g_genericnames;   // generic fns + generic enum variants (`Name<...>(` is a call)
List<string> g_localvars;      // locals + params in scope (a local named like a type shadows it)
int g_cur_pack;                // active `#pragma pack(N)` alignment (0 = natural)
List<int> g_pack_stack;        // saved pack values for `pack(push, N)` / `pack(pop)`
List<string> g_link_libs;      // `#pragma link("name")` libraries, first-seen order, no dups
List<string> g_tparams;        // type params of the generic fn/struct being parsed (`(*T)x`)
string g_stdlib_root;          // root holding stdlib/ (the driver sets it; null → cwd)
// Package imports (mirrors packageRoots in parser.cpp): the packages of eskiu.lock, name
// -> root directory, set by pkg_load_roots. g_pkg_active when the program belongs to a
// package (an eskiu.toml in its directory or above).
List<string> g_pkg_names;
List<string> g_pkg_roots;
int g_pkg_active;
string g_import_err;           // resolve_import's "unknown package" error (null if none)

// The dedup key for a source file: its absolute path with `.`/`..`/symlinks resolved
// (mirrors Parser::canonicalPath); the path itself if it cannot be resolved.
string canonical_path(string path) {
    string r = realpath(path, null);
    if (r == null) {
        return path;
    }
    return r;
}

// Record `path` as parsed. Returns 1 if it is new, 0 if it was already registered
// (a repeated import, a diamond, a cycle back to a root input).
int register_file(string path) {
    string key = canonical_path(path);
    int i = 0;
    int seen = List_len<string>(&g_imported);
    while (i < seen) {
        if (str_eq(List_get<string>(&g_imported, i), key) == 1) {
            return 0;
        }
        i = i + 1;
    }
    List_push<string>(&g_imported, key);
    return 1;
}

// The import prescan (mirrors ImportCache): pp_run reports each import at its line,
// and pre_import preprocesses the imported file right there, with the macro table as
// it stands at that point, keeping the text until do_import reaches it. So a #define
// before `import "x.esk"` reaches x.esk, one after it does not, and x.esk's own
// #defines reach the importer's later lines (C's textual #include order).
List<string> g_pre_keys;       // canonical paths preprocessed ahead (a key is claimed first)
List<string> g_pre_text;       // their preprocessed text ("" while still being preprocessed)
List<int> g_pre_err;           // their pp_run verdicts
List<int> g_pre_len;           // their byte lengths (g_pp_out_len)

int pre_find(string key) {
    int i = 0;
    while (i < List_len<string>(&g_pre_keys)) {
        if (str_eq(List_get<string>(&g_pre_keys, i), key) == 1) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

int is_registered(string key) {
    int i = 0;
    while (i < List_len<string>(&g_imported)) {
        if (str_eq(List_get<string>(&g_imported, i), key) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// The root of package `name` from eskiu.lock, or null.
string pkg_root_of(string name) {
    int i = 0;
    while (i < List_len<string>(&g_pkg_names)) {
        if (str_eq(List_get<string>(&g_pkg_names, i), name) == 1) {
            return List_get<string>(&g_pkg_roots, i);
        }
        i = i + 1;
    }
    return null;
}

// The file a package import names inside package root `root` (mirrors packageModulePath):
// `<name/module>` is src/module.esk when that exists, else module.esk; `<name>` alone is
// name.esk, src/name.esk or lib.esk.
string pkg_module_path(string root, string name, string module) {
    if (module[0] != 0) {
        string in_src = str_concat(root, str_concat("/src/", str_concat(module, ".esk")));
        if (fs_is_file(in_src) == 1) {
            return in_src;
        }
        return str_concat(root, str_concat("/", str_concat(module, ".esk")));
    }
    string top = str_concat(root, str_concat("/", str_concat(name, ".esk")));
    if (fs_is_file(top) == 1) {
        return top;
    }
    string in_src2 = str_concat(root, str_concat("/src/", str_concat(name, ".esk")));
    if (fs_is_file(in_src2) == 1) {
        return in_src2;
    }
    return str_concat(root, "/lib.esk");
}

// Where an import resolves (mirrors Parser::resolveImport): `<name>` (no '/') is
// stdlib/name.esk under the stdlib root (like the C++ stdlibPath: $ESKIU_ROOT or the
// install layout; the cwd when neither is known), a relative "path" is under `basedir`.
// `<pkg/module>` and `<pkg>` (when no stdlib module has that name) are package imports;
// inside a package, a `<name...>` naming neither sets g_import_err.
string resolve_import(string spec, int is_std, string basedir) {
    g_import_err = null;
    string path = spec;
    if (is_std == 1) {
        int n = cstr_len(spec);
        int slash = 0 - 1;
        int i = 0;
        while (i < n && slash < 0) {
            if ((int)spec[i] == 47) {
                slash = i;
            }
            i = i + 1;
        }
        // A stdlib module, also one in a subdirectory (`<c/unistd>`), comes first; then a
        // package (C++ Parser::resolveImport).
        path = str_concat("stdlib/", str_concat(path, ".esk"));
        if (g_stdlib_root != null) {
            if (g_stdlib_root[0] != 0) {
                path = str_concat(g_stdlib_root, str_concat("/", path));
            }
        }
        string head = spec;
        string module = "";
        if (slash >= 0) {
            head = p_sub(spec, 0, slash);
            module = p_sub(spec, slash + 1, n);
        }
        string proot = pkg_root_of(head);
        if (proot != null && fs_is_file(path) == 0) {
            return pkg_module_path(proot, head, module);
        }
        if (head[0] != 0 && fs_is_file(path) == 0) {
            if (g_pkg_active == 1) {
                g_import_err = str_concat("unknown package '", str_concat(head, "' (not in eskiu.toml)"));
            }
            else if (slash >= 0) {
                g_import_err = str_concat("unknown module <", str_concat(spec, str_concat("> (for a file of your own, import \"", str_concat(spec, ".esk\")"))));
            }
        }
        return path;
    }
    if ((int)path[0] != 47) {
        return str_concat(basedir, str_concat("/", path));
    }
    return path;
}

// $ESKIU_HOME, else ~/.eskiu: where packages are checked out (mirrors pkgHome).
string pkg_home() {
    string h = getenv("ESKIU_HOME");
    if (h != null) {
        if (h[0] != 0) {
            return h;
        }
    }
    string home = getenv("HOME");
    if (home == null) {
        home = ".";
    }
    return str_concat(home, "/.eskiu");
}

// Fill g_pkg_names / g_pkg_roots for a compile whose first input is `input` (mirrors
// pkgLoadRoots): find eskiu.toml in its directory or above and read the eskiu.lock next
// to it. Nothing is fetched.
void pkg_load_roots(string input) {
    List_init<string>(&g_pkg_names, 8);
    List_init<string>(&g_pkg_roots, 8);
    g_pkg_active = 0;
    string dir = str_dir(canonical_path(input));
    while (fs_is_file(str_concat(dir, "/eskiu.toml")) == 0) {
        if (dir[0] == 0 || str_eq(dir, ".") == 1) {
            return;
        }
        dir = str_dir(dir);
    }
    g_pkg_active = 1;
    let len: int64 = 0;
    *uint8 raw = fs_read_all(str_concat(dir, "/eskiu.lock"), &len);
    if (raw == null) {
        return;
    }
    string text = (string)raw;
    int pos = 0;
    int line_no = 0;
    while (pos < (int)len) {
        int end = pos;
        while (end < (int)len && (int)text[end] != 10) {
            end = end + 1;
        }
        line_no = line_no + 1;
        int stop = end;
        if (stop > pos && (int)text[stop - 1] == 13) {
            stop = stop - 1;
        }
        if (stop > pos && (int)text[pos] != 35) {
            List<string> f;
            List_init<string>(&f, 5);
            int a = pos;
            int k = pos;
            while (k <= stop) {
                if (k == stop || (int)text[k] == 9) {
                    List_push<string>(&f, p_sub(text, a, k));
                    a = k + 1;
                }
                k = k + 1;
            }
            int nf = List_len<string>(&f);
            string kind = "";
            if (nf > 1) {
                kind = List_get<string>(&f, 1);
            }
            string root = null;
            if (str_eq(kind, "git") == 1 && nf == 5) {
                root = str_concat(pkg_home(), str_concat("/pkgs/", str_concat(List_get<string>(&f, 0),
                       str_concat("/", List_get<string>(&f, 4)))));
            } else if (str_eq(kind, "path") == 1 && nf == 3) {
                root = List_get<string>(&f, 2);
                // Relative to the lock's directory (as the C++ eskiuc writes it).
                if ((int)root[0] != 47 && !((int)root[0] != 0 && (int)root[1] == 58)) {
                    root = canonical_path(str_concat(dir, str_concat("/", root)));
                }
            } else if (str_eq(kind, "root") == 1 && nf == 3) {
                root = dir;
            } else {
                uint8[64] nb;
                sprintf((string)&nb[0], ":%d: ", line_no);
                lx_puts_err("error: ");
                lx_puts_err(str_concat(dir, "/eskiu.lock"));
                lx_puts_err((string)&nb[0]);
                lx_puts_err("malformed entry (run eskiuc fetch)\n");
                exit(1);
            }
            List_push<string>(&g_pkg_names, List_get<string>(&f, 0));
            List_push<string>(&g_pkg_roots, root);
        }
        pos = end + 1;
    }
}

// The pp_run import hook (see g_pp_import_hook): preprocess the import now, once.
void pre_import(string spec, int is_std, string importer) {
    if (spec[0] == 0) {
        return;
    }
    string full = resolve_import(spec, is_std, str_dir(importer));
    string key = canonical_path(full);
    if (is_registered(key) == 1 || pre_find(key) >= 0) {
        return;
    }
    let bytes: int64 = 0;
    *uint8 isrc = fs_read_all(full, &bytes);
    if (isrc == null) {                // do_import reports it at the import
        return;
    }
    List_push<string>(&g_pre_keys, key);
    List_push<string>(&g_pre_text, "");
    List_push<int>(&g_pre_err, 0);
    List_push<int>(&g_pre_len, 0);
    int idx = List_len<string>(&g_pre_keys) - 1;
    let pe: int = 0;
    string psrc = pp_run((string)isrc, (int)bytes, full, &pe);
    List_set<string>(&g_pre_text, idx, psrc);
    List_set<int>(&g_pre_err, idx, pe);
    List_set<int>(&g_pre_len, idx, g_pp_out_len);
}

void parser_session_init() {
    List_init<string>(&g_pre_keys, 16);
    List_init<string>(&g_pre_text, 16);
    List_init<int>(&g_pre_err, 16);
    List_init<int>(&g_pre_len, 16);
    g_pp_import_hook = pre_import;
    g_pp_hook_set = 1;
    List_init<string>(&g_imported, 16);
    List_init<string>(&g_typenames, 64);
    List_init<string>(&g_genericnames, 16);
    List_init<string>(&g_localvars, 16);
    g_cur_pack = 0;
    List_init<int>(&g_pack_stack, 8);
    List_init<string>(&g_link_libs, 4);
    List_init<string>(&g_tparams, 8);
}

// Interpret a `#pragma pack(...)` directive (text is everything after `#`, e.g.
// "pragma pack(2)" / "pragma pack(push, 1)" / "pragma pack(pop)" / "pragma pack()").
// Sets g_cur_pack for subsequent struct declarations; other pragmas are ignored.
// A pack alignment other than 1, 2, 4, 8 or 16 is an error at the pragma token `t`.
void apply_pragma(Parser* p, Token t, string text) {
    int n = 0;
    while (text[n] != 0) {
        n = n + 1;
    }
    int pk = -1;                          // find "pack"
    int i = 0;
    while (i + 4 <= n) {
        if (text[i] == 112 && text[i+1] == 97 && text[i+2] == 99 && text[i+3] == 107) {
            pk = i;
            break;
        }
        i = i + 1;
    }
    if (pk < 0) {
        return;
    }
    int lp = pk;   // '('
    while (lp < n && (int)text[lp] != 40) {
        lp = lp + 1;
    }
    // collect comma-separated args inside (...)
    List<string> args;
    List_init<string>(&args, 2);
    if (lp < n) {
        int j = lp + 1;
        int start = j;
        while (j < n && (int)text[j] != 41) {        // ')'
            if ((int)text[j] == 44) {                // ','
                string a = str_trim(p_sub(text, start, j));
                if (a[0] != 0) {
                    List_push<string>(&args, a);
                }
                start = j + 1;
            }
            j = j + 1;
        }
        string a = str_trim(p_sub(text, start, j));
        if (a[0] != 0) {
            List_push<string>(&args, a);
        }
    }
    if (List_len<string>(&args) == 0) {   // pack() → reset
        g_cur_pack = 0;
        return;
    }
    string a0 = List_get<string>(&args, 0);
    if (str_eq(a0, "push") == 1) {
        int nv = g_cur_pack;
        if (List_len<string>(&args) >= 2) {
            nv = pack_value(p, t, List_get<string>(&args, 1));
        }
        List_push<int>(&g_pack_stack, g_cur_pack);
        g_cur_pack = nv;
        return;
    }
    if (str_eq(a0, "pop") == 1) {
        int sn = List_len<int>(&g_pack_stack);
        if (sn > 0) {
            g_cur_pack = List_get<int>(&g_pack_stack, sn - 1);
            List_remove<int>(&g_pack_stack, sn - 1);
        }
        else {
            g_cur_pack = 0;
        }
        return;
    }
    g_cur_pack = pack_value(p, t, a0);               // pack(N)
}

// A `#pragma pack` alignment: a power of two from 1 to 16, as in C (mirrors the C++
// applyPragma); anything else is a located error.
int pack_value(Parser* p, Token t, string a) {
    int n = 0;
    int k = 0;
    while (a[k] != 0 && k < 3) {
        if ((int)a[k] < 48 || (int)a[k] > 57) {
            n = 0;
            k = 3;
        }
        else {
            n = n * 10 + ((int)a[k] - 48);
            k = k + 1;
        }
    }
    if (k > 2) {
        n = 0;
    }
    if (n != 1 && n != 2 && n != 4 && n != 8 && n != 16) {
        p_report(p, t, str_concat(str_concat("invalid #pragma pack alignment '", a), "' (expected 1, 2, 4, 8 or 16)"));
    }
    return n;
}

// Is `c` allowed in a `#pragma link` library name (what follows -l)?
int link_name_char(int c) {
    if (c >= 97 && c <= 122) {
        return 1;
    }
    if (c >= 65 && c <= 90) {
        return 1;
    }
    if (c >= 48 && c <= 57) {
        return 1;
    }
    if (c == 95 || c == 46 || c == 43 || c == 45) {
        return 1;
    }
    return 0;
}

int pragma_skip_ws(string s, int i, int n) {
    while (i < n && ((int)s[i] == 32 || (int)s[i] == 9)) {
        i = i + 1;
    }
    return i;
}

// `#pragma link("name")` (mirrors the C++ Parser::applyPragma): records `name` in
// g_link_libs once and returns 1; returns 0 when the pragma is not `link`. A malformed
// link pragma is a syntax error at the pragma token.
int apply_link_pragma(Parser* p, Token t, string text) {
    int n = 0;
    while (text[n] != 0) {
        n = n + 1;
    }
    int w = -1;                           // find "pragma"
    int i = 0;
    while (i + 6 <= n) {
        if (text[i] == 112 && text[i+1] == 114 && text[i+2] == 97 && text[i+3] == 103 && text[i+4] == 109 && text[i+5] == 97) {
            w = i;
            break;
        }
        i = i + 1;
    }
    if (w < 0) {
        return 0;
    }
    i = pragma_skip_ws(text, w + 6, n);
    if (i + 4 > n) {
        return 0;
    }
    if (text[i] != 108 || text[i+1] != 105 || text[i+2] != 110 || text[i+3] != 107) {   // "link"
        return 0;
    }
    if (i + 4 < n && link_name_char((int)text[i + 4]) == 1) {
        return 0;
    }
    string usage = "malformed #pragma link: expected #pragma link(\"name\")";
    int j = pragma_skip_ws(text, i + 4, n);
    if (j >= n || (int)text[j] != 40) {
        p_report(p, t, usage);
    }
    j = pragma_skip_ws(text, j + 1, n);
    if (j >= n || (int)text[j] != 34) {
        p_report(p, t, usage);
    }
    int k = j + 1;
    while (k < n && link_name_char((int)text[k]) == 1) {
        k = k + 1;
    }
    string name = p_sub(text, j + 1, k);
    if (name[0] == 0 || (int)name[0] == 45 || k >= n || (int)text[k] != 34) {
        p_report(p, t, usage);
    }
    k = pragma_skip_ws(text, k + 1, n);
    if (k >= n || (int)text[k] != 41) {
        p_report(p, t, usage);
    }
    if (pragma_skip_ws(text, k + 1, n) < n) {
        p_report(p, t, usage);
    }
    int li = 0;
    while (li < List_len<string>(&g_link_libs)) {
        if (str_eq(List_get<string>(&g_link_libs, li), name) == 1) {
            return 1;
        }
        li = li + 1;
    }
    List_push<string>(&g_link_libs, name);
    return 1;
}

// Consume a #pragma token and apply it (link library or pack state).
void p_take_pragma(Parser* p) {
    Token pt = p_adv(p);
    string ptext = tok_text(p.src, pt);
    if (apply_link_pragma(p, pt, ptext) == 0) {
        apply_pragma(p, pt, ptext);
    }
}

void p_init(Parser* p, *uint8 src, int len) {
    p.src = src;
    p.pos = 0;
    p.pending_gt = 0;
    p.no_struct_lit = 0;
    p.basedir = ".";
    p.file = g_lex_file;
    p.spec = 0;
    p.failed = 0;
    p.nest = 0;
    p.tdepth = 0;
    p.tca_done = 0;
    p.is_import = 0;
    List_init<*StmtNode>(&p.so_stmts, 4);
    List_init<*DeclNode>(&p.so_vars, 4);
    List_init<Token>(&p.toks, 256);
    let lx: Lexer;
    lx.src = src;
    lx.len = len;
    lx.pos = 0;
    lx.line = 1;
    lx.col = 1;
    Token t = lx_next(&lx);
    while (t.type != EOF_TOKEN) {
        List_push<Token>(&p.toks, t);
        t = lx_next(&lx);
    }
    List_push<Token>(&p.toks, t);          // keep the EOF token as the last element
    if (g_lex_errs > 0) {       // lexical errors were reported (like the C++ hadError)
        exit(1);
    }
}

Token p_peek(Parser* p) {
    return List_get<Token>(&p.toks, p.pos);
}

Token p_peek2(Parser* p) {
    int i = p.pos + 1;
    int n = List_len<Token>(&p.toks);
    if (i >= n) {
        i = n - 1;
    }
    return List_get<Token>(&p.toks, i);
}

Token p_peek_k(Parser* p, int k) {
    int i = p.pos + k;
    int n = List_len<Token>(&p.toks);
    if (i >= n) {
        i = n - 1;
    }
    return List_get<Token>(&p.toks, i);
}

// The source between two tokens with each whitespace run folded to one space
// (the C++ Parser::sourceSpan): the text `dbg(e)` prints for `e`.
string p_source_span(Parser* p, Token from, Token to) {
    *String out = alloc<String>(1);
    String_init(out, 16);
    int space = 0;
    for (int i = from.start; i < to.start; i++) {
        uint8 c = p.src[i];
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            if (out.len > 0) {
                space = 1;
            }
            continue;
        }
        if (space == 1) {
            String_push(out, (char)32);
            space = 0;
        }
        String_push(out, (char)c);
    }
    return out.data;
}

int p_at(Parser* p) {
    return p_peek(p).type;
}

Token p_adv(Parser* p) {
    Token t = p_peek(p);
    g_pos_line = t.line;   // stamped onto the nodes built next
    g_pos_col = t.col;
    if (p.pos + 1 < List_len<Token>(&p.toks)) {
        p.pos = p.pos + 1;
    }
    return t;
}

// Print `error: <file>:<line>:<col>: <msg>` at token `t` and abort (mirrors the C++
// parser's located diagnostics).
void p_report(Parser* p, Token t, string msg) {
    uint8[32] nb;
    lx_puts_err("error: ");
    if (p.file == null) {
        lx_puts_err("<input>");
    }
    else if (p.file[0] == 0) {
        lx_puts_err("<input>");
    }
    else {
        lx_puts_err(p.file);
    }
    sprintf((string)&nb[0], ":%d:%d: ", t.line, t.col);
    lx_puts_err((string)&nb[0]);
    lx_puts_err(msg);
    lx_puts_err("\n");
    exit(1);
}

// A syntax error at the current token. While speculating (p.spec > 0) it only marks
// the attempt failed and jumps to EOF so every loop unwinds; the speculation site
// then backtracks (like the C++ catch). Otherwise it is reported and aborts.
void p_fail(Parser* p, string msg) {
    if (p.spec > 0) {
        p.failed = 1;
        p.pos = List_len<Token>(&p.toks) - 1;
        return;
    }
    p_report(p, p_peek(p), msg);
}

// Safety net against pathological input (mirrors the C++ NestGuard): more than
// 100000 nested levels is an error rather than a stack overflow here or in the later
// passes, which recurse once per level. The drivers run the compiler on a large stack
// (see bigstack.esk), so the limit sits far above realistic code. Operator chains and
// statement lists are loops and do not count. Past the limit no other reading of the
// input is valid, so the error is reported even inside a speculative parse (like the
// C++ NestingError, which a speculative catch rethrows).
int P_MAX_NESTING = 100000;
void p_nest_enter(Parser* p) {
    p.nest = p.nest + 1;
    if (p.nest > P_MAX_NESTING) {
        p_report(p, p_peek(p), "nesting too deep (more than 100000 levels)");
    }
}

// Types nest far less (mirrors the C++ kMaxTypeNesting): every template argument list,
// fn type, pointer level and array dimension is one level, at most 1000 in all. Later
// passes spell a generic instance by its whole argument list, so a type's cost grows
// faster than its depth; the limit keeps every type cheap. Reported like p_nest_enter.
int P_MAX_TYPE_NESTING = 1000;
void p_type_level(Parser* p) {
    p.tdepth = p.tdepth + 1;
    if (p.tdepth > P_MAX_TYPE_NESTING) {
        p_report(p, p_peek(p), "type nesting too deep (more than 1000 levels)");
    }
}

// Consume a token of type `t`, or fail with `msg`.
void p_expect(Parser* p, int t, string msg) {
    if (p_at(p) == t) {
        p_adv(p);
        return;
    }
    p_fail(p, msg);
}

// Consume a token of type `t` and return it, or fail with `msg`.
Token p_expect_tok(Parser* p, int t, string msg) {
    Token k = p_peek(p);
    if (k.type == t) {
        p_adv(p);
        return k;
    }
    p_fail(p, msg);
    return k;
}

// Consume a name (IDENT), or fail. Returns the token.
Token p_expect_ident(Parser* p, string msg) {
    Token t = p_peek(p);
    if (t.type == IDENT) {
        p_adv(p);
        return t;
    }
    p_fail(p, msg);
    return t;
}

// Template close: a single `>` (GT) or one `>` of a `>>` (RSHIFT, split in place
// via pending_gt — the token list isn't mutable, so we model the second `>`).
int at_tclose(Parser* p) {
    if (p.pending_gt > 0) {
        return 1;
    }
    int t = p_at(p);
    if (t == GT || t == RSHIFT) {
        return 1;
    }
    return 0;
}

void consume_tclose(Parser* p) {
    if (p.pending_gt > 0) {   // 2nd `>` of `>>`
        p.pending_gt = 0;
        p_adv(p);
        return;
    }
    if (p_at(p) == RSHIFT) {            // 1st `>` of `>>`
        p.pending_gt = 1;
        return;
    }
    p_adv(p);                                                        // a lone `>`
}

// Forward declarations (mutually-recursive descent).
*ExprNode parse_assignment(Parser* p);
*ExprNode parse_expr(Parser* p);
*ExprNode parse_postfix(Parser* p);
int ternary_colon_ahead(Parser* p);
string parse_type(Parser* p);
*ExprNode parse_struct_init(Parser* p, string name);
*StmtNode parse_stmt(Parser* p);
*StmtNode parse_block(Parser* p);
*StmtNode parse_block_item(Parser* p);
*StmtNode try_var_decl(Parser* p);
*StmtNode spec_var_decl(Parser* p);
void parse_into(Parser* p, *Program prog);

// Lexeme of a token as an owned NUL-terminated string (heap copy of source bytes).
string tok_text(*uint8 src, Token t) {
    if (t.type == INT_LIT || t.type == FLOAT_LIT) {
        return lx_num_text(src, t.start, t.len);
    }
    *uint8 buf = alloc<uint8>(t.len + 1);
    int i = 0;
    while (i < t.len) {
        buf[i] = src[t.start + i];
        i = i + 1;
    }
    buf[t.len] = 0;
    return (string)buf;
}

int cstr_len(string s) {
    int i = 0;
    while (s[i] != 0) {
        i = i + 1;
    }
    return i;
}

string str_concat(string a, string b) {
    int la = cstr_len(a);
    int lb = cstr_len(b);
    *uint8 buf = alloc<uint8>(la + lb + 1);
    int i = 0;
    while (i < la) {
        buf[i] = (uint8)a[i];
        i = i + 1;
    }
    int j = 0;
    while (j < lb) {
        buf[la + j] = (uint8)b[j];
        j = j + 1;
    }
    buf[la + lb] = 0;
    return (string)buf;
}

// Substring s[a, b) as a fresh NUL-terminated string.
string p_sub(string s, int a, int b) {
    int len = b - a;
    if (len < 0) {
        len = 0;
    }
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0;
    while (k < len) {
        buf[k] = (uint8)s[a + k];
        k = k + 1;
    }
    buf[len] = 0;
    return (string)buf;
}

// Trim leading/trailing spaces and tabs.
string str_trim(string s) {
    int n = 0;
    while (s[n] != 0) {
        n = n + 1;
    }
    int a = 0;
    while (a < n && ((int)s[a] == 32 || (int)s[a] == 9)) {
        a = a + 1;
    }
    int b = n;
    while (b > a && ((int)s[b - 1] == 32 || (int)s[b - 1] == 9)) {
        b = b - 1;
    }
    return p_sub(s, a, b);
}

int str_eq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) {
            return 0;
        }
        i = i + 1;
    }
    if (a[i] == b[i]) {        // both reached NUL together
        return 1;
    }
    return 0;
}

int str_has_char(string s, int c) {
    int i = 0;
    while (s[i] != 0) {
        if ((int)s[i] == c) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Directory portion of a path (everything before the last '/'), or "." if none.
string str_dir(string s) {
    int n = cstr_len(s);
    int last = 0 - 1;
    int i = 0;
    while (i < n) {   // 47 = '/'
        if ((int)s[i] == 47) {
            last = i;
        }
        i = i + 1;
    }
    if (last < 0) {
        return ".";
    }
    *uint8 buf = alloc<uint8>(last + 1);
    int j = 0;
    while (j < last) {
        buf[j] = (uint8)s[j];
        j = j + 1;
    }
    buf[last] = 0;
    return (string)buf;
}

void register_type(Parser* p, string name) {
    List_push<string>(&g_typenames, name);     // shared across all imported files
}

int is_known_type(Parser* p, string name) {
    int i = 0;
    int n = List_len<string>(&g_typenames);
    while (i < n) {
        if (str_eq(List_get<string>(&g_typenames, i), name) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// A declared type name or an in-scope type parameter (mirrors Parser::isTypeName).
int is_type_name(Parser* p, string name) {
    if (is_known_type(p, name) == 1) {
        return 1;
    }
    int i = 0;
    while (i < List_len<string>(&g_tparams)) {
        if (str_eq(List_get<string>(&g_tparams, i), name) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Locals and params in scope (mirrors Parser::localVars): a block, function or lambda
// body drops what it declared when it ends (local_pop to its local_mark).
int local_mark() {
    return List_len<string>(&g_localvars);
}

void local_pop(int mark) {
    while (List_len<string>(&g_localvars) > mark) {
        List_remove<string>(&g_localvars, List_len<string>(&g_localvars) - 1);
    }
}

void local_push_params(*DeclNode d) {
    int i = 0;
    while (i < List_len<Param>(&d.params)) {
        List_push<string>(&g_localvars, List_get<Param>(&d.params, i).name);
        i = i + 1;
    }
}

int is_local_var(string name) {
    int i = 0;
    while (i < List_len<string>(&g_localvars)) {
        if (str_eq(List_get<string>(&g_localvars, i), name) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Is `name` a generic function or generic enum variant parsed so far?
int is_generic_name(string name) {
    int i = 0;
    while (i < List_len<string>(&g_genericnames)) {
        if (str_eq(List_get<string>(&g_genericnames, i), name) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Can the parsed template argument `t` only be a type (mirrors Parser::typeArgIsEvident)?
// A bare name that is not a declared type (`b` in `f(a < b, c > (d))`) may equally be
// a comparison operand.
int type_arg_evident(Parser* p, string t) {
    int n = cstr_len(t);
    int i = 0;
    while (i < n) {   // '<' '('
        if ((int)t[i] == 60 || (int)t[i] == 40) {
            return 1;
        }
        i = i + 1;
    }
    int b = 0;
    int e = n;
    int go = 1;
    while (go == 1) {
        go = 0;
        if (b < e && ((int)t[b] == 63 || (int)t[b] == 42)) {          // '?' '*'
            b = b + 1;
            go = 1;
        }
        else if (e - b >= 6 && str_eq(p_sub(t, b, b + 6), "const ") == 1) {
            b = b + 6;
            go = 1;
        }
    }
    go = 1;
    while (go == 1) {
        go = 0;
        if (e > b && (int)t[e - 1] == 93) {                                              // ']'
            int o = e - 1;
            while (o >= b && (int)t[o] != 91) {                              // '['
                o = o - 1;
            }
            if (o >= b) {
                e = o;
                go = 1;
            }
        }
        else if (e - b > 6 && str_eq(p_sub(t, e - 6, e), "*const") == 1) {
            e = e - 6;
            go = 1;
        }
        else if (e > b && (int)t[e - 1] == 42) {
            e = e - 1;
            go = 1;
        }
    }
    string base = p_sub(t, b, e);
    if (str_eq(base, "int") == 1 || str_eq(base, "int8") == 1 || str_eq(base, "int16") == 1
        || str_eq(base, "int32") == 1 || str_eq(base, "int64") == 1 || str_eq(base, "uint") == 1
        || str_eq(base, "uint8") == 1 || str_eq(base, "uint16") == 1 || str_eq(base, "uint32") == 1
        || str_eq(base, "uint64") == 1 || str_eq(base, "float") == 1 || str_eq(base, "double") == 1
        || str_eq(base, "bool") == 1 || str_eq(base, "char") == 1 || str_eq(base, "string") == 1
        || str_eq(base, "void") == 1) {
        return 1;
    }
    return is_type_name(p, base);
}

// Push a decl's type-param names onto g_tparams; returns the old depth for restoring.
int push_tparams(List<TypeParam>* tps) {
    int mark = List_len<string>(&g_tparams);
    int i = 0;
    while (i < List_len<TypeParam>(tps)) {
        List_push<string>(&g_tparams, List_get<TypeParam>(tps, i).name);
        i = i + 1;
    }
    return mark;
}

void pop_tparams(int mark) {
    while (List_len<string>(&g_tparams) > mark) {
        List_remove<string>(&g_tparams, List_len<string>(&g_tparams) - 1);
    }
}

int is_type_kw(int t) {
    if (t == INT || t == FLOAT || t == DOUBLE || t == BOOL || t == CHAR || t == STRING || t == VOID) {
        return 1;
    }
    if (t == INT8 || t == INT16 || t == INT32 || t == INT64) {
        return 1;
    }
    if (t == UINT || t == UINT8 || t == UINT16 || t == UINT32 || t == UINT64) {
        return 1;
    }
    return 0;
}

// String/char literal value (decoded, quotes stripped — the C++ stores the decoded
// value in LiteralExpr.value). The byte-level escape decode (decode_escape_span,
// backed by decode_str_escape) is shared from tokens.esk.
string tok_str_value(*uint8 src, Token t, *int out_len) {
    *uint8 buf = alloc<uint8>(t.len + 1);
    int off = 0;
    int i = t.start + 1;
    int endp = lx_str_end(src, t.start, t.len);
    while (i < endp) {
        int ch = (int)src[i];
        if (ch == 92 && i + 1 < endp) {
            i = i + 1;
            int adv = 0;
            buf[off] = (uint8)decode_escape_span(src, i, endp, &adv);
            i = i + adv;
        } else {
            buf[off] = (uint8)ch;
        }
        off = off + 1;
        i = i + 1;
    }
    buf[off] = 0;
    out_len[0] = off;   // exact byte count; the value may contain embedded NULs
    return (string)buf;
}

// Concatenate two byte spans (length-aware, so embedded NULs survive adjacent-string concat).
string str_concat_n(string a, int alen, string b, int blen) {
    *uint8 buf = alloc<uint8>(alen + blen + 1);
    int i = 0;
    while (i < alen) {
        buf[i] = (uint8)a[i];
        i = i + 1;
    }
    int j = 0;
    while (j < blen) {
        buf[alen + j] = (uint8)b[j];
        j = j + 1;
    }
    buf[alen + blen] = 0;
    return (string)buf;
}

string tok_char_value(*uint8 src, Token t) {
    *uint8 buf = alloc<uint8>(4);
    int off = 0;
    int i = t.start + 1;
    int endp = t.start + t.len - 1;
    if (i < endp) {
        int ch = (int)src[i];
        int consumed = 1;
        if (ch == 92 && i + 1 < endp) {
            int adv = 0;
            buf[off] = (uint8)decode_escape_span(src, i + 1, endp, &adv);
            consumed = 2 + adv;             // backslash + escape char + extra (e.g. \x41's two hex digits)
        } else {
            buf[off] = (uint8)ch;
        }
        off = off + 1;
        if (i + consumed < endp) {          // more source chars remain: `'ab'` is not one character
            dprintf(2, "error: character literal must contain a single character\n");
            exit(1);
        }
    }
    buf[off] = 0;
    return (string)buf;
}

// Parse a type into its canonical string (mirrors parser.cpp parseType). Template
// instantiation `Name<...>` is added in a later slice (S2b/S6).
string parse_type_inner(Parser* p);
string parse_type(Parser* p) {
    int saved = p.tdepth;
    p_type_level(p);
    string ty = parse_type_inner(p);
    p.tdepth = saved;
    return ty;
}

string parse_type_inner(Parser* p) {
    int is_const = 0;
    if (p_at(p) == CONST) {
        p_adv(p);
        is_const = 1;
    }
    int nullable = 0;
    if (p_at(p) == QUESTION) {   // `?*T`: checked nullable pointer
        p_adv(p);
        nullable = 1;
    }
    // A `?` between two leading stars makes the pointer after it nullable: `*?*T` is a
    // pointer to a nullable pointer to T.
    string lead = "";
    while (p_at(p) == STAR) {
        p_type_level(p);
        p_adv(p);
        lead = str_concat(lead, "*");
        if (p_at(p) == QUESTION && p_peek2(p).type == STAR) {
            p_adv(p);
            lead = str_concat(lead, "?");
        }
    }

    if (p_at(p) == FN) {
        p_adv(p);                          // 'fn'
        p_expect(p, LPAREN, "Expected '('");
        string ft = "fn(";
        int first = 1;
        while (p_at(p) != RPAREN && p_at(p) != EOF_TOKEN) {
            if (first == 0) {
                p_adv(p);
                ft = str_concat(ft, ",");
            }
            first = 0;
            ft = str_concat(ft, parse_type(p));
        }
        p_expect(p, RPAREN, "Expected ')'");
        ft = str_concat(ft, ")->");
        p_expect(p, ARROW, "Expected '->'");
        ft = str_concat(ft, parse_type(p));
        ft = str_concat(lead, ft);
        if (is_const == 1) {
            ft = str_concat("const ", ft);
        }
        if (nullable == 1) {
            ft = str_concat("?", ft);
        }
        return ft;
    }

    Token base_tok = p_peek(p);            // type keyword or named type (IDENT)
    if (base_tok.type != IDENT && is_type_kw(base_tok.type) == 0) {
        p_fail(p, str_concat("Expected type, got ", token_name(base_tok.type)));
        return "int";
    }
    p_adv(p);
    string ty = tok_text(p.src, base_tok);

    // Template instantiation: Name<TypeArg, ...>
    if (base_tok.type == IDENT && p_at(p) == LT) {
        p_adv(p);                          // '<'
        ty = str_concat(ty, "<");
        ty = str_concat(ty, parse_type(p));
        while (p_at(p) == COMMA) {
            p_adv(p);
            ty = str_concat(ty, ",");
            ty = str_concat(ty, parse_type(p));
        }
        consume_tclose(p);
        ty = str_concat(ty, ">");
    }

    while (p_at(p) == STAR) {
        p_type_level(p);
        p_adv(p);
        ty = str_concat(ty, "*");
        if (p_at(p) == CONST) {
            p_adv(p);
            ty = str_concat(ty, "const");
        }
    }
    ty = str_concat(lead, ty);
    if (is_const == 1) {
        ty = str_concat("const ", ty);
    }

    while (p_at(p) == LBRACKET) {
        p_type_level(p);
        p_adv(p);
        string sz = "";
        while (p_at(p) != RBRACKET && p_at(p) != EOF_TOKEN) {
            sz = str_concat(sz, tok_text(p.src, p_peek(p)));
            p_adv(p);
        }
        p_expect(p, RBRACKET, "Expected ']'");
        ty = str_concat(ty, str_concat("[", str_concat(sz, "]")));
    }
    if (nullable == 1) {   // preserve `?` as the outermost prefix
        ty = str_concat("?", ty);
    }
    return ty;
}

// ── AST node constructors ────────────────────────────────────────────────────

*ExprNode mk_lit(int lk, string v) {
    *ExprNode e = ast_new_expr();
    e.kind = EK_LITERAL;
    e.lit_kind = lk;
    e.sval = v;
    e.slen = 0;
    if (lk == LIT_STRING) {   // safe default; the parser overrides with the exact byte length (embedded NULs)
        e.slen = cstr_len(v);
    }
    return e;
}

*ExprNode mk_ident(string nm) {
    *ExprNode e = ast_new_expr();
    e.kind = EK_IDENT;
    e.sval = nm;
    return e;
}

// Stamp `e` with token `t`'s position: each node points where the C++ parser's does
// (an operator at its operator token, a cast at its `(`, a keyword form at its keyword).
*ExprNode p_pos(*ExprNode e, Token t) {
    if (e != null) {
        e.line = t.line;
        e.col = t.col;
    }
    return e;
}

*ExprNode mk_bin(string op, *ExprNode l, *ExprNode r) {
    *ExprNode e = ast_new_expr();
    e.kind = EK_BINARY;
    e.sval = op;
    e.a = l;
    e.b = r;
    if (l != null && l.line > 0) {   // an operation starts at its left operand
        e.line = l.line;
        e.col = l.col;
    }
    return e;
}

*ExprNode mk_un(string op, *ExprNode operand) {
    *ExprNode e = ast_new_expr();
    e.kind = EK_UNARY;
    e.sval = op;
    e.a = operand;
    return e;
}

// Operator lexeme for a binary/unary operator token type (matches Token.value).
string op_str(int t) {
    if (t == PLUS) {
        return "+";
    }
    if (t == MINUS) {
        return "-";
    }
    if (t == STAR) {
        return "*";
    }
    if (t == SLASH) {
        return "/";
    }
    if (t == PERCENT) {
        return "%";
    }
    if (t == AMPERSAND) {
        return "&";
    }
    if (t == PIPE) {
        return "|";
    }
    if (t == CARET) {
        return "^";
    }
    if (t == LSHIFT) {
        return "<<";
    }
    if (t == RSHIFT) {
        return ">>";
    }
    if (t == EQEQ) {
        return "==";
    }
    if (t == NE) {
        return "!=";
    }
    if (t == LT) {
        return "<";
    }
    if (t == GT) {
        return ">";
    }
    if (t == LE) {
        return "<=";
    }
    if (t == GE) {
        return ">=";
    }
    if (t == AND) {
        return "&&";
    }
    if (t == OR) {
        return "||";
    }
    if (t == NOT) {
        return "!";
    }
    if (t == TILDE) {
        return "~";
    }
    return "?";
}

// Base operator for a compound-assignment token (x += y desugars to x = x + y).
string compound_base(int t) {
    if (t == PLUS_EQ) {
        return "+";
    }
    if (t == MINUS_EQ) {
        return "-";
    }
    if (t == STAR_EQ) {
        return "*";
    }
    if (t == SLASH_EQ) {
        return "/";
    }
    if (t == PERCENT_EQ) {
        return "%";
    }
    if (t == AMP_EQ) {
        return "&";
    }
    if (t == PIPE_EQ) {
        return "|";
    }
    if (t == CARET_EQ) {
        return "^";
    }
    if (t == LSHIFT_EQ) {
        return "<<";
    }
    if (t == RSHIFT_EQ) {
        return ">>";
    }
    return "?";
}

int is_compound(int t) {
    if (t == PLUS_EQ || t == MINUS_EQ || t == STAR_EQ || t == SLASH_EQ || t == PERCENT_EQ) {
        return 1;
    }
    if (t == AMP_EQ || t == PIPE_EQ || t == CARET_EQ || t == LSHIFT_EQ || t == RSHIFT_EQ) {
        return 1;
    }
    return 0;
}

// ── Expression precedence chain (mirrors parse_expr.cpp) ──────────────────────

*ExprNode mk_cast(string ty, *ExprNode inner) {
    *ExprNode e = ast_new_expr();
    e.kind = EK_CAST;
    e.sval = ty;
    e.a = inner;
    return e;
}

// Struct literal: Name { field: expr, ... } or Name { expr, ... } (positional).
// `name` already parsed (may carry a <...> template suffix). At '{'.
*ExprNode parse_struct_init(Parser* p, string name) {
    p_expect(p, LBRACE, "Expected '{'");
    *ExprNode e = ast_new_expr();
    e.kind = EK_STRUCTINIT;
    e.sval = name;
    List_init<*ExprNode>(&e.kids, 4);
    List_init<string>(&e.names, 4);
    if (p_at(p) != RBRACE) {
        while (1 == 1) {
            if (p_at(p) == IDENT && p_peek2(p).type == COLON) {
                Token nm = p_adv(p);       // field name  (NB: not `fn` — reserved keyword)
                p_expect(p, COLON, "Expected ':'");
                List_push<string>(&e.names, tok_text(p.src, nm));
            } else {
                List_push<string>(&e.names, "");
            }
            List_push<*ExprNode>(&e.kids, parse_expr(p));
            if (p_at(p) == COMMA) {
                p_adv(p);
            } else {
                break;
            }
            if (p_at(p) == RBRACE) {                  // a trailing comma
                break;
            }
        }
    }
    p_expect(p, RBRACE, "Expected '}'");
    return e;
}

// Lambda signature string for the printer: "<ret>(t0 n0, t1 n1)".
string lambda_sig(string ret, *DeclNode d) {
    string sig = str_concat(ret, "(");
    int i = 0;
    int n = List_len<Param>(&d.params);
    while (i < n) {
        Param pm = List_get<Param>(&d.params, i);
        if (i > 0) {
            sig = str_concat(sig, ", ");
        }
        sig = str_concat(sig, pm.ty);
        sig = str_concat(sig, " ");
        sig = str_concat(sig, pm.name);
        i = i + 1;
    }
    return str_concat(sig, ")");
}

// Does a lambda whose return type is not a type keyword start here (`S() {`,
// `*S(int k) {`, `Box<int>(T x) {`)? A token scan, no parse (mirrors lambdaAhead).
int lambda_ahead(Parser* p) {
    int n = List_len<Token>(&p.toks);
    int i = p.pos;
    if (i < n && List_get<Token>(&p.toks, i).type == QUESTION) {
        i = i + 1;
    }
    while (i < n && List_get<Token>(&p.toks, i).type == STAR) {
        i = i + 1;
    }
    if (i >= n) {
        return 0;
    }
    int t0 = List_get<Token>(&p.toks, i).type;
    if (t0 != IDENT && is_type_kw(t0) == 0) {
        return 0;
    }
    i = i + 1;
    if (i < n && List_get<Token>(&p.toks, i).type == LT) {
        int d = 1;
        i = i + 1;
        while (i < n && d > 0) {
            int t = List_get<Token>(&p.toks, i).type;
            if (t == LT) {
                d = d + 1;
            }
            else if (t == GT) {
                d = d - 1;
            }
            else if (t == RSHIFT) {
                d = d - 2;
            }
            else if (t != IDENT && is_type_kw(t) == 0 && t != COMMA && t != STAR && t != QUESTION) {
                return 0;
            }
            i = i + 1;
        }
        if (d != 0) {
            return 0;
        }
    }
    while (i < n && List_get<Token>(&p.toks, i).type == STAR) {
        i = i + 1;
    }
    if (i >= n || List_get<Token>(&p.toks, i).type != LPAREN) {
        return 0;
    }
    int d = 0;
    while (i < n) {
        int t = List_get<Token>(&p.toks, i).type;
        if (t == LPAREN) {
            d = d + 1;
        }
        else if (t == RPAREN) {
            d = d - 1;
            if (d == 0) {
                break;
            }
        }
        else if (t == LBRACE || t == SEMICOLON || t == EOF_TOKEN) {
            return 0;
        }
        i = i + 1;
    }
    if (i + 1 < n && List_get<Token>(&p.toks, i + 1).type == LBRACE) {
        return 1;
    }
    return 0;
}

// Lambda: RetType(params) { body }. Speculative: backs out (returns null) when the
// tokens do not form one.
*ExprNode try_parse_lambda(Parser* p) {
    int save = p.pos;
    Token lt0 = p_peek(p);
    p.spec = p.spec + 1;
    string ret = parse_type(p);
    p_expect(p, LPAREN, "Expected '('");
    *DeclNode tmp = ast_new_decl();
    parse_params(p, tmp);
    p_expect(p, RPAREN, "Expected ')'");
    p.spec = p.spec - 1;
    if (p.failed == 0 && p_at(p) == LBRACE) {
        *ExprNode e = p_pos(ast_new_expr(), lt0);
        e.kind = EK_LAMBDA;
        e.sval = lambda_sig(ret, tmp);
        int lmark = local_mark();
        local_push_params(tmp);
        e.stmt = parse_block(p);
        local_pop(lmark);
        return e;
    }
    p.failed = 0;
    p.pos = save;                          // not a lambda — back out
    return null;
}

*ExprNode parse_primary(Parser* p) {
    int t = p_at(p);
    if (t == LBRACE) {                                 // array literal { e0, e1, ... }
        p_adv(p);
        *ExprNode e = ast_new_expr();
        e.kind = EK_ARRAYLIT;
        List_init<*ExprNode>(&e.kids, 4);
        if (p_at(p) != RBRACE) {
            List_push<*ExprNode>(&e.kids, parse_expr(p));
            while (p_at(p) == COMMA) {
                p_adv(p);
                if (p_at(p) == RBRACE) {      // trailing comma
                    break;
                }
                List_push<*ExprNode>(&e.kids, parse_expr(p));
            }
        }
        p_expect(p, RBRACE, "Expected '}'");
        return e;
    }
    if (t == TRUE) {
        p_adv(p);
        return mk_lit(LIT_BOOL, "true");
    }
    if (t == FALSE) {
        p_adv(p);
        return mk_lit(LIT_BOOL, "false");
    }
    if (t == NULL_KW) {
        p_adv(p);
        return mk_lit(LIT_NULL, "null");
    }
    if (t == INT_LIT) {
        Token tok = p_adv(p);
        return mk_lit(LIT_INT, tok_text(p.src, tok));
    }
    if (t == FLOAT_LIT) {
        Token tok = p_adv(p);
        return mk_lit(LIT_FLOAT, tok_text(p.src, tok));
    }
    if (t == STRING_LIT) {
        Token first = p_adv(p);
        int vlen = 0;
        string v = tok_str_value(p.src, first, &vlen);
        while (p_at(p) == STRING_LIT) {        // adjacent string concatenation
            Token nx = p_adv(p);
            int nlen = 0;
            string nv = tok_str_value(p.src, nx, &nlen);
            v = str_concat_n(v, vlen, nv, nlen);
            vlen = vlen + nlen;
        }
        *ExprNode e = p_pos(mk_lit(LIT_STRING, v), first);
        e.slen = vlen;                          // exact length (embedded NULs preserved)
        return e;
    }
    if (t == CHAR_LIT) {
        Token tok = p_adv(p);
        return mk_lit(LIT_CHAR, tok_char_value(p.src, tok));
    }
    if (t == SIZEOF) {
        // sizeof(T) or sizeof(expr) (mirrors the C++ parser): a type when the operand reads
        // as one up to the `)` and is a bare name or a composite over a known type; any
        // other operand (`*p`, `a[0]`, `p.x`) is an expression, measured by its type.
        Token szt = p_adv(p);                  // 'sizeof'
        p_expect(p, LPAREN, "Expected '('");
        int save = p.pos;
        int savegt = p.pending_gt;
        p.spec = p.spec + 1;
        string ty = parse_type(p);
        p.spec = p.spec - 1;
        int as_type = 0;
        if (p.failed == 0 && p_at(p) == RPAREN) {
            int composite = 0;
            int ci = 0;
            while (ty[ci] != 0) {
                int ch = (int)ty[ci];
                if (ch == 42 || ch == 91 || ch == 63) {   // '*' '[' '?'
                    composite = 1;
                }
                ci = ci + 1;
            }
            if (composite == 0 || type_arg_evident(p, ty) == 1) {
                as_type = 1;
            }
        }
        *ExprNode e = p_pos(ast_new_expr(), szt);
        e.kind = EK_SIZEOF;
        if (as_type == 0) {
            p.failed = 0;
            p.pos = save;
            p.pending_gt = savegt;
            e.a = parse_expr(p);               // sval "" marks the expression form
            e.sval = "";
            p_expect(p, RPAREN, "Expected ')'");
            return e;
        }
        p_expect(p, RPAREN, "Expected ')'");
        e.sval = ty;
        return e;
    }
    if (t == ALLOC_WITH) {
        Token kwt = p_adv(p);
        p_expect(p, LPAREN, "Expected '(' after alloc_with");
        *ExprNode al = parse_expr(p);
        p_expect(p, COMMA, "Expected ','");
        string ety = parse_type(p);
        p_expect(p, COMMA, "Expected ','");
        *ExprNode cnt = parse_expr(p);
        p_expect(p, RPAREN, "Expected ')'");
        *ExprNode e = p_pos(ast_new_expr(), kwt);
        e.kind = EK_ALLOCWITH;
        e.sval = ety;
        e.a = al;
        e.b = cnt;
        return e;
    }
    if (t == FREE_CLOSURE) {
        Token kwt = p_adv(p);
        p_expect(p, LPAREN, "Expected '(' after free_closure");
        *ExprNode c = parse_expr(p);
        p_expect(p, RPAREN, "Expected ')'");
        *ExprNode e = p_pos(ast_new_expr(), kwt);
        e.kind = EK_FREECLOSURE;
        e.a = c;
        return e;
    }
    if (t == THREAD_CREATE) {
        Token kwt = p_adv(p);
        p_expect(p, LPAREN, "Expected '(' after thread_create");
        *ExprNode w = parse_expr(p);
        p_expect(p, RPAREN, "Expected ')'");
        *ExprNode e = p_pos(ast_new_expr(), kwt);
        e.kind = EK_THREADCREATE;
        e.a = w;
        return e;
    }
    // Lambda: RetType(params) { body } — a type keyword followed by '('.
    if (is_type_kw(t) == 1 && p_peek2(p).type == LPAREN && p.failed == 0) {
        *ExprNode lam = try_parse_lambda(p);
        if (lam != null) {
            return lam;
        }
    }
    if (t == IDENT) {
        Token tok = p_adv(p);
        if (p_at(p) == LBRACE && p.no_struct_lit == 0) {   // Name { ... } struct literal
            return p_pos(parse_struct_init(p, tok_text(p.src, tok)), tok);
        }
        return mk_ident(tok_text(p.src, tok));
    }
    if (t == LPAREN) {
        p_adv(p);
        *ExprNode e = parse_assignment(p);
        p_expect(p, RPAREN, "Expected ')'");
        return e;
    }
    p_fail(p, str_concat("Expected expression, got ", token_name(t)));
    return mk_lit(LIT_INT, "0");
}

// Postfix chain: template call Name<...>(args), template struct-init Name<...>{...},
// call (args), index [e], member .m, error-propagation ?.
*ExprNode parse_postfix(Parser* p) {
    *ExprNode e = parse_primary(p);
    while (1 == 1) {
        // Template call / template struct literal: ident '<' types '>' ( '(' | '{' ).
        // Speculative — restore on failure so a bare `<` is left for comparison.
        if (e.kind == EK_IDENT && p_at(p) == LT && p.failed == 0) {
            int save_pos = p.pos;
            int save_gt = p.pending_gt;
            p.spec = p.spec + 1;
            p_adv(p);                          // '<'
            // `a < b, c > (d)` reads as a call only when the callee is a known generic
            // (function, enum variant or type) or every argument can only be a type.
            int evident = 1;
            string sig = str_concat(e.sval, "<");
            string ta = parse_type(p);
            if (type_arg_evident(p, ta) == 0) {
                evident = 0;
            }
            sig = str_concat(sig, ta);
            while (p_at(p) == COMMA) {
                p_adv(p);
                sig = str_concat(sig, ",");
                ta = parse_type(p);
                if (type_arg_evident(p, ta) == 0) {
                    evident = 0;
                }
                sig = str_concat(sig, ta);
            }
            if (is_generic_name(e.sval) == 1 || is_type_name(p, e.sval) == 1) {
                evident = 1;
            }
            int matched = 0;
            if (evident == 1 && at_tclose(p) == 1) {
                consume_tclose(p);
                sig = str_concat(sig, ">");
                if (p_at(p) == LPAREN) {
                    p_adv(p);
                    *ExprNode tc = ast_new_expr();
                    tc.line = e.line;      // at the name (as the C++ parser)
                    tc.col = e.col;
                    tc.kind = EK_TEMPLATECALL;
                    tc.sval = sig;
                    List_init<*ExprNode>(&tc.kids, 4);
                    if (p_at(p) != RPAREN) {
                        List_push<*ExprNode>(&tc.kids, parse_expr(p));
                        while (p_at(p) == COMMA) {
                            p_adv(p);
                            List_push<*ExprNode>(&tc.kids, parse_expr(p));
                        }
                    }
                    p_expect(p, RPAREN, "Expected ')'");
                    p.last_call_close = p.pos;
                    e = tc;
                    matched = 1;
                } else if (p_at(p) == LBRACE) {
                    e = parse_struct_init(p, sig);   // Name<...> { ... }
                    matched = 1;
                }
            }
            p.spec = p.spec - 1;
            if (matched == 1 && p.failed == 0) {
                continue;
            }
            p.failed = 0;
            p.pos = save_pos;                  // not a template — back out
            p.pending_gt = save_gt;
        }
        int t = p_at(p);
        if (t == LPAREN) {
            p_adv(p);
            *ExprNode c = ast_new_expr();
            c.kind = EK_CALL;
            c.a = e;
            List_init<*ExprNode>(&c.kids, 4);
            Token first_arg = p_peek(p);
            if (p_at(p) != RPAREN) {
                List_push<*ExprNode>(&c.kids, parse_expr(p));
                while (p_at(p) == COMMA) {
                    p_adv(p);
                    List_push<*ExprNode>(&c.kids, parse_expr(p));
                }
            }
            Token close_tok = p_peek(p);
            p_expect(p, RPAREN, "Expected ')'");
            p.last_call_close = p.pos;
            if (e.kind == EK_IDENT && List_len<*ExprNode>(&c.kids) == 1 && str_eq(e.sval, "dbg") == 1) {
                c.dbg_text = p_source_span(p, first_arg, close_tok);
            }
            e = c;
        } else if (t == LBRACKET) {
            p_adv(p);
            *ExprNode ix = ast_new_expr();
            ix.kind = EK_INDEX;
            ix.a = e;
            ix.b = parse_expr(p);
            List_init<*ExprNode>(&ix.kids, 1);
            if (p_at(p) == RANGE) {            // base[lo..hi] slice expression
                p_adv(p);
                List_push<*ExprNode>(&ix.kids, parse_expr(p));   // hi bound
            }
            p_expect(p, RBRACKET, "Expected ']'");
            e = ix;
        } else if (t == DOT) {
            Token dt = p_adv(p);
            Token m = p_peek(p);
            if (m.type <= UINT64) {
                p_adv(p);
            } else {
                m = p_expect_ident(p, "Expected member name");
            }
            *ExprNode mb = p_pos(ast_new_expr(), dt);
            mb.kind = EK_MEMBER;
            mb.a = e;
            mb.sval = tok_text(p.src, m);
            mb.mline = m.line;
            mb.mcol = m.col;
            e = mb;
        } else if (t == QUESTION && ternary_colon_ahead(p) == 0) {
            // Postfix propagation `expr?` — only when this `?` doesn't open a ternary.
            p_adv(p);
            *ExprNode q = ast_new_expr();
            q.kind = EK_QUESTION;
            q.a = e;
            e = q;
        } else if (t == PLUS_PLUS || t == MINUS_MINUS) {
            p_adv(p);
            *ExprNode id = ast_new_expr();
            id.kind = EK_INCDEC;
            id.a = e;
            if (t == PLUS_PLUS) {
                id.sval = "post++";
            } else {
                id.sval = "post--";
            }
            e = id;
        } else {
            return e;
        }
    }
    return e;
}

// At `(` followed by `*`: does it open a cast (mirrors Parser::starParenIsCast)?
// `(*T)x` is a cast; `(*p)`, `(*p) - 1`, `(*p)++`, `(*sp).a`, `(*pf)(x)` dereference.
int star_paren_is_cast(Parser* p) {
    int k = 1;
    while (p_peek_k(p, k).type == STAR) {
        k = k + 1;
    }
    if (p_peek_k(p, k).type != IDENT || p_peek_k(p, k + 1).type != RPAREN) {
        return 1;
    }
    if (is_type_name(p, tok_text(p.src, p_peek_k(p, k))) == 1) {
        return 1;
    }
    int f = p_peek_k(p, k + 2).type;
    if (f == IDENT || f == INT_LIT || f == FLOAT_LIT || f == STRING_LIT || f == CHAR_LIT
        || f == TRUE || f == FALSE || f == NULL_KW || f == NOT || f == TILDE
        || f == SIZEOF) {
        return 1;
    }
    return 0;
}

*ExprNode parse_unary_inner(Parser* p);
*ExprNode parse_unary(Parser* p) {
    p_nest_enter(p);
    *ExprNode r = parse_unary_inner(p);
    p.nest = p.nest - 1;
    return r;
}

*ExprNode parse_unary_inner(Parser* p) {
    // A lambda whose return type is a struct, pointer or generic type. Not in a
    // match subject, where `f() {` is the call and the match body.
    // At the start of a statement that may end in a block, `Name(...) {` is a call with a
    // block, not a lambda returning `Name` (whose value the statement drops).
    if ((p.no_struct_lit == 0 || is_type_kw(p_at(p)) == 1) && p.failed == 0 && lambda_ahead(p) == 1 &&
        !(p.trailing_start == p.pos + 1 && p_at(p) == IDENT)) {
        *ExprNode lam = try_parse_lambda(p);
        if (lam != null) {
            return lam;
        }
    }
    // await E — prefix, binds like a unary operator.
    if (p_at(p) == AWAIT) {
        Token awt = p_adv(p);
        *ExprNode e = p_pos(ast_new_expr(), awt);
        e.kind = EK_AWAIT;
        e.a = parse_unary(p);
        return e;
    }
    // Fold -<int|float literal> into a negative literal (matches the C++).
    if (p_at(p) == MINUS) {
        int nt = p_peek2(p).type;
        if (nt == INT_LIT || nt == FLOAT_LIT) {
            Token mt = p_adv(p);            // '-'
            Token num = p_adv(p);
            int lk = LIT_INT;
            if (nt == FLOAT_LIT) {
                lk = LIT_FLOAT;
            }
            *uint8 raw = p.src;
            // build "-" + lexeme
            *uint8 buf = alloc<uint8>(num.len + 2);
            buf[0] = 45;                    // '-'
            int i = 0;
            while (i < num.len) {
                buf[1 + i] = raw[num.start + i];
                i = i + 1;
            }
            buf[num.len + 1] = 0;
            return p_pos(mk_lit(lk, (string)buf), mt);
        }
    }
    int t = p_at(p);
    if (t == PLUS_PLUS || t == MINUS_MINUS) {        // prefix ++x / --x
        p_adv(p);
        *ExprNode e = ast_new_expr();
        e.kind = EK_INCDEC;
        e.a = parse_unary(p);
        if (t == PLUS_PLUS) {
            e.sval = "pre++";
        } else {
            e.sval = "pre--";
        }
        return e;
    }
    if (t == NOT || t == MINUS || t == PLUS || t == AMPERSAND || t == STAR || t == TILDE) {
        Token opt = p_adv(p);
        return p_pos(mk_un(op_str(t), parse_unary(p)), opt);
    }
    // Cast (TYPE) expr — on a type keyword, a '*'-led type, or a declared type name.
    if (t == LPAREN) {
        Token i2 = p_peek2(p);
        int inner = i2.type;
        int is_cast = 0;
        if (is_type_kw(inner) == 1) {
            is_cast = 1;
        }
        else if (inner == STAR) {
            is_cast = star_paren_is_cast(p);
        }
        else if (inner == IDENT && is_type_name(p, tok_text(p.src, i2)) == 1
                 && is_local_var(tok_text(p.src, i2)) == 0) {   // unless a local shadows it
            is_cast = 1;
        }
        if (is_cast == 1 && p.failed == 0) {
            // Speculative: `(Type)operand` is a cast, but `(Type { ... })` is a
            // parenthesized struct literal — distinguished by what follows the type. Parse
            // the type and require a closing `)`; otherwise back out and let parse_postfix
            // handle the parenthesized expression (e.g. `(P{ … }).field`).
            int save = p.pos;
            int savegt = p.pending_gt;
            p.spec = p.spec + 1;
            Token lpt = p_peek(p);
            p_expect(p, LPAREN, "Expected '('");
            string cty = parse_type(p);
            p.spec = p.spec - 1;
            if (p.failed == 0 && p_at(p) == RPAREN) {
                p_expect(p, RPAREN, "Expected ')'");
                return p_pos(mk_cast(cty, parse_unary(p)), lpt);
            }
            p.failed = 0;
            p.pos = save;   // not a cast
            p.pending_gt = savegt;
        }
    }
    return parse_postfix(p);
}

// Binding strength of a binary operator token, loosest first (0: not a binary
// operator): || < && < | < ^ < & < == != < relational < shifts < + - < * / %.
int bin_prec(int t) {
    if (t == OR) {
        return 1;
    }
    if (t == AND) {
        return 2;
    }
    if (t == PIPE) {
        return 3;
    }
    if (t == CARET) {
        return 4;
    }
    if (t == AMPERSAND) {
        return 5;
    }
    if (t == EQEQ || t == NE) {
        return 6;
    }
    if (t == LT || t == GT || t == LE || t == GE) {
        return 7;
    }
    if (t == LSHIFT || t == RSHIFT) {
        return 8;
    }
    if (t == PLUS || t == MINUS) {
        return 9;
    }
    if (t == STAR || t == SLASH || t == PERCENT) {
        return 10;
    }
    return 0;
}

// Binary operators by precedence climbing (mirrors the C++ parseBinary): a unary
// operand, then every operator binding at least `min_prec`. Same-precedence operators
// fold in the loop, so a long `a + b + c ...` chain costs no recursion; a tighter
// operator on the right recurses at most once per precedence level.
*ExprNode parse_binary(Parser* p, int min_prec) {
    *ExprNode e = parse_unary(p);
    while (true) {
        int t = p_at(p);
        int prec = bin_prec(t);
        if (prec == 0 || prec < min_prec) {
            return e;
        }
        Token opt = p_adv(p);
        *ExprNode rhs = parse_binary(p, prec + 1);
        e = p_pos(mk_bin(op_str(t), e, rhs), opt);
    }
    return e;
}

// True if the `?` at the current position opens a ternary (a matching `:` follows at
// the same bracket nesting before a terminator) rather than postfix propagation.
// The answer for every start position is computed once, right to left (a group is
// skipped by jumping to its closing bracket), so nested ternaries cost linear time
// rather than a rescan per `?` (mirrors Parser::ternaryColonAhead).
int tca_open(int t) {
    if (t == LPAREN || t == LBRACKET || t == LBRACE) {
        return 1;
    }
    return 0;
}

int tca_close(int t) {
    if (t == RPAREN || t == RBRACKET || t == RBRACE) {
        return 1;
    }
    return 0;
}

void tca_build(Parser* p) {
    int n = List_len<Token>(&p.toks);
    List<int> closer;
    List_init<int>(&closer, n + 1);
    List<int> open;
    List_init<int>(&open, 16);
    int i = 0;
    while (i < n) {
        List_push<int>(&closer, n);
        int t = List_get<Token>(&p.toks, i).type;
        if (tca_open(t) == 1) {
            List_push<int>(&open, i);
        }
        else if (tca_close(t) == 1 && List_len<int>(&open) > 0) {
            int o = List_get<int>(&open, List_len<int>(&open) - 1);
            List_remove<int>(&open, List_len<int>(&open) - 1);
            List_set<int>(&closer, o, i);
        }
        i = i + 1;
    }
    List_init<int>(&p.tca, n + 1);
    i = 0;
    while (i <= n) {
        List_push<int>(&p.tca, 0);
        i = i + 1;
    }
    i = n - 1;
    while (i >= 0) {
        int t = List_get<Token>(&p.toks, i).type;
        int r = 0;
        if (tca_open(t) == 1) {
            int c = List_get<int>(&closer, i);
            if (c < n) {
                r = List_get<int>(&p.tca, c + 1);
            }
        }
        else if (tca_close(t) == 1) {        // closed the enclosing group before any ':'
            r = 0;
        }
        else if (t == COLON) {
            r = 1;
        }
        else if (t == SEMICOLON || t == COMMA || t == EOF_TOKEN) {
            r = 0;
        }
        else {
            r = List_get<int>(&p.tca, i + 1);
        }
        List_set<int>(&p.tca, i, r);
        i = i - 1;
    }
    List_free<int>(&closer);
    List_free<int>(&open);
    p.tca_done = 1;
}

int ternary_colon_ahead(Parser* p) {
    if (p.tca_done == 0) {
        tca_build(p);
    }
    if (p.pos + 1 < List_len<int>(&p.tca)) {
        return List_get<int>(&p.tca, p.pos + 1);
    }
    return 0;
}

*ExprNode parse_ternary_inner(Parser* p);
*ExprNode parse_ternary(Parser* p) {
    p_nest_enter(p);
    *ExprNode r = parse_ternary_inner(p);
    p.nest = p.nest - 1;
    return r;
}

*ExprNode parse_ternary_inner(Parser* p) {
    *ExprNode cond = parse_binary(p, 1);
    if (p_at(p) == QUESTION && ternary_colon_ahead(p) == 1) {
        Token qt = p_adv(p);                           // '?'
        *ExprNode thenE = parse_assignment(p);         // then-arm: a full expression
        p_expect(p, COLON, "Expected ':'");
        *ExprNode elseE = parse_ternary(p);            // else-arm: right-associative
        *ExprNode t = p_pos(ast_new_expr(), qt);
        t.kind = EK_TERNARY;
        t.a = cond;
        t.b = thenE;
        List_init<*ExprNode>(&t.kids, 1);
        List_push<*ExprNode>(&t.kids, elseE);
        return t;
    }
    return cond;
}

*ExprNode parse_assignment_inner(Parser* p);
*ExprNode parse_assignment(Parser* p) {
    p_nest_enter(p);
    *ExprNode r = parse_assignment_inner(p);
    p.nest = p.nest - 1;
    return r;
}

*ExprNode parse_assignment_inner(Parser* p) {
    *ExprNode left = parse_ternary(p);
    int t = p_at(p);
    if (is_compound(t) == 1) {
        string base = compound_base(t);
        Token opt = p_adv(p);
        *ExprNode rhs = parse_assignment(p);
        return p_pos(mk_bin("=", left, p_pos(mk_bin(base, left, rhs), opt)), opt);
    }
    if (t == EQ) {
        Token opt = p_adv(p);
        return p_pos(mk_bin("=", left, parse_assignment(p)), opt);
    }
    return left;
}

*ExprNode parse_expr(Parser* p) {
    return parse_assignment(p);
}

// ── Statements ────────────────────────────────────────────────────────────────

// Stamp statement `s` with token `t`'s position (the token the C++ parser uses).
*StmtNode p_spos(*StmtNode s, Token t) {
    if (s != null) {
        s.line = t.line;
        s.col = t.col;
    }
    return s;
}

*StmtNode mk_simple(int kind) {
    *StmtNode s = ast_new_stmt();
    s.kind = kind;
    return s;
}

*StmtNode mk_vardecl(string nm, string ty, *ExprNode init, int is_const) {
    *StmtNode s = ast_new_stmt();
    s.kind = SK_VARDECL;
    s.name = nm;
    s.type = ty;
    s.expr = init;
    s.is_const = is_const;
    s.is_static = 0;
    return s;
}

// Is `t` a value-const type — a leading `const ` with no pointer (mirrors the C++
// finalizeVar rule)? Such a binding is read-only; pointee-const (`const int*`) is not.
int is_value_const(string t) {
    if (t[0] != 99 || t[1] != 111 || t[2] != 110 || t[3] != 115
        || t[4] != 116 || t[5] != 32) {     // not "const "
        return 0;
    }
    int i = 6;
    while (t[i] != 0) {   // 42 = '*'
        if (t[i] == 42) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

*StmtNode wrap_block(*StmtNode inner) {        // a BlockStmt holding one item
    *StmtNode b = ast_new_stmt();
    b.kind = SK_BLOCK;
    List_init<*StmtNode>(&b.items, 1);
    List_push<*StmtNode>(&b.items, inner);
    return b;
}

// finalizeVar's stored type: drop binding-only const into the (un-printed) flag.
// (1) `*const` -> `*` (a const *pointer*); (2) a leading `const ` -> dropped, but
// only when the type is value-const (no `*` — pointee-const stays in the type).
string strip_binding_const(string t) {
    int n = cstr_len(t);
    *uint8 buf = alloc<uint8>(n + 1);
    int w = 0;
    int i = 0;
    while (i < n) {
        if (t[i] == 42 && i + 5 < n && t[i+1] == 99 && t[i+2] == 111
            && t[i+3] == 110 && t[i+4] == 115 && t[i+5] == 116) {   // "*const"
            buf[w] = 42;        // keep '*'
            w = w + 1;
            i = i + 6;                     // skip "*const"
        } else {
            buf[w] = (uint8)t[i];
            w = w + 1;
            i = i + 1;
        }
    }
    buf[w] = 0;
    // value-const leading strip, only if there is no pointer in the result.
    int has_star = 0;
    int k = 0;
    while (k < w) {
        if (buf[k] == 42) {
            has_star = 1;
        }
        k = k + 1;
    }
    if (has_star == 0 && w >= 6 && buf[0] == 99 && buf[1] == 111 && buf[2] == 110
        && buf[3] == 115 && buf[4] == 116 && buf[5] == 32) {        // "const "
        *uint8 b2 = alloc<uint8>(w - 6 + 1);
        int j = 6;
        while (j < w) {
            b2[j - 6] = buf[j];
            j = j + 1;
        }
        b2[w - 6] = 0;
        return (string)b2;
    }
    return (string)buf;
}

*StmtNode parse_return(Parser* p) {
    p_adv(p);                              // 'return'
    *StmtNode s = ast_new_stmt();
    s.kind = SK_RETURN;
    s.expr = null;
    if (p_at(p) != SEMICOLON) {
        s.expr = parse_expr(p);
    }
    p_reject_trailing(p);
    p_expect(p, SEMICOLON, "Expected ';'");
    return s;
}

// A `{` right after a call's ')' where no trailing block is allowed: a located error.
void p_reject_trailing(Parser* p) {
    if (p_at(p) == LBRACE && p.last_call_close != 0 && p.last_call_close == p.pos) {
        p_fail(p, "a trailing block is only allowed on a call statement");
    }
}

// `trailing`: a call statement may end in a block, passed as its last argument (a
// `void()` lambda): f(a) { BODY } is f(a, void() { BODY }). Only the statement path
// allows it, not a `for` header.
*StmtNode parse_expr_stmt(Parser* p, int trailing) {
    Token st0 = p_peek(p);
    int saved_start = p.trailing_start;
    p.trailing_start = trailing == 1 ? p.pos + 1 : 0;
    *ExprNode e = parse_expr(p);
    p.trailing_start = saved_start;
    if (p_at(p) == LBRACE) {
        if (trailing == 0) {
            p_reject_trailing(p);
        }
        Token brace = p_peek(p);
        int closed = p.last_call_close != 0 && p.last_call_close == p.pos;
        if (e.kind != EK_CALL && e.kind != EK_TEMPLATECALL) {
            p_fail(p, "a trailing block must follow a call");
        } else if (closed == 0) {
            p_fail(p, "a trailing block must follow the call's own ')', not parentheses around it");
        } else if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_CALL) {
            p_fail(p, "a trailing block cannot follow a call of what a call returns");
        }
        if (p.failed == 0 && p_at(p) == LBRACE) {
            *ExprNode lam = p_pos(ast_new_expr(), brace);
            lam.kind = EK_LAMBDA;
            lam.trailing = 1;
            lam.sval = lambda_sig("void", ast_new_decl());
            int lmark = local_mark();
            lam.stmt = parse_block(p);
            local_pop(lmark);
            List_push<*ExprNode>(&e.kids, lam);
            // One ';' after the block is accepted (lambdas are written `};`).
            if (p_at(p) == SEMICOLON) {
                p_adv(p);
            }
        }
        *StmtNode ts = p_spos(ast_new_stmt(), st0);
        ts.kind = SK_EXPR;
        ts.expr = e;
        return ts;
    }
    p_expect(p, SEMICOLON, "Expected ';'");
    *StmtNode s = p_spos(ast_new_stmt(), st0);
    s.kind = SK_EXPR;
    s.expr = e;
    return s;
}

// An `else if` chain is parsed with a loop (mirrors the C++ parseIfStatement): each
// `else if` becomes the else branch of the one before, and still counts one nesting
// level, since the chain is nested in the AST.
*StmtNode parse_if(Parser* p) {
    int saved = p.nest;
    *StmtNode head = null;
    *StmtNode tail = null;
    while (true) {
        Token ift = p_adv(p);                  // 'if'
        p_expect(p, LPAREN, "Expected '('");
        *ExprNode cond = parse_expr(p);
        p_expect(p, RPAREN, "Expected ')'");
        *StmtNode s = p_spos(ast_new_stmt(), ift);
        s.kind = SK_IF;         // alloc zeroes, so s.s2 (optional else) is null
        s.expr = cond;
        s.s1 = parse_stmt(p);                  // then
        if (tail == null) {
            head = s;
        } else {
            tail.s2 = s;
        }
        tail = s;
        if (p_at(p) != ELSE) {
            break;
        }
        p_adv(p);
        if (p_at(p) != IF) {
            s.s2 = parse_stmt(p);
            break;
        }
        p_nest_enter(p);
    }
    p.nest = saved;
    return head;
}

*StmtNode parse_while(Parser* p) {
    Token wt = p_peek(p);
    p_expect(p, WHILE, "Expected 'while'");
    p_expect(p, LPAREN, "Expected '('");
    *ExprNode cond = parse_expr(p);
    p_expect(p, RPAREN, "Expected ')'");
    *StmtNode s = p_spos(ast_new_stmt(), wt);
    s.kind = SK_WHILE;
    s.expr = cond;
    s.s1 = parse_stmt(p);
    return s;
}

*StmtNode parse_do(Parser* p) {
    Token dt = p_adv(p);                   // 'do'
    *StmtNode body = parse_stmt(p);
    p_expect(p, WHILE, "Expected 'while'");
    p_expect(p, LPAREN, "Expected '('");
    *ExprNode cond = parse_expr(p);
    p_expect(p, RPAREN, "Expected ')'");
    p_expect(p, SEMICOLON, "Expected ';'");
    *StmtNode s = p_spos(ast_new_stmt(), dt);
    s.kind = SK_DOWHILE;
    s.s1 = body;
    s.expr = cond;
    return s;
}

// ── Name collection (mirrors the C++ astwalk::collectNames / freshName) ──
// Every name spelled in a subtree: identifiers, declared locals, lambda/arm/catch
// binders (read from their signature text), and member names. A pass that synthesizes
// a local (a range bound, the async frame pointer) picks a name outside this set.
int names_has(List<string>* l, string nm) {
    int i = 0;
    while (i < List_len<string>(l)) {
        if (str_eq(List_get<string>(l, i), nm) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

void names_add_text(string t, List<string>* out) {
    if (t == null) {
        return;
    }
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            int st = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            string id = p_sub(t, st, i);
            if (names_has(out, id) == 0) {
                List_push<string>(out, id);
            }
        } else {
            i = i + 1;
        }
    }
}

void collect_names_s(*StmtNode s, List<string>* out);
// The first child (`a`, and an `else` branch `s2`) is followed with a loop, so a long
// operator chain or `else if` chain costs no recursion (the set of names is the same).
void collect_names_e(*ExprNode e, List<string>* out) {
    while (e != null) {
        if (e.kind == EK_IDENT || e.kind == EK_MEMBER || e.kind == EK_SIZEOF || e.kind == EK_LAMBDA) {
            names_add_text(e.sval, out);
        }
        collect_names_e(e.b, out);
        int i = 0;
        while (i < List_len<*ExprNode>(&e.kids)) {
            collect_names_e(List_get<*ExprNode>(&e.kids, i), out);
            i = i + 1;
        }
        if (e.kind == EK_LAMBDA) {
            collect_names_s(e.stmt, out);
        }
        e = e.a;
    }
}

void collect_names_s(*StmtNode s, List<string>* out) {
    while (s != null) {
        names_add_text(s.name, out);
        collect_names_e(s.expr, out);
        collect_names_e(s.expr2, out);
        collect_names_s(s.s1, out);
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            collect_names_s(List_get<*StmtNode>(&s.items, i), out);
            i = i + 1;
        }
        s = s.s2;
    }
}

// Whether `e` reads the name `nm` (an identifier or `sizeof(nm)`; a lambda body counts
// when it spells the name anywhere). Member names are not reads. Mirrors the C++
// astwalk::referencesName.
int refs_name_e(*ExprNode e, string nm) {
    while (e != null) {
        if ((e.kind == EK_IDENT || e.kind == EK_SIZEOF) && str_eq(e.sval, nm) == 1) {
            return 1;
        }
        if (e.kind == EK_LAMBDA) {
            List<string> ln;
            List_init<string>(&ln, 8);
            collect_names_s(e.stmt, &ln);
            return names_has(&ln, nm);
        }
        if (refs_name_e(e.b, nm) == 1) {
            return 1;
        }
        int i = 0;
        while (i < List_len<*ExprNode>(&e.kids)) {
            if (refs_name_e(List_get<*ExprNode>(&e.kids, i), nm) == 1) {
                return 1;
            }
            i = i + 1;
        }
        e = e.a;
    }
    return 0;
}

// `base` if it is not in `used`, else the first free `base_1`, `base_2`, ...; the chosen
// name is added to `used`.
string fresh_name(string base, List<string>* used) {
    string nm = base;
    int k = 1;
    while (names_has(used, nm) == 1) {
        nm = str_concat(base, str_concat("_", int_to_str(k)));
        k = k + 1;
    }
    List_push<string>(used, nm);
    return nm;
}

// `for (x in A..B)` desugars (at parse time, like the C++) into a counted ForStmt:
//   for (int x = A, __end_x = B; x < __end_x; x = x + 1) body
// so the bound B is evaluated once, before the first iteration.
// The bound's name is fresh against every name in the loop, so a user `__end_x` read in
// the body (or the bound) still means the user's variable.
*StmtNode desugar_range(string var, *ExprNode lo, *ExprNode hi, *StmtNode body) {
    *StmtNode s = ast_new_stmt();
    s.kind = SK_FOR;
    List<string> used;
    List_init<string>(&used, 8);
    List_push<string>(&used, var);
    collect_names_e(lo, &used);
    collect_names_e(hi, &used);
    collect_names_s(body, &used);
    string endn = fresh_name(str_concat("__end_", var), &used);
    // Spelled `int` here; sema retypes both to the bounds' common integer type (is_range).
    *StmtNode lod = mk_vardecl(var, "int", lo, 0);
    lod.is_range = 1;
    *StmtNode hid = mk_vardecl(endn, "int", hi, 0);
    hid.is_range = 1;
    // Both bounds are read in the enclosing scope: a B naming the loop variable
    // (`for (i in 0..i)`) means the OUTER `i`, so the bound is declared first then.
    *StmtNode init = null;
    if (refs_name_e(hi, var) == 1) {
        init = wrap_block(hid);
        List_push<*StmtNode>(&init.items, lod);
    }
    else {
        init = wrap_block(lod);
        List_push<*StmtNode>(&init.items, hid);
    }
    s.s1 = init;
    s.expr = mk_bin("<", mk_ident(var), mk_ident(endn));
    s.expr2 = mk_bin("=", mk_ident(var), mk_bin("+", mk_ident(var), mk_lit(LIT_INT, "1")));
    s.s2 = body;
    return s;
}

*StmtNode parse_for(Parser* p) {
    Token ft = p_adv(p);                   // 'for'
    p_expect(p, LPAREN, "Expected '('");

    // for-in: `IDENT in iterable` (or a range `A..B`)
    if (p_at(p) == IDENT && p_peek2(p).type == IN) {
        Token vt = p_peek(p);
        string var = tok_text(p.src, vt);   // x
        p_adv(p);
        p_expect(p, IN, "Expected 'in'");
        *ExprNode first = parse_expr(p);
        if (p_at(p) == RANGE) {
            p_expect(p, RANGE, "Expected '..'");
            *ExprNode hi = parse_expr(p);
            p_expect(p, RPAREN, "Expected ')'");
            *StmtNode rs = desugar_range(var, first, hi, parse_stmt(p));
            p_spos(rs, vt);                // at the loop variable (as the C++ parser)
            if (rs.s1 != null) {
                int ri = 0;
                while (ri < List_len<*StmtNode>(&rs.s1.items)) {
                    p_spos(List_get<*StmtNode>(&rs.s1.items, ri), vt);
                    ri = ri + 1;
                }
            }
            return rs;
        }
        p_expect(p, RPAREN, "Expected ')'");
        *StmtNode s = p_spos(ast_new_stmt(), vt);
        s.kind = SK_FORIN;
        s.name = var;
        s.expr = first;
        s.s1 = parse_stmt(p);
        s.resolved_elem = "";              // sema stamps this; "" until then (and on the no-sema path)
        return s;
    }

    // C-style for (init; cond; step) body
    *StmtNode init = null;
    if (p_at(p) != SEMICOLON) {
        int save = p.pos;
        *StmtNode d = spec_var_decl(p);
        if (d != null) {     // decl consumes its own ';'
            List_push<string>(&g_localvars, d.name);
            init = wrap_block(d);
        }
        else {
            p.pos = save;
            init = parse_expr_stmt(p, 0);
        }
    } else {
        p_expect(p, SEMICOLON, "Expected ';'");
    }
    *ExprNode cond = null;
    if (p_at(p) != SEMICOLON) {
        cond = parse_expr(p);
    }
    p_expect(p, SEMICOLON, "Expected ';'");
    *ExprNode step = null;
    if (p_at(p) != RPAREN) {
        step = parse_expr(p);
    }
    p_expect(p, RPAREN, "Expected ')'");
    *StmtNode s = p_spos(ast_new_stmt(), ft);
    s.kind = SK_FOR;
    s.s1 = init;
    s.expr = cond;
    s.expr2 = step;
    s.s2 = parse_stmt(p);
    return s;
}

// Optional leading qualifiers, then a let- or typed local var-decl; returns null
// (caller restores pos) if the tokens aren't actually a declaration.
// A name is expected here. If the next token is instead a reserved keyword
// (fn/in/match/type names/...), report it at the cause rather than letting it
// surface far downstream. Mirrors the C++ parser's "expected a name, found keyword
// 'fn'" diagnostic. Keyword TokenTypes are the contiguous [LET, UINT64] range.
void check_name_not_keyword(Parser* p) {
    int t = p_at(p);
    if (t >= LET && t <= UINT64) {
        p_fail(p, str_concat(str_concat("expected a name, found keyword '", tok_text(p.src, p_peek(p))), "'"));
    }
}

*StmtNode try_var_decl(Parser* p) {
    int save = p.pos;
    int is_const = 0;
    int is_static = 0;
    int is_vol = 0;
    while (p_at(p) == VOLATILE || p_at(p) == STATIC) {
        if (p_at(p) == STATIC) {
            is_static = 1;
        } else {
            is_vol = 1;
        }
        p_adv(p);
    }
    if (p_at(p) == CONST) {                          // const-let binding (const before let)
        int k = 1;
        if (p_peek_k(p, 1).type == VOLATILE) {
            k = 2;
        }
        if (p_peek_k(p, k).type == LET) {
            is_const = 1;
            p_adv(p);
        }
    }
    while (p_at(p) == VOLATILE || p_at(p) == STATIC) {
        if (p_at(p) == STATIC) {
            is_static = 1;
        } else {
            is_vol = 1;
        }
        p_adv(p);
    }
    if (p_at(p) == LET) {
        p_adv(p);
        check_name_not_keyword(p);
        if (p_at(p) != IDENT) {
            p.pos = save;
            return null;
        }
        Token lnt = p_peek(p);
        string nm = tok_text(p.src, lnt);
        p_adv(p);
        if (p_at(p) != COLON) {
            p.pos = save;
            return null;
        }
        p_adv(p);
        string raw = parse_type(p);
        if (is_value_const(raw) == 1) {
            is_const = 1;
        }
        string ty = strip_binding_const(raw);
        *ExprNode init = null;
        if (p_at(p) == EQ) {
            p_adv(p);
            init = parse_expr(p);
            p_reject_trailing(p);
        }
        if (p_at(p) != SEMICOLON) {
            p_fail(p, "Expected ';' after variable declaration");
            return null;
        }
        p_adv(p);
        *StmtNode d = p_spos(mk_vardecl(nm, ty, init, is_const), lnt);
        d.is_static = is_static;
        d.is_vol = is_vol;
        return d;
    }
    // typed: Type name [= expr] ;
    string raw = parse_type(p);
    if (is_value_const(raw) == 1) {
        is_const = 1;
    }
    string ty = strip_binding_const(raw);
    check_name_not_keyword(p);
    if (p_at(p) != IDENT) {
        p.pos = save;
        return null;
    }
    Token tnt = p_peek(p);
    string nm = tok_text(p.src, tnt);
    p_adv(p);
    if (p_at(p) == LBRACKET) {             // C-style `int a[3];`: arrays are `int[3] a`
        p_fail(p, str_concat("Expected declaration, got ", token_name(p_at(p))));
        return null;
    }
    if (p_at(p) == EQ) {
        p_adv(p);
        *ExprNode init = parse_expr(p);
        p_reject_trailing(p);
        if (p_at(p) != SEMICOLON) {
            p_fail(p, "Expected ';'");
            return null;
        }
        p_adv(p);
        *StmtNode d = p_spos(mk_vardecl(nm, ty, init, is_const), tnt);
        d.is_static = is_static;
        d.is_vol = is_vol;
        return d;
    }
    if (p_at(p) == SEMICOLON) {
        p_adv(p);
        *StmtNode d = p_spos(mk_vardecl(nm, ty, null, is_const), tnt);
        d.is_static = is_static;
        d.is_vol = is_vol;
        return d;
    }
    p.pos = save;
    return null;
}

// try_var_decl run speculatively: a syntax error inside it backs out (returns null)
// so the tokens are re-parsed as a statement, like the C++ block-item fallback.
*StmtNode spec_var_decl(Parser* p) {
    if (p.failed == 1) {
        return null;
    }
    int save = p.pos;
    int savegt = p.pending_gt;
    p.spec = p.spec + 1;
    *StmtNode d = try_var_decl(p);
    p.spec = p.spec - 1;
    if (p.failed == 1) {
        p.failed = 0;
        p.pos = save;
        p.pending_gt = savegt;
        // Only a leading name or `*` can also begin a statement; any other decl start
        // (a type keyword, let, const, ...) is unambiguous, so re-parse it for real and
        // report its error where it happens (mirrors the C++ rethrow).
        int st = p_at(p);
        if (st != IDENT && st != STAR) {
            return try_var_decl(p);
        }
        return null;
    }
    return d;
}

*StmtNode parse_switch(Parser* p) {
    Token swt = p_adv(p);                  // 'switch'
    p_expect(p, LPAREN, "Expected '('");
    *StmtNode s = p_spos(ast_new_stmt(), swt);
    s.kind = SK_SWITCH;
    s.expr = parse_expr(p);                // subject
    p_expect(p, RPAREN, "Expected ')'");
    p_expect(p, LBRACE, "Expected '{'");
    List_init<*StmtNode>(&s.items, 4);
    int mark = local_mark();               // a case's declaration reaches the end of the switch
    while (p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
        *StmtNode c = ast_new_stmt();
        c.kind = SK_CASE;
        c.expr = null;
        if (p_at(p) == CASE) {   // 'case' val ':'
            p_adv(p);
            c.expr = parse_expr(p);
            p_adv(p);
        }
        else if (p_at(p) == DEFAULT) {                   // 'default' ':'
            p_adv(p);
            p_adv(p);
        }
        else {
            break;
        }
        List_init<*StmtNode>(&c.items, 4);
        while (p_at(p) != CASE && p_at(p) != DEFAULT && p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
            List_push<*StmtNode>(&c.items, parse_block_item(p));
        }
        List_push<*StmtNode>(&s.items, c);
    }
    local_pop(mark);
    p_expect(p, RBRACE, "Expected '}'");
    return s;
}

*StmtNode parse_match(Parser* p) {
    Token mt = p_adv(p);                   // 'match'
    int saved = p.no_struct_lit;
    p.no_struct_lit = 1;                   // subject `Name { ... }` is the match body, not a literal
    *ExprNode subj = parse_expr(p);
    p.no_struct_lit = saved;
    p_expect(p, LBRACE, "Expected '{'");
    *StmtNode s = p_spos(ast_new_stmt(), mt);
    s.kind = SK_MATCH;
    s.expr = subj;
    List_init<*StmtNode>(&s.items, 4);
    while (p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
        Token cur = p_peek(p);
        string label;
        if (p_at(p) == IDENT && cur.len == 1 && (int)p.src[cur.start] == 95) {
            label = "_";         // default arm
            p_adv(p);
        } else {
            label = tok_text(p.src, p_expect_ident(p, "Expected variant name or '_'"));        // variant name
            if (p_at(p) == LPAREN) {                  // payload bindings
                p_adv(p);
                label = str_concat(label, "(");
                if (p_at(p) != RPAREN) {
                    label = str_concat(label, tok_text(p.src, p_expect_ident(p, "Expected binding name")));
                    while (p_at(p) == COMMA) {
                        p_adv(p);
                        label = str_concat(label, ", ");
                        label = str_concat(label, tok_text(p.src, p_expect_ident(p, "Expected binding name")));
                    }
                }
                p_expect(p, RPAREN, "Expected ')'");
                label = str_concat(label, ")");
            }
        }
        p_expect(p, ARROW, "Expected '->'");
        *StmtNode arm = ast_new_stmt();
        arm.kind = SK_ARM;
        arm.name = label;
        arm.s1 = parse_stmt(p);
        List_push<*StmtNode>(&s.items, arm);
    }
    p_expect(p, RBRACE, "Expected '}'");
    return s;
}

*StmtNode parse_try(Parser* p) {
    p_adv(p);                              // 'try'
    *StmtNode s = ast_new_stmt();
    s.kind = SK_TRY;
    s.s2 = null;                           // finally (optional)
    s.s1 = parse_block(p);                 // body
    List_init<*StmtNode>(&s.items, 2);
    while (p_at(p) == CATCH) {
        p_adv(p);                          // 'catch'
        p_expect(p, LPAREN, "Expected '('");
        string cty = parse_type(p);
        Token cnt = p_expect_ident(p, "Expected variable name in catch");
        string cnm = tok_text(p.src, cnt);   // exception variable name
        p_expect(p, RPAREN, "Expected ')'");
        *StmtNode cat = ast_new_stmt();
        cat.kind = SK_CATCH;
        cat.line = cnt.line;
        cat.col = cnt.col;
        cat.name = str_concat(str_concat(cty, " "), cnm);
        cat.s1 = parse_block(p);
        List_push<*StmtNode>(&s.items, cat);
    }
    if (p_at(p) == FINALLY) {
        p_adv(p);
        s.s2 = parse_block(p);
    }
    return s;
}

// One `"constraint"(expr), ...` list of asm operands (outputs or inputs) onto `items`.
void parse_asm_operands(Parser* p, List<*StmtNode>* items, int kind) {
    while (p_at(p) != RPAREN && p_at(p) != COLON && p_at(p) != EOF_TOKEN) {
        Token ct = p_adv(p);       // constraint string
        p_expect(p, LPAREN, "Expected '('");
        *StmtNode op = ast_new_stmt();
        op.kind = kind;
        int _dl1 = 0;
        op.name = tok_str_value(p.src, ct, &_dl1);
        op.expr = parse_expr(p);
        p_expect(p, RPAREN, "Expected ')'");
        List_push<*StmtNode>(items, op);
        if (p_at(p) == COMMA) {
            p_adv(p);
        } else {
            break;
        }
    }
}

*StmtNode parse_asm(Parser* p) {
    Token at = p_adv(p);                   // 'asm'
    p_expect(p, LPAREN, "Expected '('");
    *StmtNode s = p_spos(ast_new_stmt(), at);
    s.kind = SK_ASM;
    int _dl0 = 0;   // the asm string (decoded)
    s.name = tok_str_value(p.src, p_adv(p), &_dl0);
    List_init<*StmtNode>(&s.items, 2);
    if (p_at(p) == COLON) {                // outputs : inputs : clobbers
        p_adv(p);
        parse_asm_operands(p, &s.items, SK_ASMOUTPUT);
        if (p_at(p) == COLON) {
            p_adv(p);
            parse_asm_operands(p, &s.items, SK_ASMINPUT);
            if (p_at(p) == COLON) {        // clobbers: kept as `~{c},...` in s.type
                p_adv(p);
                s.type = "";
                while (p_at(p) != RPAREN && p_at(p) != EOF_TOKEN) {
                    int _dl2 = 0;
                    string cl = tok_str_value(p.src, p_adv(p), &_dl2);
                    if (s.type[0] != 0) {
                        s.type = str_concat(s.type, ",");
                    }
                    s.type = str_concat(s.type, str_concat("~{", str_concat(cl, "}")));
                    if (p_at(p) == COMMA) {
                        p_adv(p);
                    } else {
                        break;
                    }
                }
            }
        }
    }
    p_expect(p, RPAREN, "Expected ')'");
    p_expect(p, SEMICOLON, "Expected ';'");
    return s;
}

*StmtNode parse_stmt_inner(Parser* p);
*StmtNode parse_stmt(Parser* p) {
    p_nest_enter(p);
    *StmtNode r = parse_stmt_inner(p);
    p.nest = p.nest - 1;
    return r;
}

*StmtNode parse_stmt_inner(Parser* p) {
    int t = p_at(p);
    // Labeled loop: IDENT ':' <for|while|do>. Only a loop keyword after the ':' makes it a
    // label; a bare `IDENT:` has no other statement-level meaning.
    if (t == IDENT && p_peek2(p).type == COLON) {
        int after = p_peek_k(p, 2).type;
        if (after == FOR || after == WHILE || after == DO) {
            string lbl = tok_text(p.src, p_peek(p));   // IDENT text
            p_adv(p);                                   // IDENT
            p_expect(p, COLON, "Expected ':'");
            *StmtNode loop = null;
            if (p_at(p) == FOR) {
                loop = parse_for(p);
            }
            else if (p_at(p) == WHILE) {
                loop = parse_while(p);
            }
            else {
                loop = parse_do(p);
            }
            loop.label = lbl;
            return loop;
        }
    }
    if (t == LBRACE) {
        return parse_block(p);
    }
    if (t == IF) {
        return parse_if(p);
    }
    if (t == FOR) {
        return parse_for(p);
    }
    if (t == WHILE) {
        return parse_while(p);
    }
    if (t == DO) {
        return parse_do(p);
    }
    if (t == SWITCH) {
        return parse_switch(p);
    }
    if (t == MATCH) {
        return parse_match(p);
    }
    if (t == TRY) {
        return parse_try(p);
    }
    if (t == DEFER || t == ERRDEFER) {         // defer / errdefer stmt;  (run at scope exit)
        p_adv(p);
        *StmtNode s = ast_new_stmt();
        s.kind = SK_DEFER;
        s.s1 = parse_stmt(p);
        if (t == ERRDEFER) {
            s.is_err = 1;
        } else {
            s.is_err = 0;
        }
        return s;
    }
    if (t == ASM) {
        return parse_asm(p);
    }
    if (t == RETURN) {
        return parse_return(p);
    }
    if (t == BREAK) {
        Token kt = p_adv(p);                            // 'break'
        string lbl = "";
        if (p_at(p) == IDENT) {
            lbl = tok_text(p.src, p_peek(p));
            p_adv(p);
        }
        p_expect(p, SEMICOLON, "Expected ';'");
        *StmtNode s = p_spos(mk_simple(SK_BREAK), kt);
        s.label = lbl;
        return s;
    }
    if (t == CONTINUE) {
        Token kt = p_adv(p);                            // 'continue'
        string lbl = "";
        if (p_at(p) == IDENT) {
            lbl = tok_text(p.src, p_peek(p));
            p_adv(p);
        }
        p_expect(p, SEMICOLON, "Expected ';'");
        *StmtNode s = p_spos(mk_simple(SK_CONTINUE), kt);
        s.label = lbl;
        return s;
    }
    if (t == THROW) {
        p_adv(p);
        *StmtNode s = ast_new_stmt();
        s.kind = SK_THROW;
        s.expr = parse_expr(p);
        p_expect(p, SEMICOLON, "Expected ';'");
        return s;
    }
    if (t == THREAD_JOIN) {
        Token jt = p_adv(p);
        p_expect(p, LPAREN, "Expected '(' after thread_join");
        *StmtNode s = p_spos(ast_new_stmt(), jt);
        s.kind = SK_THREADJOIN;
        s.expr = parse_expr(p);
        p_expect(p, RPAREN, "Expected ')'");
        p_expect(p, SEMICOLON, "Expected ';'");
        return s;
    }
    return parse_expr_stmt(p, 1);
}

// A block item is a local declaration (let / typed) or a statement. For a decl-
// looking lead token, speculatively parse a var-decl and back out on failure.
*StmtNode parse_block_item(Parser* p) {
    int t = p_at(p);
    // `a * b;` with `a` a variable in scope is an expression (C), not a declaration.
    int local_times = 0;
    if (t == IDENT && p_peek2(p).type == STAR && is_local_var(tok_text(p.src, p_peek(p))) == 1) {
        local_times = 1;
    }
    if (local_times == 0 && (t == LET || t == CONST || t == VOLATILE || t == STATIC || t == STAR || t == IDENT
        || t == FN || t == QUESTION || is_type_kw(t) == 1)) {   // QUESTION: a `?*T` nullable decl
        int save = p.pos;
        *StmtNode d = spec_var_decl(p);
        if (d != null) {
            List_push<string>(&g_localvars, d.name);
            return d;
        }
        p.pos = save;
    }
    return parse_stmt(p);
}

*StmtNode parse_block(Parser* p) {
    Token lbt = p_peek(p);
    p_expect(p, LBRACE, "Expected '{'");
    *StmtNode b = p_spos(ast_new_stmt(), lbt);
    b.kind = SK_BLOCK;
    List_init<*StmtNode>(&b.items, 4);
    int mark = local_mark();
    while (p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
        if (p_at(p) == PRAGMA) {   // pack / link state, no item
            p_take_pragma(p);
        }
        else {
            List_push<*StmtNode>(&b.items, parse_block_item(p));
        }
    }
    local_pop(mark);
    p_expect(p, RBRACE, "Expected '}'");
    return b;
}

// ── Declarations ────────────────────────────────────────────────────────────

// Allocate a DeclNode. alloc zeroes, so the flag fields (is_async/is_mustuse/is_const/
// is_extern/is_packed/pack_align) start 0 and need no explicit init; the lists are still
// pre-sized here (a cap hint, and one central place to size the enrichment fields).
*DeclNode new_decl(int kind) {
    *DeclNode d = ast_new_decl();
    d.kind = kind;
    List_init<TypeParam>(&d.type_params, 2);
    List_init<*DeclNode>(&d.methods, 2);
    List_init<List<string>>(&d.payloads, 2);
    List_init<int>(&d.field_bits, 4);
    List_init<int>(&d.param_escaping, 4);
    return d;
}

// Parse an optional generic `<T, U: A + B>` list into `out` (captures names + their
// constraints; was previously skipped). `with_constraints` mirrors the C++ AST: fn/
// struct store constraints, but EnumDecl has no constraints field, so a generic enum
// CONSUMES `: A + B` without storing it (keeps the printers byte-identical). Empty if
// there's no `<`.
void parse_type_params(Parser* p, List<TypeParam>* out, int with_constraints) {
    if (p_at(p) != LT) {
        return;
    }
    p_adv(p);                              // '<'
    while (1 == 1) {
        let tp: TypeParam;
        tp.name = tok_text(p.src, p_expect_ident(p, "Expected type parameter name"));       // type-param name
        List_init<string>(&tp.constraints, 2);
        if (p_at(p) == COLON) {            // constraints `: A + B`
            p_adv(p);
            string c0 = tok_text(p.src, p_expect_ident(p, "Expected constraint interface name"));                  // first
            if (with_constraints == 1) {
                List_push<string>(&tp.constraints, c0);
            }
            while (p_at(p) == PLUS) {
                p_adv(p);
                string ck = tok_text(p.src, p_expect_ident(p, "Expected constraint interface name"));
                if (with_constraints == 1) {
                    List_push<string>(&tp.constraints, ck);
                }
            }
        }
        List_push<TypeParam>(out, tp);
        if (p_at(p) == COMMA) {
            p_adv(p);
        } else {
            break;
        }
    }
    consume_tclose(p);                     // '>' (or split '>>')
}

// Parameter list (mirror parseParameterList): `[escaping] Type name`, comma-
// separated, or a trailing `...` variadic. Fills d.params; leaves p at ')'.
// Set by a caller whose parameters may have default values (a function or method
// declaration); parse_params reads and clears it, so a lambda inside a default does not
// inherit it.
int g_allow_defaults;

void parse_params(Parser* p, *DeclNode d) {
    int allow = g_allow_defaults;
    g_allow_defaults = 0;
    List_init<Param>(&d.params, 4);
    List_init<int>(&d.param_escaping, 4);
    List_init<*ExprNode>(&d.param_defaults, 1);
    List_init<string>(&d.param_def_texts, 1);
    int any_def = 0;
    if (p_at(p) != RPAREN) {
        while (1 == 1) {
            if (p_at(p) == ELLIPSIS) {
                Token et = p_adv(p);
                let pm: Param;
                pm.ty = "...";
                pm.name = "...";
                pm.line = et.line;
                pm.col = et.col;
                List_push<Param>(&d.params, pm);
                List_push<int>(&d.param_escaping, 0);
                break;                     // variadic must be last
            }
            int esc = 0;
            if (p_at(p) == ESCAPING) {
                p_adv(p);
                esc = 1;
            }
            let pm: Param;
            pm.ty = parse_type(p);
            Token pnt = p_expect_ident(p, "Expected parameter name");
            pm.name = tok_text(p.src, pnt);
            pm.line = pnt.line;
            pm.col = pnt.col;
            List_push<Param>(&d.params, pm);
            List_push<int>(&d.param_escaping, esc);
            *ExprNode def = null;
            string def_text = "";
            if (p_at(p) == EQ) {
                if (allow == 0) {
                    p_fail(p, "a default value is allowed only on a function's parameter");
                    return;
                }
                p_adv(p);
                Token from = p_peek(p);
                def = parse_ternary(p);
                def_text = p_source_span(p, from, p_peek(p));
                any_def = 1;
            }
            List_push<*ExprNode>(&d.param_defaults, def);
            List_push<string>(&d.param_def_texts, def_text);
            if (p_at(p) == COMMA) {
                p_adv(p);
            } else {
                break;
            }
        }
    }
    if (any_def == 0) {
        List_init<*ExprNode>(&d.param_defaults, 1);
        List_init<string>(&d.param_def_texts, 1);
    }
}

// Read the operator token(s) after `operator`. Returns its spelling ("+","==","[]",...),
// or "" if not overloadable. `[]` is the two-token subscript.
string parse_operator_token(Parser* p) {
    int t = p_at(p);
    p_adv(p);
    if (t == PLUS) {
        return "+";
    }
    if (t == MINUS) {
        return "-";
    }
    if (t == STAR) {
        return "*";
    }
    if (t == SLASH) {
        return "/";
    }
    if (t == PERCENT) {
        return "%";
    }
    if (t == EQEQ) {
        return "==";
    }
    if (t == NE) {
        return "!=";
    }
    if (t == LT) {
        return "<";
    }
    if (t == GT) {
        return ">";
    }
    if (t == LE) {
        return "<=";
    }
    if (t == GE) {
        return ">=";
    }
    if (t == AMPERSAND) {
        return "&";
    }
    if (t == PIPE) {
        return "|";
    }
    if (t == CARET) {
        return "^";
    }
    if (t == LSHIFT) {
        return "<<";
    }
    if (t == RSHIFT) {
        return ">>";
    }
    if (t == NOT) {
        return "!";
    }
    if (t == TILDE) {
        return "~";
    }
    if (t == LBRACKET) {   // consume ']'
        p_adv(p);
        return "[]";
    }
    return "";
}

*DeclNode parse_function(Parser* p) {
    string rty = parse_type(p);            // return type (may be *T, List<T>, …)
    *DeclNode d = new_decl(DK_FUNCTION);
    d.ret_type = rty;
    string opsym = "";
    if (p_at(p) == OPERATOR) {             // `V3 operator +(V3 a, V3 b) { ... }`
        Token opkw = p_adv(p);
        d.line = opkw.line;
        d.col = opkw.col;
        Token optok = p_peek(p);
        opsym = parse_operator_token(p);
        if (opsym[0] == 0) {               // not an overloadable operator (mirrors the C++)
            if (p_at(p) == LPAREN) {
                p_report(p, optok, str_concat(str_concat("operator '", tok_text(p.src, optok)), "' cannot be overloaded"));
            }
            p_report(p, opkw, "expected a name, found keyword 'operator'");
        }
    } else {
        Token nm = p_expect_ident(p, "Expected function name");               // function name
        d.name = tok_text(p.src, nm);
        d.line = nm.line;  // diagnostics point at the name (as the C++ parser)
        d.col = nm.col;
        parse_type_params(p, &d.type_params, 1);   // optional <T, U: Iface>
        if (List_len<TypeParam>(&d.type_params) > 0) {
            List_push<string>(&g_genericnames, d.name);
        }
    }
    p_expect(p, LPAREN, "Expected '('");
    g_allow_defaults = 1;
    parse_params(p, d);                    // fills d.params, stops at ')'
    p_expect(p, RPAREN, "Expected ')'");
    if (opsym[0] != 0) {                   // build the canonical name from op + param types
        let ptys: List<string>;
        List_init<string>(&ptys, 4);
        int i = 0;
        int np = List_len<Param>(&d.params);
        while (i < np) {
            List_push<string>(&ptys, List_get<Param>(&d.params, i).ty);
            i = i + 1;
        }
        if (np == 1 && ast_streq(opsym, "-") == 1) {   // unary minus
            opsym = "u-";
        }
        d.name = ast_op_name(opsym, &ptys);
        d.operator_sym = opsym;
    }
    if (p_at(p) == LBRACE) {
        int mark = push_tparams(&d.type_params);
        int lmark = local_mark();
        local_push_params(d);
        d.body = parse_block(p);
        local_pop(lmark);
        pop_tparams(mark);
    }
    else {      // forward declaration: ';' (no body)
        d.body = null;
        p_adv(p);
    }
    return d;
}

// int -> decimal string (handles negatives; enum member values).
string int_to_str(int n) {
    if (n == 0) {
        return "0";
    }
    int neg = 0;
    if (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    *uint8 tmp = alloc<uint8>(16);
    int len = 0;
    while (n > 0) {
        tmp[len] = (uint8)(48 + (n % 10));
        n = n / 10;
        len = len + 1;
    }
    int total = len;
    if (neg == 1) {
        total = total + 1;
    }
    *uint8 buf = alloc<uint8>(total + 1);
    int off = 0;
    if (neg == 1) {
        buf[0] = 45;
        off = 1;
    }
    int i = 0;
    while (i < len) {
        buf[off + i] = tmp[len - 1 - i];
        i = i + 1;
    }
    buf[total] = 0;
    return (string)buf;
}

// Parse a decimal or 0x-hex integer literal lexeme to an int (enum values).
int str_to_int(string s) {
    int i = 0;
    int v = 0;
    if (s[0] == 48 && (s[1] == 120 || s[1] == 88)) {       // "0x"
        i = 2;
        while (s[i] != 0) {
            int c = (int)s[i];
            int dgt = 0;
            if (c >= 48 && c <= 57) {
                dgt = c - 48;
            }
            else if (c >= 97 && c <= 102) {
                dgt = c - 87;
            }
            else {
                dgt = c - 55;
            }
            v = v * 16 + dgt;
            i = i + 1;
        }
        return v;
    }
    while (s[i] != 0) {
        v = v * 10 + ((int)s[i] - 48);
        i = i + 1;
    }
    return v;
}

// An integer literal lexeme (decimal, 0x hex, leading-0 octal, as C++ std::stoll base 0)
// to int64: enum member values, which sema then range-checks against `int`.
int64 str_to_i64(string s) {
    int i = 0;
    int64 base = (int64)10;
    if (s[0] == 48 && (s[1] == 120 || s[1] == 88)) {
        base = (int64)16;
        i = 2;
    }
    else if (s[0] == 48 && s[1] != 0) {
        base = (int64)8;
        i = 1;
    }
    int64 v = (int64)0;
    while (s[i] != 0) {
        int c = (int)s[i];
        int64 dgt = (int64)0;
        if (c >= 48 && c <= 57) {
            dgt = (int64)(c - 48);
        }
        else if (c >= 97 && c <= 102) {
            dgt = (int64)(c - 87);
        }
        else if (c >= 65 && c <= 70) {
            dgt = (int64)(c - 55);
        }
        else {
            return v;
        }
        v = v * base + dgt;
        i = i + 1;
    }
    return v;
}

string i64_to_str(int64 n) {
    *uint8 buf = alloc<uint8>(24);
    sprintf((string)buf, "%lld", n);
    return (string)buf;
}

// extern / intrinsic share the prototype shape: RetType name(params);
*DeclNode parse_proto(Parser* p, int kind) {
    *DeclNode d = new_decl(kind);
    Token rt0 = p_peek(p);
    d.ret_type = parse_type(p);
    d.name = tok_text(p.src, p_expect_ident(p, "Expected function or variable name"));
    d.line = g_pos_line;   // the name token (as the C++ parser)
    d.col = g_pos_col;
    if (kind == DK_INTRINSIC) {   // an intrinsic at its return type
        d.line = rt0.line;
        d.col = rt0.col;
    }
    // `extern <type> <name>;` (no parens) is a variable defined in another
    // translation unit (a C global), not a function prototype.
    if (kind == DK_EXTERN && p_at(p) != LPAREN) {
        d.kind = DK_VARDECL;
        d.is_extern = 1;
        p_expect(p, SEMICOLON, "Expected ';'");
        return d;
    }
    p_expect(p, LPAREN, "Expected '('");
    parse_params(p, d);
    p_expect(p, RPAREN, "Expected ')'");
    p_expect(p, SEMICOLON, "Expected ';'");
    return d;
}

// An unnamed bitfield after its type `ty`: `: N;` (N = 0 allowed), kept in d.pad_*.
void parse_unnamed_bitfield(Parser* p, *DeclNode d, string ty) {
    p_adv(p);
    int64 w = str_to_i64(tok_text(p.src, p_expect_tok(p, INT_LIT, "Expected bit width after ':' in bitfield")));
    if (w > (int64)1048576) {
        w = (int64)1048576;
    }
    p_expect(p, SEMICOLON, "Expected ';' after field");
    List_push<string>(&d.pad_tys, ty);
    List_push<int>(&d.pad_bits, (int)w);
    List_push<int>(&d.pad_at, List_len<Param>(&d.params));
}

*DeclNode parse_struct(Parser* p) {
    *DeclNode d = new_decl(DK_STRUCT);
    d.name = tok_text(p.src, p_expect_ident(p, "Expected struct name"));
    d.line = g_pos_line;   // the name token (as the C++ parser)
    d.col = g_pos_col;
    if (g_cur_pack >= 1) {
        d.pack_align = g_cur_pack;
        if (g_cur_pack == 1) {
            d.is_packed = 1;
        }
    }
    parse_type_params(p, &d.type_params, 1);   // optional <T, E: Iface>
    int tmark = push_tparams(&d.type_params);   // in scope for inline methods
    p_expect(p, LBRACE, "Expected '{'");
    List_init<Param>(&d.params, 4);
    while (p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
        if (p_at(p) == PRAGMA) {
            p_take_pragma(p);
            continue;
        }
        string mty = parse_type(p);
        if (p_at(p) == COLON) {
            parse_unnamed_bitfield(p, d, mty);
            continue;
        }
        check_name_not_keyword(p);         // a field/method name can't be a reserved word (e.g. `in`)
        Token mnm = p_expect_ident(p, "Expected member name");              // member name
        if (p_at(p) == LPAREN) {
            // Method — a FunctionDecl whose return type + name were already read.
            *DeclNode m = new_decl(DK_FUNCTION);
            m.ret_type = mty;
            m.name = tok_text(p.src, mnm);
            m.line = mnm.line;
            m.col = mnm.col;
            p_expect(p, LPAREN, "Expected '('");
            g_allow_defaults = 1;
            parse_params(p, m);
            p_expect(p, RPAREN, "Expected ')'");
            if (p_at(p) == LBRACE) {
                int lmark = local_mark();
                local_push_params(m);
                m.body = parse_block(p);
                local_pop(lmark);
            } else {
                m.body = null;
                p_adv(p);
            }
            List_push<*DeclNode>(&d.methods, m);
        } else {
            int bw = 0;
            if (p_at(p) == COLON) {                       // bitfield ': width' (`: 0` is -1, rejected by sema)
                p_adv(p);
                bw = str_to_int(tok_text(p.src, p_expect_tok(p, INT_LIT, "Expected bit width after ':' in bitfield")));
                if (bw == 0) {
                    bw = 0 - 1;
                }
            }
            *ExprNode fdv = null;
            if (p_at(p) == EQ) {   // a default value
                p_adv(p);
                fdv = parse_expr(p);
            }
            p_expect(p, SEMICOLON, "Expected ';' after field");
            let pm: Param;
            pm.ty = mty;
            pm.name = tok_text(p.src, mnm);
            pm.line = mnm.line;
            pm.col = mnm.col;
            List_push<Param>(&d.params, pm);
            List_push<int>(&d.field_bits, bw);
            List_push<*ExprNode>(&d.field_dflts, fdv);
        }
    }
    pop_tparams(tmark);
    p_expect(p, RBRACE, "Expected '}'");
    return d;
}

*DeclNode parse_union(Parser* p) {
    *DeclNode d = new_decl(DK_UNION);
    d.name = tok_text(p.src, p_expect_ident(p, "Expected union name"));
    d.line = g_pos_line;   // the name token (as the C++ parser)
    d.col = g_pos_col;
    if (g_cur_pack >= 1) {
        d.pack_align = g_cur_pack;
        if (g_cur_pack == 1) {
            d.is_packed = 1;
        }
    }
    p_expect(p, LBRACE, "Expected '{'");
    List_init<Param>(&d.params, 4);
    while (p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
        let pm: Param;
        pm.ty = parse_type(p);
        if (p_at(p) == COLON) {
            parse_unnamed_bitfield(p, d, pm.ty);
            continue;
        }
        Token fnt = p_expect_ident(p, "Expected field name");
        pm.name = tok_text(p.src, fnt);
        pm.line = fnt.line;
        pm.col = fnt.col;
        p_expect(p, SEMICOLON, "Expected ';'");
        List_push<Param>(&d.params, pm);
    }
    p_expect(p, RBRACE, "Expected '}'");
    return d;
}

*DeclNode parse_interface(Parser* p) {
    *DeclNode d = new_decl(DK_INTERFACE);
    d.name = tok_text(p.src, p_expect_ident(p, "Expected interface name"));
    d.line = g_pos_line;   // the name token (as the C++ parser)
    d.col = g_pos_col;
    p_expect(p, LBRACE, "Expected '{'");
    while (p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
        *DeclNode m = new_decl(DK_FUNCTION);
        m.ret_type = parse_type(p);        // return type
        m.name = tok_text(p.src, p_expect_ident(p, "Expected method name"));    // method name
        p_expect(p, LPAREN, "Expected '('");
        parse_params(p, m);                // capture the method's params
        p_expect(p, RPAREN, "Expected ')'");
        p_expect(p, SEMICOLON, "Expected ';'");
        List_push<*DeclNode>(&d.methods, m);
    }
    p_expect(p, RBRACE, "Expected '}'");
    return d;
}

*DeclNode parse_enum(Parser* p) {
    *DeclNode d = new_decl(DK_ENUM);
    d.name = tok_text(p.src, p_expect_ident(p, "Expected enum name"));
    d.line = g_pos_line;   // the name token (as the C++ parser)
    d.col = g_pos_col;
    parse_type_params(p, &d.type_params, 0);   // optional <T> (enum: no constraints field)
    p_expect(p, LBRACE, "Expected '{'");
    List_init<Param>(&d.params, 4);
    List_init<*ExprNode>(&d.enum_vals, 4);
    int any_expr = 0;                  // after the first value expression every value is one
    int64 next = (int64)0;             // 64-bit, so sema can reject a value that does not fit int
    while (p_at(p) != RBRACE && p_at(p) != EOF_TOKEN) {
        string mname = tok_text(p.src, p_expect_ident(p, "Expected enum member name"));
        int64 val = next;
        *ExprNode ve = null;
        let pl: List<string>;
        List_init<string>(&pl, 2);
        if (p_at(p) == LPAREN) {           // ADT payload — capture variant field types
            p_adv(p);
            if (p_at(p) != RPAREN) {
                List_push<string>(&pl, parse_type(p));
                while (p_at(p) == COMMA) {
                    p_adv(p);
                    List_push<string>(&pl, parse_type(p));
                }
            }
            p_expect(p, RPAREN, "Expected ')'");
        } else if (p_at(p) == EQ) {        // explicit value: a literal, or a constant expression
            p_adv(p);
            int lit = 0;
            if (p_at(p) == MINUS) {
                lit = 1;
            }
            int after = p_peek_k(p, lit + 1).type;
            if (any_expr == 0 && p_peek_k(p, lit).type == INT_LIT && (after == COMMA || after == RBRACE)) {
                int neg = 0;
                if (p_at(p) == MINUS) {
                    p_adv(p);
                    neg = 1;
                }
                val = str_to_i64(tok_text(p.src, p_expect_tok(p, INT_LIT, "Expected integer value for enum member")));
                if (neg == 1) {
                    val = (int64)0 - val;
                }
            } else {
                ve = parse_expr(p);        // folded by sema (mirrors the C++ valueExprs)
                any_expr = 1;
                val = (int64)0;
            }
        }
        let pm: Param;
        pm.name = mname;
        pm.ty = i64_to_str(val);
        List_push<Param>(&d.params, pm);
        List_push<List<string>>(&d.payloads, pl);
        List_push<*ExprNode>(&d.enum_vals, ve);
        if (List_len<TypeParam>(&d.type_params) > 0) {   // Some<int>(x)
            List_push<string>(&g_genericnames, mname);
        }
        next = val + (int64)1;
        if (p_at(p) == COMMA) {
            p_adv(p);
        } else {
            break;
        }
    }
    p_expect(p, RBRACE, "Expected '}'");
    return d;
}

*DeclNode parse_typealias(Parser* p) {
    p_adv(p);                              // 'type'
    *DeclNode d = new_decl(DK_TYPEALIAS);
    d.name = tok_text(p.src, p_adv(p));    // alias name
    d.line = g_pos_line;   // the name token (as the C++ parser)
    d.col = g_pos_col;
    p_expect(p, EQ, "Expected '='");
    d.ret_type = parse_type(p);
    p_expect(p, SEMICOLON, "Expected ';'");
    return d;
}

*DeclNode mk_decl_var(string nm, string ty, *ExprNode init, int is_const) {
    *DeclNode d = new_decl(DK_VARDECL);
    d.name = nm;
    d.ret_type = ty;
    d.init = init;
    d.is_const = is_const;
    return d;
}

// Fallback for a non-keyword top-level decl: a let/typed global var, or a function
// (`Type name(` / `Type name<`). Mirrors parseDeclaration's tail.
*DeclNode parse_decl_fallback(Parser* p) {
    int save = p.pos;
    int is_const = 0;
    int is_vol = 0;
    int is_stat = 0;                       // `static` on a global: parsed, rejected by sema
    while (p_at(p) == STATIC || p_at(p) == VOLATILE) {
        if (p_at(p) == STATIC) {
            is_stat = 1;
        } else {
            is_vol = 1;
        }
        p_adv(p);
    }
    if (p_at(p) == CONST) {
        int k = 1;
        if (p_peek_k(p, 1).type == VOLATILE) {
            k = 2;
        }
        if (p_peek_k(p, k).type == LET) {
            is_const = 1;
            p_adv(p);
        }
    }
    if (p_at(p) == VOLATILE) {
        is_vol = 1;
        p_adv(p);
    }
    if (p_at(p) == LET) {
        p_adv(p);
        check_name_not_keyword(p);
        Token gnt = p_expect_ident(p, "Expected identifier after 'let'");
        string nm = tok_text(p.src, gnt);
        p_expect(p, COLON, "Expected ':'");
        string raw = parse_type(p);
        if (is_value_const(raw) == 1) {
            is_const = 1;
        }
        string ty = strip_binding_const(raw);
        *ExprNode init = null;
        if (p_at(p) == EQ) {
            p_adv(p);
            init = parse_expr(p);
        }
        p_expect(p, SEMICOLON, "Expected ';'");
        *DeclNode dv = mk_decl_var(nm, ty, init, is_const);
        dv.is_vol = is_vol;
        dv.is_static = is_stat;
        dv.line = gnt.line;   // the name token (as the C++ parser)
        dv.col = gnt.col;
        return dv;
    }
    string raw = parse_type(p);
    if (is_value_const(raw) == 1) {
        is_const = 1;
    }
    string ty = strip_binding_const(raw);
    if (p_at(p) == OPERATOR) {             // `V3 operator +(...)` — an operator overload
        p.pos = save;
        return parse_function(p);
    }
    check_name_not_keyword(p);
    Token nm = p_expect_ident(p, str_concat("Expected declaration, got ", token_name(p_at(p))));                   // name
    if (p_at(p) == LPAREN || p_at(p) == LT) {
        p.pos = save;                      // it's a function — re-parse from the top
        return parse_function(p);
    }
    if (p_at(p) == LBRACKET) {             // C-style `int grid[3][4];`: arrays are `int[3][4] grid`
        p_fail(p, str_concat("Expected declaration, got ", token_name(p_at(p))));
        return null;
    }
    *ExprNode init = null;
    if (p_at(p) == EQ) {
        p_adv(p);
        init = parse_expr(p);
    }
    p_expect(p, SEMICOLON, "Expected ';'");
    *DeclNode dv2 = mk_decl_var(tok_text(p.src, nm), ty, init, is_const);
    dv2.is_vol = is_vol;
    dv2.is_static = is_stat;
    dv2.line = nm.line;     // the name token (as the C++ parser)
    dv2.col = nm.col;
    return dv2;
}

// Top-level declaration dispatch (mirrors parseDeclaration). A declared type name
// is registered so later `(Name)x` casts are recognized.
*DeclNode parse_decl_top(Parser* p) {
    int t = p_at(p);
    *DeclNode d;
    if (t == EXTERN) {
        p_adv(p);
        return parse_proto(p, DK_EXTERN);
    }
    if (t == INTRINSIC) {
        p_adv(p);
        return parse_proto(p, DK_INTRINSIC);
    }
    if (t == ASYNC) {   // async fn
        p_adv(p);
        d = parse_function(p);
        d.is_async = 1;
        return d;
    }
    if (t == MUST_USE) {   // must_use fn
        p_adv(p);
        d = parse_function(p);
        d.is_mustuse = 1;
        return d;
    }
    // `deprecated("use X") T f(...)`: sema warns at each use of f.
    if (t == IDENT && p_peek_k(p, 1).type == LPAREN && p_peek_k(p, 2).type == STRING_LIT && p_peek_k(p, 3).type == RPAREN) {
        Token dt = p_peek(p);
        if (lexeme_eq(p.src, dt.start, dt.len, "deprecated") == 1) {
            p_adv(p);
            p_adv(p);
            int dml = 0;
            string dmsg = tok_str_value(p.src, p_adv(p), &dml);
            p_adv(p);
            *DeclNode dd = parse_decl_top(p);
            if (dd.kind != DK_FUNCTION) {
                p_report(p, dt, "'deprecated' applies to a function");
            }
            if (dmsg[0] == 0) {
                dmsg = " ";
            }
            dd.depr_msg = dmsg;
            return dd;
        }
    }
    if (t == STRUCT) {
        p_adv(p);
        d = parse_struct(p);
        register_type(p, d.name);
        return d;
    }
    if (t == PACKED) {
        p_adv(p);
        p_adv(p);
        d = parse_struct(p);
        d.is_packed = 1;
        d.pack_align = 1;
        register_type(p, d.name);
        return d;
    }
    if (t == UNION) {
        p_adv(p);
        d = parse_union(p);
        register_type(p, d.name);
        return d;
    }
    if (t == INTERFACE) {
        p_adv(p);
        d = parse_interface(p);
        register_type(p, d.name);
        return d;
    }
    if (t == ENUM) {
        p_adv(p);
        d = parse_enum(p);
        register_type(p, d.name);
        return d;
    }
    if (t == IDENT) {                      // contextual `type Alias = ...;`
        Token cur = p_peek(p);
        if (lexeme_eq(p.src, cur.start, cur.len, "type") == 1
            && p_peek2(p).type == IDENT && p_peek_k(p, 2).type == EQ) {
            d = parse_typealias(p);
            register_type(p, d.name);
            return d;
        }
    }
    return parse_decl_fallback(p);
}

// Resolve and recursively parse an `import`, appending the imported file's decls to
// `prog` at this position (mirrors parser.cpp: dedup via g_imported, stdlib `<name>`
// → stdlib/name.esk, relative `"path"` → basedir/path). The caller has already
// consumed the IMPORT keyword; `p` is positioned at the path token.
void do_import(Parser* p, *Program prog) {
    string path = "";
    int is_std = 0;
    Token path_tok = p_peek(p);
    if (p_at(p) == STRING_LIT) {
        int _dl2 = 0;
        path = tok_str_value(p.src, p_peek(p), &_dl2);
        p_adv(p);
    } else if (p_at(p) == LT) {
        p_adv(p);
        string name = "";
        while (p_at(p) != GT && p_at(p) != EOF_TOKEN) {
            name = str_concat(name, tok_text(p.src, p_adv(p)));
        }
        p_expect(p, GT, "Expected '>' after stdlib name");
        path = name;
        is_std = 1;
    } else {
        p_fail(p, "Expected filename or <name> after import");
        return;
    }
    p_expect(p, SEMICOLON, "Expected ';' after import");

    string full = resolve_import(path, is_std, p.basedir);
    if (g_import_err != null) {
        p_report(p, path_tok, g_import_err);
    }
    if (register_file(full) == 0) {   // dedup by canonical path — parse each file once
        return;
    }

    // The preprocessor already handled this import at its line (see pre_import);
    // otherwise read and preprocess it now. Preprocessing evaluates its #ifdef/#define,
    // so e.g. mem.esk picks one branch, not both.
    let pe: int = 0;
    string psrc;
    int plen = 0;
    int ci = pre_find(canonical_path(full));
    if (ci >= 0) {
        psrc = List_get<string>(&g_pre_text, ci);
        pe = List_get<int>(&g_pre_err, ci);
        plen = List_get<int>(&g_pre_len, ci);
    } else {
        let bytes: int64 = 0;
        *uint8 isrc = fs_read_all(full, &bytes);
        if (isrc == null) {                      // a missing import is an error (like the C++)
            p_report(p, path_tok, str_concat(str_concat("Cannot open import: '", full), "'"));
        }
        psrc = pp_run((string)isrc, (int)bytes, full, &pe);
        plen = g_pp_out_len;
    }
    if (pe != 0) {                    // directive error in the import (already reported)
        exit(1);
    }
    *uint8 ppsrc = (*uint8)psrc;
    let sub: Parser;
    g_lex_file = full;
    p_init(&sub, ppsrc, plen);
    sub.basedir = str_dir(full);
    sub.is_import = 1;
    int first = List_len<*DeclNode>(&prog.decls);
    parse_into(&sub, prog);
    while (first < List_len<*DeclNode>(&prog.decls)) {   // library code: not linted
        List_get<*DeclNode>(&prog.decls, first).from_import = 1;
        first = first + 1;
    }
}

// Scripts (mirrors the C++ Parser::startsScriptStatement / buildScriptMain): a
// top-level line is a statement when no declaration can start that way, and a file
// with top-level statements gets an implicit `main` running them in order.
int p_stmt_after_name(int t) {
    if (t == LPAREN || t == DOT || t == EQ || t == PLUS_EQ || t == MINUS_EQ || t == STAR_EQ || t == SLASH_EQ
        || t == PERCENT_EQ || t == AMP_EQ || t == PIPE_EQ || t == CARET_EQ || t == LSHIFT_EQ || t == RSHIFT_EQ
        || t == PLUS_PLUS || t == MINUS_MINUS || t == COLON || t == SEMICOLON) {
        return 1;
    }
    return 0;
}

int p_starts_script_stmt(Parser* p) {
    int t = p_at(p);
    if (t == IF || t == FOR || t == WHILE || t == DO || t == RETURN || t == SWITCH || t == MATCH || t == TRY
        || t == THROW || t == DEFER || t == ERRDEFER || t == BREAK || t == CONTINUE || t == LBRACE
        || t == PLUS_PLUS || t == MINUS_MINUS || t == LPAREN || t == INT_LIT || t == FLOAT_LIT
        || t == STRING_LIT || t == CHAR_LIT || t == MINUS || t == NOT || t == AMPERSAND || t == TILDE
        || t == NULL_KW || t == TRUE || t == FALSE || t == SIZEOF || t == FREE_CLOSURE || t == THREAD_CREATE
        || t == THREAD_JOIN || t == ALLOC_WITH || t == AWAIT || t == ASM || t == SEMICOLON) {
        return 1;
    }
    if (t != IDENT && t != STAR) {
        return 0;
    }
    if (t == IDENT && str_eq(tok_text(p.src, p_peek(p)), "deprecated") == 1 && p_peek_k(p, 1).type == LPAREN
        && p_peek_k(p, 2).type == STRING_LIT) {
        return 0;
    }
    int k = 0;
    while (p_peek_k(p, k).type == STAR) {
        k = k + 1;
    }
    if (p_peek_k(p, k).type != IDENT) {
        return 0;
    }
    int n = p_peek_k(p, k + 1).type;
    if (p_stmt_after_name(n) == 1) {
        return 1;
    }
    if (n == LT && k == 0) {
        // `f<int>(x)` is a call and `x < y` (no closing `>`) a comparison;
        // `List<int> l` declares.
        int td = 0;
        int tj = 1;
        while (1 == 1) {
            int tb = p_peek_k(p, tj).type;
            if (tb == SEMICOLON || tb == LBRACE || tb == RBRACE || tb == EOF_TOKEN) {
                return 1;
            }
            if (tb == LT) {
                td = td + 1;
            } else if (tb == GT) {
                td = td - 1;
            } else if (tb == RSHIFT) {
                td = td - 2;
            }
            if (td <= 0) {
                break;
            }
            tj = tj + 1;
        }
        if (td < 0 || p_peek_k(p, tj + 1).type == LPAREN) {
            return 1;
        }
        return 0;
    }
    if (n != LBRACKET) {
        return 0;
    }
    // `arr[0] = 1` uses a name; `Point[2] ps` and `*Node[3] t` declare one.
    int depth = 0;
    int j = k + 1;
    while (1 == 1) {
        int b = p_peek_k(p, j).type;
        if (b == EOF_TOKEN) {
            return 0;
        }
        if (b == LBRACKET) {
            depth = depth + 1;
        } else if (b == RBRACKET) {
            depth = depth - 1;
            if (depth == 0) {
                break;
            }
        }
        j = j + 1;
    }
    if (p_peek_k(p, j + 1).type == IDENT) {
        return 0;
    }
    return 1;
}

*ExprNode p_script_ident(string nm, int line, int col) {
    *ExprNode e = mk_ident(nm);
    e.line = line;
    e.col = col;
    return e;
}

*StmtNode p_script_assign(string nm, *ExprNode value, int script, int line, int col) {
    *ExprNode be = ast_new_expr();
    be.kind = EK_BINARY;
    be.sval = "=";
    be.a = p_script_ident(nm, line, col);
    be.b = value;
    be.script_init = script;
    be.line = line;
    be.col = col;
    *StmtNode st = ast_new_stmt();
    st.kind = SK_EXPR;
    st.expr = be;
    st.line = line;
    st.col = col;
    return st;
}

// A file with top-level statements is a script: it gets `int main(int __argc, string*
// __argv)` running them in order, with the arguments in the globals `argc` and `argv`.
// Each top-level variable with an initializer (not `const`, not an array literal)
// becomes a global that starts at zero and is assigned at its place in that order.
// The globals go before this file's declarations (`start`), main after them.
void p_build_script_main(Parser* p, *Program prog, int start) {
    *StmtNode first = null;
    int i = 0;
    int n = List_len<*StmtNode>(&p.so_stmts);
    while (i < n && first == null) {
        first = List_get<*StmtNode>(&p.so_stmts, i);
        i = i + 1;
    }
    if (first == null) {
        return;
    }
    int k = start;
    while (k < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, k);
        if (d.kind == DK_FUNCTION && str_eq(d.name, "main") == 1 && d.from_import == 0) {
            let at: Token;
            at.line = first.line;
            at.col = first.col;
            p_report(p, at, "a file with top-level statements has no 'main': the statements are its main");
        }
        k = k + 1;
    }
    int fl = first.line;
    int fc = first.col;
    *StmtNode body = ast_new_stmt();
    body.kind = SK_BLOCK;
    body.line = fl;
    body.col = fc;
    List_init<*StmtNode>(&body.items, n + 4);
    // `main`, `argc`, `argv`, their assignments and the final `return 0` are implicit:
    // no position (line 0), so the editor modes do not place them on the first statement.
    List_push<*StmtNode>(&body.items, p_script_assign("argc", p_script_ident("__argc", 0, 0), 0, 0, 0));
    List_push<*StmtNode>(&body.items, p_script_assign("argv", p_script_ident("__argv", 0, 0), 0, 0, 0));
    i = 0;
    while (i < n) {
        *StmtNode s = List_get<*StmtNode>(&p.so_stmts, i);
        *DeclNode vd = List_get<*DeclNode>(&p.so_vars, i);
        i = i + 1;
        if (s != null) {
            List_push<*StmtNode>(&body.items, s);
            continue;
        }
        if (vd.init == null || vd.is_const == 1 || vd.is_extern == 1 || vd.init.kind == EK_ARRAYLIT) {
            continue;
        }
        vd.script_init = 1;
        List_push<*StmtNode>(&body.items, p_script_assign(vd.name, vd.init, 1, vd.line, vd.col));
    }
    int ni = List_len<*StmtNode>(&body.items);
    if (List_get<*StmtNode>(&body.items, ni - 1).kind != SK_RETURN) {
        *ExprNode zero = ast_new_expr();
        zero.kind = EK_LITERAL;
        zero.lit_kind = LIT_INT;
        zero.sval = "0";
        zero.line = 0;
        zero.col = 0;
        *StmtNode ret = ast_new_stmt();
        ret.kind = SK_RETURN;
        ret.expr = zero;
        ret.line = 0;
        ret.col = 0;
        List_push<*StmtNode>(&body.items, ret);
    }
    *DeclNode mainfn = new_decl(DK_FUNCTION);
    mainfn.name = "main";
    mainfn.ret_type = "int";
    List_init<Param>(&mainfn.params, 2);
    let pa: Param;
    pa.ty = "int";
    pa.name = "__argc";
    List_push<Param>(&mainfn.params, pa);
    let pv: Param;
    pv.ty = "string*";
    pv.name = "__argv";
    List_push<Param>(&mainfn.params, pv);
    List_push<int>(&mainfn.param_escaping, 0);
    List_push<int>(&mainfn.param_escaping, 0);
    List_init<*ExprNode>(&mainfn.param_defaults, 1);
    List_init<string>(&mainfn.param_def_texts, 1);
    mainfn.body = body;
    mainfn.line = 0;
    mainfn.col = 0;
    mainfn.file = p.file;
    *DeclNode ga = new_decl(DK_VARDECL);
    ga.name = "argc";
    ga.ret_type = "int";
    ga.line = 0;
    ga.col = 0;
    ga.file = p.file;
    *DeclNode gv = new_decl(DK_VARDECL);
    gv.name = "argv";
    gv.ret_type = "string*";
    gv.line = 0;
    gv.col = 0;
    gv.file = p.file;
    List_insert<*DeclNode>(&prog.decls, start, gv);
    List_insert<*DeclNode>(&prog.decls, start, ga);
    List_push<*DeclNode>(&prog.decls, mainfn);
}

// Parse top-level items from `p` into an existing program (used both for the entry
// file and recursively for each import, so imported decls land in declaration order).
void parse_into(Parser* p, *Program prog) {
    int start = List_len<*DeclNode>(&prog.decls);
    while (p_at(p) != EOF_TOKEN) {
        if (p_at(p) == PRAGMA) {   // #pragma link / pack state
            p_take_pragma(p);
        }
        else if (p_at(p) == IMPORT) {
            p_adv(p);
            do_import(p, prog);
        }
        else if (p_starts_script_stmt(p) == 1) {
            if (p.is_import == 1) {
                p_report(p, p_peek(p), "a top-level statement is allowed only in a program's own file, not in an import");
            }
            List_push<*StmtNode>(&p.so_stmts, parse_stmt(p));
            List_push<*DeclNode>(&p.so_vars, null);
        }
        else {
            *DeclNode d = parse_decl_top(p);
            d.file = p.file;               // diagnostics inside it name this file
            List_push<*DeclNode>(&prog.decls, d);
            if (d.kind == DK_VARDECL) {
                List_push<*StmtNode>(&p.so_stmts, null);
                List_push<*DeclNode>(&p.so_vars, d);
            }
        }
    }
    p_build_script_main(p, prog, start);
}

*Program parse_program(Parser* p) {
    *Program prog = alloc<Program>(1);
    List_init<*DeclNode>(&prog.decls, 4);
    parse_into(p, prog);
    return prog;
}
